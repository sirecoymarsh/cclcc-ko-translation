   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미나미사와 센리",
   "jp": "起きてからこっち、欠伸した以外はひと言も発していないのに、泉理はすべての疑問に答えてくれた。"
  },
  {
   "id": "clkn02:1900",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それくらいわかるわ……だって、私たち、姉弟じゃない」"
