   "id": "clkn02:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "쿠루스 노노",
   "jp": "この慌ただしい朝の風景も久しぶりだな。"
  },
  {
   "id": "clkn02:3400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ〜！」"
  },
