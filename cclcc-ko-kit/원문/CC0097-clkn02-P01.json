  {
   "id": "clkn02:3200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「あ〜、結人くん。寝ぐせひどいです。なおさなきゃ」"
  },
