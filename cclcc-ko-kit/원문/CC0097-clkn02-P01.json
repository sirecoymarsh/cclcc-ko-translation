   "id": "clkn02:3100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "「もう玄関に用意してあるわよ」"
