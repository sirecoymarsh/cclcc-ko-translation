  {
   "id": "clkn02:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미나미사와 센리",
   "jp": "油断すると、再びくっつきそうになる瞼をなんとか開けて、ベッドから降りた。"
