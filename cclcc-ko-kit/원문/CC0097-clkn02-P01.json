   "id": "clkn02:3500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「どうした？」"
  },
  {
   "id": "clkn02:3600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「もう！ 父さんったら、またこんなところに替えの白衣置いたまま」"
  },
  {
   "id": "clkn02:3700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「ちょっと持って行ってくるから、待っててね」"
  },
  {
   "id": "clkn02:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "こうやって見てると、まるで何人も子どものいる母親みたいだ。"
  },
  {
   "id": "clkn02:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "もっともそんな事言ったら、僕もそのひとりだ、なんて言うんだろうけど。"
  },
  {
   "id": "clkn02:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "あれ？"
  },
  {
   "id": "clkn02:4100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "そういえば乃々の奴『待っててね』なんて言ってたけど、もしかして一緒に学校に行くつもりじゃないだろうな。"
  },
  {
   "id": "clkn02:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "冗談じゃない。"
  },
  {
   "id": "clkn02:4300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "ただでさえ目立つ乃々と肩を並べて登校だなんて、そんな恥ずかしいことできるか。"
  },
  {
   "id": "clkn02:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "よし、今のうちに先に行こう。"
  },
  {
   "id": "clkn02:4500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あれ？ 拓留兄、もう行くの？」"
  },
  {
   "id": "clkn02:4600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「ああ」"
  },
  {
   "id": "clkn02:4700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ちょっと待ってよ。だったら一緒に……あれ？ 乃々姉は？」"
  },
  {
   "id": "clkn02:4800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「父さんのところに行った。とにかく僕は先に行くから。それじゃ」"
  },
  {
   "id": "clkn02:4900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「え？ あ、拓留兄、待ちなさーい」"
  },
  {
   "id": "clkn02:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "오노에 세리카",
   "jp": "呼び止める結衣の声を振り切って、僕は逃げ出すように青葉寮を後にした。"
  },
  {
   "id": "clkn02:5100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "오노에 세리카",
   "jp": "乃々と一緒ってだけでも恥ずかしいのに、結衣や結人やうきとも一緒だなんてもってのほかだ。"
  },
  {
   "id": "clkn02:5200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "오노에 세리카",
   "jp": "それにしても結衣の奴ホント、ますます乃々に似てきたな。"
  },
  {
   "id": "clkn02:5300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "오노에 세리카",
   "jp": "先に行ったことで、乃々が文句を言いに来るかとも思ったがそんなこともなく、時計の針とにらめっこしながらの午前中の授業はつつがなく終わりを迎え、ようやく昼休みがやってきた。"
  },
