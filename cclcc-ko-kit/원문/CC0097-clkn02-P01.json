  },
  {
   "id": "clkn02:1100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「ふあぁ……」"
