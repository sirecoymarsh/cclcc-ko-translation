  {
   "id": "clkn02:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "泉理はくすりと笑うと、早く準備していらっしゃいと言い置いて、部屋を後にした。"
  },
  {
   "id": "clkn02:2100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "だって、姉弟じゃない、か。"
