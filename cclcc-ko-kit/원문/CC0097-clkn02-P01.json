  {
   "id": "clkn02:2800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「どうせいつもは朝なんてちゃんと食べてないんでしょう。家にいる時くらい、しっかり食べなきゃ」"
  },
  {
   "id": "clkn02:2900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「結人、結衣！ ハンカチ、ここ置いておくわよー」"
