 ],
 "context_before": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「僕、帰るよ……」"
  },
  {
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "jp": "「え？ あ、おい……！」"
  },
  {
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "jp": "「やれやれ。世話の焼けるこった」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "背後で伊藤が何かつぶやいていたけれど、雑踏に飲み込まれて僕の耳には届かなかった。"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「ん……？」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "伊藤と別れて住処に戻って来ると、中から人の気配がした。"
  }
 ],
 "entries": [
  {
   "id": "clah08:10000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "有村、もう帰ってるんだろうか？"
  },
  {
   "id": "clah08:10100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "아리무라 에미",
   "jp": "「…………」"
  },
  {
   "id": "clah08:10200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "くそっ！"
  },
  {
   "id": "clah08:10300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "伊藤が変なこと言うから、意識しちゃうじゃないか。"
  },
  {
   "id": "clah08:10400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "とはいえ、ここで引き返すというのも、伊藤に言われたことを認めるみたいで、癪に障る。"
  },
  {
   "id": "clah08:10500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "아리무라 에미",
   "jp": "「ただい……」"
  },
  {
   "id": "clah08:10600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そこに居た人物の姿に、僕の言葉は止まり、代わりに違う言葉が口から出た。"
  },
  {
   "id": "clah08:10700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "아리무라 에미",
   "jp": "「お、お母さん……」"
  },
  {
   "id": "clah08:10800",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あら。ひょっとしてしばらく来ないうちに“お母さん”って呼ばれる関係になっちゃったのかしら？」"
  },
  {
   "id": "clah08:10900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「あ、いや、今のは言葉の⟦rb⟧あや⟦rt⟧⟦rbc⟧●●⟦/r⟧で……」"
  },
  {
   "id": "clah08:11000",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「わかってるわ。冗談よ、冗談」"
  },
  {
   "id": "clah08:11100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「つまんない冗談」"
  },
  {
   "id": "clah08:11200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "帰って来るなりこの空気、勘弁してほしい。"
  },
  {
   "id": "clah08:11300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "ここは僕の家だってのに。"
  },
  {
   "id": "clah08:11400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「どうして来たのよ？」"
  },
  {
   "id": "clah08:11500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「一応ね。ほら、この前来るって言ったから。私、嘘は嫌いなのよねぇ」"
  },
  {
   "id": "clah08:11600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……嘘ばっかり」"
  },
  {
   "id": "clah08:11700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 에미",
   "jp": "「の、飲み物でもどう……ですか？」"
  },
  {
   "id": "clah08:11800",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あら、気が利くわね。ちょうど喉乾いてたの」"
  },
  {
   "id": "clah08:11900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미야시로 타쿠루",
   "jp": "確か、その辺に水が……。"
  },
  {
   "id": "clah08:12000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あぁ、そういえば切らしてたんだ。"
  },
  {
   "id": "clah08:12100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「⟦col:280aa02d1400⟧マウンテンビュー⟦col:800000⟧で、いいですか？」"
  },
  {
   "id": "clah08:12200",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なにそれ？」"
  },
  {
   "id": "clah08:12300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「……ですよね。じゃあ、アップルティーで」"
  },
  {
   "id": "clah08:12400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "アップルティーだったら、有村のために常備してある。"
  },
  {
   "id": "clah08:12500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ、私、アップルティー嫌いなの。そのマウンテンなんとかでいいわ」"
  },
  {
   "id": "clah08:12600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ほんと、娘とは相容れないんだな。"
  },
  {
   "id": "clah08:12700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「どうぞ」"
  },
  {
   "id": "clah08:12800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "有村の母さんは、差し出したマウンテンビューを一口飲んで、僅かに顔をしかめた。"
  },
  {
   "id": "clah08:12900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "やっぱり口には合わなかったらしい。"
  },
  {
   "id": "clah08:13000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「えっと……それで、その……」"
  },
  {
   "id": "clah08:13100",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「話は言わなくてもわかってるわよね？」"
  },
  {
   "id": "clah08:13200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "有村に帰って来いって話であることは間違いない。"
  },
  {
   "id": "clah08:13300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "けれど当然、有村は拒否するだろう。"
  },
  {
   "id": "clah08:13400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "その為に、僕はまた例の台本とやらを手渡されたんだから。"
  },
  {
   "id": "clah08:13500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "いったいどんなことが書かれているのかという興味本位もあって、一応台本をパラパラ見てはみたけど、内容的には前とほとんど同じだった。"
  },
  {
   "id": "clah08:13600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "『僕は雛絵のことが好きだ』とか『離れたくない』だとか、そんなものだ。"
  },
  {
   "id": "clah08:13700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "けれど有村の母さんは、有村が僕のところに半ば無理矢理、居候していることを感づいている。"
  },
  {
   "id": "clah08:13800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "だから今さら、そんな芝居をしたところで茶番でしかない。"
  },
  {
   "id": "clah08:13900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "……まあ、最初から茶番は茶番なんだけど。"
  },
  {
   "id": "clah08:14000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "아리무라 에미",
   "jp": "とはいえ、それを口に出すか出さないかの選択は、僕の意思がどこにあるのかを示すことにもなる。"
  },
  {
   "id": "clah08:14100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "아리무라 에미",
   "jp": "台本通りに進めるということは、有村の作戦に乗る意思がある、ということだ。"
  },
  {
   "id": "clah08:14200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "아리무라 에미",
   "jp": "有村の作戦に乗ると言うことは、彼女をここに泊めおくことも⟦rb⟧吝⟦rt⟧やぶさ⟦/r⟧かではないと表明するのと同義だ。"
  },
  {
   "id": "clah08:14300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "아리무라 에미",
   "jp": "逆に、僕が早いところ有村を連れて帰って欲しいと願っているのなら、有村の仕掛けた茶番に乗らなければいい。"
  },
  {
   "id": "clah08:14400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "아리무라 에미",
   "jp": "僕としては当然、早く平穏な自分だけの時間を取り戻したいわけで、どちらを選択するかは今さら考える必要もないことだった。"
  },
  {
   "id": "clah08:14500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": null,
   "next_speaker": "아리무라 히나에",
   "jp": "「雛絵。馬鹿みたいな意地を張るのはやめて、いい加減帰ってきなさい」"
  },
  {
   "id": "clah08:14600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「…………」"
  },
  {
   "id": "clah08:14700",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「こちらの……宮代さん、だったかしら？ あなたにも随分と迷惑かけてるでしょう？」"
  },
  {
   "id": "clah08:14800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 히나에",
   "jp": "「僕は……」"
  },
  {
   "id": "clah08:14900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そう、今さら考える必要もないことだった――はずなのに。"
  },
  {
   "id": "clah08:15000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "悔しいけど、僕はこの生活がもう少し続けばいいなと、たぶんそう思っている――。"
  },
  {
   "id": "clah08:15100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "……だから。"
  },
  {
   "id": "clah08:15200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
