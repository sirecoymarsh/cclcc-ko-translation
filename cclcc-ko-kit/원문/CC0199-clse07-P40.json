   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「結衣っ！！」"
  },
  {
   "id": "clse07:386000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「とにかく、私たちが来たからもう大丈夫だから……」"
  },
  {
   "id": "clse07:386100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「ああ、拓留。良かった。今ちょうど、部室に向かおうと思ってたところだったんだけど、手間がはぶけたわ」"
  },
  {
   "id": "clse07:386200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「その様子だと、やっぱり忘れてたわね」"
  },
  {
   "id": "clse07:386300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「今日は、うきと結衣の進路のことで、家に先生が来るから、部活は休むって前に言ってたはずだけど」"
  },
  {
   "id": "clse07:386400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「そういうことだから、よろしく頼むわね」"
  },
  {
   "id": "clse07:386500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「……まさか、部室に閉じ込められてただなんて……」"
  },
  {
   "id": "clse07:386600",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「こんばんは、久野里さん」"
  },
  {
   "id": "clse07:386700",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「結人ってば、学校から帰るなり、なんだか張り切ってお弁当を作ってるから、何事かと思ってたんですよ。訊いても何も教えてくれないし」"
  },
  {
   "id": "clse07:386800",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ね、結人？」"
  },
  {
   "id": "clse07:386900",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「うん、いい匂い。もうちょっと早く来れば、一緒に食べられたかなぁ？」"
  },
  {
   "id": "clse07:387000",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ね、結人？ 今度は、お姉ちゃんにもごちそうしてね？」"
  },
  {
   "id": "clse07:387100",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「さぁ、困ったわね、結人？」"
