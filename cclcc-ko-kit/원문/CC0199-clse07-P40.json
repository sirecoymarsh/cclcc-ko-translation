{
 "packet_id": "CC0199-clse07-P40",
 "kit_version": "1.0",
 "source_file": "clse07.msb",
 "speakers_in_packet": [
  "미나미사와 센리",
  "쿠루스 노노"
 ],
 "context_before": [
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「拓留？ どうしたの？」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「あ、うきも先に帰っておいてくれるかしら？」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「悪いわね。お願い」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「あのね……結衣の相談にのってあげて欲しいの」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「ええ。あの子、最近いろいろと悩みがあるみたいで……」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「ほら、拓留が出ていく前は、父さんの手伝いとかやってくれてたのは知ってるでしょ？」"
  }
 ],
 "entries": [
  {
   "id": "clse07:377300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「でも、今はうきがいるじゃない？ 父さんの手伝いも、家の手伝いもあの子が進んでやってくれるようになって……」"
  },
  {
   "id": "clse07:377400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「自分でもダメってわかってても、どうしても比較しちゃうみたいなの……」"
  },
  {
   "id": "clse07:377500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それで最近、いろいろと悩むようになって……」"
  },
  {
   "id": "clse07:377600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……私もそれとなく訊いてみようとしたことはあったの。でも、はぐらかされちゃって……」"
  },
  {
   "id": "clse07:377700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私ってほら、少し口うるさいところがあるでしょ？ だから言いにくいのかもしれないし、その点、拓留ならって……」"
  },
  {
   "id": "clse07:377800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「⟦rb⟧結衣⟦rt⟧あのこ⟦/r⟧、拓留に懐いてるところもあるし……」"
  },
  {
   "id": "clse07:377900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それはそうだけど……」"
  },
  {
   "id": "clse07:378000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留〜……？」"
  },
  {
   "id": "clse07:378100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「関係ない？ 今、関係ないって言ったわよね？」"
  },
  {
   "id": "clse07:378200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「家族の将来の話をしているのに関係ないですって？ まさか、本気で言ったんじゃないでしょうね！」"
  },
  {
   "id": "clse07:378300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……そう。だったらいいんだけど」"
  },
  {
   "id": "clse07:378400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あら？ 結人だけ？ うきや結衣は？」"
  },
  {
   "id": "clse07:378500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうだった？」"
  },
  {
   "id": "clse07:378600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほ、ほら、拓留。私のおかずもあげるから、たくさん食べなさい」"
  },
  {
   "id": "clse07:378700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はい、お粗末様でした」"
  },
  {
   "id": "clse07:378800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「宿題は？」"
  },
  {
   "id": "clse07:378900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うん……だったらいいわよ」"
  },
  {
   "id": "clse07:379000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こら、結衣」"
  },
  {
   "id": "clse07:379100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あら。拓留だって“ケイさん”に傾倒してたじゃない。それと一緒よ」"
  },
  {
   "id": "clse07:379200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしたの？」"
  },
  {
   "id": "clse07:379300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうよ。あの高柳桃寧って人、口パクだったことを逆手にとって、今や口パクアイドルとして、ニヤ生でブレイク中……って、あら？ もしかして拓留、知らなかったの？」"
  },
  {
   "id": "clse07:379400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうよね、拓留に限って、そんなわけないわよねぇ」"
  },
  {
   "id": "clse07:379500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ダメよ、結衣、アイドル活動なんて」"
  },
  {
   "id": "clse07:379600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いい？ 芸能活動っていうのは一見華やかに見えるけど、苦労だって多いのよ」"
  },
  {
   "id": "clse07:379700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「簡単にできるように見えて、たくさんの人が協力してくれて初めてできることなの」"
  },
  {
   "id": "clse07:379800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それに勉強と両立するのだって大変なんだから。あなたにそれができる？」"
  },
  {
   "id": "clse07:379900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「今でも宿題いっぱいって泣き言いってるのに？」"
  },
  {
   "id": "clse07:380000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それは……」"
  },
  {
   "id": "clse07:380100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「確かにうちはお金があるわけじゃないけど、それでも私たちみんなが食べていくくらいは、きちんと父さんが稼いでくれてるわ」"
  },
  {
   "id": "clse07:380200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それに、ネットで配信するということは、不特定多数の人が見るってことになるのよ。それがどういうことだかわかる？」"
  },
  {
   "id": "clse07:380300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「たくさんの知らない人が、自分の顔を知ることになるのよ。その中には、ひょっとしたらおかしな人だっているかもしれない」"
  },
  {
   "id": "clse07:380400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それでもし、何かあったらどうするつもり？」"
  },
  {
   "id": "clse07:380500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「結衣の気持ちはわかるわ。私だって、結衣みたいにアイドルに憧れたことだってあるもの」"
  },
  {
   "id": "clse07:380600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なに？」"
  },
  {
   "id": "clse07:380700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「確かに、今の世の中、アイドルの真似事は簡単にできちゃうかもしれない」"
  },
  {
   "id": "clse07:380800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「でもね、本気でやろうと思ったら、それこそお金だってかかるし、個人の力でそう簡単にできるものじゃないの」"
  },
  {
   "id": "clse07:380900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あなたならわかるわよね、結衣……」"
  },
  {
   "id": "clse07:381000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それじゃあ……」"
  },
  {
   "id": "clse07:381100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……拓、留……？」"
  },
  {
   "id": "clse07:381200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ねえ……拓留……どこにいるの？ 返事をして……」"
  },
  {
   "id": "clse07:381300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「昏くて、何も見えないの……だから、お願い……」"
  },
  {
   "id": "clse07:381400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留……昏いの……助けて……」"
  },
  {
   "id": "clse07:381500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ただいま帰りました」"
  },
  {
   "id": "clse07:381600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ねえ、結衣。タクルの姿が見えないんだけど、どこに行ったか知ら――」"
  },
  {
   "id": "clse07:381700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留……」"
  },
  {
   "id": "clse07:381800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あら、タクル。良かったわねぇ。結衣に遊んでもらえて」"
  },
  {
   "id": "clse07:381900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふふっ。タクル。良い子にしてたみたいね」"
  },
  {
   "id": "clse07:382000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほら、タクル。いらっしゃい。良い子良い子してあげる」"
  },
  {
   "id": "clse07:382100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よしよし、いいこいいこ」"
  },
  {
   "id": "clse07:382200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あん！ もう！」"
  },
  {
   "id": "clse07:382300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしたの？」"
  },
  {
   "id": "clse07:382400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:382500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ねえ、結衣。拓留の姿が見えないんだけど、どこに行ったか知ら――」"
  },
  {
   "id": "clse07:382600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留……」"
  },
  {
   "id": "clse07:382700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「違う？ 何が違うっていうの？」"
  },
  {
   "id": "clse07:382800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それは……どういうことかしら、結衣？」"
  },
  {
   "id": "clse07:382900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私たちの……関係？ 私には資格がない……？」"
  },
  {
   "id": "clse07:383000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そう……」"
  },
  {
   "id": "clse07:383100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っ……」"
  },
  {
   "id": "clse07:383200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
