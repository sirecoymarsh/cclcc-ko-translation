  {
   "id": "clse07:384500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そう？ だったらいいんだけど……」"
  },
  {
   "id": "clse07:384600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そういえば拓留。最近、結衣たちとよく一緒にいるみたいだけど……」"
  },
  {
   "id": "clse07:384700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ありがと。ここのところ、結衣も結人も嬉しそうにしてるし、拓留が帰って来てくれたおかげだわ」"
  },
  {
   "id": "clse07:384800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それじゃあ、やっぱり……」"
  },
  {
   "id": "clse07:384900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「その＠ちゃんねるの書き込みから、ふたりを連れていた人間を探すことは出来ないんですか？」"
  },
  {
   "id": "clse07:385000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留！ この配信止められないの！？」"
  },
  {
   "id": "clse07:385100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「大丈夫よ……きっと一緒にいるわ」"
  },
  {
   "id": "clse07:385200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしかしたら……」"
  },
  {
   "id": "clse07:385300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「何か秘密を握られている……とか？」"
  },
  {
   "id": "clse07:385400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どういうこと、結人？」"
  },
  {
   "id": "clse07:385500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしたの……結人？」"
  },
  {
   "id": "clse07:385600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしかして……話せるの？ 結衣と……」"
  },
  {
