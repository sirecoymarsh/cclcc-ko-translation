 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "結衣が悩み、ね……。"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「ほら、拓留が出ていく前は、父さんの手伝いとかやってくれてたのは知ってるでしょ？」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「まあ……」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "あまり進んで、という感じではなかったけど、それでも青葉寮の一員として一生懸命手伝おうとしている姿勢は見えた。"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「でも、今はうきがいるじゃない？ 父さんの手伝いも、家の手伝いもあの子が進んでやってくれるようになって……」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「居場所がとられちゃったってわけか……」"
  }
 ],
 "entries": [
  {
   "id": "clyu01:30000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "乃々は小さく頷いた。"
  },
  {
   "id": "clyu01:30100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "確かに、うきは他人のために尽くすことが生きがいみたいなところがある。"
  },
  {
   "id": "clyu01:30200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "今まで結衣がやっていたようなことも、本人が気づくよりも先にやってしまうのだそうだ。"
  },
  {
   "id": "clyu01:30300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "しかも、非のつけようのないクオリティで……。"
  },
  {
   "id": "clyu01:30400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "そんな状況だから、自然と⟦col:280aa02d1400⟧青葉医院⟦col:800000⟧に来る患者さんの覚えも良くなる。"
  },
  {
   "id": "clyu01:30500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "となると――。"
  },
  {
   "id": "clyu01:30600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「自分でもダメってわかってても、どうしても比較しちゃうみたいなの……」"
  },
  {
   "id": "clyu01:30700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それで最近、いろいろと悩むようになって……」"
  },
  {
   "id": "clyu01:30800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "なるほどね。"
  },
  {
   "id": "clyu01:30900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣は以前、大人になったら看護師さんになって、父さんの手伝いをしようかな……なんて言っていたこともある。"
  },
  {
   "id": "clyu01:31000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もちろん、それは会話の中でふと出てきた言葉だったし、父さんを喜ばせるためでもあったとは思うけど……。"
  },
  {
   "id": "clyu01:31100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それでも、あの年頃の女の子を悩ませるには充分な状況であるのかもしれない。"
  },
  {
   "id": "clyu01:31200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「話はわかったよ。でもなんで僕なんだ？ 相談なら来栖が乗ってやればいいだろ？」"
  },
  {
   "id": "clyu01:31300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……私もそれとなく訊いてみようとしたことはあったの。でも、はぐらかされちゃって……」"
  },
  {
   "id": "clyu01:31400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "となると、家にいて話が聞けるのは、父さんと結人とうきくらいか。"
  },
  {
   "id": "clyu01:31500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "その中でうきは原因でもあるわけで、結人も相談できる年でもない。"
  },
  {
   "id": "clyu01:31600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "父さんは……あのとおりの人だから。"
  },
  {
   "id": "clyu01:31700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「私ってほら、少し口うるさいところがあるでしょ？ だから言いにくいのかもしれないし、その点、拓留ならって……」"
  },
  {
   "id": "clyu01:31800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「⟦rb⟧結衣⟦rt⟧あのこ⟦/r⟧、拓留に懐いてるところもあるし……」"
  },
  {
   "id": "clyu01:31900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "なんだよ。そんなこと言ってるけど、結局は消去法じゃないか。"
  },
  {
   "id": "clyu01:32000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「でも、そういう悩みなら誰だってあるもんじゃないのか」"
  },
  {
   "id": "clyu01:32100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それはそうだけど……」"
  },
  {
   "id": "clyu01:32200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「だいいち、悩みが深刻なら、そのうち自分から言ってくるだろ。それに僕にあの年頃の女の子の相談に乗れるとも思えないし、そもそも僕には関係な――」"
  },
  {
   "id": "clyu01:32300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留〜……？」"
  },
  {
   "id": "clyu01:32400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「あ……」"
  },
  {
   "id": "clyu01:32500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "ヤバイ。乃々の声のトーンが上がった。"
  },
  {
   "id": "clyu01:32600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "これはまた……踏んじゃったか？"
  },
  {
   "id": "clyu01:32700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「関係ない？ 今、関係ないって言ったわよね？」"
  },
  {
   "id": "clyu01:32800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「あ、いや、今のはそれこそ、言葉のあやというやつで……」"
  },
  {
   "id": "clyu01:32900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「家族の将来の話をしているのに関係ないですって？ まさか、本気で言ったんじゃないでしょうね！」"
  },
  {
   "id": "clyu01:33000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「あー！ そういや、ちょうど久しぶりに家に顔出そうかと思ってたんだよな！」"
  },
  {
   "id": "clyu01:33100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「せっかくだからしばらくの間、家で結衣の様子でもみてみようかと思うんだけど、どうだろ？」"
  },
  {
   "id": "clyu01:33200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……そう。だったらいいんだけど」"
  },
  {
   "id": "clyu01:33300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "「…………」"
  },
  {
   "id": "clyu01:33400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "頭の中で尾上の声が聞こえた。"
  },
  {
   "id": "clyu01:33500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『ほんと、タクはのんちゃんには弱いねぇ……』"
  },
  {
   "id": "clyu01:33600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "大きなお世話だ。自分でもわかってるよ。"
  },
  {
   "id": "clyu01:33700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "타치바나 유토",
   "jp": "「ただいま」"
  },
  {
   "id": "clyu01:33800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あれぇ？ 拓留兄ちゃん！？」"
  },
  {
   "id": "clyu01:33900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "伺うように家に上がると、僕の姿を見た結人が目を丸くした。"
  },
  {
   "id": "clyu01:34000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「久しぶり」"
  },
  {
   "id": "clyu01:34100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうしたの？ 帰って来たの？」"
  },
  {
   "id": "clyu01:34200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「まあ、しばらく……」"
  },
  {
   "id": "clyu01:34300",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうして？」"
  },
  {
   "id": "clyu01:34400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「たまには結人たちの顔が見たくなってさ」"
  },
  {
   "id": "clyu01:34500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "「ほんと！？ やった！ 僕も拓留兄ちゃんに会いたかったよ」"
  },
  {
   "id": "clyu01:34600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "쿠루스 노노",
   "jp": "乃々に脅されて、なんて本当のことは言えない。"
  },
  {
   "id": "clyu01:34700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "쿠루스 노노",
   "jp": "それに、帰る道すがら、僕の中では少しだけ思考に変化があった。"
  },
  {
   "id": "clyu01:34800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "쿠루스 노노",
