   "id": "claa01:19700",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「う、ウチに帰ったら言うつもりだったんだよぉ」"
  },
  {
   "id": "claa01:19800",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「うん、いい匂い。もうちょっと早く来れば、一緒に食べられたかなぁ？」"
  },
  {
   "id": "claa01:19900",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「ね、結人？ 今度は、お姉ちゃんにもごちそうしてね？」"
  },
  {
   "id": "claa01:20000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "쿠노사토 미오",
   "jp": "「も、もちろんだよ！ これは、ほら、実験っていうか！ 泉理姉ちゃんに食べてもらう前の試食っていうか！」"
  },
  {
   "id": "claa01:20100",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「ほほう、私は実験台で試食係だったんだな。よーく分かった」"
  },
  {
   "id": "claa01:20200",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "미나미사와 센리",
   "jp": "「ええっ！？ あ、ち、ちち違うよ！ 試食とか実験とかウソ！ ちょっと言ってみただけだから！ それだけだから！」"
  },
  {
   "id": "claa01:20300",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "쿠노사토 미오",
   "jp": "「さぁ、困ったわね、結人？」"
  },
  {
   "id": "claa01:20400",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "야마조에 우키",
   "jp": "「ここに山添までいたら、さらに大変だったな」"
