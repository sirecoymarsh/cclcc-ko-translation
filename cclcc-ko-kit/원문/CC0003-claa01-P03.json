   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「帰りが少し遅いから、心配して迎えに来たの。……遅くなるなら、連絡くらいして欲しい」"
  },
  {
   "id": "claa01:21100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "쿠노사토 미오",
   "jp": "「あっ、そっか。ゴメンなさい。つい――」"
