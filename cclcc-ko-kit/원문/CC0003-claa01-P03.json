  {
   "id": "claa01:20900",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「っていうか、うき姉ちゃんまで、何しに来たんだよ〜？」"
