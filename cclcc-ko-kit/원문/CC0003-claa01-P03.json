{
 "packet_id": "CC0003-claa01-P03",
 "kit_version": "1.0",
 "source_file": "claa01.msb",
 "speakers_in_packet": [
  "미나미사와 센리",
  "아리무라 히나에",
  "야마조에 우키",
  "쿠노사토 미오",
  "타치바나 유토"
 ],
 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "そして、タッパーを三つほど引っ張り出して、テーブルの上に置いた。"
  },
  {
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "jp": "「ま、まだあんまり上手じゃないんだけど……お弁当を作って来たんだ」"
  },
  {
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "jp": "「え？」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "澪は、これまた彼女にしては珍しいくらい素直に目を丸くした。"
  },
  {
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "jp": "「あ、もちろん学校から一度家に帰って、新しく作って来たお弁当だよ。まだちょっとあったかいけど……レンジであっためるね」"
  },
  {
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "jp": "「あ、ああ……悪いな」"
  }
 ],
 "entries": [
  {
   "id": "claa01:13900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "타치바나 유토",
   "jp": "まだ意表をつかれたような顔で結人を見上げている澪を置いて、結人はキッチンへ行くと、レンジであたため直し始めた。"
  },
  {
   "id": "claa01:14000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "아리무라 히나에",
   "jp": "「あ、でも困ったなあ。雛絵お姉ちゃんが来るとは思ってなかったから、二人分しか作ってこなかったよ」"
  },
  {
   "id": "claa01:14100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「それなら大丈夫。今から華の所へ行って、決着つけることになったからっ」"
  },
  {
   "id": "claa01:14200",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「仲直りするの？」"
  },
  {
   "id": "claa01:14300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「違うっ、決着をつけるんだっ。――それじゃあ、ユウ！ あんまり遅くなる前に帰りなよっ」"
  },
  {
   "id": "claa01:14400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "타치바나 유토",
   "jp": "それだけ言うと、⟦rb⟧憤懣⟦rt⟧ふんまん⟦/r⟧やるかたない表情のまま、雛絵はバタバタと久野里のアパートを飛び出していった。"
  },
  {
   "id": "claa01:14500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "타치바나 유토",
   "jp": "まぁ、おそらく数時間後には雛絵も華も、なんで喧嘩をしていたのかすら思い出せないくらい仲の良い関係に戻っているのだろうが……。"
  },
  {
   "id": "claa01:14600",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠노사토 미오",
   "jp": "「はい、おまたせ。ええと……実は、まだあんまり自信がないんだ。おいしくなかったら、ごめんなさい」"
  },
  {
   "id": "claa01:14700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "レンジであたため直したタッパーの中身を、四つほどの手ごろなお皿に盛りつけ、結人はそれをテーブルの上に広げた。"
  },
  {
   "id": "claa01:14800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "同じくタッパーに詰めてきたご飯を、適当なお茶碗ふたつに分ける。"
  },
  {
   "id": "claa01:14900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "室内に、ちょっとだけ焦げたような、でもとてもあたたかな香りが広がった。"
  },
  {
   "id": "claa01:15000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠노사토 미오",
   "jp": "「えっとね、まだ作れるレパートリーが少なくて……これがきのこハンバーグでしょ。こっちは刻んだベーコン入りの卵焼き」"
  },
  {
   "id": "claa01:15100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠노사토 미오",
   "jp": "「あと、鶏肉とモヤシとキャベツの炒めモノ。モヤシを多くすると、鶏肉が少なくても、たくさんに見えるんだよ。えへへ」"
  },
  {
   "id": "claa01:15200",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": null,
   "next_speaker": "쿠노사토 미오",
   "jp": "「で、最後に、余ったキャベツをお豆腐と一緒にサラダにしてきましたー」"
  },
  {
   "id": "claa01:15300",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「すごいな、結人。もう立派なシェフじゃないか」"
  },
  {
   "id": "claa01:15400",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「ううん、それがねー！ うき姉ちゃんにどうしても勝てないんだよー。ほら、あちこち焦げちゃってるし……」"
  },
  {
   "id": "claa01:15500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "確かに、ハンバーグや野菜のあちこちに、いささか火を通し過ぎた痕跡が見える。少し焦げ臭いのも、そのせいだろう。"
  },
  {
   "id": "claa01:15600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "⟦top:38⟧でも、澪にとって、そんなことはどうでもよかった。"
  },
  {
   "id": "claa01:15700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "こんなごちそう、たぶん彼女は、今までに一度も食べたことなどなかったと思う。"
  },
  {
   "id": "claa01:15800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「わ！？ あの、あの！？ どうしたの！？ 何か嫌いなモノとか入ってた！？」"
  },
  {
   "id": "claa01:15900",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「……え？」"
  },
  {
   "id": "claa01:16000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "自分でも意外すぎて、澪は慌てて、手の甲で両の眼をぬぐった。"
  },
  {
   "id": "claa01:16100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "それでも、瞳から静かにあふれてくるものが止まらない。"
  },
  {
   "id": "claa01:16200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "自分だけ、こんな幸せを受け入れてしまっていいのだろうか？"
  },
  {
   "id": "claa01:16300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "かつてアメリカで行ってしまった愚かな行為。"
  },
  {
   "id": "claa01:16400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "そして、今、この瞬間も冷たい獄中で孤独に耐えている“彼”。"
  },
  {
   "id": "claa01:16500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "⟦top:38⟧彼ら彼女らへの追憶が、なぜか目の前の少年と重なっていた。"
  },
  {
   "id": "claa01:16600",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「いや、驚かせてすまない。こんなに豪華な食事、いったい何か月ぶりだろう、と感動したんだ」"
  },
  {
   "id": "claa01:16700",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「ええ？ そんな、たいしたものじゃないよ〜？」"
  },
  {
   "id": "claa01:16800",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「食べても、いいか？」"
  },
  {
   "id": "claa01:16900",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「うん。それでね、もっとこうした方がいいとか言ってね。僕、うき姉ちゃんに絶対、勝つんだから」"
  },
  {
   "id": "claa01:17000",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「ああ、分かった。――いただきます」"
  },
  {
   "id": "claa01:17100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "타치바나 유토",
   "jp": "いつもの澪の食事といえば、とにかくカロリーさえ摂取できればいいとばかりに、ラーメンなどをろくに噛みもせずに飲み込んでいくだけだった。"
  },
  {
   "id": "claa01:17200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "타치바나 유토",
   "jp": "⟦top:38⟧でも今夜の澪は、結人が作ってくれたものを一口ずつゆっくりと食べていった。"
  },
  {
   "id": "claa01:17300",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「……ど、どう？」"
  },
  {
   "id": "claa01:17400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "쿠노사토 미오",
   "jp": "澪と一緒に自分の料理に箸をつけつつ、ドキドキしながら上目遣いに聞いてくる結人。何度も、何度も。"
  },
  {
   "id": "claa01:17500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "쿠노사토 미오",
   "jp": "そのたびに澪は、もしここに雛絵や神成がいたら『この久野里澪は、絶対にニセモノだ！』と言い出しかねないほど優しい笑みを浮かべる。"
  },
  {
   "id": "claa01:17600",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「うん。美味しいよ、結人」"
  },
  {
   "id": "claa01:17700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "確かにちょっと焼き過ぎていたり、逆に半生だったり、味付けのバランスが悪かったりするものも多かったが……それでも、こんなに美味しい食事は初めてだったのだ。"
  },
  {
   "id": "claa01:17800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "⟦top:76⟧やがて澪は、ひとつも残すことなく結人の料理を食べ終えると、『ごちそうさま』と言って、もう一度ニッコリ微笑んだ。"
  },
  {
   "id": "claa01:17900",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「これならいずれ、山添だけでなく、南沢泉理だって追い越せるだろう」"
  },
  {
   "id": "claa01:18000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「えー？ それは無理だよー」"
  },
  {
   "id": "claa01:18100",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「そんなことはないさ。最初から無理だと決めつけていてはダメだ」"
  },
  {
   "id": "claa01:18200",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「そう……かなあ」"
  },
  {
   "id": "claa01:18300",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「この私が保証してやる。オマエならあっという間に上達する」"
  },
  {
   "id": "claa01:18400",
