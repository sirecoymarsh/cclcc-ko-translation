   "id": "claa01:20700",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "야마조에 우키",
   "jp": "「山添。お前は少し影が薄すぎる。もう少し濃くしろ」"
