  {
   "id": "claa01:19600",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "타치바나 유토",
   "jp": "「ね、結人？」"
