   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「うふふ、冗談です。ちょっといじわるでしたね。今度は私の料理も食べて、感想を聞かせてください」"
  },
  {
   "id": "claa01:21600",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유토",
   "jp": "「あ、ああ、もちろん」"
  },
  {
   "id": "claa01:21700",
