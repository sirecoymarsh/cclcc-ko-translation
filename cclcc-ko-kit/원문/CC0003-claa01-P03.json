  {
   "id": "claa01:20800",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "타치바나 유토",
   "jp": "「すみません。以後、気をつけます」"
