   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、有村のことだから『夕飯にカップ麺とか、本気ですか？』くらい言われるんじゃないかと思ったんだけど……」"
  },
  {
   "id": "clse07:444100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうだな。あとはコンビニで弁当買ったり、カロリーブロックだったり……」"
  },
  {
   "id": "clse07:444200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お前まで来栖みたいなことを言うなよ」"
  },
  {
   "id": "clse07:444300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふあぁぁ……」"
  },
  {
   "id": "clse07:444400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？ あ、そ、そうだな、うん」"
  },
  {
   "id": "clse07:444500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、有村はそこの布団使っていいから」"
  },
  {
   "id": "clse07:444600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕は寝袋があるから……」"
  },
  {
   "id": "clse07:444700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「じょ、女子を寝袋で寝かすわけにもいかないだろ」"
  },
  {
   "id": "clse07:444800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ばっ！ ばばばばばばばばバカなこと言うな！」"
  },
  {
   "id": "clse07:444900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕はいつだって紳士だ」"
  },
  {
   "id": "clse07:445000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そ、そんなわけあるか！」"
  },
  {
   "id": "clse07:445100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それ……なにやってんだ？」"
  },
  {
   "id": "clse07:445200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
