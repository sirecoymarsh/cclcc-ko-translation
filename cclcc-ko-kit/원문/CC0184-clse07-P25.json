   "id": "clse07:238100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「というわけで、一緒にお風呂入ろうよ。宮代先輩♪」"
