   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「大丈夫だよ。もう全部見ちゃったし。なかなかいいモノ持ってるね先輩」"
