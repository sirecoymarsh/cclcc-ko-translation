   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それが、利用してる、かも」"
  },
  {
   "id": "clse07:241300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わかんないわね。利用してるって、誰が？」"
  },
  {
   "id": "clse07:241400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ん……」"
