   "speaker_ko": "여학생",
   "prev_speaker": "히카리 엄마",
   "next_speaker": null,
   "jp": "「でも、それくらい……」"
  },
  {
   "id": "clse07:882600",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": "히카리 엄마",
   "next_speaker": null,
   "jp": "「なになに……？」"
  },
  {
   "id": "clse07:882700",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あたしも、生徒会長にはお世話になったし……」"
  },
  {
   "id": "clse07:882800",
   "type": "dialogue",
   "speaker": "女子生徒",
