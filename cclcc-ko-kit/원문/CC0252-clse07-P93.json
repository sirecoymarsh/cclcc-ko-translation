   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": "여자",
   "jp": "「何言ってるの。私！！」"
  },
  {
   "id": "clse07:887200",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": "여자",
   "jp": "「あ、生徒会長。さようなら」"
  },
  {
   "id": "clse07:887300",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": "여자",
   "jp": "「来栖先輩、ごきげんよう」"
  },
  {
   "id": "clse07:887400",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": "여자",
   "jp": "「あ、ねえ、乃々！ 一緒にお昼――」"
  },
  {
   "id": "clse07:887500",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": "여자",
   "jp": "「なに？ また生徒会？」"
  },
  {
   "id": "clse07:887600",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": "여자",
   "jp": "「こんな時期になってまで大変だよねぇ……」"
  },
  {
   "id": "clse07:887700",
   "type": "dialogue",
   "speaker": "女",
   "speaker_ko": "여자",
   "prev_speaker": "여학생",
   "next_speaker": "야마조에 우키",
   "jp": "「うきちゃんはいつもお手伝いして、小さいのに偉いねぇ」"
  },
  {
   "id": "clse07:887800",
   "type": "dialogue",
   "speaker": "女",
   "speaker_ko": "여자",
   "prev_speaker": "여학생",
   "next_speaker": "야마조에 우키",
   "jp": "「ほら、飴ちゃんあげる。あとでお食べ」"
  },
  {
   "id": "clse07:887900",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「………。いますが、何か？」"
  },
  {
   "id": "clse07:888000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「すみません。以後、気をつけます」"
  },
  {
   "id": "clse07:888100",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「帰りが少し遅いから、心配して迎えに来たの。……遅くなるなら、連絡くらいして欲しい」"
  },
  {
   "id": "clse07:888200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「ええ？ 久野里さんでも、うっかりすることなんてあるんですね。ユウのお弁当に感激して……とか？」"
  },
  {
   "id": "clse07:888300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「うふふ、冗談です。ちょっといじわるでしたね。今度は私の料理も食べて、感想を聞かせてください」"
  },
  {
   "id": "clse07:888400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「そうですね。ははは……」"
  },
  {
   "id": "clse07:888500",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「あ、えと、すみません。私……今、ちょっと“だいえっと”を……」"
  },
  {
   "id": "clse07:888600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "여자",
   "next_speaker": null,
   "jp": "「で、でも、姉さん……私ね、最近なんか急に体重が増えて来ちゃってるの。お洋服も、胸やお尻のあたりとか、すごくキツイし……」"
  },
  {
   "id": "clse07:888700",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え……？」"
  },
  {
   "id": "clse07:888800",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……？ あの？」"
  },
  {
   "id": "clse07:888900",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほんとう……？」"
  },
  {
   "id": "clse07:889000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「う、うん……」"
  },
  {
   "id": "clse07:889100",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「………」"
  },
  {
   "id": "clse07:889200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ね、姉さんの言う通りです」"
  },
  {
   "id": "clse07:889300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、あの、私はえっと……どちらも素敵だと……ですよね、拓留さん？」"
  },
