   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「近づいたら妊娠しちゃうんじゃない？」"
  },
  {
   "id": "clse07:884000",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
