  },
  {
   "id": "clse07:883400",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、会長。おはようございまーす」"
