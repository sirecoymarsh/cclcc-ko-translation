   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「にゃい、だって」"
  },
  {
   "id": "clse07:885700",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしかしたら、あの子たちも毒牙に……？」"
  },
  {
