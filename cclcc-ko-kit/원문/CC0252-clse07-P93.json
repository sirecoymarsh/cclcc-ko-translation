  {
   "id": "clse07:883500",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「見て見て、ほら、あの人……」"
