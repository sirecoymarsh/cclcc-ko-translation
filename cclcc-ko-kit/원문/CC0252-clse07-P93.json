   "id": "clse07:884300",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「みんなだって従ってるんだし……」"
  },
  {
   "id": "clse07:884400",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「会長、何言ってるの？」"
  },
  {
   "id": "clse07:884500",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あんなメンドくさいこと、あたしなら頼まれてもヤだし……」"
  },
  {
   "id": "clse07:884600",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": null,
