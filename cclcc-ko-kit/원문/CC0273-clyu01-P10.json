   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "jp": "「あれぇ？ お姉ちゃんたち、こんな時間になにしてるの？」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "トイレにでも起きてきて、さっきの僕たちの声を耳にしたのだろう。"
  }
 ],
 "entries": [
