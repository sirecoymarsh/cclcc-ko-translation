   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "쿠루스 노노",
   "jp": "有村との同居生活を知られまいと意識するあまり、ついムキになって否定してしまった。"
  },
  {
   "id": "clah02:5300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留。もしかして、有村さんとケンカでもしたの？」"
