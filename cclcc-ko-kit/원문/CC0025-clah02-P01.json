  {
   "id": "clah02:1000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あぁ、やっと起きた♪」"
  },
  {
   "id": "clah02:1100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「こ、殺す気か！！！」"
  },
  {
   "id": "clah02:1200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ、もしかして死んじゃったかと思いました？ まー、無理ないっすよねー。だって、起きたら目の前に天使がいるんですもーん」"
  },
  {
   "id": "clah02:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「そうじゃない！ お前、いま僕の鼻と口、つまんでただろ！ ふつう朝ってのは、もっと優しく起こすもんじゃないのか？」"
  },
  {
   "id": "clah02:1400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「最初はそうしてましたよ。でも、ずっと起こしてるのに、先輩ってば全然起きないんだもん」"
  },
  {
   "id": "clah02:1500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「危うく永久に起きられなくなるところだったぞ！」"
  },
  {
   "id": "clah02:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "最初、優しく起こしたってのも、怪しいものだ。"
  },
  {
   "id": "clah02:1700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「昨日の夜だって、さっさとグッスリ眠っちゃってさー」"
  },
  {
   "id": "clah02:1800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「は？」"
  },
  {
   "id": "clah02:1900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんでもないですよーだ」"
  },
  {
   "id": "clah02:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "なんなんだ、いったい。"
  },
  {
   "id": "clah02:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「それより、有村。今日は家に――」"
  },
  {
   "id": "clah02:2200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「帰りませんよ。今日帰ったら、家出じゃなくてただの無断外泊じゃないっすか」"
  },
  {
   "id": "clah02:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "……もしかしたら、ひと晩経てば、帰る気になるかとも思ったけど、どうやら僕の考えが甘かったようだ。"
  },
  {
   "id": "clah02:2400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「いいか？ しばらくここに泊まってることは、誰にも知られないようにするんだぞ」"
  },
  {
   "id": "clah02:2500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「はいはい、わかってますわかってます」"
  },
  {
   "id": "clah02:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "本当にわかってるんだろうか。"
  },
  {
   "id": "clah02:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "仮に誰かに知られた場合、たとえ僕たちの間に何ら疚しいことは無かったとしても、憶測が憶測を呼んで妙なことにならないとも限らない。"
  },
  {
   "id": "clah02:2800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「だいたい、知られて一番困るのは先輩より私ですし」"
  },
  {
   "id": "clah02:2900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "それもそうだ。"
  },
  {
   "id": "clah02:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "こういうのは男子よりも女子の方がいろいろとダメージがデカい。"
  },
  {
   "id": "clah02:3100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「そんじゃ私、先に行きますねー。あでぃおすぐらっしぁ〜♪」"
  },
  {
   "id": "clah02:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "大丈夫か、あいつ……。"
  },
  {
   "id": "clah02:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "……という僕の不安をよそに、放課後までは特に何か起こるでもなく、つつがなく時間は過ぎて行った。"
  },
  {
   "id": "clah02:3400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "都市部にあるにしては、うちの学校の校舎はそれなりの大きさを誇っている。"
  },
  {
   "id": "clah02:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "そんな中、僕は三年で有村は二年。"
  },
  {
   "id": "clah02:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "学年が違えば、そうそう顔を合わせることもない。"
  },
  {
   "id": "clah02:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "顔を合わせることもなければ、不用意に接触することもなく、誰かの前で不用意に話をして誰かに感づかれることもないのだ。"
  },
  {
   "id": "clah02:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "とはいえ、油断は禁物だ。"
  },
  {
   "id": "clah02:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "とにかく、誰かに気づかれることだけは避けなければならない。"
  },
  {
   "id": "clah02:4000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ねえ、タク。ひなちゃん、今日は部活来るかなぁ？」"
  },
  {
   "id": "clah02:4100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「し、知らないよ。なんで僕に訊くんだ？」"
  },
  {
   "id": "clah02:4200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だって、タク、ひなちゃんと仲良しでしょ？」"
  },
  {
   "id": "clah02:4300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「ぼ、僕は別に有村と特別仲がいいわけじゃない！！」"
  },
  {
   "id": "clah02:4400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
