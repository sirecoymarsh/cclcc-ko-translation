   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "考えるよりも先に、確かめたほうが早いな。"
  },
  {
   "id": "clyu01:62000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "そう心に決めて、今にも声をかけようとしたその時、部屋のドアがゆっくりと開かれた。"
  },
  {
   "id": "clyu01:62100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留兄ちゃん……もう寝ちゃったの？」"
  },
  {
   "id": "clyu01:62200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "扉の隙間から恐る恐る覗き込んだのは、結人だった。"
  },
  {
   "id": "clyu01:62300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「結人……どうした？」"
  },
  {
   "id": "clyu01:62400",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「良かった。まだ起きてたんだ」"
  },
  {
   "id": "clyu01:62500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結人は安心したような笑みを浮かべると、僕の部屋へと入って来た。"
  },
  {
   "id": "clyu01:62600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「ダメじゃないか、こんな時間まで起きてちゃ」"
  },
  {
   "id": "clyu01:62700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "結人はまだ１３歳だ。"
