  {
   "id": "clyu01:62800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "１３歳にもなれば、それなりに夜更かしもする歳かもしれないが、それでも起きていて怒られるのは結人だ。"
  },
  {
   "id": "clyu01:62900",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ごめんなさい。でも、僕……どうしても拓留兄ちゃんと話がしたくて……」"
