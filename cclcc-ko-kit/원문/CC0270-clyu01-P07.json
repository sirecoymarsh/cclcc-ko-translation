  {
   "id": "clyu01:60800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ノックの音がした。"
  },
  {
   "id": "clyu01:60900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "（誰だ、こんな時間に？）"
  },
  {
   "id": "clyu01:61000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "時計を見ると、既に日付も変わってしまっている。"
  },
  {
   "id": "clyu01:61100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この時間、普段の僕はまだ起きて、ネットで情報を漁ったりしているけれど、青葉寮の皆は違う。"
  },
  {
   "id": "clyu01:61200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "たいてい、日が変わるよりも早く眠ってしまうのが普通だ。"
