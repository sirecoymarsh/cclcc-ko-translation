 "context_before": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "（いやダメだ。別の誰かに拾われるリスクはしょいたくない）"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "（部屋の奥にしまっておこう。永久封印だ）"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「この引き出しを抜いて、っと……」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「誰にも見つかりませんように……。そして僕自身がこの雑誌の存在を早く忘れてしまいますように……」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「……」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「よし、寝よう」"
  }
 ],
 "entries": [
  {
   "id": "clse07:547300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うあああああっ！？」"
  },
  {
   "id": "clse07:547400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なななななななんでもない。まったくもってなんらかわらず寸分違わずいつも通りの僕だ」"
  },
  {
   "id": "clse07:547500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……香月、ちょっと二人だけで話がある。廊下に来てくれ」"
  },
  {
   "id": "clse07:547600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしてこの雑誌が写ってるんだ！？」"
