   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「じゃじゃじゃじゃ、じゃあ、この、雑誌は……！！！？？？」"
