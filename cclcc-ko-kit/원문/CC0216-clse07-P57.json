  {
   "id": "clse07:548500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そそそそ、それで、その雑誌は今どこに？」"
  },
