  {
   "id": "clse07:547700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だから、これだよ！」"
  },
  {
   "id": "clse07:547800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「このクールキャットプレス！」"
  },
  {
   "id": "clse07:547900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……え？」"
  },
  {
   "id": "clse07:548000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え、ええとだな、ここここ、この雑誌は、おおおお、お前が持ってきた物なんだな？ そうだと言ってくれるな？」"
