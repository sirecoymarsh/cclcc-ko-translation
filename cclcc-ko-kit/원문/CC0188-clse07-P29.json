  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「……かも」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「アイドルをプロデュース！？」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「ん…………」"
  },
  {
