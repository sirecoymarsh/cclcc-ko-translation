   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「えー、でもそれ、バスケ部の子のジャージがめくれてて、ちょっとエッチくない？」"
