   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "『でもさー、ひなちゃん。もし思惑どおり、タクがひなちゃんにめろめろ？ になったとしたら、ひなちゃんはどうするの？』"
  },
  {
   "id": "clse07:757500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
