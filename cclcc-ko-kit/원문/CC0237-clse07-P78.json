  {
   "id": "clse07:759800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、タク！ やっほー！」"
  },
  {
   "id": "clse07:759900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「えー？ 今日はホームルームが終わったら体育館に集合だって、タクが言ったんじゃーん」"
  },
  {
   "id": "clse07:760000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「女子バスケット部の活動を撮影するのに、練習前の５分間しか時間貰えなかったって悔しそうに言ってたじゃない」"
  },
  {
   "id": "clse07:760100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？ 昨日の夜に、タクのキャンピングカーでだけど？」"
  },
  {
   "id": "clse07:760200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？ 昨日の夜に、タクの部屋でだけど？」"
  },
  {
   "id": "clse07:760300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
