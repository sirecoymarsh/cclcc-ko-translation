  {
   "id": "clzz05:6000",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
