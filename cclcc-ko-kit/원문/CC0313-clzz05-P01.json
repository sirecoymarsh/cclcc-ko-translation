   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "澪は慣れた様子でトレーラーハウスの中へと足を踏み入れた。"
  },
  {
   "id": "clzz05:6600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "⟦top:76⟧――が。"
  },
  {
   "id": "clzz05:6700",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": null,
   "jp": "「……？」"
  },
  {
   "id": "clzz05:6800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
