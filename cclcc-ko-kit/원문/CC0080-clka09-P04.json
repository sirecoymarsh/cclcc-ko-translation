  {
   "id": "clka09:29100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ひどい、酷すぎます！ いえ、あたしのことはどうでもいいんです」"
  },
  {
   "id": "clka09:29200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "『華』は悲しげにぷっくりと大きくなっているお腹に手を当てた。"
