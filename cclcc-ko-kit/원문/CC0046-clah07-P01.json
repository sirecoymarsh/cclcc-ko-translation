 "entries": [
  {
   "id": "clah07:0",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "오노에 세리카",
   "jp": "渋谷カフェＬＡＸは拓留たち碧朋学園新聞部ご用達の喫茶店だ。"
  },
  {
   "id": "clah07:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "오노에 세리카",
   "jp": "普段は拓留や伊藤がだらだらと無駄な時間を過ごすことの多いこの店だが、この日は珍しく華やかな香りが漂っていた。"
  },
  {
   "id": "clah07:200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": "아리무라 히나에",
   "jp": "「そっか。そんじゃ、今日は華ちゃんのところでシャワー借りてたんだ」"
  },
  {
   "id": "clah07:300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "「そういうこと。すまないねー、華」"
  },
  {
   "id": "clah07:400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "「それは言わない約束……かも」"
  },
  {
   "id": "clah07:500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "「言ってくれればうちのお風呂、使わせてあげたのに」"
  },
  {
   "id": "clah07:600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「いやぁ、来栖先輩のとこって、ご家族多いじゃないっすかー。だから、なんか申し訳なくって」"
  },
  {
   "id": "clah07:700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「うちならかまわないわよ。なんなら、一緒に入る？」"
  },
  {
   "id": "clah07:800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「う……来栖先輩とお風呂……それはちょっと遠慮しておきます」"
  },
  {
   "id": "clah07:900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「あら、どうして？」"
  },
  {
   "id": "clah07:1000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "야마조에 우키",
   "jp": "「だって……いろいろ自信なくしそうですし。どうせ入るならうきとで」"
  },
  {
   "id": "clah07:1100",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「……心外です」"
  },
  {
   "id": "clah07:1200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「あ、ごめんごめん、冗談だから！ そんな哀しそうな顔しないで！」"
  },
  {
   "id": "clah07:1300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「……私も冗談です」"
  },
  {
   "id": "clah07:1400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「あー、うき〜！ このぉ、こうしてやるぅ！！」"
  },
  {
   "id": "clah07:1500",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "「ふぇ……ほっぺ、引っ張らないれくらさい。いたい……れす……」"
  },
  {
   "id": "clah07:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "오노에 세리카",
   "jp": "拓留の住居にはシャワーが無い。"
  },
  {
   "id": "clah07:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "오노에 세리카",
   "jp": "雛絵はこれまで、学校帰りに近くの温泉施設に行くか、あるいは学園にある運動部用のシャワールームを使うかしていたが、この日は生憎とどちらも使用できなかったのだという。"
  },
  {
   "id": "clah07:1800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "카즈키 하나",
   "jp": "「でも、華ちゃんとこの寮も、最近厳しかったんじゃないの？」"
  },
  {
   "id": "clah07:1900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "아리무라 히나에",
   "jp": "「昼間は大丈夫……かも……」"
  },
  {
   "id": "clah07:2000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "쿠루스 노노",
   "jp": "「いやー、おかげで助かったわー」"
  },
  {
   "id": "clah07:2100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "さすがに年頃の雛絵にとって、一日シャワーを浴びられないというのは死活問題に等しい。"
  },
  {
   "id": "clah07:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "しかも絶賛、宮代拓留の気を引こうとしている最中であるからには、不潔な状態でいるわけにはいかなかった。"
  },
  {
   "id": "clah07:2300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「で、どうなの、拓留は？」"
  },
  {
   "id": "clah07:2400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「全然だめっす。こっちから近づけば近づくほど、遠ざかる感じっていうか……」"
  },
  {
   "id": "clah07:2500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「でしょうねぇ。あの子、基本的にあまのじゃくだから。気を引こうとすればするほど、拒否するんじゃないかしら」"
  },
  {
   "id": "clah07:2600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「あー……やっぱそうっすかねぇ……」"
  },
  {
   "id": "clah07:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "雛絵としても薄々感じてはいた。"
  },
  {
   "id": "clah07:2800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "しかしながら一度大きく宣言した手前、引くに引けず突っ走ってしまったという次第だ。"
  },
  {
   "id": "clah07:2900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "いや、相手が拓留以外の男子であったなら、いくら雛絵でもそれほどムキになることは無かったのかもしれない。"
  },
  {
   "id": "clah07:3000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "（そこなのよねぇ……）"
  },
  {
   "id": "clah07:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "そう。雛絵自身にも不思議だった。"
  },
  {
   "id": "clah07:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "どうして、自分がこんなにも宮代拓留に拘るのか。"
  },
  {
   "id": "clah07:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "そもそも家出を決め、どこに行こうか考えた際、まず真っ先に浮かんだのが拓留の住居だった。"
  },
  {
   "id": "clah07:3400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "それも雛絵にとっては、不可解な点のひとつだった。"
  },
  {
   "id": "clah07:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "⟦top:38⟧単に母親への当てつけというだけなら、選択肢はいくつもあった。"
  },
  {
   "id": "clah07:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "⟦top:38⟧それがなぜ、拓留の住居を選んだのか。"
  },
  {
   "id": "clah07:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "単に場所が近かった、というのもあるかもしれないが、それだけではないような気もする……。"
  },
  {
   "id": "clah07:3800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「ねえ、有村さん。この前も言ったと思うけど……」"
  },
  {
   "id": "clah07:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "頭を抱える雛絵に、乃々は前置きしてから言った。"
  },
  {
   "id": "clah07:4000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": "아리무라 히나에",
   "jp": "「拓留のことだから、過ちはないとは思うわ。でも、ほどほどにしておきなさいよ」"
  },
  {
   "id": "clah07:4100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「…………」"
  },
  {
   "id": "clah07:4200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「なに？」"
  },
  {
   "id": "clah07:4300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「来栖先輩は良いんですか？」"
  },
  {
   "id": "clah07:4400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「なにが？」"
  },
  {
   "id": "clah07:4500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「だってー、私がやってることって、言ってしまえば、宮代先輩を⟦rb⟧弄⟦rt⟧もてあそ⟦/r⟧んでるようなもんですよ？」"
  },
  {
   "id": "clah07:4600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「そういうの、腹が立ったりしないんすか？」"
  },
  {
   "id": "clah07:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "血はつながっていないにせよ、拓留は乃々にとって義理の弟にあたる。"
  },
  {
   "id": "clah07:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "それに、もしかしたら乃々は拓留に少なからず好意を抱いているのではないか……そう思うこともあった。"
  },
  {
   "id": "clah07:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "雛絵にとってはそれが憂いの種でもあったのだが……。"
  },
  {
   "id": "clah07:5000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "「拓留だって子どもじゃないんだもの。仮に弄ばれたとしたら、それは本人の責任だわ。それに……」"
  },
  {
   "id": "clah07:5100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "乃々に真っ直ぐな瞳で見つめられ、雛絵は思わず引き込まれそうになった。"
  },
  {
   "id": "clah07:5200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
