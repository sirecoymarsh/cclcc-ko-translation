   "next_speaker": "쿠루스 노노",
   "jp": "「え？」"
  },
  {
   "id": "clkn09:8900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ……」"
  },
  {
   "id": "clkn09:9000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「の、乃々……お前、なに言ってんだよ？」"
  },
  {
   "id": "clkn09:9100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ち、違うの。別に、私が、とかそういうことじゃなくて……！」"
  },
  {
   "id": "clkn09:9200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ね、ねえ？ そうよねー、ひかりちゃ〜ん」"
  },
  {
   "id": "clkn09:9300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あらあら。ひかりったらご機嫌ななめでちゅねぇ。どうしたのかなぁ？」"
  },
  {
   "id": "clkn09:9400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "さっきまで機嫌よくしていたひかりが、急に⟦rb⟧憤⟦rt⟧むずか⟦/r⟧りはじめた。"
  },
  {
   "id": "clkn09:9500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「お腹空いたのかしら〜？ 拓留、悪いんだけど……」"
  },
  {
   "id": "clkn09:9600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ミルクだろ？」"
  },
  {
   "id": "clkn09:9700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「助かるわ、ありがとう」"
  },
  {
   "id": "clkn09:9800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この２日間で、僕もすっかり子育て経験者だ。"
  },
  {
   "id": "clkn09:9900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ミルクも作れれば、おむつだって替えられる。"
  },
  {
   "id": "clkn09:10000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もちろん、最初はなんで僕がこんなことをしなきゃならないんだって思ってたけど、やってみると意外と簡単だ。"
  },
  {
   "id": "clkn09:10100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "少なくとも、クラスの情弱たちと接するよりもずっと気楽でいい。"
  },
  {
   "id": "clkn09:10200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "煮沸消毒済みの哺乳瓶に粉ミルクを入れて、７０度以上のお湯で溶かす。"
  },
  {
   "id": "clkn09:10300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あとは哺乳瓶を冷水にさらして、人肌程度の温度に下げれば。"
  },
  {
   "id": "clkn09:10400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ほら、ミルク」"
  },
  {
   "id": "clkn09:10500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ありがと。はい、ひかりちゃん。ミルクでちゅよ〜」"
  },
  {
   "id": "clkn09:10600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "だが、ひかりは哺乳瓶を口に含もうとはしなかった。"
  },
  {
   "id": "clkn09:10700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕が作ったミルクがイヤ……ってわけじゃないだろう。現に、今朝だってちゃんと飲んでたし。"
  },
  {
   "id": "clkn09:10800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「どうしたんだろ？」"
  },
  {
   "id": "clkn09:10900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「お腹が空いたんじゃないのかしら？」"
  },
  {
   "id": "clkn09:11000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "心配そうにのぞき込む乃々腕の中で、ひかりが身を捩った。"
  },
  {
   "id": "clkn09:11100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "と思うと、唾液まみれの口を乃々の胸に押し付けた。"
  },
  {
   "id": "clkn09:11200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そっか、ママのおっぱいが飲みたいのね」"
