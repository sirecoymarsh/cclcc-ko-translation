 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "つまり、いまは乃々タイムというわけ。"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「ふふっ。でも、留守にしてる間もちゃあんと良い子にしてたんでちゅね〜。いいこいいこ〜」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "久野里さんも頑張ってはいたとはいえ、やはりひかりの相手は、久野里さんよりも乃々に分があるようだ。"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「拓留も、きちんと面倒みてくれてたんでちゅね〜。えらいえらい」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「⟦rb⟧揶揄⟦rt⟧からか⟦/r⟧うなよ。僕だってそれくらいできる」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「そうなんだ。それじゃあ、いつ赤ちゃんができても大丈夫ね」"
  }
 ],
 "entries": [
  {
   "id": "clkn09:8800",
   "type": "dialogue",
