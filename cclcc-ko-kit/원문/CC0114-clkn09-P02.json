  },
  {
   "id": "clkn09:13600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そう……よっぽどママのおっぱいが恋しかったのね……」"
  },
