   "id": "clkn09:12800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「もう……しょうがないわね。そんなに飲みたいの？ だったら、飲ませてあげる」"
  },
  {
   "id": "clkn09:12900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「は！？」"
  },
  {
   "id": "clkn09:13000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だって、飲みたいんだったら仕方ないものねぇ……」"
  },
