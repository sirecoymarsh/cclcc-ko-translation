  {
   "id": "clse03:6500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「いやいい。尾上は知らなくていい世界の話だ。とにかくこれを外して――」"
