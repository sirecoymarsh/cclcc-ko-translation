  {
   "id": "clse03:6600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "が。驚いたことに、いきなり尾上はキッときつい目をして僕をにらみつけた。"
