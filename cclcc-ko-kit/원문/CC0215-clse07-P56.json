   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こ、これはあくまで、大衆の興味レベルの把握が目的だ」"
  },
  {
   "id": "clse07:543700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ぼ、僕自身が、なにか不埒な考えを持っているわけじゃないぞ」"
  },
  {
   "id": "clse07:543800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「これでは単に記者の萌えポイントを読まされているだけじゃないか……。ああ、拍子抜けだ」"
  },
  {
   "id": "clse07:543900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……『君の女友達を自分好みに変えてみよう』、か」"
  },
  {
   "id": "clse07:544000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はあ。くだらない」"
  },
  {
   "id": "clse07:544100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clse07:544200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clse07:544300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……ふむ」"
  },
  {
   "id": "clse07:544400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……くだらない、が」"
  },
  {
   "id": "clse07:544500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「『タイプ１：強気なお姉さん系』……これは来栖だな」"
  },
  {
   "id": "clse07:544600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「来栖はちょっとツンデレが過ぎるからな。もう少し年上のお姉さん的な余裕のあるエロさを醸し出せるといいんだが」"
  },
  {
   "id": "clse07:544700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「『タイプ２：天然元気少女系』……尾上かなあ」"
  },
  {
   "id": "clse07:544800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あいつはそもそもそういう知識がなくて、そのせいか男子を相手にしてる時のガードがゆるいんだよな」"
  },
  {
   "id": "clse07:544900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「逆に、そのガードのゆるさにあわせていけば、いつの間にかそういう展開に持ち込むことも可能か……」"
  },
  {
   "id": "clse07:545000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「『タイプ３：好奇心旺盛な後輩系』……まあ、有村だな」"
  },
  {
   "id": "clse07:545100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「有村はそっち方向にオープンすぎるんだよな。わざとああいう態度を取ることで、逆にガードを固めているようにも思えるが」"
  },
  {
   "id": "clse07:545200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ただ、きっと本人だって多少興味があるんだろうから、その場の勢いで持ち込めるかも……」"
  },
  {
   "id": "clse07:545300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「『タイプ４：無口不思議系』……うーん」"
  },
  {
   "id": "clse07:545400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……これは、香月かな？」"
  },
  {
   "id": "clse07:545500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「香月は、誰ともコミュニケーション取ろうとしないが、みんな気付いてないだけで、かわいいし、スタイルもいい」"
  },
  {
   "id": "clse07:545600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なによりあのおっぱいの大きさは暴力的とすら言える」"
  },
  {
   "id": "clse07:545700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしあいつが、そういう方面に積極的な肉食系女子だったら、きっと籠絡される男子は沢山いるだろう」"
  },
  {
   "id": "clse07:545800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕だって、もしそんな香月に迫られたら、理性を保っていられるかはわからないな」"
  },
  {
   "id": "clse07:545900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……よし、できた！」"
  },
  {
   "id": "clse07:546000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ちょっと、読み直してみるか」"
  },
  {
   "id": "clse07:546100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clse07:546200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clse07:546300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……キモい」"
  },
  {
   "id": "clse07:546400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「我ながら、どん引きだ」"
  },
  {
   "id": "clse07:546500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕はなんでこんなどうしようもないことに時間を費やしてしまったんだ」"
  },
  {
   "id": "clse07:546600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（どうしよう。捨てるか？）"
  },
  {
   "id": "clse07:546700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（いやダメだ。別の誰かに拾われるリスクはしょいたくない）"
  },
  {
   "id": "clse07:546800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（部屋の奥にしまっておこう。永久封印だ）"
  },
  {
   "id": "clse07:546900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「この引き出しを抜いて、っと……」"
  },
  {
   "id": "clse07:547000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「誰にも見つかりませんように……。そして僕自身がこの雑誌の存在を早く忘れてしまいますように……」"
  },
  {
   "id": "clse07:547100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clse07:547200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よし、寝よう」"
  }
 ],
 "context_after": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「うあああああっ！？」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「なななななななんでもない。まったくもってなんらかわらず寸分違わずいつも通りの僕だ」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「……香月、ちょっと二人だけで話がある。廊下に来てくれ」"
  }
 ]
}