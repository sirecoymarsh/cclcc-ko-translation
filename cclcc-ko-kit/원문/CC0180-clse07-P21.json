   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうだ？ もう学校には慣れたか？」"
  },
  {
   "id": "clse07:194600",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そう、か……困ったことがあったら、いつでも言ってくれ」"
  },
  {
   "id": "clse07:194700",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
