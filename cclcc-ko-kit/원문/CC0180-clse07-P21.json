  {
   "id": "clse07:195200",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「寂しいよな？ いいや、寂しいに決まってる！！ 絶対にそうだ！」"
  },
