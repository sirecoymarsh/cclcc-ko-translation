   "id": "clse07:195100",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「南沢も久しぶりに帰って来て、寂しいだろう」"
