   "speaker_ko": "카와하라 마사시",
   "jp": "「宮代」"
  },
  {
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "jp": "「その……来栖から連絡はあったか？」"
  },
  {
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "jp": "「そうか。それにしても、来栖も冷たい奴だよな。誰にも何も言わずに、留学しちまうなんて」"
  },
  {
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "jp": "「でも、さすがにお前は知ってたんだろ？」"
  },
  {
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "jp": "「そうか……。ま、あいつにとって俺は長い付き合いってだけの存在だったってことか……」"
  }
 ],
 "entries": [
  {
   "id": "clse07:194200",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、でも言っておくが、落ち込んでるわけじゃないからな。別に、女はあいつだけじゃないし」"
  },
  {
   "id": "clse07:194300",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それに、久しぶりに会ってみると、あいつもなかなか……」"
  },
  {
   "id": "clse07:194400",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
