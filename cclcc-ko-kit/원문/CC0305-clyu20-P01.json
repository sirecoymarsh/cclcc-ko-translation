   "id": "clyu20:1500",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "남자",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「待て……とにかく落ち着くんだ……」"
