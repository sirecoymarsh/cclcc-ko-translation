   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ごめんなさーい、そんなに驚くと思わなくって！」"
  },
  {
   "id": "clka09:4100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "おでこにこつんと拳を当てて謝っている。反省している素振りを示すつもりもないようだ。"
