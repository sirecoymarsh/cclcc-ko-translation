   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": "카즈키 하나",
   "jp": "「ひぃぃっ！」⟦avs⟧⟦n⟧⟦n⟧"
