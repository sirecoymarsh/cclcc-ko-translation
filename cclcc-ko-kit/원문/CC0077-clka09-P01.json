   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "⟦col:280aa02d1400⟧ハチ公⟦col:800000⟧像の傍で、僕は香月が来るのを待っていた。"
  },
  {
   "id": "clka09:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "新聞部のメンバーに見送られて下校した僕と香月は、しかし、そのままデートを始めたわけではなかった。"
  },
  {
   "id": "clka09:800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「家に帰って服を着替えてから、４時にハチ公前で待ち合わせしましょう」"
  },
  {
   "id": "clka09:900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「制服デートもいいですけど、ちょっと目立っちゃうかもだから」"
  },
  {
   "id": "clka09:1000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「じゃあまた後で。ちゃんと着替えてきてくださいよ！」"
  },
  {
   "id": "clka09:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "面倒だと文句を言うより先に香月が走り去ってしまったので、仕方なく僕は一度キャンピングカーに戻り、私服に着替えて来た。"
  },
  {
   "id": "clka09:1200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": null,
   "jp": "（こっちは約束の時間の１０分前には到着してるんだぞ……）"
  },
  {
   "id": "clka09:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": null,
   "jp": "（しかも、どうしてハチ公前なんだよ……）"
  },
  {
   "id": "clka09:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "恐らく渋谷の待ち合わせ場所としてもっとも有名であろうハチ公像の周囲は、いつもの如くみっちりと人が集まっていた。"
  },
  {
   "id": "clka09:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こんなに人がいると移動するのさえ一苦労で、更に待ち合わせ相手を探さなければならず、効率が悪いことこの上ない。"
  },
  {
   "id": "clka09:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "情報強者であるこの僕に限らず、渋谷で暮らしている人間だったら、こんな面倒な場所を待ち合わせに使ったりはしない。"
  },
  {
   "id": "clka09:1700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": null,
   "jp": "（……）"
  },
  {
   "id": "clka09:1800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": null,
   "jp": "（……それに）"
  },
  {
   "id": "clka09:1900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（……どう考えても、場違いだ）"
  },
  {
   "id": "clka09:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ハチ公周辺で待ち合わせをしている人たちに大体共通している事がある。"
  },
  {
   "id": "clka09:2100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それは、『みんな幸せそう』ということだ。"
  },
  {
   "id": "clka09:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "きっと、これから彼氏彼女と合流して、食事だかショッピングだかカラオケだかクラブだかに行くのだろう。"
  },
  {
   "id": "clka09:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
