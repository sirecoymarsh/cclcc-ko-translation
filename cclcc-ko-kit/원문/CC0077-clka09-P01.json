   "id": "clka09:4300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ズボンを払って周りを見ると、何人かがこっちを見て笑っている。"
