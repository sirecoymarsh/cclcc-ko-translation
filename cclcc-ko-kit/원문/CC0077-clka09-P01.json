   "id": "clka09:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "急に恥ずかしくなった僕は、ぶっきらぼうに言って人混みの中を強引に歩き始めた。"
  },
  {
   "id": "clka09:4500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「行くぞ！」"
