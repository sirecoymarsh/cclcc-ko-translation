 "source_file": "clse01.msb",
 "speakers_in_packet": [
  "겐 씨",
  "미야시로 타쿠루",
  "오노에 세리카"
 ],
 "context_before": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「なんだ、それ？」"
  },
  {
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "jp": "「えとね、お友達と一緒にお酒をチビチビ飲みながら、通りかかる女子高生にこっそりポイントをつけてるらしいよ。胸の形４０点とか、ふともも６０点とか」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「…………」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "ったく！ あの、⟦col:280aa02d1400⟧セクハラ⟦col:800000⟧エロおやじめ！"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "最悪だ。ろくなことをしない！"
  },
  {
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "jp": "「ちなみに、私はこの前、総合ポイントでゆーしょーしましたー！」"
  }
 ],
 "entries": [
  {
   "id": "clse01:8700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「優勝？」"
  },
  {
   "id": "clse01:8800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えへへぇ。すごいすごい？」"
  },
  {
   "id": "clse01:8900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「いや、それ、お前がゲンさんと仲がいいからだろ。ポイント、おまけしてくれたんだよ」"
  },
  {
   "id": "clse01:9000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「え〜。そうかなあ」"
  },
  {
   "id": "clse01:9100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "尾上は、いかにも納得いかないような顔をしつつ、ふむぅとうなった。"
  },
  {
   "id": "clse01:9200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "かと思えば、ふいに、尾上が僕の眼を見つめて言う。"
  },
  {
   "id": "clse01:9300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「じゃあさ、タクは何点くらいだと思う？」"
  },
  {
   "id": "clse01:9400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「あん？」"
  },
  {
   "id": "clse01:9500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だから、私だよ、私。胸とかお尻とかえっちな所だけじゃなくて、ファッションとかもプラスしてね？」"
  },
  {
   "id": "clse01:9600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「な、なに言ってんだよ。そんなの……」"
  },
  {
   "id": "clse01:9700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "いきなり妙な質問をされて焦ってしまった僕は、『どのくらいの点数を言っておけば女の子がまぁまぁ納得するだろか？』などと余計なことを考えてしまっていた。"
  },
  {
   "id": "clse01:9800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そして、次の瞬間、それが尾上相手には最悪だったということを思い出して、自分を叱責していた。"
  },
  {
   "id": "clse01:9900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "いくら能天気で、アホの子で、さらに僕の性格をよく知ってるとはいえ……今の質問に対して、僕がテキトーに答えようとしたことを知ったら、さすがに傷つくかも知れない。"
  },
  {
   "id": "clse01:10000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "しかし、時すでに遅し。彼女は、僕の眼をじっと見つめている。"
  },
  {
   "id": "clse01:10100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "これは間違いなく『思考盗撮』をしている時の尾上の眼だ。"
  },
  {
   "id": "clse01:10200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「尾上、すまん！ 悪い！ 僕がいけなかった！」"
  },
  {
   "id": "clse01:10300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う？ タクってば、なに謝ってるの？」"
  },
  {
   "id": "clse01:10400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「……ええ？」"
  },
  {
   "id": "clse01:10500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "思考盗撮したんだろ、今？"
  },
  {
   "id": "clse01:10600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "だったら僕がなにを謝ったのかわかるハズじゃ――"
  },
  {
   "id": "clse01:10700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "しかし、尾上からは予想外の答えが返ってきた。"
  },
  {
   "id": "clse01:10800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あー、もしかして。タクの中で、私の女子高生ポイントってそんなに低いんだ？ 何がダメなの？」"
  },
  {
   "id": "clse01:10900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「分かった！ やっぱり華ちゃんみたいに胸がおっきくないとダメなんだね！？」"
  },
  {
   "id": "clse01:11000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「いやいや待て待て！ そんなこと考えてないって！」"
  },
  {
   "id": "clse01:11100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「じゃあ、のんちゃんだ！」"
  },
  {
   "id": "clse01:11200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「は？ 来栖がどうした？」"
  },
  {
   "id": "clse01:11300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だから！ タクは、のんちゃんみたいに厳しく叱ってくれる女の子が好みなんだよね！？ そこが、私のマイナスポイント！？」"
  },
  {
   "id": "clse01:11400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "尾上が、またもや見当違い過ぎることを口走った。"
  },
  {
   "id": "clse01:11500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "しかも、ちょっと焦っている感じがする。"
  },
  {
   "id": "clse01:11600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「なぁ、どうしたんだ、お前！？」"
  },
  {
   "id": "clse01:11700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうしたって？ 何が？」"
  },
  {
   "id": "clse01:11800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": null,
   "jp": "「いや、だって……僕は別に、香月や来栖のことなんて考えてないぞ。お前なら、思考盗撮すればそのくらいすぐに――」"
  },
  {
   "id": "clse01:11900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そこでふと、部室でのことを思い出した。"
  },
  {
   "id": "clse01:12000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そういえば、来栖が尾上の『思考盗撮』をさんざん⟦rb⟧諌⟦rt⟧いさ⟦/r⟧めていた。"
  },
  {
   "id": "clse01:12100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『考えてることを勝手に知られたら、イヤでしょう？』と。"
  },
  {
   "id": "clse01:12200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『それじゃ、本当のお友達も出来ないわよ』とも言われてた。"
  },
  {
   "id": "clse01:12300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "（……なるほど、そうか）"
  },
  {
   "id": "clse01:12400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "来栖の言うことを素直に聞いて、『思考盗撮』を封印してるってことか。"
  },
  {
   "id": "clse01:12500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "思考盗撮という能力、普通ならいくらでも便利に使えるだろう。"
  },
  {
   "id": "clse01:12600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "なのに、親友の言うことをちゃんと聞いて、それを封じるなんて。"
  },
  {
   "id": "clse01:12700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "うん。えらいな、尾上は。"
  },
  {
   "id": "clse01:12800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "思わず、頭を撫でてやりそうになってしまった。"
  },
  {
   "id": "clse01:12900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "겐 씨",
   "jp": "「あー！ ゲンさん見つけたー！」"
  },
  {
   "id": "clse01:13000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "겐 씨",
   "jp": "尾上の指す方を見ると、こんな時間からすでにアルコールが入っているらしい赤ら顔のゲンさんが、僕のトレーラーハウスに向かってフラフラ歩いて行くのが見えた。"
  },
  {
   "id": "clse01:13100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "겐 씨",
   "jp": "僕らは足早にその後を追った。"
  },
  {
   "id": "clse01:13200",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「おお！ 今日も元気そうであるな、ぬしたち。はははは」"
  },
  {
   "id": "clse01:13300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "미야시로 타쿠루",
   "jp": "トレーラーハウスの前で追いつくと、ゲンさんはいつものようにご機嫌な声で笑った。"
  },
  {
   "id": "clse01:13400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それは別にいいのだけれど、やっぱり息がものすごくアルコール臭い。"
  },
  {
   "id": "clse01:13500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "겐 씨",
   "next_speaker": "겐 씨",
   "jp": "「うぷっ。昼間からお酒はやめときなよ。あと、いまはうちの中に入らないでくれよな。息だけでこっちまで酔いそうだ」"
  },
  {
   "id": "clse01:13600",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「おーおー、冷たいことを言うヤツよのう。せっかく素晴らしき宝を持参してやったというのに」"
