   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なあ、うき……前にテレビで言ってたんだけどさ、アイドルって、誰かを元気づけるために頑張ってるんだって」"
  },
  {
   "id": "clse07:700800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「歌ったり踊ったり一生懸命な姿を見せることで、誰かが喜んでくれる。そのために自分たちは頑張れるんだ、笑顔になれるんだって――そう言ってた」"
  },
  {
   "id": "clse07:700900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だからさ。やってみたらどうだ？」"
  },
  {
   "id": "clse07:701000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「せっかくなんだ。たまには自分からチャレンジしてみなよ？」"
  },
  {
   "id": "clse07:701100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それに、結衣だってうきを必要としてるんだ。そうだよな、結衣？」"
  },
  {
   "id": "clse07:701200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「えええええええええええええええっ！？」"
  },
  {
   "id": "clse07:701300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、だって、今の流れだと“わかりました！ 私、やります！”って言うところだろ、ふつう」"
  },
  {
   "id": "clse07:701400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「これだ！！！！！」"
  },
  {
   "id": "clse07:701500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふふふ……行ける、行けるぞ、これは！！ はーっはっはっは！」"
  },
  {
   "id": "clse07:701600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「結衣。今日からお前はアイドルだ！」"
  },
  {
   "id": "clse07:701700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そして、結人！ お前もだっ！」"
  },
  {
   "id": "clse07:701800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わからないか？ 今日よりふたりは、ユイとユウ。姉妹ユニットとしてアイドル活動を始めてもらう！！」"
  },
  {
   "id": "clse07:701900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、結人……お前ならなれる！ 僕が保証する」"
  },
  {
   "id": "clse07:702000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なあ、うきはどう思う？ 結人には無理だと思うか？」"
  },
  {
   "id": "clse07:702100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なあ結人」"
  },
  {
   "id": "clse07:702200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もし、アイドル活動で成功したら、欲しいもの、なんでも買えるぞ？」"
  },
  {
   "id": "clse07:702300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ああ……」"
  },
  {
   "id": "clse07:702400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もちろん！ プリステ・ヴェーダだって買えるぞ！」"
  },
  {
   "id": "clse07:702500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうだ、結人。やってみないか？」"
  },
  {
   "id": "clse07:702600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほんとか！？」"
  },
  {
   "id": "clse07:702700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「（これはイケる――！！）」"
  },
  {
   "id": "clse07:702800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、そうだ……ふたりとも。くれぐれも言っておくけど、このことは来栖にはナイショだからな」"
  },
  {
   "id": "clse07:702900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「来栖は説得するのに時間がかかるからな。ある程度結果を出してからじゃないと、絶対に反対される」"
  },
  {
   "id": "clse07:703000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うきも、わかったな？」"
  },
  {
   "id": "clse07:703100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「心配するな。あいつには、どこかタイミングのいいところで、僕の方からちゃんと言ってやるから」"
  },
  {
   "id": "clse07:703200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「プロデューサー……？」"
  },
  {
   "id": "clse07:703300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「（まったく。困ったもんだ……）」"
  },
  {
   "id": "clse07:703400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ん？ どうした、尾上くん？」"
  },
  {
   "id": "clse07:703500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「悪いが、夜の予定はすべてキャンセルしてくれたまえ」"
  },
  {
   "id": "clse07:703600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「二度は言わせるな」"
  },
  {
   "id": "clse07:703700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「マウンテンビューとミルクを」"
  },
  {
   "id": "clse07:703800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……それで？」"
  },
  {
   "id": "clse07:703900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしたら……とは？」"
  },
  {
   "id": "clse07:704000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……売れるためには覚悟が必要だ。君にその覚悟はあるのかい？」"
  },
  {
   "id": "clse07:704100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どんなことでも……ね。本当に？」"
  },
  {
   "id": "clse07:704200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうか……それじゃあ……」"
  },
  {
   "id": "clse07:704300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「この意味……わかるよね？」"
  }
 ],
 "context_after": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「わかるよね？」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「緊張してるのかい？」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「心配しなくてもいい……優しくするから……」"
  }
 ]
}