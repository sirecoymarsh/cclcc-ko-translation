   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦g:424⟧２０１５年１０月１０日『ごっつァンデス』"
  },
  {
   "id": "claa04:9500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "・２００９年１０月２３日『ニュージェネの狂気／ノータリン』"
  },
  {
   "id": "claa04:9600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "・２００９年１０月２８日『ニュージェネの狂気／美味い手』"
  },
  {
   "id": "claa04:9700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "・２００９年１１月４日『ニュージェネの狂気／ＤＱＮパズル』"
  },
  {
   "id": "claa04:9800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "오노에 세리카",
   "jp": "「……今まで、気が付かなかった……」"
  },
  {
   "id": "claa04:9900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なになに？」"
  },
  {
   "id": "claa04:10000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「同じなんだ。日付が」"
  },
  {
   "id": "claa04:10100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「日付？」"
  },
  {
   "id": "claa04:10200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「ああ。六年前の『ニュージェネレーションの狂気』事件と、今回の一連の事件――今のところ、全部同じ日に起こってる！」"
  },
  {
   "id": "claa04:10300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「これって、すごいぞ！ バラバラだった点と点が、線につながった！」"
  },
  {
   "id": "claa04:10400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……？」"
  },
  {
   "id": "claa04:10500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「『こっち見んなー』にしても『音漏れてん』にしても『回転ジェット』にしても、関連性はゼロ。バカバカしい事件が頻発してるってだけで、なんの共通点も見えなかっただろ？」"
  },
  {
   "id": "claa04:10600",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う、うん」"
  },
  {
   "id": "claa04:10700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「でも、実は共通点があったんだ。いくらなんでも、こんなに偶然が重なるわけない」"
  },
  {
   "id": "claa04:10800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えと……つまりどういうこと？」"
  },
  {
   "id": "claa04:10900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「一見、テキトーに発生しているように見える今回の事件の裏に――実は真犯人が潜んでる。そして、事件が起きるよう仕組んでるってことさ」"
  },
  {
   "id": "claa04:11000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「しかもその真犯人は、６年前の『ニュージェネレーションの狂気』と同じ日に犯行を重ねてる」"
  },
  {
   "id": "claa04:11100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「でも、なんでそんな面倒なことしてるのかなあ？ しかも、笑っちゃうような事件ばっかり」"
  },
  {
   "id": "claa04:11200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「たぶん、ある種の挑戦状だ。事件の共通性に気づいて、自分の犯行を止めてみろ、みたいな」"
  },
  {
   "id": "claa04:11300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「おー。なんかカッコいいねぇ」"
  },
  {
   "id": "claa04:11400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「くっくっく、ネットのカキコミを見ても、まだこの事に気づいたヤツはいない。たぶん僕が一番乗りだ」"
  },
  {
   "id": "claa04:11500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「そして、もし僕の推測したルールが正しければ、次は『１０月２３日』になんらかの事件が起こるわけだ。それを、いち早くスクープしてやる」"
  },
  {
   "id": "claa04:11600",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「なるほどー！ すごいね、タクー！」"
  },
  {
   "id": "claa04:11700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": null,
   "jp": "尾上が、僕を尊敬のまなざしで見ながら小さく拍手をした。"
  },
  {
   "id": "claa04:11800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": null,
   "jp": "昼間の編集会議ではものの見事に敗北し、『渋谷の新しい隠れスポット』とか『これから流行するファッション』とか、実に軟派な新聞になってしまうところだったけれど――"
  },
  {
   "id": "claa04:11900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": null,
   "jp": "僕の手で、世間を驚かせるようなネタを絶対につかんでやる。"
  }
 ],
 "context_after": []
}