{
 "packet_id": "CC0015-claa04-P02",
 "kit_version": "1.0",
 "source_file": "claa04.msb",
 "speakers_in_packet": [
  "미야시로 타쿠루",
  "오노에 세리카"
 ],
 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "尾上も僕の後ろに来て、画面をのぞき込んだ。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "そうされると、なにやら柔らかいものが背中に当たって、しかも、フワリといい香りが鼻をくすぐったりするが、そんなことくらいで動じる僕ではないのだ。"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「僕の考えだと、これらの事件には〜……おほんおほん……これらの事件には、なんらかの関連性がある気がするんだ」"
  },
  {
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "jp": "「うーん？ そうかなぁ」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「ああ。絶対に何かあるはず。尾上は何か気づいた事とかないか？」"
  },
  {
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "jp": "「ん〜？」"
  }
 ],
 "entries": [
  {
   "id": "claa04:7400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "尾上は顎に手を当ててしばらく考えたあと、おもむろに両手をパシンと打って言った。"
  },
  {
   "id": "claa04:7500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どの事件も、私たちを笑わせようとしている！」"
  },
  {
   "id": "claa04:7600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「そんなわけあるか！」"
  },
  {
   "id": "claa04:7700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "……尾上に聞いた僕がバカだった。"
  },
  {
   "id": "claa04:7800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「でもでも、面白い事件ばっかりじゃない？ 何年か前に、『ニュージェなんとかのきょうき』とかいうのがあったけど、あれとは大違いだよ」"
  },
  {
   "id": "claa04:7900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「『⟦col:280aa02d1400⟧ニュージェネレーションの狂気⟦col:800000⟧』な」"
  },
  {
   "id": "claa04:8000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そうだ。確か６年ほど前、今回と同じように渋谷で連続事件が起きたことがあった。"
  },
  {
   "id": "claa04:8100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ただし、『ニュージェネレーションの狂気』と呼ばれているそれは、今回と違って、どれも目を覆いたくなるような殺人事件ばかりだったけれど――"
  },
  {
   "id": "claa04:8200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「――あっ！？」"
  },
  {
   "id": "claa04:8300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "僕はそこである事に気づき、思わず声を上げた。"
  },
  {
   "id": "claa04:8400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どしたのタク？」"
  },
  {
   "id": "claa04:8500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": null,
   "jp": "「尾上！ もしかしたら、お前、お手柄かも知れないぞ！」"
  },
  {
   "id": "claa04:8600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "急いでＰＣを立ち上げると、色々なサイトを検索しつつ、表計算ソフトにデータを打ち込んでいく。"
  },
  {
   "id": "claa04:8700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "⟦g:424⟧２００９年９月７日『ニュージェネの狂気／集団ダイブ』"
  },
  {
   "id": "claa04:8800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "⟦g:424⟧２０１５年９月７日『こっち見んなー！』"
  },
  {
   "id": "claa04:8900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
