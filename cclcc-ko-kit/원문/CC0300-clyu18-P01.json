 "context_before": [],
 "entries": [
  {
   "id": "clyu18:0",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "야마조에 우키",
   "jp": "「遅いな、結衣……どうしたんだろう？」"
  },
  {
   "id": "clyu18:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "遅くとも夕方１７時には⟦rb⟧トレーラーハウス⟦rt⟧ここ⟦/r⟧に集合と、確かに昨日の夜、結衣にはそう言ったはずだった。"
  },
  {
   "id": "clyu18:200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "既に約束の時間を３０分も過ぎている。"
  },
  {
   "id": "clyu18:300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "야마조에 우키",
   "jp": "「学校は一緒に出なかったんだよな？」"
  },
  {
   "id": "clyu18:400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「はい。先生に頼まれた用を終えて教室に戻ったら、結衣ちゃんの姿が消えていたので、てっきり先に向かったのかと思ってたんですが……」"
  },
  {
   "id": "clyu18:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "오노에 세리카",
   "jp": "うきが学校を出たのは１５時半くらいだと言っていたから、少なくとも結衣はその前には出ていたということになる。"
  },
  {
   "id": "clyu18:600",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유토",
   "jp": "「家に帰ってるってことはないの？」"
  },
  {
   "id": "clyu18:700",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "「お姉ちゃん、家にはいなかったよ」"
  },
  {
   "id": "clyu18:800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「今、向かってる最中ってことはないのか？ 携帯は？」"
  },
  {
   "id": "clyu18:900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "카즈키 하나",
   "jp": "「さっきから何度もかけてるけど、かからない」"
  },
  {
   "id": "clyu18:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "電波の届かないところにいるか、電源が入ってないか――という例のアナウンスがかかるだけだ。"
  },
  {
   "id": "clyu18:1100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「困った……かも……」"
  },
  {
   "id": "clyu18:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もしかしたら、学校から帰る途中に事故にでもあったんじゃ……。"
  },
  {
   "id": "clyu18:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「僕、ちょっと捜してくるよ」"
  },
  {
   "id": "clyu18:1400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「探すってどこを？」"
  },
  {
   "id": "clyu18:1500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "겐 씨",
   "jp": "「とりあえず、ここから中等部に向かってみる」"
  },
  {
   "id": "clyu18:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "겐 씨",
   "jp": "１８時には配信を始めたかったけど、今はそんなことを言ってる場合じゃない。"
  },
  {
   "id": "clyu18:1700",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「おぉ、タク〜」"
  },
  {
   "id": "clyu18:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "겐 씨",
   "jp": "外に出たところで、ゲンさんが暢気な声を投げかけてきた。"
  },
  {
   "id": "clyu18:1900",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「狭い日本、そんなに急いでどこへ行く？ 急いだところで世の中そうは変わらんぞ〜」"
  },
  {
   "id": "clyu18:2000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "겐 씨",
   "next_speaker": "겐 씨",
   "jp": "「ゲンさん、悪いけど今ちょっと、妹を探しにいかなきゃならないんだ」"
  },
  {
   "id": "clyu18:2100",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「妹？ もしかして前にここに来てた中学生くらいの子か？ それならちょっと前に見かけたぞ？」"
  },
  {
   "id": "clyu18:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "미야시로 타쿠루",
   "jp": "思わぬ言葉に、僕は走り出そうとしていた足を止めて、ゲンさんに詰め寄った。"
  },
  {
   "id": "clyu18:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "겐 씨",
   "next_speaker": "겐 씨",
   "jp": "「ゲンさん！ それ、どこで！？ どこで見たの！？」"
  },
  {
   "id": "clyu18:2400",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ？ あ〜……ありゃ確か……どこだっけなぁ」"
  },
  {
   "id": "clyu18:2500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "겐 씨",
   "next_speaker": "겐 씨",
   "jp": "「ゲンさんっ！！」"
  },
  {
   "id": "clyu18:2600",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「大人の男とふたりで歩いとったなぁ。どこだっけなぁ？」"
  },
  {
   "id": "clyu18:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "미야시로 타쿠루",
   "jp": "大人の男……？"
  },
  {
   "id": "clyu18:2800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "겐 씨",
   "next_speaker": "겐 씨",
   "jp": "「大人の男ってのは、４０代後半くらいのメガネをかけた人？」"
  },
  {
   "id": "clyu18:2900",
   "type": "dialogue",
   "speaker": "ゲンさん",
   "speaker_ko": "겐 씨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「いや、もっと若かったなぁ。どこだっけなぁ……」"
  },
  {
   "id": "clyu18:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "오노에 세리카",
   "jp": "てことは、父さんじゃない。"
  },
  {
   "id": "clyu18:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "오노에 세리카",
   "jp": "じゃあ誰なんだ？"
  },
  {
   "id": "clyu18:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "오노에 세리카",
   "jp": "⟦col:280aa02d1400⟧青葉医院⟦col:800000⟧の患者さんか？"
  },
  {
   "id": "clyu18:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "오노에 세리카",
   "jp": "その可能性もあるけど……。"
  },
  {
   "id": "clyu18:3400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "오노에 세리카",
   "jp": "その時、ポケットの中でスマホが震えた。"
  },
  {
   "id": "clyu18:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "오노에 세리카",
   "jp": "もしかして結衣から？ と思ったが、発信者を確かめると尾上だった。"
  },
  {
   "id": "clyu18:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "겐 씨",
   "next_speaker": "오노에 세리카",
   "jp": "慌ててトレーラーハウスに戻ると、全員の視線が一斉に僕に向けられた。"
  },
  {
   "id": "clyu18:3700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "겐 씨",
   "next_speaker": "아리무라 히나에",
   "jp": "「なんだ、タク。まだそこにいたんだね。だったら話が早いよ」"
  },
  {
   "id": "clyu18:3800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "「華、あれ」"
  },
  {
   "id": "clyu18:3900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ん……」"
  },
  {
   "id": "clyu18:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "珍しく真剣な顔をした有村に促されて、香月が示したのは、⟦col:280aa02d1400⟧＠ちゃんねる⟦col:800000⟧の⟦col:280aa02e1400⟧スレ⟦col:800000⟧だった。"
  },
  {
   "id": "clyu18:4100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "이토 신지",
   "jp": "「『⟦col:280aa02d1400⟧ミルフィーユ⟦col:800000⟧』のスレなんてあったのか……」"
  },
  {
   "id": "clyu18:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "しかも、既に１０スレ近くいってる。"
  },
  {
   "id": "clyu18:4300",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「んなことで感心してる場合じゃねーぞ。ここ、見てみろ」"
  },
  {
   "id": "clyu18:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "画面の中では＠ちゃんで良く見るような、便所の落書きめいたやり取りが記されていた。"
  },
  {
   "id": "clyu18:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その中に――。"
  },
  {
   "id": "clyu18:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "――今日の配信でユウちゃんがヒカリヲとか言ってたな"
  },
  {
   "id": "clyu18:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "――学校の帰りってことは、学校は渋谷？"
  },
  {
   "id": "clyu18:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "――渋谷ってことは翠明？"
  },
  {
   "id": "clyu18:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "――碧朋かも"
  },
  {
   "id": "clyu18:5000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "카즈키 하나",
   "jp": "「これは……」"
  },
  {
   "id": "clyu18:5100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "「⟦col:280aa02d1400⟧身バレ⟦col:800000⟧……かも」"
  },
  {
   "id": "clyu18:5200",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "「どうやら、前に⟦col:280aa02d1400⟧ニヤ生⟦col:800000⟧でポロッと言っちまったみたいだな」"
  },
  {
   "id": "clyu18:5300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「その後も特定班がいろいろ動いてたみたいっすね」"
  },
  {
   "id": "clyu18:5400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "이토 신지",
   "jp": "身バレ……つまり、ふたりの身元が特定されたかもしれないということだ。"
  },
