  {
   "id": "clyu18:5900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「いや……いくら身バレしたからって、すぐにそう考えるのは早すぎる」"
  },
  {
   "id": "clyu18:6000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「でも、もしかしてってことも――」"
