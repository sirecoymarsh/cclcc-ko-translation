   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "とはいえ、さっきのゲンさんの話を考えると、その可能性は高い。"
