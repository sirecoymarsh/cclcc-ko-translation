  {
   "id": "clyu18:5800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "確かに、やけにどこの学校か知りたがってた奴がいるみたいだけど。"
