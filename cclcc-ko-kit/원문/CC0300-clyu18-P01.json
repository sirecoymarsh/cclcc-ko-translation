  {
   "id": "clyu18:6400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「そ、そうだよな。いくらなんでも、そんなこと」"
