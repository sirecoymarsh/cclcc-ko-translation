  {
   "id": "clyu18:7000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "もしもニヤ生での発言が原因なのだとしたら、ちゃんとチェックしていなかった僕にも落ち度はある。"
  },
  {
   "id": "clyu18:7100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
