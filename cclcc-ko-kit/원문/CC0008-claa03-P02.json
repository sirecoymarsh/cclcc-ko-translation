  {
   "id": "claa03:10800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신문부원들",
   "next_speaker": "아리무라 히나에",
   "jp": "有村の妙に明るい声に、僕と伊藤は我に返った。"
  },
  {
   "id": "claa03:10900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "신문부원들",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「想像力がたくましいのは結構ですがー、変な期待をするのはやめてくださいねー」"
