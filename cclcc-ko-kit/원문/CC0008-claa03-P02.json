   "jp": "「そうね、大目に見ましょう。にぎやかなのはいいことよ」"
  },
  {
   "id": "claa03:12300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
