  {
   "id": "claa03:12700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「さてみんな、このボードを見てくれ。ここ最近、渋谷で発生した有名な事件をまとめてみた。この中から、記事に出来そうなものを選ぼうと思う」"
  },
  {
   "id": "claa03:12800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ボードは、渋谷周辺の地図を拡大したもので、いつ、どこで、どんな事件が発生したか、分かりやすくピンを刺したり、メモを貼りつけたりできるようにしてある。"
  },
  {
   "id": "claa03:12900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「まずは、『こっち見んなー！事件』」"
  },
  {
   "id": "claa03:13000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「被害者は、ニコニヤ動画で『俺氏、未来が見えてしまう件について』という生放送をしていた２１歳のフリーターだ。名前と顔写真は――」"
  },
  {
   "id": "claa03:13100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（いや、違う。被害者は男だろ？ 考え直せ）"
