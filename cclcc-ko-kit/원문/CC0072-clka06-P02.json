  {
   "id": "clka06:12500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "どうやら声の主は、来栖の隣に座っている香月のようだった。"
  },
  {
   "id": "clka06:12600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "うつむいていて顔が見えないが、微妙に肩が震えている。笑いを堪えているようだ。"
  },
  {
   "id": "clka06:12700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "「香月？」"
