  {
   "id": "clka06:12800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "「あっはっは！ も、もう我慢できない！」"
  },
  {
   "id": "clka06:12900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "「みっ、宮代先輩、いくらなんでもいい人すぎるでしょ！！ あっはっはっ！！」"
  },
  {
   "id": "clka06:13000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「へ？」"
  },
  {
   "id": "clka06:13100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카즈키 하나",
   "jp": "お腹を抱えて大声で笑い始める香月。いつもと違う口調、いつもと違う表情を見て、来栖たちはあっけに取られている。"
  },
  {
   "id": "clka06:13200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카즈키 하나",
   "jp": "香月は暫く椅子の上で笑い転げた。"
  },
  {
   "id": "clka06:13300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "「いーひーっひ！ ……ふう。おかしすぎて笑い死ぬ所でした」"
  },
  {
   "id": "clka06:13400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "本当におかしかったのだろう。目尻に浮かんだ涙を拭いながら、香月は笑顔で言った。"
  },
  {
   "id": "clka06:13500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "「えっと、宮代先輩は無実です」"
  },
  {
   "id": "clka06:13600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「え？」"
  },
  {
   "id": "clka06:13700",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「体育館倉庫に呼びだしたのはあたしです。押し倒したのもあたし」"
  },
  {
   "id": "clka06:13800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "「ちょっと、香月、それホント！？」"
  },
  {
   "id": "clka06:13900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「うーん、ホントですね。華は嘘を言ってません」"
  },
  {
   "id": "clka06:14000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "「有村がそう言うなら、そうなんだな」"
  },
  {
   "id": "clka06:14100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "이토 신지",
   "next_speaker": "카즈키 하나",
   "jp": "「え、でも、じゃあ、どういうことなの？」"
  },
  {
   "id": "clka06:14200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "이토 신지",
   "next_speaker": "카즈키 하나",
   "jp": "「どうして香月が、拓留を、えっと、その、押し倒す……なんて……」"
  },
  {
   "id": "clka06:14300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「そりゃもちろん、宮代先輩に処女を捧げたかったんです」"
  },
  {
   "id": "clka06:14400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「んなっ！？」"
  },
  {
   "id": "clka06:14500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "品行方正な生徒会長には刺激の強すぎる言葉だったらしく、来栖は口をパクパクさせたままそれ以上喋れなくなった。"
  },
  {
   "id": "clka06:14600",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "카즈키 하나",
   "jp": "「華ちゃん？ あなた、華ちゃんなの？」"
  },
  {
   "id": "clka06:14700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "카즈키 하나",
   "jp": "「なんか、いつもと様子が違うんだけど……」"
  },
  {
   "id": "clka06:14800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "아리무라 히나에",
   "jp": "「わかりました。本当は隠したままでもいいんですけど、ちゃんと説明します」"
  },
  {
   "id": "clka06:14900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "아리무라 히나에",
   "jp": "「自身の尊厳を捨ててまであたしを守ろうとした宮代先輩の騎士道精神のお礼です。宮代先輩、惚れ直しましたよ」"
  },
  {
   "id": "clka06:15000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "そう言って、明らかにいつもの香月でない香月は、呆気に取られたままの僕にウィンクした。"
  },
  {
   "id": "clka06:15100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "香月は、まずことのいきさつを説明して、みんなの誤解を解いてくれた。"
  },
  {
   "id": "clka06:15200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "香月自身に求められたので、エロ自撮り写真もみんなに見せた。"
  },
  {
   "id": "clka06:15300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
