  {
   "id": "claa03:16100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うん。これが『音漏れてん事件』と言われているものだ」"
  },
  {
   "id": "claa03:16200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『歌ってみた』の人気アイドル的な歌い手が路上ライブを決行。"
  },
  {
   "id": "claa03:16300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "途中まではよかったが、とある曲の難しいパート部分がうまく歌えず、口も開いていなかった……にも関わらず、伴奏には見事に歌が乗っていたため、彼女の路上ライブが全て口パクだったことが知れ渡ってしまった。"
  },
  {
   "id": "claa03:16400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:38⟧事件の名前は、その時彼女が口走った『ちゃうねん、ちゃうねん！ どっかから違う曲の音が漏れてん！』という言葉からである。"
  },
  {
   "id": "claa03:16500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そして、『回転ジェット事件』」"
  },
  {
   "id": "claa03:16600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「これは違うな。別の事件だ」"
  },
  {
   "id": "claa03:16700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うん、これがいわゆる『回転ジェット事件』だな」"
  },
  {
   "id": "claa03:16800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "事件当日、他にホテルの空きがなく、ラブホに宿泊していた青年がいたが、彼が座っていた回転ベッドが故障しており、スイッチもいじってないのにいきなり超高速回転を始めてしまったというアホな事件。"
  },
  {
   "id": "claa03:16900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ベッドの上から激しい勢いでふっとばされた青年は壁に激突して全治３週間の怪我をおった。"
  },
  {
   "id": "claa03:17000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:38⟧この恐怖の回転ベッド事件は、当時、某遊園地で人気だった大回転ジェットコースターにちなんで『回転ジェット』と名付けられた。"
  },
  {
   "id": "claa03:17100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "신문부원들",
   "jp": "「そして、最新の事件がこれだ。『ごっつァンデス事件』」"
  },
  {
   "id": "claa03:17200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "有名ネット記者が、アンデス地方出身のとある若手人気力士のスクープをつかみ、相撲部屋に忍び込んだはいいが……若手の弟子たちに見つかり、アンデス風ちゃんこ鍋（？）を白目をむくほど強引に食べさせられて、ダウンした事件。"
  },
  {
   "id": "claa03:17300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "裁判で、原告側は監禁および強要を主張しているが、相撲部屋としては、ただ単に『客人を、部屋名物のアンデス風大盛りちゃんこでおもてなししただけだ』と言い張っている。"
  },
  {
   "id": "claa03:17400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:38⟧この事件はネット民の間で『ごっつぁんです』とかけて、『ごっつァンデス』事件と名付けられている。"
  },
  {
   "id": "claa03:17500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "신문부원들",
   "jp": "「ということで。まとめは以上だ」"
  },
  {
   "id": "claa03:17600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "신문부원들",
   "jp": "「で、さっきも言ったが、この四つのうち、どれを記事にしたらいいか迷ってる。そこで、みんなの意見を聞かせて欲しい。⟦rb⟧忌憚⟦rt⟧きたん⟦/r⟧なく言ってくれ」"
  },
  {
   "id": "claa03:17700",
   "type": "dialogue",
   "speaker": "新聞部員たち",
   "speaker_ko": "신문부원들",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "「「「「「「………」」」」」」"
  },
  {
   "id": "claa03:17800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신문부원들",
   "next_speaker": "카즈키 하나",
   "jp": "部室内に、妙に冷めた空気が流れた。"
  },
  {
   "id": "claa03:17900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신문부원들",
   "next_speaker": "카즈키 하나",
   "jp": "室内の温度まで１〜２度下がった気さえする。"
  },
  {
   "id": "claa03:18000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "신문부원들",
   "next_speaker": "쿠루스 노노",
   "jp": "「ん、ん〜……」"
  },
  {
   "id": "claa03:18100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "야마조에 우키",
   "jp": "「えっと……そうね。どの事件も、その……とっても興味深いわ」"
  },
  {
   "id": "claa03:18200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "「ね、姉さんの言う通りです」"
  },
  {
   "id": "claa03:18300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「すっごいニュースばっかで迷っちゃうな〜」"
  },
  {
   "id": "claa03:18400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "「………」"
  },
  {
   "id": "claa03:18500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "……いや、本当は分かってるんだ、僕だって。"
  },
  {
   "id": "claa03:18600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "どの事件も、使える使えない以前の問題というか……。"
  },
  {
   "id": "claa03:18700",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どの事件もくだらねーなぁ！」"
  },
  {
   "id": "claa03:18800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "쿠루스 노노",
   "jp": "「ぐはーーっ」"
  },
  {
   "id": "claa03:18900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「ちょっと、伊藤くんっ」"
  },
  {
   "id": "claa03:19000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ハッキリ言っちゃダメだよぉー。少しは遠慮してあげなきゃー」"
  },
  {
   "id": "claa03:19100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「お、尾上も来栖も、遠慮とかいらないぞ……」"
  },
  {
   "id": "claa03:19200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "「う？ そうなの？」"
  },
  {
   "id": "claa03:19300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんか、ごめんなさい……」"
  },
  {
   "id": "claa03:19400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「い、いや、いいんだ。逆に言えば、最近の渋谷が平和ってことだからな。ははは……」"
  },
  {
   "id": "claa03:19500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "そう。"
  },
  {
   "id": "claa03:19600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "ここ最近渋谷で起こっている事件は、どれもこれも、ほんとにどうでもいい。"
  },
  {
   "id": "claa03:19700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "というか、平和すぎて、まるで誰かにそう仕組まれているかのような気さえしてくる。"
  },
  {
   "id": "claa03:19800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「なぁ、宮代？ これならさ、『渋谷の新しい隠れスポット』とか『これから流行するファッション』とか、そういう特集の方が受けるんじゃねーの？」"
  },
  {
   "id": "claa03:19900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「尾上とかにメインの記事、書いてもらってさ」"
  },
  {
   "id": "claa03:20000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "이토 신지",
   "next_speaker": "쿠루스 노노",
   "jp": "「えー、いいの！？ やるやる！ のんちゃんも一緒に書くでしょ！？」"
  },
  {
   "id": "claa03:20100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「でも……」"
  },
  {
   "id": "claa03:20200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "来栖が、チラッとこっちを見た。"
  },
  {
   "id": "claa03:20300",
   "type": "narration",
   "speaker": null,
