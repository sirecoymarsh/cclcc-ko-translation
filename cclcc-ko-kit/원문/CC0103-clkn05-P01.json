   "id": "clkn05:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "くっ……なんとか張り紙が見えないだろうか？"
