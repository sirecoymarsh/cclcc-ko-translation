  {
   "id": "clkn05:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「え？ あ、し、知ってるに決まってるだろ！ 僕を誰だと思ってる」"
