  {
   "id": "clkn05:1700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「あ、あのさ、伊藤」"
