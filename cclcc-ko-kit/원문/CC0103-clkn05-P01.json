   "id": "clkn05:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "先頭を歩いているのは、まさに乃々だった。"
  },
