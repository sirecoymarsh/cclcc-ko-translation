   "id": "clkn05:1200",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ？ お前、まさか知らないのか？」"
