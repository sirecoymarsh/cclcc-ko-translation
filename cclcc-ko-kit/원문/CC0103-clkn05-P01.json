   "id": "clkn05:3400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「ああ、そう書いてただろ？ あれ？ 宮代。お前もしかして……」"
