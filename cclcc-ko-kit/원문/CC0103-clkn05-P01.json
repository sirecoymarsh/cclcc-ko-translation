   "id": "clkn05:3600",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「ねえ、タク。あれ……のんちゃん」"
