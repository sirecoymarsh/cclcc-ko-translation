  {
   "id": "clkn05:2500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ、ひどいよねぇ、あの張り紙。校内恋愛禁止令だなんて、おーぼーすぎるよぉ」"
  },
  {
   "id": "clkn05:2600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "「校内恋愛禁止っ！？」"
