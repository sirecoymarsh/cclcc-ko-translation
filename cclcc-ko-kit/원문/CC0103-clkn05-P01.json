  {
   "id": "clkn05:2800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "「し、知ってたよ！ もちろん知ってたとも！ ほんと、ひどい話だよな！！！」"
