   "id": "clkn05:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "どうやら、張り紙に関しての生徒会の考えや真偽を問うているらしい。"
