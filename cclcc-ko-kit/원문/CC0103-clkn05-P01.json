  {
   "id": "clkn05:1400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だよなぁ。それにしても、あ〜、マジでムカつく！ あんなのが通ってたまるかってんだ」"
  },
  {
   "id": "clkn05:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "しまった。"
  },
  {
