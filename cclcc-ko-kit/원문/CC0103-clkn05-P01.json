   "id": "clkn05:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "その後ろを大勢の連中が、乃々に向かって口々に言葉を投げかけながら追っかけている。"
  },
