   "next_speaker": null,
   "jp": "「ふー、ふーっ」"
  },
  {
   "id": "clse07:37800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はい、もっかい、あーん……」"
  },
  {
