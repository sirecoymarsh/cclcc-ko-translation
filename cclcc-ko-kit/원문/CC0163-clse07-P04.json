   "id": "clse07:33100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わっかりました。そんじゃ、学校じゃなるべく接触しない方向でおなしゃす！」"
  },
