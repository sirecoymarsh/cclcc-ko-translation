  {
   "id": "clse07:32300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「早く支度しないと、学校遅れますよ」"
