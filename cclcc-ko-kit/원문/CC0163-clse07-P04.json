   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あー、美味しい！ こんなに美味しいのに食べられないなんて、先輩かわいそー」"
  },
  {
