   "id": "clse07:37200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あー、わかったー。しょうがないですねー、もう。先輩ったら、甘えんぼさんなんだからっ」"
  },
  {
   "id": "clse07:37300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はい、あーんっ」"
  },
  {
   "id": "clse07:37400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「遠慮なんてしないで、あーんっ」"
