   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うぅ……動けねぇ……マジ、動けねぇっす……」"
  },
  {
   "id": "clse07:38900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おかしい……こんなはずじゃなかったのに……」"
  },
  {
   "id": "clse07:39000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
