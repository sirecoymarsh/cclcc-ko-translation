   "id": "clse07:33200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「宮代先輩っ！！！」"
  },
  {
   "id": "clse07:33300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうですけどー、これには事情が……」"
  },
  {
   "id": "clse07:33400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「石田……あー、同じクラスだったことはあるけど、あんま覚えてないなぁ」"
  },
  {
   "id": "clse07:33500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ホントっす」"
  },
  {
   "id": "clse07:33600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あー、って言っても別に変な関係じゃないんです。ただしばらく泊めてもらってるだけで。ね、先輩♪」"
  },
  {
   "id": "clse07:33700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ちょっとー！ ちょっとちょっとー！ なにみんなして納得してくれちゃってんすかー！ こーいう時はふつー、女の子の心配をするもんでしょ」"
  },
  {
   "id": "clse07:33800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ぐにゅにゅにゅ〜……」"
  },
  {
   "id": "clse07:33900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まあ、そういうことです」"
  },
  {
   "id": "clse07:34000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「とりあえずお咎めなかったのは良かったけど……」"
  },
  {
   "id": "clse07:34100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「えー。別にやましいことしてるわけじゃないですしー」"
  },
  {
   "id": "clse07:34200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お固いことで……そんなだから来栖先輩に振り向いてもらえないんすよねぇ」"
  },
  {
   "id": "clse07:34300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いいえぇ、なんでも♪」"
  },
  {
   "id": "clse07:34400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はーい。わっかりましたぁ」"
  },
  {
   "id": "clse07:34500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「しょうがない。宮代先輩、いきましょ」"
  },
  {
   "id": "clse07:34600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はーい。わっかりましたぁ。そんじゃ、宮代先輩、いきましょ」"
  },
  {
   "id": "clse07:34700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わああああああああああああああ！！」"
  },
  {
   "id": "clse07:34800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うっわー。背中にデカデカと『バカ』って書かれた紙、貼られてましたよ、先輩」"
  },
  {
   "id": "clse07:34900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「誰でしょうねぇ、いまどきこんなイタズラするなんて。ひっでー」"
  },
  {
   "id": "clse07:35000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ま、でも生徒会の人も問題ないって言ってましたし、これで隠すことなく堂々と宮代先輩のところで共同生活できるってことですね」"
  },
  {
   "id": "clse07:35100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なにか？」"
  },
  {
   "id": "clse07:35200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「むむっ」"
  },
  {
   "id": "clse07:35300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「むぅ〜……」"
  },
  {
   "id": "clse07:35400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ちゃおーっス！ 有村雛絵、ただいま帰還しましたー！」"
  },
  {
   "id": "clse07:35500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ただいま帰りました！！」"
  },
  {
   "id": "clse07:35600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よろしい。んしょっと」"
  },
  {
   "id": "clse07:35700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふっふっふー」"
  },
  {
   "id": "clse07:35800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほら、私って人が言ってることが、ウソかホントかわかるじゃないですかー」"
  },
  {
   "id": "clse07:35900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それで最近思ったんですけどね。ウソって、ずっとつき続けてると、ホントになることもあるんじゃないかって」"
  },
  {
   "id": "clse07:36000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わかりませんか？」"
  },
  {
   "id": "clse07:36100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「先輩って私のこと、女の子だって思ってないですよね？」"
  },
  {
   "id": "clse07:36200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「この前、母と話した時だって、ぜーんぶ嘘でしたし！」"
  },
  {
   "id": "clse07:36300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「しゃらーっぷ！！」"
  },
  {
   "id": "clse07:36400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんかそれって、すっごーくプライドが傷つくっていうかー、女子として自信なくすっていうかー」"
  },
  {
   "id": "clse07:36500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「てなわけでー、これから私、有村雛絵、もてる女子力すべてをつぎ込み、力戦奮闘、万里一空、全身全霊をもって先輩をメロメロにさせてみせます！！！」"
  },
  {
   "id": "clse07:36600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うっす！ メロメロっす！」"
  },
  {
   "id": "clse07:36700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「これは私のプライドにかけた戦いです。誰がなんと言おうと、私はやる！」"
  },
  {
   "id": "clse07:36800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そう、決して負けられない戦いが、そこにある！」"
  },
  {
   "id": "clse07:36900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ま、でもとりあえず、今日のところはまだ前哨戦ってことで……」"
  },
  {
   "id": "clse07:37000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はい、召し上がれ」"
  },
  {
   "id": "clse07:37100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしたんですか？ 食べないんですか？」"
  },
