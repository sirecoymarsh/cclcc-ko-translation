  {
   "id": "clse07:32600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「また来るって母は言ってましたからね。その時のためです」"
