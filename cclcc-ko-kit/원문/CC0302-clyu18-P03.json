 ],
 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "伊藤の言うとおりだ。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "そんなものあるはずが――。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "いや……あった。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "ひとつだけ……。"
  },
  {
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "jp": "「僕のこと……かも……」"
  },
  {
