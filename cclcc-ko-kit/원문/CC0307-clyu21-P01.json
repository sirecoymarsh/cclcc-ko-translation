  {
   "id": "clyu21:9300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "この先どうなるかはわからないけれど――。"
