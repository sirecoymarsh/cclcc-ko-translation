  {
   "id": "clyu21:6800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "とはいえ、妹にこんな風に言われてなんて返せばいいのか、⟦col:280aa02d1400⟧クールキャットプレス⟦col:800000⟧は教えてはくれなかった。"
  },
  {
   "id": "clyu21:6900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "だから僕は――。"
  },
  {
   "id": "clyu21:7000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「そ、そっか……」"
