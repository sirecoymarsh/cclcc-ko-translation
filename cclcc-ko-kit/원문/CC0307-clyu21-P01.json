 ],
 "context_before": [],
 "entries": [
  {
   "id": "clyu21:0",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「私たち、アイドル活動やめる」"
  },
  {
   "id": "clyu21:100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「え？ 今、なんて……？」"
  },
  {
   "id": "clyu21:200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だから、アイドル活動やめるの」"
  },
  {
   "id": "clyu21:300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clyu21:400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "あの後、僕は乃々にこってりと絞られた。"
  },
  {
   "id": "clyu21:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "いや、“こってり”の一言では足りないくらい、絞られ過ぎて僕の身体には搾りかすしか残ってないんじゃないか……それくらい、激しく絞られた。"
  },
  {
   "id": "clyu21:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "あの時の乃々の様子をひと言で表すなら、そう……鬼神だ。"
  },
  {
   "id": "clyu21:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "鬼神に比べれば⟦col:280aa02d1400⟧女帝⟦col:800000⟧なんて可愛いものだった。"
  },
  {
   "id": "clyu21:800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "最早思い出すのも嫌だけど、しばらくはあの夜の乃々の恐ろしさを夢に見てしまうかもしれない。"
  },
  {
   "id": "clyu21:900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "事件を起こした男の名は、大谷悠馬と言って、以前⟦col:280aa02d1400⟧ニヤ生⟦col:800000⟧で『こっち見んなー！事件』を起こした張本人だった。"
  },
  {
   "id": "clyu21:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "元々、人気の⟦col:280aa02d1400⟧生主⟦col:800000⟧だった大谷は、あの『こっち見んなー！事件』以降、すっかり人気をなくして燻っていたらしい。"
  },
  {
   "id": "clyu21:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その鬱屈した感情が、ニヤ動で人気を伸ばしてきていた結衣と結人のふたりに、あんな行動となってぶつけられたようだ。"
  },
  {
   "id": "clyu21:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "そして皮肉なことに、あの時の生放送は話題が話題を呼んで、ニヤ生史上でも類を見ないほどの視聴者数を集めることとなった"
  },
  {
   "id": "clyu21:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "と同時に、その標的になった『⟦col:280aa02d1400⟧ミルフィーユ⟦col:800000⟧』の存在を、更に世間に知らしめることとなり、僕の元にはよりたくさんのオファーが舞い込んでいた。"
  },
  {
   "id": "clyu21:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "そんな最中の、さっきの結衣の発言だった。"
  },
  {
   "id": "clyu21:1500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "「……本当に辞めちゃうのか？」"
  },
  {
   "id": "clyu21:1600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うん、いいの。やっぱりアイドル活動なんて、私たちには過ぎたことだったんだよ」"
  },
  {
   "id": "clyu21:1700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "「結人も……それでいいのか？」"
  },
  {
   "id": "clyu21:1800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「いいよ。僕もいつまでも女の子のフリしてらんないもん」"
  },
  {
   "id": "clyu21:1900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "無事に済んだとはいえ、結衣にしてみれば、かなり怖い体験だったはずだ。"
  },
  {
   "id": "clyu21:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それに、結人を自分のやりたいことに無理矢理巻き込んでいたという負い目もある。"
  },
  {
   "id": "clyu21:2100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こうした結論になるのも無理もないことなのかもしれない。"
  },
  {
   "id": "clyu21:2200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "「そうか……わかった。それじゃあ後は、僕が責任もってなんとかしておくよ」"
  },
  {
   "id": "clyu21:2300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「いいの？ やめても……」"
  },
  {
   "id": "clyu21:2400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "「いいもなにも、元々、結衣たちがやりたくて始めたことだろ？ ふたりが決めたなら、僕がとやかく言うことじゃない」"
  },
  {
   "id": "clyu21:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "と、格好つけてはみたけど、正直もったいないという気持ちも無くはなかった。"
  },
  {
   "id": "clyu21:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "けれど、あんな出来事があった後じゃ、無理強いするわけにはいかない。"
  },
  {
   "id": "clyu21:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "それに……。"
  },
  {
   "id": "clyu21:2800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "ここで無理矢理続けるなんて言ったら、今度こそ乃々に殺されるかもしれない。"
  },
  {
   "id": "clyu21:2900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "それだけはカンベンだ。"
  },
  {
   "id": "clyu21:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "それに――。"
  },
  {
   "id": "clyu21:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "今思い返してみれば、あんな活動であれだけ人気が出たというのも、どこかおかしいように思う。"
  },
  {
   "id": "clyu21:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "僕は、すぐ隣で黙って僕たちの会話を聞いていたうきを見た。"
  },
  {
   "id": "clyu21:3300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「…………」"
  },
  {
   "id": "clyu21:3400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "もしかしたらあれは、うきの能力のせいじゃなかったのか。"
  },
  {
   "id": "clyu21:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "誰かの『望み』を無意識に⟦col:280aa02d1400⟧リアルブート⟦col:800000⟧させる能力――。"
  },
  {
   "id": "clyu21:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "誰かを応援したいといううきの思いが、結衣の希望を叶えさせるためにあの状況を⟦rb⟧現実化⟦rt⟧リアルブート⟦/r⟧した。"
  },
  {
   "id": "clyu21:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "充分にその可能性はある。"
  },
  {
   "id": "clyu21:3800",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……あの、どうかしましたか？」"
  },
  {
   "id": "clyu21:3900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유토",
   "jp": "「いや……」"
  },
  {
   "id": "clyu21:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "そうであるなら、あれは妄想の世界の出来事であり、妄想はいつかは終わらなきゃいけない。"
  },
  {
   "id": "clyu21:4100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「それじゃ、僕、友だちのとこ行ってくる！」"
  },
  {
   "id": "clyu21:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "야마조에 우키",
   "jp": "ここのところのアイドル活動で、友だちと過ごせる時間も少なくなっていた結人は、晴れ渡ったような顔で、嬉しそうに外に飛び出して行った。"
  },
  {
   "id": "clyu21:4300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "「私も、お父さんのお手伝いしてきますね」"
  },
  {
   "id": "clyu21:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "裏方として僕たちを手伝っていたうきも、やはり嬉しそうだった。"
  },
  {
   "id": "clyu21:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "彼女は彼女で、やはり⟦col:280aa02d1400⟧青葉医院⟦col:800000⟧の手伝いが性に合ってるらしい。"
  },
  {
   "id": "clyu21:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "そう考えると、落ち着くところに落ち着いたのかもしれない。"
  },
  {
   "id": "clyu21:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "残念なのは……結衣にもう少しくらい夢を見させていてやりたかったってことくらいだけど。"
  },
  {
   "id": "clyu21:4800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留兄……ありがと」"
  },
  {
   "id": "clyu21:4900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「結衣……」"
  },
  {
   "id": "clyu21:5000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「私ね、拓留兄のおかげで、すっごく楽しかった」"
  },
  {
   "id": "clyu21:5100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この屈託のない表情に嘘偽りはないだろう。"
  },
  {
   "id": "clyu21:5200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「ごめんな。夢、叶えてやれなくて……」"
  },
  {
   "id": "clyu21:5300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ううん、いいの。それにね、私、わかったことがあるんだ」"
  },
  {
   "id": "clyu21:5400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣は後ろ手に手を組むと、一歩踏み出し、僕の顔を見上げた。"
  },
  {
   "id": "clyu21:5500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その真っ直ぐな瞳に、何故かどぎまぎとさせられ、それを悟られまいと僕は冷静を装って尋ねる。"
  },
  {
   "id": "clyu21:5600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「わかったことって？」"
  },
  {
   "id": "clyu21:5700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「アイドルってね、誰かを元気にできる存在だって、拓留兄言ったよね？」"
  },
  {
   "id": "clyu21:5800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「ああ……言ったな」"
  },
  {
   "id": "clyu21:5900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それって、元気にできる相手がひとりでも、アイドルになれるってことだよね？」"
  },
  {
   "id": "clyu21:6000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「ま、まあ、そういうことになる……な」"
  },
  {
   "id": "clyu21:6100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「だったらね」"
  },
  {
   "id": "clyu21:6200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "結衣がさらに一歩近づく。"
  },
  {
   "id": "clyu21:6300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "その視線をまっすぐ僕に向けたまま。"
  },
  {
   "id": "clyu21:6400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「私もアイドルになれたらいいなって……拓留兄のためだけの……」"
  },
  {
   "id": "clyu21:6500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣の顔が、みるみる真っ赤に染まってゆく。"
  },
  {
   "id": "clyu21:6600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それでも、彼女は僕から視線を逸らそうとはしなかった。"
  },
  {
   "id": "clyu21:6700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もちろん結衣の言葉がどういう意味なのか、僕にだって理解できないわけじゃない。"
