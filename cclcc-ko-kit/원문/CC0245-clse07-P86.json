   "speaker_ko": "오노에 세리카",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「シャワー、浴びなきゃ……」"
  },
  {
   "id": "clse07:822400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「って、これじゃなんだか、私が欲求不満みたいじゃない」"
