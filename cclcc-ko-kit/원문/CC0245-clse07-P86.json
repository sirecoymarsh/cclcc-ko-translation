   "id": "clse07:822700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「さて、と……今日はどうしようかな？」"
  },
  {
   "id": "clse07:822800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（やっぱ、渋谷……かなぁ？）"
  },
  {
   "id": "clse07:822900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（でも、さ。行きたいんだもん、しょうがないよね）"
  },
  {
   "id": "clse07:823000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「しょうがない、ひとりで行くかなぁ」"
  },
  {
   "id": "clse07:823100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「くっそー、あの４人！」"
