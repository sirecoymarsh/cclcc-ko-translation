   "id": "clse07:822200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「ふぅ……」"
