 "source_file": "clyu01.msb",
 "speakers_in_packet": [
  "MOMONE",
  "미야시로 타쿠루",
  "야마조에 우키",
  "쿠루스 노노",
  "타치바나 유이"
 ],
 "context_before": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「そ、そうだよ。当然、じゃないか。あはははは……」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "知らなかった。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "まさかあの高柳桃寧が、そんな風にブレイクしていたなんて。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "これも⟦col:280aa02d1400⟧炎上商法⟦col:800000⟧というやつか。"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「はぁ、いいなぁ、ＭＯＭＯＮＥ。かわいいなぁ……」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「そんなに人気あるのか？」"
  }
 ],
 "entries": [
  {
   "id": "clyu01:49500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うちのクラスじゃ、ほとんど全員大好きだよ」"
  },
  {
   "id": "clyu01:49600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "「そ、そうか……」"
  },
  {
   "id": "clyu01:49700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "世の中何が幸いするかわからないな。"
  },
  {
   "id": "clyu01:49800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "それにしても……。"
  },
  {
   "id": "clyu01:49900",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "MOMONE",
   "jp": "「…………」"
  },
  {
   "id": "clyu01:50000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "MOMONE",
   "jp": "思ったとおり、うきはそれほど興味がありそうにも思えない。"
  },
  {
   "id": "clyu01:50100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "MOMONE",
   "jp": "見るからに――結衣に誘われたから一緒に見てるだけ――といった感じだ。"
  },
  {
   "id": "clyu01:50200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "MOMONE",
   "jp": "要するに、うきは“クラスのほとんど全員”から外れた人間ということだろう。"
  },
  {
   "id": "clyu01:50300",
   "type": "dialogue",
   "speaker": "ＭＯＭＯＮＥ",
   "speaker_ko": "MOMONE",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「みんなぁ。今日はゆっくりしてもらえたかなぁ？」"
  },
  {
   "id": "clyu01:50400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "MOMONE",
   "next_speaker": "MOMONE",
   "jp": "そうこうしているうちに、ＭＯＭＯＮＥのニヤ生配信は終わりに差し掛かっていた。"
  },
  {
   "id": "clyu01:50500",
   "type": "dialogue",
   "speaker": "ＭＯＭＯＮＥ",
   "speaker_ko": "MOMONE",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「今日もたくさんの視聴、ありがとぉ。来週もまた見てね！」"
  },
  {
   "id": "clyu01:50600",
   "type": "dialogue",
   "speaker": "ＭＯＭＯＮＥ",
   "speaker_ko": "MOMONE",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ＭＯＭＯＮＥの『ゆっくりしていってね♪』でした。ばいば〜い」"
  },
  {
   "id": "clyu01:50700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "MOMONE",
   "next_speaker": "미야시로 타쿠루",
   "jp": "後ろから画面を覗き込んで視聴数を確かめてみる。"
  },
  {
   "id": "clyu01:50800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "MOMONE",
   "next_speaker": "타치바나 유이",
   "jp": "「さ、さんまんにんっ！？」"
  },
  {
   "id": "clyu01:50900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "驚くべきことに、視聴者の数は３万人を超えていた。"
  },
  {
   "id": "clyu01:51000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "僕たち新聞部の配信なんて、１００人にも満たないというのに、あんな口パクのネットアイドルの生配信がそんなにカウントを稼ぐなんて。"
  },
  {
   "id": "clyu01:51100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "世の中どうかしている。"
  },
  {
   "id": "clyu01:51200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "やがて、画面はアンケート画面に変わり……。"
  },
  {
   "id": "clyu01:51300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「…………」"
  },
  {
   "id": "clyu01:51400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "その画面を何故か結衣はぼんやりと見ていた。"
  },
  {
   "id": "clyu01:51500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "もしかしたら、この後何か始まるのだろうか、と思ったけど、そういうわけでもなさそうだ。"
  },
  {
   "id": "clyu01:51600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "どうしたんだろう？"
  },
  {
   "id": "clyu01:51700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "しばらく見ていると、ついに画面は黒く変わり――そして、結衣がぽつりと言った。"
  },
  {
   "id": "clyu01:51800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……私も……アイドルになりたいな……」"
  },
  {
   "id": "clyu01:51900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「え？」"
  },
  {
   "id": "clyu01:52000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "なんだか嫌な予感がした……。"
  },
  {
   "id": "clyu01:52100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうだ！」"
  },
  {
   "id": "clyu01:52200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "と、それを裏付けるように、結衣が勢いよく振り返って僕を見ると、身体を乗り出してきた。"
  },
  {
   "id": "clyu01:52300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ね、拓留兄！ 拓留兄はネット配信とか詳しいんだよね？」"
  },
  {
   "id": "clyu01:52400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「え？ ま、まあ、そりゃ、僕に知らないことはないけど……」"
  },
  {
   "id": "clyu01:52500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「さっすが拓留兄！ それじゃあ、ニヤ生とかできるよね！？」"
  },
  {
   "id": "clyu01:52600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "おい、まさかこれは……。"
  },
  {
   "id": "clyu01:52700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「私もアイドルになりたい！！」"
  },
  {
   "id": "clyu01:52800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "思ったとおり、結衣の奴はとんでもないことを言い出した。"
  },
  {
   "id": "clyu01:52900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もしかして、結衣が悩んでる風に見えてたのは……これだったのか？"
  },
  {
   "id": "clyu01:53000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こっそりと乃々の顔を盗み見ると、彼女もまた複雑そうな顔をしていた。"
  },
  {
   "id": "clyu01:53100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "妹の悩みをなんとかしたいと思っていたら、まさかこんな悩みだったとは……といったところだろう。"
  },
  {
   "id": "clyu01:53200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この時、僕はようやく思い至った。"
  },
  {
   "id": "clyu01:53300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣が何か書いているという例のノート……あれはサインの練習なんじゃないのか？"
  },
  {
   "id": "clyu01:53400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "有名人を夢見る人間なら誰しもが行うという所業。"
  },
  {
   "id": "clyu01:53500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "やめろ結衣。それはいずれ⟦col:280aa02d1400⟧黒歴史⟦col:800000⟧へと代わり、自らを殺す⟦col:280aa02e1400⟧デスノート⟦col:800000⟧になるぞ。"
  },
  {
   "id": "clyu01:53600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "「い、いや、でもアイドルなんて、そんな簡単になれるもんじゃないだろ」"
  },
  {
   "id": "clyu01:53700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうして？ ネット環境があれば、ＭＯＭＯＮＥみたいに、ニヤ生の配信はできるんでしょ？」"
  },
  {
   "id": "clyu01:53800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「だからってだな……」"
  },
  {
   "id": "clyu01:53900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「あー、そっか。うん、でもひとりだとちょっと不安かもね」"
  },
  {
   "id": "clyu01:54000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "人の話、ぜんぜん聞いてない。"
  },
  {
   "id": "clyu01:54100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「ね、うきちゃん！ 一緒にやらない？ アイドル活動！」"
  },
  {
   "id": "clyu01:54200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「え？ アイドル活動……ですか？」"
  },
  {
   "id": "clyu01:54300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「うんっ」"
  },
  {
   "id": "clyu01:54400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "……そう来たか。"
  },
  {
   "id": "clyu01:54500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "面倒なことになってきたぞ。"
  },
  {
   "id": "clyu01:54600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「でも、アイドルって何をすればいいのか、私わかりません……」"
  },
  {
   "id": "clyu01:54700",
   "type": "dialogue",
   "speaker": "橘結衣",
