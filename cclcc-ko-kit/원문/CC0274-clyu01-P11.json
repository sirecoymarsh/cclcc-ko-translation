   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あれ？ なあ……今のヤツ、アレじゃね？ 昔、アイドルのプロデューサーとかやってた……」"
  },
  {
   "id": "clyu01:104900",
   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「は？ 誰それ？ 知らね」"
