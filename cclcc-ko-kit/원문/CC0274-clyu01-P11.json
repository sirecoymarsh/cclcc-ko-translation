  {
   "id": "clyu01:105700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "アイドル活動なんて、やっぱりそんなに簡単なものじゃなかったんだ。"
  },
  {
   "id": "clyu01:105800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "겐 씨",
   "jp": "今の時代、アイドルはどれだけ活動を長く続けられるかが勝負だ。"
  },
  {
   "id": "clyu01:105900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "겐 씨",
   "jp": "長い長い下積みを経て、多くの人に認知されるようになって、ようやく小さな花を咲かせる、それがアイドルだ。"
  },
  {
   "id": "clyu01:106000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "겐 씨",
   "jp": "そのためにはやはり資金が必要で、僕たちはその根本の部分で間違っていた。"
  },
  {
   "id": "clyu01:106100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "겐 씨",
   "jp": "おかげで結衣と結人の活動はあっという間に終了。"
  },
