  {
   "id": "clyu01:105100",
   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ンなヤツ、知るわけねーって」"
