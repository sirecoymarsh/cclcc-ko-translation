   "id": "clyu01:105200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "남자",
   "next_speaker": null,
   "jp": "「はぁ……」"
  },
  {
   "id": "clyu01:105300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "アイドル活動か……懐かしいな。"
  },
  {
   "id": "clyu01:105400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "最初は結構いい線いくと思ったんだよ。"
  },
  {
   "id": "clyu01:105500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "ネット上ではそれなりにファンもついて、ライブハウスで活動するようになって、テレビにも少しは出るようになって……。"
  },
  {
   "id": "clyu01:105600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "だけど……僕が甘かった。"
