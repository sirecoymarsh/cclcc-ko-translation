  {
   "id": "clse07:706600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんで本来の意味でとらえるんだよ……」"
  },
  {
   "id": "clse07:706700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まあ、アイドル活動って言っても、お遊びみたいなもんだけどさ……」"
  },
  {
   "id": "clse07:706800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ま、まあそれなりには……」"
  },
  {
   "id": "clse07:706900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、アイドルの人たち……ごめんなさい……」"
  },
  {
   "id": "clse07:707000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わ、わかったよ。僕の認識が間違ってた……」"
  },
  {
   "id": "clse07:707100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「アイドル活動は、僕なんかがそう軽々しく手を出していいものじゃなかったんだ。諦めるよ」"
  },
  {
   "id": "clse07:707200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「は？ だって、お前らが言ったんじゃないか。軽々しくやるものじゃないって」"
  },
  {
   "id": "clse07:707300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「誰が結衣とうきがやるって言った？」"
  },
  {
   "id": "clse07:707400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、んなわけないだろ」"
  },
  {
   "id": "clse07:707500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ユニットを組むのは、結衣とうきじゃない。結衣と結人だ」"
  },
  {
   "id": "clse07:707600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もちろん、女の子のユニットだ」"
  },
  {
   "id": "clse07:707700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え……？」"
  },
  {
   "id": "clse07:707800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「無茶言うな。そもそも、こんなこと想定してないんだから」"
  },
  {
   "id": "clse07:707900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:708000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「な、なんで僕が伊藤に嫉妬なんかしなくちゃいけないんだ……」"
  },
  {
   "id": "clse07:708100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「別に照れてないし！」"
  },
  {
   "id": "clse07:708200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「は？ なんで？」"
  },
  {
