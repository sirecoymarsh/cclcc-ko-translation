   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:709200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っ……」"
  },
  {
   "id": "clse07:709300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おい、伊藤！ これは……」"
  },
  {
   "id": "clse07:709400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ……はい」"
  },
  {
   "id": "clse07:709500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「って、そうじゃなくて！ おい、伊藤！ なんだよこれは！？」"
  },
  {
   "id": "clse07:709600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いきなり水着とか、ちょっとやり過ぎじゃないのか？」"
  },
  {
   "id": "clse07:709700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そ、それはそうだけどさ……だ、だからっていうか……その、ちょっと布地が……小さすぎないか」"
  },
  {
   "id": "clse07:709800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っ……」"
  },
  {
   "id": "clse07:709900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ストップ！！ ダメだダメだ！ カメラ止めろ！」"
  },
  {
   "id": "clse07:710000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いいからとにかく止めろ！」"
  },
  {
   "id": "clse07:710100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「伊藤にはプロデューサーを降りてもらう」"
  },
  {
   "id": "clse07:710200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「これ以上お前には任せておけないと僕が判断したからだ。いくらなんでも、あれはやり過ぎだ」"
  },
  {
   "id": "clse07:710300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、他にも方法はあるはずだ。それが思いつかないというなら、やっぱり伊藤には降りてもらうしかない」"
  },
  {
   "id": "clse07:710400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そもそもあそこ借りるお金はどうしたんだよ？ 水着だって金かかっただろ」"
  },
  {
   "id": "clse07:710500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お前な……これは部活じゃないんだから、そんなことできるわけないだろ？」"
  },
  {
   "id": "clse07:710600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「知らないよ。お前が勝手にやったんだろ。自分でなんとかしろ」"
  },
  {
   "id": "clse07:710700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おい、有村。大丈夫なのか、あれ……」"
  },
  {
   "id": "clse07:710800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「制服なんて作る金、無かっただろ」"
  },
  {
   "id": "clse07:710900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうなのか？ でも制服だろ？ 材料費だけでも、それなりにいくんじゃないか？」"
  },
  {
   "id": "clse07:711000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おおぉ、これは――！」"
  },
  {
   "id": "clse07:711100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:711200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「待て、有村」"
  },
  {
   "id": "clse07:711300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「有村……お前、全体的に古くさい……」"
  },
  {
   "id": "clse07:711400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だから、感覚が古いんだって。なんだよ、さっきの」"
  },
  {
   "id": "clse07:711500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いつの時代のアイドルだよ、それ」"
  },
  {
   "id": "clse07:711600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしかして、この後、メリーゴーランドに乗って手を振ったり、草原に寝そべってタンポポの花びらを１枚１枚数えたりしないよな？」"
  },
  {
   "id": "clse07:711700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕に……？」"
  },
  {
   "id": "clse07:711800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わかったよ。そこまで言うなら、これからは僕が責任をもってふたりをプロデュースする」"
  },
  {
   "id": "clse07:711900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「結衣は知ってるよな？」"
  },
  {
   "id": "clse07:712000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そういうことだ」"
  },
  {
   "id": "clse07:712100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「というわけで、ふたりにはこれから、この曲に合わせて踊ってもらう」"
  },
  {
   "id": "clse07:712200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それは、ほら。結人もその格好に慣れとかないと、いざという時の立ち居振る舞いとかに出ちゃうだろ？」"
  },
  {
   "id": "clse07:712300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「てわけで、これからさっきの曲でダンスしてもらうけど……できるよな？」"
  },
  {
   "id": "clse07:712400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「結衣……とりあえず今日はこれくらいにしておこうか」"
  },
  {
   "id": "clse07:712500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「来栖も帰って来たし、今日はこれで終わりだ。な？」"
  },
  {
   "id": "clse07:712600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ああ。いいよ」"
  },
  {
   "id": "clse07:712700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ま、まあ、あんまり思いつめなくてもいいんじゃないか？ 誰だって苦手なものはあるわけだし、少しずつ克服していけば」"
  },
  {
   "id": "clse07:712800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「じゃあ、どうする？ アイドル活動をやめるか？」"
  },
  {
   "id": "clse07:712900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ゆ、結衣……なにも泣かなくても……」"
  },
  {
   "id": "clse07:713000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「大丈夫……結衣ならできるよ」"
  },
  {
   "id": "clse07:713100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕がついてる」"
  },
  {
   "id": "clse07:713200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ああ……」"
  },
  {
   "id": "clse07:713300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「な、なに？」"
  },
  {
   "id": "clse07:713400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……ああ」"
  },
  {
   "id": "clse07:713500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「（あ、あれ……？）」"
  },
  {
   "id": "clse07:713600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「（でも、血は繋がってないんだよな……）」"
  },
  {
   "id": "clse07:713700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「（子どもだ子どもだと思ってたけど、意外と……）」"
  },
  {
   "id": "clse07:713800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ん？」"
  },
  {
   "id": "clse07:713900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ご、ゴメン……」"
  },
  {
   "id": "clse07:714000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そ、そっか……」"
  },
  {
   "id": "clse07:714100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「大丈夫か、結衣？ ちょっと休むか？」"
  },
