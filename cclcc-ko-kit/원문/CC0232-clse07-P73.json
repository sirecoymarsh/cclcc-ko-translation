   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんだよ？ 別に男同士なんだからいいだろ？」"
  },
  {
   "id": "clse07:708400",
   "type": "dialogue",
   "speaker": "宮代拓留",
