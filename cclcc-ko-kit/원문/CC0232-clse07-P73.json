   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「な……」"
  },
  {
   "id": "clse07:708600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「これは……」"
  },
  {
   "id": "clse07:708700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ていうか、ウィッグなんてどこから持ってきたんだよ？」"
  },
  {
   "id": "clse07:708800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、僕でいいんじゃないか？」"
  },
  {
   "id": "clse07:708900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「『ミルフィーユ』か。へえ……悪くない名前じゃないか」"
  },
  {
   "id": "clse07:709000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
