   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "何故だか僕は、その姿から逃げるように目を逸らして、慌てて衣服を身に着け始めた。"
  },
  {
   "id": "clzz99:32200",
   "type": "dialogue",
