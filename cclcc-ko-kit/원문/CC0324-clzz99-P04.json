  {
   "id": "clzz99:32300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "「タク、大丈夫！？」"
  },
  {
   "id": "clzz99:32400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "危なかった……。"
  },
  {
   "id": "clzz99:32500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "慌ただしく尾上が飛び込んできたのは、まさに服を着終えたその直後のことだった。"
  },
  {
   "id": "clzz99:32600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "どうやら、地震による誤作動で部室のドアのロックがかかり、そのまま停電したことで扉は開かなかったらしい。"
  },
  {
   "id": "clzz99:32700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "それが今朝になって電力が回復し、そのおかげでドアもすんなりと開いたようだ。"
  },
  {
   "id": "clzz99:32800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "아리무라 히나에",
   "jp": "「……まさか、部室に閉じ込められてただなんて……」"
  },
  {
   "id": "clzz99:32900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "そして、昨夜僕にメッセージを送ったものの返事がないことを不審に思った尾上が、来栖と相談し、朝一番に学校の教室で僕のスマホを見つけ、ここに駆けつけ発見に至った……ということらしい。"
  },
  {
   "id": "clzz99:33000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "幸いなことに、学校の外は特に大きな被害もなく、こうして地震による被害はごく一部だけで済んだ。"
  },
  {
   "id": "clzz99:33100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「いやはや、災難でしたなぁ」"
