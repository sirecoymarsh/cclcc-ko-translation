{
 "packet_id": "CC0010-claa03-P04",
 "kit_version": "1.0",
 "source_file": "claa03.msb",
 "speakers_in_packet": [
  "미야시로 타쿠루",
  "신문부원들",
  "야마조에 우키",
  "에린",
  "오노에 세리카",
  "이토 신지",
  "카와하라 마사시",
  "쿠루스 노노"
 ],
 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "驚いて振り返ると、そこにいたのは――"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「あ、川原くん……」"
  },
  {
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "jp": "「やっぱりここだったか」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "生徒会の副会長が、文字通り“上から目線”で立っていた。"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「……えと……何か？」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "僕は、彼が少し……いや、かなり苦手だ。"
  }
 ],
 "entries": [
  {
   "id": "claa03:24200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "生徒会の会長である来栖のサポートを完璧にこなす優等生。また、彼女の幼馴染でもある。"
  },
  {
   "id": "claa03:24300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そんな彼にしてみれば、来栖の生徒会活動の時間を削る僕ら新聞部は邪魔以外の何者でもなくて、なにかというと、目のかたきにしてくるのだ。"
  },
  {
   "id": "claa03:24400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "에린",
   "jp": "「何か用、ですか？」"
  },
  {
   "id": "claa03:24500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "에린",
   "jp": "僕はもう一回、おずおずと尋ねた。"
  },
  {
   "id": "claa03:24600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "에린",
   "jp": "彼がこういう態度とともに現われる時は、ロクな話じゃないことが多い。"
  },
  {
   "id": "claa03:24700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "에린",
   "jp": "しかも、"
  },
  {
   "id": "claa03:24800",
   "type": "dialogue",
   "speaker": "エリン",
   "speaker_ko": "에린",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「よく来たな。まぁ、ゆっくりとしていくがよい」"
  },
  {
   "id": "claa03:24900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "에린",
   "next_speaker": "미야시로 타쿠루",
   "jp": "店員さんが厨房から顔を出し、いつもの調子で言ったのに対し、よりにもよって彼は『いや、結構。彼に用件だけ伝えてすぐに帰りますから』と言い放ちやがった。"
  },
  {
   "id": "claa03:25000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "에린",
   "next_speaker": "미야시로 타쿠루",
   "jp": "途端に店員さんは、明らかにムスッとした顔になる。"
  },
  {
   "id": "claa03:25100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "에린",
   "next_speaker": "카와하라 마사시",
   "jp": "（バカ川原！ 今のは、『そんな所に突っ立ってないで、さっさと座って注文しろ』って意味だから！）"
  },
  {
   "id": "claa03:25200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "こんなことで店員さんの機嫌を損ねて、僕らまで出入り禁止になったらどうすんだよ？"
  },
  {
   "id": "claa03:25300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "しかし、僕の目線だけでの抗議など気づかない様子で、川原くんは店内をジロジロと見回した。"
  },
  {
   "id": "claa03:25400",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うん？ 生徒会長がいないな」"
  },
  {
   "id": "claa03:25500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「来栖なら、先に帰りましたよ。今日は、青葉寮の食事当番だとか……」"
  },
  {
   "id": "claa03:25600",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうか。会長の前では話しづらいことだったからな。ちょうどいい」"
  },
  {
   "id": "claa03:25700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「………」"
  },
  {
   "id": "claa03:25800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "うわあ！ なんて白々しい！"
  },
  {
   "id": "claa03:25900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "今日ここに来栖がいないのを知ってて――それで来たくせに！"
  },
  {
   "id": "claa03:26000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "僕ら全員、思いっきり冷めた目をしたが、彼は全く意に介することもなく話し始めた。このふてぶてしさだけは、ちょっとうらやましい。"
  },
  {
   "id": "claa03:26100",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「実は生徒会の話なんだけどな。今の季節は学校行事も多くて、結構忙しいんだ」"
  },
  {
   "id": "claa03:26200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「はぁ……」"
  },
  {
   "id": "claa03:26300",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「当然、生徒会長の負担もかなり大きくなっている。そのせいで来栖は、休みの日まで仕事をしてくれてるんだ」"
  },
  {
   "id": "claa03:26400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "それは、確かにその通りだった。"
  },
  {
   "id": "claa03:26500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "休日に青葉寮を訪ねていくと、来栖が、生徒会主催の行事の計画表やら、予算の計算やら、道具の手配やらをしているのを見かける。"
  },
  {
   "id": "claa03:26600",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「しかも、勉強も欠かさず、テストの成績は常にトップクラスだ。彼女がどれだけ大変な思いをしてるか分かるよな？」"
  },
  {
   "id": "claa03:26700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「………」"
  },
  {
   "id": "claa03:26800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "あー、なるほど。"
  },
  {
   "id": "claa03:26900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "その後に続く言葉が分かった。"
  },
  {
   "id": "claa03:27000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "『だから、新聞部なんかの活動で、来栖を引っ張り回すな』だ。"
  },
  {
   "id": "claa03:27100",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「今の新聞部は、集まってもただ遊んでいるだけ。何の役にも立ってないじゃないか。そんな活動に、彼女の貴重な時間を浪費させないでくれないか」"
  },
  {
   "id": "claa03:27200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "이토 신지",
   "jp": "「待ってよ、川原くん。僕らは別に遊んでるわけじゃない……」"
  },
  {
   "id": "claa03:27300",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "「全くだ。色々と取材したり、結構ハードなんだからな」"
  },
  {
   "id": "claa03:27400",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「取材だって？ そもそも、他の学校の、健全な新聞部というものを知っているのか？」"
  },
  {
   "id": "claa03:27500",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「彼らは、学校行事の特集をしたり、インターハイを目指している部活や生徒をピックアップしたり……学校にとって有意義な紙面を作ってる」"
  },
  {
   "id": "claa03:27600",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それに対して、キミたちは――なんだか分からない⟦col:280aa02d1400⟧都市伝説⟦col:800000⟧だの、あやしいウワサの調査だの。そういうのは、学校新聞のやることなのか？」"
  },
  {
   "id": "claa03:27700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「う……」"
  },
  {
   "id": "claa03:27800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "痛い所を、ストレートに突かれてしまった。"
  },
  {
   "id": "claa03:27900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "これは確かに言い返せない。"
  },
  {
   "id": "claa03:28000",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "신문부원들",
   "jp": "「生徒会としては、そんな部に貴重な部費など配分出来ない。そう思わないか？」"
  },
  {
   "id": "claa03:28100",
   "type": "dialogue",
   "speaker": "新聞部員たち",
   "speaker_ko": "신문부원들",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「「「「ええっ？」」」」"
  },
  {
   "id": "claa03:28200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신문부원들",
   "next_speaker": "카와하라 마사시",
   "jp": "ちょ、ちょっと待て。"
  },
  {
   "id": "claa03:28300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신문부원들",
   "next_speaker": "카와하라 마사시",
   "jp": "もしかして部費を削減するって話か？"
  },
  {
   "id": "claa03:28400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신문부원들",
   "next_speaker": "카와하라 마사시",
   "jp": "それは困る。今でも少なくて困ってるのに。"
  },
  {
   "id": "claa03:28500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신문부원들",
   "next_speaker": "카와하라 마사시",
   "jp": "川原くんは、生徒会の意図を僕が察したとみて、さらに偉そうにひとつうなずいた。"
  },
  {
   "id": "claa03:28600",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "신문부원들",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「もちろん、すぐに部費を減らすような横暴な真似はしない。キミたち含めて、活動実態の怪しい部の活動を、これからしばらくチェックさせてもらう。そういう話だ」"
  },
  {
   "id": "claa03:28700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「あ、あの、来栖も――生徒会長も承知してるんですか、そのこと？」"
  },
  {
   "id": "claa03:28800",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふっ。来栖に泣きつこうとしても無駄だ。そもそも俺の言ってることは正論なんだからな、いくら来栖にすがりついても……あー、ダメなものはダメに決まってる」"
  },
  {
   "id": "claa03:28900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "……ん？"
  },
  {
   "id": "claa03:29000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
