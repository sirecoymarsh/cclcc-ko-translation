   "id": "clyu05:6000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "「う、ううん！ 私、まだできるもん」"
  },
  {
   "id": "clyu05:6100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
