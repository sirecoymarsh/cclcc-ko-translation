   "id": "clyu05:8000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "歌や踊りなんて僕だってできないし、やれと言われて簡単にできるとも思わない。"
  },
  {
   "id": "clyu05:8100",
   "type": "narration",
   "speaker": null,
