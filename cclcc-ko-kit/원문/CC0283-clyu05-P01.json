  },
  {
   "id": "clyu05:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "これは……想像以上に厳しいかもしれない。"
