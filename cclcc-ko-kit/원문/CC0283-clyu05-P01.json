   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "まさか、結衣がこれほどまでにリズム感が無いとは、僕も予想していなかった。"
  },
  {
   "id": "clyu05:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "とはいえ、ここで投げ出すわけにはいかない。"
