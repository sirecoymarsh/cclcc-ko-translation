   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "昼間のダンスのことも含めた、これからの活動について話に来たのだ。"
