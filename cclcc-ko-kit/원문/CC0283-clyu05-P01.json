   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ただいま帰りました」"
