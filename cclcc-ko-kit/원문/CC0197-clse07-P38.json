 "entries": [
  {
   "id": "clse07:358100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留。お弁当は持った？」"
  },
  {
   "id": "clse07:358200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ええ。さっき父さんに連絡したら、問題ないって。それに……急に集会だなんて……こっちも心配だし」"
  },
  {
   "id": "clse07:358300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「待って、川原くん！ 拓留が何をしたっていうの？ いったい何の根拠があって、そんなことを言うの！」"
  },
  {
   "id": "clse07:358400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まさか、なんの根拠もなく、一生徒を糾弾しているんじゃないわよね？ だとしたら許さないから」"
  },
  {
   "id": "clse07:358500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え……？」"
  },
  {
   "id": "clse07:358600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あれは……」"
  },
  {
   "id": "clse07:358700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あの家は青葉寮という児童福祉施設で、事情有る子どもたちを預かっている。そしてそこで、私も拓留も暮らしている。それは川原くん、あなたも知っているでしょう！」"
  },
  {
   "id": "clse07:358800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「同じ施設で暮らすものとして、代わりに事情を説明することに、何か問題でもあるの？」"
  },
  {
   "id": "clse07:358900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あの子は数日前、うちの施設に預けられた子よ」"
  },
  {
   "id": "clse07:359000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「か、彼女は……戻って来たのよ、先日」"
  },
  {
   "id": "clse07:359100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それは……」"
  },
  {
   "id": "clse07:359200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っ…………」"
  },
  {
   "id": "clse07:359300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そ、そんなことない！」"
  },
  {
   "id": "clse07:359400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それ……どういうこと？」"
  },
  {
   "id": "clse07:359500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふざけないでっ！！」"
  },
  {
   "id": "clse07:359600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私の家族を悪く言うことは、誰であろうと許さない……！」"
  },
  {
   "id": "clse07:359700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「当たり前よ！ その赤ちゃんは預かった子で、拓留の子でも施設の他の誰かの子でもないっ」"
  },
  {
   "id": "clse07:359800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
