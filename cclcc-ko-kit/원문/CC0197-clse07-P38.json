   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「ううん。それでも間違ってる……」"
  },
  {
   "id": "clse07:364200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「ねぇ、みんな。みんなはあの校則、本当に正しいと思ってる？」"
  },
  {
   "id": "clse07:364300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「人を好きになることが、悪いことだって、本当に思ってるの？」"
  },
  {
   "id": "clse07:364400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「みんなだって大切な人を想う気持ちはあるでしょう？」"
  },
  {
   "id": "clse07:364500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「その人のために何かしてあげたい。その人の喜ぶ顔が見たい……それは、とても優しくてあたたかい気持ちだと私は思う」"
  },
  {
   "id": "clse07:364600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そんな気持ちの向こうにあるのが恋や愛であるのなら、私はその気持ちを大切にしたい。だって……」"
  },
  {
   "id": "clse07:364700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だって私にも、そう思える人がいるから……」"
  },
  {
   "id": "clse07:364800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「心から大切だって思える人がいるから……」"
  },
  {
   "id": "clse07:364900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だから、恋愛禁止の校則だなんて間違ってるわ」"
  },
  {
   "id": "clse07:365000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「少なくとも私はそう思う……」"
  },
  {
   "id": "clse07:365100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ええ、そうよ」"
  },
  {
   "id": "clse07:365200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あなたに許してもらう必要はないわ」"
  },
  {
   "id": "clse07:365300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それも間違ってる」"
  },
  {
   "id": "clse07:365400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「証拠なら、あるわ」"
  },
  {
   "id": "clse07:365500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だって、私……私が……」"
  },
  {
   "id": "clse07:365600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私が南沢泉理だから」"
  },
  {
   "id": "clse07:365700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私が泉理。あの映像に写っていた南沢泉理よ、川原くん」"
  },
  {
   "id": "clse07:365800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「冗談なんかじゃないわ。私は正真正銘の南沢泉理よ。あなたも良く知ってる、ね」"
  },
  {
   "id": "clse07:365900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ええ、そうね……」"
  },
  {
   "id": "clse07:366000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「見ていて。これが私の、ギガロマニアックスとしての⟦rb⟧能力⟦rt⟧ちから⟦/r⟧――」"
  },
  {
   "id": "clse07:366100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:366200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ひかり……」"
  },
  {
   "id": "clse07:366300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「元気でね……」"
  },
  {
   "id": "clse07:366400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？」"
  },
  {
   "id": "clse07:366500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ひかり……」"
  },
  {
   "id": "clse07:366600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「久野里さん、なんて？」"
  },
  {
   "id": "clse07:366700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そう……」"
  },
  {
   "id": "clse07:366800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……そうね。ひかりのママが持ってきてくれたお菓子もあるし。あったかいココアでも淹れましょうか」"
  },
  {
   "id": "clse07:366900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「さあ、拓留も」"
  },
  {
   "id": "clse07:367000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ええ、おはよう」"
  },
  {
   "id": "clse07:367100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もう、その呼び方やめてって言ってるでしょ」"
  },
  {
   "id": "clse07:367200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、あのね、拓留。それなんだけど、その……結衣と結人は友達のところでパーティーだって……」"
  },
  {
   "id": "clse07:367300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うん。父さんも学会だって……」"
  },
  {
   "id": "clse07:367400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふふっ、まったく……」"
  },
  {
   "id": "clse07:367500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ひかり……元気にしてるかしら……？」"
  },
  {
   "id": "clse07:367600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だったら、いいけど……」"
  },
  {
   "id": "clse07:367700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうね……」"
  },
  {
   "id": "clse07:367800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ええ……」"
  },
  {
   "id": "clse07:367900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……私も、あんな赤ちゃん欲しいな」"
  },
  {
   "id": "clse07:368000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
