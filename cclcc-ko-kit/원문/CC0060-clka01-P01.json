   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ベッドの上で目を醒ます。"
  },
  {
   "id": "clka01:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "冷蔵庫の上に置かれた目覚まし時計が、起床時刻を告げるアラームを鳴らしている。"
  },
  {
   "id": "clka01:1100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clka01:1200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……今日は、月曜日……」"
  },
  {
   "id": "clka01:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "麗しき休日は何時間も前に終わりを告げ、今日からまた５日間は学校に通わなければならない。"
  },
  {
   "id": "clka01:1400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clka01:1500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……起きなきゃ……」"
  },
  {
   "id": "clka01:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "目覚ましは、朝食を食べながら制服に着替えてかつネットの定期巡回した後に登校しても遅刻しないギリギリの時刻に設定してある。"
  },
  {
   "id": "clka01:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "つまり、すぐに起きなければいけない。それは僕の体に既に刻み込まれているルーチンワークだった。"
  },
  {
   "id": "clka01:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "が、しかし。"
  },
  {
   "id": "clka01:1900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………？」"
  },
  {
   "id": "clka01:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "体が、思うように動かない。"
  },
  {
   "id": "clka01:2100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "頭がとてもぼんやりしている。"
  },
  {
   "id": "clka01:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "まだ眠っていたい。"
  },
  {
   "id": "clka01:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……いや、ダメだ。起きよう」"
  },
  {
   "id": "clka01:2400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "一人暮らしなので、どこかでサボったらあとはズルズルさぼってしまう。なのでズル休みだけはしないと決めていた。"
  },
  {
   "id": "clka01:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ひとまず起きよう。"
  },
  {
   "id": "clka01:2600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よいしょっ――」"
  },
  {
   "id": "clka01:2700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「――っと」"
  },
  {
   "id": "clka01:2800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "上半身を起こした、その時。"
  },
  {
   "id": "clka01:2900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「がっ！？」"
  },
  {
   "id": "clka01:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "突然、頭の中に刺すような痛みが走った。"
  },
  {
   "id": "clka01:3100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「な、なんだっ！？」"
  },
  {
   "id": "clka01:3200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、頭が……痛い！」"
  },
  {
   "id": "clka01:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "反射的に両手で頭を押さえる。"
  },
  {
   "id": "clka01:3400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clka01:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "頭を動かさないでいると、徐々に痛みが引いていく。"
  },
  {
   "id": "clka01:3600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんなんだ……」"
  },
  {
   "id": "clka01:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "と、その時。"
  },
  {
   "id": "clka01:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕は今頭を押さえた自分の両腕の異変に気付いた。"
  },
  {
   "id": "clka01:3900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……なんで僕、制服を着たまま寝てたんだ？」"
  },
  {
   "id": "clka01:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "思わず立ち上がる。"
  },
  {
   "id": "clka01:4100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っと、うわっ！」"
  },
  {
   "id": "clka01:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "体を起こした途端、また頭がぐわんぐわんと痛みだす。"
  },
  {
   "id": "clka01:4300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "けれど、それを気にしている余裕はなかった。自分の身体を見直す。"
  },
  {
   "id": "clka01:4400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「制服……」"
  },
  {
   "id": "clka01:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "どうやら、昨日は制服のまま寝ていたようだ。ズボンに跡がついてしまっている。"
  },
  {
   "id": "clka01:4600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「昨日は日曜日なのに……」"
  },
  {
   "id": "clka01:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "日曜日だから制服を着る必要はない筈だ。"
  },
  {
   "id": "clka01:4800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、待てよ」"
  },
  {
   "id": "clka01:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "頭の中はいまだにぼんやりともやがかかっていたが、その中にぼんやりとうっすらとしたイメージが現れてくる。"
  },
  {
   "id": "clka01:5000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「確か、昨日は……」"
  },
  {
   "id": "clka01:5100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「新聞部のメンバーと一緒に行動した、ような……」"
  },
  {
   "id": "clka01:5200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "断片的に、渋谷の街中を伊藤や来栖、そして尾上、有村と歩いている記憶が浮かんでくる。"
  },
  {
   "id": "clka01:5300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「昨日、僕はあいつらと……」"
  },
  {
   "id": "clka01:5400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ウウッ！」"
  },
  {
   "id": "clka01:5500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "昨夜の事を思いだそうとしたその時、まるでそれを拒否するみたいに今まで以上に大きな頭痛が襲ってきた。"
  },
  {
   "id": "clka01:5600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "思わずふらついて足を一歩前に出すと――"
  },
  {
   "id": "clka01:5700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？」"
  },
  {
   "id": "clka01:5800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "靴下を履いたままの右足がなにかに当たった。"
  },
  {
   "id": "clka01:5900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "下を見ると、⟦col:280aa02d1400⟧マウンテンビュー⟦col:800000⟧のペットボトルが転がっていた。フタはなく、空のようだ。"
  },
  {
   "id": "clka01:6000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あれ、捨ててなかったか――」"
  },
  {
   "id": "clka01:6100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ペットボトルを拾おうと、頭を押さえながらかがむと、床には他にも色々落ちていることに気付いた。"
  },
  {
   "id": "clka01:6200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "空になったポテチの袋。食べ終わっているコンビニ弁当。破れたアイスの袋。ティッシュが放り込まれているコンビニ袋。"
  },
  {
   "id": "clka01:6300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そう言った物が乱雑に転がっている。"
  },
  {
   "id": "clka01:6400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんなんだよこれ……」"
  },
  {
   "id": "clka01:6500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まるで、宴会の後みたいだな……」"
  },
  {
   "id": "clka01:6600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………ん？」"
  },
  {
   "id": "clka01:6700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「宴会？ そういえば……」"
  },
  {
   "id": "clka01:6800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "じわじわと伝わってくる頭痛の波を越えて、ようやく記憶の扉が開きそうになった。"
  },
  {
   "id": "clka01:6900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「昨日は、みんなが――」"
  },
  {
   "id": "clka01:7000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あと少しで全部思いだせる気がした、その瞬間。"
  },
  {
   "id": "clka01:7100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？」"
  },
  {
   "id": "clka01:7200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "右ポケットから音が鳴った。ポケットを探ると、スマホが入っていた。"
  },
  {
   "id": "clka01:7300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「スマホもポケットに入れっぱなしで寝てたのか……」"
  },
  {
   "id": "clka01:7400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "メールが来たようだ。相手を確認する。"
  },
  {
   "id": "clka01:7500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ん？ 誰からだこれ？」"
  },
  {
   "id": "clka01:7600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "送信者の欄に見知らぬメールアドレスが表示されている。少なくとも、スマホの住所録に登録してない人からだ。"
  },
  {
   "id": "clka01:7700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "まあ、住所録と言っても、元々大した人数は登録されていないのだが。"
  },
  {
   "id": "clka01:7800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「このドメイン……。フリーの捨てアカウントだな」"
  },
  {
   "id": "clka01:7900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「件名、宮代拓留様……？ 絨毯爆撃の⟦col:280aa02d1400⟧スパムメール⟦col:800000⟧じゃないみたいだな」"
  },
  {
   "id": "clka01:8000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "少なくとも僕の本名を知っている誰かだ。"
  },
  {
   "id": "clka01:8100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「件名も本文も無し、画像の添付ファイルが一個だけ……」"
  },
  {
   "id": "clka01:8200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "怪しい。やっぱりスパムメールか？"
  },
  {
   "id": "clka01:8300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いやでも、僕の名前を知っているわけだし……」"
  },
  {
   "id": "clka01:8400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "一応ウィルススキャンをしておこう。"
  },
  {
   "id": "clka01:8500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……ウィルス、無し」"
  },
  {
   "id": "clka01:8600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "いつの間にか頭痛の事は忘れていた。"
  },
  {
   "id": "clka01:8700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "何故か、予感があった。"
  },
  {
   "id": "clka01:8800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "このメールから、なにかが始まりそうな、そんな予感が。"
  },
  {
   "id": "clka01:8900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……さて、と」"
  },
  {
   "id": "clka01:9000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "車内には僕以外に誰もいないのに、冷静なフリをして、添付ファイルを開く。"
  },
  {
   "id": "clka01:9100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clka01:9200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clka01:9300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………ええええっ！？」"
  },
  {
   "id": "clka01:9400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その画像は、この謎の頭痛や、謎の服装や、謎の車内風景を、遥かに凌駕する謎を僕に突きつけた。"
  },
  {
   "id": "clka01:9500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こ、こここここっ」"
  },
  {
   "id": "clka01:9600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こ、これはっ！？」"
  },
  {
   "id": "clka01:9700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それは、ネットやマンガや雑誌記事ではいくらでも取り上げられるが、現実で見たことはほとんど無い物だった。"
  },
  {
   "id": "clka01:9800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もしかしたら実在するのかもしれないし、実在してくれたら人生に多少の彩りを与える可能性があるので、ほんの少しは実在して欲しいと思っている物だった。"
  },
  {
   "id": "clka01:9900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "とはいえ、仮に実在しているとしても、自分には無縁の物だと思っていたし、ましてや僕のスマホに送られて来るなんて想像もしていなかった物だった。"
  }
 ],
