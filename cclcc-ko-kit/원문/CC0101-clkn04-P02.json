   "next_speaker": "미야시로 타쿠루",
   "jp": "「……すまん」"
  },
  {
   "id": "clkn04:10700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "아리무라 히나에",
   "jp": "「いや、さすがに盗み聞きは悪いだろ」"
