   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "呆気にとられている間に、僕のスマホは有村に奪われ、やがてそのスピーカーから声が漏れてきた。"
  },
  {
   "id": "clkn04:10500",
   "type": "dialogue",
   "speaker": "来栖乃々",
