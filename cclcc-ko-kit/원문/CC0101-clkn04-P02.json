  {
   "id": "clkn04:10800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なに言ってんすか。ひとりで盗み聞きしてたくせに」"
  },
  {
   "id": "clkn04:10900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "이토 신지",
   "jp": "「いや、だからそれは……」"
  },
  {
   "id": "clkn04:11000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうだぞ、宮代。それにこれは盗み聞きじゃない。調査だ」"
  },
  {
   "id": "clkn04:11100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「調査……」"
  },
  {
   "id": "clkn04:11200",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あの川原のこと。また俺たちに何か当てつけでもしてくるつもりかもしれない。だからこれはれっきとした調査なんだ」"
  },
  {
   "id": "clkn04:11300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "……そう言われると……確かに何を話すつもりなのか気になるな。"
  },
  {
   "id": "clkn04:11400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "쿠루스 노노",
   "jp": "「ま、まあ、調査なら仕方ない……な」"
  },
  {
   "id": "clkn04:11500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "伊藤の都合の良い言葉で自らを正当化させると、僕たちは壁際に身をひそめながら、再びスピーカーからの声に耳を澄ませた。"
  },
  {
   "id": "clkn04:11600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "「それで……どうしたの？ お弁当箱を返すだけなら、なにもわざわざこんなところじゃなくても良かったんじゃない？」"
  },
  {
   "id": "clkn04:11700",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「ん……まあ、それだけじゃないから呼んだわけだが」"
  },
  {
   "id": "clkn04:11800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「副部長が川原に弁当？ どういうことだ？」"
  },
  {
   "id": "clkn04:11900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "카와하라 마사시",
   "jp": "伊藤の疑問に答える者は誰もおらず、皆、ただスピーカーから聞こえるやりとりに耳を澄ませていた。"
  },
  {
   "id": "clkn04:12000",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "이토 신지",
   "next_speaker": "쿠루스 노노",
   "jp": "「まずは、これ。弁当、すっごい美味かった。しかもあんな凝った弁当作って来てくれるなんて感激だよ」"
  },
  {
   "id": "clkn04:12100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「あ、うん……でもあれは――」"
  },
  {
   "id": "clkn04:12200",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「わかってる。あれだけの手の込んだ弁当、どうでも良い奴には作れないって言うんだろ？」"
  },
  {
   "id": "clkn04:12300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「え？」"
  },
  {
   "id": "clkn04:12400",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「悪かった、来栖。本当なら、俺の方からもっと早く言っておくべきだったんだ」"
  },
  {
   "id": "clkn04:12500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "오노에 세리카",
   "jp": "「あの、川原くん……？」"
  },
  {
   "id": "clkn04:12600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "ま、待ってくれ。この展開は……。"
  },
  {
   "id": "clkn04:12700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "「ねぇねぇ、タク！ これってもしかしてぇ……」"
  },
  {
   "id": "clkn04:12800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카와하라 마사시",
   "jp": "「しっ！ せり！ 今いいところだから黙って！！」"
  },
