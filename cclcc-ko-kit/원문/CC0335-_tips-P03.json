   "type": "tip",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "ないとはると"
  },
  {
   "id": "_tips:28200",
   "type": "tip",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "ないとはると"
  },
  {
