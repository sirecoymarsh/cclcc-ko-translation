   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "のぞみてくのろじー"
  },
  {
   "id": "_tips:30200",
   "type": "tip",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "のぞみてくのろじぃ"
  },
  {
   "id": "_tips:30300",
   "type": "tip",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（架空）主に医療機器に関するソフトウェアを開発している企業。希グループ傘下。元々は希テクノロジー社を出発点としてＭ＆Ａを繰り返し、日本でも有数の複合企業体へと成長した。渋谷地震は、この希テクノロジーの極秘実験が原因である。"
  },
  {
   "id": "_tips:30500",
   "type": "tip",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "野呂瀬"
  },
  {
   "id": "_tips:30600",
   "type": "tip",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "のろせ"
  },
  {
