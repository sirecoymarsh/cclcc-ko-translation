   "prev_speaker": null,
   "next_speaker": null,
   "jp": "虹画像"
  },
  {
   "id": "_tips:28600",
   "type": "tip",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "にじがぞう"
  },
  {
