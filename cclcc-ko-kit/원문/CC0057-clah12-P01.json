   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "相手が自分の事を好きだとわかっていれば、そうそう気持ちが離れることはないのかもしれない。"
