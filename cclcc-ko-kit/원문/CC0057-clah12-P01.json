   "id": "clah12:4100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "카즈키 하나",
   "jp": "言ってみれば、外国人が常に愛情を確認し合うのと同じだ。"
