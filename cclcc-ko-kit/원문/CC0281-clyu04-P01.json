   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "「そんじゃ、次は私の番ですね」"
  },
  {
   "id": "clyu04:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "타치바나 유이",
   "jp": "いつの間にか⟦col:280aa02d1400⟧プロデューサー⟦col:800000⟧として手を挙げていた有村が僕たちに集合をかけたのは、それから２日後のことだった。"
  },
  {
   "id": "clyu04:200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "타치바나 유토",
   "jp": "「よろしくお願いします、有村プロデューサー」"
  },
  {
   "id": "clyu04:300",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "아리무라 히나에",
   "jp": "「お願いします」"
  },
  {
   "id": "clyu04:400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「不甲斐ない伊藤先輩と違って、この私に任せておけば大丈夫だから」"
  },
  {
   "id": "clyu04:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "自信満々に胸を張る有村だが、その自信がかえって不安を煽ることもある。"
  },
  {
   "id": "clyu04:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "だが、有村とはいえ女の子であるという点で、きっと伊藤に比べてもアドバンテージがあるに違いない。"
  },
  {
   "id": "clyu04:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "少なくとも、伊藤が考えたような方向へは行かないはずだ。"
  },
  {
   "id": "clyu04:800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「それじゃ、今日は外ロケを行いまーす。その前に、ふたりはこれに着替えて」"
  },
  {
   "id": "clyu04:900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "타치바나 유토",
   "jp": "有村が持参していた大きな紙袋をふたりに手渡した。"
  },
  {
   "id": "clyu04:1000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「えっと……これは？」"
  },
  {
   "id": "clyu04:1100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "「もっちろん、衣装だよ。どんなアイドルにだって、制服は必要でしょ？ それがアイドルのトレードマークにもなるんだし、ちゃんとしたものが無いと」"
  },
  {
   "id": "clyu04:1200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "타치바나 유토",
   "jp": "「制服！？」"
  },
  {
   "id": "clyu04:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "アイドルの命ともいえる制服と聞いて、結衣の目が輝いた。"
  },
  {
   "id": "clyu04:1400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "타치바나 유토",
   "jp": "「やった！ 制服だって、ユウ！」"
  },
  {
   "id": "clyu04:1500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「う、うん」"
  },
  {
   "id": "clyu04:1600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "아리무라 히나에",
   "jp": "「早く着替えよ！ ほらっ！」"
  },
  {
   "id": "clyu04:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "아리무라 히나에",
   "jp": "なるほど。結人はともかくとして、制服がこれほどまでに結衣のテンションを上げるとは。"
  },
  {
   "id": "clyu04:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "아리무라 히나에",
   "jp": "有村もなかなかやるのかもしれない。"
  },
  {
   "id": "clyu04:1900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "「華、それからうきちゃんも、手伝ってあげて」"
  },
  {
   "id": "clyu04:2000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카즈키 하나",
   "jp": "「は、はい」"
  },
  {
   "id": "clyu04:2100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ん……」"
  },
  {
   "id": "clyu04:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣と結人、そして香月たちは、有村から手渡された紙袋を抱えて着替えのためにトレーラーハウスの中に入っていった。"
  },
  {
   "id": "clyu04:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "確かに有村の言うとり、アイドルといえば、各々固有の制服に身を包んでいるイメージがあるだろう。"
  },
  {
   "id": "clyu04:2400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ふたりにそんな制服があるというのは、ありがたい話ではあるけど……。"
  },
  {
   "id": "clyu04:2500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "「おい、有村。大丈夫なのか、あれ……」"
  },
  {
   "id": "clyu04:2600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ん？ 何がっすか？」"
  },
  {
   "id": "clyu04:2700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "이토 신지",
   "jp": "「制服なんて作る金、無かっただろ」"
  },
  {
   "id": "clyu04:2800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「そうだぞ。部費をあてになんてしてたら、痛い目にあうぞ」"
  },
  {
   "id": "clyu04:2900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "아리무라 히나에",
   "jp": "ちなみに伊藤は絶賛、アルバイトを探している最中らしい。"
  },
  {
   "id": "clyu04:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "아리무라 히나에",
   "jp": "気の毒な気もするが、そもそもは早まった伊藤が悪いのだから同情の余地はない。"
  },
  {
   "id": "clyu04:3100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あー、それなら大丈夫っすよ。私のは、お金、ほとんどかかってないんで」"
  },
  {
   "id": "clyu04:3200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「そうなのか？ でも制服だろ？ 材料費だけでも、それなりにいくんじゃないか？」"
  },
  {
   "id": "clyu04:3300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「だーいじょうぶだいじょうぶ。その辺のところはうまくやってるんで、心配しなくても平気ですって」"
  },
  {
   "id": "clyu04:3400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "야마조에 우키",
   "jp": "「あ、ふたりとも着替え終わったみたいだよ〜」"
  },
  {
   "id": "clyu04:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "야마조에 우키",
   "jp": "僕たちがそんな話をしているうちにも、ふたりの準備は着々と進んでいたらしく、尾上の声とともに、部屋の扉がゆっくりと開いた。"
  },
  {
   "id": "clyu04:3600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "「お待たせしました」"
  },
  {
   "id": "clyu04:3700",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「ん……」"
  },
  {
   "id": "clyu04:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "타치바나 유이",
   "jp": "香月たちに促されて、ふたりの姿がゆっくりと現れる。"
  },
  {
   "id": "clyu04:3900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "타치바나 유토",
   "jp": "「じゃーん」"
  },
  {
   "id": "clyu04:4000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "신문부원들",
   "jp": "「えっと……こんな感じで大丈夫かな？」"
  },
  {
   "id": "clyu04:4100",
   "type": "dialogue",
   "speaker": "新聞部員たち",
   "speaker_ko": "신문부원들",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "아리무라 히나에",
   "jp": "「「「「おおぉ、これは――！」」」」"
  },
  {
   "id": "clyu04:4200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "신문부원들",
   "next_speaker": "유",
   "jp": "「おっけいおっけい。そのままゆっくり顔を出して」"
  },
  {
   "id": "clyu04:4300",
   "type": "dialogue",
   "speaker": "ユウ",
   "speaker_ko": "유",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「えっと……こう？」"
  },
  {
   "id": "clyu04:4400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "유",
   "next_speaker": "유이",
   "jp": "「うーん、いい感じいい感じ。次、結衣ちゃん」"
  },
  {
   "id": "clyu04:4500",
   "type": "dialogue",
   "speaker": "ユイ",
   "speaker_ko": "유이",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「えへっ」"
  },
  {
   "id": "clyu04:4600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "유이",
   "next_speaker": "유이",
   "jp": "「おお、ファンタスティック！」"
  },
  {
   "id": "clyu04:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "有村の提供してくれた制服はなかなかに可愛らしいデザインで、結衣と結人をはじめ、尾上や香月の評判も上々だった。"
  },
  {
   "id": "clyu04:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "僕も悪くないんじゃないかと思う。"
  },
  {
   "id": "clyu04:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "が……問題はそこじゃなく。"
  },
  {
   "id": "clyu04:5000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "유이",
   "next_speaker": "유이",
   "jp": "「そう！ そこでひと言、はいっ！ 『大好きだよっ』！」"
  },
  {
   "id": "clyu04:5100",
   "type": "dialogue",
   "speaker": "ユイ",
   "speaker_ko": "유이",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「だ、大好きだよ……？」"
  },
  {
   "id": "clyu04:5200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "유이",
   "next_speaker": "유이",
   "jp": "「うーん、戸惑った感じも悪くはないけど、もっと思い切って言ってみよう！ さん、はいっ」"
