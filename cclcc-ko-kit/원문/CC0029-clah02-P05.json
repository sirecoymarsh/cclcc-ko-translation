  {
   "id": "clah02:46200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そんな不器用な宮代先輩のために、はい、これ」"
  },
  {
   "id": "clah02:46300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「へっへっへ、文芸部のホープであるこの有村雛絵自らしたためた台本でございます。ぜひともお納めを……」"
  },
  {
   "id": "clah02:46400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "有村は台本をずいっと僕の前に押し出して胸を張った。"
  },
  {
   "id": "clah02:46500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "もしかして、今日帰りが遅くなったのはそのせいか？"
  },
  {
   "id": "clah02:46600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうですわざわざ先輩ひとりのために書いたんですよ大サービスです感謝してください」"
