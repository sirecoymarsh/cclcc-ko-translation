   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だからぁ、もし相手が“恋人”だったとしたら、うちの母も考えると思うんですよねぇ」"
  },
  {
   "id": "clah02:45000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "予感的中。"
  },
  {
   "id": "clah02:45100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「というわけで、母がやってきたら、宮代先輩には私の恋人役を演じてもらっちゃおうという作戦なわけです。うん、さっすが雛絵ちゃん天才！」"
  },
  {
   "id": "clah02:45200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "おいおい……そんな使い古された手の、なにが天才なもんか。"
  },
  {
   "id": "clah02:45300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「だいたい、家出なんてやめて、家に帰ればいいだけじゃないのか？」"
  },
  {
   "id": "clah02:45400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あー、それは無理」"
  },
  {
   "id": "clah02:45500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「なんで！？」"
  },
  {
   "id": "clah02:45600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんつーか……女の意地？」"
  },
  {
