   "id": "clah02:47900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "いや、そもそも恋人でもなければ付き合ってもいないわけだけど。"
