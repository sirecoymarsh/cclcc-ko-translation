   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そんなもの僕には関係ない。"
  },
  {
   "id": "clah02:45800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「だいたい言っておくが僕は――」"
  },
  {
   "id": "clah02:45900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そんなお芝居できないっていうんでしょ？ わかってますって。先輩って、不器用そうですしねー」"
  },
  {
   "id": "clah02:46000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "そう、自慢じゃないが、僕にそういう腹芸は無理だ。"
  },
  {
   "id": "clah02:46100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "ただでさえ初対面の人と話すのだって苦手なのに。"
