   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「先輩……私ね、昔からずっと、本当のことが知りたかった……」"
  },
  {
   "id": "clah11:15500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "有村……。"
  },
  {
   "id": "clah11:15600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うちの家は、パパもママも嘘ばっかり。口では愛してる、なんて言いながら、自分たちは外で好き勝手やって……」"
  },
  {
   "id": "clah11:15700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だから、私はずっと、本当のことが知りたいと思ってた。言葉の奥に隠された、本当の心が……」"
  },
  {
   "id": "clah11:15800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "有村は僕と目を合わせようとはしなかった。"
  },
  {
   "id": "clah11:15900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だからこの能力は私が望んだ能力。この能力さえあれば、私は幸せになれるはずだった……」"
  },
  {
   "id": "clah11:16000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「…………」"
  },
  {
   "id": "clah11:16100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「でもね……でも、現実はまったく逆。本当のことなんて知っても、何も幸せなことなんてなかった……」"
  },
  {
   "id": "clah11:16200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "道行く人たちが、遠慮ない視線で物珍しそうに僕たちを眺めてゆく。"
  },
  {
   "id": "clah11:16300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "それでも有村は続けた。"
  },
  {
   "id": "clah11:16400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「この世界に、嘘のない人なんていない。誰だってみんな嘘をついて生きてた……」"
  },
  {
   "id": "clah11:16500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「両親もお兄ちゃんも、友達も先生も、偉い政治家の人だって、みんなみんな嘘をついてる……」"
  },
  {
   "id": "clah11:16600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「もちろん、その中には悪くない嘘もあった。だけど、耳をふさぎたくなる嘘もたくさんあった……」"
  },
  {
   "id": "clah11:16700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "泣いているのか、それとも怯えているのか、有村の手は僅かに震えていた。"
  },
  {
   "id": "clah11:16800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "僕は有村のそんな言葉を黙って聞いていた。"
  },
  {
   "id": "clah11:16900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私のこと、言葉では友だちだっていいながら、心の中では嫌ってる子もいた」"
  },
  {
   "id": "clah11:17000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「毎日ずっと一緒にいるのに。笑いあってるのに、本当はお互い嫌い合ってる子たちだっていた……」"
  },
  {
   "id": "clah11:17100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "⟦col:280aa02d1400⟧スクランブル交差点⟦col:800000⟧の信号が青に変わり、人の波が動き出す。"
  },
  {
   "id": "clah11:17200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だからね……私は私自身を嘘で塗り固めることにしたの。誰とも本当の心で向き合わなくてすむように……」"
  },
  {
   "id": "clah11:17300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうすれば誰かが嘘をついていたとしても、心は痛くならないから……」"
  },
  {
   "id": "clah11:17400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "そうだ。"
  },
  {
   "id": "clah11:17500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "嘘を一番嫌っていた有村が、一番嘘をついていた。"
  },
  {
   "id": "clah11:17600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "自分の本当の心に。"
  },
  {
   "id": "clah11:17700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "でも、僕は思う。"
  },
  {
   "id": "clah11:17800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "それもきっと嘘なんだと。"
  },
  {
   "id": "clah11:17900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "たとえ嘘で塗り固めた自分だろうと、誰かの嘘を突き付けられて、心が痛まないわけがない。"
  },
  {
   "id": "clah11:18000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "むしろ、自分が嘘をついているという後ろめたさが、傷ついた心を更に痛めつけるはずだ。"
  },
  {
   "id": "clah11:18100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうやって自分を嘘で固めるうちに、私はだんだんと嘘に慣れていった。他人の嘘も平気で受け止められるようになっていった」"
  },
  {
   "id": "clah11:18200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「もう、誰かの本当の気持ちを知るのが怖いだなんて、そんな風に思うことはないはずだった……」"
  },
  {
   "id": "clah11:18300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "不思議と静かだった。"
  },
  {
   "id": "clah11:18400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうだよ……ずっと嘘のつもりだったのに……」"
  },
  {
   "id": "clah11:18500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "行きかう車の音も、すれ違ってゆく人々の声も僕には届かない。"
  },
  {
   "id": "clah11:18600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "呟くような有村の声だけが、僕の耳を震わせる。"
  },
  {
   "id": "clah11:18700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ただ、人の良い先輩をからかって甘えて……それだけのつもりだったのに……」"
