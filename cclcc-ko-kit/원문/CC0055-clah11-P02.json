  {
   "id": "clah11:18900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それなのに……」"
  },
  {
   "id": "clah11:19000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "不意に顔を上げた有村の瞳には、膨れ上がった不安が涙となって溢れていた。"
  },
  {
   "id": "clah11:19100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それなのに、今は怖いのっ。嘘だったはずの自分の気持ちも！ 先輩と会えない時の寂しいっていう気持ちも、なにもかもが……」"
  },
  {
