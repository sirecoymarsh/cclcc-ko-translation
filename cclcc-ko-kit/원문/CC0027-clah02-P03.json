   "id": "clah02:29500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "신조 타케시",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「い、いや！ 僕はそんな趣味じゃ――！」"
