  {
   "id": "clah02:29600",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "신조 타케시",
   "jp": "「何を言ってるんだい。たった今、君はその身で行動して僕たちに示したじゃないか」"
  },
  {
   "id": "clah02:29700",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうだぞ。せっかく出した勇気を否定しちゃあいけない」"
  },
  {
   "id": "clah02:29800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
