   "id": "clkn08:31600",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そ、そうね！ ミルク、欲しかったのよね！ ごめんね、いま用意しまちゅからねー」"
