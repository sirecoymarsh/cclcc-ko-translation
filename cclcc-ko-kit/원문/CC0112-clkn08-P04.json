  {
   "id": "clkn08:32100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "いつもは、そんなものばっかり飲んでって怒るのに、今日ばかりは少しは労わってくれるらしい。"
