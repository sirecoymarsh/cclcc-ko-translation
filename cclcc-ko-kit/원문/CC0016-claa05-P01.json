  {
   "id": "claa05:4900",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あるいは、そうじゃないかも知れない」"
  },
  {
   "id": "claa05:5000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「って、どっちなんです？」"
  },
  {
   "id": "claa05:5100",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それが判然としないから、私も思考がまとまらずに困ってるんだ」"
  },
  {
   "id": "claa05:5200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "久野里さんは、壁に貼ってある渋谷のマップを眺めながら、珍しく戸惑うような表情を見せた。"
  },
  {
   "id": "claa05:5300",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ただ、もしも１０月２３日にまで何かが起こるようであれば……確率的にも、さすがに偶然とは言いがたいな」"
  },
  {
   "id": "claa05:5400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「僕もそう思います。だから２３日は、渋谷の怪しい場所を調べて歩いてみようかと」"
  },
  {
   "id": "claa05:5500",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふむ。……それなら私も同行させてもらおう」"
  },
  {
   "id": "claa05:5600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「ええ？」"
  },
  {
   "id": "claa05:5700",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんだ、イヤなのか？」"
  },
  {
   "id": "claa05:5800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "「いえ、そういうわけじゃないですけど」"
  },
  {
   "id": "claa05:5900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "신조 타케시",
   "jp": "……というのはウソで、久野里さんと一緒だと面倒なことになりそうだと思った。"
  },
  {
   "id": "claa05:6000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "신조 타케시",
   "jp": "そして、その予感は、まさに今、的中していた。"
  },
  {
   "id": "claa05:6100",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠노사토 미오",
   "jp": "「だから、久野里さん。今日は危険だから、このままおとなしく帰ってくれと言ってるんだ。君に助けを借りたい時は、改めて連絡するから」"
  },
  {
   "id": "claa05:6200",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "신조 타케시",
   "next_speaker": "신조 타케시",
   "jp": "「危険？ 何か事件が発生するような情報を持ってるんだな、警察は？」"
  },
  {
   "id": "claa05:6300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "神成さんが、一瞬、しまったという顔になった。"
  },
  {
   "id": "claa05:6400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "一方の久野里さんは、口の端でかすかに笑う。"
  },
  {
   "id": "claa05:6500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "このふたり、どうにも久野里さんの方が一枚上手らしい。"
  },
  {
   "id": "claa05:6600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "その時、神成さんのポケットでスマホが鳴った。"
  },
  {
