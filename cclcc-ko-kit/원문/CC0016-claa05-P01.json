   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "話題をそらせると思ったのか、彼は少しホッとしながら通話ボタンを押す。"
