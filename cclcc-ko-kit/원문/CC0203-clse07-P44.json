  {
   "id": "clse07:424300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「げふんげふん！」"
  },
  {
   "id": "clse07:424400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ああ、僕だ。日曜なのに部活か。ご苦労」"
  },
  {
   "id": "clse07:424500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「情報収集に来たんだよ。っていうか、有村こそ何してたんだ？ ここは文芸部じゃないと何回言ったら……」"
  },
  {
   "id": "clse07:424600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ええっ！？ それ、出すのか！？ テレビのシナリオ賞に！？」"
  },
  {
   "id": "clse07:424700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕はてっきり、『ラフランス書房』とかに応募するのかと思ったぞ。その……む、胸とかふとももとか……」"
  },
  {
   "id": "clse07:424800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そ、そんなものなのか？」"
  },
  {
   "id": "clse07:424900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「イベント？」"
  },
  {
   "id": "clse07:425000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ああ、イベントって……ネトゲのギルドの……」"
  },
  {
   "id": "clse07:425100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うぁー！？」"
  },
  {
   "id": "clse07:425200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「照れちゃうなー、じゃないだろ、お前！ いいのか、アレの相手が僕で！？」"
  },
  {
   "id": "clse07:425300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「………」"
  },
  {
   "id": "clse07:425400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ああ、だめ。私、変になっちゃう。これ以上されたら……本当に気持ちよくなっちゃう〜」"
  },
  {
   "id": "clse07:425500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「かかか帰るっ！」"
  },
  {
   "id": "clse07:425600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ちゃんとやるって、あと何ページくらい続くんだ、あのシーン！？」"
  },
  {
   "id": "clse07:425700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お前、やっぱりなんか間違ってる！ 絶対！」"
  },
  {
   "id": "clse07:425800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「悪いこと言わないから、書き直せよっ。あんなの、テレビでオンエアできるわけないだろ！？ 新人賞なんて取れないって！」"
  },
  {
   "id": "clse07:425900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どう見ても、インパクトしかないだろ！」"
  },
  {
   "id": "clse07:426000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「な、なんか……今日は疲れた……」"
  },
  {
   "id": "clse07:426100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……うーん」"
  },
  {
   "id": "clse07:426200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どれも、もっとすごかったような気がするんだよなー」"
  },
  {
   "id": "clse07:426300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、どの事件ももっとこう――って、うわぁっ！？」"
  },
  {
   "id": "clse07:426400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お、お、尾上っ！ お前、いつの間に！？」"
  },
  {
   "id": "clse07:426500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「鍵があいてても、ノックくらいして入ってこいよ。いったいいつから、そこに座ってるんだ」"
  },
  {
   "id": "clse07:426600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほとんど最初からじゃないかよ、それ！ 油断も⟦rb⟧隙⟦rt⟧すき⟦/r⟧もあったもんじゃないな……」"
  },
  {
   "id": "clse07:426700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「五百円……いつもの？」"
  },
  {
   "id": "clse07:426800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「って、まさか！？」"
  },
  {
   "id": "clse07:426900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「たぁー！」"
  },
  {
   "id": "clse07:427000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なぁ、尾上？ この僕が、こんな程度の低い本を読むわけないだろう？」"
  },
  {
   "id": "clse07:427100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
