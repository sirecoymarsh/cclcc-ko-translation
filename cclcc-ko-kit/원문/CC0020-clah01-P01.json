 "entries": [
  {
   "id": "clah01:0",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "それから更に、二週間が過ぎ――。"
  },
  {
   "id": "clah01:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "長い闘いの末ようやく迎えた放課後、僕はいつものように部室にいた。"
  },
  {
   "id": "clah01:200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "오노에 세리카",
   "jp": "「むぅ……」"
  },
  {
   "id": "clah01:300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "「どしたの、タク？ むすーっとした顔しちゃって」"
  },
  {
   "id": "clah01:400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "「ほっとけほっとけ。この前の新聞記事が好評だったせいでスネてんだよ」"
  },
  {
   "id": "clah01:500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "이토 신지",
   "next_speaker": "야마조에 우키",
   "jp": "「そういうところ、昔のまま。成長しないわよね、拓留は」"
  },
  {
   "id": "clah01:600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「そうなんですか？」"
  },
  {
   "id": "clah01:700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうよ。拓留ってば前だって……」"
  },
  {
   "id": "clah01:800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「い、今は僕の昔の話は関係ないだろ！？」"
  },
  {
   "id": "clah01:900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "くそっ。でも、やっぱり納得がいかない。"
  },
  {
   "id": "clah01:1000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「どうして、僕が一生懸命に取材してゲットしたスクープより、あんなふざけた記事の方が評判がいいんだ」"
  },
  {
   "id": "clah01:1100",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あきらめろ、宮代。それが世間の素直な反応ってもんだ」"
  },
  {
   "id": "clah01:1200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "「ふんっ。僕の高尚な記事に理解がないなんて、世間なんてやっぱり情弱だらけだな」"
  },
  {
   "id": "clah01:1300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「でもさー、タクだって面白いから、クールキャットだっけ？ あの本買ってるわけでしょ？」"
  },
  {
   "id": "clah01:1400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "「だからっ！ あれはゲンさんが勝手に売りつけてくるだけで！」"
  },
  {
   "id": "clah01:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "――しまった！"
  },
  {
   "id": "clah01:1600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "「こ、こら、やめろ、有村！ 勝手に人の言葉の真偽を判断するんじゃないぞ！」"
  },
  {
   "id": "clah01:1700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "「…………」"
  },
  {
   "id": "clah01:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "……あれ？"
  },
  {
   "id": "clah01:1900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "変だな。いつもなら、すかさず減らず口が返って来るところなのに。"
  },
  {
   "id": "clah01:2000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……拓留ったら、誰に言ってるの？」"
  },
  {
   "id": "clah01:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "카즈키 하나",
   "jp": "「誰って……だから有村に……」"
  },
  {
   "id": "clah01:2200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ひなさんなら……今日は来てない、かも……」"
  },
  {
   "id": "clah01:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「…………」"
  },
  {
   "id": "clah01:2400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "改めて部室の中を見回してみると、なるほど、言われてみれば、有村の姿が無かった。"
  },
  {
   "id": "clah01:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "なんだ。どおりで、いつもに比べて静かだと思った。"
  },
  {
   "id": "clah01:2600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「それにしても珍しいな。有村が顔出さないなんて。風邪でもひいたのか？」"
  },
  {
   "id": "clah01:2700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "「う？ 体育の授業はでてたよ？」"
  },
  {
   "id": "clah01:2800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "ってことは風邪でもないし、休みでもない、と。"
  },
  {
   "id": "clah01:2900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "야마조에 우키",
   "jp": "「おおかた、文芸部の先輩と仲直りでもしたんじゃないのか？」"
  },
  {
   "id": "clah01:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "야마조에 우키",
   "jp": "確かに、その可能性もあるかもしれない。"
  },
  {
   "id": "clah01:3100",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "이토 신지",
   "next_speaker": "카즈키 하나",
   "jp": "「それじゃあ有村さん、もしかしたらもう⟦rb⟧新聞部⟦rt⟧ここ⟦/r⟧には来ないということでしょうか？」"
  },
  {
   "id": "clah01:3200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「その可能性もある……かも……？」"
  },
  {
   "id": "clah01:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あの有村が？"
  },
  {
   "id": "clah01:3400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "쿠루스 노노",
   "jp": "「いやいや、それは無いだろ。まだここに来て間もないってのに、今や部員よりも当たり前みたいに居座ってるんだぞ」"
  },
  {
   "id": "clah01:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "あの有村に限って、きっぱり来なくなるなんてことあるわけがない。"
  },
  {
   "id": "clah01:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "……はずだ。"
  },
  {
   "id": "clah01:3700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふふっ、気になる？」"
  },
  {
   "id": "clah01:3800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「べ、別に……どうして僕が、有村のことを気になんてしなきゃいけないんだ」"
  },
  {
   "id": "clah01:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そもそもアイツは部員じゃないんだし、ここに入り浸っていること自体、おかしいことなんだから。"
  },
  {
   "id": "clah01:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ちょっとお遊びのＹＥＳ－ＮＯテストの結果が、アイツみたいなタイプだったからって、僕にとってはどうだっていいことだ。"
  },
  {
   "id": "clah01:4100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「とにかくだ！ 部員でもないやつのことは置いといて、部活だ部活！」"
  },
  {
   "id": "clah01:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "とは言ったものの、新聞も刊行したばっかりで、特に話し合うべきこともなく。"
  },
  {
   "id": "clah01:4300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "結局、なあなあなままこの日の部活は終わり、下校することとなった。"
  },
  {
   "id": "clah01:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それにしても、なんという平穏な一日だったんだろう。"
  },
  {
   "id": "clah01:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "部としての活動は全く捗らなかったとはいえ、とにかく穏やかな一日だった。"
  },
  {
   "id": "clah01:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "どうして穏やかだったのか……その原因は間違いない。"
  },
  {
   "id": "clah01:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "有村がいなかったお陰だ。"
  },
  {
   "id": "clah01:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あいつがいると、とにかく僕や伊藤の言うことに茶々はいれるわふざけるわで、一向に話が前に進まないからな。"
  },
  {
   "id": "clah01:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あいつが居ないだけで、こうも平穏な一日になるなんて……。"
  },
  {
   "id": "clah01:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "これからもこうだと助かるんだけど。"
  },
  {
   "id": "clah01:5100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "なんとなく気分も良かったせいで、あれこれ寄り道してしまい、宮下公園に戻るころには、すっかり日も暮れていた。"
  },
  {
   "id": "clah01:5200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "겐 씨",
   "jp": "「ん？」"
  },
  {
   "id": "clah01:5300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "겐 씨",
   "jp": "トレーラーハウスの前まで来ると、僕を出迎えてくれる人影があった。"
  },
  {
   "id": "clah01:5400",
   "type": "dialogue",
   "speaker": "ゲンさん",
