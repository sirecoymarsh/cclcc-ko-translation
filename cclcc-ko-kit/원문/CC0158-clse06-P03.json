{
 "packet_id": "CC0158-clse06-P03",
 "kit_version": "1.0",
 "source_file": "clse06.msb",
 "speakers_in_packet": [
  "미야시로 타쿠루",
  "오노에 세리카"
 ],
 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "僕が忘れれば、存在が消えてなくなる！？"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "……それって、どういうことだ！？"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「そんなバカなこと、あるかよっ」"
  },
  {
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "jp": "「………」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「お前の言ってることは普通じゃない。それに、僕が尾上を忘れることなんて、あるわけないだろ？」"
  },
  {
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "jp": "「ふっ。好きな女が出来れば、いずれ忘れてしまうさ」"
  }
 ],
 "entries": [
  {
   "id": "clse06:14100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「だから、そんなわけないって言ってるんだ！」"
  },
  {
   "id": "clse06:14200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「さて、それはどうかな。……なぁ？」"
  },
  {
   "id": "clse06:14300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうだろうね。タクは意外と浮気者になる気がする。それに、私としても忘れてくれた方が嬉しい、かなあ」"
  },
  {
   "id": "clse06:14400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "いきなり尾上が、いつもの『白』の口調に戻って優しく言った。"
  },
  {
   "id": "clse06:14500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "そして――"
  },
  {
   "id": "clse06:14600",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ね、タク？ さっきは『死ぬ』なんておどかしてゴメンね。私なら、死ななくても、きっと⟦rb⟧綺麗⟦rt⟧きれい⟦/r⟧に消えることが出来ると思う」"
  },
  {
   "id": "clse06:14700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「尾上？ だからお前、何を言って――？」"
  },
  {
   "id": "clse06:14800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「これ以上は秘密でーす。それじゃあね、タク！ ばいばい！」"
  },
  {
   "id": "clse06:14900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "彼女は、一方的に会話を打ち切った。"
  },
  {
   "id": "clse06:15000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そして、ドアの方へくるりと背を向けた。"
  },
  {
   "id": "clse06:15100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「待ってくれ、尾上っ！」"
  },
  {
   "id": "clse06:15200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕はなんとも名状しがたい激しい感情にとらわれ、彼女の背に向けて思わず手を伸ばした！"
  },
  {
   "id": "clse06:15300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "次の瞬間、金属が千切れる激しい音とともに、四肢がいきなり自由になった。"
  },
  {
   "id": "clse06:15400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "後でいくら試しても、こんなに強い⟦rb⟧念動力⟦rt⟧のうりょく⟦/r⟧が僕から発現することはなかった――そのくらい激しい⟦rb⟧能力⟦rt⟧ちから⟦/r⟧で、僕の手足を拘束していたベルトの金属部分が弾け飛んでいた。"
  },
  {
   "id": "clse06:15500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「行くな、尾上っ！」"
  },
  {
   "id": "clse06:15600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "僕は、ふらつく身体などおかまいなしにベッドから飛び降りると、背後から尾上に抱きついていた。"
  },
  {
   "id": "clse06:15700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ひゃあっ！？」"
  },
  {
   "id": "clse06:15800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "突然のことに驚いた尾上は悲鳴を上げ、思わず身をすくめる。"
  },
  {
   "id": "clse06:15900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "でも僕は、この腕は絶対に離さないという気持ちを込めて、思い切り強く抱いた。"
  },
  {
   "id": "clse06:16000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "（こいつ……こんなに細くて、小さかったのか）"
  },
  {
   "id": "clse06:16100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そう。僕は、この時初めて、彼女が女の子だということを意識したのかもしれない。"
  },
  {
   "id": "clse06:16200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「いいか、尾上、よく聞け？ 今回の事、確かに僕は大変な目に遭わされた。お前、ちょっとやりすぎだよ」"
  },
  {
   "id": "clse06:16300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「………」"
  },
  {
   "id": "clse06:16400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「今回は、なんとか神成さん達に助けてもらえそうだけどさ……ここでずっと過ごすなんて、絶対無理に決まってるだろ？ もっと頭を使えよ」"
  },
  {
   "id": "clse06:16500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うう……」"
  },
  {
   "id": "clse06:16600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「けど……お前の気持ちはちゃんと聞いたよ」"
  },
  {
   "id": "clse06:16700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「正直、僕は愛とか恋とかそういうの、ぜんぜん分からない。けどさ……お前がいなくなったら、その……きっと寂しいと思う」"
  },
  {
   "id": "clse06:16800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「新聞部の部室で、いつも明るく笑ってくれてる方が嬉しいと……そう思う」"
  },
  {
   "id": "clse06:16900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「………」"
  },
  {
   "id": "clse06:17000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「なぁ、世莉架？ 先の事なんて分からないけど……今は、それじゃダメなのか？」"
  },
  {
   "id": "clse06:17100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「…………」"
  },
  {
   "id": "clse06:17200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「ダメなのか？」"
  },
  {
   "id": "clse06:17300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……タク」"
  },
  {
   "id": "clse06:17400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "背中越しに、尾上の身体が微かに震えているのが分かる。"
  },
  {
   "id": "clse06:17500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "それを止めてやりたくて、もう少しだけ力を込めて抱く。"
  },
  {
   "id": "clse06:17600",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……けど、もう手遅れだよ。私、取り返しのつかない事、しちゃったもん。きっともう、新聞部にも、学校にもいられない」"
  },
  {
   "id": "clse06:17700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「いや、取り返しならつく。というか、無理矢理にでもつけてやるから」"
  },
  {
   "id": "clse06:17800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う？」"
  },
  {
   "id": "clse06:17900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「さっきから考えてたんだ、どうすればいいか」"
  },
  {
   "id": "clse06:18000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「で、結論――全部、僕の新聞の取材が原因だったってことにすればいい」"
  },
  {
   "id": "clse06:18100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ええっ？」"
  },
  {
   "id": "clse06:18200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "背を向けていた世莉架が、その言葉に、思わず振り返った。"
  },
  {
   "id": "clse06:18300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「僕は、新聞のネタ集めのために、廃棄された地下病棟に潜りこんだ。そして、警察が見落としたスクープがないか、夢中になってずっと探索をしてたんだ。いいな？」"
  },
  {
   "id": "clse06:18400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「で、でも……」"
  },
  {
   "id": "clse06:18500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「いいから聞け。尾上はそんな僕に、毎日、食料の差し入れをしていた事にする。もちろんこれは不法侵入だから、尾上は僕から、きつく口止めをされていた」"
  },
  {
   "id": "clse06:18600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「ところが、素直で隠し事の下手な尾上のことだ。どうしても態度が変になってしまって、結局、来栖に怪しまれてしまった」"
  },
  {
   "id": "clse06:18700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「……とまぁ、そんな感じでいく。この筋書きなら、強引でも押し通せるだろ」"
  },
  {
   "id": "clse06:18800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
