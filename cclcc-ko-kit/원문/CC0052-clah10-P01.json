   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "何か言葉を打とうと思って、指が止まった。"
  },
  {
   "id": "clah10:6100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こんな文字にした言葉じゃ、本当か嘘かわからないじゃないか。"
  },
  {
   "id": "clah10:6200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕は、ちゃんと声に出して伝えなきゃいけないんだ。"
  },
  {
   "id": "clah10:6300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "아리무라 히나에",
   "jp": "「あ…………」"
  },
  {
   "id": "clah10:6400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『迷惑かけたのはわかってる……だから言わないで……』"
  },
  {
   "id": "clah10:6500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『声に……出さないで……』"
  },
  {
   "id": "clah10:6600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あの時の有村の言葉。"
  },
  {
   "id": "clah10:6700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ずっと違和感を覚えていた、あの言葉。"
  },
  {
   "id": "clah10:6800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あれはもしかしたら……。"
  },
  {
   "id": "clah10:6900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦rb⟧僕の⟦rt⟧⟦rbc⟧●●⟦/r⟧⟦rb⟧言葉の⟦rt⟧⟦rbc⟧●●●⟦/r⟧⟦rb⟧真偽を⟦rt⟧⟦rbc⟧●●●⟦/r⟧⟦rb⟧知りたく⟦rt⟧⟦rbc⟧●●●●⟦/r⟧⟦rb⟧なかった⟦rt⟧⟦rbc⟧●●●●⟦/r⟧ってことなんじゃないのか？"
  },
  {
   "id": "clah10:7000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": null,
   "jp": "「――！！」"
  },
  {
   "id": "clah10:7100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕は、あの日放り出したままにしていた有村の台本のページを捲った。"
  },
  {
   "id": "clah10:7200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『僕は雛絵さんのことが好きなんです！』"
  },
  {
   "id": "clah10:7300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『だから雛絵さんを帰したくありません』"
  },
  {
   "id": "clah10:7400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『これが嘘偽りのない僕の気持ちです』"
  },
  {
   "id": "clah10:7500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……やっぱ文芸部、向いてないよ、あいつ……」"
  },
  {
   "id": "clah10:7600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "もしもあの時、僕がこの言葉を口にしていれば、有村は否応なくそれが本当か嘘かわかってしまっただろう。"
  },
  {
   "id": "clah10:7700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "たとえそれが作られた台詞だとしても。"
  },
  {
   "id": "clah10:7800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "じゃあ、どうして有村は僕の本心を知りたくなかった？"
  },
  {
   "id": "clah10:7900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "もしも僕の言葉が偽りでなかったとしたら――それは、僕が有村を本当に好きだ、ということになる。"
  },
  {
   "id": "clah10:8000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "その場合、有村が聞きたくなかった理由はひとつ。"
  },
  {
   "id": "clah10:8100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "僕に好かれているという事実を知りたくなかったということだ。"
  },
  {
   "id": "clah10:8200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "どうして？"
  },
  {
   "id": "clah10:8300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "僕が有村のアプローチに負けて、有村のことを本当に好きになっていたら困るから？"
  },
  {
   "id": "clah10:8400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "好きでもない相手から本気で好意を持たれても困る。だからこそ僕を拒絶した――そういうことになる。"
  },
  {
   "id": "clah10:8500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "でもあの時の有村は心細げな……今にも泣き出してしまいそうな、そんな顔をしていた。"
  },
  {
   "id": "clah10:8600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "あれが、誰かの好意を拒絶する人間の顔だろうか？"
  },
  {
   "id": "clah10:8700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕にはそうは思えない。"
  },
  {
   "id": "clah10:8800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "じゃあ、他に理由は？"
  },
  {
   "id": "clah10:8900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "もうひとつ、考えられる理由があるとすればそれは――僕の言葉が嘘だった場合だ。"
  },
  {
   "id": "clah10:9000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "台本通り『有村の事が好きだ』と、そう告げた僕の言葉が偽りであるなら、実際には僕は本当は有村を好きじゃない、ということになる。"
  },
  {
   "id": "clah10:9100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "もしも、有村がその事実を知ってしまうことを拒絶したのだとするなら、それは何故だ？"
  },
  {
   "id": "clah10:9200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（まさか、有村も僕のことを……？）"
  },
  {
   "id": "clah10:9300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "自分が好意を寄せている相手が、もしも自分のことを好きでなかったら――。"
  },
  {
   "id": "clah10:9400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "その事実を知るのが怖いから、有村はあの時、僕に声に出すなと、そう言ったんじゃないのか？"
  },
  {
   "id": "clah10:9500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "もちろん、僕のことを嫌になり拒絶したという可能性だって有り得る。"
  },
  {
   "id": "clah10:9600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "でも僕は、もうひとつの可能性を信じたかった。"
  },
  {
   "id": "clah10:9700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "有村が僕を好きだという可能性を……。"
  },
  {
   "id": "clah10:9800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "だとしたら、僕はなおさら彼女に会わなきゃいけない。"
  },
  {
   "id": "clah10:9900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "会って気持ちを声にして伝えなきゃいけない。"
  }
 ],
 "context_after": [
