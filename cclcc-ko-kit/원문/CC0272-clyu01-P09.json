  {
   "id": "clyu01:80000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「それで、こんな時間にどうしたんだ？」"
  },
  {
   "id": "clyu01:80100",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はい。実はその……」"
  },
  {
   "id": "clyu01:80200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "言葉を選んでいるのかそれとも迷っているのか。"
  },
  {
   "id": "clyu01:80300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "しばらく考えるようにしてから、うきはやっと口を開いた。"
  },
  {
   "id": "clyu01:80400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留さん。結衣ちゃんのお願い、聞いてあげてもらえないでしょうか？」"
  },
  {
   "id": "clyu01:80500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「結衣のって……例のアイドルになりたいって話？」"
  },
  {
   "id": "clyu01:80600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はい……」"
  },
  {
   "id": "clyu01:80700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "驚いた。"
  },
  {
   "id": "clyu01:80800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣が言ってくるならともかく、うきがこんなことを訴えて来るなんて。"
  },
  {
   "id": "clyu01:80900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「でも、結衣は諦めるって……」"
  },
  {
   "id": "clyu01:81000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「結衣ちゃん、ああやって納得してはいましたけど、本当はやってみたいはずなんです。だから……」"
  },
  {
   "id": "clyu01:81100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「あれ？ うきちゃん？」"
  },
  {
   "id": "clyu01:81200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "いつの間に現れたのか、開いたままのドアの外に結衣が立っていた。"
  },
  {
   "id": "clyu01:81300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「結衣ちゃん……」"
  },
  {
   "id": "clyu01:81400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "結衣は怪訝そうな様子を隠しもせず、僕の部屋に足を踏み入れた。"
  },
  {
   "id": "clyu01:81500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「うきちゃん、どうしたの？ こんな遅くに、拓留兄の部屋で何してるの？」"
  },
  {
   "id": "clyu01:81600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えっと、それはその……」"
  },
  {
   "id": "clyu01:81700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「結衣こそどうしたんだよ？ もう夜中だぞ」"
  },
  {
   "id": "clyu01:81800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「私は、拓留兄にお願いがあって……」"
  },
  {
   "id": "clyu01:81900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "お願い……それは、もしかして。"
  },
  {
   "id": "clyu01:82000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「私ね、やっぱりアイドル、やってみたい。だから拓留兄、力をかしてくれないかな？」"
  },
  {
   "id": "clyu01:82100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "……うきの言ったとおりだった。"
  },
  {
   "id": "clyu01:82200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "一度ああは言ったものの、結衣はやっぱり諦めきれなかったんだ。"
  },
  {
   "id": "clyu01:82300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕は気づいていなかった――というかあんまり気にしてなかったけど、うきにはそれがわかっていた。"
  },
  {
   "id": "clyu01:82400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「じゃあ、用件はうきと一緒だな」"
  },
  {
   "id": "clyu01:82500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「え？ ってことはもしかしてうきちゃんも……？」"
  },
  {
   "id": "clyu01:82600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「うん」"
  },
  {
   "id": "clyu01:82700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「うそ！ うきちゃんもアイドルやりたかったの！？」"
  },
  {
   "id": "clyu01:82800",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「え？ ち、違います。そうじゃなくて、私は結衣ちゃんに……」"
  },
  {
   "id": "clyu01:82900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「私に？ どういうこと？」"
  },
  {
   "id": "clyu01:83000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「うきは、結衣に一度アイドルをやらせてやってくれって……そのために協力してくれって言いに来たんだ」"
  },
  {
   "id": "clyu01:83100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「うきちゃん……そうだったんだ……」"
  },
  {
   "id": "clyu01:83200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「だって……結衣ちゃん、本当はやりたそうだったから。でも余計なことだったかな？」"
  },
  {
   "id": "clyu01:83300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「ううんっ！ 嬉しいよ。ありがとう、うきちゃんっ」"
  },
  {
   "id": "clyu01:83400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「わっ」"
  },
  {
   "id": "clyu01:83500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "感極まったのか、結衣はうきに抱きついて喜んだ。"
  },
  {
   "id": "clyu01:83600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「ふふっ。うきちゃん、大好きっ」"
  },
  {
   "id": "clyu01:83700",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そんな。私は結衣ちゃんに喜んで欲しかっただけで」"
  },
  {
   "id": "clyu01:83800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「…………」"
  },
  {
   "id": "clyu01:83900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「ね、やっぱりうきちゃんも、一緒にやろうよ！ アイドル活動！」"
  },
  {
   "id": "clyu01:84000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「え？ わ、私？ む、無理だよ、アイドルなんて、そんなの……」"
  },
  {
   "id": "clyu01:84100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「そんなことないよ。うきちゃん可愛いもん。きっとできるよ」"
  },
  {
   "id": "clyu01:84200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「そんな……私なんて……」"
  },
  {
   "id": "clyu01:84300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「それに私も、うきちゃんが一緒にやってくれたら心強いし」"
  },
  {
   "id": "clyu01:84400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「…………」"
  },
  {
   "id": "clyu01:84500",
   "type": "dialogue",
