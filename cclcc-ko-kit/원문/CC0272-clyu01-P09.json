  {
   "id": "clyu01:79900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕はベッドから起き出して腰かけると、彼女にも座るように勧めた。"
