  {
   "id": "clka05:2200",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あからさまに声が上ずってるぞ。どうかしたのか？」"
