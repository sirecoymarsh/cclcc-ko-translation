   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「大丈夫。平静を装ってたから、みんなには怪しまれていない筈だ」"
