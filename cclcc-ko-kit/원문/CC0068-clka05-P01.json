   "id": "clka05:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "完璧な方程式だ！"
  },
  {
   "id": "clka05:4500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いやでも、それだったら部室で教えてくれてもいいよな」"
  },
  {
   "id": "clka05:4600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まあ、この写真を人前に出せないのは確かだし、香月がそれについて配慮したのかもしれない」"
  },
  {
   "id": "clka05:4700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いずれにせよ、本人に聞けばはっきりするだろう」"
  },
  {
   "id": "clka05:4800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「しかし、遅いな――」"
  },
  {
   "id": "clka05:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "と、その時、"
  },
  {
   "id": "clka05:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "突然、跳び箱の影から誰かが現れ、僕に飛びかかって来た！"
  },
  {
   "id": "clka05:5100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "카즈키 하나",
   "jp": "「なななななっ！？」"
  },
  {
   "id": "clka05:5200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "突然現れた誰かは僕の両肩を掴み、そのまま床に押し倒した。"
  },
  {
   "id": "clka05:5300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "카즈키 하나",
   "jp": "「ぐあっ！？」"
  },
  {
   "id": "clka05:5400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "相手はそのまま僕の体に覆い被さった。"
  },
  {
   "id": "clka05:5500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "突然の事に混乱していた僕は、正直超びびりながらも、組み伏せた相手を見上げる。"
  },
  {
   "id": "clka05:5600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "と――"
  },
  {
   "id": "clka05:5700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "카즈키 하나",
   "jp": "「か、香月！？」"
  },
  {
   "id": "clka05:5800",
