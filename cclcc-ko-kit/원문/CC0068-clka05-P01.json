   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "校庭の隅にある体育倉庫は、文字通り体育で使う備品の倉庫だった。"
  },
  {
   "id": "clka05:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "とはいえ、入っているのは綱引きの綱とか、大玉とか、体育祭みたいな特別な行事でしか見た事の無い道具ばかり。"
  },
  {
   "id": "clka05:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "運動部が使う備品はそれぞれの部活が保管しているから、ここに訪れるひとは滅多にいない。"
  },
  {
   "id": "clka05:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "僕はわざわざ、事務室から鍵を借りてきたのだ。"
  },
  {
   "id": "clka05:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "あのメールに従って。"
  },
  {
   "id": "clka05:1400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「拓留、どうかしたの？」"
  },
  {
   "id": "clka05:1500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「誰かからメールすか？ もしかして告白とか！？ やりますねえこのこの！」"
