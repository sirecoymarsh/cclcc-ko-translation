  {
   "id": "clka05:1600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「い、いや、間違い電話じゃないかな？ すぐ切れたみたいだ」"
  },
  {
   "id": "clka05:1700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……ふうん？ まあ、いいですけど」"
  },
  {
   "id": "clka05:1800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "「そ、そうだなあ」"
