   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "「いいいいやっ、ぼ、ぼく一人で行くから！ みみみんなはここで待っていてくれ！」"
