  {
   "id": "clka05:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "쿠루스 노노",
   "jp": "「なんでもないっ！ なんでもないからっ！ いいか！？ ついてくるなよ！？」"
