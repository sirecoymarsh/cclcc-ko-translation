  {
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "jp": "「さっきの一連の出来事は、飼い犬にでも噛まれたと思って忘れましょう」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "いろいろ間違っているが、言いたいことはわかった。"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「そ、そうだな……」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "とは言ったけど、あんな強烈な体験、忘れられる自信はもちろんない。"
  },
  {
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "jp": "「よ、よーし。そんじゃ、ご飯、食べましょうか」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「え？ あ、ああ……そうだな……」"
  }
 ],
 "entries": [
  {
