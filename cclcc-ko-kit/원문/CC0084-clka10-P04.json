  {
   "id": "clka10:35700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "『華』の行動を、香月が望んでいるっていうのか？"
