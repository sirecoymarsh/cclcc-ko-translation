   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "타치바나 유이",
   "jp": "（い、今から逃亡出来るとしたらどこだ？）"
