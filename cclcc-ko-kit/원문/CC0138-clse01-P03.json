   "id": "clse01:24800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "あいつなら来栖よりは僕に甘いし、交換条件次第で、なんとかなるかも知れない。"
