   "id": "clse01:24900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "僕は、尾上と来栖の電話が終わる前に逃げ出すと、青葉寮へと走った。"
