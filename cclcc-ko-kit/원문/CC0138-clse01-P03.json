   "id": "clse01:25200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「聞こえな〜い。だいたい、それが人にものを頼む態度なのかなあ？ せめて、土下座くらいしてもらわないと〜」"
  },
  {
   "id": "clse01:25300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「くっ。調子に乗りやがって……」"
  },
  {
   "id": "clse01:25400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "こいつ、いつの間にこんなに生意気に……？"
