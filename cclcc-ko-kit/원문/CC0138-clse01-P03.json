  {
   "id": "clse01:23700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だからね、私やのんちゃんがそばにいるのに、なんで他の子の写真とか見たがるのかなって、聞いたの」"
  },
  {
   "id": "clse01:23800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そしたらね、のんちゃんや私は、あの本みたいにえっちなコトをしないからだって」"
  },
  {
   "id": "clse01:23900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「タクは、私たちに、ああいうのをして欲しいってことなのかなあ？」"
  },
  {
   "id": "clse01:24000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "お、お、お前……いくらなんでも、ストレート過ぎだぞ？"
