  {
   "id": "clse01:23600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "しかも尾上のやつ、よりにもよって、いま僕にしたのと同じ質問を、来栖に向かってし始めたのだ。"
