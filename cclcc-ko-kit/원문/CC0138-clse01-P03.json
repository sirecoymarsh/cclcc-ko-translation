   "id": "clse01:24100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕の額からしたたり落ちるこの大量の汗は、決して暑いからなんかじゃない。"
