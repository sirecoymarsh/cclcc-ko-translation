   "id": "clah02:34300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "でもそのためには、触らなきゃならないわけで……。"
  },
