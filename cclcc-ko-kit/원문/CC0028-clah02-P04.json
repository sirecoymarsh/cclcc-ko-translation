   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "そう言い聞かせながら、小さく丸まったカラフルな布を掴んだ。"
