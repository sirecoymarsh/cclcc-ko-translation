   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「違うんです！ あれは――」"
  },
  {
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "jp": "「それじゃあ、我らが国王を呼ぼうじゃないか」"
  }
 ],
 "entries": [
  {
