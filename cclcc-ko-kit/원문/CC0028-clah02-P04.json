  {
   "id": "clah02:35300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ついさっきですよ。戻ってきたら伊藤先輩が来てるんだもん。危うく見つかるところでしたよ」"
  },
  {
   "id": "clah02:35400",
