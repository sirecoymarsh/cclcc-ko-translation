  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「休みだよ。そういうわけだから、今日も部活は中止だ」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「なんで昼休みにまでお前がここに来るんだよ、有村」"
