  {
   "id": "clkn12:900",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「そういえば、拓留さん、昨夜遅く泉理さんのお部屋から出て来ましたけど……」"
