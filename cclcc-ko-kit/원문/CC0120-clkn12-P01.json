  {
   "id": "clkn12:1000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「え！？ ちょっと拓留兄！ なに？ やっぱり泉理姉と何かあったの？」"
  },
  {
   "id": "clkn12:1100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「ないない！ ただひかりを寝かしつけてそのままウトウトしちゃっただけだ！」"
  },
  {
   "id": "clkn12:1200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ホントにぃ？」"
  },
  {
   "id": "clkn12:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "쿠루스 노노",
   "jp": "「ホントに決まってるだろ！！」"
  },
  {
   "id": "clkn12:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "……何も無かった……よな？"
  },
  {
   "id": "clkn12:1500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「何かあったら、すぐに連絡してね」"
  },
  {
   "id": "clkn12:1600",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유이",
   "jp": "「わかってるって。相変わらず心配性だな、お前は」"
  },
  {
   "id": "clkn12:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유이",
   "jp": "青葉寮を出る寸前まで、乃々は何度もひかりのことを心配して残ると言っていたが、さすがに最後は父さんの言葉に従うことになった。"
  },
  {
   "id": "clkn12:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유이",
   "jp": "ひかりは僕たちの心配に反して、父さんの腕の中で機嫌よく笑っていた。"
  },
  {
   "id": "clkn12:1900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유이",
   "jp": "案外、大きくてがっしりした体つきが、安心感を与えるのかもしれない。"
  },
  {
   "id": "clkn12:2000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「それじゃ、いってきまーす」"
  },
  {
   "id": "clkn12:2100",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "「おう、いってこい！」"
  },
  {
   "id": "clkn12:2200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「…………」"
  },
  {
   "id": "clkn12:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「どうした、うき？」"
  },
  {
   "id": "clkn12:2400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「今日は拓留さんも一緒なんですね」"
