   "id": "clkn12:3700",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「生徒の諸君は速やかに体育館に集合してください」"
  },
  {
   "id": "clkn12:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "また、緊急の生徒会？"
  },
  {
   "id": "clkn12:3900",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「繰り返します。ただいまより、緊急の生徒集会を行います。生徒の諸君は速やかに体育館に集合してください」"
  },
  {
   "id": "clkn12:4000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "오노에 세리카",
   "jp": "「ったく、なんだよ、これから放課後って時に」"
  },
  {
   "id": "clkn12:4100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "なんだか、胸騒ぎがする。"
  },
  {
   "id": "clkn12:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "体育館には、既に多くの生徒が集まっていた。"
  },
  {
   "id": "clkn12:4300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ、タク。きんきゅうしゅうかいってなんだろねー？」"
  },
  {
   "id": "clkn12:4400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "「さあな。それより乃……来栖。帰らなくて大丈夫か？」"
  },
  {
   "id": "clkn12:4500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "「ええ。さっき父さんに連絡したら、問題ないって。それに……急に集会だなんて……こっちも心配だし」"
  },
  {
   "id": "clkn12:4600",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "「てことは、副部長も知らないってわけか」"
  },
  {
   "id": "clkn12:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "아리무라 히나에",
   "jp": "やっぱり、どうにも嫌な予感がする。"
  },
  {
   "id": "clkn12:4800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "카즈키 하나",
   "jp": "「生徒会長が知らないのに、生徒集会っておかしくないっすか？」"
  },
  {
   "id": "clkn12:4900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카와하라 마사시",
   "jp": "「おかしい……かも」"
  },
  {
   "id": "clkn12:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카와하라 마사시",
   "jp": "不意に会場のざわめきが止んだ。"
  },
  {
   "id": "clkn12:5100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카와하라 마사시",
   "jp": "壇上に現れたのは、さっきの放送の声の主でもある川原くんだ。"
  },
  {
   "id": "clkn12:5200",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "카즈키 하나",
   "next_speaker": null,
   "jp": "「生徒会副会長の川原です」"
  },
  {
   "id": "clkn12:5300",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "카즈키 하나",
   "next_speaker": null,
   "jp": "「今日、こうして急に集まってもらったのは他でもない。先週決まった『校内恋愛禁止令』に関係することだ」"
  },
  {
