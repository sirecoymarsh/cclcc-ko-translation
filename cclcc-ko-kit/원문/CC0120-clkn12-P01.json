   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "카와하라 마사시",
   "jp": "それは⟦col:280aa02d1400⟧女帝⟦col:800000⟧でもなく、弟や妹を叱る姉でもなく。"
