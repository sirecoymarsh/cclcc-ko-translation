   "id": "clkn12:8600",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「来栖……生徒会長である君が傍にいて、こんな事態になったのは残念で仕方がないよ……」"
  },
  {
   "id": "clkn12:8700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "どうして、川原くんがあんな映像を？"
