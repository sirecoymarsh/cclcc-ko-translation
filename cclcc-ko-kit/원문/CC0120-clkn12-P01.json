  {
   "id": "clkn12:8800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "たまたま？ あるいは後をつけていたのか？"
