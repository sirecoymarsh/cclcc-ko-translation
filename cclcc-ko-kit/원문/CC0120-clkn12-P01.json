   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "미나미사와 센리",
   "jp": "「『あ、ほら、ひかり！ パパとママが帰ってきたわよ』」"
