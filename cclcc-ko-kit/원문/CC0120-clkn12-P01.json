  {
   "id": "clkn12:5900",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だが、それもあくまで、学生らしい節度ある関係……という範疇の話だ」"
  },
  {
   "id": "clkn12:6000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "川原くんはゆっくりと会場を眺めまわすと、再び口を開いた。"
