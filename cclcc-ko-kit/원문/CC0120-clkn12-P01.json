   "id": "clkn12:2900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留。お弁当は持った？」"
  },
  {
   "id": "clkn12:3000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「ああ。それより、早く行かないと遅れちゃうぞ」"
  },
  {
   "id": "clkn12:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "長かった一日を終えて、ようやく放課後を迎えた。"
  },
  {
   "id": "clkn12:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "きっと乃々は、ひかりのことが心配で仕方なかっただろう。"
