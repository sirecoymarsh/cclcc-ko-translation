  {
   "id": "clkn12:5800",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「禁止令はあくまでも校内でのことであり、学外に出てまでとやかく言うことじゃないというのは、我々も重々承知だ」"
