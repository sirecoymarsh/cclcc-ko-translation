   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「ただいまより、緊急の生徒集会を行います」"
