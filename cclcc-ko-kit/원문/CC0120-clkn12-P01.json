   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "쿠루스 노노",
   "jp": "「『あらぁ、ひかり。どうしたの？ 寂しかったの？』」"
