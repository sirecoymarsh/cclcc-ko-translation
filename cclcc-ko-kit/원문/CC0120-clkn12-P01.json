  {
   "id": "clkn12:2600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "쿠루스 노노",
   "jp": "「別に……なんとなくだよ」"
  },
  {
   "id": "clkn12:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "みんなで学校に行くなんて恥ずかしい……。"
  },
  {
   "id": "clkn12:2800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "そんな思いもまだ無くはなかったけど、それでも今はその恥ずかしさすら、どこか心地よいように思える。"
