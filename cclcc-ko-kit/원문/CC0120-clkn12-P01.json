  {
   "id": "clkn12:6100",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「本題に入ろう。諸君の中に、本校、碧朋学園の生徒としての節度に大きく反する行為に及んでいるものがいる。それは――」"
  },
  {
   "id": "clkn12:6200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "川原くんの視線が真っ直ぐにこっちを見た。"
  },
  {
   "id": "clkn12:6300",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「３年１組、宮代拓留――君だ！！」"
