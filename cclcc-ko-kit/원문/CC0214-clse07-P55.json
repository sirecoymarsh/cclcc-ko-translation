  {
   "id": "clse07:530300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いやでも、それだったら部室で教えてくれてもいいよな」"
  },
  {
   "id": "clse07:530400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まあ、この写真を人前に出せないのは確かだし、香月がそれについて配慮したのかもしれない」"
  },
  {
   "id": "clse07:530500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いずれにせよ、本人に聞けばはっきりするだろう」"
