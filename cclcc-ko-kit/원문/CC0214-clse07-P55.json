  {
   "id": "clse07:529000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「い、いや、間違い電話じゃないかな？ すぐ切れたみたいだ」"
