  },
  {
   "id": "clse07:508600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いやでも、僕の名前を知っているわけだし……」"
  },
  {
