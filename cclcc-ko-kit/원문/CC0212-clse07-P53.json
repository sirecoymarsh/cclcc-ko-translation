   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ん？ 誰からだこれ？」"
  },
  {
   "id": "clse07:508300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「このドメイン……。フリーの捨てアカウントだな」"
  },
  {
   "id": "clse07:508400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「件名、宮代拓留様……？ 絨毯爆撃のスパムメールじゃないみたいだな」"
  },
  {
   "id": "clse07:508500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
