{
 "packet_id": "CC0299-clyu17-P01",
 "kit_version": "1.0",
 "source_file": "clyu17.msb",
 "speakers_in_packet": [
  "남자",
  "타치바나 유이"
 ],
 "context_before": [],
 "entries": [
  {
   "id": "clyu17:0",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それじゃまた明日ね、ばいばーい！」"
  },
  {
   "id": "clyu17:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "終業のチャイムが鳴り終えたその５分後には、橘結衣は友人たちに別れを告げ、拓留たちの待つ宮下公園のトレーラーハウスへと足早に向かっていた。"
  },
  {
   "id": "clyu17:200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "これほどまでに早く向かうのには訳があった。"
  },
  {
   "id": "clyu17:300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "⟦top:38⟧ひとつは、この後『⟦col:280aa02d1400⟧ミルフィーユ⟦col:800000⟧』として⟦col:280aa02e1400⟧ニヤ生⟦col:800000⟧を配信するため。"
  },
  {
   "id": "clyu17:400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "⟦top:38⟧そしてもうひとつは――そこに行けば会えるから――だった。"
  },
  {
   "id": "clyu17:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "結衣にとって、宮代拓留は義理の兄にあたる。"
  },
  {
   "id": "clyu17:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "義理の兄と言っても、単に養護施設で一緒に暮らしているというだけであって、戸籍上は他人である。"
  },
  {
   "id": "clyu17:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "しかも兄妹として暮らし始めてからの年月は、まだそれほどでもない。"
  },
  {
   "id": "clyu17:800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "宮代拓留という人物は、少し理屈っぽく斜に構えたところがあって、結衣から見ても子どもっぽいところがあった。"
  },
  {
   "id": "clyu17:900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "⟦top:38⟧それでも結衣にとって拓留はやはり兄であり、結衣もまた兄として慕っていた。"
  },
  {
   "id": "clyu17:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "⟦top:38⟧だからこそ、拓留が家を飛び出してしまった時は寂しくも感じたし、戻ってきてくれた時には素直に嬉しいと思った。"
  },
  {
   "id": "clyu17:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "けれど――拓留が戻ってきてからこの数週間、そんな結衣の心境は少しずつ変化していた。"
  },
  {
   "id": "clyu17:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "⟦top:38⟧アイドルになりたい――誰もが笑うようなそんな夢を叶えようと、拓留は奮闘してくれた。"
  },
  {
   "id": "clyu17:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "⟦top:38⟧そこには拓留なりに何らかの算段があるのだろうということは、結衣も薄々はわかってはいた。"
  },
  {
   "id": "clyu17:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "⟦top:38⟧とはいえ、やはり自分たちのために考え、そして行動してくれる拓留の気持ちは嬉しかった。"
  },
  {
   "id": "clyu17:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "そしていつしか結衣は、拓留のことを兄とは違う、別の存在として見始めていた。"
  },
  {
   "id": "clyu17:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "果たしてその気持ちが何なのか……。"
  },
  {
   "id": "clyu17:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "そのことに、結衣も薄々は気づいていた。"
  },
  {
   "id": "clyu17:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "だからこそ、彼の下へと向かう彼女の足は自然と早くなっていたのだ。"
  },
  {
   "id": "clyu17:1900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "⟦top:114⟧しかし――。"
  },
  {
   "id": "clyu17:2000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": "남자",
   "jp": "「…………」"
  },
  {
   "id": "clyu17:2100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "남자",
   "jp": "その足が不意に止まった。"
  },
  {
   "id": "clyu17:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "남자",
   "jp": "電信柱の下、じっと自分を覗き見ていた怪しげな男の影に結衣は気づいたのだ。"
  },
  {
   "id": "clyu17:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "남자",
   "jp": "明らかに警戒する結衣に、男はゆっくりと近づいてきた。"
  },
  {
   "id": "clyu17:2400",
   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "「ちょっといいかな？」"
  },
  {
   "id": "clyu17:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "남자",
   "next_speaker": null,
   "jp": "そして、小さな声で何事かを囁くと、にんまりと笑みを浮かべた。"
  }
 ],
 "context_after": []
}