   "prev_speaker": "남학생",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ほら、あの人……」"
  },
  {
   "id": "clkn14:1100",
   "type": "dialogue",
   "speaker": "女子生徒",
   "speaker_ko": "여학생",
   "prev_speaker": "남학생",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「近づいたら妊娠しちゃうんじゃない？」"
