   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "여학생",
   "next_speaker": "미야시로 타쿠루",
   "jp": "話は⟦rb⟧歪⟦rt⟧いびつ⟦/r⟧な尾ひれをつけて更に大きくなっている。"
  },
  {
   "id": "clkn14:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "여학생",
   "next_speaker": "미야시로 타쿠루",
   "jp": "学校内どこへいっても、向けられるのは好奇の目。"
  },
  {
   "id": "clkn14:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "여학생",
   "next_speaker": "미야시로 타쿠루",
   "jp": "くそっ！"
  },
  {
   "id": "clkn14:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "여학생",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕が注目されたかったのは、スクープをゲットする側としてであって、される側としてじゃない。"
  },
  {
   "id": "clkn14:1700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "여학생",
   "next_speaker": "아리무라 히나에",
   "jp": "「な？ わかっただろ。だから、しばらく僕には――」"
  },
  {
   "id": "clkn14:1800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "「大丈夫っすよー。私、別にそーゆーの気にしないし。ねー」"
  },
  {
   "id": "clkn14:1900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ねー……」"
  },
  {
   "id": "clkn14:2000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「有村……香月……」"
  },
  {
   "id": "clkn14:2100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あんなの本当じゃないから、きっとみんなそのうちわかってくれる……はず……」"
  },
  {
   "id": "clkn14:2200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「……そっか。ありがとう……」"
  },
  {
   "id": "clkn14:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "와쿠이 슈이치",
   "jp": "そうは言ってみたものの、校内の風向きがかなり悪くなってきているのは、当事者である僕が一番よくわかっている。"
  },
  {
   "id": "clkn14:2400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "와쿠이 슈이치",
   "jp": "伊藤なんかは、すべて川原くんが何らかの情報操作をして、⟦col:280aa02d1400⟧燃料⟦col:800000⟧を投下してるんじゃないかと言っていたけれど、それも定かではない。"
  },
  {
   "id": "clkn14:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "와쿠이 슈이치",
   "jp": "仮にそうだとしても、僕たちに出来ることはただひとつしかない。"
  },
  {
   "id": "clkn14:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "와쿠이 슈이치",
   "jp": "それは、真実を言って誤解をとくことだ。"
  },
  {
   "id": "clkn14:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "와쿠이 슈이치",
   "jp": "けれど……。"
  },
  {
   "id": "clkn14:2800",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ああ。いたいた」"
  },
  {
   "id": "clkn14:2900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「和久井先生……」"
  },
  {
   "id": "clkn14:3000",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「宮代くん。悪いんだけど、ちょっといいかな？」"
  },
  {
   "id": "clkn14:3100",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「僕も努力はしたんだけどね、如何せん問題が問題でね。このままだと何らかの対策をしなきゃいけない……」"
  },
  {
   "id": "clkn14:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "미야시로 타쿠루",
   "jp": "誰も来ないことを確認して和久井先生が話し出したのは、やはり例の件に関してのことだった。"
  },
  {
   "id": "clkn14:3300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「何らかの対策……それは、退学ってこと……ですか？」"
  },
  {
   "id": "clkn14:3400",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「いやいやいや、まだそこまでのことじゃない」"
  },
  {
   "id": "clkn14:3500",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「ただ……これ以上話が大きくなると、学校側としてもそれなりの措置をとらざるを得なくなるかもしれない……ということだよ」"
  },
  {
   "id": "clkn14:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "それなりの措置。"
  },
  {
   "id": "clkn14:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "結局、言ってることは同じじゃないか。"
  },
  {
   "id": "clkn14:3800",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「いくら生徒たちの自主性に任せるとはいえ、こう事が大きくなってくるといろいろあってねぇ」"
  },
  {
   "id": "clkn14:3900",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「生徒たちからの声はもちろんだが、⟦col:280aa02d1400⟧教育委員会⟦col:800000⟧とか保護者の声とか、ね」"
  },
  {
   "id": "clkn14:4000",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「風紀が乱れているという噂が流れると、これから入学してくる生徒にも影響を及ぼすかもしれない……」"
  },
  {
   "id": "clkn14:4100",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「実際、他の先生方からは、厳しく対処すべきだという声もあがりつつある……」"
  },
  {
   "id": "clkn14:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "このままいけば、良くて停学。"
  },
  {
   "id": "clkn14:4300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "悪くて退学ってところか……。"
  },
  {
   "id": "clkn14:4400",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「でも宮代くん。僕の方で一応、佐久間さんに電話して確認してみたんだが、その赤ちゃんは君たちの言うように預けられた子だっていうじゃないか」"
  },
  {
   "id": "clkn14:4500",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だったら、その例の写真の女の子に来てもらって、本当のことを言ってもらえば、それで済むことなんじゃないのかい？」"
  },
  {
   "id": "clkn14:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": null,
   "jp": "そう。"
  },
  {
   "id": "clkn14:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": null,
   "jp": "たかがそれだけのこと、だ。"
  },
  {
   "id": "clkn14:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": null,
   "jp": "けれども僕たちには“たかがそれだけのこと”でも、彼女にとってはそうじゃない。"
  },
  {
   "id": "clkn14:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "人には誰しも、知られたくない過去のひとつやふたつあるだろう。"
  },
  {
   "id": "clkn14:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "それが今まで築いてきたものをすべてぶち壊すことになるとすれば、尚更だ。"
  },
  {
   "id": "clkn14:5100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "過去、彼女が自分が本当は来栖乃々ではなく、南沢泉理だと打ち明けられた時、家族の間にもギクシャクした空気は当然あった。"
  },
  {
   "id": "clkn14:5200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "僕だってそうだ。"
  },
  {
   "id": "clkn14:5300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "その事実をすぐに受け入れることは出来なかった。"
  },
  {
   "id": "clkn14:5400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "와쿠이 슈이치",
   "jp": "今となっても鮮明に思い出すことができる。"
