   "speaker_ko": "남학생",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "여학생",
   "jp": "「うわっ、あんな暗そうなのに、ヤることヤってんのかよ……」"
  },
  {
   "id": "clkn14:1000",
   "type": "dialogue",
   "speaker": "女子生徒",
