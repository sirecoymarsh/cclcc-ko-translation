 ],
 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "今回の騒動は、そもそも自分の気持ちを無理矢理おさえこんだから起きたことなのだ。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "その決着を付けるためには、自分の気持ちをまっすぐに見つめ、答えを出す必要がある。"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "そして、今、それをすべきなのだ。"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「……」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「……ん」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「拓留先輩は、わたしに居場所をくれたの」"
  }
 ],
 "entries": [
  {
   "id": "clka11:20000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「先輩は、突然新聞部に居ついたわたしを、事情を聞くこともなく受け入れてくれた」"
  },
  {
   "id": "clka11:20100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「黙ってエンスーやり続けても、文句言わずにいてくれた」"
  },
  {
   "id": "clka11:20200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わたしが喋りたがらない理由も聞かずにいてくれた」"
  },
  {
   "id": "clka11:20300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「きっと、それは、先輩にとってはなんでもないことなの」"
  },
  {
   "id": "clka11:20400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「きっと、わたしは部員の数合わせにすぎないの」"
  },
  {
   "id": "clka11:20500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「でも、嬉しかった」"
  },
  {
   "id": "clka11:20600",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わたしを必要としてくれて、わたしがしたいことを尊重してくれることが嬉しかった」"
  },
  {
   "id": "clka11:20700",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それに、拓留先輩は、優しい人なの」"
  },
  {
   "id": "clka11:20800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「普段はすっごく偉そうだし、みんなをバカにするような言い方しかしないけど、本当は凄く優しい人なの」"
  },
  {
   "id": "clka11:20900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「きっと、今も、わたしを探して走り回ってる筈」"
  },
  {
   "id": "clka11:21000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だから、わたしは……」"
  },
  {
   "id": "clka11:21100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わたし、は……」"
  },
  {
   "id": "clka11:21200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "声が尻すぼみになっていって、喋れなくなる。"
  },
  {
   "id": "clka11:21300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "顔もうつむき、視線が床を彷徨ってしまう。"
  },
  {
   "id": "clka11:21400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "『華』が一歩近づき、目の前に立つ。"
  },
  {
   "id": "clka11:21500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わたし、は？」"
  },
  {
   "id": "clka11:21600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "優しく手を握り、聞いて来る。"
  },
  {
   "id": "clka11:21700",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「大丈夫、あたしがついてるから。言ってごらん」"
  },
  {
   "id": "clka11:21800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……」"
  },
  {
   "id": "clka11:21900",
   "type": "dialogue",
