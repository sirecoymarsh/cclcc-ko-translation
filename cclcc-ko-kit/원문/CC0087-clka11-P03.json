   "id": "clka11:25700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "言われて、視線を巡らせる。"
  },
  {
   "id": "clka11:25800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "無人のエントランスの奥。シアターに向かう階段よりも更に奥。"
  },
  {
   "id": "clka11:25900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
