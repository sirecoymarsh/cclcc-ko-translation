  {
   "id": "clka11:23100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "その途端、景色がぐにゃりと歪んだ。"
  },
  {
   "id": "clka11:23200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え、なに……？」"
  },
  {
   "id": "clka11:23300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もう脳内会話は終わり。現実に戻りな」"
  },
  {
   "id": "clka11:23400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え、どこ？ どこにいるの？」"
  },
  {
   "id": "clka11:23500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どこにもいないよ」"
  },
  {
   "id": "clka11:23600",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あたしは、最初からどこにもいない」"
  },
  {
   "id": "clka11:23700",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「今は、あんたの心の中に戻った所。そしてもうすぐ消える」"
  },
  {
   "id": "clka11:23800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あんたが素直に自分の気持ちを話せる間は、もう出て来たりしない」"
  },
  {
   "id": "clka11:23900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だから、あたしが出てこなくていいように、がんばんな」"
  },
  {
   "id": "clka11:24000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……ん」"
  },
  {
   "id": "clka11:24100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「頑張る」"
  },
  {
   "id": "clka11:24200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よろしい！」"
  },
  {
   "id": "clka11:24300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どう？ 今の気持ちは」"
  },
  {
   "id": "clka11:24400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……正直に言うと」"
  },
  {
   "id": "clka11:24500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……滅茶苦茶、恥ずかしい……！」"
  },
  {
   "id": "clka11:24600",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あはっ！」"
  },
  {
   "id": "clka11:24700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "『華』が噴き出した。目尻から零れた涙を拭っているのが想像できた。"
  },
  {
   "id": "clka11:24800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうだよね。わかるよ」"
  },
  {
   "id": "clka11:24900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「でもね、このあともっと恥ずかしいことになるから、気絶しないようにね」"
  },
  {
   "id": "clka11:25000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？」"
  },
  {
   "id": "clka11:25100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ごめんね、あたし、あんたに嘘をついてたの」"
  },
  {
   "id": "clka11:25200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？」"
  },
  {
   "id": "clka11:25300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ここには誰もいないって言ったでしょ」"
  },
  {
   "id": "clka11:25400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あれ、嘘なの」"
  },
  {
   "id": "clka11:25500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……え？」"
  },
  {
   "id": "clka11:25600",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「奥の方、見てごらん」"
  },
