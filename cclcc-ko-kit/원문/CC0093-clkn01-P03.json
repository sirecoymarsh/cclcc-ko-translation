  },
  {
   "id": "clkn01:20600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そうか。"
  },
  {
   "id": "clkn01:20700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "でも、だからっていつまでも部屋に籠ってるわけにもいかないだろうに。"
  },
  {
   "id": "clkn01:20800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
