   "next_speaker": "미야시로 타쿠루",
   "jp": "「うん。乃々姉に何か用？」"
  },
  {
   "id": "clkn01:20000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "「用ってわけじゃないけど……」"
