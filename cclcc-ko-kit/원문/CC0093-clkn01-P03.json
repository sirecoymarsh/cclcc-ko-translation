   "id": "clkn01:27600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "모두",
   "next_speaker": "타치바나 유이",
   "jp": "久しぶりの青葉寮での夕飯は、カレーライスだった。"
  },
  {
   "id": "clkn01:27700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "모두",
   "next_speaker": "타치바나 유이",
   "jp": "こんなに野菜がゴロゴロ入ってるカレーも、久しぶりだ。"
  },
  {
   "id": "clkn01:27800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "모두",
   "next_speaker": "타치바나 유이",
   "jp": "その辺のカレーショップだと、具は入ってないもんな。"
  },
  {
   "id": "clkn01:27900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "모두",
   "next_speaker": "타치바나 유이",
   "jp": "スプーンで掬ってひと口含む。"
  },
  {
   "id": "clkn01:28000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "모두",
   "next_speaker": "타치바나 유이",
   "jp": "その時、じっと僕を見つめる視線に気づいた。"
  },
  {
   "id": "clkn01:28100",
   "type": "dialogue",
   "speaker": "橘結衣",
