  },
  {
   "id": "clkn01:20900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "「ちょっと行ってくる」"
  },
  {
   "id": "clkn01:21000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
