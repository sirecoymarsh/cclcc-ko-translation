  {
   "id": "clkn01:21100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "うきの笑顔に見送られ、僕は乃々の部屋に向かった。"
  },
  {
   "id": "clkn01:21200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ドアをノックすると、部屋の中からは確かに人の気配がした。"
