  {
   "id": "clkn01:20100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "帰って来いってせっついたくせに、戻ったら戻ったで部屋に籠って出てこないってのも、なんか釈然としない。"
  },
  {
   "id": "clkn01:20200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「乃々さん、もしかしたら、出て来づらいのかも……」"
  },
  {
   "id": "clkn01:20300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "야마조에 우키",
   "jp": "うきがポソリと言った。"
  },
  {
   "id": "clkn01:20400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だって、ほら……乃々さん家では……」"
  },
  {
   "id": "clkn01:20500",
   "type": "dialogue",
   "speaker": "宮代拓留",
