   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "夢、か……。"
  },
  {
   "id": "clkn08:300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それにしても、変な夢だった。"
  },
  {
   "id": "clkn08:400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "しかも妙なリアリティがあった気がする。"
  },
  {
   "id": "clkn08:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "特にあの泣き声。"
  },
  {
   "id": "clkn08:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そうそう、あの赤ん坊の泣き声といったら、特にリアルだった。"
  },
  {
   "id": "clkn08:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その証拠に、こうして今も耳について離れない。"
  },
  {
   "id": "clkn08:800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "離れな……。"
  },
  {
   "id": "clkn08:900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "미나미사와 센리",
   "jp": "「…………」"
  },
  {
   "id": "clkn08:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미나미사와 센리",
   "jp": "違う！"
  },
  {
   "id": "clkn08:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미나미사와 센리",
   "jp": "この泣き声は夢の続きなんかじゃない。"
  },
  {
   "id": "clkn08:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미나미사와 센리",
   "jp": "⟦rb⟧現実⟦rt⟧リアル⟦/r⟧に聴こえている声だ。"
  },
  {
   "id": "clkn08:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미나미사와 센리",
   "jp": "僕は慌ててベッドから降りると、泣き声の聞こえる場所を求めて部屋を飛び出した。"
  },
  {
   "id": "clkn08:1400",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留……」"
  },
  {
   "id": "clkn08:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "リビングに入ると、まだ朝も早くだというのに、僕以外の全員が顔をそろえていた。"
  },
  {
   "id": "clkn08:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "全員が輪のようになって何かを取り囲んでいる。"
  },
  {
   "id": "clkn08:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "泣き声はその中心から聞こえていた。"
  },
  {
   "id": "clkn08:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "覗き込むとそこには――。"
  },
  {
   "id": "clkn08:1900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「赤ん坊……」"
  },
  {
   "id": "clkn08:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その鳴き声から想像したとおり、小さな生き物が顔をくしゃくしゃにして泣いていた。"
  },
  {
   "id": "clkn08:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「どうしたんだよ、この赤ちゃん。もしかして……泉理の子か？」"
  },
  {
   "id": "clkn08:2200",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「バカっ。そんなわけないでしょ」"
  },
  {
   "id": "clkn08:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "야마조에 우키",
   "jp": "だよな……。"
  },
  {
   "id": "clkn08:2400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「今朝早く、うちの前に置かれていたんです。この手紙と一緒に」"
  },
  {
   "id": "clkn08:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "うきが差し出した手紙に目を通す。"
  },
  {
   "id": "clkn08:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "筆跡から見るに、女の人だろう。"
  },
  {
   "id": "clkn08:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そこには『この子をお願いします。名前はひかりです』とだけ書かれていた。"
  },
  {
   "id": "clkn08:2800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "사쿠마 와타루",
   "jp": "「置き去り……か……」"
  },
  {
   "id": "clkn08:2900",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "「生後三か月といったところだな」"
  },
  {
   "id": "clkn08:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유토",
   "jp": "この青葉寮に僕をはじめとした身寄りのない子どもが大勢いることを知っていたのか、それともたまたまなのか。"
  },
  {
   "id": "clkn08:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유토",
   "jp": "とにかく、赤ん坊を産んだはいいけれど、世話に困った誰かが置いていったんだろう。"
  },
  {
   "id": "clkn08:3200",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「まだこんなに小さな子なのに、ひどいよ……」"
  },
  {
   "id": "clkn08:3300",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "「そうだな。だが、まだこの手紙を書いた母親が戻って来ねえと決まったわけじゃねぇ」"
  },
  {
   "id": "clkn08:3400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「そうなの？」"
  },
  {
   "id": "clkn08:3500",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ああ。こういう場合、後になって後悔して戻って来る例も少なくはないからな」"
  },
  {
   "id": "clkn08:3600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "야마조에 우키",
   "jp": "「そうだね。それにこの赤ちゃんの着てるものを見てみなよ。なかなか良い服を着せてもらってる」"
  },
  {
   "id": "clkn08:3700",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「言われてみればそうですね」"
  },
  {
   "id": "clkn08:3800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「それに、かなり暖かそうな格好もさせてるだろ？ ってことは、愛情が無いってわけじゃなさそうだ」"
  },
  {
   "id": "clkn08:3900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「だから、もしかしたら戻って来るかもしれない」"
  },
  {
   "id": "clkn08:4000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「だったらいいんだけど……」"
  },
  {
   "id": "clkn08:4100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "사쿠마 와타루",
   "jp": "結衣と結人はその話を聞いて、ようやく少しだけ安心したような笑みを浮かべた。"
  },
  {
   "id": "clkn08:4200",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미나미사와 센리",
   "jp": "「で、この赤ん坊だが……」"
  },
  {
   "id": "clkn08:4300",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「もちろん、しばらく家で世話することにします」"
  },
  {
   "id": "clkn08:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "まあ、そうなるだろうとは思ったけど。"
  },
  {
   "id": "clkn08:4500",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「というわけで、父さん。しばらくお酒代減らすわね」"
  },
  {
   "id": "clkn08:4600",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「な、なんでそうなる！」"
  },
  {
   "id": "clkn08:4700",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「だって、ミルク代がいるもの。少しは我慢してもらわないと」"
  },
  {
   "id": "clkn08:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "사쿠마 와타루",
   "jp": "きっぱり言われ、父さんは肩をすくめた。"
  },
  {
   "id": "clkn08:4900",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「今でも減らしてるんだがなぁ……」"
  },
  {
   "id": "clkn08:5000",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それから拓留。できれば、今日から少しの間でいいの。⟦rb⟧青葉寮⟦rt⟧ここ⟦/r⟧で暮らしてもらえないかな？」"
  },
  {
   "id": "clkn08:5100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「ここで？ どうして？」"
  },
  {
   "id": "clkn08:5200",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「何かと物入りになるし、できれば男手が欲しいの」"
  },
  {
   "id": "clkn08:5300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "사쿠마 와타루",
   "jp": "「父さんがいるだろ」"
  },
  {
   "id": "clkn08:5400",
   "type": "dialogue",
