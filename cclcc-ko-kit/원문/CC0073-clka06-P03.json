 "context_before": [
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「期限は今日一日。正確には、眠るまでの間。明日目が覚めれば、あたしは綺麗さっぱりいなくなってますんで、その辺については御心配なきよう」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「だから、てっとりばやく宮代先輩としちゃおうと思って、呼びだしたんです」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「てっとりばやくって、お前な……！？」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「ね、そういうわけですから」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "僕の抗議を聞いてないのか、聞こえないふりをしてるのか、この香月ではない香月は、トコトコと僕の傍に歩み寄り、首を傾げて微笑んだ。"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「華の夢を叶えてあげてくださいよ。宮代先輩」"
  }
 ],
 "entries": [
  {
