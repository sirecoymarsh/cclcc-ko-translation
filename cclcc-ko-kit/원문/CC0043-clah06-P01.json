   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "わかってないんじゃないか。"
  },
  {
   "id": "clah06:2400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうそう！ 火を噴いたり手足が伸びるようになったり！」"
