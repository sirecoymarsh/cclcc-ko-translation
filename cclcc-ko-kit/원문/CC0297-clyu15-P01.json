 "context_before": [],
 "entries": [
  {
   "id": "clyu15:0",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": null,
   "next_speaker": "카즈키 하나",
   "jp": "「ねえ、聞いたよ、タク！ 結衣ちゃんたち、イベントのオファー来たんだって？」"
  },
  {
   "id": "clyu15:100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「すごい……かも……」"
  },
  {
   "id": "clyu15:200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "尾上と香月にそう声をかけられたのは、配信を再開してからまた一週間ほどが経った頃の放課後のことだった。"
  },
  {
   "id": "clyu15:300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「なんだ。尾上にしては、珍しく情報が早いな」"
  },
  {
   "id": "clyu15:400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "「うー、私だってそのくらい知ってるもん」"
  },
  {
   "id": "clyu15:500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……クラスでも時々、話題に上ってる……かも……」"
  },
  {
   "id": "clyu15:600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「へえ……」"
  },
  {
   "id": "clyu15:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "あれから⟦col:280aa02d1400⟧ニヤ生⟦col:800000⟧の配信を再開するようにもなって、ユイとユウの人気はさらなるものとなった。"
  },
  {
   "id": "clyu15:800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "さすがにふたりとも前の一件で懲りたのか、ニヤ生に関しては視聴者の過度な要望に応えたり奇をてらったりすることはせず、あくまでも真摯に視聴者と向き合うようになった。"
  },
  {
   "id": "clyu15:900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "その様子を見ている限り大丈夫だと判断した僕は、今ではある程度の頻度でのニヤ生の配信を任せてもいた。"
  },
  {
   "id": "clyu15:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "ふたりの素朴で擦れてない受け答えが受けたらしく、際どいことなんかしなくとも、驚くほどに視聴者の数は増え、ついには尾上が言ったように、いくつかのオファーが来るようにもなっていた。"
  },
  {
   "id": "clyu15:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "正直、ここまで望みどおりに展開するとは思ってもなかった僕たちは、ただただ現状に驚くだけだった。"
  },
  {
   "id": "clyu15:1200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「で、どうするの？ イベントでるの？」"
  },
  {
   "id": "clyu15:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "「どうしようか迷ってる。イベントって言ったって、まだ自分たちの曲があるわけじゃないし、それに……」"
  },
  {
   "id": "clyu15:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "会話を遮るように、ポケットの中のスマホが震えた。"
  },
  {
   "id": "clyu15:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "メールの差出人は、知らないメアドからだった。"
  },
  {
   "id": "clyu15:1600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "「……え？」"
  },
  {
   "id": "clyu15:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "そのメールの内容を目にした僕は、思わず声を上げてしまった。"
  },
  {
   "id": "clyu15:1800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ん……？」"
  },
  {
   "id": "clyu15:1900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「……⟦col:280aa02d1400⟧メジャーデビュー⟦col:800000⟧……」"
  },
  {
   "id": "clyu15:2000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なにそれ？」"
  },
  {
   "id": "clyu15:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「ふ、ふたりにＣＤ出さないかって！！ しかも、テレビ出演の依頼も！」"
  },
  {
   "id": "clyu15:2200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えっと……それって凄いんだよね？」"
  },
  {
   "id": "clyu15:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "카즈키 하나",
   "jp": "「凄いに決まってるだろ！ メジャーデビューだぞ？ 全国のショップにＣＤが並ぶんだぞ？」"
  },
  {
   "id": "clyu15:2400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ビックリ……かも……」"
  },
  {
   "id": "clyu15:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この誘いを断る理由なんてない。"
  },
  {
   "id": "clyu15:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "これが上手くいけば、ふたりはスターダムにのしあがり、僕たちは大金持ち！"
  },
  {
   "id": "clyu15:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "当然⟦col:280aa02d1400⟧プロデューサー⟦col:800000⟧である僕も、一躍有名人の仲間入りだ！"
  },
  {
   "id": "clyu15:2800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "「ん……？」"
  },
  {
   "id": "clyu15:2900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どしたの？」"
  },
  {
   "id": "clyu15:3000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "유이",
   "jp": "「どうやら、ふたりが配信をはじめたみたいだ」"
  },
  {
   "id": "clyu15:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "유이",
   "jp": "配信開始を知らせる通知を受け、⟦col:280aa02d1400⟧アプリ⟦col:800000⟧を開いてみると、見慣れた部屋の中で並んだふたりの姿が映し出された。"
  },
  {
   "id": "clyu15:3200",
   "type": "dialogue",
   "speaker": "ユイ",
   "speaker_ko": "유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "유",
   "jp": "「やっほー。みなさん、こんにちはー、『⟦col:280aa02d1400⟧ミルフィーユ⟦col:800000⟧』ユイでーっす」"
  },
  {
   "id": "clyu15:3300",
   "type": "dialogue",
   "speaker": "ユウ",
   "speaker_ko": "유",
   "prev_speaker": "유이",
   "next_speaker": "유이",
   "jp": "「ミルフィーユ、ユウだよ」"
  },
  {
   "id": "clyu15:3400",
   "type": "dialogue",
   "speaker": "ユイ",
   "speaker_ko": "유이",
   "prev_speaker": "유",
   "next_speaker": "유",
   "jp": "「そういえば、もうすぐクリスマスだよねー」"
  },
  {
   "id": "clyu15:3500",
   "type": "dialogue",
   "speaker": "ユウ",
   "speaker_ko": "유",
   "prev_speaker": "유이",
   "next_speaker": "오노에 세리카",
   "jp": "「あ、この前、学校から帰るとき、もうクリスマスの飾りつけしてたよね。ほら、ヒカ――」"
  },
  {
   "id": "clyu15:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "유",
   "next_speaker": "오노에 세리카",
   "jp": "とりあえず無事配信されているのを確認して、僕はアプリを閉じた。"
  },
  {
   "id": "clyu15:3700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "유",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……見ないの？」"
  },
  {
   "id": "clyu15:3800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「ふたりともそろそろ慣れて来てるし、大丈夫だよ」"
  },
  {
   "id": "clyu15:3900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「それよりも、僕はプロデューサーとして、これからの活動方針を決めなきゃいけないからな」"
  },
  {
   "id": "clyu15:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "なんと言ってもメジャーデビューだ。これまでのニヤ生での活動とはわけが違う。"
  },
  {
   "id": "clyu15:4100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "これから売り込み用のプロフィールも作らなきゃならないだろうし、ＣＤを出すにあたって作曲や作詞を誰にしてもらうかの要望なんかも必要だろう。"
  },
  {
   "id": "clyu15:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "きちんとした宣材写真も撮らなければ。"
  },
  {
   "id": "clyu15:4300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「そんなわけだから、部活の方はみんなに任せる！ あとはよろしく！」"
  },
  {
   "id": "clyu15:4400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う？ え、あ、ちょっとタク！？」"
  },
  {
   "id": "clyu15:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こうしちゃいられない！"
  },
  {
   "id": "clyu15:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "これから、忙しくなってくるぞ！"
  },
  {
   "id": "clyu15:4700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "「ふう……」"
  },
  {
   "id": "clyu15:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "風呂から上がると、一日の疲れが洗い流されたようだった。"
  },
  {
   "id": "clyu15:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "帰ってからも、これからのプランを練ったりメールの返事を書いたり。"
  },
  {
   "id": "clyu15:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "それから、近いところでメジャーデビュー発表のためのニヤ生も調整しなければいけない。"
  },
  {
   "id": "clyu15:5100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "さすがにそれはふたりだけに任せるわけにもいかないから、きちんと僕が立ち会った上で行う必要がある。"
  },
  {
   "id": "clyu15:5200",
   "type": "narration",
