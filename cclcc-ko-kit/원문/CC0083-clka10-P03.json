   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "押しつけられている二つの柔らかな物体は、確かに、それぞれの中心あたりに、少し突起があるように感じた。"
  },
  {
   "id": "clka10:23700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「こ、これが！！！」"
