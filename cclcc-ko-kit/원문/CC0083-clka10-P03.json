  {
   "id": "clka10:24400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "……なにを馬鹿なことを考えているんだ、僕は。"
