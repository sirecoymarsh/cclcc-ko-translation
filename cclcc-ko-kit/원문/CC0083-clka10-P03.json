   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そして背中に手を回し、水着のトップの後ろの紐をするするとほどき、そのまま床に落とした。"
  },
  {
   "id": "clka10:21500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「なっ！？」"
