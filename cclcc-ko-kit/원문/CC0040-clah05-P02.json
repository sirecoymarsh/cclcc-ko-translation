   "prev_speaker": "아리무라 히나에",
   "next_speaker": null,
   "jp": "くそっ！！"
  },
  {
   "id": "clah05:10700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "見ないようにしようと思えば思うほど、つい視線がそちらへ向いてしまう！！"
  },
  {
   "id": "clah05:10800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "これじゃあ、有村の思うツボだ。"
  },
  {
   "id": "clah05:10900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "よし、考え方を変えよう。"
  },
  {
   "id": "clah05:11000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そうだ。そもそも水着というのはなんだ？"
  },
  {
   "id": "clah05:11100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "水着というものは、ただ水に入るという目的のために作られた服――ようするに、見られることを前提として作られたものだ。"
  },
  {
   "id": "clah05:11200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "本来見られるべきでないものを目にした時、初めて人は悦びを感じるものじゃないのか？"
  },
  {
   "id": "clah05:11300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ということは水着なんて、多少露出が高いか低いかというだけで、普段着ている制服や私服と何も変わらないただの水中用衣服じゃないか。"
  },
  {
   "id": "clah05:11400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "そもそも、見られることを前提としたものを見て、気分が高揚するというのもおかしな話だ。"
  },
  {
   "id": "clah05:11500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "아리무라 히나에",
   "jp": "「…………」"
  },
  {
   "id": "clah05:11600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "うん。だんだんと落ち着いてきたぞ。"
  },
  {
   "id": "clah05:11700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "今なら有村の姿を見たって――。"
  },
  {
   "id": "clah05:11800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はい、できましたよ〜」"
  },
  {
   "id": "clah05:11900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "有村ができたての料理が乗った皿を手に近づいてきた。"
  },
  {
   "id": "clah05:12000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "いつの間に取ったのか、さっきまで身に着けていたエプロンはもうない。"
  },
  {
   "id": "clah05:12100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うふっ♪」"
  },
  {
   "id": "clah05:12200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "な、なかなかに際どい水着姿だ。"
  },
  {
   "id": "clah05:12300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "さっきまでの僕なら、視線の持っていきどころがなく、しどろもどろになっていたことだろう。"
  },
  {
   "id": "clah05:12400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "けれど今の僕にとってそれは、ただの衣服。"
  },
  {
   "id": "clah05:12500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "つまり、普段の格好となんら変わらないのだ。"
  },
  {
   "id": "clah05:12600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「有村」"
  },
  {
   "id": "clah05:12700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうしました？ もしかしてギブアップですか？」"
  },
  {
   "id": "clah05:12800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「寒くないか？」"
  },
  {
   "id": "clah05:12900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「え？」"
  },
  {
   "id": "clah05:13000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「いつまでもそんな格好でいると風邪ひくぞ」"
  },
  {
   "id": "clah05:13100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……そ、そんなこと言って、誤魔化してもダメっすよ」"
  },
  {
   "id": "clah05:13200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「僕は別に誤魔化してなんかない。ただ、寒いだろうから服を着たほうがいいんじゃないかと思っただけだ」"
  },
  {
   "id": "clah05:13300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふ〜ん、そうですか。でも、私はこのままでも……くちゅっ！」"
  },
  {
   "id": "clah05:13400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「ほらみろ」"
  },
  {
   "id": "clah05:13500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "いくらこの中が多少あったかいって言っても、暦の上ではもう１１月だ。"
  },
  {
   "id": "clah05:13600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "水着姿じゃ冷えるに違いない。"
  },
  {
   "id": "clah05:13700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うぅ……じゃ、こうしましょう。先輩が雛絵ちゃんにドキドキラブハートだって言うなら服を着ます」"
  },
  {
   "id": "clah05:13800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「……それを言えばいいのか？」"
  },
  {
   "id": "clah05:13900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う……」"
  },
  {
   "id": "clah05:14000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「言えばいいんだな？ だったら……」"
  },
  {
   "id": "clah05:14100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「タンマタンマ！ やっぱいいです！ わかりました。今日は大人しく服着ます……」"
  },
  {
   "id": "clah05:14200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ほっ……。"
  },
  {
   "id": "clah05:14300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "と、胸をなで下ろした僕の耳に、何やらポコポコと鈍い音が聞こえてきた。"
  },
  {
   "id": "clah05:14400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「ん？ なんだ、この音」"
  },
  {
   "id": "clah05:14500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ！ いっけない。そういえばもう一品温めてたんだ！」"
  },
  {
   "id": "clah05:14600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "衣服を手に洗面所に向かおうとしていた有村が、慌てて流しに向かう。"
  },
  {
   "id": "clah05:14700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "危ないな。あのまま忘れてたら、火事にでもなるところだ。"
  },
  {
   "id": "clah05:14800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "（それにしても……女子の水着って、心もとないよな。あんなに細い紐で、外れたりしたら……）"
  },
  {
   "id": "clah05:14900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "有村の後ろ姿を見ながらそんなことを考えていると、やがて彼女は湯気の立った小さな両手鍋を手にぱたぱたと歩み寄り……。"
  },
  {
   "id": "clah05:15000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "そして――。"
  },
  {
   "id": "clah05:15100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はいはーい、テーブル空けてくださぁ――うおっ！」"
  },
  {
   "id": "clah05:15200",
   "type": "narration",
