   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "――長い人生の中で、封印していた⟦col:280aa02d1400⟧黒歴史⟦col:800000⟧が唐突に脳裏に蘇り、叫ぶ他になにもできなくなってしまう事はないだろうか。"
  },
  {
   "id": "clka08:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "今の僕がまさにその状態だった。"
  },
  {
   "id": "clka08:200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "오노에 세리카",
   "jp": "「うあああああっ！？」"
  },
  {
   "id": "clka08:300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "「きゃっ！？」"
  },
  {
   "id": "clka08:400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留！？ 突然どうしたのよ？」"
  },
  {
   "id": "clka08:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "突然叫んだ僕を尾上や来栖が驚いて見つめている。"
  },
  {
   "id": "clka08:600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "「なななななななんでもない。まったくもってなんらかわらず寸分違わずいつも通りの僕だ」"
  },
  {
   "id": "clka08:700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あからさまにおかしいですね……」"
  },
  {
   "id": "clka08:800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카즈키 하나",
   "jp": "「……香月、ちょっと二人だけで話がある。廊下に来てくれ」"
  },
  {
   "id": "clka08:900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうこなくっちゃ！」"
  },
  {
   "id": "clka08:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "外に出るなり僕は香月に向かって叫んだ。と言っても、部室の中にいる彼らに聞こえないように小声で。"
  },
  {
   "id": "clka08:1100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「どうしてこの雑誌が写ってるんだ！？」"
  },
  {
   "id": "clka08:1200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「この雑誌って？ なんのこと？」"
  },
  {
   "id": "clka08:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「だから、これだよ！」"
  },
  {
   "id": "clka08:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "エロ自撮り写真をピンチで拡大し、ベッドに置かれた⟦col:280aa02d1400⟧クールキャットプレス⟦col:800000⟧を大写しにする。"
  },
  {
   "id": "clka08:1500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「このクールキャットプレス！」"
  },
  {
   "id": "clka08:1600",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「これがどうかしたの？」"
  },
  {
   "id": "clka08:1700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「……え？」"
  },
  {
   "id": "clka08:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その途端、僕の中で別の可能性が芽生えた。"
  },
  {
   "id": "clka08:1900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "これは、香月が偶然持っていたクールキャットプレスで、僕が引き出しの下に隠した物とは無関係という可能性だ。"
  },
  {
   "id": "clka08:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "冷静に考えればそんな都合の良い偶然があるわけないのだけれど、僕は一縷の望みにかけた。"
  },
  {
   "id": "clka08:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「え、ええとだな、ここここ、この雑誌は、おおおお、お前が持ってきた物なんだな？ そうだと言ってくれるな？」"
  },
  {
   "id": "clka08:2200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「そうだと言ってくれ！」"
  },
  {
   "id": "clka08:2300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「『香月のおっぱいの大きさは暴力的であり、もし彼女がエロ方面に積極性のある肉食系女子だったら――』」"
  },
  {
   "id": "clka08:2400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「ああああああああああ！！！！！！！」"
  },
  {
   "id": "clka08:2500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「じゃじゃじゃじゃ、じゃあ、この、雑誌は……！！！？？？」"
  },
  {
   "id": "clka08:2600",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はい。引き出しの下の隙間から見つけました」"
  },
  {
   "id": "clka08:2700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「やっぱり……！」"
  },
  {
   "id": "clka08:2800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「華は、単にお疲れ様会に興味がないから、部活動が終わった時点で家に帰ったんです」"
  },
  {
   "id": "clka08:2900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「けれど、家に帰ってから、キャンピングカーにスマホを忘れたことに気付いて、夕飯を済ませてから取りに戻ったんです」"
  },
  {
   "id": "clka08:3000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「着いた頃には伊藤先輩も宮代先輩も寝ちゃってたんですけど、鍵は開いてたから勝手に入りました」"
  },
  {
   "id": "clka08:3100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「スマホはすぐに見つかったんですけど、充電が切れてて。ちょっとだけ電源を借りて充電させてもらってたんです」"
  },
  {
   "id": "clka08:3200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「で、華はせっかく男の子の部屋に来たんだから、なんか面白い物ないかなと思って」"
  },
  {
   "id": "clka08:3300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「適当に引き出し開けてたらたまたま見つけたのがあの雑誌だったというわけです」"
  },
  {
   "id": "clka08:3400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「そそそそ、それで、その雑誌は今どこに？」"
  },
  {
   "id": "clka08:3500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「僕が目が覚めた時、ベッドの上にはなにもなかったぞ」"
  },
  {
   "id": "clka08:3600",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「もちろん、持って帰りました」"
  },
  {
   "id": "clka08:3700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「なっ！！？？」"
  },
  {
   "id": "clka08:3800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「一応本人の名誉のために言っておくと、持ち帰ったのは華じゃなくてあたし、『華』の方です」"
  },
  {
   "id": "clka08:3900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「宮代先輩的には運が無かっただけです。たまたま丁度良いタイミングであたしが具現化されちゃっただけ」"
  },
  {
   "id": "clka08:4000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「こんな面白い物があるなら利用しなくちゃもったいないと思って、持って帰っちゃいました」"
  },
  {
   "id": "clka08:4100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「嘘……だろ……」"
  },
  {
   "id": "clka08:4200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「……いや待ってくれ」"
  },
  {
   "id": "clka08:4300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんでしょう？」"
  },
  {
   "id": "clka08:4400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「『利用しなくちゃ』って言ったな？ 今」"
  },
  {
   "id": "clka08:4500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「どういう、意味だ？」"
  },
  {
   "id": "clka08:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "僕は聞いても無駄な事を、敢えて聞いた。"
  },
  {
   "id": "clka08:4700",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「宮代先輩、頭いいんだから、聞かなくても分かってると思うんですけど」"
  },
  {
   "id": "clka08:4800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「まあいいです」"
  },
  {
   "id": "clka08:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "香月の身体の中にいる『華』は、唇に指をあてて、色っぽく僕にウィンクした。"
  },
  {
   "id": "clka08:5000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「交渉材料、です♪」"
  },
  {
