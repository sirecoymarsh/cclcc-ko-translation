   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留も、きちんと面倒みてくれてたんでちゅね〜。えらいえらい」"
