   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "さっきまで涙をぽろぽろ零していたひかりは、声を上げて笑った。"
  },
  {
   "id": "clkn09:6700",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「笑った！ ほら、笑ったぞ！！ ははっ、どうだ、参ったか！」"
  },
  {
   "id": "clkn09:6800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "いったい何と戦ってるというんだろう、彼女は。"
  },
  {
   "id": "clkn09:6900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "とはいえ、赤ん坊相手に一喜一憂する姿は、見ていて面白い。"
  },
  {
   "id": "clkn09:7000",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "「おい、お前。今のうちにたくさんの事を見聞きするんだぞ」"
  },
  {
   "id": "clkn09:7100",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「人間の脳の８割は、⟦col:280aa02d1400⟧乳児期⟦col:800000⟧に出来上がるというからな」"
  },
  {
   "id": "clkn09:7200",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「優秀な脳に育つがいい。そうすれば私の研究材料くらいにはしてやる」"
  },
  {
   "id": "clkn09:7300",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「お、また笑ったな。なかなか聞き分けの良い奴だ」"
  },
  {
   "id": "clkn09:7400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠루스 노노",
   "jp": "最初こそ戦々恐々という感じだったが、そんな様子も既にどこかへ消えてしまっていた。"
  },
  {
   "id": "clkn09:7500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠루스 노노",
   "jp": "久野里さんって、意外と子ども好きだったりするのかもしれない。"
  },
  {
   "id": "clkn09:7600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「へぇ。そんなことがあったの」"
  },
  {
   "id": "clkn09:7700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ああ、なかなか見物だったよ」"
  },
  {
   "id": "clkn09:7800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あの久野里さんに、そんな一面があるなんて。私も見てみたかったな」"
  },
  {
   "id": "clkn09:7900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "神成さんと久野里さんが帰った後戻ってきた乃々に、僕は一部始終を話して聞かせた。"
  },
  {
   "id": "clkn09:8000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "ちなみに、どうして彼女が乃々の姿でいるかというと、別に外に出かけていたからじゃない。"
  },
  {
   "id": "clkn09:8100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "泉理の姿でいる時と乃々の姿でいる時、その時々でひかりの機嫌が変わるということがわかったからだ。"
  },
  {
   "id": "clkn09:8200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "つまり、いまは乃々タイムというわけ。"
  },
  {
   "id": "clkn09:8300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふふっ。でも、留守にしてる間もちゃあんと良い子にしてたんでちゅね〜。いいこいいこ〜」"
  },
