  "신조 타케시",
  "쿠노사토 미오",
  "쿠루스 노노"
 ],
 "context_before": [],
 "entries": [
  {
   "id": "clkn09:0",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "신조 타케시",
   "jp": "うちに赤ん坊がやってきて二日目。"
  },
  {
   "id": "clkn09:100",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なるほどね。話はわかったが……」"
  },
  {
   "id": "clkn09:200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "신조 타케시",
   "jp": "神成さんに連絡してみると、すぐ近くにいるということだったので、青葉寮まで来てもらった。"
  },
  {
   "id": "clkn09:300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "신조 타케시",
   "jp": "もちろん用件はひかりの母親捜しについてだ。"
  },
  {
   "id": "clkn09:400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "신조 타케시",
   "jp": "だが、反応は⟦rb⟧芳⟦rt⟧かんば⟦/r⟧しいものではなかった。"
  },
  {
   "id": "clkn09:500",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「一応、担当の部署に訊いてはみる。でも、あまり期待しないでくれ」"
  },
  {
   "id": "clkn09:600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "신조 타케시",
   "next_speaker": "신조 타케시",
   "jp": "「そう……ですか」"
  },
  {
   "id": "clkn09:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "신조 타케시",
   "jp": "母親が何かの犯罪に巻き込まれた、あるいは、赤ん坊がどこかの病院から連れ去られたというならまだしも、自発的に子どもを置いていったとなれば事件性は乏しい。"
  },
  {
   "id": "clkn09:800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "신조 타케시",
   "jp": "母親の名前なり、あるいは姿格好なり、何らかの手掛かりがあれば話も違うのかもしれないが、一切の手掛かりは無いのだから当然と言えば当然だ。"
  },
  {
   "id": "clkn09:900",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ま、そういうのはどちらかといえば警察よりも、百瀬さんの案件だからな」"
  },
  {
   "id": "clkn09:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "미야시로 타쿠루",
   "jp": "百瀬さんというのは、僕や神成さんの共通の知り合いで、⟦col:280aa02d1400⟧興信所⟦col:800000⟧を経営している百瀬克子さんのことだ。"
  },
  {
   "id": "clkn09:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "미야시로 타쿠루",
   "jp": "本来なら相談してみたいところだが、あの人も仕事だ。"
  },
  {
   "id": "clkn09:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "미야시로 타쿠루",
   "jp": "タダで頼むというわけにはいかないだろう。"
  },
  {
   "id": "clkn09:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "미야시로 타쿠루",
   "jp": "となると、うちの家計的に依頼するのは厳しい。"
  },
  {
   "id": "clkn09:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "미야시로 타쿠루",
   "jp": "他の方法を考えるしかなさそうだ。"
  },
  {
   "id": "clkn09:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それにそんなことよりも――。"
  },
  {
   "id": "clkn09:1600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "신조 타케시",
   "next_speaker": "쿠노사토 미오",
   "jp": "「どうして、あなたまでが来てるんですか、久野里さん」"
  },
  {
   "id": "clkn09:1700",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんだ、客に向かって失礼だな、君は」"
  },
  {
   "id": "clkn09:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "客もなにも、呼んだ覚えすらないんだけど。"
  },
  {
   "id": "clkn09:1900",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なに。ちょうどそこの刑事と一緒にいる時に、面白そうな話が入ってきたものでな」"
  },
  {
   "id": "clkn09:2000",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「せっかくだから、子育てに悪戦苦闘する男子学生の姿を見てやろうと思ったんだよ」"
  },
  {
   "id": "clkn09:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「やめてくださいよ、見世物じゃないんだから」"
  },
  {
   "id": "clkn09:2200",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それにしても、この子はさっきから寝てばかりじゃないか。ちっともお前が悪戦苦闘する様を見られやしない」"
  },
  {
   "id": "clkn09:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "今は乃々が買い物に出かけている最中だ。"
  },
  {
   "id": "clkn09:2400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "赤ん坊用品はあらかた買い集めたと思っていたけど、後から後から“あれがあるといい”とか”あんなのがあると助かる”とかが出てくる。"
  },
  {
   "id": "clkn09:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "それに、僕たちの日々のご飯の材料なんかも買わなきゃいけない。"
  },
  {
   "id": "clkn09:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "ひかりが大人しく眠っているタイミングを見計らって、乃々が買い物に出たところに、入れ替わりで神成さんたちが来たというわけだ。"
  },
  {
   "id": "clkn09:2700",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふむ……しかし、赤ん坊と言うのは興味深い生き物だな。それに……」"
  },
  {
   "id": "clkn09:2800",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんだ、この柔らかさは？ 自然界において、これだけ柔らかくて滑らかなものはそうそう無いぞ」"
  },
  {
   "id": "clkn09:2900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そう言いながら、久野里さんはひかりの頬っぺたをつんつんと突いている。"
  },
  {
   "id": "clkn09:3000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「ああ、ちょっと、そんな風に触ったら――」"
  },
  {
   "id": "clkn09:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠노사토 미오",
   "jp": "ほら、言わんこっちゃない。"
  },
  {
   "id": "clkn09:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠노사토 미오",
   "jp": "せっかく気持ちよさそうに寝ていたのに。"
  },
  {
   "id": "clkn09:3300",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「お、おい！ 宮代！ 泣き出してしまったぞ。どうにかしてくれ」"
  },
  {
   "id": "clkn09:3400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「久野里さんが泣かせたんだから、久野里さんが何とかしてくださいよ」"
  },
  {
   "id": "clkn09:3500",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "신조 타케시",
   "jp": "「な、何とかって……どうすればいいんだ？」"
  },
  {
   "id": "clkn09:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "久野里さんにしては珍しく、縋るような目で僕と神成さんを交互に見た。"
  },
  {
   "id": "clkn09:3700",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「そ、そうだ。ちょっと署に電話しないといけないんだった、失礼」"
  },
  {
   "id": "clkn09:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "신조 타케시",
   "next_speaker": "쿠노사토 미오",
   "jp": "神成さんはそう言い残して、早々に逃げ出してしまった。"
  },
  {
   "id": "clkn09:3900",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "신조 타케시",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「っ……卑怯だぞ！ おい、宮代っ……ど、どうすれば……」"
  },
  {
   "id": "clkn09:4000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「抱っこしてあげたら泣きやむんじゃないですか」"
  },
  {
   "id": "clkn09:4100",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「抱っこ！？ この赤ん坊を、私が、か？」"
  },
  {
   "id": "clkn09:4200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「それ以外に誰がいるんですか」"
  },
  {
   "id": "clkn09:4300",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「お、お前がやってくれ、宮代っ」"
  },
  {
   "id": "clkn09:4400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「だから、久野里さんが泣かしたんでしょう」"
  },
  {
   "id": "clkn09:4500",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「っ……」"
  },
  {
   "id": "clkn09:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "恐る恐る、手を伸ばす久野里さん。"
  },
  {
   "id": "clkn09:4700",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だ、ダメだ！ 無理だ！ 私に出来るはずがないっ！」"
  },
  {
   "id": "clkn09:4800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「へぇ。久野里さんともあろう人が、僕にだって出来ることができないなんて……」"
  },
  {
   "id": "clkn09:4900",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「くっ……」"
  },
  {
   "id": "clkn09:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "미야시로 타쿠루",
   "jp": "負けん気に火が付いたのか、久野里さんは再びひかりに手を伸ばした。"
  },
  {
   "id": "clkn09:5100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
