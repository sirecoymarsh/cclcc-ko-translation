   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「こ、こんな遅くに誰だよ、って言ったんだ」"
  },
  {
   "id": "clah02:11200",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふーん……」"
  },
  {
   "id": "clah02:11300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "今ので誤魔化せた……か？"
  },
  {
   "id": "clah02:11400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……ま、いいや。上がるぞー」"
  },
  {
   "id": "clah02:11500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「ちょ、ちょっと待て！」"
  },
  {
   "id": "clah02:11600",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんでだ？ もしかして、上がられると困ることでもあんのか？」"
  },
  {
   "id": "clah02:11700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「あ、いや……そういうわけじゃ……」"
  },
  {
   "id": "clah02:11800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だったらいいよな？ お邪魔しまーす」"
  },
  {
   "id": "clah02:11900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "伊藤は返事も待たず、僕の横をすり抜けて、上がり込んでしまった。"
  },
  {
   "id": "clah02:12000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "そして、何やら室内をジロジロと眺めまわし始めた。"
  },
  {
   "id": "clah02:12100",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふむ……」"
  },
  {
   "id": "clah02:12200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それから、こんどは洗面所のドアを開けて中を確かめている。"
  },
  {
   "id": "clah02:12300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「な、なんだよ！？」"
  },
  {
   "id": "clah02:12400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "更には屈みこんで冷蔵庫の中まで。"
  },
  {
   "id": "clah02:12500",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「さすがにここは……ないか」"
  },
  {
   "id": "clah02:12600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「だから何なんだよ、さっきから！？」"
  },
  {
   "id": "clah02:12700",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふむ。安心した！ やっぱりお前は俺の親友だ、宮代！」"
  },
  {
   "id": "clah02:12800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "伊藤はすっくと立ちあがると、両手で僕の手をとり、激しく上下に振った。"
  },
  {
   "id": "clah02:12900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「いやぁ、部活中のお前の様子がおかしかっただろ？ やけに早く帰りたそうにしてたしさ」"
  },
  {
   "id": "clah02:13000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だからてっきり、この俺を差しおいて部屋に女子でも連れ込んで同棲でもしてんじゃねぇかって思ったんだけど、どこにも女の形跡なんかねーし、どうやら俺の杞憂だったみたいだ」"
  },
  {
   "id": "clah02:13100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こいつ……なんという野生の勘。"
  },
  {
   "id": "clah02:13200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「あ、ああ、当たり前だろ。ぼ、僕がこの部屋に女子を連れ込んだりなんてするもんか」"
  },
  {
   "id": "clah02:13300",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だなー。さすがは宮代だぜ。俺が信用してる男だけのことはある」"
  },
  {
   "id": "clah02:13400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "そんな信用のされ方したくない。"
  },
  {
   "id": "clah02:13500",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ま、でも考えてみりゃ、尾上や副部長みたいなやつらが周りにいるってのに、これまでなんも無かったんだもんなぁ」"
  },
  {
   "id": "clah02:13600",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「お前に限って、そんな心配する必要はなかったんだよなぁ」"
  },
  {
   "id": "clah02:13700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "伊藤にこんな風に思われるのは癪に触るが、ここは黙って聞いといたほうがよさそうだ。"
  },
  {
   "id": "clah02:13800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「そ、そうだよ。僕に限ってそんなこと、あるわけないだろ」"
  },
  {
   "id": "clah02:13900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だよなぁ。で？」"
  },
  {
   "id": "clah02:14000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "うんうん頷いたかと思うと、こんどは急に顔を近づけて耳打ちしてきた。"
  },
  {
   "id": "clah02:14100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「……なんだよ？」"
  },
  {
   "id": "clah02:14200",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「隠すなって！ なんか良いエロＤＶＤでも手に入れて、そんで早く帰って来たんだろ？」"
  },
  {
   "id": "clah02:14300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「……お前と一緒にするな。そういうんじゃないよ」"
  },
  {
   "id": "clah02:14400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "そもそもいまどきＤＶＤって。"
  },
  {
   "id": "clah02:14500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "そんなのネット巡回したら、いくらでも手に入るだろうに。"
  },
  {
   "id": "clah02:14600",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「またまたー。飽きたら俺にも貸してくれよ」"
  },
  {
   "id": "clah02:14700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「ん？」"
  },
  {
   "id": "clah02:14800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "その時、僕は伊藤の背後、ベッドの枕の陰に、何やらくるくると丸まったものを見つけた。"
  },
  {
   "id": "clah02:14900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ファンシーな色づかいの柄があしらわれた、布でできた何かだ。"
  },
  {
   "id": "clah02:15000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あれは、もしかして……。"
  },
  {
   "id": "clah02:15100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「ぱっ、パン――」"
  },
  {
   "id": "clah02:15200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "言いかけて思わず手で口を覆う。"
  },
  {
   "id": "clah02:15300",
   "type": "dialogue",
   "speaker": "伊藤真二",
