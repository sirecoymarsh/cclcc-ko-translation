   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "야마조에 우키",
   "jp": "「…………」"
  },
  {
   "id": "clyu13:2600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "「…………」"
  },
  {
   "id": "clyu13:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "理路整然とした結衣の発言に、結人もうきもただ呆気にとられてしまっていた。"
  },
  {
   "id": "clyu13:2800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「やっぱり私、変なこと言っちゃった？」"
  },
  {
   "id": "clyu13:2900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「いや……僕もその通りだと思う……」"
  },
  {
   "id": "clyu13:3000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「本当？」"
  },
  {
   "id": "clyu13:3100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "「ああ……」"
  },
  {
   "id": "clyu13:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕はかなり驚いていた。"
  },
  {
   "id": "clyu13:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣はただの憧れとか興味本位とか、そんな気持ちでやっているところがあるんだと、まだどこかで思っていたところがあった。"
  },
  {
   "id": "clyu13:3400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "けれど、結衣は結衣なりに、自分でいろいろと考えようとしているんだ。"
  },
  {
   "id": "clyu13:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "子どもだ子どもだとばかり思っていたけれど、僕が家を離れている間に、結衣なりに成長してたんだな……。"
  },
  {
   "id": "clyu13:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それに、結衣の言ったことは理にかなっていた。"
  },
  {
   "id": "clyu13:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "正直なことを言えば、この前までは僕も調子に乗ってしまっていたところがある。"
  },
  {
   "id": "clyu13:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "このままこれでもか、これでもかと過激なことをしていけば、せいぜいのところ限界がくる。"
  },
  {
   "id": "clyu13:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ＢＡＮされて、ようやく目が覚めたのは僕も同じだった。"
  },
  {
   "id": "clyu13:4000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "「正直感心したよ。結衣もちゃんといろいろ考えてるんだな」"
  },
  {
   "id": "clyu13:4100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えへへ」"
  },
  {
   "id": "clyu13:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結衣は嬉しそうにはにかんだ。"
  },
  {
   "id": "clyu13:4300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
