   "jp": "「〜〜〜〜♪」"
  },
  {
   "id": "clse07:941700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留兄、ただいま」"
  },
  {
   "id": "clse07:941800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留兄……大丈夫？ 顔色が良くないみたいだけど？」"
  },
