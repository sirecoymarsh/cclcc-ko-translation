  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「いいじゃん、ちょっとくらい。兄妹でしょ？」"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
