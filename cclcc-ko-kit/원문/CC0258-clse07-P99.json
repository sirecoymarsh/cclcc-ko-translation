  {
   "id": "clse07:939600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「やだ、もう、タクルったら、そんなところ触っちゃダメでしょ？ めっ」"
  },
  {
   "id": "clse07:939700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あれ？」"
  },
  {
   "id": "clse07:939800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「今、タクル……ぶるぶるってした。もしかしておしっこかな？」"
  },
  {
   "id": "clse07:939900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はい、おしっこはそこでするのよ？」"
