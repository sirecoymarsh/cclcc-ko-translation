  {
   "id": "clse07:942000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いっただっきまーっす！」"
  },
  {
   "id": "clse07:942100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
