  {
   "id": "clse07:940000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほら。しー、しー……」"
  },
  {
   "id": "clse07:940100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わ。いっぱいでてる……すごーい」"
  },
  {
   "id": "clse07:940200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしたの、拓留兄？ 顔、赤いよ？」"
