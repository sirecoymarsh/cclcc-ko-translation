  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「なぁに？ もしかしてユウも良い子良い子したい？」"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「そ？ タクル、こんなにかわいいのに」"
  }
 ],
 "entries": [
  {
   "id": "clse07:939500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
