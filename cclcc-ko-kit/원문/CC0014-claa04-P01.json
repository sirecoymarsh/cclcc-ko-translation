 "context_before": [],
 "entries": [
  {
   "id": "claa04:0",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……うーん」"
  },
  {
   "id": "claa04:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "生徒会に文句をつけさせないような紙面。"
  },
  {
   "id": "claa04:200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "そのためには、世間をあっと言わせるようなスクープが必要……か。"
  },
  {
   "id": "claa04:300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕は自分のトレーラーハウスのベッドに大の字になって、ずっと考え込んでいた。"
  },
  {
   "id": "claa04:400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そして、部室のボードでまとめた、数々の事件のことを考えていたのだが……。"
  },
  {
   "id": "claa04:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ふと、妙な違和感にかられた。"
  },
  {
   "id": "claa04:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "どこがどうおかしいのか、それは全く説明できないのだけれど……。"
  },
  {
   "id": "claa04:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "たとえば、『こっち見んなー！事件』っていうのは、あんなにバカバカしい事件だったろうか？"
  },
  {
   "id": "claa04:800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "『音漏れてん事件』は？"
  },
  {
   "id": "claa04:900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "『回転ジェット事件』は？"
  },
  {
   "id": "claa04:1000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "『ごっつァンデス事件』は？"
  },
  {
   "id": "claa04:1100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「どれも、もっとすごかったような気がするんだよなー」"
  },
  {
   "id": "claa04:1200",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「何がすごかったの？」"
  },
  {
   "id": "claa04:1300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": "오노에 세리카",
   "jp": "「いや、どの事件ももっとこう――って、うわぁっ！？」"
  },
  {
   "id": "claa04:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ＰＣが置いてあるテーブルの向こうからいきなり声がしたので、思わずベッドから転がり落ちてしまった。"
  },
  {
   "id": "claa04:1500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": "오노에 세리카",
   "jp": "「お、お、尾上っ！ お前、いつの間に！？」"
  },
  {
   "id": "claa04:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "昼間見た尾上の水着姿が思いっきり脳裏によみがえってきて、あやうく顔が赤くなってしまうところだった。"
  },
  {
   "id": "claa04:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "あの時はひたすらビックリしてしまっただけだが、いま思い出してみると、来栖も尾上もなかなか似合っていて、可愛かっ――何を考えてるんだ、僕はっ！？"
  },
  {
   "id": "claa04:1800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う？ ドアの鍵あいてたから」"
  },
  {
   "id": "claa04:1900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「鍵があいてても、ノックくらいして入ってこいよ。いったいいつから、そこに座ってるんだ」"
  },
  {
   "id": "claa04:2000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「んーと。タクがね、ブツブツひとりごと言い始めたあたり」"
  },
  {
   "id": "claa04:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「ほとんど最初からじゃないかよ、それ！ 油断も⟦rb⟧隙⟦rt⟧すき⟦/r⟧もあったもんじゃないな……」"
  },
  {
   "id": "claa04:2200",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えへへぇ」"
  },
  {
   "id": "claa04:2300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "尾上はいつものように屈託なく笑ったが、ふいに、僕に向かって手を差し出した。"
  },
  {
   "id": "claa04:2400",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ、そうだ。いつもの五百円」"
  },
  {
   "id": "claa04:2500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「五百円……いつもの？」"
  },
  {
   "id": "claa04:2600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「って、まさか！？」"
  },
  {
   "id": "claa04:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "ものすごくイヤな予感がした。"
  },
  {
   "id": "claa04:2800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うん。そこでゲンさんに会ったんだ。そしたらね、タクが⟦rb⟧毎月⟦rt⟧⟦rbc⟧●●⟦/r⟧⟦rb⟧楽しみに⟦rt⟧⟦rbc⟧●●●●⟦/r⟧⟦rb⟧してる⟦rt⟧⟦rbc⟧●●●⟦/r⟧雑誌を渡しといてくれって」"
  },
  {
   "id": "claa04:2900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はいこれ。お金は私が立て替えておいたから。五百円」"
  },
  {
   "id": "claa04:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "いちおう袋らしきものに包まれてはいるものの、『⟦col:280aa02d1400⟧クールキャットプレス⟦col:800000⟧』という雑誌名や、表紙を飾っているやたら煽情的なグラビアアイドルの写真まで思いっきり透けて見えてしまっている。"
  },
  {
   "id": "claa04:3100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「たぁー！」"
  },
  {
   "id": "claa04:3200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "僕は気合とともに袋ごと雑誌をひったくると、ゴミ箱の中へ放り込んだ。"
  },
  {
   "id": "claa04:3300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えー？ なんで捨てちゃうの？ まだ読んでないのに」"
  },
  {
   "id": "claa04:3400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「なぁ、尾上？ この僕が、こんな程度の低い本を読むわけないだろう？」"
  },
  {
   "id": "claa04:3500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う？ でも、こっちの棚の奥にこっそりしまってある本って、全部、『くーるきゃっとぷれす』って書いてあったような……」"
  },
  {
   "id": "claa04:3600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「わーわーわー！ お前はヒトの家を勝手にあさるな！」"
  },
  {
   "id": "claa04:3700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「のんちゃんには秘密にしとくから、私にも見せてよー」"
  },
  {
   "id": "claa04:3800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そう言うと尾上はゴミ箱から、捨てたばかりの『クールキャットプレス』を引っ張り出し、『うわー、すごい』とか『これはえっちだー』とか言いながらペラペラとめくり始めた。"
  },
  {
   "id": "claa04:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こっちはなんともいたたまれなくなり、一刻も早く本を回収しようとするのだが――"
  },
  {
   "id": "claa04:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "――尾上のやつ、『こういう本を隠してるの、のんちゃんに言いつけちゃうよー』とか脅迫しつつ、興味深げに全ページ読破しやがったのである。"
  },
  {
   "id": "claa04:4100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "（な、なんてヤツだ……）"
  },
  {
   "id": "claa04:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "そもそも、こういう本、女の子が読んで面白いものなんだろうか？"
  },
  {
   "id": "claa04:4300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ねぇ、タク！ こんな面白いのあるよ？ やってみてよー」"
  },
  {
   "id": "claa04:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "世莉架が広げていたのは、『アナタが⟦rb⟧本気⟦rt⟧マジ⟦/r⟧でオトすべき理想のカノジョはこんな女だ！』とかなんとかそんな派手なタイトルが踊っている企画ページだった。"
  },
  {
   "id": "claa04:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "要するに、よくある『ＹＥＳ–ＮＯ』心理診断みたいなもので、設問に対してＹＥＳかＮＯかで線をたどっていくと、それによって、僕と相性ピッタリの女の子が分かる……という企画らしい。"
  },
  {
   "id": "claa04:4600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「こんなの、どっかのライターがテキトーに書いてるだけだろ？ 当たるわけないって」"
  },
  {
   "id": "claa04:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "――と、尾上の前ではカッコつけつつ、実はこの手の『ＹＥＳ–ＮＯ』心理診断企画があると、毎回、ちょっとドキドキしながら線をたどり、最終結果に一喜一憂しているのは内緒だ。"
  },
  {
   "id": "claa04:4800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「もー、そういうことばっかり言ってるから、タクはいつまでたっても彼女が出来ないんだよー」"
  },
  {
   "id": "claa04:4900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「なにをー？」"
  },
  {
   "id": "claa04:5000",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
