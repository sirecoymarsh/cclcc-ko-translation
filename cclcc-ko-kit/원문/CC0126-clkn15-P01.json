   "id": "clkn15:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "⟦top:38⟧そして、そうなるよう追い詰めてしまったのは、誰あろう自分だ。"
