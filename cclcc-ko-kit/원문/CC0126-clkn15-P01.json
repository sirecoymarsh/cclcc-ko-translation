   "id": "clkn15:3700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「僕はもう嫌なんだよ……あいつのあんな哀しい顔を見るのが……」"
