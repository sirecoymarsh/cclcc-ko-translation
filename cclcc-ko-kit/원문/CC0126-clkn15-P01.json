   "id": "clkn15:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "⟦top:38⟧拓留が一言いえば、それだけで拓留にかけられた嫌疑が晴らせる可能性は高くなる。"
  },
  {
   "id": "clkn15:2700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
