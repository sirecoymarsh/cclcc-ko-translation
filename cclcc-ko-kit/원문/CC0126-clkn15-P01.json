   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "世莉架は拓留に、自分が泉理であることを皆に言わないのかと聞いていた。"
