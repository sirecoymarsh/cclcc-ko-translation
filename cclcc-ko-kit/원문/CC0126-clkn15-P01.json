  {
   "id": "clkn15:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "午後の授業が始まる直前になって、突然尾上世莉架が教室まで訪ねてきた。"
  },
  {
   "id": "clkn15:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "そして戸惑う乃々の手を引っ張り、世莉架はここ――新聞部の部室の前まで彼女を連れてきた。"
  },
  {
   "id": "clkn15:700",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「のんちゃん。ちょっとの間、ここで待っててね」"
  },
  {
   "id": "clkn15:800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "そう言って、世莉架は乃々をひとりおいて、新聞部室に入っていった。"
  },
  {
   "id": "clkn15:900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "こんな時間の部室に何があるんだろう。"
