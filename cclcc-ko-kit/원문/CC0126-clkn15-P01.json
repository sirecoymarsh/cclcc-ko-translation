  {
   "id": "clkn15:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "そう思っていると、中から声が聞こえて来た。"
  },
  {
