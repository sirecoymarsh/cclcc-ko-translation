   "id": "clkn15:5600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": null,
   "jp": "「泉理として過ごした時間。乃々として生きた時間。その両方があって、今のあいつがいるんだから……」"
  },
  {
   "id": "clkn15:5700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": null,
   "jp": "「学校で⟦col:280aa02d1400⟧女帝⟦col:800000⟧と言われてた乃々も、家でしっかり者の姉だった泉理も、どちらも彼女を形作っているものなら、僕はそれを受け入れるだけだ」"
  },
  {
   "id": "clkn15:5800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それは――それこそは、彼女が聞きたかった言葉だった。"
  },
  {
   "id": "clkn15:5900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "たったひとり。"
  },
  {
   "id": "clkn15:6000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:38⟧ひとりで良かった。"
  },
  {
   "id": "clkn15:6100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:38⟧自分は自分でいい。"
  },
  {
   "id": "clkn15:6200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:38⟧そう認めてもらいたい。"
  },
  {
   "id": "clkn15:6300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:38⟧それが自分の求めていたものなのだと、彼女は気づいた。"
  },
  {
   "id": "clkn15:6400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そして今――。"
  },
  {
   "id": "clkn15:6500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「だから、彼女の哀しみを僕が代わりに背負ってあげられるなら、僕は喜んで背負おう」"
  },
