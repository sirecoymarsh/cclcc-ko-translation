   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ドア越しに聴こえる拓留のひと言ひと言が、乃々の不安を溶かしてゆく。"
