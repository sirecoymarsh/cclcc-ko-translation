   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "⟦top:114⟧恐れと憂いに冷たく固まっていた心が⟦rb⟧解⟦rt⟧ほど⟦/r⟧かれてゆく。"
