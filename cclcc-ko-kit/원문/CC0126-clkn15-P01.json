  {
   "id": "clkn15:2500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "⟦top:38⟧それでも、証言してくれる人ならたくさんいる。"
