   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「えっと……トン、トントン、トン……？」"
  },
  {
   "id": "clyu06:300",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「だから、タン、タタン、タン、だってばー」"
  },
  {
   "id": "clyu06:400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「うぅ……」"
  },
  {
   "id": "clyu06:500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「それから、ここでステップだよ！」"
  },
  {
   "id": "clyu06:600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「す、ステップ……っ……！」"
  },
  {
   "id": "clyu06:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "その翌日も――。"
  },
  {
   "id": "clyu06:800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「はい、ターン！」"
  },
  {
   "id": "clyu06:900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「た、ターン……きゃっ！！」⟦avs⟧⟦n⟧⟦n⟧"
  },
  {
   "id": "clyu06:1000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「大丈夫か、結衣？ ちょっと休むか？」"
  },
  {
   "id": "clyu06:1100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "「う、ううん。まだ平気！ ユウ、今のところもう一回！」"
  },
  {
   "id": "clyu06:1200",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「う、うん……」"
  },
  {
   "id": "clyu06:1300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "結衣と結人の稽古は、来る日も来る日も続いた。"
  },
  {
   "id": "clyu06:1400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "それは僕が想像していたよりも、ずっと真剣で過酷なものだった。"
  },
  {
   "id": "clyu06:1500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "結衣だけじゃなく、結人に関してもそうだ。"
  },
  {
   "id": "clyu06:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "最初は嫌々だっただけに、もっと早くに飽きて投げ出したりするかと思っていたけれど、決してそういうことは無かった。"
  },
  {
   "id": "clyu06:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "そして１０日もすると、その成果は目に見えて表れはじめていた。"
  },
  {
   "id": "clyu06:1800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「最後にここでポーズ！」"
  },
  {
   "id": "clyu06:1900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「！！！」"
  },
  {
   "id": "clyu06:2000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「…………」"
  },
  {
   "id": "clyu06:2100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はぁ……はぁ……どう……かな？」"
  },
  {
   "id": "clyu06:2200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "恐る恐る僕の顔をうかがう結衣に、僕は力強く親指を立てて見せた。"
  },
  {
   "id": "clyu06:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「やったな、結衣！ 最後まで通して、ちゃんと踊れてたぞ！」"
  },
  {
   "id": "clyu06:2400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "「ほんと！？」"
  },
  {
   "id": "clyu06:2500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「うん！ ちゃんとできてたよ！」"
  },
  {
   "id": "clyu06:2600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「いやっっっっっったあああああっ！！」"
  },
  {
   "id": "clyu06:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "飛び上がって喜ぶ結衣に、僕の顔も自然にほころんでしまう。"
  },
  {
   "id": "clyu06:2800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「これも、拓留兄とユウのおかげだよ！ ありがとー！」"
  },
  {
   "id": "clyu06:2900",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「ううん、お姉ちゃんが頑張ったからだよ」"
  },
  {
   "id": "clyu06:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "手を取り合って喜ぶふたりに、僕はひしひしと感じていた。"
  },
  {
   "id": "clyu06:3100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "――⟦rb⟧これは⟦rt⟧⟦rbc⟧●●●⟦/r⟧⟦rb⟧いい画が⟦rt⟧⟦rbc⟧●●●●⟦/r⟧⟦rb⟧とれた⟦rt⟧⟦rbc⟧●●●⟦/r⟧――と。"
  },
  {
   "id": "clyu06:3200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ねえねえ！ これで、やっと“⟦col:280aa02d1400⟧踊ってみた⟦col:800000⟧”に投稿できるよね？」"
  },
  {
   "id": "clyu06:3300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "「それなんだけど……実はふたりに見せたいものがあるんだ」"
  },
  {
   "id": "clyu06:3400",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「見せたい……もの？」"
  },
  {
   "id": "clyu06:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "僕はふたりを手招きすると、タブレットを取り出した。"
  },
  {
   "id": "clyu06:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "そのページを覗き込んだふたりの不思議そうな顔が、次第に驚きに変わっていった。"
  },
  {
   "id": "clyu06:3700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留兄……これって……」"
  },
  {
   "id": "clyu06:3800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「そう、『⟦col:280aa02d1400⟧ミルフィーユ⟦col:800000⟧』のチャンネルだ」"
  },
  {
   "id": "clyu06:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "これまで僕は、自分たちの動きを見直せるようにという名目で、ふたりのダンスを録画していた。"
  },
  {
   "id": "clyu06:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "そうして日々溜まっていく動画を、見やすい長さに編集し、毎日こっそりとニヤ動に投稿していたのだ。"
  },
  {
   "id": "clyu06:4100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「これ……本当に私たちの……？」"
  },
  {
   "id": "clyu06:4200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "「ああ……」"
  },
  {
   "id": "clyu06:4300",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「ほら、見てよ、お姉ちゃん……カウント……こんなにたくさんの人が見てるよ？」"
  },
  {
   "id": "clyu06:4400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「ほんとだ……」"
  },
  {
   "id": "clyu06:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "動画のアップを始めた最初の２日くらいは、それこそ散々だった。"
  },
  {
   "id": "clyu06:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "そもそもの視聴数が少ないうえ、ヘタクソだのやめろだの、そんな手厳しいコメントばかりが寄せられた。"
  },
  {
   "id": "clyu06:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "様子が変わっていったのは、３日を過ぎた頃だった。"
  },
  {
   "id": "clyu06:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "それまで寄せられていた罵詈や雑言が、次第に応援へと変わり始めた。"
  },
  {
   "id": "clyu06:4900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "結衣の必死さと、どれだけ失敗してもへこたれない頑張りに、皆が心を動かされ始めたのだ。"
  },
  {
   "id": "clyu06:5000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "それと同時に、カウントの数も段々と増えていった。"
  },
  {
   "id": "clyu06:5100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「でも、拓留兄ちゃん、いつの間に……」"
  },
  {
   "id": "clyu06:5200",
   "type": "dialogue",
   "speaker": "橘結衣",
