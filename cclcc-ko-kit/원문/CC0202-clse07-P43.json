  {
   "id": "clse07:415100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それぞれどんな事件だったか？ みんな覚えてるか？ どうだ尾上？」"
  },
  {
   "id": "clse07:415200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おいおい、事件からまだそれほど経ってないぞ？ いいか？ どんな事件だったかというと――」"
  },
  {
   "id": "clse07:415300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まず、『こっち見んなー！事件』は――』"
  },
  {
   "id": "clse07:415400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（いや、それは別の事件だ。考え直そう）"
  },
  {
   "id": "clse07:415500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（この事件は違う。もう少し考えてみるか）"
  },
  {
   "id": "clse07:415600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうだ。これが『こっち見んなー！事件』の概要だな」"
  },
  {
   "id": "clse07:415700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（いや、違うぞ、これは違う事件だったはずだ）"
  },
  {
   "id": "clse07:415800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「次に、『音漏れてん事件』」"
  },
  {
   "id": "clse07:415900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（違うな、これは別の事件の話だ）"
