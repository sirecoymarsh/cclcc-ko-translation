  {
   "id": "clse07:416000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（いやいや、不正解だ。落ち着いて思い出せ）"
