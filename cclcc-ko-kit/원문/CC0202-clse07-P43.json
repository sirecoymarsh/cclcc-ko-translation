  {
   "id": "clse07:414700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そっか。あんまり情報はあてに出来ないな……」"
  },
  {
   "id": "clse07:414800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「じゃあ、次。これはつい最近起こった事件だ」"
  },
  {
   "id": "clse07:414900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「有名ネット記者の渡部が巻き込まれた『ごっつァンデス事件』」"
  },
  {
   "id": "clse07:415000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「この四つのうち、どれを取材すべきか検討したいんだが……」"
