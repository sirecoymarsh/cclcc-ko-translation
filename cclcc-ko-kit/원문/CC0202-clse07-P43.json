  {
   "id": "clse07:414300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そして、三番目『回転ジェット事件』。この事件で被害にあったのは――」"
  },
  {
   "id": "clse07:414400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "（渡部はこの事件とは関係ない。よく思い出してみろ）"
  },
  {
   "id": "clse07:414500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうだ。柿田広宣だったな」"
  },
  {
   "id": "clse07:414600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「確か、有村は柿田の知り合いじゃなかったか？」"
