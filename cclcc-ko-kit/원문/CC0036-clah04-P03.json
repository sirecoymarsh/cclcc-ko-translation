   "next_speaker": "와쿠이 슈이치",
   "jp": "その時、廊下の奥を通りがかった和久井先生が、僕たちを見て歩み寄ってきた。"
  },
  {
   "id": "clah04:20200",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「探したよ、宮代くん、有村くん。ちょっと来てもらえるかな？」"
  },
  {
   "id": "clah04:20300",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「なるほど。つまり有村くんがお母さんとケンカして、宮代くんの部屋に転がり込んだ、と」"
  },
  {
   "id": "clah04:20400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「まあ、そういうことです」"
  },
  {
   "id": "clah04:20500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "와쿠이 슈이치",
   "jp": "困ったことになった。"
  },
  {
   "id": "clah04:20600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "와쿠이 슈이치",
