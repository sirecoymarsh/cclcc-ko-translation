  {
   "id": "clah04:20800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「もちろんです！！！」"
  },
  {
   "id": "clah04:20900",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふむ……」"
  },
  {
   "id": "clah04:21000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "……いや、待てよ？"
  },
  {
   "id": "clah04:21100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "ここで問題になると、有村は大人しく家に帰らざるを得なくなるんじゃないか？"
  },
  {
   "id": "clah04:21200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "僕にも多少のお咎めはあるだろうけど、それで僕の穏やかな生活が戻って来るのなら、万々歳じゃないのか？"
  },
  {
   "id": "clah04:21300",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうか。だったらいいよ。オッケー」"
  },
  {
   "id": "clah04:21400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「へ？」"
  },
  {
   "id": "clah04:21500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "だが、和久井先生はあっさりと認めた。"
  },
  {
   "id": "clah04:21600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「ど、どうしてですか！？」"
  },
  {
   "id": "clah04:21700",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だって、学生としての節度を持ってお付き合いしてるんだろう？」"
  },
  {
   "id": "clah04:21800",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「学校側としても、不純な行為にふけってもらうのは困るけど、そうじゃないのならとやかく言うことでもないしね」"
  },
  {
   "id": "clah04:21900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「で、でももしかしたら何かあったりするかも……」"
  },
  {
   "id": "clah04:22000",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あるのかい？」"
  },
  {
   "id": "clah04:22100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「あ、いや……ない……です……」"
  },
  {
   "id": "clah04:22200",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うん。だったら問題ない」"
  },
  {
   "id": "clah04:22300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "「そうは言ってもですね……！」"
  },
  {
   "id": "clah04:22400",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それに、有村くんのお母さんとも、さっき電話で話をしてある。彼女のやりたいようにやらせてくれ、ということだ」"
  },
  {
   "id": "clah04:22500",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「親御さんが良いと言うなら、僕たちがとやかく言うことじゃないよ」"
  },
  {
   "id": "clah04:22600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "와쿠이 슈이치",
   "jp": "そんな……。"
  },
  {
   "id": "clah04:22700",
   "type": "dialogue",
   "speaker": "和久井修一",
   "speaker_ko": "와쿠이 슈이치",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ま、ふたりとも、くれぐれも節度ある付き合いを頼むよ」"
  },
  {
   "id": "clah04:22800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "와쿠이 슈이치",
   "next_speaker": "아리무라 히나에",
   "jp": "「あ、先生！ 待っ――」"
  },
  {
   "id": "clah04:22900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "だがそんな僕の声は届くことなく、和久井先生はそのまま去っていってしまった。"
  },
  {
   "id": "clah04:23000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "「とりあえずお咎めなかったのは良かったけど……」"
  },
  {
   "id": "clah04:23100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카와하라 마사시",
   "jp": "良くない。全然良くない！"
  },
  {
   "id": "clah04:23200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카와하라 마사시",
   "jp": "これで、このバカバカしい家出騒動を有村にあきらめさせる口実が、またひとつ減ってしまったということだ。"
  },
  {
   "id": "clah04:23300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "카와하라 마사시",
   "jp": "かくなる上は……。"
  },
