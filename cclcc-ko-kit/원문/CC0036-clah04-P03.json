   "id": "clah04:23500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「か、川原くん！！！ いいところに！」"
  },
  {
   "id": "clah04:23600",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「え……？」"
  },
  {
   "id": "clah04:23700",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なるほど。で、和久井先生はなんて？」"
  },
  {
   "id": "clah04:23800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「それが……特には……」"
  },
  {
   "id": "clah04:23900",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふむ……」"
  },
  {
   "id": "clah04:24000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "教職員からも認められたとあっては、もはや頼みの綱は生徒会……いや、彼、川原くんだけだ。"
  },
  {
   "id": "clah04:24100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "僕には当たりの厳しい彼のことだ。"
  },
  {
   "id": "clah04:24200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "こんな騒動があったら、ここぞとばかりに咎めてくるに違いない。"
  },
  {
   "id": "clah04:24300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "そうなったら、こっちのものだ。"
  },
  {
   "id": "clah04:24400",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「先生方がなんと言おうと、生徒会としては学生同士という関係を逸脱する行為、あるいは逸脱する可能性につながる行為を認めるわけにはいかない」"
  },
  {
   "id": "clah04:24500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "아리무라 히나에",
   "jp": "「そ、そうですよね！！」"
  },
  {
   "id": "clah04:24600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카와하라 마사시",
   "jp": "「えー。別にやましいことしてるわけじゃないですしー」"
  },
  {
   "id": "clah04:24700",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「これ以上、妙な噂が広まって、学内に不純な空気が蔓延しても困る。ダメなものはダメだ」"
  },
  {
   "id": "clah04:24800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카와하라 마사시",
   "next_speaker": "카와하라 마사시",
   "jp": "「お固いことで……そんなだから来栖先輩に振り向いてもらえないんすよねぇ」"
  },
  {
   "id": "clah04:24900",
   "type": "dialogue",
   "speaker": "川原雅司",
   "speaker_ko": "카와하라 마사시",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「ん？ なにか言ったか？」"
