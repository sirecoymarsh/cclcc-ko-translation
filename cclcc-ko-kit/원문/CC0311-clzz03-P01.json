  {
   "id": "clzz03:5300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "そう言いながら、ベッドの上で身を起こしてみた。"
