   "id": "clzz03:5400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "신조 타케시",
   "jp": "⟦top:38⟧まだ少しめまいがするが、それ以外は特に問題なさそうだ。"
