  {
   "id": "clzz03:5500",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「半日くらいだと思う。宮代くんも同じ意見だった」"
  },
  {
   "id": "clzz03:5600",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "신조 타케시",
   "next_speaker": "신조 타케시",
   "jp": "「宮代？」"
