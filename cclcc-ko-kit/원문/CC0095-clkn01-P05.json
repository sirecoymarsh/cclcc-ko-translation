  },
  {
   "id": "clkn01:39900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "유이＆유토",
   "next_speaker": "타치바나 유토",
   "jp": "しかも、なんで変身に箱？"
  },
  {
   "id": "clkn01:40000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "유이＆유토",
   "next_speaker": "타치바나 유토",
   "jp": "悪趣味にもほどがある。"
  },
  {
   "id": "clkn01:40100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "유이＆유토",
   "next_speaker": "타치바나 유이",
   "jp": "「あのね、実は僕もマジックできるんだよ」"
  },
  {
   "id": "clkn01:40200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "結人が唐突に言った。"
  },
  {
   "id": "clkn01:40300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "야마조에 우키",
   "jp": "「ユウがマジック？」"
  },
  {
   "id": "clkn01:40400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "「どんなマジックですか？」"
  },
  {
   "id": "clkn01:40500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「うーんと……説明するよりも見てもらったほうが早いかな？」"
  },
  {
   "id": "clkn01:40600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "嬉しそうに笑う結人の笑顔は無垢そのものだった。"
  },
  {
   "id": "clkn01:40700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "マジックとは言ってもトランプマジックとかコインマジックとか、そういう、子どもでもできそうなものだろう。"
  },
  {
   "id": "clkn01:40800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「えへへ、きっとみんな驚くと思うよ」"
  },
  {
   "id": "clkn01:40900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "それに結人のことだから、きっとタネも見え見えだろう。"
  },
  {
   "id": "clkn01:41000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "でもそこは大人として、素直に騙されたフリをしてやるべきだな。"
  },
  {
   "id": "clkn01:41100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「結衣姉、手伝ってくれる？」"
  },
  {
   "id": "clkn01:41200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「私？ 別にいいけど……」"
  },
  {
   "id": "clkn01:41300",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "「それじゃあこっち来て」"
  },
  {
   "id": "clkn01:41400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "結人は結衣を立たせると、ふらっと廊下に出て行った。"
  },
  {
   "id": "clkn01:41500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「んっしょ……」"
  },
  {
   "id": "clkn01:41600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "しばらくして戻ってきた結人は、何やら奇妙なものを抱えていた。"
  },
  {
   "id": "clkn01:41700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "それは――箱だった。"
  },
  {
   "id": "clkn01:41800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "大小合わせ、色とりどり、様々な形の箱が組み合わせて、ある⟦rb⟧もの⟦rt⟧⟦rbc⟧●●⟦/r⟧をかたどっているように見える。"
  },
  {
   "id": "clkn01:41900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "――人だ。"
  },
  {
   "id": "clkn01:42000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "箱は明らかに人の形をしていた。"
  },
  {
   "id": "clkn01:42100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "結人は手際よく箱の蓋をすべて開け、にっこり笑って言った。"
  },
  {
   "id": "clkn01:42200",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": null,
   "next_speaker": "타치바나 유이",
   "jp": "「それじゃあ、お姉ちゃん。この中にどうぞ」"
  },
  {
   "id": "clkn01:42300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「え……ここに入ればいいの？」"
  },
  {
   "id": "clkn01:42400",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": null,
   "jp": "「うん」"
  },
  {
   "id": "clkn01:42500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "何度も首をかしげながらも、言われたとおりに箱に収まる結衣。"
  },
  {
   "id": "clkn01:42600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "やがて結衣の身体がすべて箱の中に納まると、結人はすべての蓋を閉めた。"
  },
  {
   "id": "clkn01:42700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "今やそこに横たわっているのは、人型に並べられた箱――。"
  },
  {
   "id": "clkn01:42800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "何故だろう。"
  },
  {
   "id": "clkn01:42900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "僕は厭な予感がした。"
  },
  {
   "id": "clkn01:43000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「さて皆さん。ご覧のように、この箱の中には今、結衣姉ちゃんが入っています。そして――」"
  },
  {
   "id": "clkn01:43100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "結人が小さな指で、パチンと音を鳴らすと、そこに妙な形の剣が出現した。"
  },
  {
   "id": "clkn01:43200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유토",
   "next_speaker": "미야시로 타쿠루",
   "jp": "それは――。"
  },
  {
   "id": "clkn01:43300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「ディソード……！」"
  },
  {
   "id": "clkn01:43400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "嘘だろ？"
  },
  {
   "id": "clkn01:43500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "結人がギガロマニアックスとして覚醒していた？"
  },
  {
   "id": "clkn01:43600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "そんな……。"
  },
  {
   "id": "clkn01:43700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "じゃあ、結人の能力はなんだ？"
  },
  {
   "id": "clkn01:43800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「今から、この箱をバラバラにしたいと思いまーす」"
  },
  {
   "id": "clkn01:43900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「は……？」"
  },
  {
   "id": "clkn01:44000",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それじゃあ、いっきまーす。せーのっ」"
  },
  {
   "id": "clkn01:44100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유이",
   "jp": "「ま、待て、結人！ それは――！」"
  },
  {
   "id": "clkn01:44200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "止める間もなく、結人はその小さな身体のどこにそんな力があるのかと思うほど大きくディソードを振りかぶり、一息に振り下ろした。"
  },
  {
   "id": "clkn01:44300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "と同時に。"
  },
  {
   "id": "clkn01:44400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ゃああああああああああああああ！！！」"
  },
  {
   "id": "clkn01:44500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "耳を⟦rb⟧劈⟦rt⟧つんざ⟦/r⟧くような悲鳴が上がった。"
  },
  {
   "id": "clkn01:44600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유토",
   "jp": "「結人！ お前、何してんだよ！」"
  },
  {
   "id": "clkn01:44700",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「何って、だからマジックだよ？」"
  },
  {
   "id": "clkn01:44800",
