   "id": "clah11:4500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "이토 신지",
   "jp": "それはきっと、彼女が本気だからだ……と、僕はそう思いたかった。"
  },
  {
   "id": "clah11:4600",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふ〜ん」"
