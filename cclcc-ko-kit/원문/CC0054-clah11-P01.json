   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "伊藤は考え込んだ僕の顔を、笑みを浮かべて見ていた。"
  },
  {
   "id": "clah11:4800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「な、なんだよ？」"
