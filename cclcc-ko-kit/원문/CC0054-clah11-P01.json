   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "教室に戻った僕の様子から状況を察したのだろう。伊藤が声をかけてきた。"
