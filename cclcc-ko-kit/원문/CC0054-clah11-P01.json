   "id": "clah11:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "確かに、普段のただ明るく騒がしい有村を見ていると、そう思うだろう。"
