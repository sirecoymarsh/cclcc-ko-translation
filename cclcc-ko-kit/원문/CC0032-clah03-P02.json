   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふーん……そう……」"
  },
  {
   "id": "clah03:10900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "有村の母さんは、相変わらず厳しい顔のまま立ち上がった。"
  },
  {
   "id": "clah03:11000",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「まあいいわ。今日のところは帰ります」"
  },
  {
   "id": "clah03:11100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「え……？」"
  },
  {
   "id": "clah03:11200",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうせ今は何を言っても聞かないでしょうし。頭が冷えた頃にまた来るわ」"
  },
  {
   "id": "clah03:11300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "そのまま、バッグを手にドアの前まで歩み寄り、思い出したように振り返ると、僕を見て言った。"
  },
  {
   "id": "clah03:11400",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「帰り道がわからないんだけど。送ってもらえるかしら？」"
  },
  {
   "id": "clah03:11500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「…………」"
  },
  {
   "id": "clah03:11600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "かつて、こんな重い空気を背負ったままこの道を歩いたことがあっただろうか。"
  },
  {
   "id": "clah03:11700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "背後からひしひしと感じる有村の母さんのプレッシャーを感じながら、僕は井ノ頭通りへ向かう道を歩いていた。"
  },
  {
   "id": "clah03:11800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "（まったく、なんで僕が――）"
  },
  {
   "id": "clah03:11900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "そう何度心の中で尋ねたところで、当然答えは見当たらない。"
  },
  {
   "id": "clah03:12000",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「宮代さん」"
  },
  {
   "id": "clah03:12100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「は、はいっ！？」"
  },
  {
   "id": "clah03:12200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "背中越しに名前を呼ばれ、飛び上がりそうになる。"
  },
  {
   "id": "clah03:12300",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「悪いわね。あの子の我がままに突き合わせて」"
  },
  {
   "id": "clah03:12400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「え？」"
  },
  {
   "id": "clah03:12500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あの子のことだもの。付き合ってるなんて嘘。ひとの良い先輩に無理言って、転がり込んだってところでしょう？」"
  },
  {
   "id": "clah03:12600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "……バレてる。"
  },
  {
   "id": "clah03:12700",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「その顔は図星ってところね」"
  },
  {
   "id": "clah03:12800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「あ、いや……その……」"
  },
  {
   "id": "clah03:12900",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ま、でもあなたみたいなタイプを選んだところをみると、あの子の見る目もまんざらではないってことかもしれないけど」"
  },
  {
   "id": "clah03:13000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "褒められてる……？"
  },
  {
   "id": "clah03:13100",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だって、あなたなら妙なことしそうにないものね」"
  },
  {
   "id": "clah03:13200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "ではなかったらしい。"
  },
  {
   "id": "clah03:13300",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あなたも迷惑してるんでしょう？」"
  },
  {
   "id": "clah03:13400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「その……まあ……」"
  },
  {
   "id": "clah03:13500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふふ。でもあなたもおかしな子ね。迷惑なら、あんなバカげたお芝居に付き合わなければいいのに」"
  },
  {
   "id": "clah03:13600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「あ……」"
  },
  {
   "id": "clah03:13700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "言われてみれば、確かにそうだった！"
  },
  {
   "id": "clah03:13800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "有村を本気で帰したいなら、有村の台本になんて従わずに、本当のことをブチまければよかったんだ。"
  },
  {
   "id": "clah03:13900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "じゃあ、僕はどうしてそうしなかった？"
  },
  {
   "id": "clah03:14000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "もしかして……有村との時間を惜しいと思ってた？"
  },
  {
   "id": "clah03:14100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "いや、そんなことはない……はずだ。"
  },
  {
   "id": "clah03:14200",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「まあでも、どうせここで強引にあの子を連れて帰ったところで、同じことでしょうし、あなたには悪いけど、もう少しだけ面倒見てやってもらえるかしら？」"
  },
  {
   "id": "clah03:14300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そう言うと、有村の母さんは財布から何枚かのお札を取り出した。"
  },
  {
   "id": "clah03:14400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「い、いや……！ それは、受け取れません！！」"
  },
  {
   "id": "clah03:14500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「迷惑代兼宿泊費よ」"
  },
  {
   "id": "clah03:14600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「だ、ダメです！」"
  },
  {
   "id": "clah03:14700",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「でも、あんなところで暮らしているってことは、困ってるんじゃないの？」"
  },
  {
   "id": "clah03:14800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「あ、あそこは好きでいるだけで、そう困ってるわけでも……」"
  },
  {
   "id": "clah03:14900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "結局、僕が頑なに受け取らないことを理解して、有村の母さんはお札を引っ込めた。"
  },
  {
   "id": "clah03:15000",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なるほどね……」"
