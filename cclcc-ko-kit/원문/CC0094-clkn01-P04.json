  "사쿠마 와타루",
  "야마조에 우키",
  "타치바나 유이",
  "타치바나 유토"
 ],
 "context_before": [
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「えっへん！！」"
  },
  {
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "jp": "「僕とうき姉ちゃんも手伝ったよ。ね、うき姉ちゃん！」"
  },
  {
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "jp": "「はい。お手伝いさせていただきました」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「へぇ、これを結衣がねぇ……」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "今度は大きめのジャガイモと一緒に口に運ぶ。"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「うん、ほんとに美味いよ。泉理が作るのとそんなに変わらない」"
  }
 ],
 "entries": [
  {
   "id": "clkn01:29600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미나미사와 센리",
   "jp": "「だって、泉理姉！」"
  },
  {
   "id": "clkn01:29700",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「あらあら。じゃあ今度から、夕飯はずっと結衣に任せようかしら」"
  },
  {
   "id": "clkn01:29800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "타치바나 유토",
   "jp": "「え……それはちょっと……」"
  },
  {
   "id": "clkn01:29900",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「そうだよー。結衣姉に任せたら、毎日カレーかシチューになっちゃうよー」"
  },
  {
   "id": "clkn01:30000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「こら、ユウ！！」"
  },
  {
   "id": "clkn01:30100",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "「わぁ、うき姉ちゃん、たすけてー」"
  },
  {
   "id": "clkn01:30200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "사쿠마 와타루",
   "jp": "「ええっ？」"
  },
  {
   "id": "clkn01:30300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "사쿠마 와타루",
   "jp": "確かに結人の言うとおり、泉理の域に達するには、結衣はまだまだだろう。"
  },
  {
   "id": "clkn01:30400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "사쿠마 와타루",
   "jp": "たとえば、この付け合わせのらっきょう。"
  },
  {
   "id": "clkn01:30500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "사쿠마 와타루",
   "jp": "これも泉理が家で漬けた自家製のもののはずだ。"
  },
  {
   "id": "clkn01:30600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "야마조에 우키",
   "next_speaker": "사쿠마 와타루",
   "jp": "ちゃんと家の家計を考えて、安くて美味いものを作るのは、そうそう簡単に出来ることじゃない。"
  },
  {
   "id": "clkn01:30700",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「つーかよ、肉が入ってねぇじゃねぇか、肉がよぉ」"
  },
  {
   "id": "clkn01:30800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「えー、入ってるよ。ほら、そこに」"
  },
  {
   "id": "clkn01:30900",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「これっぽっちじゃねぇか。しかもチキンときた。カレーといやぁ、牛だろ牛」"
  },
  {
   "id": "clkn01:31000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「本場のカレーには牛肉は入ってません」"
  },
  {
   "id": "clkn01:31100",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미나미사와 센리",
   "jp": "「ったく、そういうところばっか、泉理に似て来ちまって」"
  },
  {
   "id": "clkn01:31200",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「あら。それに何か問題でも？」"
  },
  {
   "id": "clkn01:31300",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "타치바나 유이",
   "jp": "「え？ あ、いやぁ……そういうわけじゃ……」"
  },
  {
   "id": "clkn01:31400",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "타치바나 유이",
   "jp": "「って、おい。拓留のカレー、肉がいっぱい入ってるじゃねえか！ 贔屓だ贔屓！ 家族は皆平等に、それが⟦rb⟧青葉寮⟦rt⟧うち⟦/r⟧の決まりだろ」"
  },
  {
   "id": "clkn01:31500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「そんなの聞いたことないわよ」"
  },
  {
   "id": "clkn01:31600",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「今決めたんだよ。ほら、拓留！ 肉よこせ、肉！」"
  },
  {
   "id": "clkn01:31700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「チキンはいらないんじゃなかったの？」"
  },
  {
   "id": "clkn01:31800",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「チキンでも無いよりゃマシだ！ よこせ！」"
  },
  {
   "id": "clkn01:31900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「あ！！ それ、一番大きいやつ！」"
  },
  {
   "id": "clkn01:32000",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あぐっ……へーんだ、もう食っちまったぜ」"
  },
  {
   "id": "clkn01:32100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "미나미사와 센리",
   "jp": "「くっそ〜……！」"
  },
  {
   "id": "clkn01:32200",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "「もう、父さんったら子どもじゃないんだから。拓留も、私のお肉あげるから、相手しない」"
  },
  {
   "id": "clkn01:32300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "타치바나 유토",
   "jp": "……こういうのも家族団欒って言うんだろうな、きっと。"
  },
  {
   "id": "clkn01:32400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "타치바나 유토",
   "jp": "でもそれも悪くない――そう思えるようになったのも、しばらく一人暮らしを経験したせいかもしれない。"
  },
  {
   "id": "clkn01:32500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "타치바나 유이",
   "jp": "「ごちそうさま！ ね、テレビつけていい？」"
  },
  {
   "id": "clkn01:32600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「ダメよ。テレビは皆が食べ終わってからっていう決まりでしょ」"
  },
  {
   "id": "clkn01:32700",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「でもほら、今日はアレがあるんだよ。結衣姉も見たいって言ってた……」"
  },
  {
   "id": "clkn01:32800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "사쿠마 와타루",
   "jp": "「あ！ あのマジックの！？ 嘘っ、今日だっけ？」"
  },
  {
   "id": "clkn01:32900",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "야마조에 우키",
   "jp": "「なんだ、結衣。お前、まだマジックだのなんだのが好きなのかよ？」"
  },
  {
   "id": "clkn01:33000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「まだ？」"
  },
  {
   "id": "clkn01:33100",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "타치바나 유이",
   "jp": "「結衣のやつ、昔よく言ってたんだよ。魔法が使えたらなぁ、とかなんとか」"
  },
  {
   "id": "clkn01:33200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유이",
   "jp": "魔法……。"
  },
  {
   "id": "clkn01:33300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「お父さんったら、またそうやってバカにするんだから」"
  },
  {
   "id": "clkn01:33400",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「バカにしてるわけじゃねえって。いつまで経っても子どものままだって思っただけだ」"
  },
  {
   "id": "clkn01:33500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유이",
   "jp": "そういえば子どものころは、手品が魔法みたいに見えたっけ。"
  },
  {
   "id": "clkn01:33600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유이",
   "jp": "誰だって、そういうのに憧れる時期というのはあるものだ。"
  },
  {
   "id": "clkn01:33700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "타치바나 유이",
   "jp": "そういう意味じゃ、ギガロマニアックスの能力だって魔法みたいなものだけど。"
  },
  {
   "id": "clkn01:33800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "야마조에 우키",
   "jp": "「それをバカにしてるっていうの。だいたい、私もう子どもじゃないし！」"
  },
  {
   "id": "clkn01:33900",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「でも、もしも本当に魔法が使えたら素敵ですよね」"
  },
  {
   "id": "clkn01:34000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "사쿠마 와타루",
   "jp": "「でしょ？ うきちゃんもそう思うよね」"
  },
  {
   "id": "clkn01:34100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "それにしても、結衣にもこんな一面があったんだな。"
  },
  {
   "id": "clkn01:34200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "父さんはいつまで経っても、だなんて言ってたけど、僕から見た結衣はむしろ背伸びをして大人ぶっているように見えていた。"
  },
  {
   "id": "clkn01:34300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "もしかしたら僕は今まで、きちんと結衣のことを見ていなかったのかもしれない。"
  },
  {
   "id": "clkn01:34400",
   "type": "dialogue",
