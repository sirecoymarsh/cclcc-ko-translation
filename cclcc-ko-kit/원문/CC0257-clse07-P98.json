  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「それじゃああらためて、よろしくお願いします。プロデューサーさんっ」"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「うん。アイドルの面倒をみてくれる人を“プロデューサー”って言うんでしょ？ だから、拓留兄がプロデューサー」"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「私、どうしたらいいでしょうか？」"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「「私、アイドルとしてもっと売れたいんです。でも、どうしたらいいかわからなくて」"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「もちろんです！ トップアイドルになるためなら私、どんなことでもします」"
  },
  {
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "jp": "「はいっ。どんなことでも！」"
  }
 ],
