   "id": "clse07:934100",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ねえ、拓留兄。私、やっぱり拓留兄にプロデューサー、してほしい」"
  },
  {
   "id": "clse07:934200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もっちろん。人気の曲に合わせて踊ってるところをアップした動画のことでしょ」"
  },
  {
   "id": "clse07:934300",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、私この曲好き！」"
  },
