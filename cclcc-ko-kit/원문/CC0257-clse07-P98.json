  {
   "id": "clse07:932700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふふっ、ふふふっ……あはははは、ダメ！ ダメだってば〜！」"
