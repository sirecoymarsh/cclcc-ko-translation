  {
   "id": "clse07:935700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私……ダメだよね。歌とかダンスとか、ユウよりも全然ヘタで……」"
  },
  {
   "id": "clse07:935800",
   "type": "dialogue",
   "speaker": "橘結衣",
