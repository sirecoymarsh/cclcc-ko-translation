  },
  {
   "id": "clse07:931700",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？ そうなの？」"
  },
  {
   "id": "clse07:931800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お願いします、伊藤プロデューサー！」"
