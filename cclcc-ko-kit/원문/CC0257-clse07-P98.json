   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それっ。こちょこちょこちょ〜」"
  },
  {
   "id": "clse07:932400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こちょこちょこちょこちょ〜」"
  },
  {
   "id": "clse07:932500",
