   "id": "clse07:930800",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、はい。一応……」"
  },
  {
   "id": "clse07:930900",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「えへへ……それに関しては、昨日寝る前に一生懸命考えたんだ。ね？」"
  },
  {
   "id": "clse07:931000",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私たちのユニット名は〜。せーのっ」"
