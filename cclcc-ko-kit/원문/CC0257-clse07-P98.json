  {
   "id": "clse07:935500",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……拓留兄。ちょっといい……かな？」"
  },
