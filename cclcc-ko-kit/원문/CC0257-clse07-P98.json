   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？ あ、きゃっ！」"
  },
  {
   "id": "clse07:932600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あっ、こら、ユウ！ ダメっ、そこは……あんっ！」"
