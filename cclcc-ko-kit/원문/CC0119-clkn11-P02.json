  {
   "id": "clkn11:15500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「泉理？」"
  },
  {
   "id": "clkn11:15600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ごめんなさい、拓留。眠れなかった？」"
  },
  {
   "id": "clkn11:15700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ああ、なんだ。乃々か……」"
  },
  {
   "id": "clkn11:15800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うん。もしかしたら泣き止むかなって。でも、ダメみたい……」"
  },
  {
   "id": "clkn11:15900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "乃々の腕の中で、ひかりは激しく泣き声を上げていた。"
  },
  {
   "id": "clkn11:16000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「……ちょっと代わろうか」"
  },
  {
   "id": "clkn11:16100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「え？ あ、うん……」"
  },
  {
   "id": "clkn11:16200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "乃々からひかりを受け取ると、ゆっくりと揺らしてやる。"
  },
  {
   "id": "clkn11:16300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "と……。"
  },
  {
   "id": "clkn11:16400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あら……」"
  },
  {
   "id": "clkn11:16500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "ひかりはすぐに泣き止み、やがて静かな寝息を立て始めた。"
  },
  {
   "id": "clkn11:16600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "ここ数日でわかったが、眠ったからといって安心して離れると、赤ん坊はすぐに目を覚ます。"
  },
  {
   "id": "clkn11:16700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "僕はそのままひかりを布団に寝かし、そのすぐ傍に横たわると、しばらくの間寝息に合わせて、手のひらで優しくトントンとその小さな身体に触れてやった。"
  },
  {
   "id": "clkn11:16800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ひかりったら、私でも泉理でもダメだったのに。ちょっと妬いちゃうわね」"
  },
  {
   "id": "clkn11:16900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "泉理でも、か……。"
