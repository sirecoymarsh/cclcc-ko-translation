  },
  {
   "id": "clkn11:10500",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유이",
   "jp": "「あら。ひかりったら、ご機嫌斜めみたいね」"
  },
  {
   "id": "clkn11:10600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「あ、ほら、ひかり！ パパとママが帰ってきたわよ」"
  },
  {
   "id": "clkn11:10700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미나미사와 센리",
   "jp": "急いで家に入ろうとノブに手をかけようとした途端、中からドアが開き、ひかりを抱いた結衣が顔をだして言った。"
  },
  {
   "id": "clkn11:10800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "타치바나 유이",
   "next_speaker": "미나미사와 센리",
   "jp": "その言葉に対しては、言われ過ぎて、もはや突っ込む気も起きない。"
  },
  {
   "id": "clkn11:10900",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「あらぁ、ひかり。どうしたの？ 寂しかったの？」"
  },
  {
   "id": "clkn11:11000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "結衣の手からひかりを受け取ると、その顔を覗き込む。"
  },
  {
   "id": "clkn11:11100",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「はいはい、いい子だからねぇ。静かにしましょうねぇ」"
  },
  {
   "id": "clkn11:11200",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "「さっすがママ！」"
  },
  {
   "id": "clkn11:11300",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "타치바나 유이",
   "jp": "「もう。またそんなこと言って。ほら、早く中に入りましょう」"
  },
  {
   "id": "clkn11:11400",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "？？？",
   "jp": "「はぁい」"
  },
  {
   "id": "clkn11:11500",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "타치바나 유이",
   "next_speaker": "사쿠마 와타루",
   "jp": "「…………」"
  },
  {
   "id": "clkn11:11600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "？？？",
   "next_speaker": "사쿠마 와타루",
   "jp": "その日の夜には、父さんが帰ってきた。"
  },
  {
   "id": "clkn11:11700",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "？？？",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ははは！ しばらく見ないうちに、お前らもすっかり子育てが板についてきたじゃねぇか」"
  },
  {
   "id": "clkn11:11800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "쿠루스 노노",
   "jp": "「笑いごとじゃないって」"
  },
  {
   "id": "clkn11:11900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「そうよ、父さん。これからこの子をどうするかだって、ちゃんと考えなきゃいけないんだから」"
  },
  {
   "id": "clkn11:12000",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「相変わらずお前は堅ぇなあ。そういうのは考えたって始まらねえ。なるようになるんだよ」"
  },
  {
   "id": "clkn11:12100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": null,
   "jp": "「また、そんな暢気なこと言って……」"
  },
  {
   "id": "clkn11:12200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "乃々がため息をつくのも無理はない。"
  },
  {
   "id": "clkn11:12300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "神成さんから赤ん坊の母親が見つかったという連絡はない。"
  },
  {
   "id": "clkn11:12400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "これから青葉寮として赤ん坊をどうするのか、僕たちは決めなきゃならない。"
  },
  {
   "id": "clkn11:12500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "神成さんの言うように、百瀬さんのところで調べてもらうか、あるいはこのまま⟦rb⟧青葉寮⟦rt⟧うち⟦/r⟧で育てるか。"
  },
  {
   "id": "clkn11:12600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "ひと口に育てると言っても、そう簡単じゃないことは、この数日でわかっている。"
  },
  {
   "id": "clkn11:12700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "それによって、僕たちの将来も大きく変わってしまうかもしれない。"
  },
  {
   "id": "clkn11:12800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "でも――。"
  },
  {
   "id": "clkn11:12900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clkn11:13000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "彼女はそれでもいいと言うだろう。"
  },
  {
   "id": "clkn11:13100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "結衣や結人、うきも……。"
  },
  {
   "id": "clkn11:13200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "사쿠마 와타루",
   "jp": "僕はどうなんだろう。"
  },
  {
   "id": "clkn11:13300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "사쿠마 와타루",
   "jp": "もしもこのままひかりを育てることになったら。"
  },
  {
   "id": "clkn11:13400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "사쿠마 와타루",
   "jp": "これまでのようにまた青葉寮で生活して、みんなでひかりの面倒をみて。"
  },
  {
   "id": "clkn11:13500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "사쿠마 와타루",
   "jp": "喋ったと言っては喜んで、立ち上がったと言っては喜んで。"
  },
  {
   "id": "clkn11:13600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "사쿠마 와타루",
   "jp": "病気をしたら心配して。"
  },
  {
   "id": "clkn11:13700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "사쿠마 와타루",
   "jp": "そんな生活があるなんて、これまで想像したことすらなかった。"
  },
  {
   "id": "clkn11:13800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "사쿠마 와타루",
   "jp": "けれど、なんだかそれはとても……。"
  },
  {
   "id": "clkn11:13900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "사쿠마 와타루",
   "jp": "とても……。"
  },
  {
   "id": "clkn11:14000",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「ま、とりあえず明日からしばらく、赤ん坊の面倒は俺がみてやっから。お前はちゃんと学校に行け」"
  },
  {
   "id": "clkn11:14100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「でも……大丈夫？」"
  },
  {
   "id": "clkn11:14200",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ったり前だ。俺を誰だと思ってる」"
  },
  {
   "id": "clkn11:14300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "사쿠마 와타루",
   "jp": "「それがわかってるから、心配なのよ……」"
  },
  {
   "id": "clkn11:14400",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「たぁ〜……お前ら、家族ならちっとは俺のこと信頼しろよ……」"
  },
  {
   "id": "clkn11:14500",
   "type": "dialogue",
   "speaker": "佐久間恒",
   "speaker_ko": "사쿠마 와타루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ほれ、ひかりもこう言ってるだろ」"
  },
  {
   "id": "clkn11:14600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "사쿠마 와타루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふふっ、もう、ひかりったら……」"
  },
  {
   "id": "clkn11:14700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "こういうのを団欒って言うんだろうか？"
  },
  {
   "id": "clkn11:14800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もしもひかりがいなかったら、僕がこんな風にここにいることは無かったかもしれない。"
  },
  {
   "id": "clkn11:14900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ふあぁ……」"
  },
  {
   "id": "clkn11:15000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "今日も一日疲れた。"
  },
  {
   "id": "clkn11:15100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "子どもっていうのは、どうしてああも体力が有り余っているんだろうか。"
  },
  {
   "id": "clkn11:15200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕にもあんな時期があったなんて、とてもじゃないが信じられない。"
  },
  {
   "id": "clkn11:15300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ほら、今もずっと泣いてるし……。"
  },
  {
   "id": "clkn11:15400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「…………」"
