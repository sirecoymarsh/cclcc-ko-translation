   "prev_speaker": null,
   "next_speaker": "이토 신지",
   "jp": "「うーん……」"
  },
  {
   "id": "clyu02:100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "アイドル活動……とは言ったものの。"
  },
  {
   "id": "clyu02:200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "致命的な問題があることに、僕は今になってようやく気付いた。"
  },
  {
   "id": "clyu02:300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "これまで情強として名を馳せてきた僕だが、こればかりは素直に認めよう。"
  },
  {
   "id": "clyu02:400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "僕はアイドルについて、まったくと言っていいほど知らない！"
  },
  {
   "id": "clyu02:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "アイドルについて、なんて、ネットでちょっと調べればわかると思ったが、その考えは甘かった。"
  },
  {
   "id": "clyu02:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "ネットで調べてみても、アイドルの歴史や、それぞれのアイドルの結成理由、個々のエピソードが羅列されているだけで、何一つ有用な情報を得ることはできなかった。"
  },
  {
   "id": "clyu02:700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "이토 신지",
   "jp": "アイドルプロデュース――もしかしたら僕は、甘くみていたのかもしれない。"
  },
  {
   "id": "clyu02:800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「なんだなんだ、宮代。さっきから、有村の作った弁当でも食ったような顔して」"
  },
  {
   "id": "clyu02:900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「あ、伊藤先輩。私、明日、お弁当作ってきてあげますね〜。おかずは何がいいですか？ 雑草？ 石？ それとも泥？ 腐ったたまねぎとかでもいいですよ〜」"
  },
  {
   "id": "clyu02:1000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「さあさあ、どれがいいです？ 選んでくださーい」"
  },
  {
   "id": "clyu02:1100",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「ほんの冗談なんですごめんなさい」"
  },
  {
   "id": "clyu02:1200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "카즈키 하나",
   "jp": "「華っ！」"
  },
  {
   "id": "clyu02:1300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "이토 신지",
   "jp": "「……伊藤先輩は……一生女子の手作りお弁当が食べられなくなる……」"
  },
  {
   "id": "clyu02:1400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「ほんっと、勘弁してください！ お願いします！！」"
  },
  {
   "id": "clyu02:1500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "「……かも」"
  },
  {
   "id": "clyu02:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "そもそもここで考え事をしようというのが間違っていた。"
  },
  {
   "id": "clyu02:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "오노에 세리카",
   "jp": "こいつらがいると、どうにも考えに集中できない。"
  },
  {
   "id": "clyu02:1800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「で、なに悩んでるの、タク？ よかったら話してみてよ。私たちでも何か力になれるかもしれないし」"
  },
  {
   "id": "clyu02:1900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "……正直、そんなに力になってもらえるとも思えないけど。"
  },
  {
   "id": "clyu02:2000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "まあでも、どんなアイデアでも無いよりはマシかもしれない。"
  },
  {
   "id": "clyu02:2100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "신문부원들",
   "jp": "「実はさ……」"
  },
  {
   "id": "clyu02:2200",
   "type": "dialogue",
   "speaker": "新聞部員たち",
   "speaker_ko": "신문부원들",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
   "jp": "「アイドルをプロデュース！？」"
  },
  {
   "id": "clyu02:2300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "신문부원들",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「アイドルって、あのアイドル？」"
  },
  {
   "id": "clyu02:2400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「他にどのアイドルがあるんだよ？」"
  },
  {
   "id": "clyu02:2500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「えっと……偶像とか邪神とか……」"
  },
  {
   "id": "clyu02:2600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "「なんで本来の意味でとらえるんだよ……」"
  },
  {
   "id": "clyu02:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "だいたい邪神をプロデュースって、どんなだよ。"
  },
  {
   "id": "clyu02:2800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "「まあ、アイドル活動って言っても、お遊びみたいなもんだけどさ……」"
  },
  {
   "id": "clyu02:2900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「おい、宮代……お前、それ本気で言ってんのか？」"
  },
  {
   "id": "clyu02:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "伊藤がさっきまでとは打って変わったように、真剣な表情で詰め寄って来た。"
  },
  {
   "id": "clyu02:3100",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「アイドルになるために、どれだけの女の子がどれだけ努力してるかわかって言ってんのか！？」"
  },
  {
   "id": "clyu02:3200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「ま、まあそれなりには……」"
  },
  {
   "id": "clyu02:3300",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「いいや、お前はぜんっぜんわかってねぇ！ だからそんな無責任に”遊びみたいなもん”だなんて言えるんだよ！」"
  },
  {
   "id": "clyu02:3400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「いいか？ お前のその発言は、アイドルに対しての、そしてすべてのアイドルファンに対しての侮辱行為だ！ 謝れ！ アイドルの人たちに謝れぇ！」"
  },
  {
   "id": "clyu02:3500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "아리무라 히나에",
   "jp": "「あ、アイドルの人たち……ごめんなさい……」"
  },
  {
   "id": "clyu02:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "伊藤の勢いに気圧されて思わず謝ってしまったけど……そもそも、伊藤ってそんなアイドル好きだったっけ？"
  },
  {
   "id": "clyu02:3700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "「ま、伊藤先輩が怒るのも無理はないですね」"
  },
  {
   "id": "clyu02:3800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「ん…………」"
  },
  {
   "id": "clyu02:3900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "아리무라 히나에",
   "jp": "そう……なのか？"
  },
  {
   "id": "clyu02:4000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「宮代先輩のさっきの発言は、アイドルを舐めくさってるとしか言いようがありません」"
  },
  {
   "id": "clyu02:4100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「アイドルとして多くの人に見てもらうためには、想像できないくらいとてつもない努力が必要なんです！」"
  },
  {
   "id": "clyu02:4200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「歌ひとつにとってもそう。歌詞を覚えてダンスを覚えて、更にはそれを笑顔で歌って踊らなきゃいけない」"
  },
  {
   "id": "clyu02:4300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「裏でどれだけ辛く苦しい思いをしていても、それを表に出しちゃいけない！」"
  },
  {
   "id": "clyu02:4400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうやって、影ならぬ努力をしていても、トップアイドルとして君臨できるのは選ばれしほんの一握りのアイドルだけなんです！」"
  },
  {
   "id": "clyu02:4500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それを“お遊び”だの“ままごと”だの“盆踊り”だの。舐めていると言われても仕方がありません！」"
  },
  {
   "id": "clyu02:4600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "……そんなことは言ってない。"
  },
  {
   "id": "clyu02:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ていうか、なんで有村までこんな必死になってるんだよ。"
  },
  {
   "id": "clyu02:4800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "이토 신지",
   "jp": "「わ、わかったよ。僕の認識が間違ってた……」"
  },
  {
   "id": "clyu02:4900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "이토 신지",
   "jp": "「アイドル活動は、僕なんかがそう軽々しく手を出していいものじゃなかったんだ。諦めるよ」"
  },
  {
   "id": "clyu02:5000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「いや、別にやめる必要ないだろ」"
  },
  {
   "id": "clyu02:5100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうですよ。なんでやめるんです？」"
  },
  {
   "id": "clyu02:5200",
   "type": "dialogue",
   "speaker": "宮代拓留",
