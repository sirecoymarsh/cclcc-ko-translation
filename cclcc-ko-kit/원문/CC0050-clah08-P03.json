  {
   "id": "clah08:20800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「…………」"
  },
  {
   "id": "clah08:20900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ママ……先輩は最初から関係ないから……私が勝手におしかけて、無理矢理、居候してただけだから……」"
  },
  {
   "id": "clah08:21000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "有村はゆっくりと立ち上がった。"
  },
  {
   "id": "clah08:21100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「先輩も、迷惑かけてごめんなさい……」"
  },
  {
   "id": "clah08:21200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そして深々と頭を下げると、そのまま隅に置いていたバッグを肩にかけ、そのまま振り返りもせずに出て行ってしまった。"
  },
  {
   "id": "clah08:21300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 에미",
   "jp": "（有村……）"
  },
  {
   "id": "clah08:21400",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「……なんなのよ、いったい」"
  },
  {
   "id": "clah08:21500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "僕こそ、言いたかった。"
  },
  {
   "id": "clah08:21600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "いったいなんなんだ。"
  },
  {
   "id": "clah08:21700",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「迷惑かけたわね。ごめんなさい……」"
  },
  {
   "id": "clah08:21800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "有村の母さんは、ため息交じりに言うと、しっかりとした足取りで有村の跡を追って出て行った。"
  },
  {
   "id": "clah08:21900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "帰り際に置いていった封筒の中には、お札が数枚入っていた。"
  }
 ],
