 "context_before": [
  {
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "jp": "「いいでしょ。私、帰るって言ってるんだから」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「よくないわよ。こないだはふたり口裏あわせて、妙なこと言ってたけど、あの遊びはもう終わりってこと？」"
  },
  {
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "jp": "「――っ」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「気まぐれも結構だけど、それに付き合わされる人のことも少しは考えたらどう？ くだらない嘘に付き合わされた宮代さんもいい迷惑よね」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「あ、いや……」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「いいのよ、はっきり言ってあげて。そうじゃないと、この子、わからないんだから」"
  }
 ],
 "entries": [
