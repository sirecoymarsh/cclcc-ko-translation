  {
   "id": "clah08:20600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「迷惑かけたのはわかってる……だから言わないで……」"
