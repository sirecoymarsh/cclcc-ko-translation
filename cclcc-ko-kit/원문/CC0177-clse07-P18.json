  {
   "id": "clse07:169200",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「普通、休日でも誰か来るだろ、学校なら。それが、丸２日誰も来ねえんだぞ。明日になったら誰か来る保証なんてどこにあるんだよ？」"
  },
  {
   "id": "clse07:169300",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……宮代？ どうしたんだ？」"
