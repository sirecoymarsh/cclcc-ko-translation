   "id": "clse07:169400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そういや、鼻声だな。ちょっとおでこ貸せ！！」"
  },
  {
   "id": "clse07:169500",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「やっぱ、すごい熱だ……」"
