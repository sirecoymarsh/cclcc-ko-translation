   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ほら、どう見ても大丈夫じゃないだろ」"
  },
  {
   "id": "clse07:171100",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
