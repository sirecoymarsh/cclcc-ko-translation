   "id": "clse07:171900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「良かった……もう、大丈夫みたいだな」"
  },
  {
   "id": "clse07:172000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
