   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「は？ 熱計るときは普通こうするだろ」"
  },
  {
   "id": "clse07:169700",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……そうなのか？」"
  },
  {
   "id": "clse07:169800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まあでも、今はそんなことはどうだっていい。とにかく、お前の熱、それなんとかしないと」"
  },
  {
   "id": "clse07:169900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
