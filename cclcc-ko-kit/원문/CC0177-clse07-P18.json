   "id": "clse07:170700",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お、俺だって、別に好きでやろうってわけじゃねーよ！ ただ……お、お前にはツナサンドの恩があるから……」"
  },
  {
   "id": "clse07:170800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それにこのままだと、お前があまりにも辛そうだろ！ だから……」"
  },
  {
   "id": "clse07:170900",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だから、さ。お前も……な？」"
