  },
  {
   "id": "clse07:170000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それはそうだけど……」"
  },
  {
   "id": "clse07:170100",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
