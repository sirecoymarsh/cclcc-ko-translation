   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よくさ、雪山で遭難したときに温め合うって話、聞くよな？」"
