  {
   "id": "clse01:5900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「おいおい、来栖？ 誰に物を言ってるんだ？ 僕の情報網には、ネタなんていくらでも転がってる。むしろ、どれを選ぶべきか困ってるくらいだ」"
  },
  {
   "id": "clse01:6000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「つまり、まだなんにも思いついてない、ってことね。困ったわね」"
  },
  {
   "id": "clse01:6100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
