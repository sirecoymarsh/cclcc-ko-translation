   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "（宮代先輩『僕はただ、彼女のことが好きなだけです。この気持ちは誰にもとめられない。たとえお母さんでも」）"
  },
  {
   "id": "clah03:500",
   "type": "dialogue",
