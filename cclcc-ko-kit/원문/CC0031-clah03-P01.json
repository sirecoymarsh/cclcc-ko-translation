   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「『当たり前じゃないか』」"
  },
  {
   "id": "clah03:1100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": "오노에 세리카",
   "jp": "「あ、ああ……そうか。『当たり前じゃないか。僕は何よりも……』」"
  },
  {
   "id": "clah03:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "오노에 세리카",
