  {
   "id": "clah03:1300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「『僕は何よりも君のことを大切に思っているよ！』」"
  },
  {
   "id": "clah03:1400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「うわああああああっ！！！ 尾上！ お前、いつの間に！」"
  },
  {
   "id": "clah03:1500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う？ さっきからいたよ？」"
  },
  {
   "id": "clah03:1600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "な、なんてことだ。"
  },
  {
   "id": "clah03:1700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "ここ最近こんなのばっかりだ。"
  },
  {
   "id": "clah03:1800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "集中したり妄想したりすると周りが見えなくなる癖、何とかしなきゃ。"
  },
  {
   "id": "clah03:1900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それよりタク。それなに？」"
  },
  {
   "id": "clah03:2000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「え？ ああ、これはその……台本だよ、台本、お芝居の」"
  },
  {
   "id": "clah03:2100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「お芝居？ タクが出るの？」"
  },
  {
   "id": "clah03:2200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「バカ言うな。僕が舞台になんて立つわけないだろ」"
  },
  {
   "id": "clah03:2300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「だったらなんでそんなもの読んでるの？」"
  },
  {
   "id": "clah03:2400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「それはだな……」"
  },
  {
   "id": "clah03:2500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それは？」"
  },
  {
   "id": "clah03:2600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "あれ？"
  },
  {
   "id": "clah03:2700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "そうだよ。"
  },
  {
   "id": "clah03:2800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "なんで僕、わざわざこんなもの覚えようとしてるんだよ。"
  },
  {
   "id": "clah03:2900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "やめたやめた、バカバカしい。"
  },
  {
   "id": "clah03:3000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "僕は有村作の台本を、そそくさとバッグの中に仕舞った。"
  },
  {
   "id": "clah03:3100",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「う？ もう読まなくていいの？」"
  },
  {
   "id": "clah03:3200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "오노에 세리카",
   "jp": "「いいんだ。どうせ必要ないものだし」"
  },
  {
   "id": "clah03:3300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "？？？",
   "jp": "「ふーん……」"
  },
  {
   "id": "clah03:3400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "？？？",
   "jp": "考えてみたら、どうして僕がそこまで付き合わなきゃいけないんだ。"
  },
  {
   "id": "clah03:3500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "？？？",
   "jp": "そもそも、有村の母親が彼女の居場所を見つけて、うちまで来るかどうかだってわからないじゃないか。"
  },
  {
   "id": "clah03:3600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "？？？",
   "jp": "第一、娘を連れ戻すだけなら、学校に乗り込んできた方が早いわけで、わざわざうちまで来る必要がない。"
  },
  {
   "id": "clah03:3700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "오노에 세리카",
   "next_speaker": "？？？",
   "jp": "そうだよ。つまり母親が来るなんてことは、あり得ないはずだ。"
  },
  {
   "id": "clah03:3800",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……それで、あなたは？」"
  },
  {
   "id": "clah03:3900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": "아리무라 에미",
   "jp": "「あ、え、えっと……」"
  },
  {
   "id": "clah03:4000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "もしも数時間前の僕に会えるなら言ってやりたい。"
  },
  {
   "id": "clah03:4100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この世にはどんなことだって起こり得るということを。"
  },
  {
   "id": "clah03:4200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": "아리무라 에미",
   "jp": "「ぼぼ、僕は、その……」"
  },
  {
   "id": "clah03:4300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "学校を終えてトレーラーハウスに戻ると、そこにはなぜか有村と有村の母親が揃っていた。"
  },
  {
   "id": "clah03:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "見なかったことにしてそのまま立ち去ろうとしたものの、有村によって目ざとく見つけられ、この状態というわけだ。"
  },
  {
   "id": "clah03:4500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はっきりしない子ね。私はあなたについて訊いているんだけど」"
  },
  {
   "id": "clah03:4600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 에미",
   "jp": "「そ、その……僕は宮代拓留、と言い……ます……」"
  },
  {
   "id": "clah03:4700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "しかもふたりでも狭いこの部屋の中でのことだ。"
  },
  {
   "id": "clah03:4800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 에미",
   "jp": "会話も必然的に至近距離で行うことになってしまい、圧迫感が半端ない。"
  },
  {
   "id": "clah03:4900",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「宮代さんね。で、うちの雛絵とはどういうご関係？」"
  },
  {
   "id": "clah03:5000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "아리무라 히나에",
   "jp": "「えと、関係と言われましても……」"
  },
  {
   "id": "clah03:5100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「先輩……」"
  },
  {
   "id": "clah03:5200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "ただの学校の先輩後輩――と言いかけたところで、有村が肘でつついてきた。"
  },
  {
   "id": "clah03:5300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "マジかよ……。"
  },
  {
   "id": "clah03:5400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この状況で、あれを言わせようっていうのか？"
  },
  {
   "id": "clah03:5500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「いやいやいや、無理だろ、さすがに」"
  },
  {
   "id": "clah03:5600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
