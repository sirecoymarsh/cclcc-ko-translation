   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こんなこと言ってるけど、本当は寂しかったんですよ、結衣ちゃん」"
  },
  {
   "id": "clse07:891800",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私、知ってますよ。時々、拓留さんのベッドでこっそりお昼寝してたこと」"
  },
  {
   "id": "clse07:891900",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それ、この前買ってきたお洋服ですよね。結衣ちゃんお気に入りの」"
  },
  {
   "id": "clse07:892000",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「拓留さんのお部屋は、乃々さんがちゃんと掃除してくれてますから、以前のまま使えますよ」"
