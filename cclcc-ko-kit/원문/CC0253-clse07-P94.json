  },
  {
   "id": "clse07:894400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おふたりはやっぱり……」"
