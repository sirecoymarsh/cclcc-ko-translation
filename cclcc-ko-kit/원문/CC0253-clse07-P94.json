  },
  {
   "id": "clse07:890100",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「で、でもっ、私にとって拓留さんは大事なお兄ちゃん！ 私、我慢しますからっ！」"
  },
  {
   "id": "clse07:890200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「えっ？ せっかくなのに、なんとかしちゃっていいんですか？」"
  },
  {
   "id": "clse07:890300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「でしたら簡単です。私からなるべく遠く離れて下さい。そうすれば、解除出来ると思います」"
  },
  {
   "id": "clse07:890400",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私、ショックです」"
  },
  {
   "id": "clse07:890500",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はずかしいですね」"
  },
  {
   "id": "clse07:890600",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「私もそんな気がします」"
