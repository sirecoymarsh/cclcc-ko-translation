  {
   "id": "clse07:892100",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「乃々さん、もしかしたら、出て来づらいのかも……」"
  },
  {
   "id": "clse07:892200",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だって、ほら……乃々さん家では……」"
  },
  {
   "id": "clse07:892300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": null,
   "next_speaker": null,
