{
 "packet_id": "CC0092-clkn01-P02",
 "kit_version": "1.0",
 "source_file": "clkn01.msb",
 "speakers_in_packet": [
  "미야시로 타쿠루",
  "야마조에 우키",
  "쿠루스 노노",
  "타치바나 유이",
  "타치바나 유토"
 ],
 "context_before": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「そうだけど、中には知らない奴もいるわけで……」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「思いたい人には思わせておけばいいわよ」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「いや。さすがにそういうわけにもいかないだろ」"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「どうして？」"
  },
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "どうしてって……それは……。"
  },
  {
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "jp": "「ねえ……拓留。あなた、そろそろ家に戻ってこない？」"
  }
 ],
 "entries": [
  {
   "id": "clkn01:10000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「え？ 家って、青葉寮に？」"
  },
  {
   "id": "clkn01:10100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "念のために確認した僕の言葉に、来栖は小さく頷いた。"
  },
  {
   "id": "clkn01:10200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「……い、言ったろ。僕はひとりが良くて、あの寮を出てったんだ。今さら、家族ごっこなんかに戻れるわけがない」"
  },
  {
   "id": "clkn01:10300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そんなこと言って、貴方が家計のこと考えて出て行ったってことくらい、みんなわかってるんだから」"
  },
  {
   "id": "clkn01:10400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ち、違う！ 僕が出て行ったのは父さんとケンカしたからで、そんな――」"
  },
  {
   "id": "clkn01:10500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あなたそれ、有村さんの前でも同じことが言える？」"
  },
  {
   "id": "clkn01:10600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ぐ……」"
  },
  {
   "id": "clkn01:10700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "こんな時に有村の能力の話を持ち出してくるなんて卑怯だ。"
  },
  {
   "id": "clkn01:10800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「父さんからの伝言。『子どもが金の心配なんてすんじゃねぇ。親の⟦rb⟧脛⟦rt⟧すね⟦/r⟧はかじるためにあるんだ』だって」"
  },
  {
   "id": "clkn01:10900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "父さんが……。"
  },
  {
   "id": "clkn01:11000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あれから父さん、晩酌の量も減らして、これまで以上に働いてるの。おかげで家の経済状況も前ほど悪くはないのよ」"
  },
  {
   "id": "clkn01:11100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「…………」"
  },
  {
   "id": "clkn01:11200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それに、結衣や結人も貴方に会いたがってる。だから……ね？」"
  },
  {
   "id": "clkn01:11300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "いつもの僕なら頑なに拒んでいただろう。"
  },
  {
   "id": "clkn01:11400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "けれど、なぜか今日は来栖の言葉がするりと胸の中に入り込んできた。"
  },
  {
   "id": "clkn01:11500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「……わかったよ」"
  },
  {
   "id": "clkn01:11600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ほんと！？」"
  },
  {
   "id": "clkn01:11700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "来栖の表情が、これ以上ないくらい晴れやかに咲いた。"
  },
  {
   "id": "clkn01:11800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ああ。でも、ずっとじゃない。とりあえず今日だけだ」"
  },
  {
   "id": "clkn01:11900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そう……」"
  },
  {
   "id": "clkn01:12000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "再び曇りかけた来栖の表情だったが、それでもすぐに笑顔を取り戻した。"
  },
  {
   "id": "clkn01:12100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「わかった。それでも構わないわ。少しずつ前と同じように戻ってくれるなら」"
  },
  {
   "id": "clkn01:12200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "前と同じように、か。"
  },
  {
   "id": "clkn01:12300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「さ、そうと決まれば、行きましょう！」"
  },
  {
   "id": "clkn01:12400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ちょっと待て。その前に部室でカバンとってこなきゃダメだろ」"
  },
  {
   "id": "clkn01:12500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あ……いけない。そうだったわね。私ったらつい」"
  },
  {
   "id": "clkn01:12600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "小さく舌を出して笑う来栖。"
  },
  {
   "id": "clkn01:12700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "学校の皆は来栖のことを、何から何まで完璧にこなすと思っているけど、意外とそそっかしいところがあることを僕は知っていた。"
  },
  {
   "id": "clkn01:12800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そしてこの時は何故か、それが誇らしくも思えた。"
  },
  {
   "id": "clkn01:12900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "部室でカバンを取ってそのまま、懐かしい道を通って青葉寮へと向かう。"
  },
  {
   "id": "clkn01:13000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "僕は一度家に戻って必要なものを取って来ると言ったんだけど、来栖に青葉寮に戻れば何でもあると言われて、それもそうだと思い直した。"
  },
  {
   "id": "clkn01:13100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "来栖は来栖で、一度トレーラーハウスに戻ったら、僕の気が変わるとでも思ってたのかもしれない。"
  },
  {
   "id": "clkn01:13200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「…………」"
  },
  {
   "id": "clkn01:13300",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「どうしたの？」"
  },
  {
   "id": "clkn01:13400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「いや……」"
  },
  {
   "id": "clkn01:13500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「変なの。ほら」"
  },
  {
   "id": "clkn01:13600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "久しぶりでちょっとだけ緊張してる、なんて口にできない僕を促し、来栖は何の⟦rb⟧躊躇⟦rt⟧ためら⟦/r⟧いも無く、玄関のドアを開けた。"
  },
  {
   "id": "clkn01:13700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「お、お邪魔します」"
  },
  {
   "id": "clkn01:13800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「もう、お邪魔しますだなんて。それを言うなら“ただいま”でしょ？」"
  },
  {
   "id": "clkn01:13900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유토",
   "jp": "「えっと……ただいま……」"
  },
  {
   "id": "clkn01:14000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "若干の照れくささを感じながらも口にしたその言葉は、なんだか少し温かかった。"
  },
  {
   "id": "clkn01:14100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "ここに来るまで、玄関には目に見えない敷居のようなものがあるんじゃないか――なんて思ったけれど、まったくそんなものは無かった。"
  },
  {
   "id": "clkn01:14200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "それほど長く離れていたわけじゃないっていうのに、何もかもが懐かしく思えた。"
  },
  {
   "id": "clkn01:14300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "小さいけれどきちんと整頓された台所も、ほんの少しだけ漂ってくる消毒液の臭いも。"
  },
  {
   "id": "clkn01:14400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "타치바나 유토",
   "jp": "そして、廊下を駆けてくる小さな足音も。"
  },
  {
   "id": "clkn01:14500",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "「拓留兄帰ってきたのッ！？」"
  },
  {
   "id": "clkn01:14600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "타치바나 유토",
   "jp": "「こら、結人。家の中では走っちゃダメって、いつも言ってるでしょう」"
  },
  {
   "id": "clkn01:14700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "타치바나 유토",
   "jp": "けれど、そんな来栖の言葉なんか耳に入っていないのか、結人は僕の姿を見つけるとそのまま真っ直ぐに飛び込んできた。"
  },
  {
   "id": "clkn01:14800",
   "type": "dialogue",
   "speaker": "橘結人",
   "speaker_ko": "타치바나 유토",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留兄っ！！」"
  },
  {
