   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうだな。何らかの精神的な理由から、脳に負担がかかり、⟦col:280aa02d1400⟧ギガロマニアックス⟦col:800000⟧としての能力を制限されるということは考えられる……」"
  },
  {
   "id": "clkn12:24300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "미야시로 타쿠루",
   "jp": "久野里さんは、夜遅くに電話をかけたことを数分間にわたり散々罵った後、ようやく僕の相談に乗ってくれた。"
  },
  {
   "id": "clkn12:24400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「じゃあ、その逆も有り得るってことですか？」"
  },
  {
   "id": "clkn12:24500",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「逆？ つまり、能力が制御できなくなるということか？」"
  },
  {
   "id": "clkn12:24600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「まあ……そういうことです」"
  },
  {
   "id": "clkn12:24700",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふむ……そういう症例はあまり聞いたことがないが、確かに有り得ることかもしれないな」"
  },
  {
   "id": "clkn12:24800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「例えば、本人が何とかしたいと、そう願っていたとしても、ですか？」"
  },
  {
   "id": "clkn12:24900",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「やっかいなことに人間ってヤツは、仮に本人がそう願ったとしても、⟦col:280aa02d1400⟧深層心理⟦col:800000⟧で拒絶してしまうということがある」"
  },
  {
   "id": "clkn12:25000",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「その場合はやはり、制御できなくなるかもしれない」"
  },
  {
   "id": "clkn12:25100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「そうですか。じゃあ、その場合どうすれば元通りになるんです？」"
  },
  {
   "id": "clkn12:25200",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「もちろん、原因を取り除くしかないだろうな」"
  },
  {
   "id": "clkn12:25300",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「能力暴走の原因となっている⟦col:280aa02d1400⟧心的ストレス⟦col:800000⟧を取り除いてやることで、元のように力を制御できるようになるだろう」"
  },
  {
   "id": "clkn12:25400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠노사토 미오",
   "jp": "「やっぱり、そういうことになりますよね……」"
  },
  {
   "id": "clkn12:25500",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「おい、宮代。その口ぶりだと、そういう症例があったということか？ そうなんだな！？」"
  },
  {
   "id": "clkn12:25600",
   "type": "dialogue",
   "speaker": "久野里澪",
   "speaker_ko": "쿠노사토 미오",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「今すぐそいつを私のところへ連れてこい！ 早速、頭の中を調べてみて――」"
  },
  {
   "id": "clkn12:25700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠노사토 미오",
   "next_speaker": "쿠루스 노노",
   "jp": "「…………」"
  },
  {
   "id": "clkn12:25800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「久野里さん……なんだって？」"
  },
  {
   "id": "clkn12:25900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ストレスの原因を取り除けば、元に戻れるって……」"
  },
  {
   "id": "clkn12:26000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そう……」"
  },
  {
   "id": "clkn12:26100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "ストレスの原因……。"
  },
  {
   "id": "clkn12:26200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "それが何かはわかっている。"
  },
  {
   "id": "clkn12:26300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "それを取り除くには彼女が自分自身――南沢泉理としての自分を認めるしかない。"
  },
  {
   "id": "clkn12:26400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "けれど彼女は今現在、自分自身でそう願っているはずだ。"
  },
  {
   "id": "clkn12:26500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "その願いが更にストレスとなって、能力の制御を阻んでいる。"
  },
  {
   "id": "clkn12:26600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "こうなってはどうしようもない。"
  },
  {
   "id": "clkn12:26700",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ゴメン……拓留……私……私は……」"
  },
  {
   "id": "clkn12:26800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「いいって。気にしなくても……」"
  },
  {
   "id": "clkn12:26900",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「でも、このままじゃ貴方が――！！！」"
  },
  {
   "id": "clkn12:27000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「僕なら自分でどうにかする。だから心配しなくていい」"
  },
  {
   "id": "clkn12:27100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「それに伊藤も言ってたろ？ この騒ぎもすぐに終わるって」"
  },
  {
   "id": "clkn12:27200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「どうせみんな騒ぎたい材料が欲しいだけだ。何か面白い材料を見つけると、騒ぐだけ騒いで、そしてすぐに忘却してしまう」"
  },
  {
   "id": "clkn12:27300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「今回だって同じだって……」"
  },
  {
   "id": "clkn12:27400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": null,
   "jp": "「うん……」"
  },
  {
   "id": "clkn12:27500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "そうだ。"
  },
  {
   "id": "clkn12:27600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "どうせまた騒ぐだけ騒いですぐ収束するに違いない――。"
  },
  {
   "id": "clkn12:27700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "けれど。"
  },
  {
   "id": "clkn12:27800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "それが楽観的すぎる考えだったと理解するのに、それほどの時間は必要なかった。"
  }
 ],
 "context_after": []
}