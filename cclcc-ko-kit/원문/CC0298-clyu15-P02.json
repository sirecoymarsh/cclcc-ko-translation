 "context_before": [
  {
   "speaker": null,
   "speaker_ko": null,
   "jp": "そのたびに、たぶんブラをつけてない結衣の小さなふくらみが僕の身体に押し付けられるわけで、そのたびに頭の中で、ふたりの僕が言い合いをしていた。"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "（落ち着きなさい、拓留。彼女はあなたの妹ですよ）"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "（ケケケ、妹とは言っても血は繋がってないんだろ？ だったら何も迷うことなんてねぇんだぜ）"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "（彼女は兄であるあなたを信頼しているのです。邪な心などおこしてはなりません）"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "（ヘヘヘ、ここにこんな風に来るってことは、この女だって期待してるはずだろ？）"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "（黙りなさい、煩悩の悪魔め）"
  }
 ],
 "entries": [
