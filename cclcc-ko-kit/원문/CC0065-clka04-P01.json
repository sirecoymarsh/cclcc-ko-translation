   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "あれに写っているのが、ここにいる誰かである可能性が高いのだ。"
  },
  {
