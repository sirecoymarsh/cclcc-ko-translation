   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「じ、実は、な」"
  },
  {
   "id": "clka04:4900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「今日、朝、目が覚めた時、僕は制服を着ていたんだ」"
  },
  {
   "id": "clka04:5000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「なんですって！？」"
  },
  {
   "id": "clka04:5100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「ひっ！」"
  },
  {
   "id": "clka04:5200",
   "type": "narration",
