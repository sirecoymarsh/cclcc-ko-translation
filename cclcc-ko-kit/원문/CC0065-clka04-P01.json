   "next_speaker": "이토 신지",
   "jp": "「ただいま――」"
  },
  {
   "id": "clka04:100",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「いやあ、ここはカットするのはもったいないだろ」"
  },
  {
   "id": "clka04:200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "「全然わかってないですね、伊藤先輩は。むしろこっちを使うべきですよ」"
  },
  {
   "id": "clka04:300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "「えー、でもそれ、バスケ部の子のジャージがめくれてて、ちょっとエッチくない？」"
  },
  {
   "id": "clka04:400",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "아리무라 히나에",
   "jp": "「確かにそうねえ。元データも消しておいた方がいいわね」"
  },
  {
   "id": "clka04:500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "部室に戻ると、伊藤、有村、尾上、来栖がいた。僕がトイレで考察作業に勤しんでいる間に帰ってきていたようだ。"
  },
  {
   "id": "clka04:600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "아리무라 히나에",
   "jp": "有村たちは伊藤が操作するＰＣを背後から覗き込みながら、なにやら議論をしている。"
  },
  {
   "id": "clka04:700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "이토 신지",
   "jp": "「ええー！？ このほんの少しだけ腹チラしてるのがいいんじゃないですか！ そう思いますよね伊藤先輩！？」"
  },
  {
   "id": "clka04:800",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「これくらいのチラリズムだったら、俺は別にあってもなくてもいいかなあ」"
  },
  {
   "id": "clka04:900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「そんな意識の低さだからモテないんですよ！」"
  },
  {
   "id": "clka04:1000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "「なんでナチュラルにディスられてるの俺！？」"
  },
  {
   "id": "clka04:1100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "ＰＣのＵＳＢコネクタから、ビデオカメラがケーブル接続されていた。どうやら、動画のチェックをしているようだ。"
  },
  {
   "id": "clka04:1200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "이토 신지",
   "next_speaker": "오노에 세리카",
   "jp": "僕が近づくと尾上が気がついて、こちらに手を振った。"
  },
  {
   "id": "clka04:1300",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "이토 신지",
   "next_speaker": "이토 신지",
   "jp": "「あ、タク！ やっほー！」"
  },
  {
   "id": "clka04:1400",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「おお、宮代、遅かったな。お前来なかったから、もう撮ってきちまったぞ」"
  },
  {
   "id": "clka04:1500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "이토 신지",
   "next_speaker": "아리무라 히나에",
   "jp": "「え、撮ってきた？」"
  },
  {
   "id": "clka04:1600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「宮代先輩チャオっす」"
  },
  {
   "id": "clka04:1700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「いやー、バスケ部女子達のしたたる汗と弾けるふともも！ ちょーよかったっすよー！」"
  },
  {
   "id": "clka04:1800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あれを見逃すなんて宮代先輩らしくないっすねー！」"
  },
  {
   "id": "clka04:1900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "쿠루스 노노",
   "jp": "「い、いや、ちょっと待ってくれ」"
  },
  {
   "id": "clka04:2000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「遅いわよ拓留、今までなにをしてたの？」"
  },
  {
   "id": "clka04:2100",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あなた部長なんだから、部員に取材を任せっきりにしていいわけないでしょう？」"
  },
  {
   "id": "clka04:2200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "「待てってば！」"
  },
  {
   "id": "clka04:2300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "「僕はホームルームが終わってから、真っ直ぐ部室に向かったぞ」"
  },
  {
   "id": "clka04:2400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "「そしたら部室には香月しかいなかったんだ。それでトイレに……」"
  },
  {
   "id": "clka04:2500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「えー？ 今日はホームルームが終わったら体育館に集合だって、タクが言ったんじゃーん」"
  },
  {
   "id": "clka04:2600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そっすよ」"
  },
  {
   "id": "clka04:2700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "「へ？」"
  },
  {
   "id": "clka04:2800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「女子バスケット部の活動を撮影するのに、練習前の５分間しか時間貰えなかったって悔しそうに言ってたじゃない」"
  },
  {
   "id": "clka04:2900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "이토 신지",
   "jp": "「言ってた？ ぼ、僕が？」"
  },
  {
   "id": "clka04:3000",
   "type": "dialogue",
   "speaker": "伊藤真二",
   "speaker_ko": "이토 신지",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "아리무라 히나에",
   "jp": "「そうだよ。部室に一度集まる時間ももったいないから、カメラは事前にカバンに入れとけって」"
  },
  {
   "id": "clka04:3100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "이토 신지",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「あの時の宮代先輩、なんか使命感に燃えててかっこよかったっすよねー」"
  },
  {
   "id": "clka04:3200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "「ちょ、ちょっと待ってくれ」"
  },
  {
   "id": "clka04:3300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "全然覚えがない。"
  },
  {
   "id": "clka04:3400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "오노에 세리카",
   "jp": "「いつどこでそんなことを僕が言ったんだ？」"
  },
  {
   "id": "clka04:3500",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「え？ 昨日の夜に、タクのキャンピングカーでだけど？」"
  },
  {
   "id": "clka04:3600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "쿠루스 노노",
   "jp": "「僕の？」"
