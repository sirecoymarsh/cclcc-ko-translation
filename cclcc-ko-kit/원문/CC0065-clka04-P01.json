  {
   "id": "clka04:3800",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「当たり前でしょ。丸一日渋谷の街を撮影して、お疲れ様会を兼ねて」"
  },
  {
   "id": "clka04:3900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "쿠루스 노노",
   "jp": "「撮影？ それは、部活動としてか？」"
  },
  {
   "id": "clka04:4000",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留？ どうかしたの？」"
  },
  {
   "id": "clka04:4100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": null,
   "jp": "「ああ、いや、ええと……」"
  },
  {
   "id": "clka04:4200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "心配そうに僕の顔を覗き込む来栖から目を逸らしながら、必死に頭を回転させる。"
  },
  {
   "id": "clka04:4300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "昨日一体なにがあったんだ？ それはあの写真と関係があるのか？"
  },
  {
   "id": "clka04:4400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "この場で写真を見せてしまおうかとも思ったが、それはまずいだろう。"
