   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "……よし。"
  },
  {
   "id": "clka04:4800",
   "type": "dialogue",
   "speaker": "宮代拓留",
