  {
   "id": "clse07:41000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんてこと言うんですか、非モテ先輩！ 失敬なっ！」"
  },
  {
   "id": "clse07:41100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わあわあわあ！！ 来栖先輩！ それ言っちゃダメなやつー！！」"
  },
  {
   "id": "clse07:41200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ち、ちゃいますからね！ べべっ、別に、宮代先輩のために覚えたわけじゃないっすからねっ！」"
  },
  {
   "id": "clse07:41300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「へ？ あ、そ、そっか……」"
  },
  {
   "id": "clse07:41400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え、えっへん！ 実はー、それぜーんぶ、宮代先輩のために覚えたんです。どうですー？ ちょっとは雛絵ちゃんのこと気になり始めました？」"
  },
  {
   "id": "clse07:41500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ぐにゅにゅにゅにゅぅ〜！」"
  },
  {
   "id": "clse07:41600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ちゃんと逃げずに帰って来てくださいね」"
  },
  {
   "id": "clse07:41700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、おっかえりなさーいっ」"
  },
  {
   "id": "clse07:41800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よしよし、逃げずに帰って来たとは感心感心」"
  },
  {
   "id": "clse07:41900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ご飯にする？ お風呂にする？ それとも、わ・た・し？ なーんて♪」"
  },
  {
   "id": "clse07:42000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「んー？ 宮代先輩、どうしちゃったんすかぁ？」"
  },
  {
   "id": "clse07:42100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしかしてぇ、私のオンナとしての魅力にメロメロになっちゃいましたかぁ？」"
  },
  {
   "id": "clse07:42200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なにって……お料理するためにエプロンつけただけですが、何か問題でも？」"
  },
  {
   "id": "clse07:42300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、一応言っておきますけど、下にはちゃーんと水着きてますから」"
  },
  {
   "id": "clse07:42400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それじゃ、もう一回。ご飯にします？ お風呂にします？ それともわ・た・し？」"
  },
  {
   "id": "clse07:42500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あれぇ？ あれれぇ？ 宮代先輩ったら、顔真っ赤ですよぉ？ かーわいい」"
  },
  {
   "id": "clse07:42600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「別に、恥ずかしくないわけじゃないっすよ……」"
  },
  {
   "id": "clse07:42700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「でも、先輩、こういうの好きみたいだから……」"
  },
  {
   "id": "clse07:42800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だって、ほら……」"
  },
  {
   "id": "clse07:42900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うふっ」"
  },
  {
   "id": "clse07:43000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「というわけでぇ、もうすぐご飯だから待っててくださいね」"
  },
  {
   "id": "clse07:43100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「〜〜〜〜♪」"
  },
  {
   "id": "clse07:43200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふふ〜ん」"
  },
  {
   "id": "clse07:43300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はい、できましたよ〜」"
  },
  {
   "id": "clse07:43400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うふっ♪」"
  },
  {
   "id": "clse07:43500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうしました？ もしかしてギブアップですか？」"
  },
  {
   "id": "clse07:43600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？」"
  },
  {
   "id": "clse07:43700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……そ、そんなこと言って、誤魔化してもダメっすよ」"
  },
  {
   "id": "clse07:43800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふ〜ん、そうですか。でも、私はこのままでも……くちゅっ！」"
  },
  {
   "id": "clse07:43900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うぅ……じゃ、こうしましょう。先輩が雛絵ちゃんにドキドキラブハートだって言うなら服を着ます」"
  },
  {
   "id": "clse07:44000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「う……」"
  },
  {
   "id": "clse07:44100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「タンマタンマ！ やっぱいいです！ わかりました。今日は大人しく服着ます……」"
  },
  {
   "id": "clse07:44200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ！ いっけない。そういえばもう一品温めてたんだ！」"
  },
  {
   "id": "clse07:44300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はいはーい、テーブル空けてくださぁ――うおっ！」"
  },
  {
   "id": "clse07:44400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ひぁっ！」"
  },
  {
   "id": "clse07:44500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っ……！？」"
  },
  {
   "id": "clse07:44600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「い……」"
  },
  {
   "id": "clse07:44700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いやああああああああああああっ！」"
  },
  {
   "id": "clse07:44800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「と、とにかく離してください！！」"
  },
  {
   "id": "clse07:44900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あ、ちょい待った！！」"
  },
  {
   "id": "clse07:45000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ち、違ぁう！ そうじゃなくて……手、離したら丸見えになっちゃう……」"
  },
  {
   "id": "clse07:45100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お、落ち着いてなんていられるわけないでしょーが！」"
  },
  {
   "id": "clse07:45200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「せ、先輩。この鍋、放り出していいですか？」"
  },
  {
   "id": "clse07:45300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あっ！」"
  },
  {
   "id": "clse07:45400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ちょっ、っ……も、揉まないでください、よっ……っ」"
  },
  {
   "id": "clse07:45500",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だ、だって、さっきから……力入れてるじゃ……ない、ですかぁ……」"
  },
  {
   "id": "clse07:45600",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あー！ それですよ！ なんで早く言わないんですか！ 先輩のエロス！」"
  },
  {
   "id": "clse07:45700",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そんなことは良いから、早く目を瞑ってください！」"
  },
  {
   "id": "clse07:45800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
