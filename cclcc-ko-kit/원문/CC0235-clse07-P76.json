{
 "packet_id": "CC0235-clse07-P76",
 "kit_version": "1.0",
 "source_file": "clse07.msb",
 "speakers_in_packet": [
  "미야시로 타쿠루",
  "？？？"
 ],
 "context_before": [
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「別の夢？」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「なあ、その夢ってどんな――」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「似合うかなって……お前、あれ……ししっ、下着じゃないか」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「ぼ、僕はもっと清楚な感じのほうが……ってそうじゃなくて！ そもそも、結衣には似合わないだろ、あんな大人っぽいの」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「へ、へぇ……結衣もああいうのに憧れたりするんだな」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「ん？ 待て、結衣。もしかしてさっき言ってた夢って……」"
  }
 ],
 "entries": [
  {
   "id": "clse07:734400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「う、う、うう……尾上……お願いだ……お願いだよ……」"
  },
  {
   "id": "clse07:734500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「僕の……僕の願いは……っ」"
  },
  {
   "id": "clse07:734600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「う、うう……お願いだ、世莉架……誰でもいい。僕のこと……ほんの少しでも⟦rb⟧愛してくれる人⟦rt⟧⟦rbc⟧●●●●●●●⟦/r⟧を与えてよっ。僕に、その人のことを、幸せにさせてよ……っ」"
  },
  {
   "id": "clse07:734700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ええ……目覚めた直後は何度も幻覚に悩まされましたが、もう大丈夫そうです」"
  },
  {
   "id": "clse07:734800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「相当ひどい目にあわせたらしいですね」"
  },
  {
   "id": "clse07:734900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「彼自身ですよ」"
  },
  {
   "id": "clse07:735000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「大丈夫です。何をされようと、僕はあいつに屈したりはしません。今回だって、彼になかなか楽しい夢をみせてもらった――それだけのことです」"
  },
  {
   "id": "clse07:735100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「久野里さん？」"
  },
  {
   "id": "clse07:735200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……。さぁ、どうでしょうね？」"
  },
  {
   "id": "clse07:735300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「………」"
  },
  {
   "id": "clse07:735400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしも久野里さんだったら？」"
  },
  {
   "id": "clse07:735500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「他のみんなは？ 大丈夫なんですか？」"
  },
  {
   "id": "clse07:735600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「そうですか、良かった」"
  },
  {
   "id": "clse07:735700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「完治するまで、伊藤のことよろしくお願いします」"
  },
  {
   "id": "clse07:735800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「あと、その……」"
  },
  {
   "id": "clse07:735900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「………」"
  },
  {
   "id": "clse07:736000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「………。ありがとうございます」"
  },
  {
   "id": "clse07:736100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「はい。それじゃあ、また」"
  },
  {
   "id": "clse07:736200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「これからもみんなのこと、よろしく頼むな。僕のせいで悲しくなったり、寂しくなったり……そんなことがないように」"
  },
  {
   "id": "clse07:736300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "？？？",
   "jp": "「あと、僕のことは早く忘れて、楽しく生きて行ってほしい。僕の大好きな、姉さん」"
  },
  {
   "id": "clse07:736400",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「おいおい。いい加減、しっかりしてくれよな、尾上」"
  },
  {
   "id": "clse07:736500",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうやってお前が泣いてたら、いつまでたっても安心できないじゃないか、僕は」"
  },
  {
   "id": "clse07:736600",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「それにな、お前が泣いてても、ちっとも可愛くないんだよ。鼻水をふけ、鼻水を」"
  },
  {
   "id": "clse07:736700",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「いつも言ってるだろ？ お前はアホみたいに笑ってる顔が一番だって」"
  },
  {
   "id": "clse07:736800",
   "type": "dialogue",
   "speaker": "？？？",
   "speaker_ko": "？？？",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「そうそう、そうやってすねてる顔も可愛らしいぞ。だから、泣き顔だけはやめろよ？ ほんと、似合わないからな？」"
  },
  {
   "id": "clse07:736900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「ああ、尾上か。お前も部室だろ？」"
  },
  {
   "id": "clse07:737000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「は？ なんでだよ？」"
  },
  {
   "id": "clse07:737100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「なるほどな……有村がそんな風に言うってことは、一緒に遊びに行くってことか……」"
  },
  {
   "id": "clse07:737200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「ふたり？」"
  },
  {
   "id": "clse07:737300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「うわっ！」"
  },
  {
   "id": "clse07:737400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「いや、遠慮する……」"
  },
  {
   "id": "clse07:737500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「……ってことは、もしかして来栖も……？」"
  },
  {
   "id": "clse07:737600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "？？？",
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:737700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「まったく、尾上も来栖も香月も有村もうきも、みんなもうちょっと部活に本腰を入れてもらわないと困るよ」"
  },
  {
   "id": "clse07:737800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「みんな休むって。というわけで、今日は実質活動休止ってとこだ」"
  },
  {
   "id": "clse07:737900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんだよ。帰ってもいいんだぞ？」"
  },
  {
   "id": "clse07:738000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふん、暇なやつ」"
  },
  {
   "id": "clse07:738100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「バカいうな。僕にはやることが山ほどある」"
  },
  {
   "id": "clse07:738200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おい、寝るなら帰って寝ろよ」"
  },
  {
   "id": "clse07:738300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふわぁ……」"
  },
  {
   "id": "clse07:738400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うっ……」"
  },
  {
   "id": "clse07:738500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「――！！？」"
  },
  {
   "id": "clse07:738600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「また渋谷地震みたいなやつかな」"
  },
  {
   "id": "clse07:738700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうだ。とりあえず、状況を……」"
  },
  {
   "id": "clse07:738800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……しまった。スマホ、教室に忘れてきた」"
  },
  {
   "id": "clse07:738900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おい、まさか……」"
  },
  {
   "id": "clse07:739000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「だったら僕も行くよ」"
  },
  {
   "id": "clse07:739100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あれ？ 開かない……」"
  },
  {
   "id": "clse07:739200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もしかして、今の地震で立て付けが歪んだのか？」"
  },
  {
   "id": "clse07:739300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「よし、行くぞ。せーのっ！！」"
  },
  {
   "id": "clse07:739400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……あれ？」"
  },
  {
   "id": "clse07:739500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「停電？」"
  },
  {
   "id": "clse07:739600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうやら、この学校だけ停電しちゃったみたいだな」"
  },
  {
   "id": "clse07:739700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「おい、ってことは……」"
  },
  {
   "id": "clse07:739800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ＰＣもダメだ……。ていうか、こういう時のために、ノパソにするべきだろ普通」"
  },
  {
   "id": "clse07:739900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……どうするって言っても……どうしよもないだろ。誰かが気づいてくれるまで、ここにいるしか」"
  },
  {
   "id": "clse07:740000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それはこっちの台詞だ」"
  },
  {
   "id": "clse07:740100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……確かに」"
  },
  {
   "id": "clse07:740200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そうだ！ 確か……」"
  },
  {
   "id": "clse07:740300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「昼に食べきれなくて残したんだ」"
  },
  {
   "id": "clse07:740400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「誰もやるとは言ってないぞ」"
  },
  {
   "id": "clse07:740500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「友達ならな」"
  },
  {
   "id": "clse07:740600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:740700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……わかったよ。半分やるよ！」"
  },
  {
   "id": "clse07:740800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そんなもの欲しそうな顔して見られたら、ひとりで食うわけにもいかないだろ！」"
  },
  {
   "id": "clse07:740900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どうだ。ツナサンドも結構いけるだろ？」"
  },
  {
   "id": "clse07:741000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っ……返せ！ お前にやるサンドイッチはない！！」"
  },
  {
   "id": "clse07:741100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そういえば、知ってるか？ うちの学校にまつわる怪談……」"
  },
  {
   "id": "clse07:741200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「夜中に部屋の前を歩く、水に濡れたような足音……聞けば１０年前にプールで死んだ女生徒が……」"
  },
  {
   "id": "clse07:741300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:741400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:741500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:741600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なんで、近寄ってんだよ！！」"
  },
  {
   "id": "clse07:741700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「あんな話は嘘だよ。そもそも１０年前にこの学校無いだろ」"
  },
  {
   "id": "clse07:741800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「悪かったよ。だから、もう寝ろって」"
  },
  {
   "id": "clse07:741900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………」"
  },
  {
   "id": "clse07:742000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「誰が好き好んで聞くかよ」"
  },
  {
   "id": "clse07:742100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「わかってるから、さっさとやれよ！」"
  },
  {
   "id": "clse07:742200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「やめとけって……もう何回も試しただろ」"
  },
  {
   "id": "clse07:742300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「とにかく、明日まで待とう。そうすれば、学校が始まって、先生も生徒も来るはずだ……」"
  },
  {
   "id": "clse07:742400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「どういうことだよ？」"
  },
  {
   "id": "clse07:742500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「とにかく……ここで騒いでも、何にもならないんだから……くしゅっ！！」"
  },
  {
   "id": "clse07:742600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いや、なんでもない……」"
  },
  {
   "id": "clse07:742700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「え？」"
  },
  {
   "id": "clse07:742800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「お、お前……」"
  },
  {
   "id": "clse07:742900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「な、なんでわざわざ熱計るのに、おでこくっつけるんだよ！？」"
  },
  {
   "id": "clse07:743000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いやいや、親とか兄弟ならまだしも、男同士でやらないだろ！」"
  },
  {
   "id": "clse07:743100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こ、これくらい、なんともない。寝たら治るよ」"
  },
  {
   "id": "clse07:743200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そんなこと言ったって、この状況じゃ、どうすることもできないだろ」"
  },
  {
   "id": "clse07:743300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「っ……とにかく、明日までの辛抱だし、僕はもう寝るよ」"
  },
  {
   "id": "clse07:743400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ふぅ……」"
  },
  {
   "id": "clse07:743500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うぅ〜……」"
  },
  {
   "id": "clse07:743600",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ぅ〜……」"
  },
  {
   "id": "clse07:743700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ウぅ〜……」"
  },
  {
   "id": "clse07:743800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「伊藤……お前、何やって……」"
  },
  {
   "id": "clse07:743900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「…………おい、まさか……」"
  },
  {
   "id": "clse07:744000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「伊藤……」"
  },
  {
   "id": "clse07:744100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「いやいやいや！ 冗談じゃない！ 誰が好き好んで男と裸で抱き合わなきゃいけないんだ！ 僕なら大丈夫――ゲホッ、ゲホッ！」"
  },
  {
   "id": "clse07:744200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「ま、待って……」"
  },
  {
   "id": "clse07:744300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……自分で……脱ぐから……」"
  }
