   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미나미사와 센리",
   "jp": "⟦top:38⟧それを雛絵が追いかける。"
  },
  {
   "id": "clzz05:35800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미나미사와 센리",
   "jp": "⟦top:38⟧そんな二人をニコニコと眺めながら、他のみんなも出口に向かった。"
