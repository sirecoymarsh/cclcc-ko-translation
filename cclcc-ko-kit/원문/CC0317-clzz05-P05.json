   "id": "clzz05:34700",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "타치바나 유토",
   "next_speaker": "아리무라 히나에",
   "jp": "「私も」"
