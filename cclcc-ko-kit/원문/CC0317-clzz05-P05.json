  {
   "id": "clzz05:36200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미나미사와 센리",
   "jp": "⟦top:38⟧その廊下の一番奥に、誰かが立っているような気がしたのだ。"
  },
  {
   "id": "clzz05:36300",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓、留……？」"
  },
  {
   "id": "clzz05:36400",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留、なの？」"
