   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "야마조에 우키",
   "next_speaker": "카즈키 하나",
   "jp": "「そっか……じゃあ、おじゃましちゃおっかな〜、えへへ」"
