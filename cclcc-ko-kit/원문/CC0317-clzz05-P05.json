   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「あ、でもひとつだけ条件があります。寝る時は、ひなさんと別の部屋でお願いします」"
  },
  {
   "id": "clzz05:35000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「ええ〜っ！？ なんで〜！？」"
