  {
   "id": "clzz05:35100",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「だって、ベタベタくっつかれると眠れないから」"
