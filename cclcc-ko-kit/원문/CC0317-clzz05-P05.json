   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "야마조에 우키",
   "jp": "「あれ〜、どうかしたんすか、先輩！？」"
  },
  {
   "id": "clzz05:37300",
   "type": "dialogue",
   "speaker": "山添うき",
   "speaker_ko": "야마조에 우키",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미나미사와 센리",
   "jp": "「姉さん！？」"
  },
  {
   "id": "clzz05:37400",
   "type": "dialogue",
   "speaker": "南沢泉理",
   "speaker_ko": "미나미사와 센리",
   "prev_speaker": "야마조에 우키",
   "next_speaker": null,
   "jp": "「えっ！？ う、ううん、なんでもないわ！ 忘れ物をしたかもって思っただけ。今、行くわ」"
  },
  {
   "id": "clzz05:37500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": null,
