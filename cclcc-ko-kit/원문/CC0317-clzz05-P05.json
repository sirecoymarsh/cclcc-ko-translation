   "id": "clzz05:35200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「誰もくっついたりせんわ！」"
  },
  {
   "id": "clzz05:35300",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "아리무라 히나에",
   "jp": "「ウソ。なんかあちこち触ってくるし。同じ部屋で寝たら、貞操の危機を感じるので」"
  },
  {
   "id": "clzz05:35400",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미나미사와 센리",
   "jp": "「ほー？ 分かった。そこまで言うんなら、本当に貞操を奪ってやるからな。覚悟しとけ」"
  },
  {
   "id": "clzz05:35500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미나미사와 센리",
   "jp": "少しだけむくれた雛絵が、わざと華に抱きつこうとする。"
  },
  {
   "id": "clzz05:35600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "미나미사와 센리",
   "jp": "華は楽しそうに笑ってベンチを立つと、ロビーの出口へ向かってタッと逃げ出した。"
