   "id": "clzz05:36500",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미나미사와 센리",
   "next_speaker": "미야시로 타쿠루",
   "jp": "しかし、廊下の奥に立っている影は何も答えない。"
