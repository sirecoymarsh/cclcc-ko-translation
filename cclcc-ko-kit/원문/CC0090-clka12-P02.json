   "id": "clka12:13200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「はあん、宮代先輩って、顔に似合わずケダモノなんですねえ」"
  },
  {
   "id": "clka12:13300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "아리무라 히나에",
   "next_speaker": "이토 신지",
   "jp": "「ひいいいいいいいっ！！！！！！！！」"
