   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "いつの間にか香月は窓際のＰＣに座り、いつものように⟦col:280aa02d1400⟧エンスー⟦col:800000⟧を始めていた。"
  },
  {
   "id": "clka12:15000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "쿠루스 노노",
   "jp": "「か、香月！」"
  },
  {
   "id": "clka12:15100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "僕が窓際に駆け寄ろうとしたその時、"
  },
  {
   "id": "clka12:15200",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
