  {
   "id": "clka12:11000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "きっと、今僕の横で、耳まで真っ赤にしながらロリポップの棒をブンブン動かしているこの女の子も。"
  },
  {
   "id": "clka12:11100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "きっと、同じ気持ちなのだと、思う。"
  },
  {
   "id": "clka12:11200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "二人で部室の入り口に立ち、自然に、二人でノブを握った。"
  },
  {
   "id": "clka12:11300",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": null,
   "next_speaker": "카즈키 하나",
   "jp": "「これからも、よろしくな、香月」"
  },
  {
   "id": "clka12:11400",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……」"
  },
  {
   "id": "clka12:11500",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……ん」"
  },
  {
   "id": "clka12:11600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "部室には、伊藤、乃々、世莉架、雛絵が揃っていた。伊藤が座っている席に３人が集まり、なにやら話し込んでいる。"
  },
  {
   "id": "clka12:11700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「みんな、昨日はありがとう。助かったよ。な？」"
  },
  {
   "id": "clka12:11800",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ん」"
  },
  {
   "id": "clka12:11900",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「それで、実はみんなに報告したいことがあって。な？」"
  },
  {
   "id": "clka12:12000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ん」"
  },
  {
   "id": "clka12:12100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "쿠루스 노노",
   "jp": "「わざわざ報せるのもどうかと思うんだけど、みんなには手伝ってもらったわけだし――」"
  },
  {
   "id": "clka12:12200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "쿠루스 노노",
   "jp": "「――ん？」"
  },
  {
   "id": "clka12:12300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "誰も、僕の話を聞いていない。伊藤が持っているなにかを見ながら喋っている。"
  },
  {
   "id": "clka12:12400",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "쿠루스 노노",
   "jp": "「なあ、みんな――」"
  },
  {
   "id": "clka12:12500",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ふうん、『来栖はツンデレが過ぎるので、もう少し年上のお姉さん的な余裕のあるエロさを醸し出せると良い』ねえ」"
  },
  {
   "id": "clka12:12600",
   "type": "dialogue",
   "speaker": "来栖乃々",
   "speaker_ko": "쿠루스 노노",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「拓留ってば、姉に対してそういう劣情を感じてたわけねえ」"
  },
  {
   "id": "clka12:12700",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "쿠루스 노노",
   "next_speaker": "오노에 세리카",
   "jp": "「ひっ！！！」"
  },
  {
   "id": "clka12:12800",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「『尾上は、エロ知識のなさとガードの弱さから、気がつくと幼なじみ系エロ展開に持ち込めるかもしれない』」"
  },
  {
   "id": "clka12:12900",
   "type": "dialogue",
   "speaker": "尾上世莉架",
   "speaker_ko": "오노에 세리카",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「タク、幼なじみ系エロ展開って、なに？」"
  },
  {
   "id": "clka12:13000",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "오노에 세리카",
   "next_speaker": "아리무라 히나에",
