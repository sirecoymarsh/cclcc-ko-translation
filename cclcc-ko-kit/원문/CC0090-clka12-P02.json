  },
  {
   "id": "clka12:10700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "傍にいてあげられなくても、この世界のどこかにその人がいると思える。"
  },
  {
   "id": "clka12:10800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
   "jp": "それが、とても素敵なことなんだと、今、僕は知っている。"
  },
  {
   "id": "clka12:10900",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": null,
   "next_speaker": "미야시로 타쿠루",
