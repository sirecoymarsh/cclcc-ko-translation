   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「どこがだよっ！」"
  },
  {
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "jp": "「ぐ……」"
