  {
   "id": "clse07:952600",
   "type": "dialogue",
   "speaker": "橘結衣",
   "speaker_ko": "타치바나 유이",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「うん……ぜったい来てくれるって思ってた……」"
  },
  {
   "id": "clse07:952700",
