  {
   "id": "claa05:13400",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "여자",
   "next_speaker": "쿠노사토 미오",
   "jp": "カツーン……ズルリ……。"
