  {
   "id": "claa05:12700",
   "type": "dialogue",
   "speaker": "神成岳志",
   "speaker_ko": "신조 타케시",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "쿠루스 노노",
   "jp": "「二人を連れて逃げろ、宮代くんっ。早くっ」"
