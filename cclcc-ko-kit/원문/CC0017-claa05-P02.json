   "id": "claa05:13200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "여자",
   "next_speaker": "쿠노사토 미오",
   "jp": "女は、まるでゾンビ映画のワンシーンのように、片足を引きずりながらさらに僕たちのほうへと向かってくる。"
  },
