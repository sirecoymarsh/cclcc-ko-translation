   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "여자",
   "jp": "女はなぜか僕をずっと見つめたまま、ザラザラとした不快な声でこう言った。"
  },
  {
   "id": "claa05:12200",
   "type": "dialogue",
   "speaker": "女",
   "speaker_ko": "여자",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「……お前……死ね……」"
