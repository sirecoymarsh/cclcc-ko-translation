   "id": "clse07:71000",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「こんど、家に来てくれませんか？」"
  },
  {
   "id": "clse07:71100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「はい。兄が一度会ってみたいって……」"
  },
  {
   "id": "clse07:71200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「雛絵の好きな相手がどんな奴か、俺が見定めてやるって」"
  },
