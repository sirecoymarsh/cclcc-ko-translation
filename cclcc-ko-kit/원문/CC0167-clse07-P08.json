   "id": "clse07:73200",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「もちろん、将来的にちゃんと責任とってくれるなら、だけど」"
  },
  {
   "id": "clse07:73300",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「なーんて、冗談ですよ、冗談」"
