   "id": "clse07:70800",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「そんなこと言って、最初からそのつもりだったんでしょ？」"
  },
  {
   "id": "clse07:70900",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「……先輩……お願いがあるんですけど……」"
