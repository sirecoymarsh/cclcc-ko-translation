   "id": "clse07:73100",
   "type": "dialogue",
   "speaker": "有村雛絵",
   "speaker_ko": "아리무라 히나에",
   "prev_speaker": null,
   "next_speaker": null,
   "jp": "「それにね。本当はママも認めてくれてるの」"
  },
