  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「ここまで来たんだから楽しみましょうよう！ 滅多に着れる物じゃないですよ」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「んふ。ありがとうございます♪」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「ほら先輩、もっと笑ってくださいよ」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「んふ！ そうですかあ？」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「ですって、宮代先輩！」"
  },
  {
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "jp": "「ほら先輩！ もっと笑って！」"
  }
 ],
 "entries": [
  {
   "id": "clse07:224200",
