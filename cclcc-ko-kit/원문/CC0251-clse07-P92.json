 "context_before": [
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「雛絵！ 今は宮代さんに聞いてるの！」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「は？ なんなのいきなり。どうしてまた……」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「もちろん帰って来るなら、文句はないわ」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「でも、理由を説明しなさい、理由を。これまで散々心配かけておいて、説明もなしにいきなり帰るなんて、こっちだってわけがわからないわ」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「よくないわよ。こないだはふたり口裏あわせて、妙なこと言ってたけど、あの遊びはもう終わりってこと？」"
  },
  {
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "jp": "「気まぐれも結構だけど、それに付き合わされる人のことも少しは考えたらどう？ くだらない嘘に付き合わされた宮代さんもいい迷惑よね」"
  }
 ],
 "entries": [
  {
   "id": "clse07:869500",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": null,
   "next_speaker": "카메라맨",
   "jp": "「いいのよ、はっきり言ってあげて。そうじゃないと、この子、わからないんだから」"
  },
  {
   "id": "clse07:869600",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": null,
   "next_speaker": "카메라맨",
   "jp": "「…………？」"
  },
  {
   "id": "clse07:869700",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": null,
   "next_speaker": "카메라맨",
   "jp": "「……なんなのよ、いったい」"
  },
  {
   "id": "clse07:869800",
   "type": "dialogue",
   "speaker": "有村恵美",
   "speaker_ko": "아리무라 에미",
   "prev_speaker": null,
   "next_speaker": "카메라맨",
   "jp": "「迷惑かけたわね。ごめんなさい……」"
  },
  {
   "id": "clse07:869900",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "「はーい、こっち向いて笑ってくださーい」"
  },
  {
   "id": "clse07:870000",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "「そっちの彼女、いい笑顔だね！ 衣装も凄い似合ってる！」"
  },
  {
   "id": "clse07:870100",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "「んー、彼氏の方は表情堅いなー。もっとリラックスして行こうよ！」"
  },
  {
   "id": "clse07:870200",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "「ほら彼氏さん、笑って笑って！ 折角の二人の新しい門出だよ！」"
  },
  {
   "id": "clse07:870300",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "「あ、もっと雰囲気出した方が気分乗るかな？ そっちで行ってみようか」"
  },
  {
   "id": "clse07:870400",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": null,
   "jp": "「幸せそうな笑顔をください！ ⟦rb⟧新郎新婦の⟦rt⟧⟦rbc⟧●●●●●⟦/r⟧⟦rb⟧お二人さん⟦rt⟧⟦rbc⟧●●●●●⟦/r⟧！」"
  },
  {
   "id": "clse07:870500",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미나미카타 켄지",
   "jp": "「いやあ、彼女さんは花嫁衣装が似合うねえ！ とても１６歳には見えない大人の色気を醸しだしてるよ！」"
  },
  {
   "id": "clse07:870600",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "아리무라 에미",
   "next_speaker": "미나미카타 켄지",
   "jp": "「うーん、逆に、彼氏さんの方は、正直あんまり似合ってないね。アッハッハ！」"
  },
  {
   "id": "clse07:870700",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": null,
   "next_speaker": "미나미카타 켄지",
   "jp": "「お、いいねいいね！ 彼女さん、そうやってどんどん彼氏さんを誘惑しちゃって！」"
  },
  {
   "id": "clse07:870800",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": null,
   "next_speaker": "미나미카타 켄지",
   "jp": "「よーし、じゃあ次はアレ行っちゃおうか！」"
  },
  {
   "id": "clse07:870900",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": null,
   "next_speaker": "미나미카타 켄지",
   "jp": "「アレだよアレ。誓いのキッス！」"
  },
  {
   "id": "clse07:871000",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": null,
   "next_speaker": "미나미카타 켄지",
   "jp": "「おお！ 彼女さんは積極的でいいねえ！」"
  },
  {
   "id": "clse07:871100",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": null,
   "next_speaker": "미나미카타 켄지",
   "jp": "「ほら彼氏さん！ バッチリ撮るから、一気にいっちゃえ！」"
  },
  {
   "id": "clse07:871200",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": null,
   "next_speaker": "미나미카타 켄지",
   "jp": "「いいねー！ 予定とはちょっと違ったけど、これはこれで幸せな家庭を感じさせる良い写真になるよ！ あっはっはっは！」"
  },
  {
   "id": "clse07:871300",
   "type": "dialogue",
   "speaker": "南方謙二",
   "speaker_ko": "미나미카타 켄지",
   "prev_speaker": "카메라맨",
   "next_speaker": "의사",
   "jp": "「真の漢ってのはな、本当に惚れるべき女が現れるまで、他の女の色香になんざ惑わされないものだぜ。なぁ？」"
  },
  {
   "id": "clse07:871400",
   "type": "dialogue",
   "speaker": "医師",
   "speaker_ko": "의사",
   "prev_speaker": "미나미카타 켄지",
   "next_speaker": "교사",
   "jp": "「久野里さん、どうです？ 視界のどこかに異常を感じたりは？」"
  },
  {
   "id": "clse07:871500",
   "type": "dialogue",
   "speaker": "医師",
   "speaker_ko": "의사",
   "prev_speaker": "미나미카타 켄지",
   "next_speaker": "교사",
   "jp": "「耳は両方ともきちんと聞こえていますか？ 耳鳴りは？」"
  },
  {
   "id": "clse07:871600",
   "type": "dialogue",
   "speaker": "医師",
   "speaker_ko": "의사",
   "prev_speaker": "미나미카타 켄지",
   "next_speaker": "교사",
   "jp": "「そうですか。どこにも問題なさそうですね。たぶん疲れによるものでしょう。念のため、点滴をしておきますね」"
  },
  {
   "id": "clse07:871700",
   "type": "dialogue",
   "speaker": "教師",
   "speaker_ko": "교사",
   "prev_speaker": "의사",
   "next_speaker": "남학생",
   "jp": "「ん？ もう時間か。それじゃあ今日はここまで」"
  },
  {
   "id": "clse07:871800",
   "type": "dialogue",
   "speaker": "教師",
   "speaker_ko": "교사",
   "prev_speaker": "의사",
   "next_speaker": "남학생",
   "jp": "「それじゃあ、今日の授業はここまで。ちゃんと復習しておくように」"
  },
  {
   "id": "clse07:871900",
   "type": "dialogue",
   "speaker": "男子生徒",
   "speaker_ko": "남학생",
   "prev_speaker": "교사",
   "next_speaker": null,
   "jp": "「マジかよ〜！」"
  },
  {
