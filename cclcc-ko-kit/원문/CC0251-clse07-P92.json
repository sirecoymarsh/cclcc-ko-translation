   "id": "clse07:875300",
   "type": "dialogue",
   "speaker": "男子生徒",
   "speaker_ko": "남학생",
   "prev_speaker": null,
   "next_speaker": "남자",
   "jp": "「おい、雅司。何やってんだよ。早く行かないと売り切れんぞ！」"
  },
  {
   "id": "clse07:875400",
   "type": "dialogue",
   "speaker": "男子生徒",
   "speaker_ko": "남학생",
   "prev_speaker": null,
   "next_speaker": "남자",
   "jp": "「は？ いらなくなったって、なんでだよ？」"
  },
  {
   "id": "clse07:875500",
   "type": "dialogue",
   "speaker": "男子生徒",
   "speaker_ko": "남학생",
   "prev_speaker": null,
   "next_speaker": "남자",
   "jp": "「は？ なんだよそれ。もしかしてお前……」"
  },
  {
   "id": "clse07:875600",
   "type": "dialogue",
   "speaker": "男子生徒",
   "speaker_ko": "남학생",
   "prev_speaker": null,
   "next_speaker": "남자",
   "jp": "「なに勿体ぶってんだよ。早く教えろよ！」"
  },
  {
   "id": "clse07:875700",
   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "남학생",
   "next_speaker": "학생회 임원",
   "jp": "「あれ？ なあ……今のヤツ、アレじゃね？ 昔、アイドルのプロデューサーとかやってた……」"
  },
  {
   "id": "clse07:875800",
   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "남학생",
   "next_speaker": "학생회 임원",
   "jp": "「だよな。一瞬だけ売れかけたアイドルで、その後すぐ消えたし」"
  },
  {
   "id": "clse07:875900",
   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "남학생",
   "next_speaker": "학생회 임원",
   "jp": "「は？ 誰それ？ 知らね」"
  },
  {
   "id": "clse07:876000",
   "type": "dialogue",
   "speaker": "男",
   "speaker_ko": "남자",
   "prev_speaker": "남학생",
   "next_speaker": "학생회 임원",
   "jp": "「ンなヤツ、知るわけねーって」"
  },
  {
   "id": "clse07:876100",
   "type": "dialogue",
   "speaker": "生徒会役員",
   "speaker_ko": "학생회 임원",
   "prev_speaker": "남자",
   "next_speaker": "점원",
   "jp": "「生徒の皆さんにお伝えします。本日放課後、臨時の生徒集会を行います」"
  },
  {
   "id": "clse07:876200",
   "type": "dialogue",
   "speaker": "生徒会役員",
   "speaker_ko": "학생회 임원",
   "prev_speaker": "남자",
   "next_speaker": "점원",
   "jp": "「放課後になりましたら、生徒の皆さんは体育館に集まってください。繰り返します……」"
  },
  {
   "id": "clse07:876300",
   "type": "dialogue",
   "speaker": "店員",
   "speaker_ko": "점원",
   "prev_speaker": "학생회 임원",
   "next_speaker": "선도부원",
   "jp": "「アリガトゴザイマシター」"
  },
  {
   "id": "clse07:876400",
   "type": "dialogue",
   "speaker": "店員",
   "speaker_ko": "점원",
   "prev_speaker": "학생회 임원",
   "next_speaker": "선도부원",
   "jp": "「アリガトゴザイマシター」"
  },
  {
   "id": "clse07:876500",
   "type": "dialogue",
   "speaker": "風紀委員",
   "speaker_ko": "선도부원",
   "prev_speaker": "점원",
   "next_speaker": "히카리",
   "jp": "「おい、見つけたぞ！ あそこだ！」"
  },
  {
   "id": "clse07:876600",
   "type": "dialogue",
   "speaker": "風紀委員",
   "speaker_ko": "선도부원",
   "prev_speaker": "점원",
   "next_speaker": "히카리",
   "jp": "「おい、君たち！！ そこでコソコソなにしている！！」"
  },
  {
   "id": "clse07:876700",
   "type": "dialogue",
   "speaker": "風紀委員",
   "speaker_ko": "선도부원",
   "prev_speaker": "점원",
   "next_speaker": "히카리",
   "jp": "「……どれ……指輪か……アウトだな」"
  },
  {
   "id": "clse07:876800",
   "type": "dialogue",
   "speaker": "風紀委員",
   "speaker_ko": "선도부원",
   "prev_speaker": "점원",
   "next_speaker": "히카리",
   "jp": "「よし、行くぞ！」"
  },
  {
   "id": "clse07:876900",
   "type": "dialogue",
   "speaker": "風紀委員",
   "speaker_ko": "선도부원",
   "prev_speaker": "점원",
   "next_speaker": "히카리",
   "jp": "「つまり、誕生日のプレゼントをやりとりするような仲ということだな」"
  },
  {
   "id": "clse07:877000",
   "type": "dialogue",
   "speaker": "風紀委員",
   "speaker_ko": "선도부원",
   "prev_speaker": "점원",
   "next_speaker": "히카리",
   "jp": "「よし、ふたりとも、生徒会室に来てもらおう」"
  },
  {
   "id": "clse07:877100",
   "type": "dialogue",
   "speaker": "ひかり",
   "speaker_ko": "히카리",
   "prev_speaker": "선도부원",
   "next_speaker": null,
   "jp": "「（泣き声）」"
  },
  {
