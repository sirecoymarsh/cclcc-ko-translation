  {
   "id": "clka09:15200",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카메라맨",
   "jp": "「……む、り」"
