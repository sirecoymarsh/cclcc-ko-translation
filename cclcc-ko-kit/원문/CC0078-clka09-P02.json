  {
   "id": "clka09:18700",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ほら彼氏さん！ バッチリ撮るから、一気にいっちゃえ！」"
  },
  {
   "id": "clka09:18800",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
