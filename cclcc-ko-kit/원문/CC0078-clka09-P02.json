   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카메라맨",
   "jp": "僕はどうしていいのか分からず、人形みたいに『華』に操られるしかなかった。"
  },
  {
   "id": "clka09:17700",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「よーし、じゃあ次はアレ行っちゃおうか！」"
