   "speaker_ko": null,
   "prev_speaker": "카메라맨",
   "next_speaker": "카메라맨",
   "jp": "『華』が選んだのは、よりにもよって結婚式の新郎新婦の衣装だった。"
  },
  {
   "id": "clka09:15700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카메라맨",
   "next_speaker": "카메라맨",
   "jp": "『華』は純白のウェディングドレスに包まれ、ベールごしに満面の笑みをカメラマンに向けている。"
  },
  {
   "id": "clka09:15800",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "「いやあ、彼女さんは花嫁衣装が似合うねえ！ とても１６歳には見えない大人の色気を醸しだしてるよ！」"
  },
  {
   "id": "clka09:15900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "카메라맨",
   "next_speaker": "카메라맨",
   "jp": "「んふ！ そうですかあ？」"
  },
  {
   "id": "clka09:16000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "카메라맨",
   "next_speaker": "카메라맨",
   "jp": "「ですって、宮代先輩！」"
  },
  {
   "id": "clka09:16100",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카메라맨",
   "jp": "確かに、肩や胸元が開いているウェディングドレスは、香月のスタイルの良さを引き出していて、いつもより『女』が強調されて見えた。"
  },
  {
   "id": "clka09:16200",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카메라맨",
   "jp": "顔も、少しだけメイクしてもらったらしく、頬が少しだけピンクに染まっている。"
  },
  {
   "id": "clka09:16300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카메라맨",
   "jp": "正直、見つめていると鼓動が早くなる気がして、あまり長く正視できなかった。"
  },
  {
   "id": "clka09:16400",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「うーん、逆に、彼氏さんの方は、正直あんまり似合ってないね。アッハッハ！」"
  },
  {
   "id": "clka09:16500",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카메라맨",
   "next_speaker": "카즈키 하나",
   "jp": "（悪かったな！）"
  },
  {
   "id": "clka09:16600",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "僕も白のモーニングを着ていたが、自分でもわかるほど似合っていなかった。"
  },
  {
   "id": "clka09:16700",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "猫背のせいか、どのサイズの物でも腕や腰回りのどこかしらが足りなかったり余ったりして、ちぐはぐになってしまう。"
  },
  {
   "id": "clka09:16800",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카즈키 하나",
   "jp": "鏡に映る姿を見たメイクの人が『七五三みたいですね』と言った時、僕も同じ事を思っていたくらいだ。"
  },
  {
   "id": "clka09:16900",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "미야시로 타쿠루",
   "next_speaker": "카메라맨",
   "jp": "「ほら先輩！ もっと笑って！」"
  },
  {
   "id": "clka09:17000",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카메라맨",
   "jp": "『華』が組んでいる腕をぎゅっと抱きしめる。シルクごしに二の腕や胸の感触が伝わってきて、余計に緊張してしまう。"
  },
  {
   "id": "clka09:17100",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「お、いいねいいね！ 彼女さん、そうやってどんどん彼氏さんを誘惑しちゃって！」"
  },
  {
   "id": "clka09:17200",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "카메라맨",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「任せてください！」"
