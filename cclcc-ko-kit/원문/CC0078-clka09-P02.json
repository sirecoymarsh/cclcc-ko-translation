   "next_speaker": "미야시로 타쿠루",
   "jp": "「アレだよアレ。誓いのキッス！」"
  },
  {
   "id": "clka09:18100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카메라맨",
