  {
   "id": "clka09:15000",
   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "카메라맨",
   "next_speaker": "미야시로 타쿠루",
   "jp": "「ほら先輩、もっと笑ってくださいよ」"
  },
  {
   "id": "clka09:15100",
   "type": "dialogue",
   "speaker": "宮代拓留",
   "speaker_ko": "미야시로 타쿠루",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카메라맨",
