  {
   "id": "clka09:18300",
   "type": "narration",
   "speaker": null,
   "speaker_ko": null,
   "prev_speaker": "카즈키 하나",
   "next_speaker": "미야시로 타쿠루",
   "jp": "そう言って『華』は、顔に懸かっていたベールをめくり、アゴを少しだけ上げて、静かに瞳を閉じた。"
  },
