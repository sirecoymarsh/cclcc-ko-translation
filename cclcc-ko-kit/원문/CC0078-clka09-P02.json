   "type": "dialogue",
   "speaker": "香月華",
   "speaker_ko": "카즈키 하나",
   "prev_speaker": "카메라맨",
   "next_speaker": "카메라맨",
   "jp": "「んふ。ありがとうございます♪」"
  },
  {
   "id": "clka09:14900",
   "type": "dialogue",
   "speaker": "カメラマン",
   "speaker_ko": "카메라맨",
   "prev_speaker": "카즈키 하나",
   "next_speaker": "카즈키 하나",
   "jp": "「んー、彼氏の方は表情堅いなー。もっとリラックスして行こうよ！」"
