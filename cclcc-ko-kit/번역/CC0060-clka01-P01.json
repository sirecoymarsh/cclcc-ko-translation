[
{"id": "clka01:0", "ko": "……"},
{"id": "clka01:100", "ko": "…………"},
{"id": "clka01:200", "ko": "………………"},
{"id": "clka01:300", "ko": "（음……）"},
{"id": "clka01:400", "ko": "……"},
{"id": "clka01:500", "ko": "…………"},
{"id": "clka01:600", "ko": "………………"},
{"id": "clka01:700", "ko": "（으음……）"},
{"id": "clka01:800", "ko": "「…………」"},
{"id": "clka01:900", "ko": "침대 위에서 눈을 뜬다."},
{"id": "clka01:1000", "ko": "냉장고 위에 놓인 자명종 시계가 기상 시각을 알리는 알람을 울리고 있다."},
{"id": "clka01:1100", "ko": "「…………」"},
{"id": "clka01:1200", "ko": "「……오늘은, 월요일……」"},
{"id": "clka01:1300", "ko": "아름다운 휴일은 몇 시간 전에 끝을 고했고, 오늘부터 또 5일 동안은 학교에 다녀야 한다."},
{"id": "clka01:1400", "ko": "「…………」"},
{"id": "clka01:1500", "ko": "「……일어나야지……」"},
{"id": "clka01:1600", "ko": "자명종은 아침을 먹으면서 교복으로 갈아입고, 거기에 인터넷 정기 순찰까지 한 뒤에 등교해도 지각하지 않는 아슬아슬한 시각에 맞춰 두었다."},
{"id": "clka01:1700", "ko": "즉, 바로 일어나야 한다. 그건 내 몸에 이미 새겨진 일과였다."},
{"id": "clka01:1800", "ko": "그런데."},
{"id": "clka01:1900", "ko": "「…………?」"},
{"id": "clka01:2000", "ko": "몸이 생각대로 움직이지 않는다."},
{"id": "clka01:2100", "ko": "머리가 몹시 멍하다."},
{"id": "clka01:2200", "ko": "아직 자고 싶다."},
{"id": "clka01:2300", "ko": "「……아니, 안 돼. 일어나자」"},
{"id": "clka01:2400", "ko": "혼자 사니까 한번 빼먹으면 그다음엔 질질 계속 빼먹게 된다. 그래서 꾀병으로 쉬는 것만은 안 하기로 정해 두었다."},
{"id": "clka01:2500", "ko": "일단 일어나자."},
{"id": "clka01:2600", "ko": "「영차――」"},
{"id": "clka01:2700", "ko": "「――하고」"},
{"id": "clka01:2800", "ko": "상반신을 일으킨 그때."},
{"id": "clka01:2900", "ko": "「윽!?」"},
{"id": "clka01:3000", "ko": "갑자기 머릿속에 찌르는 듯한 통증이 지나갔다."},
{"id": "clka01:3100", "ko": "「뭐, 뭐야!?」"},
{"id": "clka01:3200", "ko": "「머, 머리가…… 아파!」"},
{"id": "clka01:3300", "ko": "반사적으로 두 손으로 머리를 누른다."},
{"id": "clka01:3400", "ko": "「……」"},
{"id": "clka01:3500", "ko": "머리를 움직이지 않고 있으니 서서히 통증이 가라앉는다."},
{"id": "clka01:3600", "ko": "「대체 뭐야……」"},
{"id": "clka01:3700", "ko": "그때."},
{"id": "clka01:3800", "ko": "나는 방금 머리를 누른 내 두 팔의 이상을 알아차렸다."},
{"id": "clka01:3900", "ko": "「……왜 나, 교복을 입은 채로 잤던 거지?」"},
{"id": "clka01:4000", "ko": "나도 모르게 일어선다."},
{"id": "clka01:4100", "ko": "「으, 우왓!」"},
{"id": "clka01:4200", "ko": "몸을 일으키자마자 또 머리가 욱신욱신 아파 온다."},
{"id": "clka01:4300", "ko": "하지만 그걸 신경 쓸 여유는 없었다. 내 몸을 다시 훑어본다."},
{"id": "clka01:4400", "ko": "「교복……」"},
{"id": "clka01:4500", "ko": "아무래도 어제는 교복을 입은 채로 잤던 모양이다. 바지에 자국이 나 있다."},
{"id": "clka01:4600", "ko": "「어제는 일요일이었는데……」"},
{"id": "clka01:4700", "ko": "일요일이니까 교복을 입을 필요는 없었을 텐데."},
{"id": "clka01:4800", "ko": "「아니, 잠깐」"},
{"id": "clka01:4900", "ko": "머릿속은 아직도 멍하니 안개가 끼어 있었지만, 그 속에서 희미하게 어렴풋한 이미지가 떠오른다."},
{"id": "clka01:5000", "ko": "「분명 어제는……」"},
{"id": "clka01:5100", "ko": "「신문부 멤버들이랑 같이 다녔던, 것 같은……」"},
{"id": "clka01:5200", "ko": "띄엄띄엄, 이토랑 쿠루스, 그리고 오노에, 아리무라와 시부야 거리를 걷던 기억이 떠오른다."},
{"id": "clka01:5300", "ko": "「어제, 나는 그 녀석들이랑……」"},
{"id": "clka01:5400", "ko": "「으윽!」"},
{"id": "clka01:5500", "ko": "어젯밤 일을 떠올리려던 그때, 마치 그걸 거부하듯이 지금까지보다 더 큰 두통이 덮쳐 왔다."},
{"id": "clka01:5600", "ko": "나도 모르게 비틀거리며 한 발을 앞으로 내딛자――"},
{"id": "clka01:5700", "ko": "「어?」"},
{"id": "clka01:5800", "ko": "양말을 신은 채인 오른발이 뭔가에 닿았다."},
{"id": "clka01:5900", "ko": "아래를 보니 ⟦col:280aa02d1400⟧마운틴 뷰⟦col:800000⟧ 페트병이 굴러다니고 있었다. 뚜껑은 없고 비어 있는 것 같다."},
{"id": "clka01:6000", "ko": "「어라, 안 버렸었나――」"},
{"id": "clka01:6100", "ko": "페트병을 주우려고 머리를 누르며 몸을 숙이자, 바닥에 다른 것들도 이것저것 떨어져 있다는 걸 알았다."},
{"id": "clka01:6200", "ko": "텅 빈 감자칩 봉지. 다 먹은 편의점 도시락. 찢어진 아이스크림 봉지. 휴지가 던져 넣어진 편의점 봉투."},
{"id": "clka01:6300", "ko": "그런 것들이 어지럽게 굴러다니고 있다."},
{"id": "clka01:6400", "ko": "「대체 뭐야 이건……」"},
{"id": "clka01:6500", "ko": "「꼭 파티가 끝난 뒤 같잖아……」"},
{"id": "clka01:6600", "ko": "「…………응?」"},
{"id": "clka01:6700", "ko": "「파티? 그러고 보니……」"},
{"id": "clka01:6800", "ko": "서서히 밀려오는 두통의 파도를 넘어, 드디어 기억의 문이 열릴 것 같았다."},
{"id": "clka01:6900", "ko": "「어제는 다들――」"},
{"id": "clka01:7000", "ko": "조금만 더 하면 전부 떠올릴 수 있을 것 같던 그 순간."},
{"id": "clka01:7100", "ko": "「어?」"},
{"id": "clka01:7200", "ko": "오른쪽 주머니에서 소리가 울렸다. 주머니를 뒤져 보니 스마트폰이 들어 있었다."},
{"id": "clka01:7300", "ko": "「스마트폰도 주머니에 넣은 채로 잤던 건가……」"},
{"id": "clka01:7400", "ko": "메일이 온 모양이다. 보낸 사람을 확인한다."},
{"id": "clka01:7500", "ko": "「응? 누구한테서 온 거지 이거?」"},
{"id": "clka01:7600", "ko": "보낸 사람 칸에 모르는 메일 주소가 떠 있다. 적어도 스마트폰 주소록에 등록하지 않은 사람에게서 온 것이다."},
{"id": "clka01:7700", "ko": "뭐, 주소록이라고 해도 원래 별로 많은 사람이 등록돼 있지는 않지만."},
{"id": "clka01:7800", "ko": "「이 도메인…… 무료 일회용 계정이네」"},
{"id": "clka01:7900", "ko": "「제목, 미야시로 타쿠루 님……? 융단 폭격식 ⟦col:280aa02d1400⟧스팸 메일⟦col:800000⟧은 아닌 것 같네」"},
{"id": "clka01:8000", "ko": "적어도 내 본명을 아는 누군가다."},
{"id": "clka01:8100", "ko": "「제목도 본문도 없고, 이미지 첨부 파일이 하나뿐……」", "note": "앞 줄에서 제목이 있다고 했으나 원문대로 옮김"},
{"id": "clka01:8200", "ko": "수상하다. 역시 스팸 메일인가?"},
{"id": "clka01:8300", "ko": "「아니 그래도, 내 이름을 알고 있으니……」"},
{"id": "clka01:8400", "ko": "일단 바이러스 검사를 해 두자."},
{"id": "clka01:8500", "ko": "「……바이러스, 없음」"},
{"id": "clka01:8600", "ko": "어느새 두통 생각은 잊고 있었다."},
{"id": "clka01:8700", "ko": "어째서인지 예감이 들었다."},
{"id": "clka01:8800", "ko": "이 메일에서 뭔가가 시작될 것 같은, 그런 예감이."},
{"id": "clka01:8900", "ko": "「……그럼」"},
{"id": "clka01:9000", "ko": "차 안에는 나 말고 아무도 없는데, 침착한 척하며 첨부 파일을 연다."},
{"id": "clka01:9100", "ko": "「……」"},
{"id": "clka01:9200", "ko": "「…………」"},
{"id": "clka01:9300", "ko": "「…………에에에엣!?」"},
{"id": "clka01:9400", "ko": "그 이미지는 이 수수께끼의 두통이나, 수수께끼의 옷차림이나, 수수께끼의 차 안 풍경을 훨씬 능가하는 수수께끼를 나에게 들이밀었다."},
{"id": "clka01:9500", "ko": "「이, 이이이이잇」"},
{"id": "clka01:9600", "ko": "「이, 이건!?」"},
{"id": "clka01:9700", "ko": "그건 인터넷이나 만화나 잡지 기사에서는 얼마든지 다뤄지지만, 현실에서는 거의 본 적이 없는 물건이었다."},
{"id": "clka01:9800", "ko": "어쩌면 실재할지도 모르고, 실재해 준다면 인생에 약간의 색채를 더해 줄 가능성이 있으니, 아주 조금은 실재했으면 하고 생각하던 물건이었다."},
{"id": "clka01:9900", "ko": "그렇다고는 해도 설령 실재한다 해도 나와는 인연이 없는 물건이라고 생각했고, 하물며 내 스마트폰으로 보내져 오리라고는 상상도 하지 못한 물건이었다."}
]
