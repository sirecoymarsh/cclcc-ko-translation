[
{"id": "clah01:29900", "ko": "「그거요. 쿨 캣 뭐시기라는 책」"},
{"id": "clah01:30000", "ko": "「윽……!」"},
{"id": "clah01:30100", "ko": "그런 걸 읽고 있다는 걸 남들이 알면……"},
{"id": "clah01:30200", "ko": "「아, 아니. 그래도 안 돼……!」"},
{"id": "clah01:30300", "ko": "「에〜, 왜애〜?」"},
{"id": "clah01:30400", "ko": "왜고 뭐고, 내 마음의 자유는 그 무엇과도 바꿀 수 없다."},
{"id": "clah01:30500", "ko": "이런 협박 따위에 굴할까 보냐."},
{"id": "clah01:30600", "ko": "애초에 이 트레일러 하우스는 둘이 생활하기에는 너무 비좁다."},
{"id": "clah01:30700", "ko": "가운데 통로 부분은 서로 비켜 지나가기도 빠듯하다."},
{"id": "clah01:30800", "ko": "「안 된다면 안 돼. 애초에 그건 그쪽 사정이잖아. 내 사생활은 어떻게 되는데!」"},
{"id": "clah01:30900", "ko": "「그럼 저는 공기 같은 거라고 생각해 주시면 됨다」"},
{"id": "clah01:31000", "ko": "「당연히 무리지!」"},
{"id": "clah01:31100", "ko": "카즈키 같은 타입이라면 몰라도, ⟦rb⟧아리무라⟦rt⟧이것⟦/r⟧를 없는 셈 치라니, 깨달음을 얻은 부처님이라도 못 할 게 틀림없다."},
{"id": "clah01:31200", "ko": "「아무튼 지금 당장 나가 줘」"},
{"id": "clah01:31300", "ko": "「에〜. 그치만 밖은 깜깜하고〜, 이런 데서 혼자 쫓겨나면 무슨 일을 당할지 모르고〜」"},
{"id": "clah01:31400", "ko": "「뭐라고 해도 안 돼. 아무튼 돌아가」"},
{"id": "clah01:31500", "ko": "「우〜…… 알겠어요……」"},
{"id": "clah01:31600", "ko": "어라?"},
{"id": "clah01:31700", "ko": "……뭐야."},
{"id": "clah01:31800", "ko": "「폐를 끼쳐서 죄송했어요……」"},
{"id": "clah01:31900", "ko": "「아니……」"},
{"id": "clah01:32000", "ko": "더 떼를 쓸 줄 알았는데, 의외로 순순히 말을 듣잖아."},
{"id": "clah01:32100", "ko": "「…………」"},
{"id": "clah01:32200", "ko": "문을 연 아리무라는 얼굴만 내밀고 주위를 확인하더니, 뒤돌아서 살짝 고개를 숙이고 방을 나갔다."},
{"id": "clah01:32300", "ko": "「…………」"},
{"id": "clah01:32400", "ko": "확실히 이 근처는 여자애 혼자면 불안할지도 모르지만, 조금만 걸으면 바로 시부야 번화가다."},
{"id": "clah01:32500", "ko": "어지간한 일이 아닌 이상, 이상한 일 같은 건……"},
{"id": "clah01:32600", "ko": "「…………」"},
{"id": "clah01:32700", "ko": "「아리무라!!!」"},
{"id": "clah01:32800", "ko": "「어? 미야시로…… 선배?」"},
{"id": "clah01:32900", "ko": "하필이면 굳이 이렇게 어둡고 인적 드문 길을."},
{"id": "clah01:33000", "ko": "「……아직 이런 데 있었냐」"},
{"id": "clah01:33100", "ko": "「선배야말로 왜」"},
{"id": "clah01:33200", "ko": "「음료수 좀 사러 나왔을 뿐이야. 그랬더니 네가 있길래……」"},
{"id": "clah01:33300", "ko": "「그렇슴까……」"},
{"id": "clah01:33400", "ko": "……무슨 표정을 하고 있는 거야."},
{"id": "clah01:33500", "ko": "어쩔 수 없지."},
{"id": "clah01:33600", "ko": "「배고프지? 우리 집에서 뭐라도 먹고 가」"},
{"id": "clah01:33700", "ko": "「……괜찮아요?」"},
{"id": "clah01:33800", "ko": "「……어쩔 수 없잖아. 갈 데가 없다면」"},
{"id": "clah01:33900", "ko": "여기서 불러 세웠다는 건…… 결국 내가 졌다는 뜻이 되는 것도 어쩔 수 없는 일이고."},
{"id": "clah01:34000", "ko": "「……고맙습니다, 선배!!」"},
{"id": "clah01:34100", "ko": "이거 참. 나도 무르다니까……"},
{"id": "clah01:34200", "ko": "「에헤헤, 진짜 선배는 사람이 너무 좋다니까요」"},
{"id": "clah01:34300", "ko": "그거, 칭찬 아니거든."},
{"id": "clah01:34400", "ko": "「아, 물론 좋은 의미로 하는 말이에요?」"},
{"id": "clah01:34500", "ko": "「…………」"},
{"id": "clah01:34600", "ko": "「후루룩후루룩……」"},
{"id": "clah01:34700", "ko": "「후루룩후루룩……」"},
{"id": "clah01:34800", "ko": "「미안하다…… 이런 것밖에 없어서」"},
{"id": "clah01:34900", "ko": "「아뇨 아뇨, 이걸로 충분함다」"},
{"id": "clah01:35000", "ko": "아리무라는 도무지 여자애 취향이라고는 하기 힘든 컵라면을 의외일 만큼 얌전하게 후루룩거리고 있었다."},
{"id": "clah01:35100", "ko": "「…………」"},
{"id": "clah01:35200", "ko": "「뭐예요?」"},
{"id": "clah01:35300", "ko": "「아니, 아리무라니까 『저녁으로 컵라면이라니, 진심이에요?』 정도는 할 줄 알았는데……」"},
{"id": "clah01:35400", "ko": "「그런 말 안 해요. 억지 부려서 신세 지고 있는 건데」"},
{"id": "clah01:35500", "ko": "헤에……"},
{"id": "clah01:35600", "ko": "그런 점은 제대로 되어 있구나."},
{"id": "clah01:35700", "ko": "의외…… 라고 하면 이 녀석이 화낼지도 모르지만."},
{"id": "clah01:35800", "ko": "그러고 보니 아리무라는 남의 말이 진짜인지 거짓인지 알 수 있다고 했지."},
{"id": "clah01:35900", "ko": "별로 깊이 생각해 본 적은 없었지만, 그건 상상 이상으로 힘든 일이 아닐까."},
{"id": "clah01:36000", "ko": "그렇게 생각하면 평소 아리무라의 언행도 그 애 나름대로 신경을 쓴 결과일 가능성도……"},
{"id": "clah01:36100", "ko": "「선배, 저녁은 맨날 이런 식이에요?」"},
{"id": "clah01:36200", "ko": "「그렇지. 그 밖에는 편의점에서 도시락을 사거나, ⟦col:280aa02d1400⟧칼로리 블록⟦col:800000⟧이라든가……」"},
{"id": "clah01:36300", "ko": "「에〜, 안 돼요, 그래서는. 한창 클 때인데」"},
{"id": "clah01:36400", "ko": "「너까지 쿠루스 같은 소리 하지 마」"},
{"id": "clah01:36500", "ko": "뭐, 그런저런 식으로 밥을 먹고, 어쩐지 느긋하게 인터넷을 보거나 ⟦col:280aa02d1400⟧시부야 늬우스⟦col:800000⟧를 체크하거나 하다 보니 어느새 꽤 늦은 시간이 되어 버렸다."},
{"id": "clah01:36600", "ko": "「하아암……」"},
{"id": "clah01:36700", "ko": "「아, 벌써 시간이 이렇게 됐네요. 그럼 슬슬 자 볼까요」"},
{"id": "clah01:36800", "ko": "「어? 아, 그, 그렇지, 응」"},
{"id": "clah01:36900", "ko": "나도 모르게 목소리가 들뜬 걸 허둥지둥 얼버무린다."},
{"id": "clah01:37000", "ko": "의식하지 마, 미야시로 타쿠루."},
{"id": "clah01:37100", "ko": "상대는 아리무라다."},
{"id": "clah01:37200", "ko": "이상한 일이 일어날 리가 없다."},
{"id": "clah01:37300", "ko": "「아, 아리무라는 거기 이불 써도 돼」"},
{"id": "clah01:37400", "ko": "이 방 안에는 내가 평소 쓰는 침대와는 별개로, 평소에는 물건 두는 곳이 되어 있는 접이식 소파 베드가 앞쪽에 하나 더 있어서, 그걸 쓰면 둘이 자는 것 정도는 어떻게든 된다."},
{"id": "clah01:37500", "ko": "「네? 그럼 선배는요?」"},
{"id": "clah01:37600", "ko": "「나는 침낭이 있으니까……」"},
{"id": "clah01:37700", "ko": "여기 막 왔을 무렵에는 이불 같은 것도 없어서 한동안 침낭에서 먹고 잤으니, 그 정도는 익숙하다."},
{"id": "clah01:37800", "ko": "「에〜, 그래도 그건 미안함다〜」"},
{"id": "clah01:37900", "ko": "「여, 여자애를 침낭에서 재울 수도 없잖아」"},
{"id": "clah01:38000", "ko": "「그럼 같이 잘래요?」"},
{"id": "clah01:38100", "ko": "「바! 바바바바바바바바보 같은 소리 하지 마!」"},
{"id": "clah01:38200", "ko": "「아하하, 부끄러워한다 부끄러워한다〜」"},
{"id": "clah01:38300", "ko": "큭……!"},
{"id": "clah01:38400", "ko": "「의외로 신사네요, 선배는」"},
{"id": "clah01:38500", "ko": "「나는 언제나 신사다」"},
{"id": "clah01:38600", "ko": "「그래도 사실은 조금 기대하고 있다든가?」"},
{"id": "clah01:38700", "ko": "「그, 그럴 리가 있냐!」"},
{"id": "clah01:38800", "ko": "「흐응…… 그렇구나 그렇구나. 안심 안심」"},
{"id": "clah01:38900", "ko": "아, 아리무라가 납득했다는 건 거짓말이 아니다…… 라는 거겠지."},
{"id": "clah01:39000", "ko": "굿잡, 나."},
{"id": "clah01:39100", "ko": "「뭐, 괜찮슴다. 왜냐면 저, 미야시로 선배를 믿고 있으니까요」"},
{"id": "clah01:39200", "ko": "아리무라……"},
{"id": "clah01:39300", "ko": "「그거…… 뭐 하는 거야?」"},
{"id": "clah01:39400", "ko": "「네? 경보기인데요?」"},
{"id": "clah01:39500", "ko": "「…………」"},
{"id": "clah01:39600", "ko": "「그럼 안녕히 주무세요〜」"},
{"id": "clah01:39700", "ko": "이 녀석…… 믿기는 뭘 믿는다는 거야!"},
{"id": "clah01:39800", "ko": "「새근…… 새근……」"}
]
