[
{"id": "clyu01:69500", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu01:69600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu01:69700", "ko": "", "note": "보류 — 연애 묘사(미성년·가족). 옮길 때: 화자 「ユウ」의 お兄ちゃん 은 「오빠」"},
{"id": "clyu01:69800", "ko": "「…………」"},
{"id": "clyu01:69900", "ko": "나는 대체 무슨 망상을 하고 있는 거야."},
{"id": "clyu01:70000", "ko": "하필이면 남동생을――"},
{"id": "clyu01:70100", "ko": "격렬한 자기혐오에 빠질 것 같다……"},
{"id": "clyu01:70200", "ko": "생각하기보다 확인하는 게 빠르겠지."},
{"id": "clyu01:70300", "ko": "그렇게 마음먹고 막 말을 걸려던 그때, 방문이 천천히 열렸다."},
{"id": "clyu01:70400", "ko": "「타쿠루 형…… 벌써 자?」"},
{"id": "clyu01:70500", "ko": "문틈으로 조심조심 들여다본 건 유토였다."},
{"id": "clyu01:70600", "ko": "「유토…… 무슨 일이야?」"},
{"id": "clyu01:70700", "ko": "「다행이다. 아직 안 잤구나」"},
{"id": "clyu01:70800", "ko": "유토는 안심한 듯한 미소를 짓더니 내 방으로 들어왔다."},
{"id": "clyu01:70900", "ko": "「안 되잖아, 이런 시간까지 안 자고 있으면」"},
{"id": "clyu01:71000", "ko": "유토는 아직 13살이다."},
{"id": "clyu01:71100", "ko": "13살쯤 되면 나름 밤샘도 하는 나이일지도 모르지만, 그래도 안 자고 있다가 혼나는 건 유토다."},
{"id": "clyu01:71200", "ko": "「미안해. 그래도 나…… 꼭 타쿠루 형한테 부탁하고 싶은 게 있어서……」"},
{"id": "clyu01:71300", "ko": "「부탁? 나한테?」"},
{"id": "clyu01:71400", "ko": "그러고 보니 유토가 이런 식으로 나한테 부탁을 해 오는 건 처음일지도 모른다."},
{"id": "clyu01:71500", "ko": "늘 어딘가 사양하는 듯한 구석이 있어서, 자기가 원하는 걸 입 밖에 내지 않는 게 유토다."},
{"id": "clyu01:71600", "ko": "「그렇구나. 좋아, 내가 할 수 있는 거라면 뭐든 들어줄게」"},
{"id": "clyu01:71700", "ko": "「정말?!」"},
{"id": "clyu01:71800", "ko": "「그래. 나는 형이니까」"},
{"id": "clyu01:71900", "ko": "계속 집을 비우긴 했지만, 일단 나도 형이다."},
{"id": "clyu01:72000", "ko": "형으로서 동생을 위해 할 수 있는 게 있다면 해 주고 싶다."},
{"id": "clyu01:72100", "ko": "「그럼 말할게, 실은 말야, 나 있지, 여자애가 되고 싶어」"},
{"id": "clyu01:72200", "ko": "「…………뭐?」"},
{"id": "clyu01:72300", "ko": "방금 뭐라고 했지?"},
{"id": "clyu01:72400", "ko": "여자애가 되고 싶다…… 그렇게 말한 건가?"},
{"id": "clyu01:72500", "ko": "「있잖아, 우리 집은 누나에, 노노 누나에, 우키 누나. 다 여자애들뿐이잖아?」"},
{"id": "clyu01:72600", "ko": "「아빠는 집에 별로 없고, 있을 때는 혼자 술 마시고, 타쿠루 형은 나가 버렸고」"},
{"id": "clyu01:72700", "ko": "「집 안에서는 누나들이 다 즐겁게 얘기하고 있어서, 나만 혼자 왠지 따돌림당하는 것 같다고 계속 생각했어」"},
{"id": "clyu01:72800", "ko": "내가 나간 탓에 유토가 그렇게 느끼고 있었다니……"},
{"id": "clyu01:72900", "ko": "「잠깐, 유토. 그렇다고 그 생각은 너무 단순하잖아」"},
{"id": "clyu01:73000", "ko": "「나가 버린 형이 그런 말 하지 마!!」"},
{"id": "clyu01:73100", "ko": "갑자기 유토의 말투가 바뀌었고, 그 돌변한 모습에 나는 펄쩍 뛰었다."},
{"id": "clyu01:73200", "ko": "「유, 유토……?」"},
{"id": "clyu01:73300", "ko": "「……내가 얼마나 외로웠는지도 모르는 주제에, 멋대로 말하지 마」"},
{"id": "clyu01:73400", "ko": "말투는 차분해졌지만 그 목소리에는 이상한 박력이 담겨 있는 것 같아서, 저절로 몸이 떨렸다."},
{"id": "clyu01:73500", "ko": "「그래서 말야, 나는 여자애가 되고 싶다고 생각했어. 물론 진짜 여자애로……」"},
{"id": "clyu01:73600", "ko": "「진, 진짜……? 그게 무슨 뜻이야……?", "note": "원문도 끝의 」 가 없음 — 그대로 둠"},
{"id": "clyu01:73700", "ko": "목소리가 뒤집히면서도 물은 내 질문은 무시하고, 유토는 어디에 숨겨 두었던 건지 낡은 책 몇 권을 꺼냈다."},
{"id": "clyu01:73800", "ko": "「봐. 나 엄청 찾아봤단 말야? ⟦col:280aa02d1400⟧호노리우스⟦col:800000⟧잖아? ⟦col:280aa02e1400⟧피카트리스크⟦col:800000⟧에 ⟦col:280aa02f1400⟧레메게톤⟦col:800000⟧…… 그리고 ⟦col:280aa0301400⟧이취경⟦col:800000⟧까지」"},
{"id": "clyu01:73900", "ko": "「어딘가에 여자애가 되는 방법이 나와 있지 않을까 해서 많이 찾아봤어」"},
{"id": "clyu01:74000", "ko": "「그랬더니! 찾았어! 봐, 여기!」"},
{"id": "clyu01:74100", "ko": "유토는 진심으로 기쁜 듯한 미소를 띠고 책장을 넘겼다."},
{"id": "clyu01:74200", "ko": "「서로 안구를 바꿔 넣은 남녀를 교배시키고, 그렇게 얻은 체액을 정제해―― 알겠지?」"},
{"id": "clyu01:74300", "ko": "「유토…… 너, 무슨 소리를 하는 거야?」"},
{"id": "clyu01:74400", "ko": "안구를 바꿔 넣는다?"},
{"id": "clyu01:74500", "ko": "교배시킨다?"},
{"id": "clyu01:74600", "ko": "무슨 뜻인지…… 모르겠다……"},
{"id": "clyu01:74700", "ko": "「모르겠어? 그러고도 잘도 정보 강자라고 하네……」"},
{"id": "clyu01:74800", "ko": "유토는 진심으로 경멸하는 눈으로 나를 보았다."},
{"id": "clyu01:74900", "ko": "「뭐, 됐어. 타쿠루 형은 내 말만 들어 주면 그걸로 되니까」"},
{"id": "clyu01:75000", "ko": "「말이라니…… 설마……」"},
{"id": "clyu01:75100", "ko": "「그래…… 이거랑 바꿔 넣는 거야……」"},
{"id": "clyu01:75200", "ko": "차가운 목소리로 그렇게 말하더니, 유토는 주머니에 손을 넣어 아무렇게나 뭔가를 꺼내 던졌다."},
{"id": "clyu01:75300", "ko": "포물선을 그린 그것은 바닥에 떨어지더니 데굴데굴 굴러 내 발치에서 멈췄다."},
{"id": "clyu01:75400", "ko": "희번덕."},
{"id": "clyu01:75500", "ko": "눈알 두 개가 나를 바라보고 있었다."},
{"id": "clyu01:75600", "ko": "「힉――?!」"},
{"id": "clyu01:75700", "ko": "뒷걸음질 치려다 다리가 꼬여 그 자리에 쓰러졌다."},
{"id": "clyu01:75800", "ko": "뭔가 말하려 해도 공포로 목소리가 나오지 않았다."},
{"id": "clyu01:75900", "ko": "틀림없는 진짜 안구가 가만히 나를 보고 있었다."},
{"id": "clyu01:76000", "ko": "그 눈동자 색――"},
{"id": "clyu01:76100", "ko": "살짝 푸른빛이 도는 그 눈동자 색이 낯익은 것 같았다……"},
{"id": "clyu01:76200", "ko": "설마――"},
{"id": "clyu01:76300", "ko": "설마 이 눈은――"},
{"id": "clyu01:76400", "ko": "「……타쿠, 루……?」"},
{"id": "clyu01:76500", "ko": "그때 복도 저편에서 목소리가 들렸다."},
{"id": "clyu01:76600", "ko": "「저기…… 타쿠루…… 어디 있어? 대답해 줘……」"},
{"id": "clyu01:76700", "ko": "비틀거리는 발소리가 천천히 다가온다."},
{"id": "clyu01:76800", "ko": "그리고――"},
{"id": "clyu01:76900", "ko": "「아…… 아아……」"},
{"id": "clyu01:77000", "ko": "문에서 나타난 노노의 두 눈에는――"},
{"id": "clyu01:77100", "ko": "「캄캄해서 아무것도 안 보여…… 그러니까, 부탁이야……」"},
{"id": "clyu01:77200", "ko": "검고 검은."},
{"id": "clyu01:77300", "ko": "새까만 구멍이 뚫려 있었다……"},
{"id": "clyu01:77400", "ko": "「우와아아아아아아아아아아아앗!!」"},
{"id": "clyu01:77500", "ko": "「봐, 이대로면 노노 누나가 안 보인다고 울고 있어. 빨리 타쿠루 형 눈을 넣어 주자?」"},
{"id": "clyu01:77600", "ko": "유토가 가느다란 금속 주걱 같은 것을 손에 들고 한 걸음 다가왔다."},
{"id": "clyu01:77700", "ko": "「타쿠루…… 캄캄해…… 살려 줘……」"},
{"id": "clyu01:77800", "ko": "얼굴 한가운데 새까만 구멍 두 개가 뚫린 노노가 손을 뻗으며 다가온다."},
{"id": "clyu01:77900", "ko": "뭐야?"},
{"id": "clyu01:78000", "ko": "대체 뭐냐고, 이거?!"},
{"id": "clyu01:78100", "ko": "「으…… 아아아아아아아아아아아아아아아아!!」"},
{"id": "clyu01:78200", "ko": "「…………」"},
{"id": "clyu01:78300", "ko": "큰일이다……"},
{"id": "clyu01:78400", "ko": "너무한 망상 때문에 무서워서 잠을 못 잘 것 같다……"},
{"id": "clyu01:78500", "ko": "「…………」"},
{"id": "clyu01:78600", "ko": "내가 터무니없는 망상에 빠져 있는 사이, 어느새 문이 살짝 열려 있었다."},
{"id": "clyu01:78700", "ko": "거기서 얼굴을 내밀고 있던 건……"},
{"id": "clyu01:78800", "ko": "「…………」"},
{"id": "clyu01:78900", "ko": "우키?"},
{"id": "clyu01:79000", "ko": "그러자, 내가 자고 있다고 생각한 거겠지."},
{"id": "clyu01:79100", "ko": "우키는 작게 한숨을 쉬고 방을 나가려 했다."},
{"id": "clyu01:79200", "ko": "「아, 잠깐」"},
{"id": "clyu01:79300", "ko": "「아, 혹시 깨워 버렸나요? 죄송해요」"},
{"id": "clyu01:79400", "ko": "「아니, 괜찮아. 깨어 있었으니까」"}
]
