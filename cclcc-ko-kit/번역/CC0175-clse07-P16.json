[
{"id": "clse07:147400", "ko": "「거짓말? 거짓말이라니 무슨 소리야?」"},
{"id": "clse07:147500", "ko": "「그거, 우리한테는 말 못 하는 거냐?」"},
{"id": "clse07:147600", "ko": "「……그렇구나」"},
{"id": "clse07:147700", "ko": "「어이, 미야시로. 어떻게 할 생각이야?」"},
{"id": "clse07:147800", "ko": "「미야시로오……」"},
{"id": "clse07:147900", "ko": "「어이!?」"},
{"id": "clse07:148000", "ko": "「미야시로…… 괜찮은 거냐?」"},
{"id": "clse07:148100", "ko": "「…………」"},
{"id": "clse07:148200", "ko": "「부부장……」"},
{"id": "clse07:148300", "ko": "「그 말대로! 여제는 여제다~!」"},
{"id": "clse07:148400", "ko": "「연애 금지령 따위 엿이나 먹어라!!」"},
{"id": "clse07:148500", "ko": "「야, 아리무라, 너 왜 울어?」"},
{"id": "clse07:148600", "ko": "「어…… 왜?」"},
{"id": "clse07:148700", "ko": "「응? 카즈키, 왜 그래?」"},
{"id": "clse07:148800", "ko": "「어? 카와하라?」"},
{"id": "clse07:148900", "ko": "「아~ 글렀네. 충격받은 나머지 선 채로 기절했어……」"},
{"id": "clse07:149000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:149100", "ko": "「정말이야. 마침내 내가 제일 싫어하는 계절이 와 버렸다고!」"},
{"id": "clse07:149200", "ko": "「잠깐 잠깐 잠깐! 누가 이거야, 누가! 물건 취급하지 마!」"},
{"id": "clse07:149300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:149400", "ko": "「뭐!? 크리스마스라고? 일 년 중에 제일 로맨틱한 날이라고? 가족 다 같이? 뭐야 그게?」"},
{"id": "clse07:149500", "ko": "「그러니까 물건 취급하지 말라고!」"},
{"id": "clse07:149600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:149700", "ko": "「아까 복도에서 만났는데, 볼일이 있어서 늦을지도 모른다던데」"},
{"id": "clse07:149800", "ko": "「아아아아아아아아!!」"},
{"id": "clse07:149900", "ko": "「저거! 저거!!!」"},
{"id": "clse07:150000", "ko": "「쉬잇!!」"},
{"id": "clse07:150100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:150200", "ko": "「저거, 또 기억이 이상해지겠네……」"},
{"id": "clse07:150300", "ko": "「음~ 확실히 나도 그렇게 생각했어」"},
{"id": "clse07:150400", "ko": "「그래서 지금부터 그 상담을 하고 싶다고 했다며, 오노에가?」"},
{"id": "clse07:150500", "ko": "「납득이 안 가는데」"},
{"id": "clse07:150600", "ko": "「그렇다면 오늘은 어쩔 수 없나」"},
{"id": "clse07:150700", "ko": "「미스 콘테스트는 어때?」"},
{"id": "clse07:150800", "ko": "「다른 무슨 미스 콘테스트가 있다는 건데?」"},
{"id": "clse07:150900", "ko": "「봐, 저번 YES-NO 판정이 꽤 평판이 좋았잖아? 역시 민중은 그런 분위기를 원한다고 생각하거든」"},
{"id": "clse07:151000", "ko": "「그러니까 말이야. 학교 안에서 미인이라고 생각하는 사람한테 투표를 받아서――」"},
{"id": "clse07:151100", "ko": "「에~, 왜?」"},
{"id": "clse07:151200", "ko": "「나왔다! 우승 못 하는 녀석의 질투. 그런 좁은 소견이니까 안 뽑히는――」"},
{"id": "clse07:151300", "ko": "「우와아아아아아아! 농담이야, 농담! 보고만 있지 말고 말려 줘, 미야시로오!」"},
{"id": "clse07:151400", "ko": "「그런~」"},
{"id": "clse07:151500", "ko": "「히이익!」"},
{"id": "clse07:151600", "ko": "「휴……」"},
{"id": "clse07:151700", "ko": "「아니아니! 그거 농담으로 안 들리니까!!」"},
{"id": "clse07:151800", "ko": "「그래도 말이야. 실제로 야마조에가 있어 주면 편리하지」"},
{"id": "clse07:151900", "ko": "「봐. 차도 이렇게 전원의 취향을 파악해서 끓여 주고, 부실 정리정돈도 청소도 전~부 해 주고」"},
{"id": "clse07:152000", "ko": "「우리 집에도 야마조에가 한 명 있어 주면 편리하고 좋을 텐데」"},
{"id": "clse07:152100", "ko": "「맞다, 야마조에. 다음에 우리 집에 와서 방 좀 치워 주지 않을래?」"},
{"id": "clse07:152200", "ko": "「응? 뭐야?」"},
{"id": "clse07:152300", "ko": "「어, 어라? 나 뭔가 이상한 소리 했어?」"},
{"id": "clse07:152400", "ko": "「아, 아니라니까, 딱히 나는 악의가 있어서 말한 게……」"},
{"id": "clse07:152500", "ko": "「거 봐. 야마조에도 기분 나빠하지 않으니까 됐잖아~」"},
{"id": "clse07:152600", "ko": "「죄송합니다」"},
{"id": "clse07:152700", "ko": "「어라? 잠깐만! 그렇다는 건 나, 괜히 혼난 거 아니야!?」"},
{"id": "clse07:152800", "ko": "「아니, 뭐……」"},
{"id": "clse07:152900", "ko": "「그럼 오늘은 이만 돌아갈까」"},
{"id": "clse07:153000", "ko": "「뭐야 뭐야, 미야시로. 아까부터 아리무라가 만든 도시락이라도 먹은 것 같은 얼굴을 하고」"},
{"id": "clse07:153100", "ko": "「그냥 농담이었던 겁니다 죄송합니다」"},
{"id": "clse07:153200", "ko": "「정말 봐주세요! 부탁드립니다!!」"},
{"id": "clse07:153300", "ko": "「아이돌을 프로듀스!?」"},
{"id": "clse07:153400", "ko": "「어이, 미야시로…… 너, 그거 진심으로 하는 소리냐?」"},
{"id": "clse07:153500", "ko": "「아이돌이 되기 위해서 얼마나 많은 여자애들이 얼마나 노력하는지 알고 하는 소리냐!?」"},
{"id": "clse07:153600", "ko": "「아니, 너는 전혀 몰라! 그러니까 그렇게 무책임하게 “장난 같은 거”라고 말할 수 있는 거야!」"},
{"id": "clse07:153700", "ko": "「알겠냐? 너의 그 발언은 아이돌에 대한, 그리고 모든 아이돌 팬에 대한 모욕 행위다! 사과해! 아이돌분들한테 사과해!」"},
{"id": "clse07:153800", "ko": "「아니, 딱히 그만둘 필요는 없잖아」"},
{"id": "clse07:153900", "ko": "「딱히 일단 해 보겠다는 거라면 괜찮지 않냐?」"},
{"id": "clse07:154000", "ko": "「아니면 설마…… 부부장이, 라는 건 아니겠지?」"},
{"id": "clse07:154100", "ko": "「뭐――!」"},
{"id": "clse07:154200", "ko": "「그렇다는 건 남녀 유닛이라는 거냐?」"},
{"id": "clse07:154300", "ko": "「유토한테 여장을 시킨다는 거냐!?」"},
{"id": "clse07:154400", "ko": "「그렇지」"},
{"id": "clse07:154500", "ko": "「만일 들켜도 화제는 될 거고! 아니, 오히려 도중에 밝혀서 화제로 만드는 방법도 있다고」"},
{"id": "clse07:154600", "ko": "「그런 부분은 우리한테 맡겨 둬!」"},
{"id": "clse07:154700", "ko": "「그렇지. 우선 내가 내 방식대로 프로듀스해 주마」"},
{"id": "clse07:154800", "ko": "「그런 얼굴 하지 말라니까. 뭐, 속는 셈 치고 맡겨 주면 되니까」"},
{"id": "clse07:154900", "ko": "「에헴. 그런 고로 우선 내가 너희의 프로듀스를 담당하게 되었다」"},
{"id": "clse07:155000", "ko": "「으…… 유이까지 미야시로 같은 반응……」"},
{"id": "clse07:155100", "ko": "「프로듀서…… 으~음, 좋은 울림!」"},
{"id": "clse07:155200", "ko": "「자, 그럼 바로 앞으로의 계획을…… 이라고 하고 싶은데, 먼저 확인해 둬야 할 게 있다. 알겠지?」"},
{"id": "clse07:155300", "ko": "「오우, 그거다」"},
{"id": "clse07:155400", "ko": "「그래! 유토가 여자애로 통하는지 어떤지 확인이다!!」"},
{"id": "clse07:155500", "ko": "「오, 오우……」"},
{"id": "clse07:155600", "ko": "「…………」"},
{"id": "clse07:155700", "ko": "「호……」"},
{"id": "clse07:155800", "ko": "「예상 이상이군……」"},
{"id": "clse07:155900", "ko": "「그렇지. 무리하는 것보다 남자 말투 쓰는 여자애 캐릭터로 밀고 나가는 게 낫겠어」"},
{"id": "clse07:156000", "ko": "「그러고 보니 둘의 유닛 이름은 이미 정했어?」"},
{"id": "clse07:156100", "ko": "「오케이. 그럼 『밀푀유』의 두 분께 먼저 질문. 아이돌에게 제일 중요한 건 뭐라고 생각해?」"},
{"id": "clse07:156200", "ko": "「노노노. 알겠어? 아이돌에게 가장 중요한 것. 그건 바로――!」"},
{"id": "clse07:156300", "ko": "「서비스 정신이다!」"},
{"id": "clse07:156400", "ko": "「그래. 어떻게 하면 모두가 기뻐해 줄까. 즐겨 줄까. 그것들은 전부 서비스 정신에서 태어나는 거다」"},
{"id": "clse07:156500", "ko": "「서비스를 받고 나쁘게 생각하는 녀석은 없어. 서비스로 기뻐해 준다면 그보다 좋은 건 없지」"},
{"id": "clse07:156600", "ko": "「서비스 과다? 좋잖아. 그걸로 인기가 오른다면」"},
{"id": "clse07:156700", "ko": "「특히 처음 시작할 때는 일단 사람들 눈에 띄지 않으면 얘기가 안 돼. 그러기 위해서는 어느 정도의 서비스는 필요 최저 조건이라고도 할 수 있지」"},
{"id": "clse07:156800", "ko": "「어이쿠, 유토한테는 어려웠나. 요컨대 모두가 기뻐하게 하려면 뭐든지 해야 한다는 거다」"},
{"id": "clse07:156900", "ko": "「이토 프로듀서!」"},
{"id": "clse07:157000", "ko": "「후후~응…… 그건 좀 준비가 필요하니까 잠시 기다려 줄래?」"},
{"id": "clse07:157100", "ko": "「뭐, 이 이토 프로듀서한테 맡겨 두면 아무 걱정 없어. 반드시 너희를 일본 최고의 아이돌로 키워 내 보이겠다!」"},
{"id": "clse07:157200", "ko": "「아리무라 프로듀서한테는 지지 않는다고」"},
{"id": "clse07:157300", "ko": "「하하하하하하하하!」"}
]
