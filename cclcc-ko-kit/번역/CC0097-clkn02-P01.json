[
{"id": "clkn02:0", "ko": "「음……」"},
{"id": "clkn02:100", "ko": "「타쿠루…… 타쿠루라니까……」"},
{"id": "clkn02:200", "ko": "「으음……」"},
{"id": "clkn02:300", "ko": "「자, 타쿠루…… 안 일어나면 늦어……」"},
{"id": "clkn02:400", "ko": "「…………어, 어라?」"},
{"id": "clkn02:500", "ko": "센리?"},
{"id": "clkn02:600", "ko": "센리가 왜 여기에?"},
{"id": "clkn02:700", "ko": "「어제 오랜만에 돌아왔잖아?」"},
{"id": "clkn02:800", "ko": "아, 그렇지."},
{"id": "clkn02:900", "ko": "그렇다는 건……"},
{"id": "clkn02:1000", "ko": "「여기서는 학교까지 평소보다 시간이 더 걸려. 계속 자고 있으면 지각해」"},
{"id": "clkn02:1100", "ko": "「하아암……」"},
{"id": "clkn02:1200", "ko": "방심하면 다시 붙어 버릴 것 같은 눈꺼풀을 간신히 뜨고 침대에서 내려왔다."},
{"id": "clkn02:1300", "ko": "「좋은 아침, 타쿠루. 밥 다 됐어」"},
{"id": "clkn02:1400", "ko": "「응…… 아, 센리」"},
{"id": "clkn02:1500", "ko": "살짝 미소 짓고 방을 나가려는 센리를 나는 불러 세웠다."},
{"id": "clkn02:1600", "ko": "「왜에?」"},
{"id": "clkn02:1700", "ko": "「그…… 아까 내가 하고 싶은 말을 어떻게 알았어?」"},
{"id": "clkn02:1800", "ko": "일어나고 나서 하품한 것 말고는 한마디도 안 했는데, 센리는 내 의문에 전부 답해 줬다."},
{"id": "clkn02:1900", "ko": "「그 정도는 알지…… 우리, 남매잖아」"},
{"id": "clkn02:2000", "ko": "센리는 쿡 웃더니, 얼른 준비하고 오라는 말을 남기고 방을 나갔다."},
{"id": "clkn02:2100", "ko": "남매잖아, 라."},
{"id": "clkn02:2200", "ko": "세상의 남매란 원래 그런 걸……까?"},
{"id": "clkn02:2300", "ko": "「잘 먹었습니다」"},
{"id": "clkn02:2400", "ko": "「타쿠루. 밥 모자라지 않았어?」"},
{"id": "clkn02:2500", "ko": "어느새 센리는 노노로 변신해 있었다."},
{"id": "clkn02:2600", "ko": "이미 학교 갈 준비는 완벽하다는 거다."},
{"id": "clkn02:2700", "ko": "「충분해. 아침부터 너무 많이 먹었을 정도야」"},
{"id": "clkn02:2800", "ko": "「어차피 평소엔 아침 같은 거 제대로 안 먹잖아. 집에 있을 때만이라도 든든히 먹어야지」"},
{"id": "clkn02:2900", "ko": "「유토, 유이! 손수건 여기 둔다~」"},
{"id": "clkn02:3000", "ko": "「노노 언니~! 내 체육복은~?」"},
{"id": "clkn02:3100", "ko": "「벌써 현관에 챙겨 놨어」"},
{"id": "clkn02:3200", "ko": "「아~ 유토. 머리가 엄청 눌렸어요. 고쳐야겠네요」"},
{"id": "clkn02:3300", "ko": "이렇게 정신없는 아침 풍경도 오랜만이네."},
{"id": "clkn02:3400", "ko": "「아~!」"},
{"id": "clkn02:3500", "ko": "「왜 그래?」"},
{"id": "clkn02:3600", "ko": "「정말! 아빠도 참, 또 이런 데다 갈아입을 가운을 두고 갔네」"},
{"id": "clkn02:3700", "ko": "「잠깐 갖다주고 올 테니까 기다려」"},
{"id": "clkn02:3800", "ko": "이렇게 보고 있으니, 꼭 애가 여럿 딸린 엄마 같다."},
{"id": "clkn02:3900", "ko": "하긴 그런 말을 했다간, 너도 그중 하나야, 라고 하겠지만."},
{"id": "clkn02:4000", "ko": "어라?"},
{"id": "clkn02:4100", "ko": "그러고 보니 노노 녀석, 『기다려』라고 했는데, 설마 같이 학교에 갈 생각은 아니겠지."},
{"id": "clkn02:4200", "ko": "말도 안 된다."},
{"id": "clkn02:4300", "ko": "안 그래도 눈에 띄는 노노와 나란히 등교라니, 그런 창피한 짓을 할 수 있겠냐."},
{"id": "clkn02:4400", "ko": "좋아, 지금 먼저 가자."},
{"id": "clkn02:4500", "ko": "「어라? 타쿠루 오빠, 벌써 가?」"},
{"id": "clkn02:4600", "ko": "「응」"},
{"id": "clkn02:4700", "ko": "「잠깐만. 그럼 같이…… 어라? 노노 언니는?」"},
{"id": "clkn02:4800", "ko": "「아버지한테 갔어. 아무튼 난 먼저 간다. 그럼」"},
{"id": "clkn02:4900", "ko": "「어? 아, 타쿠루 오빠, 거기 서~!」"},
{"id": "clkn02:5000", "ko": "불러 세우는 유이의 목소리를 뿌리치고, 나는 도망치듯 아오바 기숙사를 나섰다."},
{"id": "clkn02:5100", "ko": "노노랑 같이 가는 것만으로도 창피한데, 유이에 유토에 우키까지 같이라니 당치도 않다."},
{"id": "clkn02:5200", "ko": "그나저나 유이 녀석, 정말 점점 노노를 닮아 가네."},
{"id": "clkn02:5300", "ko": "먼저 가 버린 일로 노노가 따지러 올까 싶기도 했지만 그런 일도 없이, 시곗바늘과 눈싸움하던 오전 수업도 무사히 끝나고, 드디어 점심시간이 찾아왔다."},
{"id": "clkn02:5400", "ko": "점심은…… 평소처럼 매점에서 사 올까 하고 일어섰는데,"},
{"id": "clkn02:5500", "ko": "「아, 있다 있다. 타쿠~!」"},
{"id": "clkn02:5600", "ko": "오노에가 교실로 들어왔다."},
{"id": "clkn02:5700", "ko": "「웬일이야. 일부러 교실까지 오고」"},
{"id": "clkn02:5800", "ko": "「차오임다, 미야시로 선배」"},
{"id": "clkn02:5900", "ko": "「뭐야…… 아리무라도 같이 왔냐……」"},
{"id": "clkn02:6000", "ko": "「‘뭐야’는 또 뭐예요, 실례되게. 귀여운 히나에가 일부러 3학년 교실까지 와 줬다니깐」"},
{"id": "clkn02:6100", "ko": "「『야호~! 히나에땅이 나를 만나러 와 줬어! 타쿠루, 감격!』 정도는 말해 주는 게 어때요?」", "note": "雛絵たん → 「히나에땅」(たん 은 귀엽게 부르는 말끝)"},
{"id": "clkn02:6200", "ko": "「『야호. 히나에땅이 나를 만나러 와 줬어. 타쿠루 감격』」"},
{"id": "clkn02:6300", "ko": "「으으~ 열받아!!」"},
{"id": "clkn02:6400", "ko": "「왜 화를 내」"},
{"id": "clkn02:6500", "ko": "「완전 거짓말이니까요!」"},
{"id": "clkn02:6600", "ko": "「어떻게 알았어!? 설마 너, 능력을……」"},
{"id": "clkn02:6700", "ko": "「안 써도 알거든!!」"},
{"id": "clkn02:6800", "ko": "「타쿠랑 히나는 정말 사이좋다니까~」"},
{"id": "clkn02:6900", "ko": "「어디가!」⟦n⟧⟦par⟧「어디가!」"},
{"id": "clkn02:7000", "ko": "「거 봐~ 완전 사이좋잖아」"},
{"id": "clkn02:7100", "ko": "「큭……」⟦n⟧⟦par⟧「큭……」"},
{"id": "clkn02:7200", "ko": "「참 나…… 뭐, 상관없지만요. 모처~럼 좋은 거 갖다 줬는데, 미야시로 선배가 그런 태도로 나오면 도로 가져갈 거거든요~」"},
{"id": "clkn02:7300", "ko": "「좋은 거?」"},
{"id": "clkn02:7400", "ko": "그러고 보니 둘 다 작은 봉투를 손에 들고 있다."},
{"id": "clkn02:7500", "ko": "「에헤헤~. 실은 말이야, 오전 수업 때 ⟦col:280aa02d1400⟧베이글⟦col:800000⟧ 만들었거든~」"},
{"id": "clkn02:7600", "ko": "아, 그래서 아까부터 무슨 냄새가 났던 거구나."},
{"id": "clkn02:7700", "ko": "「그래서 말이야, 많이 만들었으니까 타쿠한테도 줄까~ 해서 가져왔어」"},
{"id": "clkn02:7800", "ko": "「오노에랑 아리무라가…… 베이글……」"},
{"id": "clkn02:7900", "ko": "「뭠까, 그 불안한 얼굴은……」"},
{"id": "clkn02:8000", "ko": "「먹을 수는 있는 거겠지?」"},
{"id": "clkn02:8100", "ko": "「세리」"},
{"id": "clkn02:8200", "ko": "「응?」"},
{"id": "clkn02:8300", "ko": "「가자」"},
{"id": "clkn02:8400", "ko": "「어? 잠깐, 히나?」"},
{"id": "clkn02:8500", "ko": "아리무라는 당황하는 오노에의 손을 잡아끌고 교실을 나가려 했다."},
{"id": "clkn02:8600", "ko": "「기다려, 아리무라. 농담이라니까」"},
{"id": "clkn02:8700", "ko": "「농담? 그걸로 끝날 거라고 생각하세요, 미야시로 선배?」"},
{"id": "clkn02:8800", "ko": "「무슨 뜻이야?」"},
{"id": "clkn02:8900", "ko": "「이럴 땐 따로 할 말이 있잖아」"},
{"id": "clkn02:9000", "ko": "「아, 진짜, 알았어. 어쩔 수 없네……」"},
{"id": "clkn02:9100", "ko": "「아리무라가 『부탁드려요, 미야시로 선배. 미천한 제가 만든 베이글이라도 괜찮으시다면 드셔 주시지 않겠습니까?』라고 하면 먹어 줄게」"},
{"id": "clkn02:9200", "ko": "「『부탁드려요, 선배. 귀엽고 미천한 제가 만든 베이글이라도 괜찮으시다면 드셔 주시지 않겠습니까?』」"},
{"id": "clkn02:9300", "ko": "「……라니, 왜 이렇게 되는 건데!!」"},
{"id": "clkn02:9400", "ko": "쓸데없는 말이 좀 붙어 있었는데……"},
{"id": "clkn02:9500", "ko": "「봐 봐, 히나가 구운 베이글, 맛있어 보이지~」"},
{"id": "clkn02:9600", "ko": "「잠깐, 세리…… 방금 대화 들었어?」"},
{"id": "clkn02:9700", "ko": "그렇게 말하면서도 아리무라는 손에 든 봉투에서 동그란 베이글을 꺼냈다."},
{"id": "clkn02:9800", "ko": "「헤에. 겉보기는 나쁘지 않네」"},
{"id": "clkn02:9900", "ko": "「당연하죠, 이 히나에가 만들었으니까요」"}
]
