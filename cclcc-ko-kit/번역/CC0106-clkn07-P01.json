[
{"id": "clkn07:0", "ko": "노노에게 그렇게 말한 내 말은 대체로 틀리지 않았다."},
{"id": "clkn07:100", "ko": "「그 교칙이 가결돼서 어떻게 되나 했는데, 별로 달라진 게 없네」"},
{"id": "clkn07:200", "ko": "「그렇지? 결국 우리하고는 거의 상관없는 일이라고」"},
{"id": "clkn07:300", "ko": "「큭…… 그건 그거대로 왠지 열받지만」"},
{"id": "clkn07:400", "ko": "이성과의 교류를 전부 금지하는――그런 터무니없는 교칙도 아니고, 사귀는 상대도 마음에 둔 상대도 없는 우리로서는 교내 연애가 금지된다 한들 아무것도 곤란할 게 없다."},
{"id": "clkn07:500", "ko": "뭐, 가끔――."},
{"id": "clkn07:600", "ko": "「야, 찾았다! 저기다!」"},
{"id": "clkn07:700", "ko": "「좋아, 가자!」"},
{"id": "clkn07:800", "ko": "「야, 너희들!! 거기서 몰래 뭐 하는 거야!!」"},
{"id": "clkn07:900", "ko": "「아, 아니 우린 딱히……」"},
{"id": "clkn07:1000", "ko": "「맞아. 그냥 생일 선물 받고 있었을 뿐이잖아」"},
{"id": "clkn07:1100", "ko": "「즉 생일 선물을 주고받는 사이라는 거군」"},
{"id": "clkn07:1200", "ko": "「선물 정도는 친구끼리도 주잖아」"},
{"id": "clkn07:1300", "ko": "「……어디 보자…… 반지인가…… 아웃이군」"},
{"id": "clkn07:1400", "ko": "「좋아, 둘 다 학생회실로 같이 가 줘야겠다」"},
{"id": "clkn07:1500", "ko": "「말도 안 돼!!」"},
{"id": "clkn07:1600", "ko": "같은 일도 있는 모양이지만, 뭐 그것도 우리하고는 상관없는 일이었다."},
{"id": "clkn07:1700", "ko": "「왠지 괜히 난리 친 느낌이네」"},
{"id": "clkn07:1800", "ko": "「그러게……」"},
{"id": "clkn07:1900", "ko": "「아, 그러고 보니 너 다음엔 언제 집에 가냐? 일주일에 한 번은 가기로 약속했다며?」"},
{"id": "clkn07:2000", "ko": "「뭐? 네가 그 얘기를 어떻게 알아?」"},
{"id": "clkn07:2100", "ko": "「어제 우연히 유이를 만났거든. 집에 오라고 전해 달래」"},
{"id": "clkn07:2200", "ko": "유이 녀석……"},
{"id": "clkn07:2300", "ko": "뭐, 그래도 이번 주는 아직 안 갔고, 대뜸 약속을 어기는 것도 찜찜하긴 하다."},
{"id": "clkn07:2400", "ko": "게다가 그랬다간 다음에 갔을 때 무슨 소리를 들을지 모르고."},
{"id": "clkn07:2500", "ko": "「가끔은 귀여운 여동생 부탁 좀 제대로 들어줘라」"},
{"id": "clkn07:2600", "ko": "「이토……」"},
{"id": "clkn07:2700", "ko": "「뭐?」"},
{"id": "clkn07:2800", "ko": "「너…… 설마 유이를 어떻게 해 볼 생각은 아니겠지?」"},
{"id": "clkn07:2900", "ko": "「어, 어떻게 해 보다니, 무슨 소리야?」"},
{"id": "clkn07:3000", "ko": "「그러니까 그…… 노리고 있다든가」"},
{"id": "clkn07:3100", "ko": "「바, 바보! 나는 그런 취향 없다고」"},
{"id": "clkn07:3200", "ko": "정말일까?"},
{"id": "clkn07:3300", "ko": "「그렇게 소중하면 상자에라도 넣어서 보관해 두든가. 아니, 좀 더 아껴 주라고」"},
{"id": "clkn07:3400", "ko": "뭐, 이토라면 그럴 리는 없나."},
{"id": "clkn07:3500", "ko": "이 녀석, 어느 쪽이냐 하면 차가워 보이는 미인한테 욕먹고 싶어 하는 타입이니까."},
{"id": "clkn07:3600", "ko": "「어쩔 수 없지. 집에는 오늘 가기로 할게……」"},
{"id": "clkn07:3700", "ko": "「어~ 그래라 그래」"},
{"id": "clkn07:3800", "ko": "이토한테 설교를 들었다는 게 좀 분하지만, 약속은 약속이다."},
{"id": "clkn07:3900", "ko": "「「「「잘 먹었습니다」」」」"},
{"id": "clkn07:4000", "ko": "「네, 변변찮았습니다~」"},
{"id": "clkn07:4100", "ko": "「있잖아, 타쿠루 형! 카드놀이 하자, 카드놀이」"},
{"id": "clkn07:4200", "ko": "「안 돼, 유토. 노는 건 숙제 끝내고 나서」"},
{"id": "clkn07:4300", "ko": "「에~ 모처럼 타쿠루 형이 왔는데에」"},
{"id": "clkn07:4400", "ko": "「밥 먹기 전에 안 끝내 놓으니까 그렇지」"},
{"id": "clkn07:4500", "ko": "「칫~」"},
{"id": "clkn07:4600", "ko": "「유이. 설거지 좀 도와줄래?」"},
{"id": "clkn07:4700", "ko": "「네에~」"},
{"id": "clkn07:4800", "ko": "「아, 그럼 저는 진료소 빨래를 정리하고 올게요」"},
{"id": "clkn07:4900", "ko": "「부탁해, 고마워」"},
{"id": "clkn07:5000", "ko": "「아, 아빠는 술 마시기 전에 욕실 청소 부탁해」"},
{"id": "clkn07:5100", "ko": "등을 돌린 채 말하는 센리의 말에, 찬장 속 소주로 손을 뻗던 아버지의 움직임이 멈췄다."},
{"id": "clkn07:5200", "ko": "「저 녀석…… 등에 눈이라도 달렸냐?」"},
{"id": "clkn07:5300", "ko": "「그럴지도」"},
{"id": "clkn07:5400", "ko": "여기 아오바 기숙사 안에서의 센리는 집안의 모든 걸 꿰뚫고 있는 것 같다."},
{"id": "clkn07:5500", "ko": "학교에서도 그녀는 쿠루스 노노로서, 학생회장으로서 모든 일에 눈을 돌리고 있다."},
{"id": "clkn07:5600", "ko": "센리는 늘 진짜 쿠루스 노노와 자신을 비교하며 주눅 들어 있지만, 그저 흉내만으로 거기까지 할 수 있을 리가 없다."},
{"id": "clkn07:5700", "ko": "결국 그건 센리가 원래 갖추고 있던 자질이겠지."},
{"id": "clkn07:5800", "ko": "「어쩔 수 없지, 욕실 청소나 하고 올까」"},
{"id": "clkn07:5900", "ko": "「센리. 나도 설거지 도울게」"},
{"id": "clkn07:6000", "ko": "「어머, 타쿠루가 먼저 말해 주다니 별일이네」"},
{"id": "clkn07:6100", "ko": "아버지까지 돕고 있는데 나만 아무것도 안 할 수는 없다."},
{"id": "clkn07:6200", "ko": "「그럼 씻은 그릇 좀 닦아 줄래?」"},
{"id": "clkn07:6300", "ko": "「오케이」"},
{"id": "clkn07:6400", "ko": "센리, 유이와 셋이서 나란히 개수대 앞에 섰다."},
{"id": "clkn07:6500", "ko": "오랜만에 집안일을 거들어 보니, 식구가 많은 만큼 꽤 힘들다."},
{"id": "clkn07:6600", "ko": "그런데 센리는 매일 이렇게 공부와 집안일을 같이 해내고 있다."},
{"id": "clkn07:6700", "ko": "혹시 센리, 사실은 굉장한 거 아냐……?"},
{"id": "clkn07:6800", "ko": "「그러고 보니 고등부에 연애 금지령이 나왔다며?」"},
{"id": "clkn07:6900", "ko": "「……응, 뭐……」"},
{"id": "clkn07:7000", "ko": "「진짜 봐줬으면 좋겠어~. 센리 언니나 타쿠루 오빠는 졸업하니까 괜찮겠지만, 나는 내년부터라고?」"},
{"id": "clkn07:7100", "ko": "「그런데 교내 연애 금지라니」"},
{"id": "clkn07:7200", "ko": "「어머. 유이한테는 타쿠루가 있잖아」"},
{"id": "clkn07:7300", "ko": "「푸웁!」"},
{"id": "clkn07:7400", "ko": "「뭐, 뭐뭐, 뭐야 그게! 내가 왜 타쿠루 오빠 따위랑!」"},
{"id": "clkn07:7500", "ko": "“따위”라니……"},
{"id": "clkn07:7600", "ko": "「게다가…… 타쿠루 오빠한테는 센리 언니가 있잖아……」"},
{"id": "clkn07:7700", "ko": "「푸푸풉!!」"},
{"id": "clkn07:7800", "ko": "「어, 어째서 내가 타쿠루 따위랑……」"},
{"id": "clkn07:7900", "ko": "「아니, 너희……」"},
{"id": "clkn07:8000", "ko": "아까부터 “따위” “따위” 하고 연발하니, 아무리 나라도 상처받는다고……"},
{"id": "clkn07:8100", "ko": "「뭐냐, 타쿠루. 너 꽤 인기 만점이구나」"},
{"id": "clkn07:8200", "ko": "어느새 욕실 청소를 마치고 돌아온 아버지가 히죽거리며 말했다."},
{"id": "clkn07:8300", "ko": "인기 만점…… 인가, 이게……?"},
{"id": "clkn07:8400", "ko": "「정말, 아빠까지 놀리지 마」"},
{"id": "clkn07:8500", "ko": "「맞아. 애초에 타쿠루 오빠랑은 그…… 남매고」"},
{"id": "clkn07:8600", "ko": "「알고 있냐, 너희들. 사실은 말이다…… 너희는 실은…… 피가 안 섞인 가족이란다……」"},
{"id": "clkn07:8700", "ko": "뭐, 뭐라고~!"},
{"id": "clkn07:8800", "ko": "「정말, 아빠, 그런 건 새삼 말 안 해도 알거든」"},
{"id": "clkn07:8900", "ko": "「와하하! 그러냐. 알면 됐다」"},
{"id": "clkn07:9000", "ko": "뭐가 됐다는 건지……"},
{"id": "clkn07:9100", "ko": "하지만……"},
{"id": "clkn07:9200", "ko": "확실히 보는 사람에 따라서는 인기 만점으로 보이지 않을 것도 없을지 모른다."},
{"id": "clkn07:9300", "ko": "하지만 일단 “남매”라는 이름으로 한 지붕 아래 살고 있는 이상, ⟦rb⟧그런 일⟦rt⟧⟦rbc⟧●●●⟦/r⟧은 일어나지 않을 거라고 생각하는데……"},
{"id": "clkn07:9400", "ko": "어떨……까."},
{"id": "clkn07:9500", "ko": "아니, 역시 그건 없지."},
{"id": "clkn07:9600", "ko": "「그보다 타쿠루. 목욕하고 와」"},
{"id": "clkn07:9700", "ko": "「어, 응……」"},
{"id": "clkn07:9800", "ko": "「하아……」"},
{"id": "clkn07:9900", "ko": "목욕을 하면 일본인이라서 다행이라는 생각이 든단 말이지."}
]
