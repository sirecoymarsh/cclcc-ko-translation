[
{"id": "clse07:29800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:29900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:30000", "ko": "「흐~응, 그렇게 얼버무릴 생각이에요?」"},
{"id": "clse07:30100", "ko": "「좋아요. 그렇게 얼버무리겠다면 실토하게 만들어 줄게요」"},
{"id": "clse07:30200", "ko": "「에잇」"},
{"id": "clse07:30300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:30400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:30500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:30600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:30700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:30800", "ko": "「응?」"},
{"id": "clse07:30900", "ko": "「선배~? 뭘 보고 있었어요~?」"},
{"id": "clse07:31000", "ko": "「얼버무려도 안 돼요. 아까 보고 있었죠?」"},
{"id": "clse07:31100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:31900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:32000", "ko": "「으랴아아아아아앗!!!」"},
{"id": "clse07:32100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:32200", "ko": "「아…… 선배. 차오임다」"},
{"id": "clse07:32300", "ko": "「빨리 준비 안 하면 학교 늦어요」"},
{"id": "clse07:32400", "ko": "「선배. 자, 이거」"},
{"id": "clse07:32500", "ko": "「오, 눈치 빠르심다~」"},
{"id": "clse07:32600", "ko": "「엄마가 또 온다고 했으니까요. 그때를 위해서예요」"},
{"id": "clse07:32700", "ko": "「참고로 아까 그 발언을 넘어간 건 제 배려니까요」"},
{"id": "clse07:32800", "ko": "「그러니까 이거, 외워 두세요」"},
{"id": "clse07:32900", "ko": "「왜요?」"},
{"id": "clse07:33000", "ko": "「흠…… 뭐, 그것도 그렇슴다」"},
{"id": "clse07:33100", "ko": "「알~겠습니다. 그럼 학교에서는 되도록 접촉하지 않는 방향으로 부탁드림다!」"},
{"id": "clse07:33200", "ko": "「미야시로 선배!!!」"},
{"id": "clse07:33300", "ko": "「그렇긴 한데요~, 이건 사정이……」"},
{"id": "clse07:33400", "ko": "「이시다…… 아~ 같은 반이었던 적은 있는데, 별로 기억 안 나네」"},
{"id": "clse07:33500", "ko": "「진짜임다」"},
{"id": "clse07:33600", "ko": "「아~ 그렇다고 해도 딱히 이상한 관계는 아니에요. 그냥 한동안 신세 지고 있는 것뿐이고. 그쵸, 선배♪」"},
{"id": "clse07:33700", "ko": "「잠깐~! 잠깐 잠깐~! 왜 다들 납득해 버리는 검까~! 이럴 때는 보통 여자애 걱정을 하는 거잖아요」"},
{"id": "clse07:33800", "ko": "「으그그그~……」"},
{"id": "clse07:33900", "ko": "「뭐, 그런 거예요」"},
{"id": "clse07:34000", "ko": "「일단 꾸중 안 들은 건 다행이지만……」"},
{"id": "clse07:34100", "ko": "「에~. 딱히 떳떳하지 못한 짓을 하는 것도 아닌데요~」"},
{"id": "clse07:34200", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:34300", "ko": "「아뇨~, 아무것도♪」"},
{"id": "clse07:34400", "ko": "「네~. 알~겠습니다~」"},
{"id": "clse07:34500", "ko": "「어쩔 수 없지. 미야시로 선배, 가요」"},
{"id": "clse07:34600", "ko": "「네~. 알~겠습니다~. 그럼 미야시로 선배, 가요」"},
{"id": "clse07:34700", "ko": "「으아아아아아아아아아아아아아아!!」"},
{"id": "clse07:34800", "ko": "「우와~. 등에 큼지막하게 『바보』라고 쓴 종이가 붙어 있었어요, 선배」"},
{"id": "clse07:34900", "ko": "「누굴까요~, 요즘 세상에 이런 장난을 치다니. 너무하다~」"},
{"id": "clse07:35000", "ko": "「뭐, 그래도 학생회 사람도 문제없다고 했으니까, 이걸로 숨길 것 없이 당당하게 미야시로 선배 집에서 공동생활할 수 있다는 거네요」"},
{"id": "clse07:35100", "ko": "「뭔가요?」"},
{"id": "clse07:35200", "ko": "「으음!」"},
{"id": "clse07:35300", "ko": "「으으~……」"},
{"id": "clse07:35400", "ko": "「차오~임다! 아리무라 히나에, 방금 귀환했습니다~!」"},
{"id": "clse07:35500", "ko": "「다녀왔습니다!!」"},
{"id": "clse07:35600", "ko": "「좋아요. 영차」"},
{"id": "clse07:35700", "ko": "「후후후~」"},
{"id": "clse07:35800", "ko": "「봐요, 저는 남이 하는 말이 거짓말인지 진짜인지 알잖아요~」"},
{"id": "clse07:35900", "ko": "「그래서 요즘 생각한 건데요. 거짓말도 계속 하다 보면 진짜가 될 수도 있지 않을까 하고」"},
{"id": "clse07:36000", "ko": "「모르겠어요?」"},
{"id": "clse07:36100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:36200", "ko": "「얼마 전에 엄마랑 얘기했을 때도 전~부 거짓말이었고!」"},
{"id": "clse07:36300", "ko": "「셧~ 업!!」"},
{"id": "clse07:36400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:36500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:36600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:36700", "ko": "「이건 제 자존심을 건 싸움이에요. 누가 뭐라고 하든 저는 할 거예요!」"},
{"id": "clse07:36800", "ko": "「그래요, 결코 질 수 없는 싸움이 거기 있다!」"},
{"id": "clse07:36900", "ko": "「뭐, 그래도 일단 오늘은 아직 전초전이라는 걸로……」"},
{"id": "clse07:37000", "ko": "「자, 드세요」"},
{"id": "clse07:37100", "ko": "「왜 그래요? 안 먹어요?」"},
{"id": "clse07:37200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:37300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:37400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:37500", "ko": "「어라? 선배, 뜨거운 거 못 먹어요?」"},
{"id": "clse07:37600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:37700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:37800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:37900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:38000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:38100", "ko": "「헤에~……」"},
{"id": "clse07:38200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:38300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:38400", "ko": "「변명은 필요 없어! 모처럼 만들었으니까 먹어~! 자, 먹어! 전부 먹어~!!!」"},
{"id": "clse07:38500", "ko": "「으앙, 이렇게 된 이상 내가 먹어 주겠어~!」"},
{"id": "clse07:38600", "ko": "「아~ 맛있다! 이렇게 맛있는데 못 먹다니, 선배 불쌍해~」"},
{"id": "clse07:38700", "ko": "「말해 두지만, 이제 선배한테는 안 줄 거예요!」"},
{"id": "clse07:38800", "ko": "「으으…… 못 움직이겠어…… 진짜 못 움직이겠슴다……」"},
{"id": "clse07:38900", "ko": "「이상해…… 이럴 생각이 아니었는데……」"},
{"id": "clse07:39000", "ko": "「오, 오브리가도 아리가또……」"},
{"id": "clse07:39100", "ko": "「으그그…… 그래도 이 정도로 포기할 히나에가 아니니까요…… 두고 보세요, 미야시로 선배……」"},
{"id": "clse07:39200", "ko": "「말해 두는데요, 오늘은 좀 장난스러운 일면을 보여 준 것뿐이니까요」"},
{"id": "clse07:39300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:39400", "ko": "「그럼 안녕히 주무세요」"},
{"id": "clse07:39500", "ko": "「무슨 일 있어요?」"},
{"id": "clse07:39600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:39700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"}
]
