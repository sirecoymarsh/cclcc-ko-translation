[
{"id": "clka06:10000", "ko": "「…………」"},
{"id": "clka06:10100", "ko": "여기서 이 사진을 공개해도 되는 걸까?"},
{"id": "clka06:10200", "ko": "「……」"},
{"id": "clka06:10300", "ko": "「타쿠루?」"},
{"id": "clka06:10400", "ko": "「……」"},
{"id": "clka06:10500", "ko": "나는 스마트폰을 주머니에 넣고 힘없이 의자에 앉았다."},
{"id": "clka06:10600", "ko": "결정적인 증거를 내놓을 수는 없다."},
{"id": "clka06:10700", "ko": "될 대로 되라다."},
{"id": "clka06:10800", "ko": "「……」"},
{"id": "clka06:10900", "ko": "「……타쿠루」"},
{"id": "clka06:11000", "ko": "「인정하는 거구나」"},
{"id": "clka06:11100", "ko": "「……」"},
{"id": "clka06:11200", "ko": "어쩔 수 없다."},
{"id": "clka06:11300", "ko": "나는 각오를 다지고 고개를 끄덕이려 했다."},
{"id": "clka06:11400", "ko": "그때."},
{"id": "clka06:11500", "ko": "「후훗」"},
{"id": "clka06:11600", "ko": "「응? 뭐야?」"},
{"id": "clka06:11700", "ko": "「아리무라, 방금 웃었냐?」"},
{"id": "clka06:11800", "ko": "「아뇨? 세리 아니에요?」"},
{"id": "clka06:11900", "ko": "「아니야〜. 논?」"},
{"id": "clka06:12000", "ko": "「나는 아닌데……」"},
{"id": "clka06:12100", "ko": "「후훗」"},
{"id": "clka06:12200", "ko": "「혹시…… 카즈키?」"},
{"id": "clka06:12300", "ko": "「후후훗」"},
{"id": "clka06:12400", "ko": "「하나?」"},
{"id": "clka06:12500", "ko": "아무래도 소리의 주인은 쿠루스 옆에 앉아 있는 카즈키인 것 같았다."},
{"id": "clka06:12600", "ko": "고개를 숙이고 있어서 얼굴은 보이지 않지만, 어깨가 미세하게 떨리고 있다. 웃음을 참고 있는 것 같다."},
{"id": "clka06:12700", "ko": "「카즈키?」"},
{"id": "clka06:12800", "ko": "「아하하! 이, 이제 못 참겠어!」"},
{"id": "clka06:12900", "ko": "「미, 미야시로 선배, 아무리 그래도 사람이 너무 좋잖아요!! 아하하핫!!」"},
{"id": "clka06:13000", "ko": "「에?」"},
{"id": "clka06:13100", "ko": "배를 잡고 큰 소리로 웃기 시작하는 카즈키. 평소와 다른 말투, 평소와 다른 표정을 보고 쿠루스 일행은 어안이 벙벙해 있다."},
{"id": "clka06:13200", "ko": "카즈키는 한동안 의자 위에서 데굴데굴 구르며 웃었다."},
{"id": "clka06:13300", "ko": "「이히힛! ……후우. 너무 웃겨서 웃다 죽을 뻔했어요」"},
{"id": "clka06:13400", "ko": "정말 웃겼던 모양이다. 눈가에 맺힌 눈물을 닦으며 카즈키는 웃는 얼굴로 말했다."},
{"id": "clka06:13500", "ko": "「음, 미야시로 선배는 무죄예요」"},
{"id": "clka06:13600", "ko": "「어?」"},
{"id": "clka06:13700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:13800", "ko": "「잠깐, 카즈키, 그거 진짜야!?」"},
{"id": "clka06:13900", "ko": "「으음, 진짜네요. 하나는 거짓말을 안 하고 있어요」"},
{"id": "clka06:14000", "ko": "「아리무라가 그렇다면 그런 거겠지」"},
{"id": "clka06:14100", "ko": "「어, 그래도, 그럼, 어떻게 된 거야?」"},
{"id": "clka06:14200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:14300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:14400", "ko": "「뭐엇!?」"},
{"id": "clka06:14500", "ko": "품행 방정한 학생회장에게는 너무 자극적인 말이었는지, 쿠루스는 입만 뻐끔거릴 뿐 더는 말을 하지 못하게 되었다."},
{"id": "clka06:14600", "ko": "「하나? 너, 하나 맞아?」"},
{"id": "clka06:14700", "ko": "「뭔가 평소랑 다른데……」"},
{"id": "clka06:14800", "ko": "「알겠어요. 사실은 숨긴 채로 있어도 되지만, 제대로 설명할게요」"},
{"id": "clka06:14900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka06:15000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka06:15100", "ko": "카즈키는 우선 일의 경위를 설명해서 모두의 오해를 풀어 주었다."},
{"id": "clka06:15200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:15300", "ko": "나는 내 체면을 버리면서까지 카즈키가 창피를 당하지 않게 하려고 한 셈이니, 다들 조금은 칭찬해 줄 줄 알았는데――"},
{"id": "clka06:15400", "ko": "「어디로 보나 하나잖아요. 왜 한눈에 못 알아본 거예요? 미야시로 선배 눈은 썩었어요?」"},
{"id": "clka06:15500", "ko": "「에엣!? 그치만 얼굴이 가려져 있었고……」"},
{"id": "clka06:15600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:15700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:15800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:15900", "ko": "「그런 거야!?」"},
{"id": "clka06:16000", "ko": "「평소에 미야시로 선배가 얼마나 하나를 여자애로 안 보는지 알겠네요. 최악이에요」"},
{"id": "clka06:16100", "ko": "「왜 내가 뭇매를 맞는 건데!?」"},
{"id": "clka06:16200", "ko": "「자자자, 여러분. 미야시로 선배는 일단은 저랑 하나를 지키려고 한 거니까, 그 마음씨를 봐서 이번엔 용서해 줘요」"},
{"id": "clka06:16300", "ko": "……? 방금 카즈키가 이상한 말을 했다."},
{"id": "clka06:16400", "ko": "「방금 『저랑 하나』라고 했어?」"},
{"id": "clka06:16500", "ko": "「네, 했어요」"},
{"id": "clka06:16600", "ko": "하나는 히죽 웃더니 사태를 더욱 혼란에 빠뜨리는 『설명』을 시작했다."},
{"id": "clka06:16700", "ko": "「저는 하나가 아니에요. 아, 아니, 이 몸은 확실히 하나의 몸이지만, 저는 하나가 아니에요」"},
{"id": "clka06:16800", "ko": "「무슨, 소리야?」"},
{"id": "clka06:16900", "ko": "「저는 하나가 만들어 낸 또 하나의 인격이에요」"},
{"id": "clka06:17000", "ko": "「인격〜?」"},
{"id": "clka06:17100", "ko": "「네. 어느 날 하나는 이렇게 생각했어요. 이대로는 한정된 학창 시절을 ⟦col:280aa02d1400⟧엠스⟦col:800000⟧에 다 써 버리고 끝나겠다고」"},
{"id": "clka06:17200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:17300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka06:17400", "ko": "「뭔가 순수한 건지 비뚤어진 건지 모르겠네」"},
{"id": "clka06:17500", "ko": "「하지만 하나는 이성은커녕 동성하고도 제대로 이야기를 못 해요」"},
{"id": "clka06:17600", "ko": "「게다가 설령 마음에 둔 남자랑 이야기할 수 있게 된다 해도, 하나의 능력은 하나가 말하는 한 무작위로 발동해요. 그건 피하고 싶었어요」"},
{"id": "clka06:17700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:17800", "ko": "「남녀 상관없이 편하게 이야기할 수 있고, 게다가 이야기를 해도 능력이 발동하지 않는 『또 하나의 나』요」"},
{"id": "clka06:17900", "ko": "「그 소원을 입 밖에 냈을 때 하나의 망상 구현화 능력이 발동해서, 저라는 인격이 태어난 거예요」"},
{"id": "clka06:18000", "ko": "「대인 커뮤니케이션 능력 제로인 하나가 장밋빛 청춘을 구가하기 위해 만들어 낸 제2의 인격. 그게 저예요」"},
{"id": "clka06:18100", "ko": "「청춘 시절을 구가한다니, 뭘 하는데?」"},
{"id": "clka06:18200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:18300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:18400", "ko": "「거기 뭘 신나서 그러는 거예요」"},
{"id": "clka06:18500", "ko": "「새 인격이라니, 그런 게 그렇게 쉽게 생기는 게 아니잖아요」"},
{"id": "clka06:18600", "ko": "「……아니」"},
{"id": "clka06:18700", "ko": "아까의 충격에서 쿠루스가 겨우 정신을 차린다."},
{"id": "clka06:18800", "ko": "「카즈키의 능력은 『입 밖에 낸 일이 구현되는 능력』이야. 경우에 따라서는 새 인격도」"},
{"id": "clka06:18900", "ko": "「흐음……」"},
{"id": "clka06:19000", "ko": "「후훗」"},
{"id": "clka06:19100", "ko": "「그렇다고는 해도 뭐, 기간 한정이에요. 하나도 저한테 무기한으로 몸을 빌려줄 생각은 없는 것 같아서, 망상이 구현된 시점부터 남은 시간이 정해져 있어요」"},
{"id": "clka06:19200", "ko": "「기한은 오늘 하루. 정확히는 잠들 때까지. 내일 눈을 뜨면 저는 깨끗이 사라져 있을 테니까, 그 점은 걱정 마세요」"},
{"id": "clka06:19300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:19400", "ko": "「빨리라니, 너 말이야……!?」"},
{"id": "clka06:19500", "ko": "「네, 그런 거니까요」"},
{"id": "clka06:19600", "ko": "내 항의를 못 들은 건지 못 들은 척하는 건지, 이 카즈키 아닌 카즈키는 종종걸음으로 내 곁에 다가와 고개를 갸웃하며 웃었다."},
{"id": "clka06:19700", "ko": "", "note": "보류 — 성적 묘사"}
]
