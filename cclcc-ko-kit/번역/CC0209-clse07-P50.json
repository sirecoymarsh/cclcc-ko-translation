[
{"id": "clse07:477300", "ko": "「자, 자, 감았어」"},
{"id": "clse07:477400", "ko": "「아, 아아……」"},
{"id": "clse07:477500", "ko": "「아, 알고 있어……」"},
{"id": "clse07:477600", "ko": "「하아아〜……」"},
{"id": "clse07:477700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:477800", "ko": "「어?」"},
{"id": "clse07:477900", "ko": "「아, 아니야. 내가 아니야. 차단기가 내려간 거야」"},
{"id": "clse07:478000", "ko": "「잠깐 기다려. 눈이 익숙해지면 어떻게 해 볼 테니까」"},
{"id": "clse07:478100", "ko": "「아, 아리무――!」"},
{"id": "clse07:478200", "ko": "「으…… 으읏!?」"},
{"id": "clse07:478300", "ko": "「바보, 움직이지 마! 위험해!」"},
{"id": "clse07:478400", "ko": "「그, 그렇…… 지……」"},
{"id": "clse07:478500", "ko": "「읏……!」"},
{"id": "clse07:478600", "ko": "「아, 안 했어! 그보다 지금 그런 말 할 때야!」"},
{"id": "clse07:478700", "ko": "「어떻게…… 할까……」"},
{"id": "clse07:478800", "ko": "「아……」"},
{"id": "clse07:478900", "ko": "「있다. 불 켜는 방법……」"},
{"id": "clse07:479000", "ko": "「켜도…… 될까?」"},
{"id": "clse07:479100", "ko": "「아아……」"},
{"id": "clse07:479200", "ko": "「…………」"},
{"id": "clse07:479300", "ko": "「아리무라?」"},
{"id": "clse07:479400", "ko": "「으, 응……」"},
{"id": "clse07:479500", "ko": "「후우……」"},
{"id": "clse07:479600", "ko": "「아……」"},
{"id": "clse07:479700", "ko": "「저기, 아리무라――」"},
{"id": "clse07:479800", "ko": "「어?」"},
{"id": "clse07:479900", "ko": "「그, 그렇지……」"},
{"id": "clse07:480000", "ko": "「어? 아, 아아…… 그렇지……」"},
{"id": "clse07:480100", "ko": "「…………」"},
{"id": "clse07:480200", "ko": "「…………」"},
{"id": "clse07:480300", "ko": "「저기…… 아까부터 뭐 하는 거야, 그거?」"},
{"id": "clse07:480400", "ko": "「요가아? 요가라니, 그 요가?」"},
{"id": "clse07:480500", "ko": "「여, 여자들은 요가 같은 거 좋아하더라……」"},
{"id": "clse07:480600", "ko": "「패스」"},
{"id": "clse07:480700", "ko": "「애초에 나는 두뇌파라서 몸 쓰는 건 서툴러」"},
{"id": "clse07:480800", "ko": "「게다가 요가 같은 거 해 봤자 기껏해야 몸이 유연해지는 정도잖아」"},
{"id": "clse07:480900", "ko": "「장점이라. 예를 들면」"},
{"id": "clse07:481000", "ko": "「해. 취재라든가」"},
{"id": "clse07:481100", "ko": "「웃긴 표정?」"},
{"id": "clse07:481200", "ko": "「싫어」"},
{"id": "clse07:481300", "ko": "「뭐?」"},
{"id": "clse07:481400", "ko": "「어? 아, 아니, 잠깐만――」"},
{"id": "clse07:481500", "ko": "「…………」"},
{"id": "clse07:481600", "ko": "「아니, 오늘은 어제처럼 막 달려들지 않는구나 싶어서」"},
{"id": "clse07:481700", "ko": "「어쩔 수 없지. 영화라도 볼까」"},
{"id": "clse07:481800", "ko": "「너, 문예부원이잖아……」"},
{"id": "clse07:481900", "ko": "「아쉽지만 그런 영화는 안 하는 것 같네」"},
{"id": "clse07:482000", "ko": "「어느 게 좋아?」"},
{"id": "clse07:482100", "ko": "「돌아간다」"},
{"id": "clse07:482200", "ko": "「그래 놓고 재미없으면 불평할 생각이지」"},
{"id": "clse07:482300", "ko": "「흐음……」"},
{"id": "clse07:482400", "ko": "「이쪽이군」"},
{"id": "clse07:482500", "ko": "「돌아갈래」"},
{"id": "clse07:482600", "ko": "「…………」"},
{"id": "clse07:482700", "ko": "「…………」"},
{"id": "clse07:482800", "ko": "「아리무라……」"},
{"id": "clse07:482900", "ko": "「알았으니까, 그만 울어, 응?」"},
{"id": "clse07:483000", "ko": "「부탁? 뭔데」"},
{"id": "clse07:483100", "ko": "「아니……」"},
{"id": "clse07:483200", "ko": "「벼, 별로……」"},
{"id": "clse07:483300", "ko": "「그, 그런 생각 안 했거든」"},
{"id": "clse07:483400", "ko": "「아………」"},
{"id": "clse07:483500", "ko": "「아, 아니야. 방금 건――」"},
{"id": "clse07:483600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:483700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:483800", "ko": "「…………」"},
{"id": "clse07:483900", "ko": "「어?」"},
{"id": "clse07:484000", "ko": "「아……」"},
{"id": "clse07:484100", "ko": "「어?」"},
{"id": "clse07:484200", "ko": "「보, 봤냐니…… 뭘?」"},
{"id": "clse07:484300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:484400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:484500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:484600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:484700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:484800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:484900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:485000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:485100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:485200", "ko": "「해야 할 말?」"},
{"id": "clse07:485300", "ko": "「대체 뭐냐고, 아까부터!!」"},
{"id": "clse07:485400", "ko": "「뭣!?」"},
{"id": "clse07:485500", "ko": "「빽빽하게!?」"},
{"id": "clse07:485600", "ko": "「수북하게!!?」"},
{"id": "clse07:485700", "ko": "「꺅!」"},
{"id": "clse07:485800", "ko": "「히이이!」"},
{"id": "clse07:485900", "ko": "「으아아아!」"},
{"id": "clse07:486000", "ko": "「크아아아아아!」"},
{"id": "clse07:486100", "ko": "「아…… 아아…… 아아……」"},
{"id": "clse07:486200", "ko": "「부…… 부끄러워……」"},
{"id": "clse07:486300", "ko": "「어?」"},
{"id": "clse07:486400", "ko": "「아갓!!!」"},
{"id": "clse07:486500", "ko": "「아야야야……」"},
{"id": "clse07:486600", "ko": "「미안……」"},
{"id": "clse07:486700", "ko": "「괘, 괜찮아! 이 정도는 아무렇지도 않으니까!」"},
{"id": "clse07:486800", "ko": "「…………」"},
{"id": "clse07:486900", "ko": "「…………」"},
{"id": "clse07:487000", "ko": "「참나, 무슨 볼일인가 했더니……」"},
{"id": "clse07:487100", "ko": "「나는 너를 절친이라고 생각한 적 없는데」"},
{"id": "clse07:487200", "ko": "「카즈키한테 갔어. 샤워 빌린다고」"}
]
