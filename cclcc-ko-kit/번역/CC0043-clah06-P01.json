[
{"id": "clah06:0", "ko": "「…………」"},
{"id": "clah06:100", "ko": "「하…… 으으응…… 아앗……」"},
{"id": "clah06:200", "ko": "「…………」"},
{"id": "clah06:300", "ko": "「하아앙……」"},
{"id": "clah06:400", "ko": "「저기…… 아까부터 뭐 하는 거야, 그거?」"},
{"id": "clah06:500", "ko": "「아, 이거요? ⟦col:280aa02d1400⟧요가⟦col:800000⟧예요」"},
{"id": "clah06:600", "ko": "「요가아? 요가라니, 그 요가?」"},
{"id": "clah06:700", "ko": "요가라기보다 그냥 요염한 소리를 내고 있는 것 같았지만.", "note": "ヨガ(요가)/ヨガる(교성을 내다) 말장난 → 「요가/요염한」"},
{"id": "clah06:800", "ko": "그보다, 굳이 이렇게 좁은 데서 할 필요는 없을 텐데."},
{"id": "clah06:900", "ko": "「응…… 으읏……」"},
{"id": "clah06:1000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah06:1100", "ko": "「힐끗」"},
{"id": "clah06:1200", "ko": "앗, 위험해, 위험해."},
{"id": "clah06:1300", "ko": "이래서야 아리무라가 노린 대로다."},
{"id": "clah06:1400", "ko": "「여, 여자애들은 요가 같은 거 좋아하더라……」"},
{"id": "clah06:1500", "ko": "「맞다. 선배도 해 보면 어떰까, 요가」"},
{"id": "clah06:1600", "ko": "「패스」"},
{"id": "clah06:1700", "ko": "「즉답이냐!」"},
{"id": "clah06:1800", "ko": "「애초에 나는 두뇌파라서 몸 쓰는 건 잘 못해」"},
{"id": "clah06:1900", "ko": "「게다가 요가 같은 거 해 봤자 기껏해야 몸이 유연해지는 정도겠지」"},
{"id": "clah06:2000", "ko": "「안 그렇슴다. 다른 장점도 잔뜩 있거든요」"},
{"id": "clah06:2100", "ko": "「장점이라. 예를 들면」"},
{"id": "clah06:2200", "ko": "「그건…… 그러니까…… 음……」"},
{"id": "clah06:2300", "ko": "모르는 거 아냐?"},
{"id": "clah06:2400", "ko": "「그래그래! 불을 뿜는다든가 팔다리가 늘어난다든가!」"},
{"id": "clah06:2500", "ko": "어느 격투 게임 얘기야, 그거……"},
{"id": "clah06:2600", "ko": "「뭐, 그래도 확실히 미야시로 선배는 딱 봐도 건강하지 않아 보이니까요. 쉬는 날에 어디 가거나 안 함까?」"},
{"id": "clah06:2700", "ko": "「가지. 취재 같은 거」"},
{"id": "clah06:2800", "ko": "내가 그렇게 대답하자, 아리무라는 대놓고 얼굴을 찌푸렸다."},
{"id": "clah06:2900", "ko": "「⟦col:280aa02d1400⟧엽기 표정⟦col:800000⟧?」"},
{"id": "clah06:3000", "ko": "「어이가 없는 검다!」"},
{"id": "clah06:3100", "ko": "「하아아, 한심하구먼. 멀쩡한 젊은 놈이 그런 소리나 하고. 거참, 일본의 앞날이 걱정이라니까」"},
{"id": "clah06:3200", "ko": "전부터 생각했지만, 아리무라는 가끔 말투가 걸걸해진단 말이지."},
{"id": "clah06:3300", "ko": "「좋아, 정했다! 모처럼 쉬는 날이니까, 오늘은 놀러 가요!」"},
{"id": "clah06:3400", "ko": "「싫어」"},
{"id": "clah06:3500", "ko": "「기각이다!」"},
{"id": "clah06:3600", "ko": "「뭐?」"},
{"id": "clah06:3700", "ko": "「자자, 그렇게 정해졌으면 준비, 준비! 가요, 어서!!」"},
{"id": "clah06:3800", "ko": "「어? 아, 아니, 잠깐 기다――」"},
{"id": "clah06:3900", "ko": "「…………」"},
{"id": "clah06:4000", "ko": "결국 아리무라가 나를 억지로 끌고 나왔다."},
{"id": "clah06:4100", "ko": "그보다, 요가는 이제 됐나?"},
{"id": "clah06:4200", "ko": "게다가 뭐랄까…… 아리무라 녀석, 오늘은 또 어제와는 어딘가 좀 다르달까……"},
{"id": "clah06:4300", "ko": "「왜 그러심까? 인상은 쓰고」"},
{"id": "clah06:4400", "ko": "「아니, 오늘은 어제처럼 막 들이대지는 않는구나 싶어서」"},
{"id": "clah06:4500", "ko": "「아아, 오늘은 그거 쉬는 날임다. 휴일이니까요. 어라? 말 안 했던가요?」"},
{"id": "clah06:4600", "ko": "못 들었어."},
{"id": "clah06:4700", "ko": "그보다 뭐야, 그 자기만의 규칙은."},
{"id": "clah06:4800", "ko": "「그런 고로, 선배도 가끔은 날개를 쭉 펴고 기분 전환하세요」"},
{"id": "clah06:4900", "ko": "뒤에서 내 양 날개를 꽉 붙들고 있는 장본인이 하는 말이니, 어쩔 도리가 없다."},
{"id": "clah06:5000", "ko": "「그래서, 어디로 갈래요?」"},
{"id": "clah06:5100", "ko": "두세 걸음 앞서 걷던 아리무라가 빙글 돌아보며 말했다."},
{"id": "clah06:5200", "ko": "물어봐도, 원래 외출할 예정 같은 건 없었으니 곤란한데."},
{"id": "clah06:5300", "ko": "「어쩔 수 없지. 영화라도 볼까」"},
{"id": "clah06:5400", "ko": "분명 이 근처에 작은 영화관이 있었을 거다."},
{"id": "clah06:5500", "ko": "게다가 영화관이라면 아무리 아리무라라도 얌전히 있겠지."},
{"id": "clah06:5600", "ko": "「영화아?」"},
{"id": "clah06:5700", "ko": "대놓고 싫은 얼굴……"},
{"id": "clah06:5800", "ko": "「저는 지어낸 이야기가 좀 별로임다아」"},
{"id": "clah06:5900", "ko": "「너, 문예부원이잖아……」"},
{"id": "clah06:6000", "ko": "「소설에는 진실이 있지만, 영화는 역시 거짓말이 많잖아요」"},
{"id": "clah06:6100", "ko": "그건 그냥 편견이다."},
{"id": "clah06:6200", "ko": "「차라리 대놓고 거짓말인 이야기라면 괜찮은데 말이죠〜. 이렇게, 콰과과광〜, 쾅〜! 같은 거」"},
{"id": "clah06:6300", "ko": "손짓 발짓까지 섞어 가며 그저 의성어만 늘어놓는 모습이 꼭 어린애 같다."},
{"id": "clah06:6400", "ko": "참고로 나는 어느 쪽이냐 하면 그런 기세만 있는 영화는 별로 좋아하지 않는다."},
{"id": "clah06:6500", "ko": "점점 더 아리무라와는 취향이 안 맞는 것 같다."},
{"id": "clah06:6600", "ko": "「안타깝게도, 그런 영화는 안 하는 것 같아」"},
{"id": "clah06:6700", "ko": "「어라라」"},
{"id": "clah06:6800", "ko": "뭐, 이 안에 있는 영화관은 특히 소규모 개봉 영화만 트니까."},
{"id": "clah06:6900", "ko": "그러니까 손님도 적어서 나한테는 딱 좋지만."},
{"id": "clah06:7000", "ko": "「뭐가 좋아?」"},
{"id": "clah06:7100", "ko": "「아무거나 상관없슴다. 저 그렇게 진지하게 안 보거든요」"},
{"id": "clah06:7200", "ko": "「집에 간다」"},
{"id": "clah06:7300", "ko": "「아, 거짓말 거짓말〜. 그럼 선배한테 맡길게요」"},
{"id": "clah06:7400", "ko": "「그래 놓고 재미없으면 불평할 생각이지」"},
{"id": "clah06:7500", "ko": "「에이, 참〜. 아무리 그래도 그렇게까지는 안 해요〜」"},
{"id": "clah06:7600", "ko": "정말일까?"},
{"id": "clah06:7700", "ko": "「흠……」"},
{"id": "clah06:7800", "ko": "한 편은 딱 봐도 예술 영화 같은 느낌이다."},
{"id": "clah06:7900", "ko": "다른 한 편은 요즘 일부에서 화제가 되고 있는 휴먼 드라마였다."},
{"id": "clah06:8000", "ko": "분명 쿠루스가 보고 싶다고 했던 것 같다."},
{"id": "clah06:8100", "ko": "「이쪽으로 하자」"},
{"id": "clah06:8200", "ko": "나는 쿠루스가 보러 가고 싶다던 쪽 작품을 골랐다."},
{"id": "clah06:8300", "ko": "휴먼 드라마도 그렇게 좋아하진 않지만, 예술 영화는 고상한 척해서 더 질색이다."},
{"id": "clah06:8400", "ko": "게다가 이 감독 작품은 전에 본 바로는 그렇게 나쁘지 않았던 것 같다."},
{"id": "clah06:8500", "ko": "무엇보다 이쪽이 화제성이 있으니까, 누가 내용을 물어봤을 때 설명할 수 있을 테고."},
{"id": "clah06:8600", "ko": "「우와아, 이검까아……」"},
{"id": "clah06:8700", "ko": "「집에 갈래」"},
{"id": "clah06:8800", "ko": "「와아 휴먼 드라마. 히나에, 휴먼 드라마 너무 좋아〜」"},
{"id": "clah06:8900", "ko": "「…………」"},
{"id": "clah06:9000", "ko": "영화 내용은 내가 상상했던 것보다 훨씬 사회파여서, 호감이 가는 작품이었다."},
{"id": "clah06:9100", "ko": "생각해 보면 이 영화, 애초에 캐치프레이즈가 나쁘다."},
{"id": "clah06:9200", "ko": "이렇게 인정극 쪽으로 기운 캐치프레이즈로는 본래 주제와 동떨어져서 오해를 살 수도 있다."},
{"id": "clah06:9300", "ko": "모처럼 내용은 나쁘지 않은데, 이래서는 휴먼 드라마가 보고 싶어서 온 사람에게는 오히려 기대에 못 미친다고 느껴질지도 모른다."},
{"id": "clah06:9400", "ko": "게다가 포스터 디자인도 별로다."},
{"id": "clah06:9500", "ko": "이것저것 다 너저분하게 설명하면 되는 게 아닐 텐데."},
{"id": "clah06:9600", "ko": "어째서 일본 배급사는 이렇게나 센스가 없는 걸까."},
{"id": "clah06:9700", "ko": "라는 이야기를 영화가 끝나면 이것저것 들려줄 생각이었는데……"},
{"id": "clah06:9800", "ko": "「흐어어어엉……!」"},
{"id": "clah06:9900", "ko": "「…………」"}
]
