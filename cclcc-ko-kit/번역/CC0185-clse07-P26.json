[
{"id": "clse07:244200", "ko": "「아이참, 언제까지 우울하게 굴 거야」"},
{"id": "clse07:244300", "ko": "「응!?」"},
{"id": "clse07:244400", "ko": "「어, 어째서……!?」"},
{"id": "clse07:244500", "ko": "「어째서, 네가, 거기 있는 거야!?」"},
{"id": "clse07:244600", "ko": "「하아, 엠스 할 때만 돌아가는 그 머리, 좀 어떻게 하는 게 좋지 않겠어?」"},
{"id": "clse07:244700", "ko": "「여기는 네가 마음속에 만들어 낸 공간이야」"},
{"id": "clse07:244800", "ko": "「시어터 큐브 입구처럼 보이지만, 그냥 심상 풍경이야」"},
{"id": "clse07:244900", "ko": "「뭐, 현실의 너도 같은 곳에 있지만」"},
{"id": "clse07:245000", "ko": "「문 닫아서 아무도 없는 입구 구석에서 훌쩍훌쩍 울고 있어」"},
{"id": "clse07:245100", "ko": "「정말 쓸쓸한 여자라니까, 너」"},
{"id": "clse07:245200", "ko": "「으으으……」"},
{"id": "clse07:245300", "ko": "「내 다른 인격한테 인격을 부정당하고 있어……」"},
{"id": "clse07:245400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:245500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:245600", "ko": "「그, 그치만……」"},
{"id": "clse07:245700", "ko": "「그치만, 뭐?」"},
{"id": "clse07:245800", "ko": "「으으응……」"},
{"id": "clse07:245900", "ko": "「여기는 네 마음속이잖아? 나 말고는 아무도 안 듣고 있으니까 말해 봐」"},
{"id": "clse07:246000", "ko": "「……응」"},
{"id": "clse07:246100", "ko": "「반칙…… 일지도」"},
{"id": "clse07:246200", "ko": "「반칙? 무슨 뜻이야?」"},
{"id": "clse07:246300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:246400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:246500", "ko": "「나는, 뭔가를 할 용기도 없으면서, 그냥 보고만 있어」"},
{"id": "clse07:246600", "ko": "「그냥, 너한테 기대고 있을 뿐…… 일지도」"},
{"id": "clse07:246700", "ko": "「……내 쪽이, 나아…… 일지도」"},
{"id": "clse07:246800", "ko": "「낫다니, 뭐가?」"},
{"id": "clse07:246900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:247000", "ko": "「오늘이 끝나고, 이 몸에서 사라지는 인격은……」"},
{"id": "clse07:247100", "ko": "「……내 쪽이, 나아…… 일지도」"},
{"id": "clse07:247200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:247300", "ko": "「……」"},
{"id": "clse07:247400", "ko": "「……하아」"},
{"id": "clse07:247500", "ko": "「너, 그런 걸로 고민하고 있었구나」"},
{"id": "clse07:247600", "ko": "「오늘이 끝나면 나라는 인격이 사라진다」"},
{"id": "clse07:247700", "ko": "「그걸 쓸쓸하게 생각해 주는 거구나」"},
{"id": "clse07:247800", "ko": "「……응」"},
{"id": "clse07:247900", "ko": "「고마워」"},
{"id": "clse07:248000", "ko": "「하지만 말이야, 그런 걱정은 필요 없어」"},
{"id": "clse07:248100", "ko": "「내 걱정은 하지 말라는 뜻이 아니야. 처음부터 그런 걱정은 필요 없었던 거야」"},
{"id": "clse07:248200", "ko": "「응?」"},
{"id": "clse07:248300", "ko": "「잘, 모르겠어…… 일지도」"},
{"id": "clse07:248400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:248500", "ko": "「윽……」"},
{"id": "clse07:248600", "ko": "「나랑 똑같이 생긴 얼굴이 내가 한 망상을 입에 올리는 건, 믿을 수 없을 만큼 부끄러워……」"},
{"id": "clse07:248700", "ko": "「그래도, 응……」"},
{"id": "clse07:248800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:248900", "ko": "「그러니까, 네가 나를 만들어 낸 게 아니야」"},
{"id": "clse07:249000", "ko": "「나는 처음부터 『또 하나의 카즈키 하나』가 아니야」"},
{"id": "clse07:249100", "ko": "「나는 『네가 될 수도 있는 미래의 가능성』이야」"},
{"id": "clse07:249200", "ko": "「……어?」"},
{"id": "clse07:249300", "ko": "「그러니까 내가 사라져 버린다는 걱정은 안 해도 돼」"},
{"id": "clse07:249400", "ko": "「나는 네 미래의 가능성 중 하나일 뿐이야」"},
{"id": "clse07:249500", "ko": "「처음부터 네 안에는 너라는 인격밖에 없어」"},
{"id": "clse07:249600", "ko": "「그런, 거야?」"},
{"id": "clse07:249700", "ko": "「당연하지. 완전히 분리된 인격? 그런 게 갑자기 생겨날 리가 없잖아?」"},
{"id": "clse07:249800", "ko": "「아니면 뭐야? 『자신의 존재란 대체 무엇인가』라든가 『무엇으로 자아를 정의하는가』 같은 토론이라도 하고 싶은 거야?」"},
{"id": "clse07:249900", "ko": "「그만해 그만해! 너무 부끄러우니까」"},
{"id": "clse07:250000", "ko": "「으으읏」"},
{"id": "clse07:250100", "ko": "「게다가 말이야, 더 말하자면 지금 한 설명조차 원래는 필요 없는 거야」"},
{"id": "clse07:250200", "ko": "「이걸 들으면 넌 더 놀랄걸」"},
{"id": "clse07:250300", "ko": "「아직, 더 있어?」"},
{"id": "clse07:250400", "ko": "「지금도, 너무 부끄러워서, 머리가 끓어오를 것 같은데……」"},
{"id": "clse07:250500", "ko": "「유감. 본론은 지금부터야. 넌 들을 의무가 있어」"},
{"id": "clse07:250600", "ko": "「말해 두는데, 너 이번에 기가로매니악스 능력 안 썼거든」"},
{"id": "clse07:250700", "ko": "「……」"},
{"id": "clse07:250800", "ko": "「……응?」"},
{"id": "clse07:250900", "ko": "「어, 그치만, 네가――!」"},
{"id": "clse07:251000", "ko": "「아까 납득했지? 나는 존재하지 않는다고」"},
{"id": "clse07:251100", "ko": "「네 능력은 말로 한 게 현실에 나타나 버리는 거잖아?」"},
{"id": "clse07:251200", "ko": "「응……」"},
{"id": "clse07:251300", "ko": "「그런데 나는 실재하지 않아」"},
{"id": "clse07:251400", "ko": "「즉, 나는 네 능력으로 나타난 게 아니라는 거지」"},
{"id": "clse07:251500", "ko": "「간단하지?」"},
{"id": "clse07:251600", "ko": "「드, 듣고 보니 그 말대로지만……」"},
{"id": "clse07:251700", "ko": "「그, 그럼 너는 대체……?」"},
{"id": "clse07:251800", "ko": "「으음, 알려 주는 건 쉽지만, 스스로 생각해 줬으면 하는 부분이네」"},
{"id": "clse07:251900", "ko": "「이제 신문부에는 못 돌아가잖아? 그럼 시간은 조금 더 있어」"},
{"id": "clse07:252000", "ko": "（애초의 계기는 타쿠루 선배의 메모가 적힌 쿨 캣 프레스를 읽은 거였어）"},
{"id": "clse07:252100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:252200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:252300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:252400", "ko": "（나는 그게 내가 능력을 발현시킨 결과라고 생각했는데, 그게 아니라면――）"},
{"id": "clse07:252500", "ko": "「……」"},
{"id": "clse07:252600", "ko": "「……응?」"},
{"id": "clse07:252700", "ko": "「으응?」"},
{"id": "clse07:252800", "ko": "「으으으응?」"},
{"id": "clse07:252900", "ko": "「으으으으으응!!!!!??????」"},
{"id": "clse07:253000", "ko": "「어때? 답은 찾았어?」"},
{"id": "clse07:253100", "ko": "「……」"},
{"id": "clse07:253200", "ko": "「……호,」"},
{"id": "clse07:253300", "ko": "「……호, 호호혹, 혹시이……」"},
{"id": "clse07:253400", "ko": "「응? 혹시?」"},
{"id": "clse07:253500", "ko": "「너, 너는……」"},
{"id": "clse07:253600", "ko": "「나는?」"},
{"id": "clse07:253700", "ko": "「나, 나의……」"},
{"id": "clse07:253800", "ko": "「너의?」"},
{"id": "clse07:253900", "ko": "「……차」", "note": "다음 묶음의 「思いこみ(착각)」 첫소리 — お를 「차」로 옮김"},
{"id": "clse07:254000", "ko": "「차?」"},
{"id": "clse07:254100", "ko": "「……차아」"}
]
