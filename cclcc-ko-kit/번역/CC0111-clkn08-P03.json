[
{"id": "clkn08:20000", "ko": "⟦col:280aa02d1400⟧아기 플레이⟦col:800000⟧라는 말을 떠올린 것만으로 두근거리기 시작했어."},
{"id": "clkn08:20100", "ko": "좋아하는…… 건가, 나는?"},
{"id": "clkn08:20200", "ko": "「좋아하…… 지?」"},
{"id": "clkn08:20300", "ko": "「좋아하는…… 걸지도 몰라」"},
{"id": "clkn08:20400", "ko": "아니."},
{"id": "clkn08:20500", "ko": "「좋아해……」"},
{"id": "clkn08:20600", "ko": "그래."},
{"id": "clkn08:20700", "ko": "「나는 아기 플레이를 좋아해! 좋아한다고!」"},
{"id": "clkn08:20800", "ko": "「후훗…… 어쩔 수 없는 아이구나…… 그럼……」"},
{"id": "clkn08:20900", "ko": "센리가 그 자리에서 빙그르르 한 바퀴 돌았다."},
{"id": "clkn08:21000", "ko": "「나머지는 나한테 맡기면 괜찮으니까, 알았지?」"},
{"id": "clkn08:21100", "ko": "어째선지 센리에서 모습을 바꾼 노노가 수상쩍은 눈빛으로 천천히 내게 손을 뻗었다."},
{"id": "clkn08:21200", "ko": "「자~ 그럼 지금부터 기저귀 갈아 줄 테니까 거기 누워……」"},
{"id": "clkn08:21300", "ko": "「네……」"},
{"id": "clkn08:21400", "ko": "시키는 대로 그 자리에 똑바로 누웠다."},
{"id": "clkn08:21500", "ko": "「갈아 주세요」"},
{"id": "clkn08:21600", "ko": "「『주세요』가 아니라 『주떼요』지?」", "note": "말장난: 원문은 します → しまちゅ(아기 말투). 앞 묶음과 같게 「주세요 → 주떼요」로 옮김"},
{"id": "clkn08:21700", "ko": "「갈아…… 주떼요……」"},
{"id": "clkn08:21800", "ko": "「네에~ 잘했어요오……」"},
{"id": "clkn08:21900", "ko": "노노가 내 바지에 손을 댔다."},
{"id": "clkn08:22000", "ko": "벨트를 푸는 소리에 심장 소리가 더욱 커졌다."},
{"id": "clkn08:22100", "ko": "그리고……"},
{"id": "clkn08:22200", "ko": "이루 말할 수 없는 해방감이 밀려왔다."},
{"id": "clkn08:22300", "ko": "「…………풋」"},
{"id": "clkn08:22400", "ko": "「어?」"},
{"id": "clkn08:22500", "ko": "「큽…… 크읍……」"},
{"id": "clkn08:22600", "ko": "「뭐…… 뭘 웃는 건데……」"},
{"id": "clkn08:22700", "ko": "「어? 아, 안 웃었어. 안 웃었다니까?」"},
{"id": "clkn08:22800", "ko": "「거짓말! 방금 웃었잖아!」"},
{"id": "clkn08:22900", "ko": "「안 웃었다니까요」"},
{"id": "clkn08:23000", "ko": "정말……일까?"},
{"id": "clkn08:23100", "ko": "「…………푸풋」"},
{"id": "clkn08:23200", "ko": "「봐, 웃었어! 분명히 웃었어!!」"},
{"id": "clkn08:23300", "ko": "「미, 미안해. 그래도 어쩔 수 없잖아」"},
{"id": "clkn08:23400", "ko": "어쩔 수 없다고?"},
{"id": "clkn08:23500", "ko": "뭐가?"},
{"id": "clkn08:23600", "ko": "「노노 언니, 왜 그래?」"},
{"id": "clkn08:23700", "ko": "「아, 유이. 자, 이것 좀 봐」"},
{"id": "clkn08:23800", "ko": "「……풋!!」"},
{"id": "clkn08:23900", "ko": "「뭐……!!」"},
{"id": "clkn08:24000", "ko": "「자자, 우키도 유토도 와서 봐. 엄청 웃겨!」"},
{"id": "clkn08:24100", "ko": "「……후훗」"},
{"id": "clkn08:24200", "ko": "「기다려, 너희들! 구경거리 아니라고!!」"},
{"id": "clkn08:24300", "ko": "「있잖아, 타쿠루 형」"},
{"id": "clkn08:24400", "ko": "「유토……」"},
{"id": "clkn08:24500", "ko": "「타쿠루 형은…… 귀엽네」"},
{"id": "clkn08:24600", "ko": "「으…………아아아아아아아아아아아아아아아!!」"},
{"id": "clkn08:24700", "ko": "「…………」"},
{"id": "clkn08:24800", "ko": "「있잖아, 타쿠루 형. 귀엽다」"},
{"id": "clkn08:24900", "ko": "「너, 너한테는 안 질 거다!!」"},
{"id": "clkn08:25000", "ko": "「어!? 그게…… 무슨 얘기야?」"},
{"id": "clkn08:25100", "ko": "「무슨 얘기냐니…… 그러니까 거시기 얘기…… 어? 유토야말로 무슨 얘기……?」"},
{"id": "clkn08:25200", "ko": "「아기. 귀엽다고……」"},
{"id": "clkn08:25300", "ko": "「아, 아아. 아기 말이구나! 응, 그렇지! 귀엽네!!」"},
{"id": "clkn08:25400", "ko": "「…………?」"},
{"id": "clkn08:25500", "ko": "그나저나…… 이 무슨 끔찍한 망상이냐."},
{"id": "clkn08:25600", "ko": "현실이 아니라서 다행이다……"},
{"id": "clkn08:25700", "ko": "「네에~ 다 됐쪄요~. 이제 안 찝찝해쪄요~」"},
{"id": "clkn08:25800", "ko": "기저귀를 갈아서 개운해졌는지, 아기는 겨우 울음을 그친 것 같다."},
{"id": "clkn08:25900", "ko": "그나저나……"},
{"id": "clkn08:26000", "ko": "아기 돌보기란 힘든 거구나."},
{"id": "clkn08:26100", "ko": "나는 거의 아무것도 안 했는데도 지쳐 버렸다."},
{"id": "clkn08:26200", "ko": "하지만 당연히 이건 시작에 불과했다."},
{"id": "clkn08:26300", "ko": "「이번엔 왜 그래?」"},
{"id": "clkn08:26400", "ko": "「배고픈 거 아닐까……」"},
{"id": "clkn08:26500", "ko": "그러고 보니 아기는 얼마나 자주 분유를 먹는 거지?"},
{"id": "clkn08:26600", "ko": "「저기, 타쿠루. 부탁이 있는데……」"},
{"id": "clkn08:26700", "ko": "설마……!"},
{"id": "clkn08:26800", "ko": "「분유랑 젖병 사다 줄래?」"},
{"id": "clkn08:26900", "ko": "「그런 건 한꺼번에 말해 줘!!!」"},
{"id": "clkn08:27000", "ko": "어디 보자…… 나머지는 이거랑 이거랑…… 이걸로 전부지?"},
{"id": "clkn08:27100", "ko": "「감사합니다아~」"},
{"id": "clkn08:27200", "ko": "「사, 사 왔…… 어……」"},
{"id": "clkn08:27300", "ko": "「고마워」"},
{"id": "clkn08:27400", "ko": "젖병에 분유에, 당장 쓸 갈아입힐 옷이며 관리 용품 등등 필요할 것 같은 건 센리가 ⟦col:280aa02d1400⟧RINE⟦col:800000⟧으로 보내 준 목록대로 전부 사 왔다."},
{"id": "clkn08:27500", "ko": "일단은 이걸로 괜찮겠지."},
{"id": "clkn08:27600", "ko": "다른 필요한 건 나중에 인터넷으로라도 한꺼번에 사면 된다."},
{"id": "clkn08:27700", "ko": "「저기, 타쿠루. 잠깐 이 아이 좀 안고 있어 줄래?」"},
{"id": "clkn08:27800", "ko": "「엇!? 왜, 왜 내가!」"},
{"id": "clkn08:27900", "ko": "「유이네는 아기 이불 준비하러 갔어」"},
{"id": "clkn08:28000", "ko": "그렇다고 내가 아기를 안다니……"},
{"id": "clkn08:28100", "ko": "「아니 아니 아니 아니, 무리 무리 무리 무리 무리!」"},
{"id": "clkn08:28200", "ko": "「괜찮아. 머리만 잘 받쳐 주면」"},
{"id": "clkn08:28300", "ko": "「아니, 안 된다니까! 아, 잠깐……」"},
{"id": "clkn08:28400", "ko": "「괜찮으니까. 자」"},
{"id": "clkn08:28500", "ko": "싫다고 했는데도 센리는 내게 아기를 내밀었다."},
{"id": "clkn08:28600", "ko": "자기도 아까 처음 안아 봤으면서, 그 모습이 벌써 몸에 배어 있다."},
{"id": "clkn08:28700", "ko": "「우왓!」"},
{"id": "clkn08:28800", "ko": "두 팔에 묵직한 감각."},
{"id": "clkn08:28900", "ko": "「어때?」"},
{"id": "clkn08:29000", "ko": "「뭔가…… 따뜻해……」"},
{"id": "clkn08:29100", "ko": "게다가 묘하게 좋은 냄새가 난다……"},
{"id": "clkn08:29200", "ko": "「그렇게 만져 보니까 귀엽지?」"},
{"id": "clkn08:29300", "ko": "「…………」"},
{"id": "clkn08:29400", "ko": "솔직히 귀여운지 어떤지는 나로선 모르겠다."},
{"id": "clkn08:29500", "ko": "하지만 팔로 전해져 오는 온기와 심장 박동에, 아아, 이 아기는 분명히 살아 있구나, 그렇게 생각했다."},
{"id": "clkn08:29600", "ko": "「그럼 잠깐만 안고 있어 줘」"},
{"id": "clkn08:29700", "ko": "「응……」"},
{"id": "clkn08:29800", "ko": "「……후훗. 그러고 있으니까 꼭 아빠 같아」"},
{"id": "clkn08:29900", "ko": "「어?」"}
]
