[
{"id": "clka09:10000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:10100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:10200", "ko": "『하나』는 그렇게 말하며 내 팔을 잡아당기고, 107을 향해 성큼성큼 걷기 시작했다."},
{"id": "clka09:10300", "ko": "「카, 카즈키! 기, 기다려!」"},
{"id": "clka09:10400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:10500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:10600", "ko": "「아직 마음의 준비가! 기다려! 기다려 주세요 카즈키 씨! 아니 하나 씨! 으아아아아아!」"},
{"id": "clka09:10700", "ko": "……일단 들어가 보니 107은 그렇게까지 공포에 떨 만한 공간은 아니었다. 뭐, 당연하지만."},
{"id": "clka09:10800", "ko": "층마다 엄청나게 좁다는 것과 어디를 봐도 여자용 패션 가게밖에 없다는 걸 빼면 보통 백화점과 똑같다."},
{"id": "clka09:10900", "ko": "『하나』는 뭘 사지도, 손에 들어 보지도 않고, 좁은 빌딩 안에서 나를 끌고 다니며 눈에 띄는 걸 하나하나 나한테 가리켰다."},
{"id": "clka09:11000", "ko": "「아! 저 치마 귀엽지 않아요!?」"},
{"id": "clka09:11100", "ko": "「좀 너무 짧지 않아?」"},
{"id": "clka09:11200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:11300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:11400", "ko": "「그런가〜. 아, 그럼 저쪽 티셔츠는요!?」"},
{"id": "clka09:11500", "ko": "「저건 아동용 아니야? 저렇게 작은 티셔츠는 못 입잖아」"},
{"id": "clka09:11600", "ko": "「크롭티라고 해요. 작아서 몸 라인이 딱 드러나요」"},
{"id": "clka09:11700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:11800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:11900", "ko": "「에〜!? 그럼 저쪽 흰 원피스는요?」"},
{"id": "clka09:12000", "ko": "「아, 응. 저거라면 괜찮지 않을까? 청초하고 지적인 느낌이 들어」"},
{"id": "clka09:12100", "ko": "「그럴 줄 알았어요. 미야시로 선배는 여자애한테 환상이 너무 많아요!」"},
{"id": "clka09:12200", "ko": "「저런 건 선배 같은 단순한 남자를 넘어오게 하려고 있는 거예요」"},
{"id": "clka09:12300", "ko": "「그래!?」"},
{"id": "clka09:12400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:12500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:12600", "ko": "「아! 저기 신발 귀여워〜! 잠깐 보고 가요!」"},
{"id": "clka09:12700", "ko": "「좀 들어!」"},
{"id": "clka09:12800", "ko": "이대로 아이쇼핑으로 끝나나 싶었는데, 어떤 가게 앞에서 갑자기 『하나』가 멈춰 섰다."},
{"id": "clka09:12900", "ko": "「여기…… 는?」"},
{"id": "clka09:13000", "ko": "「사진관이에요. 원하는 차림으로 분장해서 사진을 찍을 수 있어요」"},
{"id": "clka09:13100", "ko": "「……설마」"},
{"id": "clka09:13200", "ko": "「네♪ 여기가 목적지예요」"},
{"id": "clka09:13300", "ko": "「지금부터 여기서 기념사진을 찍을 거예요」"},
{"id": "clka09:13400", "ko": "「거짓말…… 이지?」"},
{"id": "clka09:13500", "ko": "「어제 미리 의상도 예약해 뒀어요」"},
{"id": "clka09:13600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:13700", "ko": "「잡아당기지 마! 야!」"},
{"id": "clka09:13800", "ko": "얼떨결에 가게에 들어가자 『하나』는 술술 수속을 마쳤고, 점원이 우리를 가게 안쪽 탈의실로 데려갔다."},
{"id": "clka09:13900", "ko": "커튼으로 칸막이할 수 있는 작은 공간이 두 개 있었고, 점원은 나와 『하나』를 각각의 공간에 밀어 넣더니 의상을 바닥에 두고 커튼을 닫았다."},
{"id": "clka09:14000", "ko": "「잠깐, 나는 아직 한다고 안 했어!」"},
{"id": "clka09:14100", "ko": "그러자 칸막이 너머에서 『하나』의 목소리가 돌아왔다."},
{"id": "clka09:14200", "ko": "「여기까지 왔으니까 즐겨요〜! 좀처럼 입어 볼 수 있는 옷이 아니라고요」"},
{"id": "clka09:14300", "ko": "「좀처럼 입어 볼 수 없는 옷……?」"},
{"id": "clka09:14400", "ko": "나는 발밑에 놓인 의상 뭉치를 들어 올려 두 손으로 펼쳤다."},
{"id": "clka09:14500", "ko": "「……뭐!? 말도 안 돼!?」"},
{"id": "clka09:14600", "ko": "「자〜, 이쪽 보고 웃어 주세요〜」"},
{"id": "clka09:14700", "ko": "「거기 아가씨, 웃는 얼굴 좋네! 의상도 엄청 잘 어울려!」"},
{"id": "clka09:14800", "ko": "「후훗. 고맙습니다♪」"},
{"id": "clka09:14900", "ko": "「으음, 남자 쪽은 표정이 굳었네〜. 좀 더 편하게 가자고!」"},
{"id": "clka09:15000", "ko": "「자 선배, 좀 더 웃어 봐요」"},
{"id": "clka09:15100", "ko": "「……」"},
{"id": "clka09:15200", "ko": "「……무, 리」"},
{"id": "clka09:15300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:15400", "ko": "「아, 분위기를 좀 더 내는 편이 기분이 나려나? 그쪽으로 가 볼까」"},
{"id": "clka09:15500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:15600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:15700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:15800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:15900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:16000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:16100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:16200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:16300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:16400", "ko": "「으음, 반대로 남자 쪽은 솔직히 별로 안 어울리네. 아하하!」"},
{"id": "clka09:16500", "ko": "（미안하게 됐네!）"},
{"id": "clka09:16600", "ko": "나도 흰 모닝코트를 입고 있었지만, 스스로도 알 만큼 어울리지 않았다."},
{"id": "clka09:16700", "ko": "구부정한 등 탓인지 어느 사이즈를 입어도 팔이나 허리 어딘가가 모자라거나 남아서 엉성해져 버린다."},
{"id": "clka09:16800", "ko": "거울에 비친 모습을 본 메이크업 담당이 『꼬마가 기념사진 찍으려고 차려입은 것 같네요』라고 했을 때, 나도 같은 생각을 하고 있었을 정도다.", "note": "七五三(아이 성장 축하 행사의 나들이옷) → 뜻을 풀어서"},
{"id": "clka09:16900", "ko": "「자 선배! 좀 더 웃어요!」"},
{"id": "clka09:17000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:17100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:17200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:17300", "ko": "「맡기라니 무슨!」"},
{"id": "clka09:17400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:17500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:17600", "ko": "나는 어떻게 해야 할지 몰라서 인형처럼 『하나』가 하는 대로 움직일 수밖에 없었다."},
{"id": "clka09:17700", "ko": "「좋아〜, 그럼 다음엔 그거 가 볼까!」"},
{"id": "clka09:17800", "ko": "「그, 그거라니?」"},
{"id": "clka09:17900", "ko": "「그거요, 그・거」"},
{"id": "clka09:18000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:18100", "ko": "「뭐!?」"},
{"id": "clka09:18200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:18300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:18400", "ko": "「뭐! 어!? 뭐어!!??」"},
{"id": "clka09:18500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:18600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:18700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:18800", "ko": "「그, 그렇게 말해도!?」"}
]
