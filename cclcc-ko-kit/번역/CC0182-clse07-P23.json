[
{"id": "clse07:214200", "ko": "「그렇게 나오시겠다? 과연, 일리가 있네요」"},
{"id": "clse07:214300", "ko": "「으음, 그렇다면……」"},
{"id": "clse07:214400", "ko": "「……아, 맞다!」"},
{"id": "clse07:214500", "ko": "「아까 그 사진, 다시 한번 봐 줄래요?」"},
{"id": "clse07:214600", "ko": "「그 사진에서 ⟦rb⟧제⟦rt⟧⟦rbc⟧●⟦/r⟧ ⟦rb⟧옆⟦rt⟧⟦rbc⟧●⟦/r⟧에 있는 물건, 잘 보세요」"},
{"id": "clse07:214700", "ko": "「자, 빨리요!」"},
{"id": "clse07:214800", "ko": "「본 적 있는 호 아니에요?」"},
{"id": "clse07:214900", "ko": "「음후♪」"},
{"id": "clse07:215000", "ko": "「그래야죠!」"},
{"id": "clse07:215100", "ko": "「이 잡지라니? 무슨 소리야?」"},
{"id": "clse07:215200", "ko": "「이게 왜?」"},
{"id": "clse07:215300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:215400", "ko": "「네. 서랍 밑 틈에서 찾았어요」"},
{"id": "clse07:215500", "ko": "「하나는 그냥 뒤풀이에 관심이 없어서, 동아리 활동이 끝났을 때 집에 갔어요」"},
{"id": "clse07:215600", "ko": "「그런데 집에 가서야 캠핑카에 스마트폰을 두고 온 걸 알고, 저녁을 먹고 나서 가지러 돌아갔어요」"},
{"id": "clse07:215700", "ko": "「도착했을 때는 이토 선배도 미야시로 선배도 잠들어 있었지만, 문이 열려 있어서 멋대로 들어갔어요」"},
{"id": "clse07:215800", "ko": "「스마트폰은 금방 찾았는데 배터리가 다 돼서요. 잠깐 콘센트를 빌려서 충전하고 있었어요」"},
{"id": "clse07:215900", "ko": "「그래서 하나는 모처럼 남자애 방에 왔으니까 뭔가 재밌는 거 없나 싶어서」"},
{"id": "clse07:216000", "ko": "「대충 서랍을 열어 보다가 우연히 찾은 게 그 잡지였던 거죠」"},
{"id": "clse07:216100", "ko": "「물론 가지고 돌아갔어요」"},
{"id": "clse07:216200", "ko": "「일단 본인의 명예를 위해 말해 두자면, 가지고 간 건 하나가 아니라 저, 『하나』 쪽이에요」"},
{"id": "clse07:216300", "ko": "「미야시로 선배로서는 운이 없었을 뿐이에요. 마침 딱 좋은 타이밍에 제가 구현화돼 버렸을 뿐」"},
{"id": "clse07:216400", "ko": "「이렇게 재밌는 게 있으면 써먹지 않으면 아깝다 싶어서 가져가 버렸어요」"},
{"id": "clse07:216500", "ko": "「뭘까요?」"},
{"id": "clse07:216600", "ko": "「미야시로 선배는 머리가 좋으니까, 안 물어봐도 알 것 같은데요」"},
{"id": "clse07:216700", "ko": "「뭐, 됐어요」"},
{"id": "clse07:216800", "ko": "「협상 카드예요♪」"},
{"id": "clse07:216900", "ko": "「오래 기다렸지〜!」"},
{"id": "clse07:217000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:217100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:217200", "ko": "「미야시로 선배, 꽤 멋진 말을 하지?」"},
{"id": "clse07:217300", "ko": "「그래서요, 다른 조건을 생각했어요」"},
{"id": "clse07:217400", "ko": "「미야시로 선배」"},
{"id": "clse07:217500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:217600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:217700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:217800", "ko": "「뭐, 시부야 거리를 어슬렁거리기만 할 거예요」"},
{"id": "clse07:217900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:218000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:218100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:218200", "ko": "「어라〜? 거절하는 거예요? 미야시로 선배? 뭐, 상관없지만요〜……」"},
{"id": "clse07:218300", "ko": "「그럼 ⟦rb⟧그거⟦rt⟧⟦rbc⟧●●⟦/r⟧는 어떻게 할까나〜」"},
{"id": "clse07:218400", "ko": "「음후후」"},
{"id": "clse07:218500", "ko": "「자자자, 여러분의 기대에 멋지게 부응해 드리자고요」"},
{"id": "clse07:218600", "ko": "「아, 그래도 여러분은 따라오면 안 돼요? 이것도 조건 중 하나예요」"},
{"id": "clse07:218700", "ko": "「자, 미야시로 선배. 갈까요?」"},
{"id": "clse07:218800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:218900", "ko": "「집에 가서 옷 갈아입고 4시에 하치코 앞에서 만나요」"},
{"id": "clse07:219000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:219100", "ko": "「그럼 이따 봐요. 꼭 갈아입고 오세요!」"},
{"id": "clse07:219200", "ko": "「음후」"},
{"id": "clse07:219300", "ko": "「누구〜게?」"},
{"id": "clse07:219400", "ko": "「자, 잠깐 괜찮아!? 너무 놀라잖아〜!」"},
{"id": "clse07:219500", "ko": "「미안해요〜, 그렇게 놀랄 줄은 몰랐어요!」"},
{"id": "clse07:219600", "ko": "「어, 잠깐만!」"},
{"id": "clse07:219700", "ko": "「에에, 그래도 역시 약속 장소는 거기여야 한다고」"},
{"id": "clse07:219800", "ko": "「그치만 말이야」"},
{"id": "clse07:219900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:220000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:220100", "ko": "「음후」"},
{"id": "clse07:220200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:220300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:220400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:220500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:220600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:220700", "ko": "「어머 아쉬워라. 아리무라 선배의 예상은 빗나갔네요」"},
{"id": "clse07:220800", "ko": "「그게 당당하게 할 말이에요? 뭐, 알고 있었지만요」"},
{"id": "clse07:220900", "ko": "「괜찮아요. 갈 곳은 정해 놨어요. 이쪽 이쪽!」"},
{"id": "clse07:221000", "ko": "「도착〜! 자, 미야시로 선배, 들어가요!」"},
{"id": "clse07:221100", "ko": "「선배? 왜 그래요?」"},
{"id": "clse07:221200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:221300", "ko": "「맞아요! 107! 시부야의 패션 성지!」"},
{"id": "clse07:221400", "ko": "「갑자기 왜 그래요!?」"},
{"id": "clse07:221500", "ko": "「……자기 입으로 말하면서 한심하지 않아요?」"},
{"id": "clse07:221600", "ko": "「괜찮다니까요. 아까도 말했잖아요」"},
{"id": "clse07:221700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:221800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:221900", "ko": "「그〜러〜니〜까〜, 하나라고 불러 달라고 했잖아요〜」"},
{"id": "clse07:222000", "ko": "「자, 가요, 타・쿠・루・씨♪」"},
{"id": "clse07:222100", "ko": "「아! 저 치마 귀엽지 않아요!?」"},
{"id": "clse07:222200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:222300", "ko": "「그런가〜. 아, 그럼 저쪽 티셔츠는!?」"},
{"id": "clse07:222400", "ko": "「쫄티라고 하는 거예요. 작아서 몸 라인이 딱 드러나요」"},
{"id": "clse07:222500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:222600", "ko": "「에〜!? 그럼 저쪽 하얀 원피스는?」"},
{"id": "clse07:222700", "ko": "「그럴 줄 알았어. 미야시로 선배는 여자애한테 환상이 너무 많아요!」"},
{"id": "clse07:222800", "ko": "「저런 건 선배 같은 단순한 남자를 꼬시려고 있는 거예요」"},
{"id": "clse07:222900", "ko": "「게다가 가슴 큰 애한테 어울리는 원피스는 별로 없거든요〜. 가슴에 옷이 걸려서 뚱뚱해 보여요」"},
{"id": "clse07:223000", "ko": "「아! 저기 신발 귀여워〜! 잠깐 보고 가요!」"},
{"id": "clse07:223100", "ko": "「사진관이에요. 원하는 차림으로 꾸미고 사진을 찍을 수 있어요」"},
{"id": "clse07:223200", "ko": "「네♪ 여기가 목적지예요」"},
{"id": "clse07:223300", "ko": "「지금부터 여기서 기념사진을 찍을 거예요」"},
{"id": "clse07:223400", "ko": "「어제 미리 의상도 예약해 뒀어요」"},
{"id": "clse07:223500", "ko": "「자, 들어가요. 타쿠루 씨♪」"},
{"id": "clse07:223600", "ko": "「여기까지 왔으니까 즐겨요〜! 좀처럼 입어 볼 수 있는 게 아니라고요」"},
{"id": "clse07:223700", "ko": "「음후. 감사합니다♪」"},
{"id": "clse07:223800", "ko": "「자, 선배, 좀 더 웃어 봐요」"},
{"id": "clse07:223900", "ko": "「음후! 그래요〜?」"},
{"id": "clse07:224000", "ko": "「그렇대요, 미야시로 선배!」"},
{"id": "clse07:224100", "ko": "「자, 선배! 좀 더 웃어요!」"}
]
