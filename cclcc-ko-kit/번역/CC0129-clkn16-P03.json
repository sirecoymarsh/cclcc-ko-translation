[
{"id": "clkn16:20000", "ko": "「무슨 소리야?」"},
{"id": "clkn16:20100", "ko": "「뭔 소린지 모르겠고……」"},
{"id": "clkn16:20200", "ko": "「뭐야 뭐야……?」"},
{"id": "clkn16:20300", "ko": "「회장님, 무슨 소리 하는 거야?」"},
{"id": "clkn16:20400", "ko": "「뭔데……?」"},
{"id": "clkn16:20500", "ko": "노노의 말에 다들 의아한 목소리를 내기 시작했다."},
{"id": "clkn16:20600", "ko": "무리도 아니다."},
{"id": "clkn16:20700", "ko": "지금 우리 눈앞에 있는 건 어디로 보나 쿠루스 노노니까."},
{"id": "clkn16:20800", "ko": "「무, 무슨 말인지 모르겠군. 확실히 그 사람은 나도 잘 알지만, 어디로 보나 너는 쿠루스 노노잖아」"},
{"id": "clkn16:20900", "ko": "「아니면 뭐야? ⟦col:280aa02d1400⟧특수 분장⟦col:800000⟧ 같은 걸로 네가 변장하고 있었다고 말할 셈인가?」"},
{"id": "clkn16:21000", "ko": "「그거야말로 말도 안 되는 얘기다! 애초에 너한테는 그런 짓을 할 이유가 없어!」"},
{"id": "clkn16:21100", "ko": "「응, 그렇지……」"},
{"id": "clkn16:21200", "ko": "「그렇다면 그 얘기는――」"},
{"id": "clkn16:21300", "ko": "그 순간, 갑자기 우리 눈앞에 기계 장치로 된 날개 같은 물체가 나타났다."},
{"id": "clkn16:21400", "ko": "물론 여기 모인 사람들은 모두 그게 무엇인지 알고 있었다."},
{"id": "clkn16:21500", "ko": "――⟦col:280aa02d1400⟧디소드⟦col:800000⟧――"},
{"id": "clkn16:21600", "ko": "⟦col:280aa02d1400⟧기가로매니악스⟦col:800000⟧만이 ⟦col:280aa02e1400⟧⟦rb⟧구현화⟦rt⟧리얼 부트⟦/r⟧⟦col:800000⟧할 수 있는 망상의 검."},
{"id": "clkn16:21700", "ko": "「노노…… 선배……」"},
{"id": "clkn16:21800", "ko": "「봐 줘. 이게 나의 ⟦col:280aa02d1400⟧기가로매니악스⟦col:800000⟧로서의 ⟦rb⟧능력⟦rt⟧힘⟦/r⟧――」"},
{"id": "clkn16:21900", "ko": "노노의 몸이 눈부신 빛의 입자에 휩싸였다."},
{"id": "clkn16:22000", "ko": "강하게 빛난 입자는 노노의 모습을 본뜨더니, 그리고――."},
{"id": "clkn16:22100", "ko": "천천히 다른 형상을 만들어 갔다."},
{"id": "clkn16:22200", "ko": "빛이 가라앉았을 때, 거기 서 있던 건――."},
{"id": "clkn16:22300", "ko": "「…………」"},
{"id": "clkn16:22400", "ko": "「…………」"},
{"id": "clkn16:22500", "ko": "「…………」"},
{"id": "clkn16:22600", "ko": "모두 넋이 나간 듯 눈을 크게 뜬 채 그 모습을 바라보고 있었다."},
{"id": "clkn16:22700", "ko": "「……알았지? 조금 전까지의 모습은 내 ⟦rb⟧능력⟦rt⟧힘⟦/r⟧으로 쿠루스 노노라는 소녀에게서 빌린 임시 모습이야」"},
{"id": "clkn16:22800", "ko": "「그리고 이게 나의…… 미나미사와 센리의 진짜 모습이야……」"},
{"id": "clkn16:22900", "ko": "「아…… 아아……」"},
{"id": "clkn16:23000", "ko": "센리는 주위를 둥글게 에워싼 학생들을 마주 보았다."},
{"id": "clkn16:23100", "ko": "「나에게 쿠루스 노노라는 여자아이는 동경의 대상이었어」"},
{"id": "clkn16:23200", "ko": "「늘 밝고 다정하고 모두에게 사랑받고…… 그런 그 애처럼 되고 싶다고 계속 생각했어……」"},
{"id": "clkn16:23300", "ko": "그건 그녀가 지금까지 줄곧 마음속에 품고 있던 슬픔."},
{"id": "clkn16:23400", "ko": "결코 누구에게도 알리고 싶지 않았던 어둠."},
{"id": "clkn16:23500", "ko": "「진짜 쿠루스 노노는 몇 년 전에 유학을 가서 일본에 없어……」"},
{"id": "clkn16:23600", "ko": "「그러니까 다들 아는 쿠루스 노노는 나…… 어둡고 울보에 볼품없고…… 친구를 동경하면서도 그저 부러워할 수밖에 없었던 미나미사와 센리야……」"},
{"id": "clkn16:23700", "ko": "「노노 선배……」"},
{"id": "clkn16:23800", "ko": "「미안해…… 지금까지 속여서」"},
{"id": "clkn16:23900", "ko": "센리는 깊숙이 고개를 숙였다."},
{"id": "clkn16:24000", "ko": "「사과한다고 용서받을 수 있을 거라고는 생각 안 하지만……」"},
{"id": "clkn16:24100", "ko": "「부부장……」"},
{"id": "clkn16:24200", "ko": "「그래도! 그래도 이것만은 알아줬으면 해!」"},
{"id": "clkn16:24300", "ko": "「나와 타쿠루는 지금까지 계속 남매로 지내 왔어. 거기엔 떳떳하지 못한 일 같은 건 하나도 없어!」"},
{"id": "clkn16:24400", "ko": "「그러니까…… 타쿠루를 처분하는 건 잘못됐어……」"},
{"id": "clkn16:24500", "ko": "「벌이라면 내가 받을 테니까……」"},
{"id": "clkn16:24600", "ko": "「모두를 속인 책임도…… 제대로 질 테니까……」"},
{"id": "clkn16:24700", "ko": "다시 한번 고개를 숙이는 센리에게, 누구 하나 목소리를 내려는 사람은 없었다."},
{"id": "clkn16:24800", "ko": "탓하고 있는 걸까."},
{"id": "clkn16:24900", "ko": "아니면 분노하고 있는 걸까."},
{"id": "clkn16:25000", "ko": "이런 분위기 속에서 목소리를 낼 용기는 내게 없었다."},
{"id": "clkn16:25100", "ko": "지금까지의 내게는……"},
{"id": "clkn16:25200", "ko": "「뭐, 뭐야!!」"},
{"id": "clkn16:25300", "ko": "하지만 지금은 다르다."},
{"id": "clkn16:25400", "ko": "「다들 학생회장한테 엄청 신세 졌잖아!!」"},
{"id": "clkn16:25500", "ko": "나에게는 지키고 싶은 것이 있다."},
{"id": "clkn16:25600", "ko": "「지금까지 그 애는 아무리 사소한 호소라도 귀 기울여 줬잖아!」"},
{"id": "clkn16:25700", "ko": "지키고 싶은 사람이 있다."},
{"id": "clkn16:25800", "ko": "「학원과의 귀찮은 교섭도, 이웃의 민원도, 언제나 앞장서서 싸워 준 건 그 애였잖아?」"},
{"id": "clkn16:25900", "ko": "그걸 위해서라면 무서운 건 아무것도 없다."},
{"id": "clkn16:26000", "ko": "「학원에 ⟦col:280aa02d1400⟧건의함⟦col:800000⟧을 두고 의견을 말하기 쉽게 한 것도, 여러 동아리의 불만을 전부 들어 주고 내 일처럼 고민해 준 것도 그 애다!!」"},
{"id": "clkn16:26100", "ko": "「그건 그 애가 모두를 생각해서 한 일이잖아! 모두가 즐겁게 지낼 수 있도록 해 준 일이잖아!」"},
{"id": "clkn16:26200", "ko": "「타쿠루……」"},
{"id": "clkn16:26300", "ko": "「확실히 그 애는 모습을 속였을지도 몰라!」"},
{"id": "clkn16:26400", "ko": "「하지만 지금까지 학생회장으로서 그 애가 모두를 위해 애써 온 건 사실이다!」"},
{"id": "clkn16:26500", "ko": "「나는 그걸 누구보다 잘 알아! 왜냐하면 나는…… 나는 줄곧 그 애를 봐 왔으니까!!」"},
{"id": "clkn16:26600", "ko": "「잘 챙겨 주고 다정하고, 가끔은 무서울 때도 있지만…… 그래도 겉모습이 다르다고 해서 아무것도 달라지지 않아!」"},
{"id": "clkn16:26700", "ko": "있는 힘껏 목소리를 쥐어짰다."},
{"id": "clkn16:26800", "ko": "「그 애는 그 애다!!!」"},
{"id": "clkn16:26900", "ko": "알아주길 바랐다."},
{"id": "clkn16:27000", "ko": "인정해 주길 바랐다."},
{"id": "clkn16:27100", "ko": "그 애를."},
{"id": "clkn16:27200", "ko": "그 애의 노력을."},
{"id": "clkn16:27300", "ko": "하지만 체육관 안은 조용한 그대로였고, 동의를 표해 주는 사람은 없었다."},
{"id": "clkn16:27400", "ko": "결국 이런 거다."},
{"id": "clkn16:27500", "ko": "아무리 남을 위해 애써도, 아무리 모두를 위해 힘써도, 아무도 정당하게 평가해 주지 않는다."},
{"id": "clkn16:27600", "ko": "알고 있었다."},
{"id": "clkn16:27700", "ko": "그래도 나는, 어쩌면 누군가 한 사람쯤은 그 애를 인정해 주지 않을까, 마음 어딘가에서 그런 기대를 하고 있었다."},
{"id": "clkn16:27800", "ko": "하지만 기대는 어디까지나 기대일 뿐이고."},
{"id": "clkn16:27900", "ko": "그런 기대에 매달린 내가 한심해서."},
{"id": "clkn16:28000", "ko": "분해서――."},
{"id": "clkn16:28100", "ko": "「잘 말했어, 타쿠!!」"},
{"id": "clkn16:28200", "ko": "「……!?」"},
{"id": "clkn16:28300", "ko": "「타쿠 말이 맞아. 노노…… 가 아니라, 센리는 언제나 모두를 생각했어. 그건 틀림없는 사실인걸」"},
{"id": "clkn16:28400", "ko": "「오노에……」"},
{"id": "clkn16:28500", "ko": "「맞아 맞아~! 겉모습이 바뀌어도 우리 학생회장은 학생회장이다~!」"},
{"id": "clkn16:28600", "ko": "「그 말이 맞아! 여제는 여제다~!」"},
{"id": "clkn16:28700", "ko": "「다들……」"},
{"id": "clkn16:28800", "ko": "「연애 금지령 따윈 엿이나 먹어라!!」"},
{"id": "clkn16:28900", "ko": "「먹어라~…… 일지도……」"},
{"id": "clkn16:29000", "ko": "그 목소리에 힘을 얻은 듯 조금씩 목소리가 퍼져 간다."},
{"id": "clkn16:29100", "ko": "「그…… 렇지……」"},
{"id": "clkn16:29200", "ko": "「여제는 여제지……」"},
{"id": "clkn16:29300", "ko": "「나도 학생회장한테 신세 졌고……」"},
{"id": "clkn16:29400", "ko": "「그런 귀찮은 일, 나라면 부탁받아도 싫고……」"},
{"id": "clkn16:29500", "ko": "「그보다 연애 금지라니 말도 안 되지 않아?」"},
{"id": "clkn16:29600", "ko": "맞아 맞아, 하는 목소리가 곳곳에서 터져 나오더니 이윽고……"},
{"id": "clkn16:29700", "ko": "「여제! 여제! 여제!!」⟦n⟧⟦par⟧「여제! 여제! 여제!!」⟦n⟧⟦par⟧「여제! 여제! 여제!!」"},
{"id": "clkn16:29800", "ko": "성대한 여제 콜이 체육관 안에 울려 퍼졌다."},
{"id": "clkn16:29900", "ko": "뭐야……"}
]
