[
{"id": "clse07:969500", "ko": "「정말?! 신난다! 나도 타쿠루 형 보고 싶었어」"},
{"id": "clse07:969600", "ko": "「둘 다 아빠 있는 데서 일 돕고 있지 않을까」"},
{"id": "clse07:969700", "ko": "「그럼 누나는 방에 있을지도」"},
{"id": "clse07:969800", "ko": "「달라진 거라니?」"},
{"id": "clse07:969900", "ko": "「음…… 고민하는지는 모르겠지만…… 요즘 맨날 노트에 열심히 뭔가 쓰고 있는 것 같아」"},
{"id": "clse07:970000", "ko": "「글쎄. 누나는 보려고 하면 화내고」"},
{"id": "clse07:970100", "ko": "「니야생이래」"},
{"id": "clse07:970200", "ko": "「MOMONE라는 아이돌 방송. 지금 누나네 반에서 유행하나 봐」"},
{"id": "clse07:970300", "ko": "「그야 그렇지. MOMONE는 립싱크 아이돌이니까」"},
{"id": "clse07:970400", "ko": "「맞아, 노노 누나. 타쿠루 형은 “정보 강자”잖아? 모를 리가 없어」"},
{"id": "clse07:970500", "ko": "「타쿠루 형…… 벌써 자?」"},
{"id": "clse07:970600", "ko": "「다행이다. 아직 안 잤구나」"},
{"id": "clse07:970700", "ko": "「미안해. 그래도 나…… 꼭 타쿠루 형이랑 얘기하고 싶어서……」"},
{"id": "clse07:970800", "ko": "「응……」"},
{"id": "clse07:970900", "ko": "「있잖아…… 나 말야, 지금까지 말 안 했지만…… 사실은…… 자…… 야」", "note": "「(女の)子……なの」를 웅얼거리는 줄 — 「(여)자…… 야」로 옮김"},
{"id": "clse07:971000", "ko": "「……그러니까…… 그…… 나…… 사실은……」"},
{"id": "clse07:971100", "ko": "「사실 나, 여자애야!」"},
{"id": "clse07:971200", "ko": "「쉿! 목소리 커」"},
{"id": "clse07:971300", "ko": "「뭐…… 그렇게 되는 거지」"},
{"id": "clse07:971400", "ko": "「혹시 내 말 안 믿는 거야?」"},
{"id": "clse07:971500", "ko": "「알았어…… 그럼, 손 줘 봐」"},
{"id": "clse07:971600", "ko": "「아직도 안 믿는구나…… 알았어. 그럼……」"},
{"id": "clse07:971700", "ko": "「…………」"},
{"id": "clse07:971800", "ko": "", "note": "보류 — 성적 묘사(초등학생 인물)"},
{"id": "clse07:971900", "ko": "", "note": "보류 — 성적 묘사(초등학생 인물의 몸을 만지는 장면)"},
{"id": "clse07:972000", "ko": "「그게, 지진 때 여자애 둘이면 위험하니까 그러는 게 낫다고 누나가……」"},
{"id": "clse07:972100", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:972200", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:972300", "ko": "「그러니까…… 그러니까……」"},
{"id": "clse07:972400", "ko": "「유……」"},
{"id": "clse07:972500", "ko": "", "note": "보류 — 연애 묘사(미성년·가족). 옮길 때: 여자애 「ユウ」로 자기를 밝히는 대목이라 お兄ちゃん 은 「오빠」(03 4절)"},
{"id": "clse07:972600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:972700", "ko": "「타쿠루 형…… 벌써 자?」"},
{"id": "clse07:972800", "ko": "「다행이다. 아직 안 잤구나」"},
{"id": "clse07:972900", "ko": "「미안해. 그래도 나…… 꼭 타쿠루 형한테 부탁하고 싶은 게 있어서……」"},
{"id": "clse07:973000", "ko": "「정말?!」"},
{"id": "clse07:973100", "ko": "「그럼 말할게, 실은 말야, 나 있지, 여자애가 되고 싶어」"},
{"id": "clse07:973200", "ko": "「있잖아, 우리 집은 누나에, 노노 누나에, 우키 누나. 다 여자애들뿐이잖아?」"},
{"id": "clse07:973300", "ko": "「아빠는 집에 별로 없고, 있을 때는 혼자 술 마시고, 타쿠루 형은 나가 버렸고」"},
{"id": "clse07:973400", "ko": "「집 안에서는 누나들이 다 즐겁게 얘기하고 있어서, 나만 혼자 왠지 따돌림당하는 것 같다고 계속 생각했어」"},
{"id": "clse07:973500", "ko": "「나가 버린 형이 그런 말 하지 마!!」"},
{"id": "clse07:973600", "ko": "「……내가 얼마나 외로웠는지도 모르는 주제에, 멋대로 말하지 마」"},
{"id": "clse07:973700", "ko": "「그래서 말야, 나는 여자애가 되고 싶다고 생각했어. 물론 진짜 여자애로……」"},
{"id": "clse07:973800", "ko": "「봐. 나 엄청 찾아봤단 말야? 호노리우스잖아? 피카트리스크에 레메게톤…… 그리고 이취경까지」", "note": "마술서 이름: ホノリウス·ピカトリスク(원문 표기 그대로)·レメゲトン·理趣教(이취경)"},
{"id": "clse07:973900", "ko": "「어딘가에 여자애가 되는 방법이 나와 있지 않을까 해서 많이 찾아봤어」"},
{"id": "clse07:974000", "ko": "「그랬더니! 찾았어! 봐, 여기!」"},
{"id": "clse07:974100", "ko": "「서로 안구를 바꿔 넣은 남녀를 교배시키고, 그렇게 얻은 체액을 정제해―― 알겠지?」"},
{"id": "clse07:974200", "ko": "「모르겠어? 그러고도 잘도 정보 강자라고 하네……」"},
{"id": "clse07:974300", "ko": "「뭐, 됐어. 타쿠루 형은 내 말만 들어 주면 그걸로 되니까」"},
{"id": "clse07:974400", "ko": "「그래…… 이거랑 바꿔 넣는 거야……」"},
{"id": "clse07:974500", "ko": "「봐, 이대로면 노노 누나가 안 보인다고 울고 있어. 빨리 타쿠루 형 눈을 넣어 주자?」"},
{"id": "clse07:974600", "ko": "「어라~? 누나들, 이 시간에 뭐 해?」"},
{"id": "clse07:974700", "ko": "「아니, 괜찮아」"},
{"id": "clse07:974800", "ko": "「뭐, 뭐야?」"},
{"id": "clse07:974900", "ko": "「……?」"},
{"id": "clse07:975000", "ko": "「???」"},
{"id": "clse07:975100", "ko": "「어? 내가 여자애? 그런 거 싫어!」"},
{"id": "clse07:975200", "ko": "「그런 거 장담해 주지 않아도 돼~」"},
{"id": "clse07:975300", "ko": "「누나……」"},
{"id": "clse07:975400", "ko": "「우키 누나까지……」"},
{"id": "clse07:975500", "ko": "「……뭐든지?」"},
{"id": "clse07:975600", "ko": "「……프리스테이션 4도?」", "note": "プリステ４ = 플레이스테이션 4 패러디"},
{"id": "clse07:975700", "ko": "「…………」"},
{"id": "clse07:975800", "ko": "「우……」"},
{"id": "clse07:975900", "ko": "「알았어…… 나, 해 볼게! 누나를 위해서!」"},
{"id": "clse07:976000", "ko": "「응!」"},
{"id": "clse07:976100", "ko": "「아, 아파 누나」"},
{"id": "clse07:976200", "ko": "「노노 누나한테는 말하면 안 돼?」"},
{"id": "clse07:976300", "ko": "「알았어. 노노 누나한테는 말 안 할게」"},
{"id": "clse07:976400", "ko": "「부탁드려요, 프로듀서님」"},
{"id": "clse07:976500", "ko": "「차 안에서라니, 좋겠다~」"},
{"id": "clse07:976600", "ko": "「부탁드려요, 이토 프로듀서」"},
{"id": "clse07:976700", "ko": "「우~……」"},
{"id": "clse07:976800", "ko": "「너, 너무 빤히 보지 마~. 부끄러워~」"},
{"id": "clse07:976900", "ko": "「그게…… 나, 괜찮을까?」"},
{"id": "clse07:977000", "ko": "「에엣? 그런 거 나 못 해~」"},
{"id": "clse07:977100", "ko": "「다행이다아……」"},
{"id": "clse07:977200", "ko": "「으, 응」"},
{"id": "clse07:977300", "ko": "「밀푀유, 예요」"},
{"id": "clse07:977400", "ko": "「웃는 얼굴…… 같은 거려나?」"},
{"id": "clse07:977500", "ko": "「그게……」"},
{"id": "clse07:977600", "ko": "「그렇구나……」"},
{"id": "clse07:977700", "ko": "「부, 부탁드려요」"},
{"id": "clse07:977800", "ko": "「그렇구나아……」"},
{"id": "clse07:977900", "ko": "「부탁드려요!」"},
{"id": "clse07:978000", "ko": "「그게…… 밀푀크의 유예요……」", "note": "원문 「ミルフィーク」 — 유닛 이름을 잘못 말한 것으로 보고 살림"},
{"id": "clse07:978100", "ko": "「그게…… 방긋」"},
{"id": "clse07:978200", "ko": "「어? 어? 어?」"},
{"id": "clse07:978300", "ko": "", "note": "보류 — 성적 묘사(미성년). 원문 머리에 겹낫표 「「"},
{"id": "clse07:978400", "ko": "「아핫…… 아하핫, 아하하하하」"},
{"id": "clse07:978500", "ko": "「이, 이번엔 내가…… 에잇」"},
{"id": "clse07:978600", "ko": "「자, 간질간질간질간질~」"},
{"id": "clse07:978700", "ko": "「자자자~」"},
{"id": "clse07:978800", "ko": "「이렇게…… 요?」"},
{"id": "clse07:978900", "ko": "「부탁드려요」"},
{"id": "clse07:979000", "ko": "「그게…… 이건?」"},
{"id": "clse07:979100", "ko": "「으, 응」"},
{"id": "clse07:979200", "ko": "「그게…… 이런 느낌으로 괜찮을까?」"},
{"id": "clse07:979300", "ko": "「그게…… 이렇게?」"},
{"id": "clse07:979400", "ko": "「저, 정말 좋아해~」"}
]
