[
{"id": "clse07:889500", "ko": "「네?」"},
{"id": "clse07:889600", "ko": "「………」"},
{"id": "clse07:889700", "ko": "「………」"},
{"id": "clse07:889800", "ko": "「네, 네…… 유감스럽게도」"},
{"id": "clse07:889900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:890000", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:890100", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:890200", "ko": "「네? 모처럼인데, 해결해 버려도 괜찮은 거예요?」"},
{"id": "clse07:890300", "ko": "「그렇다면 간단해요. 저한테서 되도록 멀리 떨어져 주세요. 그러면 해제할 수 있을 거예요」"},
{"id": "clse07:890400", "ko": "「저, 충격이에요」"},
{"id": "clse07:890500", "ko": "「부끄럽네요」"},
{"id": "clse07:890600", "ko": "「저도 그런 느낌이 들어요」"},
{"id": "clse07:890700", "ko": "「그래요?」"},
{"id": "clse07:890800", "ko": "「그럼 아리무라 씨, 어쩌면 이제 ⟦rb⟧신문부⟦rt⟧여기⟦/r⟧에는 안 온다는 건가요?」"},
{"id": "clse07:890900", "ko": "「…………」"},
{"id": "clse07:891000", "ko": "「……섭섭해요」"},
{"id": "clse07:891100", "ko": "「……저도 농담이에요」"},
{"id": "clse07:891200", "ko": "「후에…… 볼, 잡아당기지 마데요. 아파…… 여……」"},
{"id": "clse07:891300", "ko": "「……설마, 생각 안 했던 거예요?」"},
{"id": "clse07:891400", "ko": "「후후후」"},
{"id": "clse07:891500", "ko": "「후후후」"},
{"id": "clse07:891600", "ko": "「정말, 유이도 참, 솔직하지 못하다니까요」"},
{"id": "clse07:891700", "ko": "「이런 말 하지만, 사실은 외로웠던 거예요, 유이」"},
{"id": "clse07:891800", "ko": "「저 알아요. 가끔 타쿠루 씨 침대에서 몰래 낮잠 잤던 거」"},
{"id": "clse07:891900", "ko": "「그거, 저번에 사 온 옷이죠? 유이가 아끼는」"},
{"id": "clse07:892000", "ko": "「타쿠루 씨 방은 노노 씨가 꼬박꼬박 청소해 주고 있으니까, 예전 그대로 쓸 수 있어요」"},
{"id": "clse07:892100", "ko": "「노노 씨, 어쩌면 나오기 힘든 걸지도……」"},
{"id": "clse07:892200", "ko": "「그야, 그…… 노노 씨, 집에서는……」"},
{"id": "clse07:892300", "ko": "「네」"},
{"id": "clse07:892400", "ko": "「잘 먹겠습니다」"},
{"id": "clse07:892500", "ko": "「네. 제가 거들었어요」"},
{"id": "clse07:892600", "ko": "「네엣?」"},
{"id": "clse07:892700", "ko": "「아직?」"},
{"id": "clse07:892800", "ko": "「그래도, 만약 정말로 마법을 쓸 수 있다면 멋지겠죠」"},
{"id": "clse07:892900", "ko": "「설마…… 그 매지컬 유이가 유이였다니……」"},
{"id": "clse07:893000", "ko": "「저기, 사인해 주세요……」"},
{"id": "clse07:893100", "ko": "「어떤 마술이에요?」"},
{"id": "clse07:893200", "ko": "「후훗, 타쿠루 씨도 참, 그렇게 놀라다니」"},
{"id": "clse07:893300", "ko": "「아~, 유토. 머리가 엄청 뻗쳤어요. 정리해야겠다」"},
{"id": "clse07:893400", "ko": "「아, 그럼 저는 진료소 빨래를 정리하고 올게요」"},
{"id": "clse07:893500", "ko": "「안녕히 주무세요」"},
{"id": "clse07:893600", "ko": "「타쿠루 씨. 목욕물 데워졌어요. 먼저 들어가세요」"},
{"id": "clse07:893700", "ko": "「오늘 아침 일찍 집 앞에 놓여 있었어요. 이 편지랑 같이」"},
{"id": "clse07:893800", "ko": "「듣고 보니 그렇네요」"},
{"id": "clse07:893900", "ko": "「네. 엄청 귀여워요」"},
{"id": "clse07:894000", "ko": "「자, 잠깐만요. 아기를 안을 때는 목 부분을 제대로 받쳐 줘야 해요」"},
{"id": "clse07:894100", "ko": "「아, 아뇨…… 실제로 해 본 적은 없…… 지만요……」"},
{"id": "clse07:894200", "ko": "「…………」"},
{"id": "clse07:894300", "ko": "「네, 넷. 관심이 있다거나 그런 건 아니…… 에요……」"},
{"id": "clse07:894400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:894500", "ko": "「아기, 귀엽네요, 타쿠루 씨」"},
{"id": "clse07:894600", "ko": "「……쪄, 요……?」", "note": "노노의 아기 말투(でちゅね → ~쪄요, 03)를 따라 해 보는 줄로 봄"},
{"id": "clse07:894700", "ko": "「네, 네……」"},
{"id": "clse07:894800", "ko": "「……후훗」"},
{"id": "clse07:894900", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:895000", "ko": "「…………」"},
{"id": "clse07:895100", "ko": "「오늘은 타쿠루 씨도 같이 왔네요」"},
{"id": "clse07:895200", "ko": "「또 놀러 와. 기다리고 있을게요……」"},
{"id": "clse07:895300", "ko": "「응!」"},
{"id": "clse07:895400", "ko": "「또 놀러 와. 기다리고 있을게요……」"},
{"id": "clse07:895500", "ko": "「대체 어떻게 된 걸까요? 요즘 세리카 씨 상태가 좀 이상한 것 같아요」"},
{"id": "clse07:895600", "ko": "「어, 어째서 저희는 안 되는 거예요?」"},
{"id": "clse07:895700", "ko": "「그래도…… 정말 그럴까요?」"},
{"id": "clse07:895800", "ko": "「………」"},
{"id": "clse07:895900", "ko": "「타쿠루 씨~!」"},
{"id": "clse07:896000", "ko": "「자, 여기요. 마운틴 뷰예요」"},
{"id": "clse07:896100", "ko": "「오노에 씨는 자몽 주스면 됐죠?」"},
{"id": "clse07:896200", "ko": "「아리무라 씨의 애플티와 언니의 다즐링은 지금 탈게요」"},
{"id": "clse07:896300", "ko": "「아뇨. 좋아서 하는 일이니까요」"},
{"id": "clse07:896400", "ko": "「저, 말인가요?」"},
{"id": "clse07:896500", "ko": "「저는…… 딱히……」"},
{"id": "clse07:896600", "ko": "「취미, 말인가요? 글쎄요…… 일 거들기라든가」"},
{"id": "clse07:896700", "ko": "「어……」"},
{"id": "clse07:896800", "ko": "「…………」"},
{"id": "clse07:896900", "ko": "「아뇨…… 뭐랄까 그게…… 그런 말, 별로 들어 본 적이 없어서……」"},
{"id": "clse07:897000", "ko": "「아뇨. 신경 쓰지 마세요. 제가 좋아서 하는 일이라서요」"},
{"id": "clse07:897100", "ko": "「네. 저는 이렇게 여러분께 도움이 될 수 있어서, 저, 기뻐요」"},
{"id": "clse07:897200", "ko": "「저기, 언니. 저……」"},
{"id": "clse07:897300", "ko": "「네. 그럼 저는 돌아가서 아버지 일을 도와 둘게요」"},
{"id": "clse07:897400", "ko": "「네」"},
{"id": "clse07:897500", "ko": "「아뇨. 좋아서 하는 일이니까요」"},
{"id": "clse07:897600", "ko": "「……감사합니다」"},
{"id": "clse07:897700", "ko": "「청진기라면 목에 걸려 있어요」"},
{"id": "clse07:897800", "ko": "「아버지 모습을 보다 보니까 그냥」"},
{"id": "clse07:897900", "ko": "「네?」"},
{"id": "clse07:898000", "ko": "「아…… 웁, 으으읍」"},
{"id": "clse07:898100", "ko": "「자, 잘 먹었습니다」"},
{"id": "clse07:898200", "ko": "「…………」"},
{"id": "clse07:898300", "ko": "「네? 아이돌 활동…… 이요?」"},
{"id": "clse07:898400", "ko": "「그래도, 아이돌이 뭘 하면 되는 건지 저는 모르겠어요……」"},
{"id": "clse07:898500", "ko": "「유이는 아이돌이 되고 싶어요?」"},
{"id": "clse07:898600", "ko": "「그렇…… 군요……」"},
{"id": "clse07:898700", "ko": "「아~아~아~……」"},
{"id": "clse07:898800", "ko": "「…………」"},
{"id": "clse07:898900", "ko": "「아, 혹시 깨워 버렸나요? 죄송해요」"},
{"id": "clse07:899000", "ko": "「그렇…… 군요. 다행이다」"},
{"id": "clse07:899100", "ko": "「아, 네. 그럼 실례할게요」"},
{"id": "clse07:899200", "ko": "「네. 실은 그……」"},
{"id": "clse07:899300", "ko": "「타쿠루 씨. 유이의 부탁, 들어주시면 안 될까요?」"},
{"id": "clse07:899400", "ko": "「네……」"}
]
