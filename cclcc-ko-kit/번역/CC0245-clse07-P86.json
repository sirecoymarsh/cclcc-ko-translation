[
{"id": "clse07:819500", "ko": "「있잖아, 들었어, 타쿠! 유이네, 이벤트 제안 들어왔다며?」"},
{"id": "clse07:819600", "ko": "「으~, 나도 그 정도는 안단 말이야」"},
{"id": "clse07:819700", "ko": "「그래서 어떡할 거야? 이벤트 나가?」"},
{"id": "clse07:819800", "ko": "「그게 뭔데?」"},
{"id": "clse07:819900", "ko": "「그러니까…… 그거 대단한 거지?」"},
{"id": "clse07:820000", "ko": "「왜 그래?」"},
{"id": "clse07:820100", "ko": "「……안 봐?」"},
{"id": "clse07:820200", "ko": "「응? 어, 아, 잠깐 타쿠!?」"},
{"id": "clse07:820300", "ko": "「집에 가 있는 건 아니야?」"},
{"id": "clse07:820400", "ko": "「찾는다니 어디를?」"},
{"id": "clse07:820500", "ko": "「뭐야, 타쿠. 아직 거기 있었구나. 그럼 얘기가 빠르겠다」"},
{"id": "clse07:820600", "ko": "「무슨 일이라니?」"},
{"id": "clse07:820700", "ko": "「신지!」"},
{"id": "clse07:820800", "ko": "「맞아. 아직 무슨 일이 있었다고 정해진 건 아니야」"},
{"id": "clse07:820900", "ko": "「아……」"},
{"id": "clse07:821000", "ko": "「유이가 어디 있는지만 알면……!」"},
{"id": "clse07:821100", "ko": "「왜 그래, 타쿠?」"},
{"id": "clse07:821200", "ko": "「으…… 미안, 나, 모르겠어……」"},
{"id": "clse07:821300", "ko": "「뭐어~, 타쿠? 타쿠 말이라면 뭐든 들어줄게? 나, 뭘 하면 돼?」"},
{"id": "clse07:821400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:821500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:821600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:821700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:821800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:821900", "ko": "「……? ……?」"},
{"id": "clse07:822000", "ko": "「……잠깐, 또 꿈~!? 방금 뭐야!?」"},
{"id": "clse07:822100", "ko": "「매일매일 왜 이런 꿈만 꾸는 거야!?」"},
{"id": "clse07:822200", "ko": "「후우……」"},
{"id": "clse07:822300", "ko": "「샤워해야겠다……」"},
{"id": "clse07:822400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:822500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:822600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:822700", "ko": "「자, 그럼…… 오늘은 뭐 할까?」"},
{"id": "clse07:822800", "ko": "（역시…… 시부야려나~?）"},
{"id": "clse07:822900", "ko": "（그래도 말이야. 가고 싶은걸, 어쩔 수 없잖아）"},
{"id": "clse07:823000", "ko": "「어쩔 수 없지, 혼자 갈까~」"},
{"id": "clse07:823100", "ko": "「쳇~, 그 네 명!」"},
{"id": "clse07:823200", "ko": "「『아~, 저 애는 역시 늘 혼자네. 외톨이구나. 불쌍해라…… 말 걸어 주는 게 좋으려나?』 같은 생각이나 하고 있을 것 같아서 열받아!」"},
{"id": "clse07:823300", "ko": "「…………」"},
{"id": "clse07:823400", "ko": "「……좋~아!」"},
{"id": "clse07:823500", "ko": "（그래도…… 좋은 친구, 많이 사귀고 싶은걸）"},
{"id": "clse07:823600", "ko": "「하아~~」"},
{"id": "clse07:823700", "ko": "（에헤헤~. 좀 지나면 그 네 명한테 말을 걸어 볼지도……）"},
{"id": "clse07:823800", "ko": "「……응? 어라? 어라~?」"},
{"id": "clse07:823900", "ko": "「으…… 훌쩍…… 훌쩍……」"},
{"id": "clse07:824000", "ko": "「시, 시끄러워~」"},
{"id": "clse07:824100", "ko": "「잠깐~! 그거 무슨 뜻이야!?」"},
{"id": "clse07:824200", "ko": "「……정말이지. 나를 뭐라고 생각하는 거야!?」"},
{"id": "clse07:824300", "ko": "「……흥. 정말, 참견만 하고……」"},
{"id": "clse07:824400", "ko": "「아, 여보세요? 세리카예요. 네, 네…… 에엣? 싫다~, 시부야요~? 쿠노사토 씨 몰래 그런 데를 갈 리가 없잖아요~, 참」"},
{"id": "clse07:824500", "ko": "「오늘은 하루 종일 숙제해야 하거든요~. 지금 학교는 숙제가 너무 많아요. 정말이지 곤란하다니까요~. 네, 그럼 끊을게요~」"},
{"id": "clse07:824600", "ko": "「아, 여보세요! 어때, 다들? 어? 괜찮대? 다행이다~! 시간이랑 장소는…… 응, 그걸로 OK야. 그럼 이따 봐!」"},
{"id": "clse07:824700", "ko": "「그럼, 다녀오겠습니다~」"},
{"id": "clse07:824800", "ko": "「아, 타쿠」"},
{"id": "clse07:824900", "ko": "「미안, 타쿠. 오늘 동아리는 쉴게」"},
{"id": "clse07:825000", "ko": "「그게, 그러니까……」"},
{"id": "clse07:825100", "ko": "「아~, 히나. 미안, 그게 아직……」"},
{"id": "clse07:825200", "ko": "「미안해, 타쿠. 새로 생긴 초콜릿 바에 다 같이 가자는 얘기가 돼서」"},
{"id": "clse07:825300", "ko": "「아, 응. 그럼 타쿠. 또 봐」"},
{"id": "clse07:825400", "ko": "「타쿠, 괜찮아!?」"},
{"id": "clse07:825500", "ko": "「……『밀푀유』?」"},
{"id": "clse07:825600", "ko": "「……흥, 아이돌은 무슨……」"},
{"id": "clse07:825700", "ko": "「별로 귀엽지도 않고, 노래도 엉망이잖아」"},
{"id": "clse07:825800", "ko": "「젠장! 이딴 걸로 랭킹 상위에 들어가다니, 말이 되냐!」"},
{"id": "clse07:825900", "ko": "「이럴 거면 내가 훨씬 재밌다고!」"},
{"id": "clse07:826000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:826100", "ko": "「아~, 왠지 열받네! 젠장! 젠장! 젠장! 젠장! 젠장!」"},
{"id": "clse07:826200", "ko": "「이럴 거면 내가…… 내가…… 내가……」"},
{"id": "clse07:826300", "ko": "「잠깐 시간 괜찮을까?」"},
{"id": "clse07:826400", "ko": "「자, 이름은?」"},
{"id": "clse07:826500", "ko": "「지금 기분은 어때?」"},
{"id": "clse07:826600", "ko": "「흐응. 그럼 지금부터 내는 질문에 대답하면 뭐 좀 마시게 해 줄게」"},
{"id": "clse07:826700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:826800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:826900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:827900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:828700", "ko": "「하? 아직도 그런 소리 하는 거야? 애초에 장소도 모르는데 누가 온다는 거야?」"},
{"id": "clse07:828800", "ko": "「『그렇게 다들 봐 주길 바란다면, 도와주지……』」"},
{"id": "clse07:828900", "ko": "「『이거야, 이거!』」"},
{"id": "clse07:829000", "ko": "「그럼, 슬슬 해 볼까……」"},
{"id": "clse07:829100", "ko": "「괜찮아…… 딱히 죽이지는 않을 테니까. 그냥……」"},
{"id": "clse07:829200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:829300", "ko": "「이상하네? 누가 구하러 와 준다고 하지 않았나?」"},
{"id": "clse07:829400", "ko": "", "note": "보류 — 성적 묘사"}
]
