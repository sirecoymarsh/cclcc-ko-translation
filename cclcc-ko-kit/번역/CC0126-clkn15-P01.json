[
{"id": "clkn15:0", "ko": "「…………」"},
{"id": "clkn15:100", "ko": "쿠루스 노노는 홀로 싸늘한 복도에 서 있었다."},
{"id": "clkn15:200", "ko": "오후 수업은 이미 시작됐다."},
{"id": "clkn15:300", "ko": "학생회장이면서 수업을 빼먹는 짓은, 지금까지의 노노라면 결코 하지 않았을 것이다."},
{"id": "clkn15:400", "ko": "⟦top:38⟧하지만 그것도 지금의 노노에게는 아무래도 좋았다."},
{"id": "clkn15:500", "ko": "오후 수업이 시작되기 직전, 갑자기 오노에 세리카가 교실로 찾아왔다."},
{"id": "clkn15:600", "ko": "그리고 당황하는 노노의 손을 잡아끌고, 세리카는 이곳――신문부 부실 앞까지 그녀를 데려왔다."},
{"id": "clkn15:700", "ko": "「노노. 잠깐만 여기서 기다려 줘」"},
{"id": "clkn15:800", "ko": "그렇게 말하고 세리카는 노노를 혼자 두고 신문부실로 들어갔다."},
{"id": "clkn15:900", "ko": "이런 시간에 부실에 뭐가 있다는 걸까."},
{"id": "clkn15:1000", "ko": "세리카는 무슨 생각을 하는 걸까."},
{"id": "clkn15:1100", "ko": "그런 생각을 하고 있는데, 안에서 목소리가 들려왔다."},
{"id": "clkn15:1200", "ko": "（――세리카랑 또 한 사람…… 누구지?）"},
{"id": "clkn15:1300", "ko": "「진짜 사실이라니?」"},
{"id": "clkn15:1400", "ko": "（――타쿠루?）"},
{"id": "clkn15:1500", "ko": "그건 틀림없이 미야시로 타쿠루의 목소리였다."},
{"id": "clkn15:1600", "ko": "⟦top:38⟧타쿠루니까."},
{"id": "clkn15:1700", "ko": "교실에 있기 힘들어서 여기 와 있었던 거겠지."},
{"id": "clkn15:1800", "ko": "⟦top:38⟧그리고 그렇게 되도록 몰아붙인 건, 다름 아닌 자신이다."},
{"id": "clkn15:1900", "ko": "「……노노 일」"},
{"id": "clkn15:2000", "ko": "세리카는 타쿠루에게, 그녀가 센리라는 사실을 모두에게 말하지 않을 거냐고 묻고 있었다."},
{"id": "clkn15:2100", "ko": "그래, 모든 건 간단한 일이다."},
{"id": "clkn15:2200", "ko": "⟦top:38⟧쿠루스 노노는, 미나미사와 센리라는 자신에게 자신감조차 갖지 못하는 볼품없는 소녀가 주위를 속이기 위해 꾸민 모습."},
{"id": "clkn15:2300", "ko": "⟦top:38⟧호랑이 가죽을 뒤집어쓴 한낱 여우일 뿐이라고 주위에 말하면 된다."},
{"id": "clkn15:2400", "ko": "확실히 지금 노노는 센리의 모습으로 돌아갈 수 없다."},
{"id": "clkn15:2500", "ko": "⟦top:38⟧그래도 증언해 줄 사람이라면 얼마든지 있다."},
{"id": "clkn15:2600", "ko": "⟦top:38⟧타쿠루가 한마디만 하면, 그것만으로 타쿠루에게 씌워진 혐의를 벗을 가능성은 높아진다."},
{"id": "clkn15:2700", "ko": "（타쿠루……）"},
{"id": "clkn15:2800", "ko": "듣고 싶지 않다."},
{"id": "clkn15:2900", "ko": "⟦top:76⟧그래도 듣고 싶다."},
{"id": "clkn15:3000", "ko": "⟦top:38⟧세리카의 물음에 타쿠루가 어떻게 대답할지――."},
{"id": "clkn15:3100", "ko": "그건 아주 잠깐이었지만, 노노에게는 몇 분처럼 느껴졌다."},
{"id": "clkn15:3200", "ko": "⟦top:152⟧그리고――."},
{"id": "clkn15:3300", "ko": "「말 안 해, 그런 거……」"},
{"id": "clkn15:3400", "ko": "「――!」"},
{"id": "clkn15:3500", "ko": "그 대답을 들은 순간, 노노의 눈에서는 굵은 눈물이 흘러내리고 있었다."},
{"id": "clkn15:3600", "ko": "「읏…… 으으……」"},
{"id": "clkn15:3700", "ko": "「나는 이제 싫어…… 그 녀석의 그런 슬픈 얼굴을 보는 게……」"},
{"id": "clkn15:3800", "ko": "문 너머로 들리는 타쿠루의 한마디 한마디가 노노의 불안을 녹여 간다."},
{"id": "clkn15:3900", "ko": "⟦top:114⟧두려움과 근심으로 차갑게 굳어 있던 마음이 풀려 간다."},
{"id": "clkn15:4000", "ko": "「계속 이런 시간이 이어지면 좋겠다고 생각했어」"},
{"id": "clkn15:4100", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:4200", "ko": "（타쿠…… 루…… 읏……）"},
{"id": "clkn15:4300", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:4400", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:4500", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:4600", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:4700", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:4800", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:4900", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:5000", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:5100", "ko": "「읏…………」"},
{"id": "clkn15:5200", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:5300", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:5400", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn15:5500", "ko": "「어느 쪽이든 마찬가지야. 노노든 센리든, 그 녀석은 그 녀석이야」"},
{"id": "clkn15:5600", "ko": "「센리로서 보낸 시간. 노노로서 살아온 시간. 그 둘 다가 있어서 지금의 그 녀석이 있는 거니까……」"},
{"id": "clkn15:5700", "ko": "「학교에서 ⟦col:280aa02d1400⟧여제⟦col:800000⟧라 불리던 노노도, 집에서 야무진 누나였던 센리도, 둘 다 그 애를 이루는 거라면 나는 그걸 받아들일 뿐이야」"},
{"id": "clkn15:5800", "ko": "그건――그것이야말로 그녀가 듣고 싶었던 말이었다."},
{"id": "clkn15:5900", "ko": "단 한 사람."},
{"id": "clkn15:6000", "ko": "⟦top:38⟧한 사람이면 됐다."},
{"id": "clkn15:6100", "ko": "⟦top:38⟧자신은 자신이어도 된다."},
{"id": "clkn15:6200", "ko": "⟦top:38⟧그렇게 인정받고 싶었다."},
{"id": "clkn15:6300", "ko": "⟦top:38⟧그게 자신이 바라던 것이었다고, 그녀는 깨달았다."},
{"id": "clkn15:6400", "ko": "그리고 지금――."},
{"id": "clkn15:6500", "ko": "「그러니까 그 애의 슬픔을 내가 대신 짊어질 수 있다면, 나는 기꺼이 짊어지겠어」"},
{"id": "clkn15:6600", "ko": "그제야 진짜 자신을 되찾은 듯한 기분이 들었다."},
{"id": "clkn15:6700", "ko": "문 열리는 소리에 고개를 들자, 세리카가 쑥스러운 얼굴로 서 있었다."},
{"id": "clkn15:6800", "ko": "「세리카……」"},
{"id": "clkn15:6900", "ko": "「들렸어?」"},
{"id": "clkn15:7000", "ko": "「응」"},
{"id": "clkn15:7100", "ko": "「그렇대」"},
{"id": "clkn15:7200", "ko": "「응」"},
{"id": "clkn15:7300", "ko": "「갈까?」"},
{"id": "clkn15:7400", "ko": "「응」"}
]
