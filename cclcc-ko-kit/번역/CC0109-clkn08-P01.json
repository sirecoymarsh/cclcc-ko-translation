[
{"id": "clkn08:0", "ko": "「하아…… 하아…… 하아……」"},
{"id": "clkn08:100", "ko": "……뭐, 뭐야."},
{"id": "clkn08:200", "ko": "꿈이었나……"},
{"id": "clkn08:300", "ko": "그나저나 이상한 꿈이었다."},
{"id": "clkn08:400", "ko": "게다가 묘한 현실감이 있었던 것 같다."},
{"id": "clkn08:500", "ko": "특히 그 울음소리."},
{"id": "clkn08:600", "ko": "그래그래, 그 아기 울음소리는 특히 생생했다."},
{"id": "clkn08:700", "ko": "그 증거로, 이렇게 지금도 귀에 들러붙어 떠나지 않는다."},
{"id": "clkn08:800", "ko": "떠나지 않……"},
{"id": "clkn08:900", "ko": "「…………」"},
{"id": "clkn08:1000", "ko": "아니야!"},
{"id": "clkn08:1100", "ko": "이 울음소리는 꿈의 연장 같은 게 아니다."},
{"id": "clkn08:1200", "ko": "⟦rb⟧현실⟦rt⟧리얼⟦/r⟧에서 들리는 목소리다."},
{"id": "clkn08:1300", "ko": "나는 허둥지둥 침대에서 내려와, 울음소리가 들리는 곳을 찾아 방을 뛰쳐나갔다."},
{"id": "clkn08:1400", "ko": "「타쿠루……」"},
{"id": "clkn08:1500", "ko": "거실에 들어가자, 아직 이른 아침인데도 나 말고 모두가 다 모여 있었다."},
{"id": "clkn08:1600", "ko": "다들 둥글게 모여 뭔가를 둘러싸고 있다."},
{"id": "clkn08:1700", "ko": "울음소리는 그 한가운데서 들려오고 있었다."},
{"id": "clkn08:1800", "ko": "들여다보니 거기에는――."},
{"id": "clkn08:1900", "ko": "「아기……」"},
{"id": "clkn08:2000", "ko": "그 울음소리로 짐작했던 대로, 조그만 생명체가 얼굴을 잔뜩 찡그린 채 울고 있었다."},
{"id": "clkn08:2100", "ko": "「어떻게 된 거야, 이 아기. 혹시…… 센리 애야?」"},
{"id": "clkn08:2200", "ko": "「바보. 그럴 리가 없잖아」"},
{"id": "clkn08:2300", "ko": "그렇겠지……"},
{"id": "clkn08:2400", "ko": "「오늘 아침 일찍 집 앞에 놓여 있었어요. 이 편지랑 같이」"},
{"id": "clkn08:2500", "ko": "우키가 내민 편지를 훑어봤다."},
{"id": "clkn08:2600", "ko": "필체로 보아 여자일 것이다."},
{"id": "clkn08:2700", "ko": "거기에는 『이 아이를 부탁합니다. 이름은 히카리입니다』라고만 쓰여 있었다."},
{"id": "clkn08:2800", "ko": "「버리고 간…… 건가……」"},
{"id": "clkn08:2900", "ko": "「생후 3개월쯤 됐겠구먼」"},
{"id": "clkn08:3000", "ko": "이 아오바 기숙사에 나를 비롯해 오갈 데 없는 아이들이 많이 있다는 걸 알았던 건지, 아니면 우연인지."},
{"id": "clkn08:3100", "ko": "아무튼 아기를 낳기는 했지만, 돌보기 힘들어진 누군가가 두고 간 거겠지."},
{"id": "clkn08:3200", "ko": "「아직 이렇게 조그만 앤데, 너무해……」"},
{"id": "clkn08:3300", "ko": "「그렇지. 하지만 이 편지를 쓴 엄마가 안 돌아온다고 정해진 건 아니다」"},
{"id": "clkn08:3400", "ko": "「그래?」"},
{"id": "clkn08:3500", "ko": "「그래. 이런 경우, 나중에 후회하고 돌아오는 일도 적지 않으니까」"},
{"id": "clkn08:3600", "ko": "「맞아. 게다가 이 아기가 입은 걸 좀 봐. 꽤 좋은 옷을 입혀 놨잖아」"},
{"id": "clkn08:3700", "ko": "「듣고 보니 그렇네요」"},
{"id": "clkn08:3800", "ko": "「게다가 꽤 따뜻해 보이게 입혀 놨잖아? 그렇다는 건, 애정이 없는 건 아닌 것 같아」"},
{"id": "clkn08:3900", "ko": "「그러니까 어쩌면 돌아올지도 몰라」"},
{"id": "clkn08:4000", "ko": "「그러면 좋겠는데……」"},
{"id": "clkn08:4100", "ko": "유이와 유토는 그 얘기를 듣고서야 조금 안심한 듯한 미소를 지었다."},
{"id": "clkn08:4200", "ko": "「그래서, 이 아기 말인데……」"},
{"id": "clkn08:4300", "ko": "「물론 당분간 집에서 돌볼게요」"},
{"id": "clkn08:4400", "ko": "뭐, 그렇게 될 거라고는 생각했지만."},
{"id": "clkn08:4500", "ko": "「그러니까 아빠. 당분간 술값 줄일게」"},
{"id": "clkn08:4600", "ko": "「왜, 왜 그렇게 되는데!」"},
{"id": "clkn08:4700", "ko": "「그치만 분유값이 필요하잖아. 조금은 참아 줘야지」"},
{"id": "clkn08:4800", "ko": "센리가 딱 잘라 말하자, 아버지는 어깨를 움츠렸다."},
{"id": "clkn08:4900", "ko": "「지금도 줄이고 있는데 말이다……」"},
{"id": "clkn08:5000", "ko": "「그리고 타쿠루. 될 수 있으면 오늘부터 잠깐만이라도 좋으니까. ⟦rb⟧아오바 기숙사⟦rt⟧여기⟦/r⟧서 지내 줄 수 없을까?」"},
{"id": "clkn08:5100", "ko": "「여기서? 왜?」"},
{"id": "clkn08:5200", "ko": "「이것저것 필요한 것도 많아지고, 될 수 있으면 남자 손이 있었으면 해서」"},
{"id": "clkn08:5300", "ko": "「아버지가 있잖아」"},
{"id": "clkn08:5400", "ko": "「미안하지만 난 오늘 오후부터 일주일쯤 학회 때문에 나가 봐야 한다」"},
{"id": "clkn08:5500", "ko": "잠깐."},
{"id": "clkn08:5600", "ko": "그런 얘긴 한마디도 못 들었는데."},
{"id": "clkn08:5700", "ko": "「그러니까 부탁해. 응?」"},
{"id": "clkn08:5800", "ko": "나랑은 상관없어――그 말이 목구멍까지 올라왔을 때, 아기의 동그란 눈동자가 가만히 나를 보고 있다는 걸 알아차렸다."},
{"id": "clkn08:5900", "ko": "『히카리』는 서툴게 팔다리를 버둥거리며, 악의라곤 없는 순수한 눈동자를 그저 똑바로 내게 향하고 있었다."},
{"id": "clkn08:6000", "ko": "「……아, 알았어. 그 대신 아버지가 돌아올 때까지만이야」"},
{"id": "clkn08:6100", "ko": "「응. 고마워, 타쿠루」"},
{"id": "clkn08:6200", "ko": "센리의 말에 대답하듯 아기가 웃었다."},
{"id": "clkn08:6300", "ko": "그로부터 몇 시간은 그야말로 정신없었다."},
{"id": "clkn08:6400", "ko": "아버지 말로는 이럴 때는 ⟦col:280aa02d1400⟧후생노동성⟦col:800000⟧에 알려야 한다는데, 혹시라도 엄마가 마음을 바꿔 돌아왔을 때 이래저래 일이 커지면 안 된다는 이유로――"},
{"id": "clkn08:6500", "ko": "일단 당분간은 상황을 지켜보기로 했다."},
{"id": "clkn08:6600", "ko": "여차하면 내가 어떻게든 하겠다――고 아버지는 말했지만…… 괜찮은 걸까."},
{"id": "clkn08:6700", "ko": "아무튼 우리는 쓸데없는 걱정 말고 아기 돌보는 데만 전념하라는 말을 남기고, 아버지는 학회로 떠났다."},
{"id": "clkn08:6800", "ko": "도무지 믿음직한 건지 아닌 건지 잘 모르겠다."},
{"id": "clkn08:6900", "ko": "그건 그렇고――."},
{"id": "clkn08:7000", "ko": "「후훗…… 귀엽구나」"},
{"id": "clkn08:7100", "ko": "「네. 엄청 귀여워요」"},
{"id": "clkn08:7200", "ko": "내 입장에서 보면 아기는 작고 연약해서 아무래도 겁나는 존재인데, 여자애들한테는 다른 걸까."},
{"id": "clkn08:7300", "ko": "「앗, 울기 시작했어. 왜 그러지?」"},
{"id": "clkn08:7400", "ko": "「안아 줘? 안아 주는 게 좋아?」"},
{"id": "clkn08:7500", "ko": "「자, 잠깐만요. 아기를 안을 때는 목 쪽을 제대로 받쳐 줘야 해요」"},
{"id": "clkn08:7600", "ko": "「우키는 해 본 적 있어?」"},
{"id": "clkn08:7700", "ko": "「아, 아뇨…… 실제로 해 본 적은 없…… 지만요……」"},
{"id": "clkn08:7800", "ko": "모두 서로 눈치를 보다가, 결국 모든 시선이 센리에게 향했다."},
{"id": "clkn08:7900", "ko": "「어? 나!?」"},
{"id": "clkn08:8000", "ko": "그 센리도 아기 돌보기는 처음인 모양이다."},
{"id": "clkn08:8100", "ko": "잠깐 망설이는 기색을 보였지만, 그렇다고 여기서 떠넘길 상대도 없다고 판단한 모양이다."},
{"id": "clkn08:8200", "ko": "조심조심 손을 뻗어 아기 몸 아래로 두 팔을 살며시 넣고 천천히 안아 올렸다."},
{"id": "clkn08:8300", "ko": "「옳지 옳지, 그래~ 착하지, 울지 마~」"},
{"id": "clkn08:8400", "ko": "하지만 아기는 울음을 그치기는커녕 더 크게 울었다."},
{"id": "clkn08:8500", "ko": "「큰일이네…… 울음을 안 그쳐……」"},
{"id": "clkn08:8600", "ko": "「혹시 쉬한 거 아냐?」"},
{"id": "clkn08:8700", "ko": "「아…… 그럴지도 모르겠다. 근데 어쩌지. 기저귀가 없어……」"},
{"id": "clkn08:8800", "ko": "「타쿠루 오빠, 사 와!」"},
{"id": "clkn08:8900", "ko": "「어? 왜 내가……」"},
{"id": "clkn08:9000", "ko": "「그러라고 있는 게 타쿠루 오빠잖아?」"},
{"id": "clkn08:9100", "ko": "내 존재 가치란……"},
{"id": "clkn08:9200", "ko": "결국 근처 드러그스토어까지 사러 가야 하는 신세가 됐다."},
{"id": "clkn08:9300", "ko": "「큭…… 왜 내가 기저귀를 사러 뛰어야 하는 건데……!」"},
{"id": "clkn08:9400", "ko": "「감사합니다아~」"},
{"id": "clkn08:9500", "ko": "「하아…… 하아…… 사, 왔어……」"},
{"id": "clkn08:9600", "ko": "「고마워. 덕분에 살았어」"},
{"id": "clkn08:9700", "ko": "종이 기저귀는 뭐가 좋은지 몰라서 대충 골랐지만, 뭐 괜찮겠지."},
{"id": "clkn08:9800", "ko": "「자~ 기저귀 갈아요오~. 착하니까 가만히 있어 주쩨요오~」"},
{"id": "clkn08:9900", "ko": "어느새 아기 말투가 돼 있고."}
]
