[
{"id": "clse07:117800", "ko": "「내버려 둬 내버려 둬. 저번 신문 기사가 호평이었던 탓에 삐친 거야」"},
{"id": "clse07:117900", "ko": "「포기해, 미야시로. 그게 세상의 솔직한 반응이라는 거다」"},
{"id": "clse07:118000", "ko": "「대충 문예부 선배랑 화해라도 한 거 아니야?」"},
{"id": "clse07:118100", "ko": "「아니~ 정말 바보구나, 미야시로」"},
{"id": "clse07:118200", "ko": "「그래. 신문부의 새로운 시도로 앞으로 웹에서 영상 배포를 하기로 했어. 그 첫 번째가 이거다」"},
{"id": "clse07:118300", "ko": "「그것뿐만이 아니라고」"},
{"id": "clse07:118400", "ko": "「봐. SNS 트렌드에도 올랐다고!」"},
{"id": "clse07:118500", "ko": "「……왜 그래, 너. 갑자기 그렇게 큰 소리를 내고」"},
{"id": "clse07:118600", "ko": "「…………」"},
{"id": "clse07:118700", "ko": "「에헤헷, 와 버렸어♪」"},
{"id": "clse07:118800", "ko": "「으그그…… 기다려, 닫지 마……!」"},
{"id": "clse07:118900", "ko": "「으읏…… 아아아아아아아앗!!!」"},
{"id": "clse07:119000", "ko": "「하아…… 하아…… 뭐, 뭐야. 왜 쫓아내는 건데?」"},
{"id": "clse07:119100", "ko": "「흐흐~응……」"},
{"id": "clse07:119200", "ko": "「그런 말 하고. 누구 기다리고 있었던 거 아니야~?」"},
{"id": "clse07:119300", "ko": "「그치만 아까 늦었네, 라고 하지 않았냐?」"},
{"id": "clse07:119400", "ko": "「흐~응……」"},
{"id": "clse07:119500", "ko": "「……뭐, 됐다. 들어간다~」"},
{"id": "clse07:119600", "ko": "「왜? 혹시 들어오면 곤란한 거라도 있냐?」"},
{"id": "clse07:119700", "ko": "「그럼 괜찮지? 실례합니다~」"},
{"id": "clse07:119800", "ko": "「흠……」"},
{"id": "clse07:119900", "ko": "「아무리 그래도 여기는…… 없나」"},
{"id": "clse07:120000", "ko": "「흠. 안심했다! 역시 너는 내 절친이야, 미야시로!」"},
{"id": "clse07:120100", "ko": "「아니~ 동아리 할 때 네 모습이 이상했잖아? 이상하게 빨리 돌아가고 싶어 하는 것 같았고」"},
{"id": "clse07:120200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:120300", "ko": "「그렇지~. 역시 미야시로다. 내가 믿는 남자다워」"},
{"id": "clse07:120400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:120500", "ko": "「너한테 한해서는 그런 걱정할 필요가 없었던 거지」"},
{"id": "clse07:120600", "ko": "「그렇지~. 그래서?」"},
{"id": "clse07:120700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:120800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:120900", "ko": "「뭐?」"},
{"id": "clse07:121000", "ko": "「뭐야. 너 배고프냐?」"},
{"id": "clse07:121100", "ko": "「아앙?」"},
{"id": "clse07:121200", "ko": "「뭐야. 나는 사러 안 간다. 먹고 싶으면 네가 사 와」"},
{"id": "clse07:121300", "ko": "「응? 모처럼 왔으니까 좀 더 느긋하게 있어도 되잖아」"},
{"id": "clse07:121400", "ko": "「그동안 내가 집 봐 줄게」"},
{"id": "clse07:121500", "ko": "「그보다 말이야, 나 좀 졸린데. 그러니까 네가 편의점 가 있는 동안 누워 있어도 되냐?」"},
{"id": "clse07:121600", "ko": "「그럼 잘 자~!」"},
{"id": "clse07:121700", "ko": "「어? 아…… 우왓!!」"},
{"id": "clse07:121800", "ko": "「미, 미야시로…… 너, 뭘……」"},
{"id": "clse07:121900", "ko": "「저, 저기…… 미야시로…… 그…… 좀 비켜…… 줄래?」"},
{"id": "clse07:122000", "ko": "「아니…… 응?」"},
{"id": "clse07:122100", "ko": "「뭐야, 이거?」"},
{"id": "clse07:122200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:122300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:122400", "ko": "「엥?」"},
{"id": "clse07:122500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:122600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:122700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:122800", "ko": "「아, 아아…… 말 안 할게…… 아무한테도……」"},
{"id": "clse07:122900", "ko": "「미, 미안했다. 방해해서. 나, 슬슬……」"},
{"id": "clse07:123000", "ko": "「그, 그럼 간다!!!」"},
{"id": "clse07:123100", "ko": "「아……」"},
{"id": "clse07:123200", "ko": "「미야시로…… 너…… 혹시……」"},
{"id": "clse07:123300", "ko": "「그렇구나…… 미안하다…… 지금까지 알아주지 못해서……」"},
{"id": "clse07:123400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:123500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:123600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:123700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:123800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:123900", "ko": "「국왕 폐하 납시오~!」"},
{"id": "clse07:124000", "ko": "「미야시로」"},
{"id": "clse07:124100", "ko": "「어서 와라, 우리 남자 왕국에」"},
{"id": "clse07:124200", "ko": "「자자, 미야시로, 미련 그만 부려」"},
{"id": "clse07:124300", "ko": "「미야시로……?」"},
{"id": "clse07:124400", "ko": "「뭐, 뭐야, 그런 거였냐. 나는 또 완전히……」"},
{"id": "clse07:124500", "ko": "「아~ 아니, 아무것도 아니야! 신경 쓰지 마!」"},
{"id": "clse07:124600", "ko": "「아~ 그럼 나 슬슬 갈게. 뭔가 내 착각이었던 것 같고」"},
{"id": "clse07:124700", "ko": "「뭐, 특종이라면 특종일지도 모르겠네」"},
{"id": "clse07:124800", "ko": "「미야시로오~」"},
{"id": "clse07:124900", "ko": "「너도 고생이 많구나……」"},
{"id": "clse07:125000", "ko": "「네가 그 아리무라를 스스로 끌어들였을 리가 없지. 어차피 무슨 약점이라도 잡힌 거겠지?」"},
{"id": "clse07:125100", "ko": "「아, 미야시로!」"},
{"id": "clse07:125200", "ko": "「그래서 어땠어? 뭐라고 하든?」"},
{"id": "clse07:125300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:125400", "ko": "「그럼 딱히 괜찮지 않냐?」"},
{"id": "clse07:125500", "ko": "「그보다 말이야, 그거 먹을 수 있는 거냐?」"},
{"id": "clse07:125600", "ko": "「누가 인기 없는 선배야!」"},
{"id": "clse07:125700", "ko": "「그만해, 카즈키! 네가 그걸 입에 올리면 현실이 될지도 모르잖아!!」"},
{"id": "clse07:125800", "ko": "「그치만 말이야~……」"},
{"id": "clse07:125900", "ko": "「미안하다, 어울리게 해서」"},
{"id": "clse07:126000", "ko": "「『부탁이야, 미야시로! 도와줘! 평생소원이야!!』」"},
{"id": "clse07:126100", "ko": "「뭐, 그렇게 말하지 마. 네 덕분에 나는 지금 엄청 행복하다고. 절친의 행복은 너의 행복이기도 할 거잖아, 그치?」"},
{"id": "clse07:126200", "ko": "「우와, 너무하네」"},
{"id": "clse07:126300", "ko": "「그러고 보니 오늘 아리무라는 어떻게 하고 있냐?」"},
{"id": "clse07:126400", "ko": "「흐~응」"},
{"id": "clse07:126500", "ko": "「그래서 말이야, 어떤데, 실제로는」"},
{"id": "clse07:126600", "ko": "「당연하잖아! 아리무라 얘기지」"},
{"id": "clse07:126700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:126800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:126900", "ko": "「이봐. 나는 그렇게까지 속 좁은 남자가 아니라고」"},
{"id": "clse07:127000", "ko": "「헤헷, 들켰냐. 아니, 그치만 말이야~, 그 녀석 나를 절대로 선배라고 생각 안 하고, 더 말하자면 남자로 안 본다니까」"},
{"id": "clse07:127100", "ko": "「그래~? 나한테는 그렇게 안 보이는데」"},
{"id": "clse07:127200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:127300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:127400", "ko": "「뭐, 너는 그런 여자애들의 섬세한 심정은 모르겠지」"},
{"id": "clse07:127500", "ko": "「당연하지. 뭐니 뭐니 해도 나는 너랑 달리 순정 만화를 읽으니까」"},
{"id": "clse07:127600", "ko": "「저기 말이야…… 모르겠는데, 너야말로 왜 그렇게까지 발끈하는 건데?」"},
{"id": "clse07:127700", "ko": "「그럼 말을 바꿔 주지. 왜 그렇게 전부 다 부정하려고 하는 건데?」"}
]
