[
{"id": "clse07:909500", "ko": "「그래서, 뭔데?」"},
{"id": "clse07:909600", "ko": "「네에~」"},
{"id": "clse07:909700", "ko": "「네에~」"},
{"id": "clse07:909800", "ko": "「노노 언니~! 내 체육복은~?」"},
{"id": "clse07:909900", "ko": "「어라? 타쿠루 오빠, 벌써 가?」"},
{"id": "clse07:910000", "ko": "「잠깐 기다려. 그럼 같이…… 어라? 노노 언니는?」"},
{"id": "clse07:910100", "ko": "「어? 아, 타쿠루 오빠, 기다려~」"},
{"id": "clse07:910200", "ko": "「잘 먹었습니다」"},
{"id": "clse07:910300", "ko": "「밥 먹기 전에 끝내 놓지 않으니까 그렇지」"},
{"id": "clse07:910400", "ko": "「네에~」"},
{"id": "clse07:910500", "ko": "「그러고 보니, 고등부에 연애 금지령이 내려졌다며?」"},
{"id": "clse07:910600", "ko": "「진짜 좀 봐줬으면 좋겠어~. 센리 언니랑 타쿠루 오빠는 졸업하니까 괜찮겠지만, 나는 내년부터라고?」"},
{"id": "clse07:910700", "ko": "「그런데 교내 연애 금지라니」"},
{"id": "clse07:910800", "ko": "「뭐, 뭐뭐, 뭐야 그게! 왜 내가 타쿠루 오빠 같은 거랑!」"},
{"id": "clse07:910900", "ko": "「게다가…… 타쿠루 오빠한텐 센리 언니가 있잖아……」"},
{"id": "clse07:911000", "ko": "「그래. 애초에 타쿠루 오빠랑은 그…… 남매고」"},
{"id": "clse07:911100", "ko": "「왜 그래, 타쿠루 오빠?」"},
{"id": "clse07:911200", "ko": "「잘 자, 타쿠루 오빠」"},
{"id": "clse07:911300", "ko": "「그래?」"},
{"id": "clse07:911400", "ko": "「그럼 다행이지만……」"},
{"id": "clse07:911500", "ko": "「안아? 안아 주는 게 좋아?」"},
{"id": "clse07:911600", "ko": "「우키는 해 본 적 있어?」"},
{"id": "clse07:911700", "ko": "「타쿠루 오빠, 사 와!」"},
{"id": "clse07:911800", "ko": "「그야, 그러라고 있는 타쿠루 오빠잖아?」"},
{"id": "clse07:911900", "ko": "「흐응……」"},
{"id": "clse07:912000", "ko": "「따, 딱히 빤히 쳐다보지 않았거든! 그치~?!」"},
{"id": "clse07:912100", "ko": "「맞아. 게다가 이 정도는 유 거 보면서 익숙해졌고」"},
{"id": "clse07:912200", "ko": "「센리 언니는 신기하지 않아?」"},
{"id": "clse07:912300", "ko": "「세, 센리 언니, 대담해~……」"},
{"id": "clse07:912400", "ko": "「노노 언니, 왜 그래?」"},
{"id": "clse07:912500", "ko": "「……풉!!」"},
{"id": "clse07:912600", "ko": "「크흠!」"},
{"id": "clse07:912700", "ko": "「이불, 다 깔았는데요~」"},
{"id": "clse07:912800", "ko": "「아, 봐, 히카리! 아빠랑 엄마가 돌아왔어」"},
{"id": "clse07:912900", "ko": "「역시 엄마!」"},
{"id": "clse07:913000", "ko": "「네에~」"},
{"id": "clse07:913100", "ko": "「센리 언니, 무슨 일 있었어?」"},
{"id": "clse07:913200", "ko": "「뭐?! 잠깐, 타쿠루 오빠! 뭐야? 역시 센리 언니랑 무슨 일 있었던 거야?」"},
{"id": "clse07:913300", "ko": "「정말~?」"},
{"id": "clse07:913400", "ko": "「그럼, 다녀오겠습니다~」"},
{"id": "clse07:913500", "ko": "「정말, 무슨 바람이 분 거야?」"},
{"id": "clse07:913600", "ko": "「『아, 봐, 히카리! 아빠랑 엄마가 돌아왔어』」"},
{"id": "clse07:913700", "ko": "「아직도 그 소리야. 그게 최선이라는 거, 유도 알잖아」"},
{"id": "clse07:913800", "ko": "「언니 꼭 기억해야 한다~?」"},
{"id": "clse07:913900", "ko": "「가자, 우키」"},
{"id": "clse07:914000", "ko": "「아직도 그 소리야. 그게 최선이라는 거, 유도 알잖아」"},
{"id": "clse07:914100", "ko": "「언니 꼭 기억해야 한다~?」"},
{"id": "clse07:914200", "ko": "「아하하. 타쿠루 오빠도 참, 지금부터 센리 언니한테 꽉 잡혀 살면 앞으로 큰일이다~」"},
{"id": "clse07:914300", "ko": "「안~녕히 주~무세요~」"},
{"id": "clse07:914400", "ko": "「응~? 뭐어~, 타쿠루 오빠~? 한 번 더 말해 봐?」"},
{"id": "clse07:914500", "ko": "「안 들려~. 애초에 그게 남한테 부탁하는 태도인가~? 적어도 무릎 꿇고 싹싹 빌기 정도는 해 줘야지~」"},
{"id": "clse07:914600", "ko": "「아~, 그래? 그런 말 한다 이거지? 흐응~」"},
{"id": "clse07:914700", "ko": "「꺄아아아, 살려 줘 노노 언니~! 방에 타쿠루 오빠가――!」"},
{"id": "clse07:914800", "ko": "「흥흥, 처음부터 순순히 그렇게 하면 되잖아」"},
{"id": "clse07:914900", "ko": "「타쿠루 오빠~, 비는 자세가 영 엉망이네? 좀 더 이렇게, 머리를 바닥에 문지르는 거야. 이렇게, 꾹꾹꾹 하고」"},
{"id": "clse07:915000", "ko": "「당연히 노노 언니지?」"},
{"id": "clse07:915100", "ko": "「자~? 좀 더 제대로 부탁해 봐! 노노 언니 불러 버린다?」"},
{"id": "clse07:915200", "ko": "「후후후, 어쩔 수 없네. 하긴 타쿠루 오빠는 내가 도와주지 않으면 아무것도 못 하는 한심한 인간이니까~」"},
{"id": "clse07:915300", "ko": "「그렇지? 응? 꾹꾹꾹……」"},
{"id": "clse07:915400", "ko": "「어라~?! 자기가 『밟아 줘』라고 부탁해 놓고 그런 말 하는 거야? 그리고 『유이』가 아니라 『유이 님』이지?」"},
{"id": "clse07:915500", "ko": "「……잠깐, 저기?! 뭐야, 보고 있는 거야?!」"},
{"id": "clse07:915600", "ko": "「말도 안 돼! 타쿠루 오빠, 밑에서 내 팬티 실컷 보고 있잖아! 이 음흉한! 변태!」"},
{"id": "clse07:915700", "ko": "「뭐라고~?」"},
{"id": "clse07:915800", "ko": "「솔직하게 말해! 좋은 거지?!」"},
{"id": "clse07:915900", "ko": "「저기, 노노 언니~?! 여기 수상한 사람이 숨어 있어~?!」"},
{"id": "clse07:916000", "ko": "「무~. 영 진심이 안 느껴지는데!」"},
{"id": "clse07:916100", "ko": "「흥, 뭐, 됐어. 아무튼 지금 타쿠루 오빠는 내 노예라는 걸로 된 거지?」"},
{"id": "clse07:916200", "ko": "「그럼, 명령. 타쿠루 오빠는 오늘부터 내 『개』가 되는 거야」"},
{"id": "clse07:916300", "ko": "「나 있지, 계속 개를 키우고 싶었어. 그런데 아오바 기숙사는 애완동물 금지잖아?」"},
{"id": "clse07:916400", "ko": "「그래도 언젠가 몰래 키워 버려야지 하고 준비해 뒀거든. 우후후」"},
{"id": "clse07:916500", "ko": "「자, 귀여운 멍멍아? 앞으로 쭈~욱 예뻐해 줄게~」"},
{"id": "clse07:916600", "ko": "「얘, 안 되지?! 노노 언니한테 들키기 싫으면 내 명령엔 절대복종이야. 게다가 『멍멍!』이라고만 대답해」"},
{"id": "clse07:916700", "ko": "「자, 타쿠야? 산책 데리고 가 줄게! 준비해야지?」"},
{"id": "clse07:916800", "ko": "「개가 사람 옷을 입고 있으면 이상하잖아? 개는 개답게―― 알몸인 게 당연하잖아」"},
{"id": "clse07:916900", "ko": "「맞다. 모처럼이니까 우키도 산책에 불러 볼까~?」"},
{"id": "clse07:917000", "ko": "「저기~」"},
{"id": "clse07:917100", "ko": "「노노 언니가 오라고 해서 왔는데……」"},
{"id": "clse07:917200", "ko": "「내 거?」"},
{"id": "clse07:917300", "ko": "「아……」"},
{"id": "clse07:917400", "ko": "「그래도, 그건……」"},
{"id": "clse07:917500", "ko": "「…………」"},
{"id": "clse07:917600", "ko": "「으, 응…… 알았어」"},
{"id": "clse07:917700", "ko": "「저, 저기 말야…… 타쿠루 오빠……」"},
{"id": "clse07:917800", "ko": "「그, 그게…… 내…… 으……」"},
{"id": "clse07:917900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:918000", "ko": "「으…… 응……」"},
{"id": "clse07:918100", "ko": "「여, 역시 싫어?」"},
{"id": "clse07:918200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:918300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:918400", "ko": "「그건, 노노 언니가……」"},
{"id": "clse07:918500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:918600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:918700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:918800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:918900", "ko": "「역시……」"},
{"id": "clse07:919000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:919100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:919200", "ko": "「아~, 있다 있다」"},
{"id": "clse07:919300", "ko": "「하여간, 노노 언니. 이런 데 있었냐. 찾았잖아」"},
{"id": "clse07:919400", "ko": "「지금 애들이랑 놀러 갈 거거든, 응?」"}
]
