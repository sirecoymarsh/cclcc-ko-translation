[
{"id": "clse07:724400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:724500", "ko": "「（그 아이는 오빠를 믿고 있는 거예요. 못된 마음을 품어서는 안 됩니다）」"},
{"id": "clse07:724600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:724700", "ko": "「（입 다무세요, 번뇌의 악마 같으니）」"},
{"id": "clse07:724800", "ko": "「（너야말로 착한 척하기는, 이 겁쟁이 천사 놈아）」"},
{"id": "clse07:724900", "ko": "「…………」"},
{"id": "clse07:725000", "ko": "「그, 그렇구나……」"},
{"id": "clse07:725100", "ko": "「……자, 내일도 학교잖아? 빨리 자야지……」"},
{"id": "clse07:725200", "ko": "「（거짓말……? 뭐가?）」"},
{"id": "clse07:725300", "ko": "「…………」"},
{"id": "clse07:725400", "ko": "「늦네, 유이…… 무슨 일이지?」"},
{"id": "clse07:725500", "ko": "「학교에서 같이 나오지 않은 거지?」"},
{"id": "clse07:725600", "ko": "「아까부터 몇 번이나 걸고 있는데 연결이 안 돼」"},
{"id": "clse07:725700", "ko": "「나, 잠깐 찾아보고 올게」"},
{"id": "clse07:725800", "ko": "「일단 여기서 중등부 쪽으로 가 볼게」"},
{"id": "clse07:725900", "ko": "「겐 씨, 미안하지만 지금 여동생을 찾으러 가야 해서」"},
{"id": "clse07:726000", "ko": "「겐 씨! 그거 어디서!? 어디서 봤어!?」"},
{"id": "clse07:726100", "ko": "「겐 씨!!」"},
{"id": "clse07:726200", "ko": "「어른 남자라는 건, 40대 후반쯤에 안경 쓴 사람?」"},
{"id": "clse07:726300", "ko": "「『밀푀유』 스레드 같은 게 있었구나……」"},
{"id": "clse07:726400", "ko": "「이건……」"},
{"id": "clse07:726500", "ko": "「아니…… 아무리 신상이 털렸다고 해도, 바로 그렇게 생각하는 건 너무 성급해」"},
{"id": "clse07:726600", "ko": "「그렇네. 오늘 일을 잊고 어디 놀러 갔을지도 모르고」"},
{"id": "clse07:726700", "ko": "「네……」"},
{"id": "clse07:726800", "ko": "「경찰이 움직여 줄 수는 없나요?」"},
{"id": "clse07:726900", "ko": "「쿠노사토 씨…… 미안하지만 지금 좀 정신이 없어서……」"},
{"id": "clse07:727000", "ko": "「니야생?」"},
{"id": "clse07:727100", "ko": "「잠깐요. 지금 그럴 때가……」"},
{"id": "clse07:727200", "ko": "「――!!」"},
{"id": "clse07:727300", "ko": "「저, 저건 어떻게 된 거예요? 왜 유이가 저런 걸!」"},
{"id": "clse07:727400", "ko": "「방송을 강제 종료시키지 못하게 하라는 거예요」"},
{"id": "clse07:727500", "ko": "「읏……」"},
{"id": "clse07:727600", "ko": "「어?」"},
{"id": "clse07:727700", "ko": "「유토! 유이한테 거기까지 가는 데 얼마나 걸렸는지 물어봐 줘!」"},
{"id": "clse07:727800", "ko": "「왜 그래?」"},
{"id": "clse07:727900", "ko": "「…………」"},
{"id": "clse07:728000", "ko": "「（생각해, 미야시로 타쿠루…… 뭔가…… 뭔가가……）」"},
{"id": "clse07:728100", "ko": "「유이……」"},
{"id": "clse07:728200", "ko": "「젠장! 뭐였더라…… 이 걸리는 느낌은……!」"},
{"id": "clse07:728300", "ko": "「유이 얘기…… 벽에 얼굴이라는 게 아무래도 걸려. 어디서 본 것 같은데…… 오노에는 짚이는 데 없어!?」"},
{"id": "clse07:728400", "ko": "「카즈키! 사진, 있지!?」"},
{"id": "clse07:728500", "ko": "「「（겐 씨 얘기로는 유이를 본 건 학교 근처라고 했어……）」"},
{"id": "clse07:728600", "ko": "「（거기서 15분 안에 갈 수 있는 곳이라면……）」"},
{"id": "clse07:728700", "ko": "「유이 말로는 방에 크고 둥근 침대가 있다고 했어）」"},
{"id": "clse07:728800", "ko": "「（그리고 벽에 떠오른 얼굴……）」"},
{"id": "clse07:728900", "ko": "「（이 중에서 그 얘기와 일치하는 건……）」"},
{"id": "clse07:729000", "ko": "「（이거다!）」"},
{"id": "clse07:729100", "ko": "「（……아니, 틀렸어. 이거로는 유토 얘기랑 맞지 않아）」"},
{"id": "clse07:729200", "ko": "「（다시 한번 생각해）」"},
{"id": "clse07:729300", "ko": "「틀림없어! 여기다!」"},
{"id": "clse07:729400", "ko": "「이 스티커는 딱 3층쯤에 붙어 있어요. 그러니까 창문으로 이 스티커가 보이는 방에 유이가 있을 거예요!!」"},
{"id": "clse07:729500", "ko": "「신조 씨……」"},
{"id": "clse07:729600", "ko": "「…………」"},
{"id": "clse07:729700", "ko": "「읏……!」"},
{"id": "clse07:729800", "ko": "「（읏…… 움직여――!）」"},
{"id": "clse07:729900", "ko": "「신조 씨!」"},
{"id": "clse07:730000", "ko": "「유이!!」"},
{"id": "clse07:730100", "ko": "「괜찮아. 이제 괜찮으니까……!」"},
{"id": "clse07:730200", "ko": "「유이……」"},
{"id": "clse07:730300", "ko": "「우왓」"},
{"id": "clse07:730400", "ko": "「（아…… 그거 내 역할이었는데……）」"},
{"id": "clse07:730500", "ko": "「（아니, 아리무라, 너는 상관없잖아…）」"},
{"id": "clse07:730600", "ko": "「응?」"},
{"id": "clse07:730700", "ko": "「그, 그럼 우리도 갈까!」"},
{"id": "clse07:730800", "ko": "「왜 그래? 안 가?」"},
{"id": "clse07:730900", "ko": "「참아?」"},
{"id": "clse07:731000", "ko": "「기, 기다려 줘, 유이! 확실히 이번 일은 내 부주의였지만 나도 구하려고――」"},
{"id": "clse07:731100", "ko": "「유, 유이!?」"},
{"id": "clse07:731200", "ko": "「윽…… 미, 미안……!」"},
{"id": "clse07:731300", "ko": "「미안……」"},
{"id": "clse07:731400", "ko": "「그러니까 미안하다니까」"},
{"id": "clse07:731500", "ko": "「어?」"},
{"id": "clse07:731600", "ko": "「어? 방금 뭐라고……?」"},
{"id": "clse07:731700", "ko": "「…………」"},
{"id": "clse07:731800", "ko": "「……정말 그만둘 거야?」"},
{"id": "clse07:731900", "ko": "「유토도…… 그걸로 괜찮아?」"},
{"id": "clse07:732000", "ko": "「그래…… 알았어. 그럼 나머지는 내가 책임지고 어떻게든 해 둘게」"},
{"id": "clse07:732100", "ko": "「괜찮고 뭐고, 원래 유이네가 하고 싶어서 시작한 거잖아? 두 사람이 정했다면 내가 이러쿵저러쿵할 일이 아니야」"},
{"id": "clse07:732200", "ko": "「아니……」"},
{"id": "clse07:732300", "ko": "「유이……」"},
{"id": "clse07:732400", "ko": "「미안해. 꿈을 이뤄 주지 못해서……」"},
{"id": "clse07:732500", "ko": "「알게 된 거라니?」"},
{"id": "clse07:732600", "ko": "「그래…… 말했지」"},
{"id": "clse07:732700", "ko": "「뭐, 뭐어, 그렇게 되는…… 거지」"},
{"id": "clse07:732800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:732900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:733000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:733100", "ko": "「……왜?」"},
{"id": "clse07:733200", "ko": "「알았어……」"},
{"id": "clse07:733300", "ko": "「어?」"},
{"id": "clse07:733400", "ko": "「…………」"},
{"id": "clse07:733500", "ko": "「저, 저기, 좀 너무 붙어 있는 거 아냐?」"},
{"id": "clse07:733600", "ko": "「그런데 말이야, 정말 괜찮았어? 그만둬 버려서」"},
{"id": "clse07:733700", "ko": "「그런 건 아니지만…… 꿈이었던 거 아닌가 싶어서」"},
{"id": "clse07:733800", "ko": "「다른 꿈?」"},
{"id": "clse07:733900", "ko": "「저기, 그 꿈이라는 게 어떤――」"},
{"id": "clse07:734000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:734100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:734200", "ko": "「헤, 헤에…… 유이도 저런 걸 동경하는구나」"},
{"id": "clse07:734300", "ko": "", "note": "보류 — 연애 묘사"}
]
