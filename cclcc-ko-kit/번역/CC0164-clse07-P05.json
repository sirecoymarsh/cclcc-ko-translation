[
{"id": "clse07:39800", "ko": "「읏……」"},
{"id": "clse07:39900", "ko": "「……그렇게 여유 부릴 수 있는 것도 지금뿐이니까요. 안녕히 주무세요!」"},
{"id": "clse07:40000", "ko": "「으응……」"},
{"id": "clse07:40100", "ko": "「미야시로…… 선배……」"},
{"id": "clse07:40200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:40300", "ko": "「쿨~, 쿨~……」"},
{"id": "clse07:40400", "ko": "「쳇――」"},
{"id": "clse07:40500", "ko": "「미야~시로~선배~!」"},
{"id": "clse07:40600", "ko": "「어라~? 가방 같은 걸 들고 어디 가려는 거예요~?」"},
{"id": "clse07:40700", "ko": "「점심 만들었어요♪ 같이 먹어요!」"},
{"id": "clse07:40800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:40900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:41000", "ko": "「무슨 소리를 하는 거예요, 인기 없는 선배! 실례네요!」"},
{"id": "clse07:41100", "ko": "「으아아아!! 쿠루스 선배! 그건 말하면 안 되는 거예요~!!」"},
{"id": "clse07:41200", "ko": "「아, 아니거든요! 따, 딱히 미야시로 선배를 위해서 배운 게 아님다!」"},
{"id": "clse07:41300", "ko": "「에? 아, 그, 그렇구나……」"},
{"id": "clse07:41400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:41500", "ko": "「으그그그그~!」"},
{"id": "clse07:41600", "ko": "「도망치지 말고 꼭 돌아오세요」"},
{"id": "clse07:41700", "ko": "「아, 어서 오세요~!」"},
{"id": "clse07:41800", "ko": "「옳지 옳지, 도망치지 않고 돌아오다니 기특해 기특해」"},
{"id": "clse07:41900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42000", "ko": "「응~? 미야시로 선배, 왜 그러심까~?」"},
{"id": "clse07:42100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:42900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:43000", "ko": "「그런 고로오, 곧 밥이니까 기다려 주세요」"},
{"id": "clse07:43100", "ko": "「~~~~♪」"},
{"id": "clse07:43200", "ko": "「흐흥~」"},
{"id": "clse07:43300", "ko": "「네~, 다 됐어요~」"},
{"id": "clse07:43400", "ko": "「우훗♪」"},
{"id": "clse07:43500", "ko": "「왜 그래요? 혹시 기브 업이에요?」"},
{"id": "clse07:43600", "ko": "「네?」"},
{"id": "clse07:43700", "ko": "「……그, 그런 말로 얼버무려도 소용없슴다」"},
{"id": "clse07:43800", "ko": "「흐~응, 그래요. 그래도 저는 이대로도…… 엣취!」"},
{"id": "clse07:43900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:44000", "ko": "「우……」"},
{"id": "clse07:44100", "ko": "「타임 타임! 역시 됐어요! 알겠어요. 오늘은 얌전히 옷 입을게요……」"},
{"id": "clse07:44200", "ko": "「앗! 큰일이다. 그러고 보니 한 가지 더 데우고 있었지!」"},
{"id": "clse07:44300", "ko": "「네~ 네~, 테이블 좀 비워 주세――우왓!」"},
{"id": "clse07:44400", "ko": "「히얏!」"},
{"id": "clse07:44500", "ko": "「읏……!?」"},
{"id": "clse07:44600", "ko": "「시……」"},
{"id": "clse07:44700", "ko": "「싫어어어어어어어어어어어어엇!」"},
{"id": "clse07:44800", "ko": "「아, 아무튼 놓아 주세요!!」"},
{"id": "clse07:44900", "ko": "「아, 잠깐!!」"},
{"id": "clse07:45000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:45100", "ko": "「지, 진정할 수 있을 리가 없잖아요!」"},
{"id": "clse07:45200", "ko": "「서, 선배. 이 냄비 내던져도 돼요?」"},
{"id": "clse07:45300", "ko": "「앗!」"},
{"id": "clse07:45400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:45500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:45600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:45700", "ko": "「그런 건 됐으니까 빨리 눈 감아 주세요!」"},
{"id": "clse07:45800", "ko": "「정말이에요?」"},
{"id": "clse07:45900", "ko": "「읏…… 눈 뜨면 안 돼요!」"},
{"id": "clse07:46000", "ko": "「꺅!!!」"},
{"id": "clse07:46100", "ko": "「자, 잠깐 선배! 이상한 장난은 그만둬요!」"},
{"id": "clse07:46200", "ko": "「캄, 캄캄해서 아무것도 안 보이는데요!!!」"},
{"id": "clse07:46300", "ko": "「그, 그런 말 해도…… 앗!」"},
{"id": "clse07:46400", "ko": "「히야아아아앗!!」"},
{"id": "clse07:46500", "ko": "「아야……」"},
{"id": "clse07:46600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:46700", "ko": "「아……」"},
{"id": "clse07:46800", "ko": "「아, 아무것도 안 보이…… 네요」"},
{"id": "clse07:46900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:47000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:47100", "ko": "「왜, 왜 그래요?」"},
{"id": "clse07:47200", "ko": "「정말이에요?」"},
{"id": "clse07:47300", "ko": "「아, 기다려 주세요!」"},
{"id": "clse07:47400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:47500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:47600", "ko": "「…………」"},
{"id": "clse07:47700", "ko": "「…………」"},
{"id": "clse07:47800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:47900", "ko": "「아……」"},
{"id": "clse07:48000", "ko": "「읏…………」"},
{"id": "clse07:48100", "ko": "「스톱~!!」"},
{"id": "clse07:48200", "ko": "「아까의 일련의 사건은 기르던 개한테 물린 셈 치고 잊어버려요」"},
{"id": "clse07:48300", "ko": "「조, 좋아. 그럼 밥 먹을까요」"},
{"id": "clse07:48400", "ko": "「히, 히나에가 솜씨를 발휘해서 만든 밥, 제대로 음미하면서 드세요~」"},
{"id": "clse07:48500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:48600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:48700", "ko": "「아아, 이거요? 요가예요」"},
{"id": "clse07:48800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:48900", "ko": "「힐끔」"},
{"id": "clse07:49000", "ko": "「맞다. 선배도 해 보면 어떰까, 요가」"},
{"id": "clse07:49100", "ko": "「즉답이냐!」"},
{"id": "clse07:49200", "ko": "「그렇지 않슴다. 다른 장점도 잔뜩 있으니까요」"},
{"id": "clse07:49300", "ko": "「그건…… 그러니까…… 음……」"},
{"id": "clse07:49400", "ko": "「맞아 맞아! 불을 뿜거나 팔다리가 늘어나게 되거나!」"},
{"id": "clse07:49500", "ko": "「뭐, 그래도 확실히 미야시로 선배는 딱 봐도 건강하지 않아 보이네요. 쉬는 날에 어디 놀러 가거나 안 함까?」"},
{"id": "clse07:49600", "ko": "「어이가 없어서 그렇슴다!」"},
{"id": "clse07:49700", "ko": "「하아~ 한심하네. 한창때인 젊은이가 그런 소리를 하다니. 정말이지 일본의 장래가 걱정된다니까」"}
]
