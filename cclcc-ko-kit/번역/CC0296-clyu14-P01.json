[
{"id": "clyu14:0", "ko": "「……『⟦col:280aa02d1400⟧밀푀유⟦col:800000⟧』?」"},
{"id": "clyu14:100", "ko": "「……흥, 아이돌은 무슨……」"},
{"id": "clyu14:200", "ko": "「별로 귀엽지도 않고, 노래도 엉망이잖아」"},
{"id": "clyu14:300", "ko": "「젠장! 이딴 걸로 랭킹 상위에 들어가다니, 말이 되냐고!」"},
{"id": "clyu14:400", "ko": "「이럴 거면 내가 훨씬 재밌다고!」"},
{"id": "clyu14:500", "ko": "「쳇! 좋겠다, 여자는. 좀 아슬아슬한 영상만 올리면 떠받들어 주고」"},
{"id": "clyu14:600", "ko": "「아~, 왠지 열받네! 젠장! 젠장! 젠장! 젠장! 젠장!」"},
{"id": "clyu14:700", "ko": "「이럴 거면 내가…… 내가…… 내가……」"}
