[
{"id": "clse01:17500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:17600", "ko": "「그러니까! 너 오해하고 있어. 그런 책을 『좋다』고 생각한 적은 한 번도 없거든!」"},
{"id": "clse01:17700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:17800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:17900", "ko": "「니즈?」"},
{"id": "clse01:18000", "ko": "세리카는 정말로 모르는 건지 아니면 모르는 척하는 것뿐인지, 『흐으음』 하고 신음하며 내 얼굴을 보았다."},
{"id": "clse01:18100", "ko": "큰일이다! 이번에야말로 확실히 사고 도촬이 온다!"},
{"id": "clse01:18200", "ko": "지금 머릿속에 이상한 장면 같은 걸 떠올리면 절대로 곤란하다!"},
{"id": "clse01:18300", "ko": "（으그그……）"},
{"id": "clse01:18400", "ko": "참아라! 평정심이다, 평정심!"},
{"id": "clse01:18500", "ko": "무엇보다 나는 자신의 본능조차 억누를 수 있는 강인한 정신의 소유자니까."},
{"id": "clse01:18600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:18700", "ko": "「…………」"},
{"id": "clse01:18800", "ko": "아니 그보다, 오노에! 너 말이야!"},
{"id": "clse01:18900", "ko": "적당히 좀 하고 사고 도촬 그만둬!"},
{"id": "clse01:19000", "ko": "「있잖아, 타쿠. 잠깐 와 봐」"},
{"id": "clse01:19100", "ko": "「어? 뭐, 뭔데?」"},
{"id": "clse01:19200", "ko": "나는 갑자기 오노에에게 손을 붙잡혀 트레일러 하우스 안으로 끌려 들어갔다."},
{"id": "clse01:19300", "ko": "「그렇구나. 역시 그런 거구나. 알아 버렸어」"},
{"id": "clse01:19400", "ko": "「뭐, 뭐가?」"},
{"id": "clse01:19500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:19600", "ko": "「으아하아앗!?」"},
{"id": "clse01:19700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:19800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:19900", "ko": "（잠깐, 우와아아~~）"},
{"id": "clse01:20000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:20100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:20200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:20300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:20400", "ko": "「………」"},
{"id": "clse01:20500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:20600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:20700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:20800", "ko": "「아, 아니, 잠깐 오노에! 너 뭔가 엄청난 착각을 하고 있다고!」"},
{"id": "clse01:20900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:21000", "ko": "「그, 그러니까, 그, 그만하라니까!」"},
{"id": "clse01:21100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:21200", "ko": "「………」"},
{"id": "clse01:21300", "ko": "「자, 자 오노에! 이제 충분하니까! 얼른 옷 똑바로 입어, 응!?」"},
{"id": "clse01:21400", "ko": "그런데 그녀는 거기서 터무니없는 말을 꺼냈다."},
{"id": "clse01:21500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:21600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:21700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:21800", "ko": "「…………」"},
{"id": "clse01:21900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:22700", "ko": "（어!? 갑자기 전화!? 누구랑 통화하려는 거야, 오노에!?）"},
{"id": "clse01:22800", "ko": "「아, 여보세요, 노노? 잠깐 물어봐도 될까~?」"},
{"id": "clse01:22900", "ko": "「우와아아, 그만해 바보야! 너, 쿠루스한테 뭘 물어볼 생각이야!」"},
{"id": "clse01:23000", "ko": "하지만 오노에의 스마트폰을 빼앗으려던 나를 향해 수화기 너머로 도깨비가 으르렁거리는 듯한 목소리가 들려왔다."},
{"id": "clse01:23100", "ko": "「잠깐, 타쿠루. 시끄러워서 세리카 목소리가 안 들려. 조용히 해 줄래?」"},
{"id": "clse01:23200", "ko": "「아니, 하지만 말이지!」"},
{"id": "clse01:23300", "ko": "「뭔가 남이 들으면 곤란한 얘기라도 있는 거야?」"},
{"id": "clse01:23400", "ko": "우와아아~!!"},
{"id": "clse01:23500", "ko": "이제 틀렸다. 모든 게 끝났다."},
{"id": "clse01:23600", "ko": "게다가 오노에 녀석, 하필이면 방금 나한테 했던 것과 똑같은 질문을 쿠루스한테 하기 시작한 것이다."},
{"id": "clse01:23700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:23800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:23900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:24000", "ko": "너, 너, 너…… 아무리 그래도 너무 직설적이잖아?"},
{"id": "clse01:24100", "ko": "내 이마에서 뚝뚝 떨어지는 이 엄청난 땀은 결코 더워서 그런 게 아니다."},
{"id": "clse01:24200", "ko": "애초에 땀을 잔뜩 흘릴 계절도 아니고."},
{"id": "clse01:24300", "ko": "（지, 지금부터 도망칠 수 있다면 어디지?）"},
{"id": "clse01:24400", "ko": "（이토네 집 같은 건 10초도 안 돼서 들킨다. 그렇다고 아리무라나 카즈키가 나를 숨겨 줄 리도 없고……）"},
{"id": "clse01:24500", "ko": "（그래! 여기선 확실하게 허를 찔러서 아오바 기숙사다! 유토 방 벽장에 일주일 정도 숨어 있으면!）"},
{"id": "clse01:24600", "ko": "（아니, 잠깐! 무리다! 그 녀석 방은 유이랑 같이 쓰잖아! 단번에 들킨다!）"},
{"id": "clse01:24700", "ko": "（크으윽. 이렇게 된 이상…… 유이한테도 고개를 숙일까!?）"},
{"id": "clse01:24800", "ko": "그 녀석이라면 쿠루스보다는 나한테 무르고, 교환 조건에 따라서는 어떻게든 될지도 모른다."},
{"id": "clse01:24900", "ko": "나는 오노에와 쿠루스의 통화가 끝나기 전에 도망쳐 나와 아오바 기숙사로 달렸다."},
{"id": "clse01:25000", "ko": "「에~? 뭐어, 타쿠루 오빠? 다시 한번 말해 봐?」"},
{"id": "clse01:25100", "ko": "「아니, 너! 방금 거 들었잖아!?」"},
{"id": "clse01:25200", "ko": "「안 들려~. 애초에 그게 남한테 부탁하는 태도야? 적어도 무릎 꿇고 엎드려 비는 정도는 해 줘야지~」"},
{"id": "clse01:25300", "ko": "「큭. 우쭐대기는……」"},
{"id": "clse01:25400", "ko": "이 녀석, 언제 이렇게 건방져진 거지……?"},
{"id": "clse01:25500", "ko": "「아~ 그래? 그런 말 하는구나? 흐으응~」"},
{"id": "clse01:25600", "ko": "「꺄아아악, 살려 줘, 노노 언니~! 방에 타쿠루 오빠가――!」"},
{"id": "clse01:25700", "ko": "「으악, 거짓말입니다 농담입니다!」"},
{"id": "clse01:25800", "ko": "나는 곧바로 여동생에게 굴욕적으로 무릎 꿇고 엎드려 비는 처지가 되었다."}
]
