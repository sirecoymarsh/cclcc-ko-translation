[
{"id": "clse07:368100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368700", "ko": "「타쿠루……」"},
{"id": "clse07:368800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368900", "ko": "「있잖아, 타쿠루……」"},
{"id": "clse07:369000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:369100", "ko": "「누구든 남이 멋대로 마음을 읽으면 싫잖아? 세리카가 그런 능력을 갖고 있다는 걸 알면 반 애들 누구도 친구가 되려고 하지 않을 거고…… 그런 건 쓸쓸할 것 같아」"},
{"id": "clse07:369200", "ko": "「그래서 말했어. 웬만한 경우가 아니면 사고 도촬은 그만두라고」", "note": "새 용어: 思考盗撮 → 사고 도촬"},
{"id": "clse07:369300", "ko": "「……있잖아, 둘 다? 뭔가 다 들리거든요?」"},
{"id": "clse07:369400", "ko": "「타쿠루, 세리카? 그런 건 너무 생각하면 오히려 안 되는 법이야. 언젠가 자연스럽게, 응?」"},
{"id": "clse07:369500", "ko": "「그래서 타쿠루는 어떻게 할 거야? 뭐 기사 쓸 수 있겠어?」"},
{"id": "clse07:369600", "ko": "「그러니까 아직 아무것도 생각 안 났다는 거네. 곤란하네」"},
{"id": "clse07:369700", "ko": "「나는 사고 도촬 같은 거 못 합니다. 타쿠루가 뻔할 뿐이야」"},
{"id": "clse07:369800", "ko": "「그건 좋은데, 무리하면 안 돼?」"},
{"id": "clse07:369900", "ko": "「……… 그래?」"},
{"id": "clse07:370000", "ko": "「……그러네. 뭐, 겐 씨나 겐 씨 친구들이라면 괜찮으려나」"},
{"id": "clse07:370100", "ko": "「다만 시부야 부흥을 핑계로 나쁜 짓을 하는 사람들도 있다고 하니까, 그것만은 조심해」"},
{"id": "clse07:370200", "ko": "「잠깐 타쿠루. 시끄러워서 세리카 목소리가 안 들려. 좀 조용히 해 줄래?」"},
{"id": "clse07:370300", "ko": "「뭔가 들으면 곤란한 얘기라도 있는 걸까?」"},
{"id": "clse07:370400", "ko": "「응? 세리카, 먼저 가 버렸어?」"},
{"id": "clse07:370500", "ko": "「아직 우리도 확실히 들은 건 아니지만…… 아마 그런 거라고 생각해」"},
{"id": "clse07:370600", "ko": "「본인도 아직 확신이 없는 거야. 그래서 우선 나랑 아리무라한테 몰래 털어놓아 보고――」"},
{"id": "clse07:370700", "ko": "「응, 다들? 조금만 기다려 주자. 응? 아마 세리카는 처음 겪는 일이라서 누구한테 어떻게 상담하면 좋을지 모르는 거야」"},
{"id": "clse07:370800", "ko": "「나는, 봐, 그 애 언니 같은 존재고…… 아리무라는, 음……」"},
{"id": "clse07:370900", "ko": "「아, 저기 있잖아? 그런 심한 생각 안 했어, 나?」"},
{"id": "clse07:371000", "ko": "「안 돼, 아리무라. 재촉하면 아무 말도 못 하게 돼. ……괜찮아, 천천히 해, 세리카」"},
{"id": "clse07:371100", "ko": "「사고 도촬?」"},
{"id": "clse07:371200", "ko": "「타쿠루만?」"},
{"id": "clse07:371300", "ko": "「……?」"},
{"id": "clse07:371400", "ko": "「알았어. 그 일은 내일 다 같이 사과하자. 나도 같이 사과해 줄게」"},
{"id": "clse07:371500", "ko": "「그래서, 능력 결과는 어땠어?」"},
{"id": "clse07:371600", "ko": "「타, 타쿠루!?」"},
{"id": "clse07:371700", "ko": "「아리무라, 이제 됐으니까! 세리카를 부탁해!」"},
{"id": "clse07:371800", "ko": "「……타쿠루? 언제까지 멀뚱히 서 있지 말고 앉아」"},
{"id": "clse07:371900", "ko": "「언젠가 이런 때가 올 거라고 생각은 했는데…… 세리카 쪽이 조금 더 빨랐나 봐」"},
{"id": "clse07:372000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:372100", "ko": "「그러니까 세리카가 걱정되는 건 알지만…… 이번 같은 일은 그만둬 줘? 딱히 진짜 병 같은 건 아니니까, 분명 괜찮아」"},
{"id": "clse07:372200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:372300", "ko": "「어라? 몰라? ……그, 그렇구나, 나 역시 좀 할머니 취향인가. 충격이야……」"},
{"id": "clse07:372400", "ko": "「슬슬 돌아갈까」"},
{"id": "clse07:372500", "ko": "「아마 그런데…… 지금 타쿠루 얼굴을 보면 도망칠 것 같아. 좀 진정될 때까지 기다려 주지 않으면 또 울어 버릴지도 모르고」"},
{"id": "clse07:372600", "ko": "「괜찮아. 오늘은 아리무라한테 맡기는 게 제일 잘 해결될 거야. 동급생끼리가 얘기하기 편할 테니까」"},
{"id": "clse07:372700", "ko": "「그 대신 세리카가 기운을 되찾으면 이유 같은 건 일절 묻지 말고 먼저 제대로 사과하는 거야, 알았지?」"},
{"id": "clse07:372800", "ko": "「정말, 타쿠루는 가끔 눈치가 없어서―― 물어보면 안 되는 거나 말하면 안 되는 걸 입에 담으니까, 누나는 걱정입니다」"},
{"id": "clse07:372900", "ko": "「자, 가자」"},
{"id": "clse07:373000", "ko": "「타쿠루! 부탁이야! 대답해!」"},
{"id": "clse07:373100", "ko": "「……!? 타쿠루! 세리카!」"},
{"id": "clse07:373200", "ko": "「기각입니다」"},
{"id": "clse07:373300", "ko": "「늘 미안해, 우키」"},
{"id": "clse07:373400", "ko": "「있잖아, 우키는 지금 뭐 관심 있는 거 없어?」"},
{"id": "clse07:373500", "ko": "「응. 이런 기사를 읽고 싶다든가, 이런 특집이 있으면 재밌겠다든가」"},
{"id": "clse07:373600", "ko": "「…………」"},
{"id": "clse07:373700", "ko": "「…………」"},
{"id": "clse07:373800", "ko": "「…………!」"},
{"id": "clse07:373900", "ko": "「말을 해도 좀 가려서 해야지」"},
{"id": "clse07:374000", "ko": "「이 토」"},
{"id": "clse07:374100", "ko": "「뭐…… 우키가 그걸로 괜찮다면 됐지만」"},
{"id": "clse07:374200", "ko": "「타쿠루. 미안한데, 이따가 잠깐 괜찮을까?」"},
{"id": "clse07:374300", "ko": "「미안해, 세리카. 타쿠루 좀 빌릴게」"},
{"id": "clse07:374400", "ko": "「할 얘기가 있어…… 부탁이야」"},
{"id": "clse07:374500", "ko": "「실은 유이 일인데……」"},
{"id": "clse07:374600", "ko": "「왜 그래?」"},
{"id": "clse07:374700", "ko": "「우키의? 왜?」"},
{"id": "clse07:374800", "ko": "「……그러게…… 그래도 그건 그거대로 우키가 하고 싶어서 하는 거니까……」"},
{"id": "clse07:374900", "ko": "「마침 잘 왔다. 지금 네 얘기를 하고 있었어, 유이」"},
{"id": "clse07:375000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:375100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:375200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:375300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:375400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:375500", "ko": "「어디 가?」"},
{"id": "clse07:375600", "ko": "「할 얘기가 있으니까 여기 남아 있으라고 한 거, 들었지?」"},
{"id": "clse07:375700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:375800", "ko": "「그 나이에 쿵후 놀이? 정말, 남자애들은 언제까지고 애라니까」"},
{"id": "clse07:375900", "ko": "「유이……」"},
{"id": "clse07:376000", "ko": "「요, 용돈은 저번에 줬잖아?」"},
{"id": "clse07:376100", "ko": "「어?」"},
{"id": "clse07:376200", "ko": "「아, 안 돼. 남은 건 우리 생활비란 말이야……」"},
{"id": "clse07:376300", "ko": "「제, 제발 그만해, 유이…… 너 이런 짓 할 애가 아니었잖아?」"},
{"id": "clse07:376400", "ko": "「그, 그만…… 해…… 유이……」"},
{"id": "clse07:376500", "ko": "「그만해! 유이…… 더는 그만해……」"},
{"id": "clse07:376600", "ko": "「으…… 흐윽…… 흐으윽……」"},
{"id": "clse07:376700", "ko": "「타쿠루? 왜 그래?」"},
{"id": "clse07:376800", "ko": "「아, 우키도 먼저 돌아가 줄래?」"},
{"id": "clse07:376900", "ko": "「미안해. 부탁해」"},
{"id": "clse07:377000", "ko": "「있잖아…… 유이 고민 상담 좀 해 줬으면 해」"},
{"id": "clse07:377100", "ko": "「응. 그 애, 요즘 여러 가지로 고민이 있는 것 같아서……」"},
{"id": "clse07:377200", "ko": "「왜, 타쿠루가 나가기 전에는 아빠 일을 돕기도 했던 거 알지?」"}
]
