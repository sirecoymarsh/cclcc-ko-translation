[
{"id": "clse07:754400", "ko": "「어?」"},
{"id": "clse07:754500", "ko": "「그, 그래? 그럼 다음에 할게……」"},
{"id": "clse07:754600", "ko": "「아까 얘기하고 있었거든~. 혹시 타쿠랑 싸우기라도――」"},
{"id": "clse07:754700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:754800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:754900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:755000", "ko": "「응? 아까부터 있었는데?」"},
{"id": "clse07:755100", "ko": "「그보다 타쿠. 그게 뭐야?」"},
{"id": "clse07:755200", "ko": "「연극? 타쿠가 나와?」"},
{"id": "clse07:755300", "ko": "「그럼 왜 그런 걸 읽고 있어?」"},
{"id": "clse07:755400", "ko": "「그건?」"},
{"id": "clse07:755500", "ko": "「응? 이제 안 읽어도 돼?」"},
{"id": "clse07:755600", "ko": "「흐응……」"},
{"id": "clse07:755700", "ko": "「아, 찾았다, 타쿠!!」"},
{"id": "clse07:755800", "ko": "「타쿠랑 히나가 같이 산다는 소문이야」"},
{"id": "clse07:755900", "ko": "「뭐, 타쿠니까~」"},
{"id": "clse07:756000", "ko": "「그치만 타쿠랑 히나라니……」"},
{"id": "clse07:756100", "ko": "「어라, 타쿠. 등에 뭔가 붙어 있어?」"},
{"id": "clse07:756200", "ko": "「이게 뭐야? 『쿠루스 선배랑 떼어 놓고 싶으면――』」"},
{"id": "clse07:756300", "ko": "「???」"},
{"id": "clse07:756400", "ko": "「히나는 한번 말을 꺼내면 안 듣잖아~」"},
{"id": "clse07:756500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:756600", "ko": "「응? 아니야?」"},
{"id": "clse07:756700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:756800", "ko": "「그렇구나. 그럼 오늘은 하나네서 샤워했구나」"},
{"id": "clse07:756900", "ko": "「그런데 하나네 기숙사도 요즘 엄격하지 않았어?」"},
{"id": "clse07:757000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:757100", "ko": "「저기요~. 자몽 주스 주세요~」"},
{"id": "clse07:757200", "ko": "「응? 뭐가?」"},
{"id": "clse07:757300", "ko": "「으~???」"},
{"id": "clse07:757400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:757500", "ko": "「어라, 타쿠?」"},
{"id": "clse07:757600", "ko": "「뭐야 뭐야, 나한테 무슨 볼일이라도 있어~?」"},
{"id": "clse07:757700", "ko": "「뭐야~, 내가 아니라 히나한테 볼일이구나……」"},
{"id": "clse07:757800", "ko": "「어라? 그런데 오늘 히나 결석 아니었나?」"},
{"id": "clse07:757900", "ko": "「응? 타쿠, 히나랑 같이 있었던 거 아니야?」"},
{"id": "clse07:758000", "ko": "「그렇구나……」"},
{"id": "clse07:758100", "ko": "「으, 응……」"},
{"id": "clse07:758200", "ko": "「교실에는 없는 것 같네~. 어디 가 버렸으려나~」"},
{"id": "clse07:758300", "ko": "「오케이」"},
{"id": "clse07:758400", "ko": "「그래도 히나도 언제까지 그렇게 피해 다닐 생각인 걸까~」"},
{"id": "clse07:758500", "ko": "「어쩌면 전학 같은 걸 갈 생각일지도……」"},
{"id": "clse07:758600", "ko": "「그보다 타쿠. 여기는……」"},
{"id": "clse07:758700", "ko": "「타쿠? 다행이다, 겨우 연결됐어!」"},
{"id": "clse07:758800", "ko": "「방금 막 거기서 나와서 지금은 역으로 가고 있어. 지금이라면 아직 따라잡을 수 있어」"},
{"id": "clse07:758900", "ko": "「……타쿠」"},
{"id": "clse07:759000", "ko": "「힘내!!」"},
{"id": "clse07:759100", "ko": "「그게, 타쿠랑 히나가……」"},
{"id": "clse07:759200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:759300", "ko": "「응? 뭐야, 왜 그래 하나?」"},
{"id": "clse07:759400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:759500", "ko": "「어디어디? 좀 더 잘 보여 줘?」"},
{"id": "clse07:759600", "ko": "「에~, 왜~. 모처럼인데 보여 줘도 되잖아」"},
{"id": "clse07:759700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:759800", "ko": "「아, 타쿠! 야호~!」"},
{"id": "clse07:759900", "ko": "「에~? 오늘은 종례 끝나면 체육관에 집합이라고 타쿠가 말했잖아~」"},
{"id": "clse07:760000", "ko": "「여자 농구부 활동을 촬영하는데 연습 전 5분밖에 시간을 못 받았다고 분해하면서 말했잖아」"},
{"id": "clse07:760100", "ko": "「어? 어젯밤에 타쿠 캠핑카에서인데?」"},
{"id": "clse07:760200", "ko": "「어? 어젯밤에 타쿠 방에서인데?」"},
{"id": "clse07:760300", "ko": "「…………」"},
{"id": "clse07:760400", "ko": "「아하하하하!」"},
{"id": "clse07:760500", "ko": "「아하하! 타쿠도 참, 잊어버렸다니!」"},
{"id": "clse07:760600", "ko": "「타쿠~!? 여자애를 괴롭히면 안 되는 거야!?」"},
{"id": "clse07:760700", "ko": "「타쿠~!!」"},
{"id": "clse07:760800", "ko": "「아, 그렇구나」"},
{"id": "clse07:760900", "ko": "「얼굴 새빨개져서 연설했었지~」"},
{"id": "clse07:761000", "ko": "「그랬더니 처음엔 기운차게 떠들던 타쿠가 점점 말수가 줄더니, 마지막엔 눈을 감고 입을 다물어 버려서」"},
{"id": "clse07:761100", "ko": "「잠들었나 싶었는데――」"},
{"id": "clse07:761200", "ko": "「응」"},
{"id": "clse07:761300", "ko": "「타쿠 걱정됐지만, 혼자 두는 건 아니니까」"},
{"id": "clse07:761400", "ko": "「타쿠, 무슨 소리야?」"},
{"id": "clse07:761500", "ko": "「하나는 베이스캠프에서 후방 지원을 해 줬어」"},
{"id": "clse07:761600", "ko": "「아, 그럼 나도――」"},
{"id": "clse07:761700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:761800", "ko": "「타쿠, 실망이야」"},
{"id": "clse07:761900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:762000", "ko": "「뭐어~? 히나」"},
{"id": "clse07:762100", "ko": "「그래? 타쿠」"},
{"id": "clse07:762200", "ko": "「『정보 강자인 내가 이런 것에 현혹될까 보냐』 같은 소리 할 것 같은데~」"},
{"id": "clse07:762300", "ko": "「그래도 그런 타쿠가 믿었으니까 뭔가 이유가 있는 거지?」"},
{"id": "clse07:762400", "ko": "「타쿠, 오늘 아침부터 뭔가 이상했고, 무슨 일 있었던 거 아니야?」"},
{"id": "clse07:762500", "ko": "「타쿠?」"},
{"id": "clse07:762600", "ko": "「아니야~. 노노야?」"},
{"id": "clse07:762700", "ko": "「하나?」"},
{"id": "clse07:762800", "ko": "「하나? 너, 하나 맞아?」"},
{"id": "clse07:762900", "ko": "「뭔가 평소랑 좀 다른데……」"},
{"id": "clse07:763000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:763100", "ko": "「청춘을 만끽한다니, 뭘 하는데」"},
{"id": "clse07:763200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:763300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:763400", "ko": "「꺄앗!?」"},
{"id": "clse07:763500", "ko": "「하나, 무슨 얘기 했어?」"},
{"id": "clse07:763600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:763700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:763800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:763900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:764000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:764100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:764200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:764300", "ko": "", "note": "보류 — 연애 묘사"}
]
