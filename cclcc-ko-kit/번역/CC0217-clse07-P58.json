[
{"id": "clse07:557300", "ko": "「뭐어!?」"},
{"id": "clse07:557400", "ko": "「뭐! 엥!? 뭐어!!??」"},
{"id": "clse07:557500", "ko": "「그, 그렇게 말해도!?」"},
{"id": "clse07:557600", "ko": "「카……즈키……」"},
{"id": "clse07:557700", "ko": "「카, 카즈키……」"},
{"id": "clse07:557800", "ko": "「……어? 다, 다들?」"},
{"id": "clse07:557900", "ko": "「너, 너희!? 어어어어, 언제부터 거기에!?」"},
{"id": "clse07:558000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:558100", "ko": "「여, 여긴!? 교회야!?」"},
{"id": "clse07:558200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:558300", "ko": "「아니, 잠깐만 기다려 줘!」"},
{"id": "clse07:558400", "ko": "「……뭐」"},
{"id": "clse07:558500", "ko": "「뭐라고!?」"},
{"id": "clse07:558600", "ko": "「잠깐! 방금 그 얘기를 믿는 거냐, 너희!」"},
{"id": "clse07:558700", "ko": "「너희는 평소에 나를 그런 눈으로 보고 있었던 거야!」"},
{"id": "clse07:558800", "ko": "「힉! 쿠, 쿠루스!」"},
{"id": "clse07:558900", "ko": "「기, 기다려 줘, 쿠루스! 이건 뭔가 잘못된 거고――」"},
{"id": "clse07:559000", "ko": "「……엥?」"},
{"id": "clse07:559100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:559200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:559300", "ko": "「너 말이야……!」"},
{"id": "clse07:559400", "ko": "「쿠루스! 들어 줘! 나는 무죄야!」"},
{"id": "clse07:559500", "ko": "「……어?」"},
{"id": "clse07:559600", "ko": "「크하악!」"},
{"id": "clse07:559700", "ko": "「전혀 짚이는 데가 없는 얘긴데, 왠지 양심이 아파!」"},
{"id": "clse07:559800", "ko": "「히갸악!」"},
{"id": "clse07:559900", "ko": "「마음이, 마음이 아파!」"},
{"id": "clse07:560000", "ko": "「후구윽!」"},
{"id": "clse07:560100", "ko": "「포고옥!」"},
{"id": "clse07:560200", "ko": "「우오오오오오오오!!!!!!!」"},
{"id": "clse07:560300", "ko": "「카, 카즈킷!」"},
{"id": "clse07:560400", "ko": "「아, 하하……」"},
{"id": "clse07:560500", "ko": "「하아…… 험한 꼴을 당했네」"},
{"id": "clse07:560600", "ko": "「비가 올 것 같군」"},
{"id": "clse07:560700", "ko": "「나, 우산 없는데」"},
{"id": "clse07:560800", "ko": "「으음……」"},
{"id": "clse07:560900", "ko": "「……하아」"},
{"id": "clse07:561000", "ko": "「아야야……」"},
{"id": "clse07:561100", "ko": "「사진관에서 넘어졌을 때 삐었나」"},
{"id": "clse07:561200", "ko": "「아아 아니, 카즈키 탓이 아니야」"},
{"id": "clse07:561300", "ko": "「전부 그 녀석 책임이다」"},
{"id": "clse07:561400", "ko": "「그렇다고는 해도, 이제 어떻게 하면 좋을까……」"},
{"id": "clse07:561500", "ko": "「이다음에 무슨 예정이었는지, 그 녀석밖에 모른단 말이지……」"},
{"id": "clse07:561600", "ko": "「카즈키, 너는 그 녀석이 무슨 생각을 하는지 모르는 거지?」"},
{"id": "clse07:561700", "ko": "「그렇다는 건, 그때 그 녀석이 갑자기 사라진 이유도 모른다는 건가」"},
{"id": "clse07:561800", "ko": "（……아니면）"},
{"id": "clse07:561900", "ko": "「……흠」"},
{"id": "clse07:562000", "ko": "「왜 그래?」"},
{"id": "clse07:562100", "ko": "「일단 저기서 비를 피하자!」"},
{"id": "clse07:562200", "ko": "（큰일 났다……）"},
{"id": "clse07:562300", "ko": "「일단 비가 그칠 때까지 여기 있자」"},
{"id": "clse07:562400", "ko": "「카즈키, 추워?」"},
{"id": "clse07:562500", "ko": "「……」"},
{"id": "clse07:562600", "ko": "「…………하아」"},
{"id": "clse07:562700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:562800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:562900", "ko": "「그대로 있으면 감기 걸리잖아. 그러면 나중에 쿠루스한테 혼나는 건 나야」"},
{"id": "clse07:563000", "ko": "「샤워하고, 옷을 최대한 말리는 거야」"},
{"id": "clse07:563100", "ko": "「너한테는 손가락 하나 안 댈게. 약속해」"},
{"id": "clse07:563200", "ko": "「안심해. 내가 그런 배짱 있는 남자로 보여?」"},
{"id": "clse07:563300", "ko": "「뭐야?」"},
{"id": "clse07:563400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:563500", "ko": "「무슨 소리야?」"},
{"id": "clse07:563600", "ko": "「게다가?」"},
{"id": "clse07:563700", "ko": "「할 리가 있냐!」"},
{"id": "clse07:563800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:563900", "ko": "「굳이 따지자면, 나는 남한테 차가운 편이야」"},
{"id": "clse07:564000", "ko": "「무슨 뜻이야?」"},
{"id": "clse07:564100", "ko": "「아아, 그러고 보니 카즈키는 쿠루스가 권해서 신문부에 들어왔었지」"},
{"id": "clse07:564200", "ko": "「쿠루스는 다정하다기보다, 곤란한 사람을 그냥 못 지나치는 녀석이니까」"},
{"id": "clse07:564300", "ko": "「뭐랄까, 남 챙기는 걸 좋아할 뿐이야」"},
{"id": "clse07:564400", "ko": "「뭐, 만약 쿠루스가 없었으면, 카즈키가 지금처럼 방과 후에 엠스를 하고 있을 일은 없었겠지」"},
{"id": "clse07:564500", "ko": "「쿠루스한테 고마워하라고」"},
{"id": "clse07:564600", "ko": "「어?」"},
{"id": "clse07:564700", "ko": "「무슨 뜻이야?」"},
{"id": "clse07:564800", "ko": "「히익! 뭐, 뭐야!?」"},
{"id": "clse07:564900", "ko": "「그, 그런가! 놀래키지 좀 마……」"},
{"id": "clse07:565000", "ko": "「자, 들어가」"},
{"id": "clse07:565100", "ko": "「나는 나중에 해도 돼. 카즈키가 몸이 더 식었잖아」"},
{"id": "clse07:565200", "ko": "「뭔데」"},
{"id": "clse07:565300", "ko": "「……그, 그래! 그렇지!」"},
{"id": "clse07:565400", "ko": "（카즈키는 무슨 말을 하려던 걸까?）"},
{"id": "clse07:565500", "ko": "（카즈키가 신문부에 있을 수 있는 이유…… 라니, 뭐지?）"},
{"id": "clse07:565600", "ko": "（……흠）"},
{"id": "clse07:565700", "ko": "「……신경 쓰지 않기로 하자」"},
{"id": "clse07:565800", "ko": "「히아앗!?」"},
{"id": "clse07:565900", "ko": "「너, 너! 카즈키가 아니구나!?」"},
{"id": "clse07:566000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:566100", "ko": "「끄아아아아아아!!!!!」"},
{"id": "clse07:566200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:566300", "ko": "「무슨 얘기를 하는 거야!?」"},
{"id": "clse07:566400", "ko": "「그런 얘기 안 했어!!」"},
{"id": "clse07:566500", "ko": "「엥?」"},
{"id": "clse07:566600", "ko": "「뭐, 뭘」"},
{"id": "clse07:566700", "ko": "「뭐!?」"},
{"id": "clse07:566800", "ko": "「주, 준비? 무…… 무슨?」"},
{"id": "clse07:566900", "ko": "「뭐!?」"},
{"id": "clse07:567000", "ko": "「뭐, 뭐가?」"},
{"id": "clse07:567100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:567200", "ko": "", "note": "보류 — 성적 묘사"}
]
