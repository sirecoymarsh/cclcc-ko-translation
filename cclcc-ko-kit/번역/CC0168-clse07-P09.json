[
{"id": "clse07:79800", "ko": "「아뇨? 세리잖아요?」"},
{"id": "clse07:79900", "ko": "「엥?」"},
{"id": "clse07:80000", "ko": "「으음~ 정말이네요. 하나는 거짓말 안 하고 있어요」"},
{"id": "clse07:80100", "ko": "「어디서 어떻게 봐도 하나잖아요. 왜 한눈에 못 알아본 거예요? 미야시로 선배 눈은 썩었어요?」"},
{"id": "clse07:80200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:80300", "ko": "「뭘 거기서 신나 하는 거예요」"},
{"id": "clse07:80400", "ko": "「새 인격이라니, 그런 게 간단히 생길 리가 없잖아요」"},
{"id": "clse07:80500", "ko": "「흠……」"},
{"id": "clse07:80600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:80700", "ko": "「대놓고 이상하네요……」"},
{"id": "clse07:80800", "ko": "「그거 정말 미야시로 선배가 한 말이야? 좀 믿기지 않는데」"},
{"id": "clse07:80900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:81900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:82000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:82100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:82200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:82300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:82400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:82500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:82600", "ko": "「알고 있던 일이지만, 역시 여자의 적이네요」"},
{"id": "clse07:82700", "ko": "「미야시로 선배. 최악이에요」"},
{"id": "clse07:82800", "ko": "「최악!」"},
{"id": "clse07:82900", "ko": "「하아? 혹시 미야시로 선배, 아직도 모르는 거예요?」"},
{"id": "clse07:83000", "ko": "「아~니~거~든~요~」"},
{"id": "clse07:83100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:83200", "ko": "「다들 말하는 대로예요, 미야시로 선배」"},
{"id": "clse07:83300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:83400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:83500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:83600", "ko": "「미야시로 선배?」"},
{"id": "clse07:83700", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:83800", "ko": "「차오임다, 미야시로 선배」"},
{"id": "clse07:83900", "ko": "「뭐냐니 뭐예요, 실례네요. 귀여운 히나에가 일부러 3학년 교실까지 와 줬다는데」"},
{"id": "clse07:84000", "ko": "「『야호~! 히나에땅이 나를 만나러 와 줬어! 타쿠루, 감격!』 정도는 말해 보는 게 어때요?」"},
{"id": "clse07:84100", "ko": "「욱~!!」"},
{"id": "clse07:84200", "ko": "「완전 거짓말이니까요!」"},
{"id": "clse07:84300", "ko": "「안 써도 안다고!!」"},
{"id": "clse07:84400", "ko": "「어디가!」"},
{"id": "clse07:84500", "ko": "「으……」"},
{"id": "clse07:84600", "ko": "「정말이지…… 뭐, 딱히 상관없지만요. 모~처럼 좋은 걸 가져와 줬는데, 미야시로 선배가 그런 태도를 취하면 도로 가져갈 거라고요~」"},
{"id": "clse07:84700", "ko": "「뭠까, 그 불안해 보이는 얼굴은……」"},
{"id": "clse07:84800", "ko": "「세리」"},
{"id": "clse07:84900", "ko": "「가자」"},
{"id": "clse07:85000", "ko": "「농담? 그걸로 끝날 거라고 생각하세요, 미야시로 선배」"},
{"id": "clse07:85100", "ko": "「이럴 땐 달리 할 말이 있잖아요」"},
{"id": "clse07:85200", "ko": "「『부탁드립니다 선배, 귀여운 제가 만든 베이글이라도 괜찮으시다면 드셔 주시겠습니까?』」"},
{"id": "clse07:85300", "ko": "「잠깐, 왜 그렇게 되는 거야~!!」"},
{"id": "clse07:85400", "ko": "「저기, 세리…… 방금 대화 들었어?」"},
{"id": "clse07:85500", "ko": "「그야 이 히나에가 만들었으니까요」"},
{"id": "clse07:85600", "ko": "「흥!」"},
{"id": "clse07:85700", "ko": "「세리」"},
{"id": "clse07:85800", "ko": "「잔말 말고 처먹어~!! 으랴~!」"},
{"id": "clse07:85900", "ko": "「자~ 자~, 잔뜩 드셔 주실 거죠~?」"},
{"id": "clse07:86000", "ko": "「물로 흘려 넘기려는 건 안 돼요 안 돼. 제대로 맛보면서 먹어야죠」"},
{"id": "clse07:86100", "ko": "「아~ 이런 건 거짓말 거짓말…… 응? 거짓말이…… 아닌 것 같네……」"},
{"id": "clse07:86200", "ko": "「어휴, 손이 많이 가네요. 우리가 없었으면 어떻게 됐을지」"},
{"id": "clse07:86300", "ko": "「호오~. 아무래도 두 분 다 목숨이 아깝지 않은 모양이네요……」"},
{"id": "clse07:86400", "ko": "「어…… 아~ 역시 그런 식으로 말하면 좀 깨네요……」"},
{"id": "clse07:86500", "ko": "「그건 2학년 수업이니까 3학년인 쿠루스 선배는 안 만들었을 거예요」"},
{"id": "clse07:86600", "ko": "「정말, 할아버지 둘, 시끄러워~」"},
{"id": "clse07:86700", "ko": "「우리가 보기엔 둘 다 한 학년 위니까 충분히 할아버지임다」"},
{"id": "clse07:86800", "ko": "「셧~업, 하나! 더 말하면 무서운 꼴을 당할 거다~」"},
{"id": "clse07:86900", "ko": "「아~~~~~~~~~~~앗!!」"},
{"id": "clse07:87000", "ko": "「쿠루스 선배」"},
{"id": "clse07:87100", "ko": "「어라? 선배. 혹시……」"},
{"id": "clse07:87200", "ko": "「아, 역시!」"},
{"id": "clse07:87300", "ko": "「선배…… 엿듣는 거예요?」"},
{"id": "clse07:87400", "ko": "「혼자서 즐기다니 치사해~!」"},
{"id": "clse07:87500", "ko": "「잠깐 빌려주세요! 에잇!」"},
{"id": "clse07:87600", "ko": "「무슨 소리임까. 혼자서 엿듣고 있었으면서」"},
{"id": "clse07:87700", "ko": "「쉿! 세리! 지금 좋은 데니까 조용히 해!!」"},
{"id": "clse07:87800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:87900", "ko": "「우웩…… 최악……」"},
{"id": "clse07:88000", "ko": "「좋았어!!」"},
{"id": "clse07:88100", "ko": "「하아~……」"},
{"id": "clse07:88200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:88300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:88400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:88500", "ko": "「가끔은 문예부에도 얼굴 내밀어야지!」"},
{"id": "clse07:88600", "ko": "「으헤에…… 큰일이 났구먼요」"},
{"id": "clse07:88700", "ko": "「그보다, 애초에 그런 교칙을 인정해 버려도 되는 검까?」"},
{"id": "clse07:88800", "ko": "「그렇슴다. 앞으로 졸업할 때까지 여자 친구가 생길 가능성이 전무한 이토 선배가 하는 말이라고요? 이상하잖아요」"},
{"id": "clse07:88900", "ko": "「찬성~」"},
{"id": "clse07:89000", "ko": "「그래도 원래는 부회장이 이상한 짓을 하고 있는 거고요~」"},
{"id": "clse07:89100", "ko": "「그건……」"},
{"id": "clse07:89200", "ko": "「그보다~, 이토 선배는 교칙이 있든 없든 결과가 안 바뀌니까 괜찮지만~, 히나에는 아직 2학년인데~, 앞으로 계속 연애 금지라니 불쌍해~」"},
{"id": "clse07:89300", "ko": "「으음~ 꽤 충격받은 것 같슴다~」"},
{"id": "clse07:89400", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:89500", "ko": "「아니~, 미야시로 선배 언동이 수상해서 살짝 떠봤더니, 완전 거짓말을 하고 있길래, 좀 세리한테 부탁해서~」"},
{"id": "clse07:89600", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:89700", "ko": "「알아요 알아. 농담임다, 농담」"}
]
