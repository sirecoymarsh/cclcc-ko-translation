[
{"id": "clkn18:0", "ko": "겨울 추위도 드디어 본격적으로 시작되려는 어느 날."},
{"id": "clkn18:100", "ko": "「정말 죄송했습니다……」"},
{"id": "clkn18:200", "ko": "「앞으로는 그 미안한 마음을 아이한테 쏟아 줘요」"},
{"id": "clkn18:300", "ko": "「네」"},
{"id": "clkn18:400", "ko": "「정말 가 버리는구나……」"},
{"id": "clkn18:500", "ko": "「아직도 그러네. 그게 최선이라는 거, 유도 알잖아」"},
{"id": "clkn18:600", "ko": "「응…… 그치만……」"},
{"id": "clkn18:700", "ko": "아오바 기숙사를 찾아온 히카리의 엄마는 아기를 맡기고 간 것을 진심으로 후회하는 것 같았다."},
{"id": "clkn18:800", "ko": "그 마음에 거짓은 없다고 판단한 아버지는 원래 엄마인 그 사람에게 히카리를 맡기기로 했다."},
{"id": "clkn18:900", "ko": "그게 히카리에게 가장 좋다는 건 우리도 알고 있었지만, 그래도 아쉬움은 끝이 없었다."},
{"id": "clkn18:1000", "ko": "「자, 모두 웃으면서 보내 줘라」"},
{"id": "clkn18:1100", "ko": "「응. 잘 지내, 히카리」"},
{"id": "clkn18:1200", "ko": "「누나 잊으면 안 된다~?」"},
{"id": "clkn18:1300", "ko": "「또 놀러 와. 기다리고 있을게요……」"},
{"id": "clkn18:1400", "ko": "「자, 너희도」"},
{"id": "clkn18:1500", "ko": "「또 보자, 히카리. 행복해야 해」"},
{"id": "clkn18:1600", "ko": "「…………」"},
{"id": "clkn18:1700", "ko": "처음에는 말도 안 된다고 생각했지만, 그래도 한동안 같이 지내다 보면 정이 드는 법이다."},
{"id": "clkn18:1800", "ko": "나조차 그런데 센리는 오죽할까."},
{"id": "clkn18:1900", "ko": "그래도 헤어져야 한다는 건 센리도 잘 알고 있을 것이다."},
{"id": "clkn18:2000", "ko": "「히카리……」"},
{"id": "clkn18:2100", "ko": "우리 마음은 아랑곳없이 히카리는 기쁜 듯이 웃었다."},
{"id": "clkn18:2200", "ko": "「잘 지내……」"},
{"id": "clkn18:2300", "ko": "「어?」"},
{"id": "clkn18:2400", "ko": "「방금……」"},
{"id": "clkn18:2500", "ko": "「히카리……」"},
{"id": "clkn18:2600", "ko": "우리는 모습이 보이지 않을 때까지 히카리와 엄마를 배웅했다."},
{"id": "clkn18:2700", "ko": "「가 버렸나……」"},
{"id": "clkn18:2800", "ko": "「쿠노사토 씨!? 왜……」"},
{"id": "clkn18:2900", "ko": "「왜냐니, 꽤나 거창한 인사로군. 일부러 그 소동에 대해 설명해 주려고 왔더니」"},
{"id": "clkn18:3000", "ko": "그렇다면 학교든 어디든 상관없었을 텐데, 사실은 아기가 보고 싶었던 게 분명하다."},
{"id": "clkn18:3100", "ko": "그러고 보니 이 사람, 유토한테도 어딘가 무르고, 사실 보기와 달리 아이를 좋아하는 건지도 모른다……"},
{"id": "clkn18:3200", "ko": "「그래서 그 건 말인데, 역시 뭔가 ⟦col:280aa02d1400⟧기가로매니악스⟦col:800000⟧의 능력이 발동해 있었을 거라는 게 내 견해다」"},
{"id": "clkn18:3300", "ko": "「그렇지 않고서야 아무리 유토리 세대인 너희라도 그런 유치한 ⟦rb⟧선동⟦rt⟧애지테이트⟦/r⟧에 넘어갈 리가 없으니까」"},
{"id": "clkn18:3400", "ko": "자기도 유토리 세대이면서."},
{"id": "clkn18:3500", "ko": "「그럼 카와하라에게도 능력이……?」"},
{"id": "clkn18:3600", "ko": "「잠재적으로 갖고 있던 능력이 ⟦col:280aa02d1400⟧심리적 스트레스⟦col:800000⟧로 포화되어 새어 나온 게 아닐까 싶다」"},
{"id": "clkn18:3700", "ko": "「그런 일이 있나요?」"},
{"id": "clkn18:3800", "ko": "「스트레스 때문에 능력 제어가 안 되는 일도 있지. 그 반대도 마찬가지고」"},
{"id": "clkn18:3900", "ko": "「그럼 카와하라는……」"},
{"id": "clkn18:4000", "ko": "「능력의 발현은 어디까지나 일시적인 거겠지. 뭐, 제대로 조사해 보지 않으면 모르겠다만……」"},
{"id": "clkn18:4100", "ko": "「그래서 그 카와하라 말인데, 대체 지금 어떻게 지내는 거지?」"},
{"id": "clkn18:4200", "ko": "「아, 그게 말이죠……」"},
{"id": "clkn18:4300", "ko": "「미야시로」"},
{"id": "clkn18:4400", "ko": "「아…… 카, 카와하라. 저기…… 무슨 일…… 이에요?」"},
{"id": "clkn18:4500", "ko": "「그…… 쿠루스한테서 연락은 있었냐?」"},
{"id": "clkn18:4600", "ko": "「……아, 아뇨, 없는데요……」"},
{"id": "clkn18:4700", "ko": "「그런가. 그나저나 쿠루스도 매정한 녀석이야. 아무한테도 아무 말 없이 유학을 가 버리다니」"},
{"id": "clkn18:4800", "ko": "「그, 그러…… 게요……」"},
{"id": "clkn18:4900", "ko": "「그래도 너는 알고 있었겠지?」"},
{"id": "clkn18:5000", "ko": "「뭐, 뭐……」"},
{"id": "clkn18:5100", "ko": "「그런가…… 뭐, 그 녀석한테 나는 그냥 오래 알고 지낸 사람일 뿐이었다는 건가……」"},
{"id": "clkn18:5200", "ko": "「…………」"},
{"id": "clkn18:5300", "ko": "「아, 그래도 말해 두는데, 침울해하는 건 아니니까. 딱히 여자가 그 녀석 하나뿐인 것도 아니고」"},
{"id": "clkn18:5400", "ko": "「하아……」"},
{"id": "clkn18:5500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clkn18:5600", "ko": "「네?」"},
{"id": "clkn18:5700", "ko": "카와하라는 알 수 없는 말을 남기고 등을 돌려 가 버렸다."},
{"id": "clkn18:5800", "ko": "「이봐」"},
{"id": "clkn18:5900", "ko": "떠나가는 카와하라와 엇갈리듯 쿠노사토 씨가 나타났다."},
{"id": "clkn18:6000", "ko": "「저건 어떻게 된 거지?」"},
{"id": "clkn18:6100", "ko": "「그게……」"},
{"id": "clkn18:6200", "ko": "그날 이후 노노는 학교에서도 센리의 모습으로 지내게 되었다."},
{"id": "clkn18:6300", "ko": "주위 사람들은 당황하긴 했지만, 점점 그 사실을 받아들여 갔다."},
{"id": "clkn18:6400", "ko": "단 한 사람, 카와하라만 빼고."},
{"id": "clkn18:6500", "ko": "노노가 센리였다는 사실은 카와하라에게 어지간히 충격이었던 모양이다."},
{"id": "clkn18:6600", "ko": "그 결과――."},
{"id": "clkn18:6700", "ko": "「뭐! 기억이!?」"},
{"id": "clkn18:6800", "ko": "「……아무래도 그동안 있었던 일을 전부 잊어버린 것 같아서요……」"},
{"id": "clkn18:6900", "ko": "그 결과, 카와하라 안에서 자기에게 유리한 기억이 생겨난 모양이다."},
{"id": "clkn18:7000", "ko": "지금 카와하라의 기억 속에서는 “쿠루스 노노는 바로 얼마 전 갑자기 유학을 떠났”고, 떠나 버린 그녀 대신 “유학 가 있던 미나미사와 센리가 돌아온” 것으로 되어 있는 것이다."},
{"id": "clkn18:7100", "ko": "「흠…… 과거의 일에서 눈을 돌린 나머지, 자기 안에 가짜 기억을 만들어 냈다는 건가. 실로 흥미롭군……」"},
{"id": "clkn18:7200", "ko": "「이번 능력 폭주 건도 있고. 꼭 한번 저 머리를 열어서 조사해 보고 싶군」"},
{"id": "clkn18:7300", "ko": "「마음대로 하세요……」"},
{"id": "clkn18:7400", "ko": "뭐, 그걸로 카와하라 본인이 행복하다면 그걸로 된 게 아닐까."},
{"id": "clkn18:7500", "ko": "어느 쪽이든 우리와는 상관없는 일이다."},
{"id": "clkn18:7600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn18:7700", "ko": "「어, 어디까지라니, 뭐가!?」"},
{"id": "clkn18:7800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn18:7900", "ko": "「아무 데도 안 갔으니까!」"},
{"id": "clkn18:8000", "ko": "「우~ 정말~?」"},
{"id": "clkn18:8100", "ko": "「정말이야!」"},
{"id": "clkn18:8200", "ko": "「히나 씨……!」"},
{"id": "clkn18:8300", "ko": "「흐음…… 아무래도 정말인가 보네」"},
{"id": "clkn18:8400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn18:8500", "ko": "이토가 수상하다는 눈빛으로 나와 거리를 벌렸다."},
{"id": "clkn18:8600", "ko": "「시끄러워! 우리 일이야. 너희랑은 상관없잖아?」"},
{"id": "clkn18:8700", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:8800", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:8900", "ko": "「기각이야!!」"},
{"id": "clkn18:9000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:9100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:9200", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:9300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:9400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn18:9500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"}
]
