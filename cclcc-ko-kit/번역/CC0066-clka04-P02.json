[
{"id": "clka04:10000", "ko": "「아하하! 타쿠도 참, 잊어버리다니!」"},
{"id": "clka04:10100", "ko": "「미, 미야시로 선배! 기, 기억이, 없다니, 거, 거짓말, 이죠!」"},
{"id": "clka04:10200", "ko": "「다, 다들, 너, 너무 웃잖아!? 타쿠, 루한테, 실례, 잖아. 그, 그렇지?」"},
{"id": "clka04:10300", "ko": "「우후, 우후후후……」"},
{"id": "clka04:10400", "ko": "「다, 다들 대체 왜 그래!」"},
{"id": "clka04:10500", "ko": "「이, 히이힛힛! 미야시로다워!」"},
{"id": "clka04:10600", "ko": "「그야 잊고 싶어지기도 하겠지!」"},
{"id": "clka04:10700", "ko": "「그때의 너는 빛나고 있었는데 말이야」"},
{"id": "clka04:10800", "ko": "「잊고 싶어진다고? 빛나고 있었다고?」"},
{"id": "clka04:10900", "ko": "「무슨 소리야 이토, 나 어제 뭘 한 거야!?」"},
{"id": "clka04:11000", "ko": "「아리무라, 가르쳐 줘라」"},
{"id": "clka04:11100", "ko": "「선배……」"},
{"id": "clka04:11200", "ko": "「정말로 기억 안 나는 거군요……」"},
{"id": "clka04:11300", "ko": "「너무해……」"},
{"id": "clka04:11400", "ko": "「……어?」"},
{"id": "clka04:11500", "ko": "「어젯밤엔 저를 그렇게나 사랑해 줬으면서……!」"},
{"id": "clka04:11600", "ko": "「저, 선배 마음이 기뻤으니까……」"},
{"id": "clka04:11700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka04:11800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka04:11900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka04:12000", "ko": "「그런데 전부 잊어버리다니…… 저를 시집도 못 가는 몸으로 만들어 놓고!」"},
{"id": "clka04:12100", "ko": "「뭐어어!?」"},
{"id": "clka04:12200", "ko": "「잠깐 타쿠루!? 너, 아리무라한테 무슨 짓을 한 거야!?」"},
{"id": "clka04:12300", "ko": "「타쿠〜!? 여자애를 괴롭히면 안 되는 거야!?」"},
{"id": "clka04:12400", "ko": "「잠깐 기다려!」"},
{"id": "clka04:12500", "ko": "「확실히 기억은 안 나지만……」"},
{"id": "clka04:12600", "ko": "「너무해!」"},
{"id": "clka04:12700", "ko": "「타쿠루〜!?」⟦n⟧⟦par⟧「타쿠〜!!」"},
{"id": "clka04:12800", "ko": "「아니 잠깐! 나는 기억 못 하지만, 너희는 다 같이 있었잖아!?」"},
{"id": "clka04:12900", "ko": "「내가 아리무라한테 뭘 했는지 안 했는지, 너희 쪽이 알고 있을 거 아냐!」"},
{"id": "clka04:13000", "ko": "「아, 그렇구나」"},
{"id": "clka04:13100", "ko": "「그러고 보니 그렇네」"},
{"id": "clka04:13200", "ko": "「……칫」"},
{"id": "clka04:13300", "ko": "「조금만 더 하면 막대한 위자료를 얻을 수 있었는데」"},
{"id": "clka04:13400", "ko": "「아아아, 아리무라!?」"},
{"id": "clka04:13500", "ko": "「농담이에요, 미야시로 선배」"},
{"id": "clka04:13600", "ko": "「확실히 어젯밤의 선배는 어디까지나 신사적이었어요」"},
{"id": "clka04:13700", "ko": "「그, 그런가……」"},
{"id": "clka04:13800", "ko": "「뭐, 언행은 완전 변태였지만요」"},
{"id": "clka04:13900", "ko": "「뭐어!?」"},
{"id": "clka04:14000", "ko": "「그건 나도 동감이야…… 타쿠루가 그런 말을 쓰다니」"},
{"id": "clka04:14100", "ko": "「그런 말!?」"},
{"id": "clka04:14200", "ko": "「얼굴 새빨개져서 연설했지〜」"},
{"id": "clka04:14300", "ko": "「연설!? 내가!?」"},
{"id": "clka04:14400", "ko": "「자작곡은 꽤 그럴듯했다고」"},
{"id": "clka04:14500", "ko": "「노, 노래!?」"},
{"id": "clka04:14600", "ko": "「하지만 아무래도 그 춤은 저질스럽다고 생각했어」"},
{"id": "clka04:14700", "ko": "「추추추추춤이라고오오오!?」"},
{"id": "clka04:14800", "ko": "「대체 어떤 추태를 보인 거야, 어제의 나는!?」"},
{"id": "clka04:14900", "ko": "「그러니까 잊은 채로 있는 게 너를 위한 거라니까」"},
{"id": "clka04:15000", "ko": "「그러면 더 신경 쓰이잖아!?」"},
{"id": "clka04:15100", "ko": "「그치만 그때의 너 진짜 웃겨서, 히히힛!」"},
{"id": "clka04:15200", "ko": "……글렀다, 이건."},
{"id": "clka04:15300", "ko": "「알았어, 됐어. 이제 내 얘기는 안 물을 테니까」"},
{"id": "clka04:15400", "ko": "「어제 무슨 일이 있었는지 가르쳐 줘」"},
{"id": "clka04:15500", "ko": "「타쿠루, 농담이 아니라 정말 아무것도 기억 안 나는 거지?」"},
{"id": "clka04:15600", "ko": "「응」"},
{"id": "clka04:15700", "ko": "「알았어. 뭐 확실히 그건 잊는 편이 나은 기억일지도, 큭, 후후……」"},
{"id": "clka04:15800", "ko": "「쿠루스」"},
{"id": "clka04:15900", "ko": "「미, 미안해. 그만……」"},
{"id": "clka04:16000", "ko": "「에헴」"},
{"id": "clka04:16100", "ko": "「어제는 말이야, 아침부터 신문부원이 전원 모여서 시부야 취재를 했어」"},
{"id": "clka04:16200", "ko": "「문화제용 기사 소재 모으기로, 시부야의 역사를 더듬어 볼 수 있는 곳을 돌았거든」"},
{"id": "clka04:16300", "ko": "「복개돼서 숨어 있는 시부야강이라든가, 시부야 지진 부흥의 상징인 히카리오라든가」"},
{"id": "clka04:16400", "ko": "「그렇다고 해도 이토는 계속 몰래 와 있는 아이돌이 없는지 찾느라고 사진을 제대로 안 찍어 주고」"},
{"id": "clka04:16500", "ko": "「미안 미안. 모처럼 휴일이니까 좀 즐거움이 필요했다고」"},
{"id": "clka04:16600", "ko": "「아리무라는 지도를 잘못 본 척하면서 러브호텔 거리로 가려고 하고, 힘들었지만」"},
{"id": "clka04:16700", "ko": "「뭐 어때요, 즐거웠으니까 됐잖아요」"},
{"id": "clka04:16800", "ko": "「뭐, 그래도 어떻게든 취재가 끝나서 미야시타 공원에 돌아온 게 저녁 무렵이었지」"},
{"id": "clka04:16900", "ko": "「하지만 집에 가기엔 이르니까, 자연스럽게 뒤풀이를 하자는 얘기가 돼서」"},
{"id": "clka04:17000", "ko": "「대충 과자랑 음료를 사서 미야시로 차 안에서 파티를 했지」"},
{"id": "clka04:17100", "ko": "「그랬더니 처음엔 기운차게 떠들던 타쿠가 점점 말수가 줄어들더니, 마지막엔 눈을 감고 입을 다물어 버려서」"},
{"id": "clka04:17200", "ko": "「잠들었나 했더니――」"},
{"id": "clka04:17300", "ko": "「갑자기 눈을 번쩍 뜨고 다른 사람처럼 떠들기 시작한 거예요!」"},
{"id": "clka04:17400", "ko": "「얼굴이 새빨갰고, 음료 중 뭔가에 미성년자가 마시면 안 되는 그런, 뭔가가 들어 있었던 걸까요」"},
{"id": "clka04:17500", "ko": "「아〜, 그런 몹쓸 짓을 한 건 누굴까〜. 괘씸하네〜」"},
{"id": "clka04:17600", "ko": "……아무리 생각해도 이 녀석이다."},
{"id": "clka04:17700", "ko": "「그래서 말이야, 미야시로는 엔진 풀가동으로 종횡무진 대활약이었는데」"},
{"id": "clka04:17800", "ko": "「좀 있다가 침대에 쓰러져서 잠들어 버렸어. 그대로 해산 분위기가 됐지」"},
{"id": "clka04:17900", "ko": "「처음 돌아간 건 아리무라였던가?」"},
{"id": "clka04:18000", "ko": "「녹화 예약을 깜빡한 프로그램이 있어서요」"},
{"id": "clka04:18100", "ko": "「나랑 세리카는 같이 돌아갔지?」"},
{"id": "clka04:18200", "ko": "「응」"},
{"id": "clka04:18300", "ko": "「타쿠가 걱정됐지만, 혼자 두는 건 아니니까」"},
{"id": "clka04:18400", "ko": "「이토가 남아 줬어. 타쿠루, 이토한테 고마워해야 해」"},
{"id": "clka04:18500", "ko": "「그랬구나. 미안, 이토」"},
{"id": "clka04:18600", "ko": "「신경 쓰지 마」"},
{"id": "clka04:18700", "ko": "「이, 이건 설마 그런 루트인가요!? 드디어 금단의 문을 열어 버리는 건가요!?」"},
{"id": "clka04:18800", "ko": "「바보냐」"},
{"id": "clka04:18900", "ko": "「미야시로 PC 빌려서 게임하고 있었어. 우리 집은 부모님이 시끄러우니까」"},
{"id": "clka04:19000", "ko": "「그렇다고 해도 나도 금방 잠들어 버렸어. 아침에 눈을 떠 보니 미야시로가 일단 숨은 쉬고 있길래 집에 갔지」"},
{"id": "clka04:19100", "ko": "「……」"},
{"id": "clka04:19200", "ko": "「……그래서?」"},
{"id": "clka04:19300", "ko": "「응? 뭐가?」"},
{"id": "clka04:19400", "ko": "「아니 그러니까, 그 뒤는?」"},
{"id": "clka04:19500", "ko": "「그 뒤라니, 딱히 아무 일도 없었어」"},
{"id": "clka04:19600", "ko": "「그럴 리가 없잖아! 거기엔 한 명 더 있었을 거야!」"},
{"id": "clka04:19700", "ko": "「타쿠, 무슨 소리야?」"},
{"id": "clka04:19800", "ko": "「아직 잠이 덜 깼나. 다른 사람은 아무도 없었어」"},
{"id": "clka04:19900", "ko": "「그렇게까지 말할 근거라도 있는 거야?」"}
]
