[
{"id": "clse07:647300", "ko": "「아니, 너! 방금 거 들었지!?」"},
{"id": "clse07:647400", "ko": "「큭. 기어오르기는……」"},
{"id": "clse07:647500", "ko": "「와〜, 거짓말이에요, 농담이에요!」"},
{"id": "clse07:647600", "ko": "「아야야야야! 그, 그만해! 누구한테 배운 거야, 이런 걸!」"},
{"id": "clse07:647700", "ko": "「뭐어어어!?」"},
{"id": "clse07:647800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:647900", "ko": "「아야야야야야! 찌그러진다, 찌그러져! 야! 좀 봐주면서 해, 유이!」"},
{"id": "clse07:648000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:648100", "ko": "「어? 딱히 아무것도」"},
{"id": "clse07:648200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:648300", "ko": "「아야야야야야!」"},
{"id": "clse07:648400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:648500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:648600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:648700", "ko": "「……네?」"},
{"id": "clse07:648800", "ko": "「너, 너, 그거……!」"},
{"id": "clse07:648900", "ko": "「자, 자, 잠깐만 기다려 줘, 유이!?」"},
{"id": "clse07:649000", "ko": "「꾸엑……」"},
{"id": "clse07:649100", "ko": "「……준비……?」"},
{"id": "clse07:649200", "ko": "「무슨 소리 하는 거야, 너는――!」"},
{"id": "clse07:649300", "ko": "「그・만・둬――!」"},
{"id": "clse07:649400", "ko": "「…………」"},
{"id": "clse07:649500", "ko": "「그게…… 뭘 했는데? 내가?」"},
{"id": "clse07:649600", "ko": "「어, 어어……」"},
{"id": "clse07:649700", "ko": "「어, 어어……」"},
{"id": "clse07:649800", "ko": "「그렇군. 알기 쉬운 설명, 감사한다」"},
{"id": "clse07:649900", "ko": "「아아, 나쁜 버릇으로 잠깐 망상을 좀…… 놀라게 해서 미안」"},
{"id": "clse07:650000", "ko": "（――앗, 으악! 아차!）"},
{"id": "clse07:650100", "ko": "「어?」"},
{"id": "clse07:650200", "ko": "「왜, 왜 내가 오노에 때문에 화를 내야 하는 건데?」"},
{"id": "clse07:650300", "ko": "「아니, 그러니까――」"},
{"id": "clse07:650400", "ko": "「저기, 너 말이야? 혹시 지금 능력 안 쓰고 있는 거야?」"},
{"id": "clse07:650500", "ko": "「그런데 겐 씨 생각은 쉽게 도촬했잖아?」"},
{"id": "clse07:650600", "ko": "「저, 저기, 오노에?」"},
{"id": "clse07:650700", "ko": "「이제 됐잖아? 슬슬 그만하라니까」"},
{"id": "clse07:650800", "ko": "「너, 아까부터 계속 나를 사고 도촬하고 있지? 기분 좋은 일은 아니야, 그거」"},
{"id": "clse07:650900", "ko": "「쿠루스한테도 실컷 주의받았잖아? 친구 잃는다?」"},
{"id": "clse07:651000", "ko": "「뭐?」"},
{"id": "clse07:651100", "ko": "「그게 다…… 야?」"},
{"id": "clse07:651200", "ko": "「……미, 미안하다. 내 착각이었어. 미안」"},
{"id": "clse07:651300", "ko": "「응? 그건――」"},
{"id": "clse07:651400", "ko": "「미안하지만, 그건 아니야」"},
{"id": "clse07:651500", "ko": "「뭐야, 그게」"},
{"id": "clse07:651600", "ko": "「어이, 오노에?」"},
{"id": "clse07:651700", "ko": "「뭐야, 오늘은 벌써 가?」"},
{"id": "clse07:651800", "ko": "「나는 어제처럼 지금부터 발로 뉴스를 찾을 생각이었는데…… 너도 같이 안 갈래?」"},
{"id": "clse07:651900", "ko": "「물론. 그럼 오늘은 나 혼자 찾을게」"},
{"id": "clse07:652000", "ko": "「아니면…… 아리무라라도 불러 볼까. 소설 취재 같은 걸로 꽤 이상한 장소를 알고 있을지도 모르고」"},
{"id": "clse07:652100", "ko": "「어? 그래?」"},
{"id": "clse07:652200", "ko": "「자〜 그럼. 혼자 해 볼까, 기삿거리 찾기」"},
{"id": "clse07:652300", "ko": "（……응?）"},
{"id": "clse07:652400", "ko": "「쉿, 조용히!」"},
{"id": "clse07:652500", "ko": "「오늘은 좀 사정이 있어서요, 따로 다니는 중이에요. 그러니까 이쪽 자리에 앉을게요」"},
{"id": "clse07:652600", "ko": "（그렇구나. 그래서 오노에 녀석…… 자꾸 내 눈을……）"},
{"id": "clse07:652700", "ko": "（좋아!）"},
{"id": "clse07:652800", "ko": "（하지만 그런 거 신경 쓸 때가 아니야）"},
{"id": "clse07:652900", "ko": "「야, 오노에!」"},
{"id": "clse07:653000", "ko": "「미안한 줄은 알지만…… 얘기는 다 들었어, 오노에. 왜 그런 중요한 걸 나한테 말도 없이――」⟦avs⟧⟦n⟧⟦n⟧"},
{"id": "clse07:653100", "ko": "「야, 야, 오노에!?」"},
{"id": "clse07:653200", "ko": "「아니, 그게 말이야……!」"},
{"id": "clse07:653300", "ko": "「세, 세리카? 너, 대체 왜 그러――」"},
{"id": "clse07:653400", "ko": "「어?」"},
{"id": "clse07:653500", "ko": "「………」"},
{"id": "clse07:653600", "ko": "「……?」"},
{"id": "clse07:653700", "ko": "「그런, 거야?」"},
{"id": "clse07:653800", "ko": "「……? 뭐야, 그게?」"},
{"id": "clse07:653900", "ko": "「어!? 그래도 오노에는?」"},
{"id": "clse07:654000", "ko": "「……?」"},
{"id": "clse07:654100", "ko": "「……??」"},
{"id": "clse07:654200", "ko": "「아, 응……」"},
{"id": "clse07:654300", "ko": "「아얏」"},
{"id": "clse07:654400", "ko": "「아…… 읏……」"},
{"id": "clse07:654500", "ko": "「콜록, 쿨럭……」"},
{"id": "clse07:654600", "ko": "「콜록…… 야, 누구 없어? 여기 어디야?」"},
{"id": "clse07:654700", "ko": "「야! 적당히 좀 해! 무슨 장난이야, 이거!」"},
{"id": "clse07:654800", "ko": "（그런데 여기 캄캄하잖아? 그 녀석, 언제 적외선 카메라 같은 걸 샀지? 꽤 비쌀 텐데…… 이런 바보 같은 장난에 쓰다니 아깝다）"},
{"id": "clse07:654900", "ko": "「야, 이토! 너, 내 능력 알지! 이런 건 금방 풀 수 있다고! 네가 자랑하는 카메라도 부숴 버린다!」"},
{"id": "clse07:655000", "ko": "「그게 싫으면 이제 장난은 그만둬!」"},
{"id": "clse07:655100", "ko": "「야, 이토! 적당히 하라니까! 무슨 영화 오마주인지 패러디인지 모르겠지만!」"},
{"id": "clse07:655200", "ko": "「………어?」"},
{"id": "clse07:655300", "ko": "「오노에? 너, 이거…… 대체 무슨 생각으로……」"},
{"id": "clse07:655400", "ko": "「……?」"},
{"id": "clse07:655500", "ko": "「저, 저기. 아까는 정말 미안했어. 그런데 학교에서 오노에가 병일지도 모른다는 얘기를 들어서…… 가만히 있을 수가 없어서 그만 그런 짓을……」"},
{"id": "clse07:655600", "ko": "「그러니까 나쁜 뜻이 있었던 건 아니야. 그래도…… 매너 위반이라고 할까…… 나쁜 짓을 한 건 사실이니까. 미안」"},
{"id": "clse07:655700", "ko": "「안 된다니? 뭐가?」"},
{"id": "clse07:655800", "ko": "「척이라니…… 그럴 리가 없잖아. 정말 잘못했다고 생각하고 있다니까」"},
{"id": "clse07:655900", "ko": "「물론」"},
{"id": "clse07:656000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:656100", "ko": "「아니, 됐어. 오노에는 몰라도 되는 세계 얘기야. 아무튼 이걸 풀어――」"},
{"id": "clse07:656200", "ko": "「어?」"},
{"id": "clse07:656300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:656400", "ko": "「으아아아아――!!」"},
{"id": "clse07:656500", "ko": "「아파아파아파! 너, 무슨 짓을 하는 거야!」"},
{"id": "clse07:656600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:656700", "ko": "「거짓말 같은 거 안 할 테니까! 그러니까 부탁이야!」"},
{"id": "clse07:656800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:656900", "ko": "「버, 버, 버려! 지금 당장 어디다 버리고 와!」"},
{"id": "clse07:657000", "ko": "「됐으니까, 전부 치워」"},
{"id": "clse07:657100", "ko": "「자, 잠깐만! 어디 가!? 이거 풀어 줘!」"},
{"id": "clse07:657200", "ko": "「뭐!? 왜!?」"}
]
