[
{"id": "clse07:684400", "ko": "「물론. 다만 아까도 말했듯이 귀엽게 굴어 줘. 날뛰는 건 사양이야」"},
{"id": "clse07:684500", "ko": "「으음. 너는 와와 시끄러우니까. 편히 못 자니까 기각」"},
{"id": "clse07:684600", "ko": "「하하하……」"},
{"id": "clse07:684700", "ko": "「그래서 말인데. 다음 신문 특집을 어떻게 할지 말이야……」"},
{"id": "clse07:684800", "ko": "「……미스콘이라니, 그 미스콘 말이야?」"},
{"id": "clse07:684900", "ko": "「자업자득이지」"},
{"id": "clse07:685000", "ko": "「아, 아아. 땡큐」"},
{"id": "clse07:685100", "ko": "「야, 이토……」"},
{"id": "clse07:685200", "ko": "「이토」"},
{"id": "clse07:685300", "ko": "「아니, 딱히 아무 생각 없는데」"},
{"id": "clse07:685400", "ko": "「단 거라……」"},
{"id": "clse07:685500", "ko": "「저기, 쿠루스. 난 아직 간다고는……」"},
{"id": "clse07:685600", "ko": "「유이 얘기?」"},
{"id": "clse07:685700", "ko": "「아, 아니…… 아까 흐름으로 봐선 당연히 우키 얘기인 줄 알았거든」"},
{"id": "clse07:685800", "ko": "「그게 말이야. 우키가 남 생각만 하는 게…… 뭐 그런 얘기인 줄……」"},
{"id": "clse07:685900", "ko": "「유이? 왜 여기에?」"},
{"id": "clse07:686000", "ko": "「뭐, 뭔데?」"},
{"id": "clse07:686100", "ko": "「어?」"},
{"id": "clse07:686200", "ko": "「미안. 잘 안 들려」"},
{"id": "clse07:686300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:686400", "ko": "「에에에에에에에에에에에에에에에!?」"},
{"id": "clse07:686500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:686600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:686700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:686800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:686900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:687700", "ko": "「엥?」"},
{"id": "clse07:687800", "ko": "「어!? 우, 우왓!!」"},
{"id": "clse07:687900", "ko": "「아, 아아, 아니야! 이건 그러니까…… 어제 쿵후 영화를 봤거든! 이런 자세가 있었어! 호랑이 권법이라고!」"},
{"id": "clse07:688000", "ko": "「그, 그래서 할 얘기라는 게……?」"},
{"id": "clse07:688100", "ko": "「유, 유이……?」"},
{"id": "clse07:688200", "ko": "「윽……」"},
{"id": "clse07:688300", "ko": "「내, 내가……?」"},
{"id": "clse07:688400", "ko": "「그런…… 나는 아무것도……」"},
{"id": "clse07:688500", "ko": "「어……」"},
{"id": "clse07:688600", "ko": "「힉……」"},
{"id": "clse07:688700", "ko": "「아버…… 지가……?」"},
{"id": "clse07:688800", "ko": "「기, 기다려, 유이! 그런 짓――!」"},
{"id": "clse07:688900", "ko": "「유……」"},
{"id": "clse07:689000", "ko": "「…………」"},
{"id": "clse07:689100", "ko": "「……아니……」"},
{"id": "clse07:689200", "ko": "「그, 그래서 할 얘기라는 게?」"},
{"id": "clse07:689300", "ko": "「그래서 할 얘기라는 게?」"},
{"id": "clse07:689400", "ko": "「상담?」"},
{"id": "clse07:689500", "ko": "「뭐……」"},
{"id": "clse07:689600", "ko": "「설 자리를 빼앗겼다는 건가……」"},
{"id": "clse07:689700", "ko": "「얘기는 알겠어. 그런데 왜 나야? 상담이라면 쿠루스가 들어 주면 되잖아?」"},
{"id": "clse07:689800", "ko": "「그래도 그런 고민이라면 누구나 있는 거 아냐?」"},
{"id": "clse07:689900", "ko": "「애초에 고민이 심각하면 언젠가 자기가 먼저 말하겠지. 게다가 내가 그 나이대 여자애 고민을 들어 줄 수 있을 것 같지도 않고, 애초에 나랑은 상관없――」"},
{"id": "clse07:690000", "ko": "「아……」"},
{"id": "clse07:690100", "ko": "「아, 아니, 방금 건 그야말로 말이 헛나온 거라서……」"},
{"id": "clse07:690200", "ko": "「아〜! 그러고 보니 마침 오랜만에 집에 얼굴 좀 비칠까 생각하고 있었거든!」"},
{"id": "clse07:690300", "ko": "「모처럼이니까 당분간 집에서 유이 상태라도 지켜볼까 하는데, 어때?」"},
{"id": "clse07:690400", "ko": "「…………」"},
{"id": "clse07:690500", "ko": "「다녀왔어」"},
{"id": "clse07:690600", "ko": "「오랜만이야」"},
{"id": "clse07:690700", "ko": "「뭐, 당분간……」"},
{"id": "clse07:690800", "ko": "「가끔은 유토네 얼굴이 보고 싶어져서」"},
{"id": "clse07:690900", "ko": "「잠깐 보고 올게」"},
{"id": "clse07:691000", "ko": "「우키밖에 없던데」"},
{"id": "clse07:691100", "ko": "「방이라……」"},
{"id": "clse07:691200", "ko": "「저기, 유토. 요즘 유이한테 뭔가 달라진 거 없어?」"},
{"id": "clse07:691300", "ko": "「글쎄…… 뭔가 고민하고 있다든가……」"},
{"id": "clse07:691400", "ko": "「노트에? 뭘?」"},
{"id": "clse07:691500", "ko": "「나야. 열어도 돼?」"},
{"id": "clse07:691600", "ko": "「응, 뭐…… 좀」"},
{"id": "clse07:691700", "ko": "「아니, 일단 오늘만이고 내일이면 다시 갈 거야」"},
{"id": "clse07:691800", "ko": "「그러고 보니 뭐 하고 있었어?」"},
{"id": "clse07:691900", "ko": "「유이」"},
{"id": "clse07:692000", "ko": "「혹시 무슨 고민 같은 거 있으면 말하렴. 언제든 상담해 줄 테니까」"},
{"id": "clse07:692100", "ko": "「괜찮아, 부끄러울 건 하나도 없단다. 젊을 때는 다들 고민하는 법이니까」"},
{"id": "clse07:692200", "ko": "「하지만 고민만 해서는 해결되지 않지. 때로는 누군가에게 기대는 걸로 해결되는 일도 있단다」"},
{"id": "clse07:692300", "ko": "「그래, 예를 들면 바로 나 같은 믿음직한 상대에게 말이지」"},
{"id": "clse07:692400", "ko": "「별거 아니야. 오빠로서 당연한 말을 했을 뿐이란다」"},
{"id": "clse07:692500", "ko": "「그럼 공부 열심히 하게나」"},
{"id": "clse07:692600", "ko": "「…………」"},
{"id": "clse07:692700", "ko": "「（쿠루스〜……）」"},
{"id": "clse07:692800", "ko": "「유이 녀석, 뭘 저렇게 허둥대는 거지?」"},
{"id": "clse07:692900", "ko": "「뭐 보고 싶은 거라도 있어?」"},
{"id": "clse07:693000", "ko": "「흐응. 아이돌 방송에 저렇게 빠지다니, 아직 애구나」"},
{"id": "clse07:693100", "ko": "「케, 케이 씨는 그런 거랑 다르잖아!」"},
{"id": "clse07:693200", "ko": "「응?」"},
{"id": "clse07:693300", "ko": "「이거…… 아무리 봐도 립싱크 아냐?」"},
{"id": "clse07:693400", "ko": "「립싱크…… 아이돌?」"},
{"id": "clse07:693500", "ko": "「어라? 이 애……」"},
{"id": "clse07:693600", "ko": "「타카야나기 모모네잖아! “소리 새는데” 사건의!」"},
{"id": "clse07:693700", "ko": "「어? 아…… 아아! 물론 알고 있었지! 당연하잖아!」"},
{"id": "clse07:693800", "ko": "「그, 그래. 당연, 하잖아. 아하하하하……」"},
{"id": "clse07:693900", "ko": "「그렇게 인기 있어?」"},
{"id": "clse07:694000", "ko": "「그, 그렇구나……」"},
{"id": "clse07:694100", "ko": "「사, 삼만 명!?」"},
{"id": "clse07:694200", "ko": "「어?」"},
{"id": "clse07:694300", "ko": "「어? 뭐, 뭐어, 그야 내가 모르는 건 없지만……」"}
]
