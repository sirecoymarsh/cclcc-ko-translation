[
{"id": "clse07:517300", "ko": "「없어없어없어없어없어없어」"},
{"id": "clse07:517400", "ko": "「그런그런그런그런」"},
{"id": "clse07:517500", "ko": "「설마설마설마설마」"},
{"id": "clse07:517600", "ko": "「있을 수 있겠냐!!!!!」"},
{"id": "clse07:517700", "ko": "「이토와 여자애의 관계는 일단 제쳐 두자」"},
{"id": "clse07:517800", "ko": "「사실로 셀 수 있는 건, 여자애가 이 셀카를 찍었을 때 옆에서 이토가 자고 있었다. 그것뿐이다」"},
{"id": "clse07:517900", "ko": "「……응? 기억하는 한?」"},
{"id": "clse07:518000", "ko": "「혹시!」"},
{"id": "clse07:518100", "ko": "「역시! 어제다!」"},
{"id": "clse07:518200", "ko": "「어젯밤 늦게, 적어도 이 여자애와 이토는 거기 있었다는 거지」"},
{"id": "clse07:518300", "ko": "「뭐, 있었다고 보는 게 타당하겠지」"},
{"id": "clse07:518400", "ko": "「알 수가 없군……」"},
{"id": "clse07:518500", "ko": "「……」"},
{"id": "clse07:518600", "ko": "「자, 그 밖에 딱히 특징적인 건 안 찍혀 있고, 풍경에서 얻을 수 있는 정보는 이 정도인 것 같군」"},
{"id": "clse07:518700", "ko": "「드디어 본진으로 진격하자」"},
{"id": "clse07:518800", "ko": "「이, 가운데 찍혀 있는 여자애 말인데……」"},
{"id": "clse07:518900", "ko": "「……」"},
{"id": "clse07:519000", "ko": "「아아아아아아아아아아!」"},
{"id": "clse07:519100", "ko": "「아, 안 돼 안 돼! 냉정해져!」"},
{"id": "clse07:519200", "ko": "「냉정하게. 냉정하게. 사실만을 골라내는 거야」"},
{"id": "clse07:519300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:519400", "ko": "「!」"},
{"id": "clse07:519500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:519600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:519700", "ko": "「!!」"},
{"id": "clse07:519800", "ko": "「그그그, 그러니까, 이 애가 누구인지는 얼굴로는 판단할 수 없다」"},
{"id": "clse07:519900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:520000", "ko": "「아아아아아아아아아아!」"},
{"id": "clse07:520100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:520200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:520300", "ko": "「……진정해. 우선 피사체를 특정하는 걸 우선하는 거야」"},
{"id": "clse07:520400", "ko": "「사진의 다른 부분에서 본인을 특정할 수 있는 정보는 없을까?」"},
{"id": "clse07:520500", "ko": "「음……」"},
{"id": "clse07:520600", "ko": "「으음……」"},
{"id": "clse07:520700", "ko": "「으으음……!」"},
{"id": "clse07:520800", "ko": "「으으으음……!!」"},
{"id": "clse07:520900", "ko": "「으으으으음……!!!」"},
{"id": "clse07:521000", "ko": "「……하아」"},
{"id": "clse07:521100", "ko": "「안 되겠군」"},
{"id": "clse07:521200", "ko": "「필요한 정보가 전혀 부족해」"},
{"id": "clse07:521300", "ko": "「이 사진만으로 특정하는 건 불가능해」"},
{"id": "clse07:521400", "ko": "「당연하지만, 추리 소설처럼 잘 풀리지는 않는군」"},
{"id": "clse07:521500", "ko": "「부실로 돌아가서 이토가 돌아오길 기다릴까」"},
{"id": "clse07:521600", "ko": "「다녀――」"},
{"id": "clse07:521700", "ko": "「어, 찍어 왔다고?」"},
{"id": "clse07:521800", "ko": "「아, 아니, 잠깐만」"},
{"id": "clse07:521900", "ko": "「기다리라니까!」"},
{"id": "clse07:522000", "ko": "「나는 조회 끝나고 곧장 부실로 갔어」"},
{"id": "clse07:522100", "ko": "「그랬더니 부실에는 카즈키밖에 없었어. 그래서 화장실에……」"},
{"id": "clse07:522200", "ko": "「응?」"},
{"id": "clse07:522300", "ko": "「말했다고? 내가?」"},
{"id": "clse07:522400", "ko": "「자, 잠깐만」"},
{"id": "clse07:522500", "ko": "「언제 어디서 내가 그런 말을 했는데?」"},
{"id": "clse07:522600", "ko": "「내?」"},
{"id": "clse07:522700", "ko": "「혹시 어젯밤에 다 같이 내 캠핑카에 왔었어?」"},
{"id": "clse07:522800", "ko": "「촬영? 그건 동아리 활동으로서?」"},
{"id": "clse07:522900", "ko": "「아아, 아니, 그러니까……」"},
{"id": "clse07:523000", "ko": "「시, 실은 말이야」"},
{"id": "clse07:523100", "ko": "「오늘 아침에 눈을 떴을 때 나는 교복을 입고 있었어」"},
{"id": "clse07:523200", "ko": "「힉!」"},
{"id": "clse07:523300", "ko": "「뭐, 뭐야!?」"},
{"id": "clse07:523400", "ko": "「……뭐어?」"},
{"id": "clse07:523500", "ko": "「아, 아니, 지금 중요한 건 그게 아니라――」"},
{"id": "clse07:523600", "ko": "「그 전에, 내가 왜 어제 교복을 입고 있었는지 누가 좀 알려 줄래」"},
{"id": "clse07:523700", "ko": "「과연……」"},
{"id": "clse07:523800", "ko": "「아니, 실은……」"},
{"id": "clse07:523900", "ko": "「어제 있었던 일을 전혀 기억 못 하겠어」"},
{"id": "clse07:524000", "ko": "「뭐, 뭐야?」"},
{"id": "clse07:524100", "ko": "「아, 아아……」"},
{"id": "clse07:524200", "ko": "「밤이라면, 뒤풀이라는 거 말이야? 응. 그것도 기억 안 나」"},
{"id": "clse07:524300", "ko": "「저, 저기, 대체 뭐가――」"},
{"id": "clse07:524400", "ko": "「뭐, 뭐야!」"},
{"id": "clse07:524500", "ko": "「다, 다들 대체 왜 그래!」"},
{"id": "clse07:524600", "ko": "「잊고 싶어진다? 빛나고 있었다?」"},
{"id": "clse07:524700", "ko": "「무슨 소리야 이토, 나 어제 뭘 한 거야!?」"},
{"id": "clse07:524800", "ko": "「……어?」"},
{"id": "clse07:524900", "ko": "「뭐어엇!?」"},
{"id": "clse07:525000", "ko": "「잠깐!」"},
{"id": "clse07:525100", "ko": "「확실히 기억은 안 나지만……」"},
{"id": "clse07:525200", "ko": "「아니 잠깐! 나는 기억 안 나지만, 너희는 다 같이 있었잖아!?」"},
{"id": "clse07:525300", "ko": "「내가 아리무라한테 뭔가 했는지 안 했는지는 너희가 더 잘 알 거 아냐!」"},
{"id": "clse07:525400", "ko": "「아아아, 아리무라!?」"},
{"id": "clse07:525500", "ko": "「그, 그런가……」"},
{"id": "clse07:525600", "ko": "「뭐어엇!?」"},
{"id": "clse07:525700", "ko": "「그런 말!?」"},
{"id": "clse07:525800", "ko": "「연설!? 내가!?」"},
{"id": "clse07:525900", "ko": "「노, 노래!?」"},
{"id": "clse07:526000", "ko": "「추추추추춤!?」"},
{"id": "clse07:526100", "ko": "「대체 어떤 추태를 보인 거야, 어제의 나는!?」"},
{"id": "clse07:526200", "ko": "「더 신경 쓰이잖아 그거!?」"},
{"id": "clse07:526300", "ko": "「알았어 이제 됐어. 이제 내 얘기는 안 물을 테니까」"},
{"id": "clse07:526400", "ko": "「어제 무슨 일이 있었는지 알려 줘」"},
{"id": "clse07:526500", "ko": "「아아」"},
{"id": "clse07:526600", "ko": "「쿠루스」"},
{"id": "clse07:526700", "ko": "「그랬구나. 미안, 이토」"},
{"id": "clse07:526800", "ko": "「……」"},
{"id": "clse07:526900", "ko": "「……그래서?」"},
{"id": "clse07:527000", "ko": "「아니 그러니까, 그 뒤엔?」"},
{"id": "clse07:527100", "ko": "「그럴 리가 없잖아! 거기엔 한 명이 더 있었을 거야!」"},
{"id": "clse07:527200", "ko": "「그건 이――!」"}
]
