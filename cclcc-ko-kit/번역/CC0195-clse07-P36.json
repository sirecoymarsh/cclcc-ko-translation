[
{"id": "clse07:338100", "ko": "「너 그거, 아리무라 앞에서도 똑같이 말할 수 있어?」"},
{"id": "clse07:338200", "ko": "「아빠가 전하래. 『애가 돈 걱정 같은 거 하는 거 아니다. 부모 등골은 빼먹으라고 있는 거야』래」"},
{"id": "clse07:338300", "ko": "「그 뒤로 아빠, 반주도 줄이고 전보다 더 열심히 일하고 있어. 덕분에 집 형편도 전만큼 나쁘진 않아」"},
{"id": "clse07:338400", "ko": "「그리고 유이랑 유토도 너를 보고 싶어 해. 그러니까…… 응?」"},
{"id": "clse07:338500", "ko": "「정말!?」"},
{"id": "clse07:338600", "ko": "「그래……」"},
{"id": "clse07:338700", "ko": "「알았어. 그래도 괜찮아. 조금씩 예전처럼 돌아와 준다면」"},
{"id": "clse07:338800", "ko": "「자, 그렇게 정해졌으면 가자!」"},
{"id": "clse07:338900", "ko": "「아…… 이런. 그랬지. 나도 참」"},
{"id": "clse07:339000", "ko": "「왜 그래?」"},
{"id": "clse07:339100", "ko": "「이상하긴. 자」"},
{"id": "clse07:339200", "ko": "「정말, 실례하겠습니다라니. 그 말을 할 거면 “다녀왔습니다”잖아?」"},
{"id": "clse07:339300", "ko": "「얘, 유토. 집 안에서는 뛰면 안 된다고 늘 말하잖아」"},
{"id": "clse07:339400", "ko": "「타쿠루. 밥, 충분했어?」"},
{"id": "clse07:339500", "ko": "「어차피 평소엔 아침도 제대로 안 먹지? 집에 있을 때만이라도 든든히 먹어야지」"},
{"id": "clse07:339600", "ko": "「유토, 유이! 손수건 여기 둔다〜」"},
{"id": "clse07:339700", "ko": "「벌써 현관에 준비해 뒀어」"},
{"id": "clse07:339800", "ko": "「아〜!」"},
{"id": "clse07:339900", "ko": "「정말! 아빠도 참, 또 이런 데 갈아입을 흰 가운을 두고 갔네」"},
{"id": "clse07:340000", "ko": "「잠깐 갖다주고 올 테니까, 기다려」"},
{"id": "clse07:340100", "ko": "（정말. 타쿠루도 참, 먼저 가 버리고）"},
{"id": "clse07:340200", "ko": "（정말이지, 남자애들이란……）"},
{"id": "clse07:340300", "ko": "（자, 그럼. 서둘러야지）"},
{"id": "clse07:340400", "ko": "「아, 미안. 오늘은 좀……」"},
{"id": "clse07:340500", "ko": "「응〜, 뭐, 그렇지……」"},
{"id": "clse07:340600", "ko": "「응. 그러니까 다음에. 미안해」"},
{"id": "clse07:340700", "ko": "「음…… 타쿠루는……」"},
{"id": "clse07:340800", "ko": "「아, 있다 있다…… 타쿠――」"},
{"id": "clse07:340900", "ko": "「…………」"},
{"id": "clse07:341000", "ko": "（어쩔 수 없지……）"},
{"id": "clse07:341100", "ko": "「아, 아니. 그런 건 아닌데, 좀……」"},
{"id": "clse07:341200", "ko": "「카, 카와하라는?」"},
{"id": "clse07:341300", "ko": "「아……」"},
{"id": "clse07:341400", "ko": "「저기, 혹시 괜찮으면…… 이거, 어때?」"},
{"id": "clse07:341500", "ko": "「별건 안 들었지만……」"},
{"id": "clse07:341600", "ko": "「아, 그게 아니라――」"},
{"id": "clse07:341700", "ko": "「그런 거……」"},
{"id": "clse07:341800", "ko": "「아, 카와하라. 그럼 나는 이만……」"},
{"id": "clse07:341900", "ko": "「아, 타쿠루? 미안. 늦는다고 카즈키한테 전했는데」"},
{"id": "clse07:342000", "ko": "「아, 미안. 이따 봐!」"},
{"id": "clse07:342100", "ko": "「지각. 자기가 불러 놓고 늦다니, 글렀네」"},
{"id": "clse07:342200", "ko": "「그래서…… 무슨 일이야? 도시락통만 돌려주는 거라면 굳이 이런 데까지 안 와도 됐잖아?」"},
{"id": "clse07:342300", "ko": "「아, 응…… 그래도 그건――」"},
{"id": "clse07:342400", "ko": "「어?」"},
{"id": "clse07:342500", "ko": "「저기, 카와하라……?」"},
{"id": "clse07:342600", "ko": "「잠깐, 아까부터 뭘――」"},
{"id": "clse07:342700", "ko": "「…………!」"},
{"id": "clse07:342800", "ko": "「…………」"},
{"id": "clse07:342900", "ko": "「엇?」"},
{"id": "clse07:343000", "ko": "「잠, 잠깐만――읏!!」"},
{"id": "clse07:343100", "ko": "「가, 갑자기 뭐 하는 거야!?」"},
{"id": "clse07:343200", "ko": "「그게 아니야. 내가 말하고 싶은 건 그런 게 아니라――」"},
{"id": "clse07:343300", "ko": "「카와하라. 너 여러 가지로 착각하고 있어」"},
{"id": "clse07:343400", "ko": "「그 도시락은 딱히 너를 위해 만든 게 아니야」"},
{"id": "clse07:343500", "ko": "「쑥스러워하는 거 아니야. 그건 원래 그…… 가족을 위해 만든 거야. 그런데 마침 필요 없어져서, 그러다 네가 배고파 보이길래」"},
{"id": "clse07:343600", "ko": "「그리고 미안하지만, 나, 너를 그냥 친구로밖에 볼 수 없어」"},
{"id": "clse07:343700", "ko": "「오해하게 했다면 미안해……」"},
{"id": "clse07:343800", "ko": "「아니야. 그런 게 아니야. 지금 나는 누구하고도 사귈 생각이 없어……」"},
{"id": "clse07:343900", "ko": "「으, 응……」"},
{"id": "clse07:344000", "ko": "「미안…… 해……」"},
{"id": "clse07:344100", "ko": "「…………」"},
{"id": "clse07:344200", "ko": "「미, 미안해, 늦어서」"},
{"id": "clse07:344300", "ko": "「타쿠루? 왜 그래?」"},
{"id": "clse07:344400", "ko": "「???」"},
{"id": "clse07:344500", "ko": "「뭐, 됐어. 그보다 오늘 동아리는 어떻게 할래?」"},
{"id": "clse07:344600", "ko": "「그래…… 그럼 오늘은 이걸로 해산할까」"},
{"id": "clse07:344700", "ko": "「아, 타쿠루! 오늘은 집에――」"},
{"id": "clse07:344800", "ko": "「그래……」"},
{"id": "clse07:344900", "ko": "「어떻게 된 거야, 그건!!」"},
{"id": "clse07:345000", "ko": "「그런 걸 묻는 게 아닙니다. 지금까지 학생회에서 그런 얘기, 한 번이라도 나온 적 없잖아요」"},
{"id": "clse07:345100", "ko": "「그걸 저런 식으로 학생회 성명으로 내다니, 무슨 생각인지 묻고 있는 겁니다」"},
{"id": "clse07:345200", "ko": "「그런 개인적인 얘기를 하는 게 아닙니다. 이런 바보 같은 교칙은 인정할 수 없어」"},
{"id": "clse07:345300", "ko": "「그건……」"},
{"id": "clse07:345400", "ko": "「읏…………」"},
{"id": "clse07:345500", "ko": "「기다려, 이토」"},
{"id": "clse07:345600", "ko": "「미안해. 다들 마음은 알지만, 신문부를 자칭하는 이상 우리는 어디까지나 중립적인 입장에 있어야 한다고 생각해……」"},
{"id": "clse07:345700", "ko": "「물론 나도 그런 교칙엔 반대야. 그래도 신문부인 우리가 인상을 조작하는 건 절대 해서는 안 되는 일이야. 아니야?」"},
{"id": "clse07:345800", "ko": "「상대가 비겁한 수를 썼다고 해서 우리가 똑같이 해도 된다는 이유는 안 돼」"},
{"id": "clse07:345900", "ko": "「아무튼 반대 의견 기사를 쓸 거면 똑같이 찬성 의견도 싣는다. 그게 신문부로서 올바른 모습 아닐까」"},
{"id": "clse07:346000", "ko": "「…………」"},
{"id": "clse07:346100", "ko": "「…………」"},
{"id": "clse07:346200", "ko": "「아…… 타쿠루……」"},
{"id": "clse07:346300", "ko": "「내 예상이 너무 안이했나 봐. 설마 이런 결과가 나올 줄이야……」"},
{"id": "clse07:346400", "ko": "「그럴까……」"},
{"id": "clse07:346500", "ko": "「알고 있어요. 아니면 뭐? 설마 이성과 이야기만 해도 안 된다고 할 생각이야?」"},
{"id": "clse07:346600", "ko": "「그러면…… 좋겠지만……」"},
