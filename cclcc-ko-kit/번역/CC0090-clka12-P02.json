[
{"id": "clka12:10000", "ko": "둘 다 사람 사귀는 게 서툴렀다."},
{"id": "clka12:10100", "ko": "둘 다 남과 이야기하는 게 서툴렀다."},
{"id": "clka12:10200", "ko": "둘 다 남의 마음을 헤아리는 게 서툴렀다."},
{"id": "clka12:10300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:10400", "ko": "하지만."},
{"id": "clka12:10500", "ko": "하지만 그런 둘이기에, 상대에게 힘이 되어 주고 싶다고 생각할 수 있다."},
{"id": "clka12:10600", "ko": "힘이 되어 주지 못하더라도, 곤란할 때 곁에 있어 주고 싶다고 생각할 수 있다."},
{"id": "clka12:10700", "ko": "곁에 있어 주지 못하더라도, 이 세상 어딘가에 그 사람이 있다고 생각할 수 있다."},
{"id": "clka12:10800", "ko": "그게 아주 멋진 일이라는 걸, 지금 나는 알고 있다."},
{"id": "clka12:10900", "ko": "분명."},
{"id": "clka12:11000", "ko": "분명, 지금 내 옆에서 귀까지 새빨개진 채 롤리팝 막대를 붕붕 흔들고 있는 이 여자애도."},
{"id": "clka12:11100", "ko": "분명 같은 마음일 거라고, 생각한다."},
{"id": "clka12:11200", "ko": "둘이서 부실 입구에 서서, 자연스럽게 둘이 함께 손잡이를 잡았다."},
{"id": "clka12:11300", "ko": "「앞으로도 잘 부탁해, 카즈키」"},
{"id": "clka12:11400", "ko": "「……」"},
{"id": "clka12:11500", "ko": "「……응」"},
{"id": "clka12:11600", "ko": "부실에는 이토, 노노, 세리카, 히나에가 모여 있었다. 이토가 앉아 있는 자리에 세 사람이 모여서, 뭔가 열심히 이야기하고 있다."},
{"id": "clka12:11700", "ko": "「다들, 어제는 고마웠어. 덕분에 살았어. 그치?」"},
{"id": "clka12:11800", "ko": "「응」"},
{"id": "clka12:11900", "ko": "「그래서, 실은 다들한테 알릴 게 있어서. 그치?」"},
{"id": "clka12:12000", "ko": "「응」"},
{"id": "clka12:12100", "ko": "「굳이 알리는 것도 좀 그렇다 싶긴 한데, 다들 도와줬으니까――」"},
{"id": "clka12:12200", "ko": "「――음?」"},
{"id": "clka12:12300", "ko": "아무도 내 말을 듣고 있지 않다. 이토가 들고 있는 뭔가를 보면서 떠들고 있다."},
{"id": "clka12:12400", "ko": "「저기, 다들――」"},
{"id": "clka12:12500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:12600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:12700", "ko": "「힉!!!」"},
{"id": "clka12:12800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:12900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:13000", "ko": "「히익!!!」"},
{"id": "clka12:13100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:13200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:13300", "ko": "「히이이이이이이익!!!!!!!!」"},
{"id": "clka12:13400", "ko": "틀림없다. 이토가 들고 있는 저건, 『하나』가 훔쳐 간 ⟦col:280aa02d1400⟧쿨 캣 프레스⟦col:800000⟧다!"},
{"id": "clka12:13500", "ko": "「이이이이이이, 이토!!!!!! 어어어어어, 어째서 네가 그걸 갖고 있는 거야!?」"},
{"id": "clka12:13600", "ko": "「어째서냐니, 부실에 왔더니 놓여 있었다고」"},
{"id": "clka12:13700", "ko": "「하, 하지만 그건 내가 어제 회수――」"},
{"id": "clka12:13800", "ko": "――아니, 잠깐."},
{"id": "clka12:13900", "ko": "회수는…… 안 했잖아?"},
{"id": "clka12:14000", "ko": "그때 카즈키는 분명 이 잡지를 손에 들고 있었다."},
{"id": "clka12:14100", "ko": "그리고 나에게 내밀었다."},
{"id": "clka12:14200", "ko": "그다음에,"},
{"id": "clka12:14300", "ko": "그다음에――"},
{"id": "clka12:14400", "ko": "――기억이…… 안 난다."},
{"id": "clka12:14500", "ko": "「카카카카카, 카즈키, 이건 대체――?」"},
{"id": "clka12:14600", "ko": "옆을 보니, 거기엔 아무도 없었다."},
{"id": "clka12:14700", "ko": "「카, 카즈키!?」"},
{"id": "clka12:14800", "ko": "「엥!?」"},
{"id": "clka12:14900", "ko": "어느새 카즈키는 창가 PC 앞에 앉아, 평소처럼 ⟦col:280aa02d1400⟧엠스⟦col:800000⟧를 시작하고 있었다."},
{"id": "clka12:15000", "ko": "「카, 카즈키!」"},
{"id": "clka12:15100", "ko": "내가 창가로 달려가려던 그때,"},
{"id": "clka12:15200", "ko": "「타쿠루〜? 이건 네가 쓴 거지?」"},
{"id": "clka12:15300", "ko": "「『츤데레가 지나치다』는 게 무슨 뜻인지 가르쳐 줄래?」"},
{"id": "clka12:15400", "ko": "……눈이 웃고 있지 않다."},
{"id": "clka12:15500", "ko": "「아, 아니 이건」"},
{"id": "clka12:15600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:15700", "ko": "「아니, 그게 말이지」"},
{"id": "clka12:15800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka12:15900", "ko": "「그, 그러니까!」"},
{"id": "clka12:16000", "ko": "「이, 이토! 도와줘!」"},
{"id": "clka12:16100", "ko": "「아, 나 불려 간 데가 있었지. 그럼 간다, 나머진 힘내라」"},
{"id": "clka12:16200", "ko": "「거짓말이지!?」"},
{"id": "clka12:16300", "ko": "「타쿠루?」"},
{"id": "clka12:16400", "ko": "「타쿠〜?」"},
{"id": "clka12:16500", "ko": "「미야시로 선배?」"},
{"id": "clka12:16600", "ko": "「갸아아아아아아아아아아아!!!!!!!」"},
{"id": "clka12:16700", "ko": "「……」"},
{"id": "clka12:16800", "ko": "「응……」"},
{"id": "clka12:16900", "ko": "「……후훗」"}
]
