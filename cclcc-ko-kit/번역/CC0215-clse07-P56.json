[
{"id": "clse07:537300", "ko": "「그, 그래! 맞아! 아리무라는 내가 거짓말 안 한다는 걸 알 수 있잖아!」"},
{"id": "clse07:537400", "ko": "「야, 아리무라, 모두한테 말해 줘. 내가 거짓말 안 하고 있다고」"},
{"id": "clse07:537500", "ko": "「너희는 나를 뭐라고 생각하는 거야!? 그보다 아리무라! 너 사실은 알면서 이 상황을 즐기고 있는 거지!」"},
{"id": "clse07:537600", "ko": "「너 말이야!」"},
{"id": "clse07:537700", "ko": "「침착하게 스마트폰 꺼내지 마, 쿠루스!」"},
{"id": "clse07:537800", "ko": "「진짜야! 메일로 불려 나갔다고!」"},
{"id": "clse07:537900", "ko": "「카즈키한테서, 『체육관 창고로 와』라고!」"},
{"id": "clse07:538000", "ko": "「이, 이것 봐 줘!」"},
{"id": "clse07:538100", "ko": "「봐!? 지, 진짜잖아!?」"},
{"id": "clse07:538200", "ko": "「기다리라니까! 진짜라고!」"},
{"id": "clse07:538300", "ko": "「윽」"},
{"id": "clse07:538400", "ko": "「그, 그건」"},
{"id": "clse07:538500", "ko": "「으윽……」"},
{"id": "clse07:538600", "ko": "「윽……」"},
{"id": "clse07:538700", "ko": "「……」"},
{"id": "clse07:538800", "ko": "「……」"},
{"id": "clse07:538900", "ko": "「……」"},
{"id": "clse07:539000", "ko": "（……하지만）"},
{"id": "clse07:539100", "ko": "「……」"},
{"id": "clse07:539200", "ko": "「……」"},
{"id": "clse07:539300", "ko": "「……」"},
{"id": "clse07:539400", "ko": "「……」"},
{"id": "clse07:539500", "ko": "「에엣!? 하지만 얼굴이 가려져 있었는데……」"},
{"id": "clse07:539600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:539700", "ko": "「그런 거야!?」"},
{"id": "clse07:539800", "ko": "「왜 내가 몰매를 맞고 있는 건데!?」"},
{"id": "clse07:539900", "ko": "「방금, 『저랑 하나』라고 했어?」"},
{"id": "clse07:540000", "ko": "「손쉽게라니, 너 진짜……!?」"},
{"id": "clse07:540100", "ko": "「장장장장, 장난하지 마!」"},
{"id": "clse07:540200", "ko": "「내 얘기는 아무래도 상관없잖아!」"},
{"id": "clse07:540300", "ko": "「우왓!?」"},
{"id": "clse07:540400", "ko": "「아…… 안, 돼!」"},
{"id": "clse07:540500", "ko": "「너는, 카즈키가 아니야, 그러니까!」"},
{"id": "clse07:540600", "ko": "「그 몸은, 카즈키의 것이지, 네 것이 아니야!」"},
{"id": "clse07:540700", "ko": "「그러니까, 그 몸을 네 멋대로 하는 건, 용납될 일이 아니잖아!」"},
{"id": "clse07:540800", "ko": "「어?」"},
{"id": "clse07:540900", "ko": "「뭐?」"},
{"id": "clse07:541000", "ko": "「아, 아아……」"},
{"id": "clse07:541100", "ko": "「딱히 아무것도 안 찍혀……」"},
{"id": "clse07:541200", "ko": "「……응?」"},
{"id": "clse07:541300", "ko": "「쿨 캣 프레스인가?」"},
{"id": "clse07:541400", "ko": "「……?」"},
{"id": "clse07:541500", "ko": "「……『바꿔』……?」"},
{"id": "clse07:541600", "ko": "「이번엔 꽤 많은 권수를 한꺼번에 가져다줬으니, 확인하기 힘들겠군」"},
{"id": "clse07:541700", "ko": "「자, 그럼 다음 호는……」"},
{"id": "clse07:541800", "ko": "「음, 별로 기대할 게 없겠군. 이제 와서 이 아이돌 수영복 같은 걸 실어 봤자……」"},
{"id": "clse07:541900", "ko": "「뭐, 일단은 훑어보자」"},
{"id": "clse07:542000", "ko": "「……음, 화보 페이지인가」"},
{"id": "clse07:542100", "ko": "「……」"},
{"id": "clse07:542200", "ko": "「생각보다, 괜찮은데」"},
{"id": "clse07:542300", "ko": "「이 아이돌은 이미 한물갔다고 생각했는데, 내가 잘못 봤나……?」"},
{"id": "clse07:542400", "ko": "「역시 쿨 캣 프레스, 얕볼 수 없군」"},
{"id": "clse07:542500", "ko": "「……」"},
{"id": "clse07:542600", "ko": "「……후우」"},
{"id": "clse07:542700", "ko": "「……이 호는, 보존 대상으로 하자」"},
{"id": "clse07:542800", "ko": "「자, 다른 페이지는……」"},
{"id": "clse07:542900", "ko": "「……」"},
{"id": "clse07:543000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:543100", "ko": "「가까운 여사친……?」", "note": "새 용어: 女友達 → 여사친(여자인 친구. 543900 잡지 문구와 같게)"},
{"id": "clse07:543200", "ko": "「이건……!」"},
{"id": "clse07:543300", "ko": "「……」"},
{"id": "clse07:543400", "ko": "「……」"},
{"id": "clse07:543500", "ko": "「……으, 응. 이건 훑어 두는 편이 좋을지도 모르겠군」"},
{"id": "clse07:543600", "ko": "「이, 이건 어디까지나, 대중의 관심 수준을 파악하는 게 목적이다」"},
{"id": "clse07:543700", "ko": "「내, 내가 무슨 불순한 생각을 품고 있는 건 아니라고」"},
{"id": "clse07:543800", "ko": "「이래서는 그냥 기자의 모에 포인트를 읽고 있는 것뿐이잖아…… 아아, 김빠지는군」"},
{"id": "clse07:543900", "ko": "「……『네 여사친을 네 취향대로 바꿔 보자』라」"},
{"id": "clse07:544000", "ko": "「하아. 시시하군」"},
{"id": "clse07:544100", "ko": "「……」"},
{"id": "clse07:544200", "ko": "「……」"},
{"id": "clse07:544300", "ko": "「……흠」"},
{"id": "clse07:544400", "ko": "「……시시하긴, 하지만」"},
{"id": "clse07:544500", "ko": "「『타입 1: 기 센 누나 계열』……이건 쿠루스겠군」"},
{"id": "clse07:544600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:544700", "ko": "「『타입 2: 천연 활발 소녀 계열』……오노에려나」"},
{"id": "clse07:544800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:544900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:545000", "ko": "「『타입 3: 호기심 왕성한 후배 계열』……뭐, 아리무라겠지」"},
{"id": "clse07:545100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:545200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:545300", "ko": "「『타입 4: 과묵한 신비 계열』……으음」"},
{"id": "clse07:545400", "ko": "「……이건, 카즈키려나?」"},
{"id": "clse07:545500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:545600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:545700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:545800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:545900", "ko": "「……좋아, 완성이다!」"},
{"id": "clse07:546000", "ko": "「한번 다시 읽어 볼까」"},
{"id": "clse07:546100", "ko": "「……」"},
{"id": "clse07:546200", "ko": "「……」"},
{"id": "clse07:546300", "ko": "「……징그럽다」"},
{"id": "clse07:546400", "ko": "「내가 봐도, 완전 질린다」"},
{"id": "clse07:546500", "ko": "「나는 왜 이런 한심한 일에 시간을 써 버린 거지」"},
{"id": "clse07:546600", "ko": "（어쩌지. 버릴까?）"},
{"id": "clse07:546700", "ko": "（아니, 안 돼. 다른 누군가가 주울 위험은 지고 싶지 않아）"},
{"id": "clse07:546800", "ko": "（방 안쪽에 넣어 두자. 영구 봉인이다）"},
{"id": "clse07:546900", "ko": "「이 서랍을 빼고, 여기에……」"},
{"id": "clse07:547000", "ko": "「아무한테도 들키지 않기를…… 그리고 나 자신이 이 잡지의 존재를 빨리 잊어버리기를……」"},
{"id": "clse07:547100", "ko": "「……」"},
{"id": "clse07:547200", "ko": "「좋아, 자자」"}
]
