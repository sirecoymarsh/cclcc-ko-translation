[
{"id": "clkn01:39600", "ko": "「네에~」⟦n⟧⟦par⟧「네에~」"},
{"id": "clkn01:39700", "ko": "그나저나 뭐야, 아까 그 망상은."},
{"id": "clkn01:39800", "ko": "매지컬 유이?"},
{"id": "clkn01:39900", "ko": "게다가 변신하는 데 왜 상자야?"},
{"id": "clkn01:40000", "ko": "악취미도 정도가 있지."},
{"id": "clkn01:40100", "ko": "「있잖아, 사실 나도 마술 할 줄 알아」"},
{"id": "clkn01:40200", "ko": "유토가 느닷없이 말했다."},
{"id": "clkn01:40300", "ko": "「유가 마술을?」"},
{"id": "clkn01:40400", "ko": "「어떤 마술인데요?」"},
{"id": "clkn01:40500", "ko": "「으음…… 설명하는 것보다 보여 주는 게 빠르려나?」"},
{"id": "clkn01:40600", "ko": "신나게 웃는 유토의 얼굴은 천진난만 그 자체였다."},
{"id": "clkn01:40700", "ko": "마술이라고 해 봤자 카드 마술이나 동전 마술 같은, 애들도 할 수 있을 법한 거겠지."},
{"id": "clkn01:40800", "ko": "「에헤헤, 다들 분명히 놀랄 거야」"},
{"id": "clkn01:40900", "ko": "게다가 유토니까 분명 속임수도 빤히 보일 것이다."},
{"id": "clkn01:41000", "ko": "그래도 거기선 어른으로서 순순히 속아 주는 척을 해 줘야겠지."},
{"id": "clkn01:41100", "ko": "「유이 누나, 도와줄래?」"},
{"id": "clkn01:41200", "ko": "「나? 뭐, 괜찮긴 한데……」"},
{"id": "clkn01:41300", "ko": "「그럼 이리 와」"},
{"id": "clkn01:41400", "ko": "유토는 유이를 일으켜 세우더니, 훌쩍 복도로 나갔다."},
{"id": "clkn01:41500", "ko": "「영차……」"},
{"id": "clkn01:41600", "ko": "잠시 후 돌아온 유토는 뭔가 기묘한 것을 안고 있었다."},
{"id": "clkn01:41700", "ko": "그건――상자였다."},
{"id": "clkn01:41800", "ko": "크고 작은 형형색색에 갖가지 모양인 상자들을 짜 맞춰서 어떤 ⟦rb⟧형체⟦rt⟧⟦rbc⟧●●⟦/r⟧를 본뜬 것처럼 보였다."},
{"id": "clkn01:41900", "ko": "――사람이다."},
{"id": "clkn01:42000", "ko": "상자는 누가 봐도 사람 모양이었다."},
{"id": "clkn01:42100", "ko": "유토는 능숙하게 상자 뚜껑을 전부 열고, 방긋 웃으며 말했다."},
{"id": "clkn01:42200", "ko": "「자, 누나. 이 안으로 들어가 줘」"},
{"id": "clkn01:42300", "ko": "「어…… 여기 들어가면 돼?」"},
{"id": "clkn01:42400", "ko": "「응」"},
{"id": "clkn01:42500", "ko": "몇 번이나 고개를 갸웃거리면서도, 시키는 대로 상자 속에 들어가는 유이."},
{"id": "clkn01:42600", "ko": "이윽고 유이의 몸이 전부 상자 안에 들어가자, 유토는 뚜껑을 모두 닫았다."},
{"id": "clkn01:42700", "ko": "이제 거기 누워 있는 건, 사람 모양으로 늘어놓은 상자――."},
{"id": "clkn01:42800", "ko": "왜일까."},
{"id": "clkn01:42900", "ko": "불길한 예감이 들었다."},
{"id": "clkn01:43000", "ko": "「자, 여러분. 보시다시피 지금 이 상자 안에는 유이 누나가 들어 있습니다. 그리고――」"},
{"id": "clkn01:43100", "ko": "유토가 작은 손가락을 딱 하고 튕기자, 거기에 묘한 모양의 검이 나타났다."},
{"id": "clkn01:43200", "ko": "그건――."},
{"id": "clkn01:43300", "ko": "「디소드……!」"},
{"id": "clkn01:43400", "ko": "거짓말이지?"},
{"id": "clkn01:43500", "ko": "유토가 기가로매니악스로 각성했다고?"},
{"id": "clkn01:43600", "ko": "그럴 수가……"},
{"id": "clkn01:43700", "ko": "그럼 유토의 능력은 뭐지?"},
{"id": "clkn01:43800", "ko": "「지금부터 이 상자를 산산조각 내 보겠습니다~」"},
{"id": "clkn01:43900", "ko": "「뭐……?」"},
{"id": "clkn01:44000", "ko": "「그럼 가겠습니다~. 하나, 둘!」"},
{"id": "clkn01:44100", "ko": "「기, 기다려, 유토! 그건――!」"},
{"id": "clkn01:44200", "ko": "말릴 틈도 없이, 유토는 그 작은 몸 어디에 그런 힘이 있나 싶을 만큼 크게 디소드를 치켜들었다가 단숨에 내리쳤다."},
{"id": "clkn01:44300", "ko": "그와 동시에."},
{"id": "clkn01:44400", "ko": "「꺄아아아아아아아아아아아아아아!!!」"},
{"id": "clkn01:44500", "ko": "귀를 찢는 듯한 비명이 터져 나왔다."},
{"id": "clkn01:44600", "ko": "「유토! 너 뭐 하는 거야!」"},
{"id": "clkn01:44700", "ko": "「뭐 하냐니, 그러니까 마술이잖아?」"},
{"id": "clkn01:44800", "ko": "「마술이라니…… 너, 방금 그 목소리……」"},
{"id": "clkn01:44900", "ko": "「그럼 이쪽도 간다. 얍!」"},
{"id": "clkn01:45000", "ko": "「끄아아아아아아아아아아아아악!!!」"},
{"id": "clkn01:45100", "ko": "다시 단말마 같은 비명."},
{"id": "clkn01:45200", "ko": "「그만해!!!」"},
{"id": "clkn01:45300", "ko": "「왜?」"},
{"id": "clkn01:45400", "ko": "왜냐고?"},
{"id": "clkn01:45500", "ko": "왜냐하면…… 이건."},
{"id": "clkn01:45600", "ko": "이런 건……"},
{"id": "clkn01:45700", "ko": "「어이어이, 타쿠루. 뭘 그렇게 기를 쓰냐」"},
{"id": "clkn01:45800", "ko": "「아, 아버지야말로 왜 태연하게 보고 있는 거야! 유이가 잘리고 있다고!」"},
{"id": "clkn01:45900", "ko": "「괜찮아. 마술이잖아?」"},
{"id": "clkn01:46000", "ko": "「후훗, 타쿠루 씨도 참, 그렇게까지 놀라다니」"},
{"id": "clkn01:46100", "ko": "마술?"},
{"id": "clkn01:46200", "ko": "말도 안 돼."},
{"id": "clkn01:46300", "ko": "저 목소리가 마술이 만들어 낸 거라고?"},
{"id": "clkn01:46400", "ko": "저 소리도, 목소리도――."},
{"id": "clkn01:46500", "ko": "게다가 이 냄새도?"},
{"id": "clkn01:46600", "ko": "냄새?"},
{"id": "clkn01:46700", "ko": "그래…… 이 냄새."},
{"id": "clkn01:46800", "ko": "――피다."},
{"id": "clkn01:46900", "ko": "잘린 상자 귀퉁이에서 새빨간 선혈이 뚝뚝 떨어지고 있었다."},
{"id": "clkn01:47000", "ko": "「자, 이 산산조각 난 상자가, 놀랍게도. 원래대로――」"},
{"id": "clkn01:47100", "ko": "여느 때처럼 천진난만하던 유토의 말이 갑자기 멈췄다."},
{"id": "clkn01:47200", "ko": "「어라? 이상하네…… 원래대로 안 돌아와?」"},
{"id": "clkn01:47300", "ko": "당연하다."},
{"id": "clkn01:47400", "ko": "왜냐하면, 그건……"},
{"id": "clkn01:47500", "ko": "「왜? 왜 원래대로 안 돌아오는 거야?」"},
{"id": "clkn01:47600", "ko": "이런 건 마술이고 뭐고 아니다."},
{"id": "clkn01:47700", "ko": "「있잖아, 타쿠루 형! 왜!? 왜 원래대로 안 돌아오는 거야!? 응!!」"},
{"id": "clkn01:47800", "ko": "무리다."},
{"id": "clkn01:47900", "ko": "이제 원래대로는 돌아오지 않는다."},
{"id": "clkn01:48000", "ko": "유이는……"},
{"id": "clkn01:48100", "ko": "유이는 이제……"},
{"id": "clkn01:48200", "ko": "「유…… 유이이이이이이이이이!!」"},
{"id": "clkn01:48300", "ko": "「뭐, 뭐야!? 갑자기?」"},
{"id": "clkn01:48400", "ko": "「어?」"},
{"id": "clkn01:48500", "ko": "「갑자기 큰 소리로 부르니까 깜짝 놀랐잖아」"},
{"id": "clkn01:48600", "ko": "「아……」"},
{"id": "clkn01:48700", "ko": "아차…… 또 망상에 빠져 버렸다."},
{"id": "clkn01:48800", "ko": "「그래서, 뭔데?」"},
{"id": "clkn01:48900", "ko": "「아, 아니…… 그…… 텔레비전은…… 나중에 봐라……」"},
{"id": "clkn01:49000", "ko": "「에에에에」"},
{"id": "clkn01:49100", "ko": "「안 돼, 유토. 모처럼 타쿠루가 돌아왔잖아. 오늘은 다 같이 이야기하자. 유이도, 알았지?」"},
{"id": "clkn01:49200", "ko": "「네에~」⟦n⟧⟦par⟧「네에~」"},
{"id": "clkn01:49300", "ko": "그나저나 뭐야, 아까 그 망상은."},
{"id": "clkn01:49400", "ko": "아무리 그래도 유토가 갑자기 그런 마술을 보여 주겠다고 할 리가 없잖아."},
{"id": "clkn01:49500", "ko": "게다가 상자?"}
]
