[
{"id": "clse07:407300", "ko": "「얘, 유이. 놀리지 마」"},
{"id": "clse07:407400", "ko": "「정말, 저 애도 참!」"},
{"id": "clse07:407500", "ko": "「타쿠루, 왜 그래?」"},
{"id": "clse07:407600", "ko": "「그래……」"},
{"id": "clse07:407700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:407800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:407900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408500", "ko": "「타쿠루……」"},
{"id": "clse07:408600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408700", "ko": "「있잖아, 타쿠루……」"},
{"id": "clse07:408800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:408900", "ko": "「기다렸지. 이제 다들 돌아가도 된대」"},
{"id": "clse07:409000", "ko": "「……응? 왜 그래, 카즈키?」"},
{"id": "clse07:409100", "ko": "「어디 아파!? 선생님한테 진찰받을래!?」"},
{"id": "clse07:409200", "ko": "「뭐?」"},
{"id": "clse07:409300", "ko": "「왜, 왜 그래?」"},
{"id": "clse07:409400", "ko": "「자, 다들 스톱! 거기까지〜!」"},
{"id": "clse07:409500", "ko": "「쿠노사토 씨도 말했잖아? 이번 일은 나쁜 꿈이었어. 그러니까 잊어버리라고. 응? 그러니까 이 얘기는 이제 끝」"},
{"id": "clse07:409600", "ko": "「네, 좋아. 그럼 돌아가자?」"},
{"id": "clse07:409700", "ko": "「아, 맞다. 모처럼이니까 아리무라도 카즈키도 오늘은 아오바 기숙사에서 자고 가지 않을래?」"},
{"id": "clse07:409800", "ko": "「응. 뭐랄까…… 오늘 밤은 왠지 다 같이 있고 싶은 기분이랄까. 그치, 유토, 우키?」"},
{"id": "clse07:409900", "ko": "「……?」"},
{"id": "clse07:410000", "ko": "「타, 쿠루……?」"},
{"id": "clse07:410100", "ko": "「타쿠루, 맞아?」"},
{"id": "clse07:410200", "ko": "「……… 응. 맡겨 둬, 타쿠루. 아오바 기숙사도, 신문부 애들도 절대 괜찮아. 지금은 이런 모습이지만…… 나는 쿠루스 노노잖아? 전 『헤키호 학원 학생회의 여제』를 믿어……」"},
{"id": "clse07:410300", "ko": "「……훌쩍……」"},
{"id": "clse07:410400", "ko": "「엇!? 아, 아니, 아무것도 아니야! 뭘 두고 왔나 싶었을 뿐이야. 지금 갈게」"},
{"id": "clse07:410500", "ko": "「……그날, 그때」"},
{"id": "clse07:410600", "ko": "「나는 이 빌어먹을 게임을……」"},
{"id": "clse07:410700", "ko": "「……클리어했다」"},
{"id": "clse07:410800", "ko": "「……이날, 이때」"},
{"id": "clse07:410900", "ko": "「나는 이 빌어먹을 게임을……」"},
{"id": "clse07:411000", "ko": "「……리타이어하겠습니다〜♥」"},
{"id": "clse07:411100", "ko": "「그런 고로, 다들! 이번 달이야말로 세상을 깜짝 놀라게 할 특종 기사를 손에 넣어 1면을 장식한다! 그게 우리 신문부의 사명이자 존재 이유다!」"},
{"id": "clse07:411200", "ko": "「그럼, 이번 달 호 편집 회의를 시작한다!」"},
{"id": "clse07:411300", "ko": "「이봐, 카즈키? 마침 끊기 좋은 데잖아? 지금부터 편집 회의 시작할 거니까 로그아웃을――」"},
{"id": "clse07:411400", "ko": "「'안 돼!'가 아니라, 로그아웃하라고!」"},
{"id": "clse07:411500", "ko": "「아니, 그게 아니라 로그아웃을 말이지……!」"},
{"id": "clse07:411600", "ko": "「아니아니아니! 잠깐, 이봐〜〜!」"},
{"id": "clse07:411700", "ko": "「'응〜?'이 아니야! 너, 얘기 안 들었어!? 지금부터 다 같이 편집 회의를 한다고!」"},
{"id": "clse07:411800", "ko": "「아, 아아, 미안……」"},
{"id": "clse07:411900", "ko": "「라니, 아니잖아〜!」"},
{"id": "clse07:412000", "ko": "「뭐, 뭐야, 그 박수는?」"},
{"id": "clse07:412100", "ko": "「장기자랑도 전통 예능도 아니니까!」"},
{"id": "clse07:412200", "ko": "「그보다, 아리무라!」"},
{"id": "clse07:412300", "ko": "「왜 매일 여기 있는 거야!? 너 신문부가 아니라 문예부원이잖아!」"},
{"id": "clse07:412400", "ko": "「뭘?」"},
{"id": "clse07:412500", "ko": "「뭐, 뭐라고〜!?」"},
{"id": "clse07:412600", "ko": "「핫!?」"},
{"id": "clse07:412700", "ko": "「이, 이상한 기대 같은 거 안 했어」"},
{"id": "clse07:412800", "ko": "「그, 그러니까 나는 딱히――」"},
{"id": "clse07:412900", "ko": "「아니, 뭐야 쿠루스. 아무튼 아리무라는 문예부로 돌아가」"},
{"id": "clse07:413000", "ko": "「뭐야, 그 이유는!?」"},
{"id": "clse07:413100", "ko": "「……… 아리무라 건은 알았어. 하지만! 아무튼 편집 회의만큼은 할 거니까. 다들 진지하게 내 얘기 들어」"},
{"id": "clse07:413200", "ko": "「자, 다들 이 보드를 봐 줘. 최근 시부야에서 일어난 유명한 사건들을 정리해 봤어. 이 중에서 기사로 만들 수 있을 것 같은 걸 고르려고 해」"},
{"id": "clse07:413300", "ko": "「우선 『이쪽 보지 마〜! 사건』」"},
{"id": "clse07:413400", "ko": "「피해자는 니코니야 동화에서 『나님, 미래가 보여 버리는 건에 대하여』라는 생방송을 하던 21세 프리터다. 이름과 얼굴 사진은――」"},
{"id": "clse07:413500", "ko": "（아니, 아니야. 피해자는 남자잖아? 다시 생각해）"},
{"id": "clse07:413600", "ko": "（이 녀석은 인터넷 기자 와타베다. 『이쪽 보지 마〜!』의 피해자가 아니야）"},
{"id": "clse07:413700", "ko": "（그게 아니야. 사진을 더 잘 봐）"},
{"id": "clse07:413800", "ko": "「그래. 피해자는 이 오타니 유마였지」"},
{"id": "clse07:413900", "ko": "「다음은 『소리 새는데! 사건』. 그 피해자는――」"},
{"id": "clse07:414000", "ko": "「응, 그래. 타카야나기 모모네였지」"},
{"id": "clse07:414100", "ko": "（아니, 아니야. 더 잘 생각해）"},
{"id": "clse07:414200", "ko": "（그러니까 아니잖아. 제대로 떠올려）"},
{"id": "clse07:414300", "ko": "「그리고 세 번째 『회전 제트 사건』. 이 사건으로 피해를 입은 건――」"},
{"id": "clse07:414400", "ko": "（와타베는 이 사건과 관계없어. 잘 떠올려 봐）"},
{"id": "clse07:414500", "ko": "「그래. 카키타 히로노부였지」"},
{"id": "clse07:414600", "ko": "「분명 아리무라는 카키타랑 아는 사이 아니었나?」"},
{"id": "clse07:414700", "ko": "「그런가. 정보는 별로 기대할 수 없겠네……」"},
{"id": "clse07:414800", "ko": "「그럼 다음. 이건 바로 최근에 일어난 사건이다」"},
{"id": "clse07:414900", "ko": "「유명 인터넷 기자 와타베가 휘말린 『고맙스모 사건』」", "note": "ごっつァンデス(스모 선수의 「잘 먹겠습니다/고맙습니다」 말버릇) — 「고맙스모」로 옮김"},
{"id": "clse07:415000", "ko": "「이 네 개 중에서 어느 걸 취재해야 할지 검토하고 싶은데……」"},
{"id": "clse07:415100", "ko": "「각각 어떤 사건이었는지 다들 기억해? 어때, 오노에?」"},
{"id": "clse07:415200", "ko": "「이봐 이봐, 사건 나고 아직 그렇게 안 지났다고? 잘 들어? 어떤 사건이었냐 하면――」"},
{"id": "clse07:415300", "ko": "「우선 『이쪽 보지 마〜! 사건』은――』"},
{"id": "clse07:415400", "ko": "（아니, 그건 다른 사건이다. 다시 생각하자）"},
{"id": "clse07:415500", "ko": "（이 사건은 아니야. 좀 더 생각해 볼까）"},
{"id": "clse07:415600", "ko": "「그래. 이게 『이쪽 보지 마〜! 사건』의 개요지」"},
{"id": "clse07:415700", "ko": "（아니, 아니야. 이건 다른 사건이었을 텐데）"},
{"id": "clse07:415800", "ko": "「다음은 『소리 새는데 사건』」"},
{"id": "clse07:415900", "ko": "（아니군. 이건 다른 사건 얘기다）"},
{"id": "clse07:416000", "ko": "（아니아니, 오답이다. 침착하게 떠올려）"},
{"id": "clse07:416100", "ko": "「응. 이게 『소리 새는데 사건』이라고 불리는 거다」"},
{"id": "clse07:416200", "ko": "「그리고 『회전 제트 사건』」"},
{"id": "clse07:416300", "ko": "「이건 아니군. 다른 사건이다」"},
{"id": "clse07:416400", "ko": "「응, 이게 이른바 『회전 제트 사건』이지」"},
{"id": "clse07:416500", "ko": "「그리고 최신 사건이 이거다. 『고맙스모 사건』」"},
{"id": "clse07:416600", "ko": "「그런 고로. 정리는 이상이다」"},
{"id": "clse07:416700", "ko": "「그래서 아까도 말했지만, 이 네 개 중에서 어느 걸 기사로 하면 좋을지 고민 중이다. 그러니 다들 의견을 들려줬으면 해. 기탄없이 말해 줘」"},
{"id": "clse07:416800", "ko": "「다만 이 네 개 중에서 어느 걸 기사로 하면 좋을지 고민 중이야. 그러니 다들 의견을 들려줬으면 해. 기탄없이 말해 줘」"},
{"id": "clse07:416900", "ko": "「………」"},
{"id": "clse07:417000", "ko": "「크하앗〜〜」"},
{"id": "clse07:417100", "ko": "「오, 오노에도 쿠루스도, 사양할 필요 없다고……」"},
{"id": "clse07:417200", "ko": "「아, 아니, 괜찮아. 거꾸로 말하면 요즘 시부야가 평화롭다는 거니까. 하하하……」"}
]
