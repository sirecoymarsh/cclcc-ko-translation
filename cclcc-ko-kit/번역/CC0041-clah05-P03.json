[
{"id": "clah05:20000", "ko": "「그런 건 됐으니까, 빨리 눈 감아 주세요!」"},
{"id": "clah05:20100", "ko": "「아, 알았어!」"},
{"id": "clah05:20200", "ko": "「자, 자, 감았어」"},
{"id": "clah05:20300", "ko": "「진짜예요?」"},
{"id": "clah05:20400", "ko": "「아, 응……」"},
{"id": "clah05:20500", "ko": "이윽고 손바닥에 전해지던 온기가 천천히 사라져 갔다."},
{"id": "clah05:20600", "ko": "조금…… 아니, 꽤 아쉬운 기분도 든다……"},
{"id": "clah05:20700", "ko": "「읏…… 눈 뜨면 안 되니까요!」"},
{"id": "clah05:20800", "ko": "「아, 알고 있어……」", "note": "원문 「わ。」 의 마침표는 쉼표 오타로 봄"},
{"id": "clah05:20900", "ko": "냄비를 내려놓은 아리무라가 허둥지둥 옷을 들고 세면실로 가는 기척이 났다."},
{"id": "clah05:21000", "ko": "「하아아〜……」"},
{"id": "clah05:21100", "ko": "……위험할 뻔했다."},
{"id": "clah05:21200", "ko": "어떻게든 침착하려고 애써서 넘기긴 했지만, 솔직히 아슬아슬했던 것 같다."},
{"id": "clah05:21300", "ko": "그보다, 대체 무슨 생각인 거야, 그 녀석은."},
{"id": "clah05:21400", "ko": "설마 방금 것도 계산이었던 건…… 아니겠지, 아무리 그래도."},
{"id": "clah05:21500", "ko": "내가 아니었으면 이성을 잃었어도 이상하지 않았을 거라고."},
{"id": "clah05:21600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:21700", "ko": "안 돼."},
{"id": "clah05:21800", "ko": "떠올리지 마!"},
{"id": "clah05:21900", "ko": "떠올렸다간 끝장이야, 한 방에 넘어간다고!"},
{"id": "clah05:22000", "ko": "（그래도…… 이렇게 된 이상, 이제 그래도……）"},
{"id": "clah05:22100", "ko": "내가 그런 식으로"},
{"id": "clah05:22200", "ko": "「어?」"},
{"id": "clah05:22300", "ko": "「꺄앗!!!」"},
{"id": "clah05:22400", "ko": "갑자기 뭔가 터지는 듯한 소리가 나는가 싶더니, 이번에는 실내가 캄캄해졌다."},
{"id": "clah05:22500", "ko": "「자, 잠깐 선배! 이상한 장난은 그만하세요!」"},
{"id": "clah05:22600", "ko": "「아, 아니야. 내가 아니야. 차단기가 내려간 거야」"},
{"id": "clah05:22700", "ko": "「깜, 깜깜해서 아무것도 안 보이는데요!!!」"},
{"id": "clah05:22800", "ko": "「잠깐 기다려. 눈이 익숙해지면 어떻게든 할 테니까」"},
{"id": "clah05:22900", "ko": "「그, 그렇게 말해 봤자…… 앗!」"},
{"id": "clah05:23000", "ko": "「아, 아리무――!」"},
{"id": "clah05:23100", "ko": "「히야아아아아앗!!」"},
{"id": "clah05:23200", "ko": "「으…… 으읏!?」"},
{"id": "clah05:23300", "ko": "「아파아……」"},
{"id": "clah05:23400", "ko": "아리무라가…… 내 위에……"},
{"id": "clah05:23500", "ko": "게다가 옷 갈아입던 중이었다는 건…… 설마……"},
{"id": "clah05:23600", "ko": "「응? 이 감촉…… 혹시 미야시로 선배!?」"},
{"id": "clah05:23700", "ko": "「바보야, 움직이지 마! 위험해!」"},
{"id": "clah05:23800", "ko": "「아……」"},
{"id": "clah05:23900", "ko": "테이블 위에는 아까 아리무라가 막 가져온 냄비를 비롯해 아직 따뜻한 요리가 놓여 있다."},
{"id": "clah05:24000", "ko": "섣불리 넘어져서 엎기라도 하면 큰일이다."},
{"id": "clah05:24100", "ko": "그렇다고 이 자세 그대로 있을 수도 없고……", "note": "원문 「体制」 는 「体勢」(자세) 오타로 봄"},
{"id": "clah05:24200", "ko": "「아, 아무것도 안 보여요…… 그쵸」"},
{"id": "clah05:24300", "ko": "「그, 그러게…… 말이야……」"},
{"id": "clah05:24400", "ko": "하고 말했지만 거짓말이다."},
{"id": "clah05:24500", "ko": "내 눈은 점점 어둠에 익숙해지기 시작했다."},
{"id": "clah05:24600", "ko": "어둠 속에서 차츰 아리무라의 모습이 어렴풋이 떠오른다."},
{"id": "clah05:24700", "ko": "아니나 다를까, 아리무라는 한창 옷을 갈아입던 중이다……"},
{"id": "clah05:24800", "ko": "참고로 아리무라는 아까 내 말이 거짓말이라는 걸 모를 것이다."},
{"id": "clah05:24900", "ko": "왜냐하면 아리무라의 능력은 상대의 눈을 보고 있을 때가 아니면 발동하지 않으니까."},
{"id": "clah05:25000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:25100", "ko": "「읏……!」"},
{"id": "clah05:25200", "ko": "「어, 어라아? 서, 선배…… 혹시…… 두근거리고 있어요?」"},
{"id": "clah05:25300", "ko": "「아, 아니야! 그보다 그런 소리 할 때냐!」"},
{"id": "clah05:25400", "ko": "물론 그것도 거짓말이다."},
{"id": "clah05:25500", "ko": "아까부터 연달아 몰아치는데, 두근거리지 않는 쪽이 이상한 거다."},
{"id": "clah05:25600", "ko": "「어, 어떡하죠……」"},
{"id": "clah05:25700", "ko": "「어떻게…… 할까……」"},
{"id": "clah05:25800", "ko": "아리무라가 말할 때마다 그 숨결이 귓가를 간질인다."},
{"id": "clah05:25900", "ko": "만약 아리무라가 이 심장 소리를 듣기라도 하면, 승부는 내 패배가 되고 만다."},
{"id": "clah05:26000", "ko": "「아……」"},
{"id": "clah05:26100", "ko": "「왜, 왜 그래요?」"},
{"id": "clah05:26200", "ko": "「있다. 불 켤 방법……」"},
{"id": "clah05:26300", "ko": "「진짜예요?」"},
{"id": "clah05:26400", "ko": "그래."},
{"id": "clah05:26500", "ko": "내 능력만 쓰면……"},
{"id": "clah05:26600", "ko": "「켜도…… 될까?」"},
{"id": "clah05:26700", "ko": "「아, 잠깐만요!」"},
{"id": "clah05:26800", "ko": "「저기…… 한 번 더 눈 감아 주세요」"},
{"id": "clah05:26900", "ko": "왜 저러지?"},
{"id": "clah05:27000", "ko": "어쩐지 아까와는 딴판으로 얌전한 목소리가 되어 있다."},
{"id": "clah05:27100", "ko": "「눈 감았어요?」"},
{"id": "clah05:27200", "ko": "「응……」"},
{"id": "clah05:27300", "ko": "「…………」"},
{"id": "clah05:27400", "ko": "「…………」"},
{"id": "clah05:27500", "ko": "「…………」"},
{"id": "clah05:27600", "ko": "그런데 아리무라는 어째서인지 움직이려 하지 않았다."},
{"id": "clah05:27700", "ko": "「아리무라?」"},
{"id": "clah05:27800", "ko": "「아, 저기…… 그럼…… 부탁해요」"},
{"id": "clah05:27900", "ko": "「으, 응……」"},
{"id": "clah05:28000", "ko": "나는 마음속으로 명령했다."},
{"id": "clah05:28100", "ko": "올라가라."},
{"id": "clah05:28200", "ko": "차단기여, 올라가라."},
{"id": "clah05:28300", "ko": "「아……」"},
{"id": "clah05:28400", "ko": "철컥 소리와 함께 눈꺼풀 안쪽을 채우고 있던 검은빛이 붉은빛으로 바뀌었다."},
{"id": "clah05:28500", "ko": "그리고 잠시 후 몸 위의 무게와 온기가 사라졌다."},
{"id": "clah05:28600", "ko": "「후우……」"},
{"id": "clah05:28700", "ko": "어쩐지…… 아까 아리무라, 상태가 이상했지."},
{"id": "clah05:28800", "ko": "무슨 일 있었던 걸까."},
{"id": "clah05:28900", "ko": "「아……」"},
{"id": "clah05:29000", "ko": "「읏…………」"},
{"id": "clah05:29100", "ko": "「저기, 아리무라――」"},
{"id": "clah05:29200", "ko": "「스토〜옵!!」"},
{"id": "clah05:29300", "ko": "「어?」"},
{"id": "clah05:29400", "ko": "「아까 그 일련의 사건은 믿는 도끼에 발등 찍혔다 치고 잊어버리죠」", "note": "飼い犬に手を噛まれる 와 犬に噛まれたと思って忘れる 를 섞은 말실수 → 「믿는 도끼에 발등 찍히다」와 「개한테 물렸다 치고 잊다」를 섞은 꼴로"},
{"id": "clah05:29500", "ko": "여러모로 틀렸지만, 무슨 말을 하고 싶은지는 알겠다."},
{"id": "clah05:29600", "ko": "「그, 그렇지……」"},
{"id": "clah05:29700", "ko": "라고는 했지만, 그런 강렬한 체험을 잊을 자신은 물론 없다."},
{"id": "clah05:29800", "ko": "「조, 좋〜아. 그럼 밥 먹을까요?」"},
{"id": "clah05:29900", "ko": "「어? 아, 응…… 그래……」"}
]
