[
{"id": "clse07:949500", "ko": "「……미안, 타쿠루 오빠……」"},
{"id": "clse07:949600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:949700", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:949800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:949900", "ko": "「그럼 내일 또 봐, 바이바이~!」"},
{"id": "clse07:950000", "ko": "「…………」"},
{"id": "clse07:950100", "ko": "「유이…… 예요……」"},
{"id": "clse07:950200", "ko": "", "note": "보류 — 성적 강요 묘사(미성년 인물을 감금하고 성적으로 괴롭히는 방송, 원래 장면 clyu18:11900~ 950200~951500)"},
{"id": "clse07:950300", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:950400", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:950500", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:950600", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:950700", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:950800", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:950900", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:951000", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:951100", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:951200", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:951300", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:951400", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:951500", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clse07:951600", "ko": "「그럴 수가!!」"},
{"id": "clse07:951700", "ko": "「읏……」"},
{"id": "clse07:951800", "ko": "「그렇지 않단 말야! 분명 와 줄 거란 말야!」"},
{"id": "clse07:951900", "ko": "「오빠가…… 타쿠루 오빠가 꼭 와 줄 거란 말야!」"},
{"id": "clse07:952000", "ko": "「타쿠루 오빠가 분명 구하러 와 줄 거란 말야!」"},
{"id": "clse07:952100", "ko": "「읏……」"},
{"id": "clse07:952200", "ko": "「읏……」"},
{"id": "clse07:952300", "ko": "「와…… 줄 거란 말야…… 꼭……」"},
{"id": "clse07:952400", "ko": "「타쿠루 오빠!!」"},
{"id": "clse07:952500", "ko": "「타쿠루 오빠!!」"},
{"id": "clse07:952600", "ko": "「응…… 꼭 와 줄 거라고 생각했어……」"},
{"id": "clse07:952700", "ko": "「타쿠루 오빠……」"},
{"id": "clse07:952800", "ko": "「응…… 괜찮아……」"},
{"id": "clse07:952900", "ko": "「아니. 유는 잘못 없어. 따지고 보면 내가 끌어들였는걸」"},
{"id": "clse07:953000", "ko": "「……있잖아, 타쿠루 오빠……」"},
{"id": "clse07:953100", "ko": "「와 줘서 기뻤어. 고마워……」"},
{"id": "clse07:953200", "ko": "「…………」"},
{"id": "clse07:953300", "ko": "", "note": "보류 — 성적 강요 묘사의 연장(미성년)"},
{"id": "clse07:953400", "ko": "「아, 아무튼 타쿠루 오빠는 저쪽으로 가!!」"},
{"id": "clse07:953500", "ko": "「정말! 그런 게 아니라…… 아, 아무튼 빨리 저쪽으로……!」"},
{"id": "clse07:953600", "ko": "", "note": "보류 — 성적 강요 묘사의 연장(미성년)"},
{"id": "clse07:953700", "ko": "", "note": "보류 — 성적 강요 묘사의 연장(미성년)"},
{"id": "clse07:953800", "ko": "", "note": "보류 — 성적 강요 묘사의 연장(미성년)"},
{"id": "clse07:953900", "ko": "", "note": "보류 — 성적 강요 묘사의 연장(미성년)"},
{"id": "clse07:954000", "ko": "「정말~, 뭘 웃어?」"},
{"id": "clse07:954100", "ko": "「진짜…… 싫어해 버릴 거니까!」"},
{"id": "clse07:954200", "ko": "「거짓말…… 이야」"},
{"id": "clse07:954300", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:954400", "ko": "「우리, 아이돌 활동 그만둘래」"},
{"id": "clse07:954500", "ko": "「그러니까, 아이돌 활동 그만둔다고」"},
{"id": "clse07:954600", "ko": "「응, 괜찮아. 역시 아이돌 활동 같은 건 우리한테는 과분했던 거야」"},
{"id": "clse07:954700", "ko": "「괜찮아? 그만둬도……」"},
{"id": "clse07:954800", "ko": "「타쿠루 오빠…… 고마워」"},
{"id": "clse07:954900", "ko": "「나 있지, 타쿠루 오빠 덕분에 엄청 즐거웠어」"},
{"id": "clse07:955000", "ko": "「아니, 괜찮아. 그리고 있지, 나 알게 된 게 있어」"},
{"id": "clse07:955100", "ko": "「아이돌은 말야, 누군가를 힘나게 해 줄 수 있는 존재라고 타쿠루 오빠가 말했지?」"},
{"id": "clse07:955200", "ko": "「그건, 힘나게 해 줄 상대가 한 명뿐이라도 아이돌이 될 수 있다는 거지?」"},
{"id": "clse07:955300", "ko": "「그렇다면 말야」"},
{"id": "clse07:955400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:955500", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:955600", "ko": "「……용서받고 싶어?」"},
{"id": "clse07:955700", "ko": "「그럼, 귀 좀 빌려줘」"},
{"id": "clse07:955800", "ko": "「됐으니까 빌려줘」"},
{"id": "clse07:955900", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:956000", "ko": "「에헤헤」"},
{"id": "clse07:956100", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:956200", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:956300", "ko": "「안 돼~, 타쿠루 오빠는 이제 나가면 안 된단 말야~」"},
{"id": "clse07:956400", "ko": "「그렇지 않단 말야. 남매니까 보통이야」"},
{"id": "clse07:956500", "ko": "「에헤헤~」"},
{"id": "clse07:956600", "ko": "「어라, 뭐야? 타쿠루 오빠는 내가 아이돌이 되는 게 좋았어?」"},
{"id": "clse07:956700", "ko": "「음~, 그건 그렇지만, 그래도 괜찮아. 지금은 다른 꿈이 있으니까」"},
{"id": "clse07:956800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:956900", "ko": "「아~, 봐 봐. 저거 귀엽다~」"},
{"id": "clse07:957000", "ko": "", "note": "보류 — 성적 묘사(미성년·가족): 진열된 야한 속옷을 두고 하는 말(본편 clyu22:3500)"},
{"id": "clse07:957100", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:957200", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:957300", "ko": "「아~, 봐, 저거, 멋지다」"},
{"id": "clse07:957400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:957500", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:957600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:957700", "ko": "「있잖아, 타쿠루 오빠……」"},
{"id": "clse07:957800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:957900", "ko": "「선생님~? 쿠노사토 선생니임?」"},
{"id": "clse07:958000", "ko": "「말도 안 돼~? 설마 아직 자는 거야~? 벌써 4시인데?」"},
{"id": "clse07:958100", "ko": "「방금 엄청난 하품 소리가 들렸는데」"},
{"id": "clse07:958200", "ko": "「그야 선생님은 선생님이란 말야. 오늘은 산수 공부 봐 주는 날이잖아? 잊어버린 거야?」"},
{"id": "clse07:958300", "ko": "「벌써 3일이나 전이야. 아~아, 역시 잠이 덜 깼네」"},
{"id": "clse07:958400", "ko": "「빨리 해, 쿠노사토 선생님. 5분 안에」"},
{"id": "clse07:958500", "ko": "「어차피 3일 전부터 방 청소를 안 했을 뿐이잖아? 내가 할게」"},
{"id": "clse07:958600", "ko": "「그거, 저번에도 똑같이 말했잖아?」"},
{"id": "clse07:958700", "ko": "「나, 공부를 배워도, 그…… 수업료라든가 사례금이라든가 아무것도 못 내니까, 그 대신이랄까…… 사양 안 해도 돼」"},
{"id": "clse07:958800", "ko": "「아무튼 방 정리 같은 건 나한테 맡겨 줘, 응, 선생님?」"},
{"id": "clse07:958900", "ko": "「안녕하세요, 실례합니다~. ……우와아~?!」"},
{"id": "clse07:959000", "ko": "「이걸 15분 만에 어떻게 할 수 있을 거라고 생각했어?! 그보다, 어떻게 하면 3일 만에 이렇게 더러워지는 걸까?」"},
{"id": "clse07:959100", "ko": "「나는 변호사가 될 거라니까!」"},
{"id": "clse07:959200", "ko": "「이제 그만하라니까, 둘 다. 그보다 쿠노사토 선생님? 다음에 히나에 누나한테도 공부 좀 가르쳐 줘」"},
{"id": "clse07:959300", "ko": "「히나에 누나 말야, 다음 시험에서 좋은 점수 못 받으면 유급할지도 모른대……」"},
{"id": "clse07:959400", "ko": "「아. 그게…… 하나 누나가 걱정하고 있어서……」"}
]
