[
{"id": "clse07:467300", "ko": "「그렇게 말씀하셔도요……!」"},
{"id": "clse07:467400", "ko": "「아, 선생님! 잠깐――」"},
{"id": "clse07:467500", "ko": "「카, 카와하라!!! 마침 잘 왔어!」"},
{"id": "clse07:467600", "ko": "「그게…… 딱히……」"},
{"id": "clse07:467700", "ko": "「그, 그렇죠!!」"},
{"id": "clse07:467800", "ko": "「그, 그럼 저희는……」"},
{"id": "clse07:467900", "ko": "「네?」"},
{"id": "clse07:468000", "ko": "「뭐……?」"},
{"id": "clse07:468100", "ko": "「네!? 자, 잠깐만요!!」"},
{"id": "clse07:468200", "ko": "「그런! 아까랑 하는 말이 다르――」"},
{"id": "clse07:468300", "ko": "「잠깐! 나는 아직 할 말이――」"},
{"id": "clse07:468400", "ko": "「그게……」"},
{"id": "clse07:468500", "ko": "「어?」"},
{"id": "clse07:468600", "ko": "「……화, 확실히 학교랑 학생회는 괜찮다고 했지만, 역시 보통으로 생각하면 곤란하지 않아?」"},
{"id": "clse07:468700", "ko": "「노, 농담하지 마!! 나는 절대로 그런 짓 안 해!」"},
{"id": "clse07:468800", "ko": "「쿠, 쿠루스〜……!」"},
{"id": "clse07:468900", "ko": "「그런〜」"},
{"id": "clse07:469000", "ko": "「하아……」"},
{"id": "clse07:469100", "ko": "「…………」"},
{"id": "clse07:469200", "ko": "「아, 아뇨…… 지금은 딱히……」"},
{"id": "clse07:469300", "ko": "「신조 씨! 부탁이 있는데요」"},
{"id": "clse07:469400", "ko": "「네, 실은……」"},
{"id": "clse07:469500", "ko": "「아무것도, 요?」"},
{"id": "clse07:469600", "ko": "「제가요? 왜요!」"},
{"id": "clse07:469700", "ko": "「그런…… 저도 아직 미성년자라고요?」"},
{"id": "clse07:469800", "ko": "「……제가 어디가 특이하다는 거예요?」"},
{"id": "clse07:469900", "ko": "「……그래도 상대는 그 아리무라라고요?」"},
{"id": "clse07:470000", "ko": "「그건……」"},
{"id": "clse07:470100", "ko": "「…………」"},
{"id": "clse07:470200", "ko": "「아, 아아…… 어서 와……」"},
{"id": "clse07:470300", "ko": "「뭐야. 뭘 그렇게 잔뜩 사 왔어?」"},
{"id": "clse07:470400", "ko": "「……무슨 소리야?」"},
{"id": "clse07:470500", "ko": "「전혀」"},
{"id": "clse07:470600", "ko": "「엥……?」"},
{"id": "clse07:470700", "ko": "「그러니까 그건 네가 쓴 대본대로 한 거니까 당연한 거고……」"},
{"id": "clse07:470800", "ko": "「……홀딱?」"},
{"id": "clse07:470900", "ko": "（그런 것만 없으면 아리무라도 좀……）"},
{"id": "clse07:471000", "ko": "「음……」"},
{"id": "clse07:471100", "ko": "「아니, 잠깐! 그건――!」"},
{"id": "clse07:471200", "ko": "「앗뜨! 앗뜨뜨뜨!!」"},
{"id": "clse07:471300", "ko": "「그 이전의 문제다!!!」"},
{"id": "clse07:471400", "ko": "「저기…… 아리무라……」"},
{"id": "clse07:471500", "ko": "「미안한데, 나……」"},
{"id": "clse07:471600", "ko": "「돌아오기 전에 밥, 먹어 버렸어……」"},
{"id": "clse07:471700", "ko": "「아, 아니, 왜, 막 개업한 피자집이 있어서! 무슨 밀라노에서 처음 상륙했다나 해서, 맛있어 보이길래……」"},
{"id": "clse07:471800", "ko": "「그, 그러니까 배가 불러서」"},
{"id": "clse07:471900", "ko": "「미, 미안해! 더 일찍 말했어야 했――읍!」"},
{"id": "clse07:472000", "ko": "「…………」"},
{"id": "clse07:472100", "ko": "「미안……」"},
{"id": "clse07:472200", "ko": "「자, 약……」"},
{"id": "clse07:472300", "ko": "「어라?」"},
{"id": "clse07:472400", "ko": "「아니……」"},
{"id": "clse07:472500", "ko": "「알고 있다니까」"},
{"id": "clse07:472600", "ko": "「뭐, 뭐야?」"},
{"id": "clse07:472700", "ko": "「…………」"},
{"id": "clse07:472800", "ko": "「깨어 있지?」"},
{"id": "clse07:472900", "ko": "「역시」"},
{"id": "clse07:473000", "ko": "「읏……!」"},
{"id": "clse07:473100", "ko": "「좀 볼일이 있어서……」"},
{"id": "clse07:473200", "ko": "「……」"},
{"id": "clse07:473300", "ko": "「아〜……」"},
{"id": "clse07:473400", "ko": "「그렇게 보이냐?」"},
{"id": "clse07:473500", "ko": "「어? 아, 아아……」"},
{"id": "clse07:473600", "ko": "（듣고 보니……）"},
{"id": "clse07:473700", "ko": "「……별로」"},
{"id": "clse07:473800", "ko": "「좋아!」"},
{"id": "clse07:473900", "ko": "「다녀왔…… 우와아아아아앗?」"},
{"id": "clse07:474000", "ko": "「뭐…………」"},
{"id": "clse07:474100", "ko": "「뭐뭐뭐……」"},
{"id": "clse07:474200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:474300", "ko": "「요, 욕실 같은 건 이 방에 없잖아!」"},
{"id": "clse07:474400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:474500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:474600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:474700", "ko": "「…………」"},
{"id": "clse07:474800", "ko": "「…………」"},
{"id": "clse07:474900", "ko": "「…………」"},
{"id": "clse07:475000", "ko": "「아리무라」"},
{"id": "clse07:475100", "ko": "「안 춥냐?」"},
{"id": "clse07:475200", "ko": "「언제까지 그런 차림으로 있으면 감기 걸린다」"},
{"id": "clse07:475300", "ko": "「나는 딱히 얼버무리는 거 아니야. 그냥 추울 테니까 옷을 입는 게 좋지 않을까 싶었을 뿐이야」"},
{"id": "clse07:475400", "ko": "「거 봐」"},
{"id": "clse07:475500", "ko": "「……그걸 말하면 되는 거야?」"},
{"id": "clse07:475600", "ko": "「말하면 되는 거지? 그럼……」"},
{"id": "clse07:475700", "ko": "「응? 뭐지, 이 소리」"},
{"id": "clse07:475800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:475900", "ko": "「잠깐――!」"},
{"id": "clse07:476000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:476100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:476200", "ko": "「우와아앗! 아니야! 아니라고! 나는 절대 그런 생각이 아니라!!」"},
{"id": "clse07:476300", "ko": "「아, 알았어!」"},
{"id": "clse07:476400", "ko": "「아, 아리무라! 너, 너 뭐 하는……」"},
{"id": "clse07:476500", "ko": "「아……」"},
{"id": "clse07:476600", "ko": "「아, 아무튼 진정해, 응?」"},
{"id": "clse07:476700", "ko": "「안 되는 게 당연하잖아!」"},
{"id": "clse07:476800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:476900", "ko": "「아, 아니야. 불가항력이야!」"},
{"id": "clse07:477000", "ko": "「어라…… 그래, 내가 눈을 감으면 되는 거 아닌가?」"},
{"id": "clse07:477100", "ko": "「너, 너도 생각 못 했잖아!」"},
{"id": "clse07:477200", "ko": "「아, 알았어!」"}
]
