[
{"id": "clse07:507300", "ko": "「어?」"},
{"id": "clse07:507400", "ko": "「그거, 안 버렸었나――」"},
{"id": "clse07:507500", "ko": "「대체 뭐야 이거……」"},
{"id": "clse07:507600", "ko": "「마치 연회가 끝난 뒤 같잖아……」"},
{"id": "clse07:507700", "ko": "「………… 응?」"},
{"id": "clse07:507800", "ko": "「연회? 그러고 보니……」"},
{"id": "clse07:507900", "ko": "「어제는 다들――」"},
{"id": "clse07:508000", "ko": "「어?」"},
{"id": "clse07:508100", "ko": "「스마트폰도 주머니에 넣은 채로 잤나……」"},
{"id": "clse07:508200", "ko": "「응? 누구한테서 온 거지 이거?」"},
{"id": "clse07:508300", "ko": "「이 도메인…… 무료 일회용 계정이군」"},
{"id": "clse07:508400", "ko": "「제목, 미야시로 타쿠루 님……? 무차별 살포하는 스팸 메일은 아닌 것 같군」"},
{"id": "clse07:508500", "ko": "「제목도 본문도 없고, 이미지 첨부 파일이 하나뿐……」"},
{"id": "clse07:508600", "ko": "「아니 그래도 내 이름을 알고 있으니까……」"},
{"id": "clse07:508700", "ko": "「……바이러스, 없음」"},
{"id": "clse07:508800", "ko": "「……자, 그럼」"},
{"id": "clse07:508900", "ko": "「……」"},
{"id": "clse07:509000", "ko": "「…………」"},
{"id": "clse07:509100", "ko": "「………… 에에에엣!?」"},
{"id": "clse07:509200", "ko": "「이, 이이이이이잇」"},
{"id": "clse07:509300", "ko": "「이, 이건!?」"},
{"id": "clse07:509400", "ko": "「이……!」"},
{"id": "clse07:509500", "ko": "「이게……!」"},
{"id": "clse07:509600", "ko": "「그……!」"},
{"id": "clse07:509700", "ko": "「전설의――!」"},
{"id": "clse07:509800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:509900", "ko": "「응, 내가 일등인가……?」"},
{"id": "clse07:510000", "ko": "「아니, 아니군. 문이 열려 있었어」"},
{"id": "clse07:510100", "ko": "「조심성 없긴…… 언제 누가 올지 모르는데」"},
{"id": "clse07:510200", "ko": "「아니아니아니아니」"},
{"id": "clse07:510300", "ko": "「인기도 지명도도 전무하다는 건 아무리 그래도 너무하잖아」"},
{"id": "clse07:510400", "ko": "「신문부는 헤키호 학원 최첨단의 정보 수집 기지라고?」"},
{"id": "clse07:510500", "ko": "「여기에는 다른 부가 탐내 마지않는 정보가 모여 있단 말이야」"},
{"id": "clse07:510600", "ko": "「조심성 없이 문을 열어 두면 어디서 어떤 녀석들이 그 정보를 훔치러 올지 모르잖아」"},
{"id": "clse07:510700", "ko": "「예를 들면 말이지……」"},
{"id": "clse07:510800", "ko": "「……」"},
{"id": "clse07:510900", "ko": "「…………」"},
{"id": "clse07:511000", "ko": "「………………」"},
{"id": "clse07:511100", "ko": "「아니아니아니아니 잠깐잠깐잠깐잠깐잠깐」"},
{"id": "clse07:511200", "ko": "「신문부가 가치 없다니 그런 일은 없어」"},
{"id": "clse07:511300", "ko": "「정보가 없어도 부실에 찾아오는 사람은 있을 거야」"},
{"id": "clse07:511400", "ko": "「예를 들면, 부원 친구가 오는 일은 있지 않나?」"},
{"id": "clse07:511500", "ko": "「볼일이 있다든가, 그냥 놀러 왔다든가」"},
{"id": "clse07:511600", "ko": "「……」"},
{"id": "clse07:511700", "ko": "「……없군」"},
{"id": "clse07:511800", "ko": "「우리 부원들한테 그런 상황이 생기는 게 전혀 상상이 안 돼」"},
{"id": "clse07:511900", "ko": "「신문부는 미움받는 게 아니야. 다들 사람 사귀는 게 좀 서툴 뿐이야」"},
{"id": "clse07:512000", "ko": "「그래도 누군가는 있을 거야. 신문부에 와 주는 부원 이외의 누군가가……」"},
{"id": "clse07:512100", "ko": "「누군가, 누군가……!」"},
{"id": "clse07:512200", "ko": "「누군가……!」"},
{"id": "clse07:512300", "ko": "「……그래!」"},
{"id": "clse07:512400", "ko": "「있잖아!」"},
{"id": "clse07:512500", "ko": "「카와하라가!」"},
{"id": "clse07:512600", "ko": "「……」"},
{"id": "clse07:512700", "ko": "「…………」"},
{"id": "clse07:512800", "ko": "「하아……」"},
{"id": "clse07:512900", "ko": "「뭐, 됐어」"},
{"id": "clse07:513000", "ko": "「객관적으로 상황을 파악하는 것도 정보 강자에게 필요한 소질이니까」"},
{"id": "clse07:513100", "ko": "「우와아아앗!」"},
{"id": "clse07:513200", "ko": "「아, 아, 아」"},
{"id": "clse07:513300", "ko": "「아아앗! 가, 가까워 가까워 가까워!」"},
{"id": "clse07:513400", "ko": "「떨어져 줘! 떨어져 주세요 부탁입니다!」"},
{"id": "clse07:513500", "ko": "「카카카캇, 카즈키!!??」"},
{"id": "clse07:513600", "ko": "「바, 방, 방금, 온 거야!?」"},
{"id": "clse07:513700", "ko": "「아, 아닌, 거야?」"},
{"id": "clse07:513800", "ko": "「내가 들어왔을 때 아무도 없었던 것 같은데」"},
{"id": "clse07:513900", "ko": "「계속 엠스 하고 있었어?」"},
{"id": "clse07:514000", "ko": "「미안. 몰랐어」"},
{"id": "clse07:514100", "ko": "「다들은? 안 왔어?」"},
{"id": "clse07:514200", "ko": "「아아, 나갔구나」"},
{"id": "clse07:514300", "ko": "「으음, 응」"},
{"id": "clse07:514400", "ko": "「이토한테 볼일이 있어. 찾아볼게」"},
{"id": "clse07:514500", "ko": "「……후우」"},
{"id": "clse07:514600", "ko": "「……아직도 두근거리네」"},
{"id": "clse07:514700", "ko": "「……」"},
{"id": "clse07:514800", "ko": "「……자」"},
{"id": "clse07:514900", "ko": "「혼자 있을 수 있는 곳을 찾자」"},
{"id": "clse07:515000", "ko": "「차분히 생각해야 해」"},
{"id": "clse07:515100", "ko": "「냉정하게, 그리고 논리적으로 결론을 내야 해」"},
{"id": "clse07:515200", "ko": "「――이 셀카에 찍힌 게 대체 누구인지를」"},
{"id": "clse07:515300", "ko": "「――자」"},
{"id": "clse07:515400", "ko": "「다시 생각해 보자」"},
{"id": "clse07:515500", "ko": "「사진에 찍힌 이 여자애가 누구인지에 대해」"},
{"id": "clse07:515600", "ko": "「올바른 답을 이끌어 내려면 올바른 추론을 세워야 해」"},
{"id": "clse07:515700", "ko": "「올바른 추론을 세우려면 올바른 데이터, 즉 사실을 쌓아야 해」"},
{"id": "clse07:515800", "ko": "「좋아, 우선 이 사진에서 읽어 낼 수 있는 사실을 모아 가자」"},
{"id": "clse07:515900", "ko": "「우선 주위 배경부터 확인하자」"},
{"id": "clse07:516000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:516100", "ko": "「……누구한테 변명하는 거야, 나는?」"},
{"id": "clse07:516200", "ko": "「좋아」"},
{"id": "clse07:516300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:516400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:516500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:516600", "ko": "「이 두 가지에서 이끌어 낼 수 있는 추론, 그건 즉――」"},
{"id": "clse07:516700", "ko": "「――이 여자애가 걸터앉은 건 간이침대다!」"},
{"id": "clse07:516800", "ko": "「게다가 말하자면, 그건 내 캠핑카의 간이침대다!」"},
{"id": "clse07:516900", "ko": "「――이토」"},
{"id": "clse07:517000", "ko": "「이토가 있다는 건 내 캠핑카겠지」"},
{"id": "clse07:517100", "ko": "「……설마, 이토의 여자 친구라든가?」"},
{"id": "clse07:517200", "ko": "「아니아니아니아니아니아니」"}
]
