[
{"id": "clse07:597300", "ko": "「어? 아…… 응, 딱 좋아」"},
{"id": "clse07:597400", "ko": "「뭐!? 자, 잠깐만! 너, 무슨 소리 하는 거야!?」"},
{"id": "clse07:597500", "ko": "「아니아니아니아니, 아무리 그래도 그건 안 되지!!」"},
{"id": "clse07:597600", "ko": "「그럼 도로 입으면 되잖아!! 아무튼, 아무리 남매라도 그런 건――」"},
{"id": "clse07:597700", "ko": "「으……」"},
{"id": "clse07:597800", "ko": "「잠깐만…… 전혀 영문을 모르겠는데……」"},
{"id": "clse07:597900", "ko": "「그러니까, 왜 노노랑 센리가 동시에 둘 다 있는 거야?」"},
{"id": "clse07:598000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:598800", "ko": "「어? 아……」"},
{"id": "clse07:598900", "ko": "「아, 아니…… 아무것도 아니야. 그…… 목욕은 나중에 할게. 응……」"},
{"id": "clse07:599000", "ko": "「됐습니다!」"},
{"id": "clse07:599100", "ko": "「그럼 난 이제 잘게」"},
{"id": "clse07:599200", "ko": "「응……?」"},
{"id": "clse07:599300", "ko": "「어쩔 수 없지. 같이 잘까」"},
{"id": "clse07:599400", "ko": "「우와아아아아앗!! 아, 아버지!? 왜!!」"},
{"id": "clse07:599500", "ko": "「아, 아니, 이상한 농담은 그만해, 아버지!」"},
{"id": "clse07:599600", "ko": "「히이이이이이이이이익!!!」"},
{"id": "clse07:599700", "ko": "「사, 살려 줘! 누가! 센리! 유이! 우키! 유토! 누구라도 좋아! 제발, 살려 줘어어어어어어어어어어!!!」"},
{"id": "clse07:599800", "ko": "「우와아아아아아아앗!!」"},
{"id": "clse07:599900", "ko": "「아…… 아, 아니……」"},
{"id": "clse07:600000", "ko": "「괘, 괜찮아! 괜찮으니까……!」"},
{"id": "clse07:600100", "ko": "「아, 아아……」"},
{"id": "clse07:600200", "ko": "「읏…………!」"},
{"id": "clse07:600300", "ko": "「으…… 아아아아아아아아아아아앗!!」"},
{"id": "clse07:600400", "ko": "「하아…… 하아…… 하아……」"},
{"id": "clse07:600500", "ko": "「…………」"},
{"id": "clse07:600600", "ko": "「아기……」"},
{"id": "clse07:600700", "ko": "「어떻게 된 거야, 이 아기. 혹시…… 센리 애야?」"},
{"id": "clse07:600800", "ko": "「버려진…… 건가……」"},
{"id": "clse07:600900", "ko": "「그렇네. 게다가 이 아기가 입고 있는 걸 봐. 꽤 좋은 옷을 입혀 놨어」"},
{"id": "clse07:601000", "ko": "「게다가 꽤 따뜻해 보이는 차림도 시켜 놨잖아? 그렇다는 건 애정이 없는 건 아닌 것 같아」"},
{"id": "clse07:601100", "ko": "「그러니까 어쩌면 돌아올지도 몰라」"},
{"id": "clse07:601200", "ko": "「여기서? 왜?」"},
{"id": "clse07:601300", "ko": "「아버지가 있잖아」"},
{"id": "clse07:601400", "ko": "「……아, 알았어. 그 대신 아버지가 돌아올 때까지다」"},
{"id": "clse07:601500", "ko": "「혹시 쉬 한 거 아냐?」"},
{"id": "clse07:601600", "ko": "「어? 왜 내가……」"},
{"id": "clse07:601700", "ko": "「큭…… 왜 내가 기저귀를 사러 뛰어가야 하는 건데……!」"},
{"id": "clse07:601800", "ko": "「하아…… 하아…… 사, 왔다……」"},
{"id": "clse07:601900", "ko": "「왜 그래?」"},
{"id": "clse07:602000", "ko": "「진짜네……」"},
{"id": "clse07:602100", "ko": "「둘 다, 신기한 건 알겠는데, 그렇게 빤히 보지 마……」"},
{"id": "clse07:602200", "ko": "「뭐!!」"},
{"id": "clse07:602300", "ko": "「읏……」"},
{"id": "clse07:602400", "ko": "「…………」"},
{"id": "clse07:602500", "ko": "「뭐!? 아니, 잠깐! 부럽다니, 그 아기 얘기야?」"},
{"id": "clse07:602600", "ko": "「바보 같은 소리 마! 왜 내가 부럽다고 생각해야 하는 건데!」"},
{"id": "clse07:602700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:602800", "ko": "", "note": "보류 — 성적 묘사"},
