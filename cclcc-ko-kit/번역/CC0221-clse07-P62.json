{"id": "clse07:604600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:604700", "ko": "「어?」"},
{"id": "clse07:604800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:604900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:605000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:605100", "ko": "「뭐……!!」"},
{"id": "clse07:605200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:605300", "ko": "「유토……」"},
{"id": "clse07:605400", "ko": "「으………… 아아아아아아아아아아아아아아아!!」"},
{"id": "clse07:605500", "ko": "「…………」"},
{"id": "clse07:605600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:605700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:605800", "ko": "「아, 아아. 아기 말이구나! 응, 그렇지! 귀엽네!!」"},
{"id": "clse07:605900", "ko": "「이번엔 왜 그래?」"},
{"id": "clse07:606000", "ko": "「그런 건 한꺼번에 말해 줘!!!」"},
{"id": "clse07:606100", "ko": "「사, 사 왔…… 다……」"},
{"id": "clse07:606200", "ko": "「뭐!? 왜, 왜 내가!」"},
{"id": "clse07:606300", "ko": "「아니아니아니아니, 무리무리무리무리무리!」"},
{"id": "clse07:606400", "ko": "「아니, 안 된다니까! 아, 잠깐……」"},
{"id": "clse07:606500", "ko": "「우왓!」"},
{"id": "clse07:606600", "ko": "「뭔가…… 따뜻해……」"},
{"id": "clse07:606700", "ko": "「…………」"},
{"id": "clse07:606800", "ko": "「응……」"},
{"id": "clse07:606900", "ko": "「어?」"},
{"id": "clse07:607000", "ko": "「우왓!」"},
{"id": "clse07:607100", "ko": "「피, 피곤해〜」"},
{"id": "clse07:607200", "ko": "「아무리 나라도, 그 상태로 돌아갈 수는 없잖아」"}
]
