[
{"id": "clyu01:20000", "ko": "「할 얘기가 있으니까 여기 남아 달라고 한 거, 들었지?」"},
{"id": "clyu01:20100", "ko": "바, 방금 그건…… 망상?"},
{"id": "clyu01:20200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:20300", "ko": "「어?! 우, 우왓!!」"},
{"id": "clyu01:20400", "ko": "망상에 푹 빠진 나머지, 나는 두 손바닥을 앞으로 힘껏 내민 자세를 취하고 있었다."},
{"id": "clyu01:20500", "ko": "「아, 아아, 그게 아니야! 이건 그…… 어제 ⟦col:280aa02d1400⟧쿵후 영화⟦col:800000⟧를 봐서! 이런 자세가 있었거든! 호랑이 권법이라고!」"},
{"id": "clyu01:20600", "ko": "「그 나이에 쿵후 놀이? 정말, 남자애들은 언제까지고 애라니까」"},
{"id": "clyu01:20700", "ko": "……살았다."},
{"id": "clyu01:20800", "ko": "「그, 그래서 할 얘기라는 게……?」"},
{"id": "clyu01:20900", "ko": "그런 생각을 하는 사이, 정신을 차려 보니 나와 노노 말고는 부원들이 다 돌아가 버린 뒤였다."},
{"id": "clyu01:21000", "ko": "결국, 이러쿵저러쿵 생각하는 것보다 물어보는 게 빠르다."},
{"id": "clyu01:21100", "ko": "그렇게 마음을 고쳐먹은 그때――"},
{"id": "clyu01:21200", "ko": "공기를 뒤흔드는 듯한 거친 소리와 함께 부실 문이 열렸다."},
{"id": "clyu01:21300", "ko": "「아~, 있다 있다」"},
{"id": "clyu01:21400", "ko": "들어온 건 방금 막 얘기하던 인물―― 여동생 유이였다."},
{"id": "clyu01:21500", "ko": "「유이……」"},
{"id": "clyu01:21600", "ko": "「하여간, 노노 언니. 이런 데 있었냐. 찾았잖냐」"},
{"id": "clyu01:21700", "ko": "「유, 유이……?」"},
{"id": "clyu01:21800", "ko": "나는 유이의 그 말투에 잠시 어안이 벙벙해졌다."},
{"id": "clyu01:21900", "ko": "유이와는 내가 아오바 기숙사를 나온 뒤로 그다지 얼굴 볼 기회가 없었다."},
{"id": "clyu01:22000", "ko": "그렇다고 해도, 못 본 기간은 고작 몇 달 정도다."},
{"id": "clyu01:22100", "ko": "적어도 내가 아는 유이는 『찾았잖냐』 같은 거친 말투는 쓰지 않았을 텐데……"},
{"id": "clyu01:22200", "ko": "「지금 애들이랑 놀러 갈 거거든, 응?」"},
{"id": "clyu01:22300", "ko": "유이는 노노에게 다가가더니, 그 눈앞에서 오른손 엄지와 검지와 중지를 비벼 댔다."},
{"id": "clyu01:22400", "ko": "「쪼끔만 줘 봐?」"},
{"id": "clyu01:22500", "ko": "「요, 용돈은 저번에 줬잖아?」"},
{"id": "clyu01:22600", "ko": "「다 써 버렸어」"},
{"id": "clyu01:22700", "ko": "「뭐?」"},
{"id": "clyu01:22800", "ko": "「그런 푼돈, 금방 없어지는 게 당연하잖아? 그러니까, 응? 자」"},
{"id": "clyu01:22900", "ko": "「아, 안 돼. 남은 건 우리 집 생활비란 말이야……」"},
{"id": "clyu01:23000", "ko": "「뭐어?!」"},
{"id": "clyu01:23100", "ko": "방 안에 딱딱한 소리가 울리고, 노노가 몸을 움츠렸다."},
{"id": "clyu01:23200", "ko": "너무 뜻밖의 일이라 생각이 멈춰 버려서, 그 소리가 유이가 접이식 의자를 걷어찬 소리라는 걸 알기까지 시간이 걸렸다."},
{"id": "clyu01:23300", "ko": "「됐으니까 내놓으라고 했잖아? 돈 말야?」"},
{"id": "clyu01:23400", "ko": "「제, 제발 그만해, 유이…… 너 이런 짓 하는 애가 아니었잖아?」"},
{"id": "clyu01:23500", "ko": "「네가 나에 대해 뭘 안다는 건데?」"},
{"id": "clyu01:23600", "ko": "유이가 노노에게 다가가 교복 리본을 움켜쥐었다."},
{"id": "clyu01:23700", "ko": "「착한 척하기는. 가족은 무슨. 거짓말은 안 한다는 게 다 뭐야?」"},
{"id": "clyu01:23800", "ko": "「너야말로 거짓말만 해 대는 주제에!」"},
{"id": "clyu01:23900", "ko": "「그, 그만…… 해…… 유이……」"},
{"id": "clyu01:24000", "ko": "유이의 손에 힘이 들어가자 노노가 괴로운 듯한 소리를 냈다."},
{"id": "clyu01:24100", "ko": "거짓말…… 이지?"},
{"id": "clyu01:24200", "ko": "그 유이가 이렇게 엇나가다니."},
{"id": "clyu01:24300", "ko": "혹시 이게…… 노노가 나한테 상담하려던 일…… 인가?"},
{"id": "clyu01:24400", "ko": "「아? 뭘 봐?」"},
{"id": "clyu01:24500", "ko": "「으……」"},
{"id": "clyu01:24600", "ko": "「따지고 보면 네가 잘못한 거야. 타쿠루 오빠……」"},
{"id": "clyu01:24700", "ko": "「내, 내가……?」"},
{"id": "clyu01:24800", "ko": "「네가 나가 버린 뒤로 우리 가족 관계는 망가져 버렸다고……」"},
{"id": "clyu01:24900", "ko": "「그런…… 나는 아무것도……」"},
{"id": "clyu01:25000", "ko": "「흥…… 마음에 안 드네……」"},
{"id": "clyu01:25100", "ko": "「어……」"},
{"id": "clyu01:25200", "ko": "「너의 그런 점이 마음에 안 든다고! 혼자선 아무것도 못 하는 주제에 남을 깔보고! 열받는다고!」"},
{"id": "clyu01:25300", "ko": "「힉……」"},
{"id": "clyu01:25400", "ko": "다가오는 유이의 눈동자를 정면으로 본 나는 저도 모르게 소리를 내고 말았다."},
{"id": "clyu01:25500", "ko": "그만큼 유이의 눈동자 깊은 곳은 캄캄한 어둠에 잠겨 있었다."},
{"id": "clyu01:25600", "ko": "", "note": "보류 — 미성년 인물에 대한 학대 암시"},
{"id": "clyu01:25700", "ko": "「아버지…… 가……?」"},
{"id": "clyu01:25800", "ko": "아버지가!"},
{"id": "clyu01:25900", "ko": "대체 유이한테 무슨 짓을…… 했다는 거야……?!"},
{"id": "clyu01:26000", "ko": "「그만해! 유이…… 더는 그만해……」"},
{"id": "clyu01:26100", "ko": "「흥……! 그럼 냉큼 돈이나 내놔」"},
{"id": "clyu01:26200", "ko": "유이의 말에 노노는 말없이 지갑을 꺼내, 안에서 지폐를 몇 장 꺼내려 했다."},
{"id": "clyu01:26300", "ko": "그런데――"},
{"id": "clyu01:26400", "ko": "「쳇! 짜기는」"},
{"id": "clyu01:26500", "ko": "유이는 지갑째 낚아채서, 안에 든 지폐를 전부 꺼내 주머니에 쑤셔 넣었다."},
{"id": "clyu01:26600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:26700", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:26800", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:26900", "ko": "「자, 잠깐, 유이! 그런 짓――!」"},
{"id": "clyu01:27000", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:27100", "ko": "「유……」"},
{"id": "clyu01:27200", "ko": "「흥…… 겁쟁이가……!」"},
{"id": "clyu01:27300", "ko": "유이는 그렇게 내뱉고는 성큼성큼 방을 나가 버렸다."},
{"id": "clyu01:27400", "ko": "「으…… 흐윽…… 흐으윽……」"},
{"id": "clyu01:27500", "ko": "나는 그저 노노의 흐느낌이 울리는 방 안에서 우두커니 서 있을 수밖에 없었다……"},
{"id": "clyu01:27600", "ko": "「…………」"},
{"id": "clyu01:27700", "ko": "「타쿠루? 왜 그래?」"},
{"id": "clyu01:27800", "ko": "「……아니……」"},
{"id": "clyu01:27900", "ko": "최악이다."},
{"id": "clyu01:28000", "ko": "그 유이가 저렇게 될 리가 없다."},
{"id": "clyu01:28100", "ko": "아무리 망상이라지만 최악의 망상이었다……"},
{"id": "clyu01:28200", "ko": "「그, 그래서, 할 얘기라는 게?」"},
{"id": "clyu01:28300", "ko": "뭐, 생각하는 것보다 물어보는 게 빠르겠지."},
{"id": "clyu01:28400", "ko": "「저기, 언니. 저……」"},
{"id": "clyu01:28500", "ko": "「아, 우키도 먼저 돌아가 줄래?」"},
{"id": "clyu01:28600", "ko": "「네. 그럼 저는 돌아가서 아버지 일을 도와 둘게요」"},
{"id": "clyu01:28700", "ko": "「미안해. 부탁할게」"},
{"id": "clyu01:28800", "ko": "우키와 함께 다른 녀석들도 각자 돌아가 버려서, 부실에는 나와 노노만 남았다."},
{"id": "clyu01:28900", "ko": "「그래서, 할 얘기라는 게?」"},
{"id": "clyu01:29000", "ko": "분위기가 가라앉은 걸 보고 나는 물었다."},
{"id": "clyu01:29100", "ko": "「있잖아…… 유이 고민 상담을 좀 들어 줬으면 해」"},
{"id": "clyu01:29200", "ko": "「상담?」"},
{"id": "clyu01:29300", "ko": "「응. 그 애, 요즘 이것저것 고민이 있는 것 같아서……」"},
{"id": "clyu01:29400", "ko": "유이가 고민이라……"},
{"id": "clyu01:29500", "ko": "「봐, 타쿠루가 나가기 전에는 아빠 일 같은 걸 도와줬던 거 알지?」"},
{"id": "clyu01:29600", "ko": "「뭐……」"},
{"id": "clyu01:29700", "ko": "그다지 자진해서 하는 느낌은 아니었지만, 그래도 아오바 기숙사의 일원으로서 열심히 도우려는 모습은 보였다."},
{"id": "clyu01:29800", "ko": "「그런데 지금은 우키가 있잖아? 아빠 일도, 집안일도 그 애가 자진해서 해 주게 돼서……」"},
{"id": "clyu01:29900", "ko": "「설 자리를 빼앗겨 버렸다는 건가……」"}
]
