[
{"id": "clka12:0", "ko": "방과 후. 나는 신문부 부실 앞에 멍하니 서 있었다."},
{"id": "clka12:100", "ko": "「……」"},
{"id": "clka12:200", "ko": "「……하아」"},
{"id": "clka12:300", "ko": "「무슨 얼굴로 만나야 하는 거냐고……」"},
{"id": "clka12:400", "ko": "결국 나는 카즈키를 위해 아무것도 해 주지 못했다."},
{"id": "clka12:500", "ko": "그날 나는 호텔 방에서 나간 카즈키를 찾지 못하고, 내 캠핑카로 돌아왔다."},
{"id": "clka12:600", "ko": "그러자 거기에는 신문부 동료들이 모여 있었다."},
{"id": "clka12:700", "ko": "나는 거기서 처음으로, 내가 얼마나 눈치가 없는지 깨닫게 되었다."},
{"id": "clka12:800", "ko": "「대체 어떻게 된 거야?」"},
{"id": "clka12:900", "ko": "「그 둘은 대체 뭘 하고 싶은 거야?」"},
{"id": "clka12:1000", "ko": "「하아? 혹시 미야시로 선배, 아직도 모르는 거예요?」"},
{"id": "clka12:1100", "ko": "「어, 뭐가?」"},
{"id": "clka12:1200", "ko": "「하아…… 내 동생이지만 어이가 없어서 말이 안 나오네」"},
{"id": "clka12:1300", "ko": "「뭐야, 다들 왜 그래」"},
{"id": "clka12:1400", "ko": "「있잖아, 타쿠」"},
{"id": "clka12:1500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:1600", "ko": "「……어?」"},
{"id": "clka12:1700", "ko": "「무슨 소리야?」"},
{"id": "clka12:1800", "ko": "「그래, 다들 짜고 나를 속이려는 거구나?」"},
{"id": "clka12:1900", "ko": "「아〜니〜에〜요〜」"},
{"id": "clka12:2000", "ko": "「하나 얼굴만 봐도 알 수 있어요. 미야시로 선배가 둔한 것뿐이에요」"},
{"id": "clka12:2100", "ko": "「어, 그래? 나는 전혀 몰랐는데」"},
{"id": "clka12:2200", "ko": "「이토는 좀 조용히 해 줄래?」"},
{"id": "clka12:2300", "ko": "「네」"},
{"id": "clka12:2400", "ko": "「자, 타쿠루, 어떻게 할 거야?」"},
{"id": "clka12:2500", "ko": "「뭐!? 어, 어떻게 하다니……」"},
{"id": "clka12:2600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:2700", "ko": "「받아들이든 아니든, 제대로 대답해 주지 않으면 불쌍하잖아」"},
{"id": "clka12:2800", "ko": "「맞아, 타쿠」"},
{"id": "clka12:2900", "ko": "「다들 말이 맞아요. 미야시로 선배」"},
{"id": "clka12:3000", "ko": "「……」"},
{"id": "clka12:3100", "ko": "「……어쨌든, 카즈키를 찾자」"},
{"id": "clka12:3200", "ko": "「미안. 다들, 도와줘!」"},
{"id": "clka12:3300", "ko": "이렇게 해서 신문부 모두가 나눠서 시부야 곳곳을 뛰어다녔다."},
{"id": "clka12:3400", "ko": "평소라면 카즈키가 부실에 붙어 있으면서 모두의 연락을 이어 주는 역할을 해 줬을 텐데, 이번엔 그게 없었다."},
{"id": "clka12:3500", "ko": "그게 어딘가에 뻥 구멍이 뚫린 것 같아서 괴로웠다."},
{"id": "clka12:3600", "ko": "지금은 그저 카즈키를 만나고 싶었다."},
{"id": "clka12:3700", "ko": "밤이 되어도 카즈키를 찾지 못했다."},
{"id": "clka12:3800", "ko": "「젠장, 어디 있는 거야……!」"},
{"id": "clka12:3900", "ko": "바로 그때,"},
{"id": "clka12:4000", "ko": "「메일? ……카즈키한테서야!」"},
{"id": "clka12:4100", "ko": "도착한 메일에는 단 한 줄, 『시어터 큐브』라고 적혀 있었다."},
{"id": "clka12:4200", "ko": "「시어터 큐브!」"},
{"id": "clka12:4300", "ko": "정문은 닫혀 있어서, 비상계단으로 몰래 들어가 올라갔다."},
{"id": "clka12:4400", "ko": "「여기다!」"},
{"id": "clka12:4500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:4600", "ko": "「읏!」"},
{"id": "clka12:4700", "ko": "그 뒤의 일은 기억나지 않는다."},
{"id": "clka12:4800", "ko": "머릿속이 새하얘져서 멍하니 서 있는데, 카즈키가 이쪽으로 걸어온 것 같다."},
{"id": "clka12:4900", "ko": "나는 뭔가를 말한 것 같다."},
{"id": "clka12:5000", "ko": "카즈키는 『응』 하고 고개를 끄덕인 것 같다."},
{"id": "clka12:5100", "ko": "그리고 나는 『고마워』라고 말한 것 같다."},
{"id": "clka12:5200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:5300", "ko": "하지만 카즈키는 웃으며 고개를 끄덕여 준…… 것 같다."},
{"id": "clka12:5400", "ko": "그 뒤에 카즈키와 무슨 이야기를 했는지 전혀 기억나지 않는다."},
{"id": "clka12:5500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:5600", "ko": "어떻게 캠핑카로 돌아왔는지도 기억나지 않는다."},
{"id": "clka12:5700", "ko": "카즈키와 함께 돌아온 것 같기도 하고, 히카리오 바로 아래에서 헤어진 것 같기도 하다."},
{"id": "clka12:5800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:5900", "ko": "솔직히 말하면 그 혼란은 지금도 이어지고 있다. 그래서 어떤 얼굴로 부실에 들어가야 할지 모르겠다."},
{"id": "clka12:6000", "ko": "다만, 하나 말할 수 있는 건."},
{"id": "clka12:6100", "ko": "지금 기분이 아주 좋다는 것이다."},
{"id": "clka12:6200", "ko": "「벌써 와 있으려나, 카즈키」"},
{"id": "clka12:6300", "ko": "「응」"},
{"id": "clka12:6400", "ko": "「히악!?」"},
{"id": "clka12:6500", "ko": "뒤에서 갑자기 목소리가 들려서, 내 목소리가 뒤집힌다."},
{"id": "clka12:6600", "ko": "「카, 카즈키!?」"},
{"id": "clka12:6700", "ko": "「응?」"},
{"id": "clka12:6800", "ko": "평소의 카즈키였다."},
{"id": "clka12:6900", "ko": "어젯밤에는 꽤 허둥지둥했던 것 같은데……"},
{"id": "clka12:7000", "ko": "그건 내가 본 망상이었던 걸까."},
{"id": "clka12:7100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka12:7200", "ko": "「응」"},
{"id": "clka12:7300", "ko": "갑자기 카즈키가 내 얼굴 앞으로 손을 내밀었다."},
{"id": "clka12:7400", "ko": "그 손에는 하나가 물고 있는 것과 똑같은 롤리팝이 쥐여 있었다."},
{"id": "clka12:7500", "ko": "「어?」"},
{"id": "clka12:7600", "ko": "「응!」"},
{"id": "clka12:7700", "ko": "내가 어리둥절해하고 있자, 하나는 뾰로통한 얼굴이 되더니 억지로 내 입에 롤리팝을 물렸다."},
{"id": "clka12:7800", "ko": "「후왓!? 뭐, 뭐 하는 거야!?」"},
{"id": "clka12:7900", "ko": "「응」"},
{"id": "clka12:8000", "ko": "카즈키는 만족스럽게 고개를 끄덕이고는 나에게 등을 돌려, 부실 입구 앞에 섰다."},
{"id": "clka12:8100", "ko": "그리고 뭔가를 웅얼웅얼 중얼거렸다."},
{"id": "clka12:8200", "ko": "「어, 방금 뭐라고 했어?」"},
{"id": "clka12:8300", "ko": "그러자 카즈키는 이쪽을 돌아보더니 나를 매섭게 노려보았다."},
{"id": "clka12:8400", "ko": "「으음〜〜!!」"},
{"id": "clka12:8500", "ko": "「뭐, 뭐야!?」"},
{"id": "clka12:8600", "ko": "카즈키는 말없이 다시 부실 쪽으로 돌아서서 말했다."},
{"id": "clka12:8700", "ko": "「……똑같은 거…… 일지도」"},
{"id": "clka12:8800", "ko": "「……읏!」"},
{"id": "clka12:8900", "ko": "그때 처음으로, 카즈키의 귀가 새빨개져 있는 걸 알아차렸다."},
{"id": "clka12:9000", "ko": "카즈키도 어제 주고받은 말들이 부끄러워 견딜 수 없는 거겠지."},
{"id": "clka12:9100", "ko": "그렇다는 건, 그건 망상이 아니었던 것이다."},
{"id": "clka12:9200", "ko": "「……후, 하하하」"},
{"id": "clka12:9300", "ko": "나도 모르게 웃음이 새어 나온다."},
{"id": "clka12:9400", "ko": "「응?」"},
{"id": "clka12:9500", "ko": "「아, 아무것도 아니야. 들어가자」"},
{"id": "clka12:9600", "ko": "「응」"},
{"id": "clka12:9700", "ko": "평소와 다름없는 일상이 시작된다."},
{"id": "clka12:9800", "ko": "카즈키의 뭔가가 바뀐 건 아니다."},
{"id": "clka12:9900", "ko": "나의 뭔가가 바뀐 것도 아니다."}
]
