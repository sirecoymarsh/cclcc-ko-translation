[
{"id": "clse07:617300", "ko": "「그 정도는 내가 할게」"},
{"id": "clse07:617400", "ko": "「제조사 이름은 알아?」"},
{"id": "clse07:617500", "ko": "「그런 건 빠를수록 좋잖아」"},
{"id": "clse07:617600", "ko": "「아, 그게, 저…… 죄송한데요. 얼마 전에 구입한 상품이 고장 나 있어서요……」"},
{"id": "clse07:617700", "ko": "「아, 네, 있을 거예요……」"},
{"id": "clse07:617800", "ko": "「알겠습니다」"},
{"id": "clse07:617900", "ko": "「왜?」"},
{"id": "clse07:618000", "ko": "「뭐, 뭐야, 그게?」"},
{"id": "clse07:618100", "ko": "「딱히 쑥스러워하는 거 아니라니까」"},
{"id": "clse07:618200", "ko": "「다, 당연하지. 가족이니까」"},
{"id": "clse07:618300", "ko": "「뭔데?」"},
{"id": "clse07:618400", "ko": "「웃을 일이 아니라니까」"},
{"id": "clse07:618500", "ko": "「후아아……」"},
{"id": "clse07:618600", "ko": "「…………」"},
{"id": "clse07:618700", "ko": "「센리?」"},
{"id": "clse07:618800", "ko": "「아아, 뭐야. 노노구나……」"},
{"id": "clse07:618900", "ko": "「……잠깐 교대할까」"},
{"id": "clse07:619000", "ko": "「노노는 그…… 졸업할 때까지 그 모습 그대로야?」"},
{"id": "clse07:619100", "ko": "「미안, 아무것도 아니야……」"},
{"id": "clse07:619200", "ko": "「딱히. 별다른 건 없어」"},
{"id": "clse07:619300", "ko": "「이제 잠잠해졌어. 잘하면 이대로 있으나 마나 한 게 되지 않을까?」"},
{"id": "clse07:619400", "ko": "「…………」"},
{"id": "clse07:619500", "ko": "「…………」"},
{"id": "clse07:619600", "ko": "「…………」"},
{"id": "clse07:619700", "ko": "「…………」"},
{"id": "clse07:619800", "ko": "「후아아…… 좋은 아침……」"},
{"id": "clse07:619900", "ko": "「그게…… 무슨 일 있어?」"},
{"id": "clse07:620000", "ko": "「응……」"},
{"id": "clse07:620100", "ko": "「글쎄……」"},
{"id": "clse07:620200", "ko": "「없어없어! 그냥 히카리를 재우다가 그대로 꾸벅꾸벅 졸았을 뿐이야!」"},
{"id": "clse07:620300", "ko": "「당연히 진짜지!!」"},
{"id": "clse07:620400", "ko": "「왜 그래, 우키?」"},
{"id": "clse07:620500", "ko": "「딱히…… 그냥이야」"},
{"id": "clse07:620600", "ko": "「응. 그보다 빨리 안 가면 늦는다」"},
{"id": "clse07:620700", "ko": "「글쎄. 그보다 노…… 쿠루스. 안 돌아가도 괜찮아?」"},
{"id": "clse07:620800", "ko": "「뭐?」"},
{"id": "clse07:620900", "ko": "「어, 어어어……」"},
{"id": "clse07:621000", "ko": "「그, 그그, 그건……」"},
{"id": "clse07:621100", "ko": "「으…… 아……」"},
{"id": "clse07:621200", "ko": "「훗……」"},
{"id": "clse07:621300", "ko": "「이토…… 너……」"},
{"id": "clse07:621400", "ko": "「나, 나는……」"},
{"id": "clse07:621500", "ko": "「나, 나는! 켕기는 짓은 아무것도 안 해써!!」"},
{"id": "clse07:621600", "ko": "「그, 그렇겠지가 아니라, 사실인 걸 어떡해…… 요」"},
{"id": "clse07:621700", "ko": "「그, 그걸 못 하면…… 어떻게 되는…… 건데요?」"},
{"id": "clse07:621800", "ko": "「…………」"},
{"id": "clse07:621900", "ko": "「……안…… 돼, 이토. 그 애를 ⟦rb⟧학교⟦rt⟧여기⟦/r⟧에 데려올 수는 없어」"},
{"id": "clse07:622000", "ko": "「그건…… 사정이 있어서……」"},
{"id": "clse07:622100", "ko": "「그건 그렇지만…… 그래도 안 돼……」"},
{"id": "clse07:622200", "ko": "「……미안」"},
{"id": "clse07:622300", "ko": "「노노?」"},
{"id": "clse07:622400", "ko": "「몇 번이나 그렇게 말 안 해도 돼. 아직 깨어 있었으니까 괜찮아」"},
{"id": "clse07:622500", "ko": "「응……」"},
{"id": "clse07:622600", "ko": "「어?」"},
{"id": "clse07:622700", "ko": "「…………」"},
{"id": "clse07:622800", "ko": "「그럼 그 반대도 있을 수 있다는 건가요?」"},
{"id": "clse07:622900", "ko": "「뭐…… 그런 셈이에요」"},
{"id": "clse07:623000", "ko": "「예를 들어, 본인이 어떻게든 하고 싶다고 그렇게 바라고 있다 해도요?」"},
{"id": "clse07:623100", "ko": "「그렇군요. 그럼 그 경우엔 어떻게 하면 원래대로 돌아오는데요?」"},
{"id": "clse07:623200", "ko": "「역시 그렇게 되는 거군요……」"},
{"id": "clse07:623300", "ko": "「…………」"},
{"id": "clse07:623400", "ko": "「스트레스의 원인을 없애면 원래대로 돌아올 수 있다고……」"},
{"id": "clse07:623500", "ko": "「됐어. 신경 안 써도……」"},
{"id": "clse07:623600", "ko": "「나라면 내가 알아서 할게. 그러니까 걱정 안 해도 돼」"},
{"id": "clse07:623700", "ko": "「게다가 이토도 말했잖아? 이 소동도 금방 끝날 거라고」"},
{"id": "clse07:623800", "ko": "「어차피 다들 떠들 거리가 필요할 뿐이야. 뭔가 재밌는 거리를 찾으면 실컷 떠들고는 금방 잊어버려」"},
{"id": "clse07:623900", "ko": "「이번에도 마찬가지야……」"},
{"id": "clse07:624000", "ko": "「아리무라. 그리고 카즈키도, 나한테 가까이 오지 않는 게 좋아……」"},
{"id": "clse07:624100", "ko": "「왜냐하면……」"},
{"id": "clse07:624200", "ko": "「봐? 알겠지. 그러니까 당분간 나한테는――」"},
{"id": "clse07:624300", "ko": "「아리무라…… 카즈키……」"},
{"id": "clse07:624400", "ko": "「……그래. 고마워……」"},
{"id": "clse07:624500", "ko": "「와쿠이 선생님……」"},
{"id": "clse07:624600", "ko": "「어떤 대책…… 그건 퇴학이라는…… 건가요?」"},
{"id": "clse07:624700", "ko": "「당연하잖…… 아요……」"},
{"id": "clse07:624800", "ko": "「……도망치거나 하진…… 않아요」"},
{"id": "clse07:624900", "ko": "「오노에…… 왜?」"},
{"id": "clse07:625000", "ko": "「사실이라니?」"},
{"id": "clse07:625100", "ko": "「안 말해, 그런 건……」"},
{"id": "clse07:625200", "ko": "「나는 이제 싫어…… 그 녀석의 그런 슬픈 얼굴을 보는 게……」"},
{"id": "clse07:625300", "ko": "「오랜만에 ⟦rb⟧아오바 기숙사⟦rt⟧우리 집⟦/r⟧에 돌아가서, 즐거웠어, 엄청……」"},
{"id": "clse07:625400", "ko": "「아버지가 있고, 유이랑 유토랑 우키가 있고…… 그리고 아기가 있고……」"},
{"id": "clse07:625500", "ko": "「그 녀석이 화내기도 하고 잔소리하기도 하고 웃기도 하고……」"},
{"id": "clse07:625600", "ko": "「계속 이런 시간이 이어지면 좋겠다고 생각했어」"},
{"id": "clse07:625700", "ko": "「그 녀석이 웃어 주면 좋겠다고……」"},
{"id": "clse07:625800", "ko": "", "note": "보류 — 연애 묘사"},
