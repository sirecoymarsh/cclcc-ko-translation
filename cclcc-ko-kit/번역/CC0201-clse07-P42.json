[
{"id": "clse07:397300", "ko": "「있잖아, 타쿠루. 이 아이 좀 잠깐 안고 있어 줄래?」"},
{"id": "clse07:397400", "ko": "「유이네는 아기 이불 준비하러 갔어」"},
{"id": "clse07:397500", "ko": "「괜찮아. 머리만 잘 받쳐 주면 돼」"},
{"id": "clse07:397600", "ko": "「괜찮으니까. 자」"},
{"id": "clse07:397700", "ko": "「어때?」"},
{"id": "clse07:397800", "ko": "「그렇게 만져 보니까 귀엽지?」"},
{"id": "clse07:397900", "ko": "「잠깐 동안 그렇게 안고 있어 줘」"},
{"id": "clse07:398000", "ko": "「그럼 잠깐 동안 안고 있어 줘」"},
{"id": "clse07:398100", "ko": "「……후훗. 그러고 있으니까 꼭 아빠 같아」"},
{"id": "clse07:398200", "ko": "「타쿠루도 언젠가 그렇게 아기를 안는 날이 올까」"},
{"id": "clse07:398300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:398400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:398500", "ko": "「아, 아아. 고마워!」"},
{"id": "clse07:398600", "ko": "「아, 아무것도 아니야, 아무것도!」"},
{"id": "clse07:398700", "ko": "「그, 그렇지! 우유 먹고 싶었지! 미안해, 금방 준비하쪄요〜」"},
{"id": "clse07:398800", "ko": "「자, 타쿠루…… 수고했어」"},
{"id": "clse07:398900", "ko": "「고마워. 타쿠루가 있어 줘서 살았어」"},
{"id": "clse07:399000", "ko": "「응. 그러네. 타쿠루는 상냥하니까」"},
{"id": "clse07:399100", "ko": "「있잖아, 타쿠루…… 그 아이 엄마, 어떻게든 찾을 수 없을까?」"},
{"id": "clse07:399200", "ko": "「…………」"},
{"id": "clse07:399300", "ko": "「새근…… 새근……」"},
{"id": "clse07:399400", "ko": "「응. 아무래도 둘 다 쉴 수는 없잖아. 그러니까 학교에는 인플루엔자라고 해 둘게」"},
{"id": "clse07:399500", "ko": "「그 대신 되도록 빨리 돌아와」"},
{"id": "clse07:399600", "ko": "「그리고 학교 사람들한테는……」"},
{"id": "clse07:399700", "ko": "「그럼 다행이지만……」"},
{"id": "clse07:399800", "ko": "「아, 맞다. 도시락은 잘 챙겼어?」"},
{"id": "clse07:399900", "ko": "「손수건은?」"},
{"id": "clse07:400000", "ko": "「아. 잠깐. 봐, 옷깃 구겨졌어」"},
{"id": "clse07:400100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:400200", "ko": "「후훗, 그냥 농담이야. 그보다 자, 서두르지 않으면 늦어」"},
{"id": "clse07:400300", "ko": "「응. 내일 밤에는 아빠도 돌아온다고 했으니까, 그러면 앞으로 어떻게 할지 의논하자」"},
{"id": "clse07:400400", "ko": "「아, 타쿠루. 오늘은 유이네가 일찍 올 수 있대서, 방과 후에 장 보러 같이 가 줄 수 있을까?」"},
{"id": "clse07:400500", "ko": "「응, 부탁해」"},
{"id": "clse07:400600", "ko": "「음〜…… 다음에 갈 곳은……」"},
{"id": "clse07:400700", "ko": "「안 돼. 가게마다 세일하는 물건이 다르단 말이야」"},
{"id": "clse07:400800", "ko": "「아, 맞다. 그리고 저번에 산 히카리 장난감, 소리 안 나는 게 섞여 있었으니까 나중에 제조사에 전화해야지」"},
{"id": "clse07:400900", "ko": "「정말? 고마워. 그럼 부탁할까」"},
{"id": "clse07:401000", "ko": "「어? 지금 전화하게?」"},
{"id": "clse07:401100", "ko": "「어, 응…… 그러네……」"},
{"id": "clse07:401200", "ko": "「…………」"},
{"id": "clse07:401300", "ko": "「아니. 타쿠루도 믿음직해졌구나 싶어서」"},
{"id": "clse07:401400", "ko": "「후훗, 쑥스러워한다」"},
{"id": "clse07:401500", "ko": "「그래도 정말로 도움이 돼. 타쿠루가 있어 줘서…… 고마워」"},
{"id": "clse07:401600", "ko": "「가족…… 이라」"},
{"id": "clse07:401700", "ko": "「아니, 아무것도 아니야」"},
{"id": "clse07:401800", "ko": "「어머. 히카리가 기분이 안 좋은가 보네」"},
{"id": "clse07:401900", "ko": "「어머나, 히카리. 왜 그래? 쓸쓸했어?」"},
{"id": "clse07:402000", "ko": "「자자, 착하지. 조용히 하자〜」"},
{"id": "clse07:402100", "ko": "「정말. 또 그런 소리 하고. 자, 얼른 안으로 들어가자」"},
{"id": "clse07:402200", "ko": "「앗…… 조, 좋은 아침」"},
{"id": "clse07:402300", "ko": "「아, 아니. 아무것도 아니야. 금방 밥 차릴게」"},
{"id": "clse07:402400", "ko": "「『어머나, 히카리. 왜 그래? 쓸쓸했어?』」"},
{"id": "clse07:402500", "ko": "「『자자, 착하지. 조용히 하자〜』」"},
{"id": "clse07:402600", "ko": "「…………」"},
{"id": "clse07:402700", "ko": "「……알았지? 아까까지의 모습은 나의 ⟦rb⟧능력⟦rt⟧힘⟦/r⟧으로 쿠루스 노노라는 소녀에게서 빌린 임시 모습」"},
{"id": "clse07:402800", "ko": "「그리고 이게 나의…… 미나미사와 센리의 진짜 모습이야……」"},
{"id": "clse07:402900", "ko": "「나한테 쿠루스 노노라는 여자아이는 동경의 대상이었어」"},
{"id": "clse07:403000", "ko": "「늘 밝고 상냥하고 모두에게 사랑받고…… 그런 노노가 되고 싶다고 계속 생각했어……」"},
{"id": "clse07:403100", "ko": "「진짜 쿠루스 노노는 몇 년 전에 유학을 가서 일본에 없어……」"},
{"id": "clse07:403200", "ko": "「그러니까 모두가 알고 있는 쿠루스 노노는 나…… 어둡고 울보에 볼품없고…… 친구를 동경하면서도 그저 부러워할 수밖에 없었던 미나미사와 센리야……」"},
{"id": "clse07:403300", "ko": "「미안해…… 지금까지 속여서」"},
{"id": "clse07:403400", "ko": "「사과한다고 용서받을 수 있을 거라고는 생각 안 하지만……」"},
{"id": "clse07:403500", "ko": "「그래도! 그래도 이것만은 알아줬으면 해!」"},
{"id": "clse07:403600", "ko": "「나랑 타쿠루는 지금까지 쭉 남매로 지내 왔어. 거기에 떳떳하지 못한 일은 아무것도 없어!」"},
{"id": "clse07:403700", "ko": "「그러니까…… 타쿠루를 처분하는 건 잘못됐어……」"},
{"id": "clse07:403800", "ko": "「벌이라면 내가 받을 테니까……」"},
{"id": "clse07:403900", "ko": "「모두를 속여 온 책임도…… 제대로 질 테니까……」"},
{"id": "clse07:404000", "ko": "「타쿠루……」"},
{"id": "clse07:404100", "ko": "「다들……」"},
{"id": "clse07:404200", "ko": "「응……」"},
{"id": "clse07:404300", "ko": "「타쿠루…… 울고 있어?」"},
{"id": "clse07:404400", "ko": "「그치만…… 기뻐서……」"},
{"id": "clse07:404500", "ko": "「그래도 좀 복잡한 기분이야……」"},
{"id": "clse07:404600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:404700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:404800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:404900", "ko": "「타, 타쿠루……?」"},
{"id": "clse07:405000", "ko": "「타, 쿠루……」"},
{"id": "clse07:405100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:405200", "ko": "「…………」"},
{"id": "clse07:405300", "ko": "「히카리……」"},
{"id": "clse07:405400", "ko": "「잘 지내……」"},
{"id": "clse07:405500", "ko": "「어?」"},
{"id": "clse07:405600", "ko": "「히카리……」"},
{"id": "clse07:405700", "ko": "「저기…… 무슨 얘기야?」"},
{"id": "clse07:405800", "ko": "「으, 응…… 뭐……」"},
{"id": "clse07:405900", "ko": "「고, 고마워……」"},
{"id": "clse07:406000", "ko": "「얘기는 그게 다야? 그럼 나……」"},
{"id": "clse07:406100", "ko": "「뭐?」"},
{"id": "clse07:406200", "ko": "「…………?」"},
{"id": "clse07:406300", "ko": "「별로……」"},
{"id": "clse07:406400", "ko": "「저기, 카와하라? 아까부터 뭘……」"},
{"id": "clse07:406500", "ko": "「응?」"},
{"id": "clse07:406600", "ko": "「……왜?」"},
{"id": "clse07:406700", "ko": "「저기…… 미안해」"},
{"id": "clse07:406800", "ko": "「카와하라는 친구지만, 그 이상으로 생각해 본 적은 없어」"},
{"id": "clse07:406900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:407000", "ko": "「얘기는 그게 다야? 그럼 나는 이만……」"},
{"id": "clse07:407100", "ko": "「타쿠루. 차 마실래?」"},
{"id": "clse07:407200", "ko": "「안〜돼. 이런 시간에 그렇게 카페인 많은 걸 마시면 잠이 안 오잖아」"}
]
