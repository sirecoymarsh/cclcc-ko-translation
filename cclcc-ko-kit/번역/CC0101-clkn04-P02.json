[
{"id": "clkn04:10000", "ko": "「아니야! 그런 게 아니라……」"},
{"id": "clkn04:10100", "ko": "「혼자서만 즐기다니 치사해~!」"},
{"id": "clkn04:10200", "ko": "뭐?"},
{"id": "clkn04:10300", "ko": "「잠깐 빌려주세요! 얍!」"},
{"id": "clkn04:10400", "ko": "내가 어안이 벙벙해 있는 사이에 아리무라가 내 스마트폰을 낚아챘고, 이윽고 그 스피커에서 목소리가 새어 나왔다."},
{"id": "clkn04:10500", "ko": "「지각이야. 자기가 불러 놓고 늦다니, 기본이 안 돼 있네」"},
{"id": "clkn04:10600", "ko": "「……미안」"},
{"id": "clkn04:10700", "ko": "「아니, 아무리 그래도 엿듣는 건 나쁘잖아」"},
{"id": "clkn04:10800", "ko": "「뭔 소리임까. 혼자서 엿듣고 있었으면서」"},
{"id": "clkn04:10900", "ko": "「아니, 그러니까 그건……」"},
{"id": "clkn04:11000", "ko": "「그래, 미야시로. 게다가 이건 엿듣는 게 아니야. 조사다」"},
{"id": "clkn04:11100", "ko": "「조사……」"},
{"id": "clkn04:11200", "ko": "「그 카와하라잖아. 또 우리한테 무슨 시비라도 걸 생각일지도 몰라. 그러니까 이건 엄연한 조사라고」"},
{"id": "clkn04:11300", "ko": "……그렇게 말하니…… 확실히 무슨 얘기를 할 생각인지 궁금하긴 하네."},
{"id": "clkn04:11400", "ko": "「뭐, 뭐어, 조사라면 어쩔 수 없…… 지」"},
{"id": "clkn04:11500", "ko": "이토의 편리한 말로 스스로를 정당화하고서, 우리는 벽에 붙어 몸을 숨긴 채 다시 스피커에서 나오는 목소리에 귀를 기울였다."},
{"id": "clkn04:11600", "ko": "「그래서…… 무슨 일이야? 도시락통 돌려주는 거라면 굳이 이런 데까지 안 와도 됐잖아?」"},
{"id": "clkn04:11700", "ko": "「음…… 뭐, 그것만이 아니니까 부른 거지만」"},
{"id": "clkn04:11800", "ko": "「부부장이 카와하라한테 도시락을? 어떻게 된 거야?」"},
{"id": "clkn04:11900", "ko": "이토의 의문에 대답하는 사람은 아무도 없었고, 다들 그저 스피커에서 들려오는 대화에 귀를 기울이고 있었다."},
{"id": "clkn04:12000", "ko": "「일단, 이거. 도시락 진짜 맛있었어. 게다가 그렇게 공들인 도시락을 만들어 와 주다니 감격이야」"},
{"id": "clkn04:12100", "ko": "「아, 응…… 근데 그건――」"},
{"id": "clkn04:12200", "ko": "「알아. 그렇게 정성 들인 도시락은 아무한테나 만들어 줄 수 없다는 거지?」"},
{"id": "clkn04:12300", "ko": "「어?」"},
{"id": "clkn04:12400", "ko": "「미안했다, 쿠루스. 원래는 내 쪽에서 더 빨리 말했어야 했는데」"},
{"id": "clkn04:12500", "ko": "「저기, 카와하라……?」"},
{"id": "clkn04:12600", "ko": "자, 잠깐만. 이 전개는……"},
{"id": "clkn04:12700", "ko": "「있잖아 있잖아, 타쿠! 이거 혹시이……」"},
{"id": "clkn04:12800", "ko": "「쉿! 세리! 지금 좋은 데니까 조용히 해!!」"},
{"id": "clkn04:12900", "ko": "「내 마음은 계속 전해지고 있다고 생각했어. 하지만 그렇지? 제대로 말해 주지 않으면 모르는 거지?」"},
{"id": "clkn04:13000", "ko": "「특히 여자는 그런 생물이라고들 하니까……」"},
{"id": "clkn04:13100", "ko": "「잠깐, 아까부터 무슨――」"},
{"id": "clkn04:13200", "ko": "「괜찮아! 무서워하지 않아도 돼. 불안해할 필요 없으니까……」"},
{"id": "clkn04:13300", "ko": "「…………!」"},
{"id": "clkn04:13400", "ko": "카와하라가 거리를 좁혔다."},
{"id": "clkn04:13500", "ko": "그리고――."},
{"id": "clkn04:13600", "ko": "「나왔다~! ⟦col:280aa02d1400⟧벽쿵⟦col:800000⟧!!」"},
{"id": "clkn04:13700", "ko": "아니, 이 경우엔 펜스쿵이라고 해야 하나."},
{"id": "clkn04:13800", "ko": "「네 마음을 받아들이지. 내 여자가 되어라, 쿠루스……」"},
{"id": "clkn04:13900", "ko": "「우웩…… 최악……」"},
{"id": "clkn04:14000", "ko": "「…………」"},
{"id": "clkn04:14100", "ko": "카와하라의 말에 노노는 그저 입을 다문 채."},
{"id": "clkn04:14200", "ko": "그 침묵이 결코 감격한 나머지 말을 잃은 게 아니라는 건 우리도 금방 알 수 있었다."},
{"id": "clkn04:14300", "ko": "하지만 카와하라는 그렇지 않았던 모양이다."},
{"id": "clkn04:14400", "ko": "「엇?」"},
{"id": "clkn04:14500", "ko": "노노를 똑바로 바라보는 카와하라."},
{"id": "clkn04:14600", "ko": "그리고――."},
{"id": "clkn04:14700", "ko": "「뭐!」"},
{"id": "clkn04:14800", "ko": "「으으으읍!!?」"},
{"id": "clkn04:14900", "ko": "천천히 얼굴을 가까이 가져갔다."},
{"id": "clkn04:15000", "ko": "「쿠루스……」"},
{"id": "clkn04:15100", "ko": "「잠――!!」"},
{"id": "clkn04:15200", "ko": "「자, 잠깐 기다――읏!!」"},
{"id": "clkn04:15300", "ko": "내가 저도 모르게 소리치려던 그때, 노노가 두 손으로 카와하라의 몸을 힘껏 밀쳐 냈다."},
{"id": "clkn04:15400", "ko": "「좋았어!!」"},
{"id": "clkn04:15500", "ko": "아리무라가 옆에서 작게 주먹을 불끈 쥐었다."},
{"id": "clkn04:15600", "ko": "나는 어째선지 나도 주먹을 꽉 쥐고 있었다는 걸 깨달았다."},
{"id": "clkn04:15700", "ko": "떠밀린 카와하라는 무슨 일이 일어났는지 모르겠다는 얼굴로 멍하니 노노를 보고 있다."},
{"id": "clkn04:15800", "ko": "「쿠루스……」"},
{"id": "clkn04:15900", "ko": "「가, 갑자기 무슨 짓이야!?」"},
{"id": "clkn04:16000", "ko": "「……아, 아아, 그렇군…… 아무래도 너무 갑작스러웠나. 마음의 준비라는 것도 필요하겠지」"},
{"id": "clkn04:16100", "ko": "「그게 아니야. 내가 하고 싶은 말은 그런 게 아니라――」"},
{"id": "clkn04:16200", "ko": "「???」"},
{"id": "clkn04:16300", "ko": "「카와하라. 너 여러 가지로 착각하고 있어」"},
{"id": "clkn04:16400", "ko": "「착각? 무슨 소리야?」"},
{"id": "clkn04:16500", "ko": "「그 도시락은 딱히 너를 위해 만든 게 아니야」"},
{"id": "clkn04:16600", "ko": "「……이제 와서 쑥스러워할 것까진 없잖아」"},
{"id": "clkn04:16700", "ko": "「쑥스러워하는 거 아니야. 그건 원래 그…… 가족을 위해 만든 거야. 그런데 어쩌다 필요 없어졌고, 마침 네가 배고파 보여서」"},
{"id": "clkn04:16800", "ko": "그 말로 나는 이해했다."},
{"id": "clkn04:16900", "ko": "가족이라고 얼버무리긴 했지만, 그건 분명 나를 위한 거였다."},
{"id": "clkn04:17000", "ko": "하지만 나는 점심시간에 오노에와 아리무라네의 ⟦col:280aa02d1400⟧베이글⟦col:800000⟧을 먹어 버렸다."},
{"id": "clkn04:17100", "ko": "그래서 노노는…… 결국 그런 거였구나."},
{"id": "clkn04:17200", "ko": "「기다려 줘! 하지만 너는――」"},
{"id": "clkn04:17300", "ko": "「그리고 미안하지만, 난 너를 그냥 친구로밖에 볼 수 없어」"},
{"id": "clkn04:17400", "ko": "「뭐…… 뭐, 뭐……」"},
{"id": "clkn04:17500", "ko": "카와하라는 그 말이 정말 뜻밖이라는 듯 입을 뻐끔거렸다."},
{"id": "clkn04:17600", "ko": "「어, 어어, 어째서? 자랑은 아니지만 나는 성적도 좋은 편이고 운동신경도 나쁘지 않아. 인망도 있고, 무엇보다 부회장으로서 계속 너를 받쳐 왔잖아!?」"},
{"id": "clkn04:17700", "ko": "「대체 뭐가 불만이라는 거야!」"},
{"id": "clkn04:17800", "ko": "「오해하게 했다면 미안해……」"},
{"id": "clkn04:17900", "ko": "「어째서야? 혹시 좋아하는 녀석이라도……」"},
{"id": "clkn04:18000", "ko": "「!! 서, 설마 미야……」⟦avs⟧⟦n⟧⟦n⟧"},
{"id": "clkn04:18100", "ko": "「아니야. 그런 게 아니야. 지금 난 누구하고도 사귈 생각이 없어……」"},
{"id": "clkn04:18200", "ko": "「누구하고도……」"},
{"id": "clkn04:18300", "ko": "「으, 응……」"},
{"id": "clkn04:18400", "ko": "「그, 그렇, 군……」"},
{"id": "clkn04:18500", "ko": "「미안…… 해……」"},
{"id": "clkn04:18600", "ko": "「하하…… 하하하…… 뭐야, 뭐냐고…… 그런 건 빨리 말하라고……」"},
{"id": "clkn04:18700", "ko": "「이래서야 내가 바보 같잖아……」"},
{"id": "clkn04:18800", "ko": "카와하라는 노노에게 등을 돌리고 휘청거리는 걸음으로 걸어가나 싶더니, 문득 돌아보며――."},
{"id": "clkn04:18900", "ko": "「쿠, 쿠루스! 말해 두는데, 이 일은 아무한테도 말하지 마! 절대 말하지 마!!」"},
{"id": "clkn04:19000", "ko": "하고 신신당부하더니 달려가 버렸다."},
{"id": "clkn04:19100", "ko": "「…………」"},
{"id": "clkn04:19200", "ko": "「「「「「하아~……」」」」」"},
{"id": "clkn04:19300", "ko": "남아 있던 노노마저 떠나 두 사람이 모두 사라지자마자, 우리는 크게 숨을 내쉬었다."},
{"id": "clkn04:19400", "ko": "「그나저나 놀랐다~」"},
{"id": "clkn04:19500", "ko": "「그, 그래……」"},
{"id": "clkn04:19600", "ko": "남의 고백이라지만 그렇게 숨 막히는 건 줄은 몰랐다."},
{"id": "clkn04:19700", "ko": "「그나저나 카와하라도 배짱 있네~. 그 ⟦col:280aa02d1400⟧여제⟦col:800000⟧한테 말이야」"},
{"id": "clkn04:19800", "ko": "「왜? 노노는 귀엽고 성격도 좋고 집안일도 뭐든지 척척 해내는 ⟦col:280aa02d1400⟧멋진 여자⟦col:800000⟧잖아?」"},
{"id": "clkn04:19900", "ko": "「그럴지도 모르지만…… 보통 생각하면 안 될 거라는 거, 처음부터 뻔하잖아」"}
]
