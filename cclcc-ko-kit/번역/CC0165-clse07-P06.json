[
{"id": "clse07:49800", "ko": "「좋아, 정했다! 모처럼 쉬는 날이니까 오늘은 놀러 가요!」"},
{"id": "clse07:49900", "ko": "「기각이다!」"},
{"id": "clse07:50000", "ko": "「네네, 그렇게 정해졌으면 준비 준비! 가요, 자!!」"},
{"id": "clse07:50100", "ko": "「왜 그러심까? 어려운 얼굴을 하고」"},
{"id": "clse07:50200", "ko": "「아아, 오늘은 그거, 쉬는 날임다. 휴일이니까요. 어라? 말 안 했었나요?」"},
{"id": "clse07:50300", "ko": "「그런 고로, 선배도 가끔은 날개를 펴고 리프레시하세요」"},
{"id": "clse07:50400", "ko": "「그래서 어디로 갈래요?」"},
{"id": "clse07:50500", "ko": "「영화아?」"},
{"id": "clse07:50600", "ko": "「저, 지어낸 이야기는 질색임다~」"},
{"id": "clse07:50700", "ko": "「소설에는 진실이 있지만, 영화는 역시 거짓말이 많잖아요」"},
{"id": "clse07:50800", "ko": "「아예 완전히 거짓말인 이야기라면 좋은데요~. 이렇게, 콰콰콰~, 쾅~ 같은」"},
{"id": "clse07:50900", "ko": "「어머나」"},
{"id": "clse07:51000", "ko": "「아무거나 괜찮슴다. 저 그렇게 진지하게 안 보니까」"},
{"id": "clse07:51100", "ko": "「아, 거짓말 거짓말~. 그럼 선배한테 맡길게요」"},
{"id": "clse07:51200", "ko": "「싫다~. 아무리 그래도 거기까지는 안 해요~」"},
{"id": "clse07:51300", "ko": "「우와~, 이거임까……」"},
{"id": "clse07:51400", "ko": "「와아~ 휴먼 드라마. 히나에, 휴먼 드라마 너무 좋아~」"},
{"id": "clse07:51500", "ko": "「으허어어어엉……!」"},
{"id": "clse07:51600", "ko": "「우에엑…… 에에에에에에엥~……」"},
{"id": "clse07:51700", "ko": "「그러니가 말했잖슴가아…… 질색이라고오오……」"},
{"id": "clse07:51800", "ko": "「저어 그런 얘기 약하단 말이에요오오오……」"},
{"id": "clse07:51900", "ko": "「으으…… 히끅……」"},
{"id": "clse07:52000", "ko": "「그럼 제 부탁 들어줄래요오~?」"},
{"id": "clse07:52100", "ko": "「크레페 먹고 싶어……」"},
{"id": "clse07:52200", "ko": "「에헤헤헤~」"},
{"id": "clse07:52300", "ko": "「응? 혹시 크림 묻었어요?」"},
{"id": "clse07:52400", "ko": "「뭐, 뭠까 뭠까? 아까부터 빤히 보고~」"},
{"id": "clse07:52500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:52600", "ko": "「네?」"},
{"id": "clse07:52700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:52800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:52900", "ko": "「있잖아요. 지금 어떤 기분이에요? 어떤 기분이에요?」"},
{"id": "clse07:53000", "ko": "「…………」"},
{"id": "clse07:53100", "ko": "「아, 그러니까……」"},
{"id": "clse07:53200", "ko": "「뭐? 따, 딱히 쑥스러워하는 거 아니거든여!」"},
{"id": "clse07:53300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:53400", "ko": "「서, 선배 크레페 맛있어 보임다~!」"},
{"id": "clse07:53500", "ko": "「빈틈 발견~! 냠!」"},
{"id": "clse07:53600", "ko": "「음…… 맛있다~」"},
{"id": "clse07:53700", "ko": "「아……」"},
{"id": "clse07:53800", "ko": "「아, 그러니까, 방금 건 그게에……」"},
{"id": "clse07:53900", "ko": "「…………」"},
{"id": "clse07:54000", "ko": "「꺅!!!」"},
{"id": "clse07:54100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:54200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:54300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:54400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:54500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:54600", "ko": "「읏…………」"},
{"id": "clse07:54700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:54800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:54900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:55000", "ko": "「…………」"},
{"id": "clse07:55100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:55200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:55300", "ko": "「읏……」"},
{"id": "clse07:55400", "ko": "「역시 안 돼! 이제 입 다물고 있을 수 없어!」"},
{"id": "clse07:55500", "ko": "「미야시로 선배…… 실은 저, 선배한테 말해야 하는 게 있는데요」"},
{"id": "clse07:55600", "ko": "「있잖아요. 실은요…… 그게…… 풉!」"},
{"id": "clse07:55700", "ko": "「으아~ 이제 참는 거 무리~! 완전 창피하거든요~」"},
{"id": "clse07:55800", "ko": "「선배, 오늘 집 나오기 전에 거울 봤어요? 안 봤죠~?」"},
{"id": "clse07:55900", "ko": "「있잖아요……………… 코털 나와 있어요~!!」"},
{"id": "clse07:56000", "ko": "「게다가 양쪽 구멍에서. 빽빽하게!」"},
{"id": "clse07:56100", "ko": "「완전 수북하게!」"},
{"id": "clse07:56200", "ko": "「으아~ 언제 눈치채나 하고 기다렸는데, 아무래도 이 이상 같이 있는 건 창피해~!」"},
{"id": "clse07:56300", "ko": "「맞다 맞다, 그리고요……」"},
{"id": "clse07:56400", "ko": "「지퍼 열렸어요~」"},
{"id": "clse07:56500", "ko": "「그리고 셔츠, 안팎이 뒤집혔고요~」"},
{"id": "clse07:56600", "ko": "「뭔가 말라붙은 밥알도 묻어 있고요~」"},
{"id": "clse07:56700", "ko": "「뒤통수에 까치집 졌고요~」"},
{"id": "clse07:56800", "ko": "「양말도 좌우가 달라요~」"},
{"id": "clse07:56900", "ko": "「용케도 그 꼴로 밖을 걸어 다녔네요~. 저는 같이 걷는 것만으로도 얼굴이 빨개질 지경이었는데!」"},
{"id": "clse07:57000", "ko": "「선배 위험해요!!」"},
{"id": "clse07:57100", "ko": "「괜찮아요?」"},
{"id": "clse07:57200", "ko": "「정말, 멍하니 있으니까」"},
{"id": "clse07:57300", "ko": "「자, 보여 주세요」"},
{"id": "clse07:57400", "ko": "「그래요……? 그럼 됐지만」"},
{"id": "clse07:57500", "ko": "「다음엔 어디 갈까나~」"},
{"id": "clse07:57600", "ko": "「새근…… 새근……」"},
{"id": "clse07:57700", "ko": "「새근…… 새근……」"},
{"id": "clse07:57800", "ko": "「그런 거야. 미안해~, 하나」"},
{"id": "clse07:57900", "ko": "「아니~, 쿠루스 선배네는 가족이 많잖슴까~. 그래서 왠지 미안해서」"},
{"id": "clse07:58000", "ko": "「우…… 쿠루스 선배랑 목욕…… 그건 좀 사양할게요」"},
{"id": "clse07:58100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:58200", "ko": "「아, 미안 미안, 농담이니까! 그렇게 슬픈 얼굴 하지 마!」"},
{"id": "clse07:58300", "ko": "「아~ 우키~! 요것이, 이렇게 해 주마~!!」"},
{"id": "clse07:58400", "ko": "「아이고~ 덕분에 살았어~」"},
{"id": "clse07:58500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:58600", "ko": "「아~…… 역시 그렇슴까……」"},
{"id": "clse07:58700", "ko": "（그게 문제란 말이지……）"},
{"id": "clse07:58800", "ko": "「…………」"},
{"id": "clse07:58900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:59000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:59100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:59200", "ko": "「…………」"},
{"id": "clse07:59300", "ko": "「……그러고 보니 어떻게 하려나?」"},
{"id": "clse07:59400", "ko": "「아하하하하~…… 그만 폭주해서 여기까지 와 버렸는데, 아무것도」"},
{"id": "clse07:59500", "ko": "「아~. 너무해~」"},
{"id": "clse07:59600", "ko": "「하나까지!」"},
{"id": "clse07:59700", "ko": "「잠깐, 이쪽은 듣지도 않고!!」"}
]
