[
{"id": "clse07:527300", "ko": "「……읏!」"},
{"id": "clse07:527400", "ko": "「아, 아무것도 아니야」"},
{"id": "clse07:527500", "ko": "「정말로 다른 사람은 아무도 없었던 거지?」"},
{"id": "clse07:527600", "ko": "「어? 카즈키?」"},
{"id": "clse07:527700", "ko": "「카즈키도 왔었어?」"},
{"id": "clse07:527800", "ko": "「베이스캠프?」"},
{"id": "clse07:527900", "ko": "「그래서 카즈키는 왜 뒤풀이에 참가 안 했어?」"},
{"id": "clse07:528000", "ko": "（사진 건이랑은 관계없어 보이지만, 일단 확인해 둘까）"},
{"id": "clse07:528100", "ko": "「저기, 카즈키. 왜 먼저 돌아갔어?」"},
{"id": "clse07:528200", "ko": "「카즈키?」"},
{"id": "clse07:528300", "ko": "「어라?」"},
{"id": "clse07:528400", "ko": "「어, 그래?」"},
{"id": "clse07:528500", "ko": "「실례합니다〜……」"},
{"id": "clse07:528600", "ko": "「카즈키, 있, 는 거야……?」"},
{"id": "clse07:528700", "ko": "「힉!」"},
{"id": "clse07:528800", "ko": "「……진정해. 딱히 갇힌 게 아니야」"},
{"id": "clse07:528900", "ko": "「우와, 땀 냄새……」"},
{"id": "clse07:529000", "ko": "「아, 아니, 잘못 건 전화 아닐까? 바로 끊긴 것 같아」"},
{"id": "clse07:529100", "ko": "「그, 그렇네」"},
{"id": "clse07:529200", "ko": "「잠깐 카즈키 찾아볼게. 자세히 얘기 듣고 싶으니까」"},
{"id": "clse07:529300", "ko": "「아아아아니, 나, 나 혼자 갈 테니까! 다다다들은 여기서 기다려 줘!」"},
{"id": "clse07:529400", "ko": "「아무것도 아니야! 아무것도 아니니까! 알았지!? 따라오지 마!?」"},
{"id": "clse07:529500", "ko": "「괜찮아. 태연한 척했으니까 다들 수상하게 여기지 않았을 거야」"},
{"id": "clse07:529600", "ko": "「자……」"},
{"id": "clse07:529700", "ko": "「이런 데로 불러내서 무슨 볼일이지?」"},
{"id": "clse07:529800", "ko": "「……아니, 잠깐?」"},
{"id": "clse07:529900", "ko": "「혹시……!」"},
{"id": "clse07:530000", "ko": "「설마!」"},
{"id": "clse07:530100", "ko": "「여기 찍혀 있는 이 여자애가――!」"},
{"id": "clse07:530200", "ko": "「――카즈키 친구라든가?」"},
{"id": "clse07:530300", "ko": "「아니 그래도 그렇다면 부실에서 알려 줘도 될 텐데」"},
{"id": "clse07:530400", "ko": "「뭐, 이 사진을 남들 앞에 내놓을 수 없는 건 확실하니까, 카즈키가 그걸 배려했는지도 몰라」"},
{"id": "clse07:530500", "ko": "「어쨌든 본인한테 물어보면 확실해지겠지」"},
{"id": "clse07:530600", "ko": "「그나저나 늦네――」"},
{"id": "clse07:530700", "ko": "「뭐뭐뭐뭐뭣!?」"},
{"id": "clse07:530800", "ko": "「크억!?」"},
{"id": "clse07:530900", "ko": "「카, 카즈키!?」"},
{"id": "clse07:531000", "ko": "「카, 카즈키? 이, 일단 좀 떨어져 줄래?」"},
{"id": "clse07:531100", "ko": "「카, 카즈키, 네 목적은 뭐야――」"},
{"id": "clse07:531200", "ko": "「카즈키……?」"},
{"id": "clse07:531300", "ko": "「카, 카즈키!?」"},
{"id": "clse07:531400", "ko": "「대체 왜 그래!?」"},
{"id": "clse07:531500", "ko": "「어?」"},
{"id": "clse07:531600", "ko": "「어린, 양?」"},
{"id": "clse07:531700", "ko": "「……그건, 설마」"},
{"id": "clse07:531800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:531900", "ko": "「아얏! 뭐, 뭐 하는 거야!」"},
{"id": "clse07:532000", "ko": "「뭐뭐뭐, 무슨 소리야!」"},
{"id": "clse07:532100", "ko": "「아얏!」"},
{"id": "clse07:532200", "ko": "「아얏! 자, 잠깐! 왜 내가 맞아야 하는데!」"},
{"id": "clse07:532300", "ko": "「어어어, 언제부터……?」"},
{"id": "clse07:532400", "ko": "「아얏!」"},
{"id": "clse07:532500", "ko": "「아팟!」"},
{"id": "clse07:532600", "ko": "「으앗!」"},
{"id": "clse07:532700", "ko": "「카, 카즈키?」"},
{"id": "clse07:532800", "ko": "「이이이, 이 상황에 대해 나는 일절 잘못이 없으니까」"},
{"id": "clse07:532900", "ko": "「올라탄 건 너, 너, 너니까」"},
{"id": "clse07:533000", "ko": "「아, 아무튼 일단 좀 비켜 줄래」"},
{"id": "clse07:533100", "ko": "「그리고 무엇 때문에 나를 여기 불렀는지 알려 줘」"},
{"id": "clse07:533200", "ko": "「어?」"},
{"id": "clse07:533300", "ko": "「하나, 만? 카즈키, 너 뭘――」"},
{"id": "clse07:533400", "ko": "「뭣!?」"},
{"id": "clse07:533500", "ko": "「대, 대시!? 그게 뭐야!!」"},
{"id": "clse07:533600", "ko": "「떠올리라니, 대체 뭘――」"},
{"id": "clse07:533700", "ko": "「호, 호, 호」"},
{"id": "clse07:533800", "ko": "「혹혹혹혹혹혹혹혹혹혹」"},
{"id": "clse07:533900", "ko": "「혹시 그 셀카, 카즈키야!?」"},
{"id": "clse07:534000", "ko": "「……전혀 몰랐어」"},
{"id": "clse07:534100", "ko": "「애초에 카즈키가 그런 사진을 찍는다는 것 자체가 상상 밖이었으니까……」"},
{"id": "clse07:534200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:534300", "ko": "「그, 그게 무슨 소리야?」"},
{"id": "clse07:534400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:534500", "ko": "「힉!」"},
{"id": "clse07:534600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:534700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:534800", "ko": "「아니아니아니아니!」"},
{"id": "clse07:534900", "ko": "「상황을 이해 못 하고 있을 뿐이야!」"},
{"id": "clse07:535000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:535100", "ko": "「뭐어!?」"},
{"id": "clse07:535200", "ko": "「아니, 저기!?」"},
{"id": "clse07:535300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:535400", "ko": "「뭐냐니……」"},
{"id": "clse07:535500", "ko": "「기, 기다려 줘 쿠루스! 이건 사정이 있어!」"},
{"id": "clse07:535600", "ko": "「카즈키! 너도 설명 좀 해 줘!」"},
{"id": "clse07:535700", "ko": "「카즈키?」"},
{"id": "clse07:535800", "ko": "「야! 모르는 척하지 마! 원래는 네가――!」"},
{"id": "clse07:535900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:536000", "ko": "「핫! 쿠, 쿠루스!?」"},
{"id": "clse07:536100", "ko": "「지, 진짜라니까! 나는 무죄야!」"},
{"id": "clse07:536200", "ko": "「아니 그러니까 오해라니까!」"},
{"id": "clse07:536300", "ko": "「진짜라고!」"},
{"id": "clse07:536400", "ko": "「메일로 불려서 거기 갔더니, 갑자기 뒤에서 카즈키가 끌어안았다고!」"},
{"id": "clse07:536500", "ko": "「사실이야!」"},
{"id": "clse07:536600", "ko": "「그치, 카즈키! 내 말이 맞지!?」"},
{"id": "clse07:536700", "ko": "「쿠루스한테 말해 줘! 응!」"},
{"id": "clse07:536800", "ko": "「말도 안 돼!?」"},
{"id": "clse07:536900", "ko": "「야, 이토, 오노에, 아리무라! 너희도 뭐라고 좀 해 줘!」"},
{"id": "clse07:537000", "ko": "「뭣!?」"},
{"id": "clse07:537100", "ko": "「무슨 뜻이야!」"},
{"id": "clse07:537200", "ko": "「너는 무슨 소리를 하는 거야!」"}
]
