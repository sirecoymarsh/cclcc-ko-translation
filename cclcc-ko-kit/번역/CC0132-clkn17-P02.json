[
{"id": "clkn17:10000", "ko": "「…………」"},
{"id": "clkn17:10100", "ko": "실컷 떠들더니 다들 가 버렸다."},
{"id": "clkn17:10200", "ko": "「뭐야, 저건……」"},
{"id": "clkn17:10300", "ko": "「후훗, 참……」"},
{"id": "clkn17:10400", "ko": "그건 그렇고……"},
{"id": "clkn17:10500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn17:10600", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn17:10700", "ko": "「히카리…… 잘 지내고 있을까……?」"},
{"id": "clkn17:10800", "ko": "「어? 아, 응…… 뭐, 잘 지내지 않을까……?」"},
{"id": "clkn17:10900", "ko": "「그렇다면 다행이지만……」"},
{"id": "clkn17:11000", "ko": "「역시 쓸쓸해?」"},
{"id": "clkn17:11100", "ko": "「그렇네……」"},
{"id": "clkn17:11200", "ko": "「그래도 그게 히카리를 위해서 제일 좋은 거잖아」"},
{"id": "clkn17:11300", "ko": "「응……」"},
{"id": "clkn17:11400", "ko": "히카리를 가장 많이 돌본 건 그녀니까, 당연하다면 당연한지도 모르지만."},
{"id": "clkn17:11500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn17:11600", "ko": "「헐!?」"},
{"id": "clkn17:11700", "ko": "이상한 소리가 나왔다."},
{"id": "clkn17:11800", "ko": "「너, 너너, 너…… 무슨 소리를……!!」"},
{"id": "clkn17:11900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn17:12000", "ko": "「아니, 시기의 문제가 아니잖아!」"},
