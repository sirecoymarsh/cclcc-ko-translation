[
{"id": "clka03:0", "ko": "――몇 분 뒤. 나는 드디어 최적의 장소를 찾아냈다."},
{"id": "clka03:100", "ko": "누구의 방해도 없이 혼자 생각할 수 있는 곳이라면 여기밖에 없다."},
{"id": "clka03:200", "ko": "화장실이다."},
{"id": "clka03:300", "ko": "5층 맨 안쪽에 있는 이 남자 화장실은 이용하기 불편해서 보통 학생들은 좀처럼 쓰지 않는다."},
{"id": "clka03:400", "ko": "솔직히 말해서 평소엔 나랑 이토밖에 안 쓰는 게 아닐까 싶다. 몸을 숨기기에 절호의 장소였다."},
{"id": "clka03:500", "ko": "「――그럼」"},
{"id": "clka03:600", "ko": "「다시 생각해 보자」"},
{"id": "clka03:700", "ko": "「사진에 찍힌 이 여자애가 누구인지에 대해서」"},
{"id": "clka03:800", "ko": "「올바른 답을 이끌어 내려면 올바른 추론을 세워야 한다」"},
{"id": "clka03:900", "ko": "「올바른 추론을 세우려면 올바른 데이터, 즉 사실을 쌓아 올려야 한다」"},
{"id": "clka03:1000", "ko": "「좋아, 우선 이 사진에서 읽어 낼 수 있는 사실을 모아 가자」"},
{"id": "clka03:1100", "ko": "「우선 주위 배경부터 확인하자」"},
{"id": "clka03:1200", "ko": "「벼, 별로 갑자기 반라의 여자애를 똑바로 보는 데 겁먹은 건 아니니까」"},
{"id": "clka03:1300", "ko": "「……누구한테 변명하는 거야, 나는?」"},
{"id": "clka03:1400", "ko": "「좋아」"},
{"id": "clka03:1500", "ko": "「여자애가 앉아 있는 건 침대겠지」"},
{"id": "clka03:1600", "ko": "「이 애 뒤로 뻗은 그림자 길이로 침대 폭을 추측할 수 있다. 꽤 좁다. 보통 침대가 아니야」"},
{"id": "clka03:1700", "ko": "「스프링도 그리 좋은 걸 쓰지 않았다. 이 애의 하반신이 가라앉은 정도를 보면 그것도 분명하다」"},
{"id": "clka03:1800", "ko": "「이 두 가지에서 이끌어 낼 수 있는 추론, 그건 즉――」"},
{"id": "clka03:1900", "ko": "「――이 애가 걸터앉아 있는 건 간이침대다!」"},
{"id": "clka03:2000", "ko": "「더 말하자면, 그건 내 캠핑카의 간이침대다!」"},
{"id": "clka03:2100", "ko": "……"},
{"id": "clka03:2200", "ko": "…………"},
{"id": "clka03:2300", "ko": "…………허무하다."},
{"id": "clka03:2400", "ko": "추리나 수수께끼 풀이는 책 좋아하는 고등학생이라면 누구나 한 번쯤 동경하는 것이다."},
{"id": "clka03:2500", "ko": "어쩐지 분위기를 타서 해 버렸지만, 딱히 방금 그 추리 과정은 애초에 필요 없었다."},
{"id": "clka03:2600", "ko": "침대 구조 같은 데 주목하지 않아도 더 알기 쉬운 사실이 사진에 찍혀 있으니까."},
{"id": "clka03:2700", "ko": "「――이토」"},
{"id": "clka03:2800", "ko": "여자애 발치에 바보 같은 자는 얼굴을 드러낸 이토의 얼굴이 화면 끝에 걸쳐 있었다."},
{"id": "clka03:2900", "ko": "「이토가 있다는 건, 내 캠핑카겠지」"},
{"id": "clka03:3000", "ko": "이토와 이 수수께끼의 여자애는 무슨 관계일까."},
{"id": "clka03:3100", "ko": "적어도 두 사람 말고 사진에 찍힌 인물은 없다."},
{"id": "clka03:3200", "ko": "「……설마, 이토의 여자 친구라든가?」"},
{"id": "clka03:3300", "ko": "「아니아니아니아니아니」"},
{"id": "clka03:3400", "ko": "「없어없어없어없어없어없어없어」"},
{"id": "clka03:3500", "ko": "「그럴 리 그럴 리 그럴 리 그럴 리」"},
{"id": "clka03:3600", "ko": "「설마설마설마설마」"},
{"id": "clka03:3700", "ko": "「그런 일이 있어서 되겠냐!!!!!」"},
{"id": "clka03:3800", "ko": "……헉."},
{"id": "clka03:3900", "ko": "나도 모르게 흥분해 버렸다."},
{"id": "clka03:4000", "ko": "진정해."},
{"id": "clka03:4100", "ko": "「이토와 여자애의 관계는 일단 제쳐 두자」"},
{"id": "clka03:4200", "ko": "「사실로 셀 수 있는 건, 여자애가 이 셀카를 찍었을 때 옆에서 이토가 자고 있었다. 그것뿐이다」"},
{"id": "clka03:4300", "ko": "하지만 그건 대체 어떤 상황이지?"},
{"id": "clka03:4400", "ko": "적어도 기억하는 한, 신문부를 만든 이래 내 캠핑카에 생판 모르는 여자애를 데려온 적은 없다."},
{"id": "clka03:4500", "ko": "「……응? 기억하는 한?」"},
{"id": "clka03:4600", "ko": "「혹시!」"},
{"id": "clka03:4700", "ko": "스마트폰을 조작해서 사진을 찍은 날짜를 확인한다."},
{"id": "clka03:4800", "ko": "「역시! 어제다!」"},
{"id": "clka03:4900", "ko": "어제 23시 14분."},
{"id": "clka03:5000", "ko": "내 기억이 없는 시간대다."},
{"id": "clka03:5100", "ko": "「어젯밤 늦게, 적어도 이 여자애와 이토는 거기 있었다는 거다」"},
{"id": "clka03:5200", "ko": "사진에는 내 모습이 찍혀 있지 않다. 그러니 그 자리에 내가 있었는지는 모른다."},
{"id": "clka03:5300", "ko": "「그래도 뭐, 있었다고 생각하는 게 타당하겠지」"},
{"id": "clka03:5400", "ko": "그리고 아침에 눈을 떴을 때 캠핑카에는 나밖에 없었다."},
{"id": "clka03:5500", "ko": "즉, 여자애뿐 아니라 이토도 사라졌다는 얘기가 된다."},
{"id": "clka03:5600", "ko": "「영문을 모르겠네……」"},
{"id": "clka03:5700", "ko": "「……」"},
{"id": "clka03:5800", "ko": "「자, 그 밖에 딱히 특징적인 건 찍혀 있지 않고, 풍경에서 얻을 수 있는 정보는 이 정도인 것 같네」"},
{"id": "clka03:5900", "ko": "「드디어 핵심으로 들어가자」"},
{"id": "clka03:6000", "ko": "「이, 가운데에 찍혀 있는 여자애 말인데……」"},
{"id": "clka03:6100", "ko": "「……」"},
{"id": "clka03:6200", "ko": "나는 드디어 지금까지 의식적으로 피해 왔던 사진 한가운데의 피사체 쪽으로 시선을 돌리려 했다."},
{"id": "clka03:6300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka03:6400", "ko": "「아아아아아아아아아아!」"},
{"id": "clka03:6500", "ko": "「아, 안 돼 안 돼! 침착해!」"},
{"id": "clka03:6600", "ko": "「침착하게. 침착하게. 사실만을 골라내는 거다」"},
{"id": "clka03:6700", "ko": "심호흡을 두 번 하고 나서 고찰을 다시 시작한다."},
{"id": "clka03:6800", "ko": "「우선 이 여자애는 헤키호 학원 교복을 입고 있다」"},
{"id": "clka03:6900", "ko": "「!」"},
{"id": "clka03:7000", "ko": "「즈, 즉, 이, 이 학교, 학생이다」"},
{"id": "clka03:7100", "ko": "「!!」"},
{"id": "clka03:7200", "ko": "「그, 그그, 그러니까, 이 애가 누군지는 얼굴로는 판단할 수 없다」"},
{"id": "clka03:7300", "ko": "「개인을 특정하기 위한 신체적 특징은……」"},
{"id": "clka03:7400", "ko": "「아아아아아아아아아아!」"},
{"id": "clka03:7500", "ko": "「무, 무리다. 이 사진을 오래 똑바로 보는 건 나한테는 불가능하다」"},
{"id": "clka03:7600", "ko": "「자극이 너무 세……」"},
{"id": "clka03:7700", "ko": "인터넷에서 검색하면 끝도 없이 나오는 야한 셀카 사진과는 차원이 다르다."},
{"id": "clka03:7800", "ko": "이 사진에 찍힌 건 이 학원 여학생이고, 게다가 내 메일 주소를 알고 있다."},
{"id": "clka03:7900", "ko": "즉, 내가 아는 사람일 가능성이 높은 거다."},
{"id": "clka03:8000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka03:8100", "ko": "게다가 내 캠핑카 안에서!!!"},
{"id": "clka03:8200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka03:8300", "ko": "「……진정해. 우선은 피사체를 특정하는 게 먼저다」"},
{"id": "clka03:8400", "ko": "「사진의 다른 부분에서 본인을 특정할 수 있는 정보는 없을까?」"},
{"id": "clka03:8500", "ko": "나는 사진을 확대해서 자극이 센 살색 부분을 피하면서 스크롤해 간다."},
{"id": "clka03:8600", "ko": "「음……」"},
{"id": "clka03:8700", "ko": "「으음……」"},
{"id": "clka03:8800", "ko": "「으으음……!」"},
{"id": "clka03:8900", "ko": "「으으으음……!!」"},
{"id": "clka03:9000", "ko": "「으으으으음……!!!」"},
{"id": "clka03:9100", "ko": "「……하아」"},
{"id": "clka03:9200", "ko": "「안 되겠네」"},
{"id": "clka03:9300", "ko": "「필요한 정보가 전혀 부족해」"},
{"id": "clka03:9400", "ko": "「이 사진만으로 특정하는 건 불가능하다」"},
{"id": "clka03:9500", "ko": "「당연하지만, 추리 소설처럼 편하게 풀리지는 않네」"},
{"id": "clka03:9600", "ko": "「부실로 돌아가서 이토가 오기를 기다릴까」"},
{"id": "clka03:9700", "ko": "이토가 알고 있다면 그걸로 해결이다."}
]
