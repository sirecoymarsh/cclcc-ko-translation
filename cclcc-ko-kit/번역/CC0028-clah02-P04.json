[
{"id": "clah02:30000", "ko": "국왕?"},
{"id": "clah02:30100", "ko": "「국왕 폐하, 납시오〜!」"},
{"id": "clah02:30200", "ko": "어디선가 팡파르가 들리더니, 좁은 문으로 한 남자가 나타났다."},
{"id": "clah02:30300", "ko": "「짐이 지금 돌아왔노라, 타쿠」"},
{"id": "clah02:30400", "ko": "「겐 씨!?」"},
{"id": "clah02:30500", "ko": "「그래, 이분이야말로 우리나라의 왕, 킹 겐이다」"},
{"id": "clah02:30600", "ko": "그러고 보니 전에 겐 씨가 말한 적이 있다."},
{"id": "clah02:30700", "ko": "외국 귀족의 피를 이어받아서, 그 연줄로 여차하면 외국 특수 부대도 움직일 수 있다고."},
{"id": "clah02:30800", "ko": "그럼 이게…… 특수 부대?"},
{"id": "clah02:30900", "ko": "확실히 특수（성적인 의미로）하긴 하지만……"},
{"id": "clah02:31000", "ko": "「타쿠가 동료가 되어 주니 짐도 기쁘구나」"},
{"id": "clah02:31100", "ko": "아니, 그렇다고 아무리 그래도 이건……"},
{"id": "clah02:31200", "ko": "「미야시로 군」"},
{"id": "clah02:31300", "ko": "「미야시로 군」"},
{"id": "clah02:31400", "ko": "「미야시로」"},
{"id": "clah02:31500", "ko": "「어서 와라, 우리 남자 왕국에」⟦n⟧⟦par⟧「어서 와라, 우리 남자 왕국에」⟦n⟧⟦par⟧「어서 와라, 우리 남자 왕국에」"},
{"id": "clah02:31600", "ko": "「히이이익!」"},
{"id": "clah02:31700", "ko": "그때 겐 씨가 성큼 한 걸음 내디뎠다."},
{"id": "clah02:31800", "ko": "「자, 짐의 동료가 된 증표로 짐의 가장 소중한 것을 하사하마. 마음 단단히 먹고 받도록 하여라」"},
{"id": "clah02:31900", "ko": "가장 소중한 것……"},
{"id": "clah02:32000", "ko": "그건……"},
{"id": "clah02:32100", "ko": "「시, 싫어…… 그것만은! 부탁해! 제발 부탁이니까 그만둬요!」"},
{"id": "clah02:32200", "ko": "「자자, 미야시로, 미련 떨지 마」"},
{"id": "clah02:32300", "ko": "어느새 주위에 모여든 이토 일행이 나를 뒤에서 꽉 붙잡는다."},
{"id": "clah02:32400", "ko": "「싫어어어어어어어어!!」"},
{"id": "clah02:32500", "ko": "최, 최악이다!!"},
{"id": "clah02:32600", "ko": "지금까지 상상한 것 중에서도 최악의 부류에 드는 망상이다!!"},
{"id": "clah02:32700", "ko": "「미야시로……?」"},
{"id": "clah02:32800", "ko": "「어? 아, 아아, 미안! 좀 발이 걸려서!!」"},
{"id": "clah02:32900", "ko": "나는 허둥지둥 이토 위에서 뛰어 물러났다."},
{"id": "clah02:33000", "ko": "「뭐, 뭐야, 그렇구나. 나는 또 당연히……」"},
{"id": "clah02:33100", "ko": "「당연히?」"},
{"id": "clah02:33200", "ko": "「아〜, 아니, 아무것도 아니야! 신경 쓰지 마!」"},
{"id": "clah02:33300", "ko": "다행이다."},
{"id": "clah02:33400", "ko": "아무래도 이토는 아리무라의 팬티를 눈치채지 못한 모양이다."},
{"id": "clah02:33500", "ko": "「아〜, 그럼 나 슬슬 간다. 뭔가 내 착각이었던 것 같고」"},
{"id": "clah02:33600", "ko": "「응? 아아, 그래. 그럼 잘 가」"},
{"id": "clah02:33700", "ko": "이토는 순순히 돌아갔다."},
{"id": "clah02:33800", "ko": "왠지 좀 서먹서먹했던 느낌도 들지만…… 이상한 오해를 한 건 아니겠지?"},
{"id": "clah02:33900", "ko": "「맞다. 그것보다……」"},
{"id": "clah02:34000", "ko": "문제는 저 아리무라의 팬티다……"},
{"id": "clah02:34100", "ko": "이럴 때는 어떻게 해야 하지?"},
{"id": "clah02:34200", "ko": "살짝 어딘가에 놓아둔다?"},
{"id": "clah02:34300", "ko": "하지만 그러려면 만져야 하는 거고……"},
{"id": "clah02:34400", "ko": "그렇다고 저대로 저기 방치해 둘 수도 없고."},
{"id": "clah02:34500", "ko": "「…………!」"},
{"id": "clah02:34600", "ko": "나는 마음을 먹고 침대에 다가가서――"},
{"id": "clah02:34700", "ko": "「알겠지. 나는 딱히 만지고 싶어서 만지는 게 아니야. 어쩔 수 없어서 그러는 거라고」"},
{"id": "clah02:34800", "ko": "그렇게 스스로 타이르며 작게 말린 알록달록한 천을 움켜쥐었다."},
{"id": "clah02:34900", "ko": "「뭐가 어쩔 수 없다는 검까?」"},
{"id": "clah02:35000", "ko": "「그러니까 아리무라의 팬――으아아아아아아!!」"},
{"id": "clah02:35100", "ko": "「팬?」"},
{"id": "clah02:35200", "ko": "「아, 아리무라! 언제 돌아온 거야!?」"},
{"id": "clah02:35300", "ko": "「방금이요. 돌아왔더니 이토 선배가 와 있잖아요. 하마터면 들킬 뻔했다고요」"},
{"id": "clah02:35400", "ko": "「그, 그래……」"},
{"id": "clah02:35500", "ko": "뭐, 마주치지 않았다니 다행이다."},
{"id": "clah02:35600", "ko": "「그보다 제 팬이 어쩌고 하지 않았어요?」"},
{"id": "clah02:35700", "ko": "「어? 아〜 아니, 그건 그……!!」"},
{"id": "clah02:35800", "ko": "「아아아아아아아아아아앗!!!」"},
{"id": "clah02:35900", "ko": "아리무라는 내 손안에 있는 것을 보고 큰 소리를 질렀다."},
{"id": "clah02:36000", "ko": "아차!!"},
{"id": "clah02:36100", "ko": "아리무라의 팬티를 손에 꽉 쥔 채였다."},
{"id": "clah02:36200", "ko": "「아, 아니야!! 이건 그――!」"},
{"id": "clah02:36300", "ko": "「다행이다〜. 역시 이 방에 떨어뜨렸었군요, 제 ⟦col:280aa02d1400⟧곱창 밴드⟦col:800000⟧」"},
{"id": "clah02:36400", "ko": "「엥? 곱창 밴드……?」"},
{"id": "clah02:36500", "ko": "「혹시 잃어버린 건 아닌가 했거든요〜. 아이고, 다행이다 다행이야」"},
{"id": "clah02:36600", "ko": "손바닥을 펴서 확인해 보니, 그건 확실히 팬티가 아니라."},
{"id": "clah02:36700", "ko": "「아, 그래…… 곱창 밴드…… 그렇구나……」"},
{"id": "clah02:36800", "ko": "「왜 그럼까, 선배?」"},
{"id": "clah02:36900", "ko": "헷…… 헷갈리잖아!!!!!!"},
{"id": "clah02:37000", "ko": "아아아아, 진짜!!"},
{"id": "clah02:37100", "ko": "괜히 두근거렸잖아!!!"},
{"id": "clah02:37200", "ko": "「???」"},
{"id": "clah02:37300", "ko": "「야, 아직이야?」"},
{"id": "clah02:37400", "ko": "「아직이에요, 조금만 더 기다려 주세요〜」"},
{"id": "clah02:37500", "ko": "아까부터 내 시야는 칠흑 같은 어둠."},
{"id": "clah02:37600", "ko": "왜냐하면 아리무라가 나에게 눈가리개를 씌워 버렸기 때문이다."},
{"id": "clah02:37700", "ko": "눈가리개라고 해도 딱히 이상한 플레이는 아니다."},
{"id": "clah02:37800", "ko": "「네〜, 다 됐어요〜. 자자, 그 눈가리개를 벗어 주세요」"},
{"id": "clah02:37900", "ko": "시키는 대로 눈가리개를 벗는다."},
{"id": "clah02:38000", "ko": "그러자 눈앞에는――"},
{"id": "clah02:38100", "ko": "「오오……」"},
{"id": "clah02:38200", "ko": "이게 웬일, 눈앞에는 제법 맛있어 보이는 요리가 차려져 있었다."},
{"id": "clah02:38300", "ko": "「헤헷, 어떰까 어떰까〜. 조금은 히나에를 다시 보지 않았슴까?」"},
{"id": "clah02:38400", "ko": "「……뭐…… 조금은……」"},
{"id": "clah02:38500", "ko": "아니, 조금은커녕 꽤다."},
{"id": "clah02:38600", "ko": "파스타에 샐러드에 수프에, 곁들인 빵."},
{"id": "clah02:38700", "ko": "저녁을 만들겠다고 했을 때는 과연 어떤 게 나올지 불안밖에 없었는데, 겉보기도 냄새도 지금으로서는 평범하다."},
{"id": "clah02:38800", "ko": "처음 상상이 상상이었던 만큼, 그 “평범함”에 나는 크게 감동해 버렸다."},
{"id": "clah02:38900", "ko": "게다가 이 트레일러 하우스의 좁은 부엌이라는 악조건에서, 말이다."},
{"id": "clah02:39000", "ko": "이건 꽤 대단한 거 아닐까."},
{"id": "clah02:39100", "ko": "「솔직하지 않슴다〜」"},
{"id": "clah02:39200", "ko": "당연히 그 속마음은 아리무라에게 훤히 들켰다."},
{"id": "clah02:39300", "ko": "「그나저나 무슨 바람이 분 거야?」"},
{"id": "clah02:39400", "ko": "「그야 신세 지고 있으니까 이 정도는 해야겠다 싶어서요」"},
{"id": "clah02:39500", "ko": "혹시 이 장을 보느라 학교에서 돌아오는 게 늦었던 걸까."},
{"id": "clah02:39600", "ko": "「자자, 그보다 따뜻할 때 드세요, 플리즈 보나페티」"},
{"id": "clah02:39700", "ko": "이제는 어느 나라 말인지도 모를 말에 떠밀려, 나는 아리무라가 만든 요리를 입에 넣었다."},
{"id": "clah02:39800", "ko": "「빤히〜」"},
{"id": "clah02:39900", "ko": "「응. 맛있어」"}
]
