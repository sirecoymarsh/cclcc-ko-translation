[
{"id": "clse07:9900", "ko": "「넹~, 히나에임다♪」"},
{"id": "clse07:10000", "ko": "「그치만 문이 열려 있었으니까요. 조심성이 없네요~. 멋대로 누가 들어오면 어쩌려고 그래요~」"},
{"id": "clse07:10100", "ko": "「제가 집을 봐 줬으니까 고마워하세요!」"},
{"id": "clse07:10200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:10300", "ko": "「으음~ 그거에 대해서는 말하자면 긴데요~, 한마디로 말하자면 어른 사회에 대한 반항 같은? 지배로부터의 졸업 같은?」"},
{"id": "clse07:10400", "ko": "「그보다 뭔가 떨어뜨리셨는데요?」"},
{"id": "clse07:10500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:10600", "ko": "「그러니까 선배가 떨어뜨렸다니까요」"},
{"id": "clse07:10700", "ko": "「~~♪」"},
{"id": "clse07:10800", "ko": "「자자, 좁은 곳이지만 그 근처에라도 앉아서 편히 쉬세요」"},
{"id": "clse07:10900", "ko": "「네?」"},
{"id": "clse07:11000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:11100", "ko": "「으아~, 농담! 농담이라니까~!」"},
{"id": "clse07:11200", "ko": "「설명해도 되지만, 아까도 말했듯이 길어질 거예요?」"},
{"id": "clse07:11300", "ko": "「그렇슴까. 그럼 되도록 짧게 말할게요…… 으음~ 뭐라고 하면 좋을까~…… 좋은 말이 안 떠오르는데요오……」"},
{"id": "clse07:11400", "ko": "「가출?」"},
{"id": "clse07:11500", "ko": "「그러니까…… 가・출?」"},
{"id": "clse07:11600", "ko": "「예스! 댓츠 라~잇!」"},
{"id": "clse07:11700", "ko": "「이상」"},
{"id": "clse07:11800", "ko": "「아니~ 엄마랑 싸워 버려서요. 어른들은 왜 그렇게 자기 일은 제쳐 두고 설교만 하는 걸까요~」"},
{"id": "clse07:11900", "ko": "「그런 고로 한동안 여기서 신세 좀 질 테니까, 그 부분은 아무쪼록 잘 부탁드려요」"},
{"id": "clse07:12000", "ko": "「네?」"},
{"id": "clse07:12100", "ko": "「그러니까 한동안 여기서 신세 진다고요」"},
{"id": "clse07:12200", "ko": "「에~, 왜요~?」"},
{"id": "clse07:12300", "ko": "「서면 반 평, 누우면 한 평. 이것만 있으면 충분해요~」"},
{"id": "clse07:12400", "ko": "「게다가 여기 이 소파도 침대가 되죠? 아까 확인했어요」"},
{"id": "clse07:12500", "ko": "「얼마 전에 친구 불러서 크게 소란 피운 애가 있어서, 입주자 말고는 출입이 엄격해졌대요」"},
{"id": "clse07:12600", "ko": "「세리가 왠지 완강하게 거부함다~」"},
{"id": "clse07:12700", "ko": "「쿠루스 선배는 우리 부모님한테 거절 연락할 거잖아요, 절대로」"},
{"id": "clse07:12800", "ko": "「그러면 가출이 안 되잖아요」"},
{"id": "clse07:12900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:13000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:13100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:13200", "ko": "「없다고 할 수 있어요?」"},
{"id": "clse07:13300", "ko": "「그 점에서 미야시로 선배라면 안심이니까요」"},
{"id": "clse07:13400", "ko": "「그치만~ 미야시로 선배는 겁쟁이잖아요~」"},
{"id": "clse07:13500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:13600", "ko": "「그런 미야시로 선배니까 히나에는 안심하고 기댈 수 있는 것입니다!」"},
{"id": "clse07:13700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:13800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:13900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:14900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:15000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:15100", "ko": "「……라는 건 물론 농담이지만요」"},
{"id": "clse07:15200", "ko": "「그래도, 뭐, 생각한 대로임다」"},
{"id": "clse07:15300", "ko": "「꺄악!!」"},
{"id": "clse07:15400", "ko": "「미안해요~, 선배. 저는 싫다고 했는데요오」"},
{"id": "clse07:15500", "ko": "「야앙, 하나도 참, 그건 말하면 안 돼~」"},
{"id": "clse07:15600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:15700", "ko": "「그래도, 뭐, 생각한 대로죠?」"},
{"id": "clse07:15800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:15900", "ko": "「그래도, 뭐, 생각한 대로죠?」"},
{"id": "clse07:16000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:16100", "ko": "「그 점에서 선배는 아무것도 안 했어요. 그렇다는 건 그만큼 미야시로 선배가 아무 해도 없는 사람이라는 거 아님까」"},
{"id": "clse07:16200", "ko": "「아, 물론 좋은 의미로요?」"},
{"id": "clse07:16300", "ko": "「그런 고로오…… 한동안 신세 지겠슴다」"},
{"id": "clse07:16400", "ko": "「좋다고 말해 주지 않으면, 아까 그거 폭로할 거예요」"},
{"id": "clse07:16500", "ko": "「봐요. 쿨 캣 뭐시기라는 책」"},
{"id": "clse07:16600", "ko": "「에~, 왜요~?」"},
{"id": "clse07:16700", "ko": "「그럼 저는 공기 같은 거라고 생각해 주시면 됨다」"},
{"id": "clse07:16800", "ko": "「에~. 그치만 밖은 캄캄하고~, 이런 데에 혼자 내쫓기면 무슨 일을 당할지 모르고~」"},
{"id": "clse07:16900", "ko": "「우~…… 알겠어요……」"},
{"id": "clse07:17000", "ko": "「폐를 끼쳐서 죄송했습니다……」"},
{"id": "clse07:17100", "ko": "「…………」"},
{"id": "clse07:17200", "ko": "「어? 미야시로…… 선배?」"},
{"id": "clse07:17300", "ko": "「선배야말로 어째서」"},
{"id": "clse07:17400", "ko": "「그렇슴까……」"},
{"id": "clse07:17500", "ko": "「……괜찮아요?」"},
{"id": "clse07:17600", "ko": "「……고맙습니다, 선배!!」"},
{"id": "clse07:17700", "ko": "「에헤헤, 정말이지 선배는 사람이 좋다니까요」"},
{"id": "clse07:17800", "ko": "「아, 물론 좋은 의미로, 요?」"},
{"id": "clse07:17900", "ko": "「후루룩후루룩……」"},
{"id": "clse07:18000", "ko": "「아뇨아뇨, 이걸로 충분함다」"},
{"id": "clse07:18100", "ko": "「뭔데요?」"},
{"id": "clse07:18200", "ko": "「그런 말 안 해요. 억지 부려서 신세 지고 있는 거니까」"},
{"id": "clse07:18300", "ko": "「선배, 저녁은 맨날 이런 식이에요?」"},
{"id": "clse07:18400", "ko": "「에~, 안 돼요, 그래서는. 한창 클 나이인데」"},
{"id": "clse07:18500", "ko": "「아, 벌써 시간이 이렇게 됐네요. 그럼 슬슬 잘까요」"},
{"id": "clse07:18600", "ko": "「어? 그럼 선배는요?」"},
{"id": "clse07:18700", "ko": "「에~, 그래도 그러면 미안함다~」"},
{"id": "clse07:18800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:18900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:19000", "ko": "「의외로 신사네요, 선배는」"},
{"id": "clse07:19100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:19200", "ko": "「흐응…… 그렇구나 그렇구나. 안심 안심」"},
{"id": "clse07:19300", "ko": "「뭐, 괜찮슴다. 왜냐하면 저, 미야시로 선배를 믿으니까요」"},
{"id": "clse07:19400", "ko": "「네? 경보기인데요?」"},
{"id": "clse07:19500", "ko": "「그럼 안녕히 주무세요~」"},
{"id": "clse07:19600", "ko": "「새근…… 새근……」"},
{"id": "clse07:19700", "ko": "「아아, 겨우 일어났다♪」"},
{"id": "clse07:19800", "ko": "「아, 혹시 죽어 버린 줄 알았어요? 뭐~ 무리도 아님다~. 일어났더니 눈앞에 천사가 있으니까요~」"}
]
