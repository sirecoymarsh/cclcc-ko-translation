[
{"id": "clyu15:9600", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu15:9700", "ko": "「…………」"},
{"id": "clyu15:9800", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu15:9900", "ko": "「있잖아, 타쿠루 오빠……」"},
{"id": "clyu15:10000", "ko": "「나 있지…… 타쿠루 오빠가 오빠가 되어 줘서 다행이야……」"},
{"id": "clyu15:10100", "ko": "「그, 그래……」"},
{"id": "clyu15:10200", "ko": "「응……」"},
{"id": "clyu15:10300", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu15:10400", "ko": "그래. 나는 오빠다."},
{"id": "clyu15:10500", "ko": "오빠로서 오빠답게 있어야 한다."},
{"id": "clyu15:10600", "ko": "「……자, 내일도 학교잖아? 빨리 자야지……」"},
{"id": "clyu15:10700", "ko": "「응……」"},
{"id": "clyu15:10800", "ko": "나도…… 쓸데없는 생각 말고 빨리 자자……"},
{"id": "clyu15:10900", "ko": "그렇게 스스로 타이르고, 겨우 마음을 가라앉혀 눈을 감았다."},
{"id": "clyu15:11000", "ko": "그로부터 얼마나 시간이 지났을까."},
{"id": "clyu15:11100", "ko": "슬슬 깊은 잠의 숲에 가라앉으려던 무렵, 작은 속삭임이 귓가를 간질였다."},
{"id": "clyu15:11200", "ko": "「……미안, 타쿠루 오빠……」"},
{"id": "clyu15:11300", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu15:11400", "ko": "（거짓말……? 뭐가?）"},
{"id": "clyu15:11500", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu15:11600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu15:11700", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu15:11800", "ko": "「…………」"},
{"id": "clyu15:11900", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"}
]
