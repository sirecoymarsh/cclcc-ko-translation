[
{"id": "clkn08:10000", "ko": "「쉬야 많이 했쪄요~. 찝찝했쪄요~」"},
{"id": "clkn08:10100", "ko": "그때 아기 기저귀를 벗기던 센리가 손을 멈췄다."},
{"id": "clkn08:10200", "ko": "「어머」"},
{"id": "clkn08:10300", "ko": "「왜 그래?」"},
{"id": "clkn08:10400", "ko": "「이 아이…… 남자애야……」"},
{"id": "clkn08:10500", "ko": "「정말이네……」"},
{"id": "clkn08:10600", "ko": "『히카리』라는 이름이라 당연히 여자아이인 줄 알았는데, 거기엔 달려 있어야 할 게 제대로 달려 있었다."},
{"id": "clkn08:10700", "ko": "「흐응……」"},
{"id": "clkn08:10800", "ko": "「…………」"},
{"id": "clkn08:10900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn08:11000", "ko": "", "note": "보류 — 성적 묘사"},
