[
{"id": "clkn08:10000", "ko": "「쉬야 많이 했쪄요~. 찝찝했쪄요~」"},
{"id": "clkn08:10100", "ko": "그때 아기 기저귀를 벗기던 센리가 손을 멈췄다."},
{"id": "clkn08:10200", "ko": "「어머」"},
{"id": "clkn08:10300", "ko": "「왜 그래?」"},
{"id": "clkn08:10400", "ko": "「이 아이…… 남자애야……」"},
{"id": "clkn08:10500", "ko": "「정말이네……」"},
{"id": "clkn08:10600", "ko": "『히카리』라는 이름이라 당연히 여자아이인 줄 알았는데, 거기엔 달려 있어야 할 게 제대로 달려 있었다."},
{"id": "clkn08:10700", "ko": "「흐응……」"},
{"id": "clkn08:10800", "ko": "「…………」"},
{"id": "clkn08:10900", "ko": "「둘 다, 신기한 건 알겠는데 그렇게 빤히 보지 마……」"},
{"id": "clkn08:11000", "ko": "「따, 따따, 딱히 빤히 안 봤거든! 그치~!?」"},
{"id": "clkn08:11100", "ko": "「네, 네. 관심이 있다든가 그런 건 아니…… 에요……」"},
{"id": "clkn08:11200", "ko": "「맞아. 게다가 이 정도는 유 걸로 익숙하고」"},
{"id": "clkn08:11300", "ko": "「에엣!?」"},
{"id": "clkn08:11400", "ko": "그건 그거대로 어떤가 싶은데……"},
{"id": "clkn08:11500", "ko": "「자, 그런 걸로 떠들지 말고 거기 물티슈 좀 줘」"},
{"id": "clkn08:11600", "ko": "「센리 언니는 신기하지 않아?」"},
{"id": "clkn08:11700", "ko": "「나는 그…… 그야말로 타쿠루 걸로 익숙하니까……」"},
{"id": "clkn08:11800", "ko": "「뭣!!」"},
{"id": "clkn08:11900", "ko": "「세, 센리 언니, 대담해~……」"},
{"id": "clkn08:12000", "ko": "「두 분은 역시……」"},
{"id": "clkn08:12100", "ko": "「어? 아, 아니야! 그런 게 아니야! 타쿠루가 여기 막 왔을 무렵에 혼자 못 움직이던 때가 있었잖아? 그때, 그……」"},
{"id": "clkn08:12200", "ko": "「읏……」"},
{"id": "clkn08:12300", "ko": "싫은 일이 떠올라 버렸다."},
{"id": "clkn08:12400", "ko": "그래."},
{"id": "clkn08:12500", "ko": "그 지진 이후 나는 계속 누워만 있는 상태였고, 그동안 줄곧 나를 돌봐 준 게 센리였다."},
{"id": "clkn08:12600", "ko": "아아, 젠장!"},
{"id": "clkn08:12700", "ko": "애써 잊으려고 했는데, 떠올라 버렸잖아."},
{"id": "clkn08:12800", "ko": "하지만 그때는 혼자서는 아무것도 할 수 없는 상태였으니 어쩔 수 없었다."},
{"id": "clkn08:12900", "ko": "……그런 의미에서 센리는 가족 이상의 존재라고 할 수 있을지도 모른다."},
{"id": "clkn08:13000", "ko": "아무리 친형제라도 대소변 수발까지 받는 일은 좀처럼 없을 테니까."},
{"id": "clkn08:13100", "ko": "그나저나 센리는 그때 어떤 마음으로 나를 돌봐 줬던 걸까."},
{"id": "clkn08:13200", "ko": "「…………」"},
{"id": "clkn08:13300", "ko": "생각하지 마, 타쿠루."},
{"id": "clkn08:13400", "ko": "생각하면 수렁에 빠질 뿐이다."},
{"id": "clkn08:13500", "ko": "생각하면 안 돼."},
{"id": "clkn08:13600", "ko": "생각하면……"},
{"id": "clkn08:13700", "ko": "「타쿠루…… 혹시…… 부럽다고 생각하는 거야?」"},
{"id": "clkn08:13800", "ko": "「뭐!? 아니, 잠깐! 부럽다니, 그 아기 말하는 거야?」"},
{"id": "clkn08:13900", "ko": "센리는 작게 고개를 끄덕였다."},
{"id": "clkn08:14000", "ko": "「바보 같은 소리 하지 마! 내가 왜 부러워해야 하는데!」"},
{"id": "clkn08:14100", "ko": "「그치만 타쿠루, 이런 거…… 좋아하잖아?」"},
{"id": "clkn08:14200", "ko": "좋아한다고?"},
{"id": "clkn08:14300", "ko": "내가?"},
{"id": "clkn08:14400", "ko": "⟦rb⟧아기⟦rt⟧그런⟦/r⟧ 플레이를?"},
{"id": "clkn08:14500", "ko": "어, 어라?"},
{"id": "clkn08:14600", "ko": "이 가슴의 두근거림은 뭐지?"},
{"id": "clkn08:14700", "ko": "⟦col:280aa02d1400⟧아기 플레이⟦col:800000⟧라는 말을 떠올린 것만으로 두근거리기 시작했어."},
{"id": "clkn08:14800", "ko": "좋아하는…… 건가, 나는?"},
{"id": "clkn08:14900", "ko": "「좋아하…… 지?」"},
{"id": "clkn08:15000", "ko": "「좋아하는…… 걸지도 몰라」"},
{"id": "clkn08:15100", "ko": "아니."},
{"id": "clkn08:15200", "ko": "「좋아해……」"},
{"id": "clkn08:15300", "ko": "그래."},
{"id": "clkn08:15400", "ko": "「나는 아기 플레이를 좋아해! 좋아한다고!」"},
{"id": "clkn08:15500", "ko": "「후훗…… 알았어. 그럼 타쿠루야. 착하지, 거기 누워 주쩨요~」"},
{"id": "clkn08:15600", "ko": "「네, 네……」"},
{"id": "clkn08:15700", "ko": "나는 시키는 대로 그 자리에 똑바로 누웠다."},
{"id": "clkn08:15800", "ko": "「그럼 기저귀 갈아요오~」"},
{"id": "clkn08:15900", "ko": "「가, 갈아, 주세, 요……」"},
{"id": "clkn08:16000", "ko": "「『주세요』가 아니라 『주떼요』지?」", "note": "말장난: 원문은 します → ちまちゅ(아기 말투). 「주세요 → 주떼요」로 옮김"},
{"id": "clkn08:16100", "ko": "「갈아…… 주떼요……」"},
{"id": "clkn08:16200", "ko": "「네에~ 잘했쪄요」"},
{"id": "clkn08:16300", "ko": "센리는 방긋 웃더니 내 바지에 손을 댔다."},
{"id": "clkn08:16400", "ko": "벨트를 푸는 소리에 심장 소리가 더욱 커진다."},
{"id": "clkn08:16500", "ko": "「바, 바부우……」"},
{"id": "clkn08:16600", "ko": "그리고……"},
{"id": "clkn08:16700", "ko": "해☆방☆감!"},
{"id": "clkn08:16800", "ko": "「아……」"},
{"id": "clkn08:16900", "ko": "「아…………」"},
{"id": "clkn08:17000", "ko": "「정말…… 타쿠루도 참, 못 말리는 아이쪄요……」"},
{"id": "clkn08:17100", "ko": "「죄, 죄송해쪄요」"},
{"id": "clkn08:17200", "ko": "「그래도 어쩔 수 없지…… 남자아이인걸……」"},
{"id": "clkn08:17300", "ko": "부, 부끄러워……"},
{"id": "clkn08:17400", "ko": "그래도……"},
{"id": "clkn08:17500", "ko": "버릇 될 것 같아!!!!"},
{"id": "clkn08:17600", "ko": "（아아아아아아아아아아아!!）"},
{"id": "clkn08:17700", "ko": "그러니까 생각하지 말라고 했잖아!!"},
{"id": "clkn08:17800", "ko": "아니야!"},
{"id": "clkn08:17900", "ko": "나는 딱히 그런 거 안 좋아한다고!!"},
{"id": "clkn08:18000", "ko": "아, 아무튼 평정이다!"},
{"id": "clkn08:18100", "ko": "평정을 가장해라, 타쿠루!"},
{"id": "clkn08:18200", "ko": "「아기, 귀엽네요, 타쿠루 씨」"},
{"id": "clkn08:18300", "ko": "「아, 응. 그러쪄요」"},
{"id": "clkn08:18400", "ko": "「쪄…… 요……?」"},
{"id": "clkn08:18500", "ko": "우아아아아아아아아아아!"},
{"id": "clkn08:18600", "ko": "무심코!!"},
{"id": "clkn08:18700", "ko": "「바, 발음이 꼬인 것뿐이야! 정말이라고!」"},
{"id": "clkn08:18800", "ko": "「네, 네……」"},
{"id": "clkn08:18900", "ko": "위, 위험했다~."},
{"id": "clkn08:19000", "ko": "「타쿠루…… 혹시…… 부럽다고 생각하는 거야?」"},
{"id": "clkn08:19100", "ko": "「뭐!? 아니, 잠깐! 부럽다니, 그 아기 말하는 거야?」"},
{"id": "clkn08:19200", "ko": "센리는 작게 고개를 끄덕였다."},
{"id": "clkn08:19300", "ko": "「바보 같은 소리 하지 마! 내가 왜 부러워해야 하는데!」"},
{"id": "clkn08:19400", "ko": "「그치만 타쿠루, 이런 거…… 좋아하잖아?」"},
{"id": "clkn08:19500", "ko": "좋아한다고?"},
{"id": "clkn08:19600", "ko": "내가?"},
{"id": "clkn08:19700", "ko": "⟦rb⟧아기⟦rt⟧그런⟦/r⟧ 플레이를?"},
{"id": "clkn08:19800", "ko": "어, 어라?"},
