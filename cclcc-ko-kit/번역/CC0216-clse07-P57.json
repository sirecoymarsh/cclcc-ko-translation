[
{"id": "clse07:547300", "ko": "「우아아아아앗!?」"},
{"id": "clse07:547400", "ko": "「아아아아아아아무것도 아니야. 정말로 아무 변함도 없이 한 치도 다름없는 평소의 나다」"},
{"id": "clse07:547500", "ko": "「……카즈키, 잠깐 둘이서만 할 얘기가 있어. 복도로 와 줘」"},
{"id": "clse07:547600", "ko": "「왜 이 잡지가 찍혀 있는 거야!?」"},
{"id": "clse07:547700", "ko": "「그러니까, 이거 말이야!」"},
{"id": "clse07:547800", "ko": "「이 쿨 캣 프레스!」"},
{"id": "clse07:547900", "ko": "「……어?」"},
{"id": "clse07:548000", "ko": "「그, 그러니까 말이지, 이이이이, 이 잡지는, 너너너너, 네가 가져온 거지? 그렇다고 말해 줄 거지?」"},
{"id": "clse07:548100", "ko": "「그렇다고 말해 줘!」"},
{"id": "clse07:548200", "ko": "「아아아아아아아아아아!!!!!!!」"},
{"id": "clse07:548300", "ko": "「그그그그, 그럼, 이, 잡지는……!!!???」"},
{"id": "clse07:548400", "ko": "「역시……!」"},
{"id": "clse07:548500", "ko": "「그그그그, 그래서, 그 잡지는 지금 어디에?」"},
{"id": "clse07:548600", "ko": "「내가 눈을 떴을 때, 침대 위에는 아무것도 없었다고」"},
{"id": "clse07:548700", "ko": "「뭐!!??」"},
{"id": "clse07:548800", "ko": "「말도…… 안 돼……」"},
{"id": "clse07:548900", "ko": "「……아니, 잠깐만」"},
{"id": "clse07:549000", "ko": "「『써먹지 않으면』이라고 했지? 방금」"},
{"id": "clse07:549100", "ko": "「무슨, 뜻이야?」"},
{"id": "clse07:549200", "ko": "「……뭔데?」"},
{"id": "clse07:549300", "ko": "「……」"},
{"id": "clse07:549400", "ko": "「……」"},
{"id": "clse07:549500", "ko": "「……미안, 잘 못 들었는데. 뭘 하자고?」"},
{"id": "clse07:549600", "ko": "「……」"},
{"id": "clse07:549700", "ko": "「……」"},
{"id": "clse07:549800", "ko": "「……미안, 잘 안 들――」"},
{"id": "clse07:549900", "ko": "「아까부터 하고 싶은 말 다 하는구나!?」"},
{"id": "clse07:550000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:550100", "ko": "「뭐!?」"},
{"id": "clse07:550200", "ko": "「왜, 왜 내가 그런 경박한 짓을 해야 하는 건데!」"},
{"id": "clse07:550300", "ko": "「크헉!?」"},
{"id": "clse07:550400", "ko": "「……」"},
{"id": "clse07:550500", "ko": "「…………」"},
{"id": "clse07:550600", "ko": "「………………알, 았어」"},
{"id": "clse07:550700", "ko": "「너희들, 적당히 안 하면 나도 상처받는다고!」"},
{"id": "clse07:550800", "ko": "「닥쳐, 이토!」"},
{"id": "clse07:550900", "ko": "「승부는 받아들이겠어」"},
{"id": "clse07:551000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:551100", "ko": "「너희는 내 편이야!? 적이야!? 확실히 해 줘!!」"},
{"id": "clse07:551200", "ko": "「……」"},
{"id": "clse07:551300", "ko": "「…………」"},
{"id": "clse07:551400", "ko": "「………………」"},
{"id": "clse07:551500", "ko": "「늦어! 약속 시간에서 5분 지났다고!」"},
{"id": "clse07:551600", "ko": "「대체 언제 오는 거야!」"},
{"id": "clse07:551700", "ko": "（이쪽은 약속 시간 10분 전에 도착해 있었다고……）"},
{"id": "clse07:551800", "ko": "（게다가 왜 하치코 앞이냐고……）"},
{"id": "clse07:551900", "ko": "（……）"},
{"id": "clse07:552000", "ko": "（……게다가）"},
{"id": "clse07:552100", "ko": "（……아무리 생각해도, 내가 있을 곳이 아니야）"},
{"id": "clse07:552200", "ko": "「뭐뭐뭐뭐, 뭐야!?」"},
{"id": "clse07:552300", "ko": "「히이익!」"},
{"id": "clse07:552400", "ko": "「카, 카즈키!?」"},
{"id": "clse07:552500", "ko": "「가, 갑자기 놀라잖아!」"},
{"id": "clse07:552600", "ko": "「가자!」"},
{"id": "clse07:552700", "ko": "「덕분에 이상하게 주목받았잖아!」"},
{"id": "clse07:552800", "ko": "「왜 내가 저급한 리얼충 놈들한테 비웃음을 당해야 하는 건데!」"},
{"id": "clse07:552900", "ko": "「애초에 왜 하치코 앞이냐고!」"},
{"id": "clse07:553000", "ko": "「사람이 더 적은 약속 장소는 얼마든지 있잖아!?」"},
{"id": "clse07:553100", "ko": "「어째서!?」"},
{"id": "clse07:553200", "ko": "「그치만, 뭔데」"},
{"id": "clse07:553300", "ko": "「뭐!?」"},
{"id": "clse07:553400", "ko": "「으앗!?」"},
{"id": "clse07:553500", "ko": "「……」"},
{"id": "clse07:553600", "ko": "「……」"},
{"id": "clse07:553700", "ko": "「아, 아니, 안 해! 밤까지 너한테 어울려 주고, 그걸로 끝이야!」"},
{"id": "clse07:553800", "ko": "「당연하지!」"},
{"id": "clse07:553900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:554000", "ko": "「……」"},
{"id": "clse07:554100", "ko": "「……」"},
{"id": "clse07:554200", "ko": "「……카즈키」"},
{"id": "clse07:554300", "ko": "「혹시, 말인데」"},
{"id": "clse07:554400", "ko": "「목적지가, 여기야?」"},
{"id": "clse07:554500", "ko": "「미안, 돌아갈래」"},
{"id": "clse07:554600", "ko": "「방금 네가 말했잖아! 저긴 시부야의 패션 성지야! 리얼충들의 소굴이라고!」"},
{"id": "clse07:554700", "ko": "「하치코 앞에서조차 내 존재가 민망해서 견딜 수가 없는데, 저런 곳에 내가 들어갈 수 있을 리가 없잖아!」"},
{"id": "clse07:554800", "ko": "「가득 찬 리얼충 오라에 질식사해 버릴 게 뻔해!」"},
{"id": "clse07:554900", "ko": "「아니면 리얼충들이 나한테 보내는 『저 오타쿠는 왜 여기 있어?』 하는 시선에 녹아 버릴 게 분명해!」"},
{"id": "clse07:555000", "ko": "「저기 가서 당할 굴욕에 비하면 나아!」"},
{"id": "clse07:555100", "ko": "「카, 카즈키! 기, 기다려!」"},
{"id": "clse07:555200", "ko": "「아직 마음의 준비가! 기다려! 기다려 주세요 카즈키 씨! 아니 하나 씨! 우아아아아아!」"},
{"id": "clse07:555300", "ko": "「좀 너무 짧지 않아?」"},
{"id": "clse07:555400", "ko": "「노출이 많다고 좋은 게 아니야」"},
{"id": "clse07:555500", "ko": "「저건 어린이용 아니야? 저렇게 작은 티셔츠는 못 입잖아」"},
{"id": "clse07:555600", "ko": "「왜 야해져야 하는 건데!」"},
{"id": "clse07:555700", "ko": "「아, 아아. 저거라면 괜찮지 않을까? 청초하고 지적인 느낌이 들어」"},
{"id": "clse07:555800", "ko": "「그런 거야!?」"},
{"id": "clse07:555900", "ko": "「카, 카즈키, 너 아까부터 큰 가슴이니 가슴이니 길거리에서 너무 입에 올리는 거 아냐……」"},
{"id": "clse07:556000", "ko": "「좀 들어!」"},
{"id": "clse07:556100", "ko": "「여긴……?」"},
{"id": "clse07:556200", "ko": "「……설마」"},
{"id": "clse07:556300", "ko": "「거짓말이지?」"},
{"id": "clse07:556400", "ko": "「잡아당기지 마! 야!」"},
{"id": "clse07:556500", "ko": "「기다려, 난 아직 한다고 안 했어!」"},
{"id": "clse07:556600", "ko": "「좀처럼 입어 볼 수 있는 게 아니라고……?」"},
{"id": "clse07:556700", "ko": "「……뭐!? 거짓말이지!?」"},
{"id": "clse07:556800", "ko": "「……」"},
{"id": "clse07:556900", "ko": "「……못, 해」"},
{"id": "clse07:557000", "ko": "（미안하게 됐네!）"},
{"id": "clse07:557100", "ko": "「『맡겨 주세요』가 아니잖아!」"},
{"id": "clse07:557200", "ko": "「그, 그거라니?」"}
]
