[
{"id": "clah02:0", "ko": "「…………」"},
{"id": "clah02:100", "ko": "깊고 깊은."},
{"id": "clah02:200", "ko": "검은색보다 더 어두운 어둠 속을 헤매고 있었다."},
{"id": "clah02:300", "ko": "그곳에는 빛도 없고 공기도 없고――"},
{"id": "clah02:400", "ko": "영원히 이어질 것만 같은 어둠 속에서 모든 감각은 마비되고, 그저 숨 막힘만이 나를 괴롭히고 있었다."},
{"id": "clah02:500", "ko": "숨 막힘만이――"},
{"id": "clah02:600", "ko": "숨 막힘……"},
{"id": "clah02:700", "ko": "「읍〜! 으읍〜!」"},
{"id": "clah02:800", "ko": "「푸핫!!!!」"},
{"id": "clah02:900", "ko": "「하아, 하아……」"},
{"id": "clah02:1000", "ko": "「아, 드디어 일어났다♪」"},
{"id": "clah02:1100", "ko": "「주, 죽일 셈이냐!!!」"},
{"id": "clah02:1200", "ko": "「아, 혹시 죽은 줄 알았어요? 뭐〜, 그럴 만도 함다〜. 일어났더니 눈앞에 천사가 있으니까요〜」"},
{"id": "clah02:1300", "ko": "「그게 아니야! 너, 방금 내 코랑 입 막고 있었지! 보통 아침에는 좀 더 상냥하게 깨우는 거 아니냐?」"},
{"id": "clah02:1400", "ko": "「처음엔 그렇게 했어요. 그런데 계속 깨워도 선배가 전혀 안 일어나는걸요」"},
{"id": "clah02:1500", "ko": "「하마터면 영원히 못 일어날 뻔했잖아!」"},
{"id": "clah02:1600", "ko": "처음에 상냥하게 깨웠다는 것도 수상하다."},
{"id": "clah02:1700", "ko": "「어젯밤에도 금방 쿨쿨 잠들어 버리고〜」"},
{"id": "clah02:1800", "ko": "「뭐?」"},
{"id": "clah02:1900", "ko": "「아무것도 아니거든요〜」"},
{"id": "clah02:2000", "ko": "대체 뭐야."},
{"id": "clah02:2100", "ko": "「그보다 아리무라. 오늘은 집에――」"},
{"id": "clah02:2200", "ko": "「안 가요. 오늘 돌아가면 가출이 아니라 그냥 무단 외박이잖슴까」"},
{"id": "clah02:2300", "ko": "……어쩌면 하룻밤 지나면 돌아갈 마음이 생길까 싶기도 했지만, 아무래도 내 생각이 안일했던 모양이다."},
{"id": "clah02:2400", "ko": "「알겠지? 당분간 여기서 지낸다는 건 아무도 모르게 해야 한다」"},
{"id": "clah02:2500", "ko": "「네네, 알아요 알아요」"},
{"id": "clah02:2600", "ko": "정말 알고 있는 걸까."},
{"id": "clah02:2700", "ko": "만약 누군가가 알게 된다면, 설령 우리 사이에 떳떳하지 못한 일이 전혀 없었다 해도, 추측이 추측을 불러 이상한 일이 되지 않으리라는 법도 없다."},
{"id": "clah02:2800", "ko": "「애초에 들켜서 제일 곤란한 건 선배보다 저고요」"},
{"id": "clah02:2900", "ko": "그도 그렇다."},
{"id": "clah02:3000", "ko": "이런 건 남자보다 여자 쪽이 여러모로 타격이 크다."},
{"id": "clah02:3100", "ko": "「그럼 저 먼저 갈게요〜. 아디오스 그라치아〜♪」"},
{"id": "clah02:3200", "ko": "괜찮을까, 저 녀석……"},
{"id": "clah02:3300", "ko": "……라는 내 불안과는 상관없이, 방과 후까지 딱히 아무 일도 일어나지 않고 무사히 시간이 지나갔다."},
{"id": "clah02:3400", "ko": "도심에 있는 것치고는 우리 학교 건물은 꽤 큰 편이다."},
{"id": "clah02:3500", "ko": "그런 가운데 나는 3학년이고 아리무라는 2학년."},
{"id": "clah02:3600", "ko": "학년이 다르면 그렇게 자주 얼굴을 마주칠 일도 없다."},
{"id": "clah02:3700", "ko": "얼굴을 마주칠 일이 없으면 무심코 접촉할 일도 없고, 누군가의 앞에서 무심코 이야기를 해서 누군가가 눈치챌 일도 없는 것이다."},
{"id": "clah02:3800", "ko": "그렇다고는 해도 방심은 금물이다."},
{"id": "clah02:3900", "ko": "아무튼 누군가가 눈치채는 일만은 피해야 한다."},
{"id": "clah02:4000", "ko": "「있잖아, 타쿠. 히나, 오늘은 동아리 올까?」"},
{"id": "clah02:4100", "ko": "「모, 몰라. 왜 나한테 물어?」"},
{"id": "clah02:4200", "ko": "「그치만 타쿠, 히나랑 사이좋잖아?」"},
{"id": "clah02:4300", "ko": "「나, 나는 딱히 아리무라랑 특별히 사이가 좋은 게 아니야!!」"},
{"id": "clah02:4400", "ko": "「…………」"},
{"id": "clah02:4500", "ko": "「어?」"},
{"id": "clah02:4600", "ko": "「…………」"},
{"id": "clah02:4700", "ko": "「…………」"},
{"id": "clah02:4800", "ko": "「…………」"},
{"id": "clah02:4900", "ko": "「아……」"},
{"id": "clah02:5000", "ko": "「……왜 그래, 너. 갑자기 그렇게 큰 소리를 내고」"},
{"id": "clah02:5100", "ko": "아차."},
{"id": "clah02:5200", "ko": "아리무라와의 동거 생활을 들키지 않으려고 너무 의식한 나머지, 그만 발끈해서 부정해 버렸다."},
{"id": "clah02:5300", "ko": "「타쿠루. 혹시 아리무라랑 싸우기라도 했어?」"},
{"id": "clah02:5400", "ko": "「아, 아니, 딱히 그런 건……」"},
{"id": "clah02:5500", "ko": "「그래? 그럼 다행이지만……」"},
{"id": "clah02:5600", "ko": "아리무라한테 그렇게 주의를 줘 놓고 내가 이래서야 다 망친다."},
{"id": "clah02:5700", "ko": "조심하자."},
{"id": "clah02:5800", "ko": "「맞다, 타쿠. 오늘 가는 길에 타쿠네 집 들러도 돼?」"},
{"id": "clah02:5900", "ko": "「안 돼!!」"},
{"id": "clah02:6000", "ko": "「어?」"},
{"id": "clah02:6100", "ko": "「아…………」"},
{"id": "clah02:6200", "ko": "말하자마자 이 꼴이다."},
{"id": "clah02:6300", "ko": "나는 바보야!!"},
{"id": "clah02:6400", "ko": "「아〜, 그, 그러니까, 뭐냐…… 오늘은 좀 들를 데가 있어서. 그러니까……」"},
{"id": "clah02:6500", "ko": "「그, 그래? 그럼 다음에 갈게……」"},
{"id": "clah02:6600", "ko": "정신 차려, 미야시로 타쿠루."},
{"id": "clah02:6700", "ko": "이 정도 일로 포커페이스가 무너지다니, 나답지 않잖아."},
{"id": "clah02:6800", "ko": "「차오임다, 제군〜. 아이고, 늦어서 죄송해요」"},
{"id": "clah02:6900", "ko": "윽…… 아리무라."},
{"id": "clah02:7000", "ko": "설마 이 타이밍에?"},
{"id": "clah02:7100", "ko": "그보다 왜 온 거야."},
{"id": "clah02:7200", "ko": "「아, 아리무라. 왔구나. 다행이다」"},
{"id": "clah02:7300", "ko": "「이럴 수가〜! 혹시 여러분, 히나에의 등장을 학수고대하고 계셨나요?」"},
{"id": "clah02:7400", "ko": "「어제도 안 왔어…… 일지도……」"},
{"id": "clah02:7500", "ko": "「아〜, 미안 미안. 어제는 좀 볼일이 있었달까요, 헤헤헷」"},
{"id": "clah02:7600", "ko": "「그럼 정말로 싸운 건 아니었구나」"},
{"id": "clah02:7700", "ko": "「후에? 싸움?」"},
{"id": "clah02:7800", "ko": "「아까 얘기하고 있었거든. 혹시 타쿠랑 싸우기라도――」"},
{"id": "clah02:7900", "ko": "오노에의 말이 끝나기도 전에 나는 가방을 들고 일어섰다."},
{"id": "clah02:8000", "ko": "「아〜. 그러고 보니 볼일이 있었지. 미안하지만 먼저 갈게」"},
{"id": "clah02:8100", "ko": "「어……?」"},
{"id": "clah02:8200", "ko": "「동아리 활동은, 뭐…… 알아서 해 줘. 그럼」"},
{"id": "clah02:8300", "ko": "「아, 잠깐 타쿠루!」"},
{"id": "clah02:8400", "ko": "「…………」"},
{"id": "clah02:8500", "ko": "위험했다, 위험했어."},
{"id": "clah02:8600", "ko": "그대로 아리무라와 같은 공간에 있었다면 언제 들통날지 모를 일이다."},
{"id": "clah02:8700", "ko": "아리무라한테 그렇게 주의를 줘 놓고 내가 무덤을 파는 일이라도 생기면, 그야말로 그 녀석이 무슨 소리를 할지 모르니까."},
{"id": "clah02:8800", "ko": "「…………」"},
{"id": "clah02:8900", "ko": "그나저나 아리무라 녀석, 늦네."},
{"id": "clah02:9000", "ko": "혹시 엄마랑 화해하고 집에 갔다든가?"},
{"id": "clah02:9100", "ko": "……아니, 그건 아니겠지."},
{"id": "clah02:9200", "ko": "아무리 아리무라라도 그렇게 됐다면 연락 정도는 하겠지."},
{"id": "clah02:9300", "ko": "아마 오노에나 카즈키랑 어디서 차라도 마시고 있다든가, 그런 거겠지."},
{"id": "clah02:9400", "ko": "「응?」"},
{"id": "clah02:9500", "ko": "아무래도 돌아온 모양이다."},
{"id": "clah02:9600", "ko": "「뭐 하고 있었어. 늦었잖……」"},
{"id": "clah02:9700", "ko": "「에헤헷, 와 버렸다♪」"},
{"id": "clah02:9800", "ko": "「――!?」"},
{"id": "clah02:9900", "ko": "「끄으읏…… 잠깐, 닫지 마……!」"}
]
