[
{"id": "clzz99:30000", "ko": "눈을 뜨면 분명……"},
{"id": "clzz99:30100", "ko": "", "note": "보류 — 미성년 인물들의 맨살 밀착 장면에 이어짐(30100~30400)"},
{"id": "clzz99:30200", "ko": "", "note": "보류 — 미성년 인물들의 친밀 묘사"},
{"id": "clzz99:30300", "ko": "", "note": "보류 — 미성년 인물들의 친밀 묘사"},
{"id": "clzz99:30400", "ko": "", "note": "보류 — 미성년 인물들의 친밀 묘사"},
{"id": "clzz99:30500", "ko": "그래, 눈을 뜨면……"},
{"id": "clzz99:30600", "ko": "「응……」"},
{"id": "clzz99:30700", "ko": "눈부셔……"},
{"id": "clzz99:30800", "ko": "「어라? 나는……」"},
{"id": "clzz99:30900", "ko": "「좋은 아침, 미야시로……」"},
{"id": "clzz99:31000", "ko": "「이토……」"},
{"id": "clzz99:31100", "ko": "아아, 그런가……"},
{"id": "clzz99:31200", "ko": "그건 망상 같은 게 아니었구나……"},
{"id": "clzz99:31300", "ko": "「몸은 좀 어때?」"},
{"id": "clzz99:31400", "ko": "……그러고 보니…… 이제 한기도 나른함도 느껴지지 않는다……"},
{"id": "clzz99:31500", "ko": "", "note": "보류 — 미성년 인물들의 친밀 묘사"},
{"id": "clzz99:31600", "ko": "「다행이다…… 이제 괜찮은 것 같네」"},
{"id": "clzz99:31700", "ko": "「……이토」"},
{"id": "clzz99:31800", "ko": "「응?」"},
{"id": "clzz99:31900", "ko": "「고마…… 워……」"},
{"id": "clzz99:32000", "ko": "", "note": "보류 — 미성년 인물들의 탈의·친밀 묘사(32000~32100)"},
{"id": "clzz99:32100", "ko": "", "note": "보류 — 미성년 인물들의 탈의·친밀 묘사"},
{"id": "clzz99:32200", "ko": "「――!?」⟦avs⟧⟦n⟧⟦n⟧"},
{"id": "clzz99:32300", "ko": "「타쿠, 괜찮아?!」"},
{"id": "clzz99:32400", "ko": "위험했다……"},
{"id": "clzz99:32500", "ko": "오노에가 허둥지둥 뛰어든 건 바로 옷을 다 입은 직후였다."},
{"id": "clzz99:32600", "ko": "아무래도 지진으로 인한 오작동으로 부실 문이 잠기고, 그대로 정전이 되는 바람에 문이 열리지 않았던 모양이다."},
{"id": "clzz99:32700", "ko": "그게 오늘 아침이 되어 전력이 돌아오면서 문도 순순히 열린 것 같다."},
{"id": "clzz99:32800", "ko": "「……설마 부실에 갇혀 있었을 줄이야……」"},
{"id": "clzz99:32900", "ko": "그리고 어젯밤 나에게 메시지를 보냈는데 답이 없는 걸 수상히 여긴 오노에가 쿠루스와 상의해서, 아침 일찍 학교 교실에서 내 스마트폰을 찾아내고 여기로 달려와 발견하게 되었다…… 는 모양이다."},
{"id": "clzz99:33000", "ko": "다행히 학교 밖은 딱히 큰 피해도 없어서, 지진 피해는 아주 일부에 그쳤다."},
{"id": "clzz99:33100", "ko": "「이야~ 거참, 고생이 많으셨구먼~」"},
{"id": "clzz99:33200", "ko": "「진짜, 좀 봐줬으면 좋겠어. 그치, 미야시로?」"},
{"id": "clzz99:33300", "ko": "「정말 그래」"},
{"id": "clzz99:33400", "ko": "「위로를 드려요…… 일지도……」"},
{"id": "clzz99:33500", "ko": "「지금 따뜻한 차 탈게요」"},
{"id": "clzz99:33600", "ko": "물론 이 하룻밤의 일은 나도 이토도 누구에게 발설하지 않았고, 우리 관계도 평소 그대로."},
{"id": "clzz99:33700", "ko": "그렇게 이 소동은 이윽고 우리의 기억에서도 사라져 갔다……"},
{"id": "clzz99:33800", "ko": "……일 텐데."},
{"id": "clzz99:33900", "ko": "「그러고 보니 미야시로…… 너, 지진 난 날 부실에 갇혀 있었다면서」"},
{"id": "clzz99:34000", "ko": "「쿠노사토 씨……」"},
{"id": "clzz99:34100", "ko": "「그때 이야기를 기사로라도 쓰면 재미있는 신문이 되지 않겠나?」"},
{"id": "clzz99:34200", "ko": "「따, 딱히 재미있는 일 같은 건 아무것도 없었어요!」"},
{"id": "clzz99:34300", "ko": "「너…… 뭘 그렇게 발끈하는 거지?」"},
{"id": "clzz99:34400", "ko": "「딱히 발끈하긴요, 아무것도……」"},
{"id": "clzz99:34500", "ko": "「아……」"},
{"id": "clzz99:34600", "ko": "이토……"},
{"id": "clzz99:34700", "ko": "「아아, 이토. 좋은 아침……」"},
{"id": "clzz99:34800", "ko": "「어, 어어……」"},
{"id": "clzz99:34900", "ko": "「…………」"},
{"id": "clzz99:35000", "ko": "「…………」"},
{"id": "clzz99:35100", "ko": "「???」"},
{"id": "clzz99:35200", "ko": "", "note": "보류 — 미성년 인물들의 연애 암시(35200~35400)"},
{"id": "clzz99:35300", "ko": "", "note": "보류 — 미성년 인물들의 연애 암시"},
{"id": "clzz99:35400", "ko": "", "note": "보류 — 미성년 인물들의 연애 암시"},
{"id": "clzz99:35500", "ko": "「어? 아아……」"},
{"id": "clzz99:35600", "ko": "「그 녀석이랑 무슨 일 있었나?」"},
{"id": "clzz99:35700", "ko": "「그, 그러니까 없다니까요! 아무것도!」"},
{"id": "clzz99:35800", "ko": "아직도 얼굴을 마주칠 때마다 어딘가 서먹서먹한 느낌이 드는 건…… 아마 내 기분 탓…… 이겠지?"}
]
