[
{"id": "clse07:387300", "ko": "「별로…… 그냥 방 좀 정리하고 있었을 뿐이야……」"},
{"id": "clse07:387400", "ko": "「어? 잠깐만――」"},
{"id": "clse07:387500", "ko": "「아――!」"},
{"id": "clse07:387600", "ko": "「그게……」"},
{"id": "clse07:387700", "ko": "「그건 그렇지만……」"},
{"id": "clse07:387800", "ko": "「타쿠루……」"},
{"id": "clse07:387900", "ko": "「…………」"},
{"id": "clse07:388000", "ko": "「그건…… 무리야」"},
{"id": "clse07:388100", "ko": "「왜냐하면 다들 “쿠루스 노노”로서의 나를 학생회장으로 지지해 주고 있는걸」"},
{"id": "clse07:388200", "ko": "「그게 사실은 이렇게 수수하고 아무 장점도 없는 “미나미사와 센리”라는 걸 알면 분명 실망할 거야」"},
{"id": "clse07:388300", "ko": "「아니, 실망만 하면 차라리 다행이야. 지금까지 속여 왔다는 데 화를 낼 게 틀림없어」"},
{"id": "clse07:388400", "ko": "「그렇다니까. 타쿠루는 모르는 거야…… 이렇게 우중충한 모습의 내가 주변에서 어떻게 보일지……」"},
{"id": "clse07:388500", "ko": "「응. 그건 알고 있어. 다만, 그…… 오랜만에 이 모습으로 타쿠루 앞에 나선다고 생각하니까 갑자기 불안해져서……」"},
{"id": "clse07:388600", "ko": "「……응, 고마워, 타쿠루」"},
{"id": "clse07:388700", "ko": "「잘 먹겠습니다」"},
{"id": "clse07:388800", "ko": "「이 카레, 유이가 만든 거야」"},
{"id": "clse07:388900", "ko": "「어머어머. 그럼 앞으로 저녁은 계속 유이한테 맡길까」"},
{"id": "clse07:389000", "ko": "「어머. 그게 뭐 문제라도 있어?」"},
{"id": "clse07:389100", "ko": "「정말, 아빠도 참 애도 아니고. 타쿠루도, 내 고기 줄 테니까 상대하지 마」"},
{"id": "clse07:389200", "ko": "「……무슨 소리야? 유이, 너 우리한테 뭔가 숨기는 거 있어?」"},
{"id": "clse07:389300", "ko": "「어? 타쿠루…… 몰라? 지금 TV에서 엄청 인기 있는 아이돌, 매지컬 유이 말이야」"},
{"id": "clse07:389400", "ko": "「타쿠루……」"},
{"id": "clse07:389500", "ko": "「그렇…… 지. 그래도 놀랍다……」"},
{"id": "clse07:389600", "ko": "「안 돼, 유토. 모처럼 타쿠루가 돌아왔잖아. 오늘은 다 같이 이야기하자. 유이도, 응?」"},
{"id": "clse07:389700", "ko": "「괜찮아. 마술이잖아?」"},
{"id": "clse07:389800", "ko": "「안 돼, 유토. 모처럼 타쿠루가 돌아왔잖아. 오늘은 다 같이 이야기하자. 유이도, 응?」"},
{"id": "clse07:389900", "ko": "「그래도 TV는 안 돼, 유이. 모처럼 타쿠루가 돌아왔으니까 오늘은 다 같이 이야기하자」"},
{"id": "clse07:390000", "ko": "「타쿠루…… 타쿠루도 참……」"},
{"id": "clse07:390100", "ko": "「자, 타쿠루…… 일어나지 않으면 늦어……」"},
{"id": "clse07:390200", "ko": "「어제 오랜만에 돌아왔잖아?」"},
{"id": "clse07:390300", "ko": "「학교까지는 평소보다 시간이 더 걸려. 계속 자고 있으면 지각해」"},
{"id": "clse07:390400", "ko": "「좋은 아침, 타쿠루. 밥 다 됐어」"},
{"id": "clse07:390500", "ko": "「응〜?」"},
{"id": "clse07:390600", "ko": "「그 정도는 알아…… 우리, 남매잖아」"},
{"id": "clse07:390700", "ko": "「응, 맛있게 먹어 줘서 고마워」"},
{"id": "clse07:390800", "ko": "「안 돼, 유토. 노는 건 숙제 끝내고 나서」"},
{"id": "clse07:390900", "ko": "「유이. 설거지 좀 도와줄래?」"},
{"id": "clse07:391000", "ko": "「부탁해, 고마워」"},
{"id": "clse07:391100", "ko": "「아, 아빠는 술 마시기 전에 욕실 청소 부탁해」"},
{"id": "clse07:391200", "ko": "「어머, 타쿠루가 먼저 말을 꺼내다니 별일이네」"},
{"id": "clse07:391300", "ko": "「그럼 씻은 그릇 좀 닦아 줄래?」"},
{"id": "clse07:391400", "ko": "「……응, 뭐……」"},
{"id": "clse07:391500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:391600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:391700", "ko": "「정말, 아빠까지 놀리지 마」"},
{"id": "clse07:391800", "ko": "「정말, 아빠. 새삼스럽게 말 안 해도 알거든」"},
{"id": "clse07:391900", "ko": "「그보다 타쿠루. 목욕하고 와」"},
{"id": "clse07:392000", "ko": "「타쿠루 말이 맞아」"},
{"id": "clse07:392100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:392900", "ko": "「타쿠루. 먼저 목욕해」"},
{"id": "clse07:393000", "ko": "「그래? 그럼 아빠, 얼른 들어가」"},
{"id": "clse07:393100", "ko": "「응, 잘 자」"},
{"id": "clse07:393200", "ko": "「타쿠루……」"},
{"id": "clse07:393300", "ko": "「바보. 그럴 리가 없잖아」"},
{"id": "clse07:393400", "ko": "「물론 당분간 집에서 돌보겠습니다」"},
{"id": "clse07:393500", "ko": "「그러니까 아빠. 당분간 술값 줄일게」"},
{"id": "clse07:393600", "ko": "「그야 분유값이 들잖아. 조금은 참아 줘야지」"},
{"id": "clse07:393700", "ko": "「그리고 타쿠루. 가능하면 오늘부터 잠깐만이라도 괜찮아. ⟦rb⟧아오바 기숙사⟦rt⟧여기⟦/r⟧에서 지내 줄 수 없을까?」"},
{"id": "clse07:393800", "ko": "「이것저것 돈 들 일도 많아지고, 가능하면 남자 손이 필요해」"},
{"id": "clse07:393900", "ko": "「그런 거니까 부탁해. 응?」"},
{"id": "clse07:394000", "ko": "「응. 고마워, 타쿠루」"},
{"id": "clse07:394100", "ko": "「후훗…… 귀엽네」"},
{"id": "clse07:394200", "ko": "「어? 나!?」"},
{"id": "clse07:394300", "ko": "「옳지 옳지, 자〜, 착하지, 울지 마〜」"},
{"id": "clse07:394400", "ko": "「곤란하네…… 울음을 안 그쳐……」"},
{"id": "clse07:394500", "ko": "「아…… 그럴지도 모르겠네. 그래도 어쩌지. 기저귀가 없어……」"},
{"id": "clse07:394600", "ko": "「고마워. 살았어」"},
{"id": "clse07:394700", "ko": "「자〜, 기저귀 갈아요오〜. 착하지, 가만히 있어 주쪄요〜」"},
{"id": "clse07:394800", "ko": "「쉬야를 많이 했쪄요〜. 찝찝했쪄요〜」"},
{"id": "clse07:394900", "ko": "「어머」"},
{"id": "clse07:395000", "ko": "「이 아이…… 남자아이……」"},
{"id": "clse07:395100", "ko": "「자, 그런 걸로 들떠 있지 말고 거기 물티슈 좀 줘」"},
{"id": "clse07:395200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:395300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:395400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:395500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:395600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:395700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:395800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:395900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:396800", "ko": "「자〜, 다 됐쪄요〜. 이제 찝찝하지 않쪄요〜」"},
{"id": "clse07:396900", "ko": "「배고픈 거 아닐까……」"},
{"id": "clse07:397000", "ko": "「있잖아, 타쿠루. 부탁이 있는데……」"},
{"id": "clse07:397100", "ko": "「분유랑 젖병 좀 사다 줄래?」"},
{"id": "clse07:397200", "ko": "「고마워」"}
]
