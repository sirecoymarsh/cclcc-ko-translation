[
{"id": "clyu03:0", "ko": "「흠…… 좋아. 다 모였지?」"},
{"id": "clyu03:100", "ko": "이토가 우리를 불러 모은 건 그다음 일요일의 일이었다."},
{"id": "clyu03:200", "ko": "「드디어 지금부터 나, 이토 신지 프로듀스의 아이돌 유닛 『⟦col:280aa02d1400⟧밀푀유⟦col:800000⟧』의 아이돌 활동을 개시한다!」"},
{"id": "clyu03:300", "ko": "생각보다 시간이 걸렸지만, 확실히 준비니 뭐니 생각하면 이 정도는 걸리는 법일지도 모른다."},
{"id": "clyu03:400", "ko": "「먼저 말해 두는데, 아이돌 활동이라고 해도 처음부터 노래하고 춤출 수 있는 건 아니다」"},
{"id": "clyu03:500", "ko": "「어? 그래?」"},
{"id": "clyu03:600", "ko": "「미안해, 유이. 그래도 생각해 봐. 노래를 부르거나 춤을 추려면 곡이 필요하잖아?」"},
{"id": "clyu03:700", "ko": "「곡을 만들려면 작곡가한테 보수도 줘야 하고, 춤을 추려 해도 안무가 필요한데 거기에도 돈이 든다」"},
{"id": "clyu03:800", "ko": "「그렇구나아……」"},
{"id": "clyu03:900", "ko": "「아이돌 활동에도 돈이 드는군요……」"},
{"id": "clyu03:1000", "ko": "「그래! 그러니까 우선 해야 할 일은 니야동에서 조회 수를 벌어서 유명해지고, 그걸로 수익을 얻는 거다」"},
{"id": "clyu03:1100", "ko": "「그러면 그 돈을 밑천으로 곡을 만들 수도 있고, 어쩌면 호의로 만들어 주는 팬이 나올지도 모르지. 그렇지?」"},
{"id": "clyu03:1200", "ko": "「신지치고는 제대로 된 의견이네~」"},
{"id": "clyu03:1300", "ko": "「진짜, 깜짝 놀랐어」"},
{"id": "clyu03:1400", "ko": "「잘 듣게, 제군들. 이 몸에게 맡겨 두면 『밀푀유』는 인기 폭발 틀림없지!」", "note": "이토가 업계 프로듀서 흉내를 내는 줄(僕·キミタチ) — 「제군들」로"},
{"id": "clyu03:1500", "ko": "「부탁드려요, 이토 ⟦col:280aa02d1400⟧프로듀서⟦col:800000⟧!」"},
{"id": "clyu03:1600", "ko": "「부탁드려요!」"},
{"id": "clyu03:1700", "ko": "「하하하, 안심하고 맡겨 두게」"},
{"id": "clyu03:1800", "ko": "콧김을 거칠게 뿜으며 말하는 이토의 등에, 수상쩍은 분홍색 맨투맨이 걸쳐진 게 보이는 것 같았다."},
{"id": "clyu03:1900", "ko": "「그럼, 가 볼까」"},
{"id": "clyu03:2000", "ko": "「어? 간다니 어디로?」"},
{"id": "clyu03:2100", "ko": "「물론 촬영하러지. 니야동에 영상을 올리려면 우선 소스를 찍어야 하잖아?」"},
{"id": "clyu03:2200", "ko": "확실히 그 말대로다."},
{"id": "clyu03:2300", "ko": "「이것저것 준비는 내 쪽에서 해 뒀으니까」"},
{"id": "clyu03:2400", "ko": "……이 녀석, 생각보다 훨씬 프로듀서로서의 능력이 있는지도 모른다."},
{"id": "clyu03:2500", "ko": "나는 엄지를 척 세우며 상쾌한 미소를 보이는 이토를 보고 그런 생각을 품기 시작했다."},
{"id": "clyu03:2600", "ko": "「여러분 안녕하세요. 『밀푀유』의 유이예요」"},
{"id": "clyu03:2700", "ko": "「그게…… 밀푀유의 유예요……」"},
{"id": "clyu03:2800", "ko": "이건……"},
{"id": "clyu03:2900", "ko": "「음~. 아직 어색하네. 자, 더 웃어 웃어」"},
{"id": "clyu03:3000", "ko": "「웃는 얼굴…… 이렇게? 방긋」"},
{"id": "clyu03:3100", "ko": "「오, 좋아 좋아~. 자, 유토…… 가 아니라 유도!」"},
{"id": "clyu03:3200", "ko": "「그게…… 방긋」"},
{"id": "clyu03:3300", "ko": "「음~, 아직 딱딱하네. 유이. 좀 간지럽혀 볼래?」"},
{"id": "clyu03:3400", "ko": "「간지럽히라고? 알았어! 에잇~」"},
{"id": "clyu03:3500", "ko": "「어? 어? 어?」"},
{"id": "clyu03:3600", "ko": "「자. 간질간질간질~」"},
{"id": "clyu03:3700", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:3800", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:3900", "ko": "「간질간질간질간질~」"},
{"id": "clyu03:4000", "ko": "「아핫…… 아하핫, 아하하하하」"},
{"id": "clyu03:4100", "ko": "「…………」"},
{"id": "clyu03:4200", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu03:4300", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu03:4400", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu03:4500", "ko": "「읏……」"},
{"id": "clyu03:4600", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu03:4700", "ko": "「야, 이토! 이건……」"},
{"id": "clyu03:4800", "ko": "「미야시로, 지금 좋은 데니까 조용히 해 줘!」"},
{"id": "clyu03:4900", "ko": "「아…… 네」"},
{"id": "clyu03:5000", "ko": "「……가 아니라! 야, 이토! 뭐야 이건?!」"},
{"id": "clyu03:5100", "ko": "「뭐가 뭐야?」"},
{"id": "clyu03:5200", "ko": "「다짜고짜 수영복이라니, 좀 지나친 거 아냐?」"},
{"id": "clyu03:5300", "ko": "게다가 유토까지!"},
{"id": "clyu03:5400", "ko": "「뭐? 무슨 소리야? 요즘 이 정도는 안 하면, 산더미 같은 인터넷 영상 속에 묻혀 버릴 뿐이라고」"},
{"id": "clyu03:5500", "ko": "「튀어야 장땡. 그러려면 다소 과격하게, 라는 건 네가 늘 하던 말이잖아」"},
{"id": "clyu03:5600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:5700", "ko": "저래서는 유토한테 너무 위험하다."},
{"id": "clyu03:5800", "ko": "게다가 이 수영장…… 가끔 인터넷에서 보이는 유명한 수영장이고."},
{"id": "clyu03:5900", "ko": "「그런 것까지 포함해서 화제성이라는 거지」"},
{"id": "clyu03:6000", "ko": "읏…… 확실히 이토 말대로다."},
{"id": "clyu03:6100", "ko": "말대로이긴 한데……"},
{"id": "clyu03:6200", "ko": "「이, 이번엔 내가…… 에잇」"},
{"id": "clyu03:6300", "ko": "「어? 아, 꺅!」"},
{"id": "clyu03:6400", "ko": "「자, 간질간질간질간질~」"},
{"id": "clyu03:6500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:6600", "ko": "「자자자~」"},
{"id": "clyu03:6700", "ko": "「후훗, 후후훗…… 아하하하하, 안 돼! 안 된다니까~!」"},
{"id": "clyu03:6800", "ko": "", "note": "보류 — 성적 묘사(미성년을 선정적으로 촬영하는 장면 6800~7600)"},
{"id": "clyu03:6900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:7000", "ko": "「읏……」"},
{"id": "clyu03:7100", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:7200", "ko": "「응…………」"},
{"id": "clyu03:7300", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:7400", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:7500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:7600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu03:7700", "ko": "「스톱!! 안 돼 안 돼! 카메라 멈춰!」"},
{"id": "clyu03:7800", "ko": "「아? 뭐야, 미야시로. 지금 좋은 데니까――」"},
{"id": "clyu03:7900", "ko": "「됐으니까 아무튼 멈춰!」"},
{"id": "clyu03:8000", "ko": "「아……」"},
{"id": "clyu03:8100", "ko": "「이토는 프로듀서에서 물러나 줘야겠어」"},
{"id": "clyu03:8200", "ko": "촬영을 중단하고 내 방으로 돌아오자마자 그렇게 선언하자, 이토는 당연하다는 듯 불만을 얼굴에 드러냈다."},
{"id": "clyu03:8300", "ko": "「뭐? 왜?」"},
{"id": "clyu03:8400", "ko": "「더 이상 너한테는 맡겨 둘 수 없다고 내가 판단했으니까. 아무리 그래도 그건 지나쳤어」"},
{"id": "clyu03:8500", "ko": "유이네가 하고 싶은 건 어디까지나 아이돌 활동이고, 아까 촬영은 거기서 벗어났다고 해도 좋다."},
{"id": "clyu03:8600", "ko": "게다가 그대로 갔다간 당장 유토가 위험하다."},
{"id": "clyu03:8700", "ko": "「모르는구나. 모른다고, 미야시로. 요즘 그 정도는 안 하면 인기 아이돌은 될 수 없다니까」"},
{"id": "clyu03:8800", "ko": "「아니, 다른 방법도 있을 거야. 그게 안 떠오른다면 역시 이토는 물러나 주는 수밖에 없어」"},
{"id": "clyu03:8900", "ko": "「에이, 뭐야~. 나도 열심히 했는데~」"},
{"id": "clyu03:9000", "ko": "「애초에 거기 빌린 돈은 어떻게 했는데? 수영복도 돈 들었잖아」"},
{"id": "clyu03:9100", "ko": "「어? 물론 신문부 부비에서 낼 예정인데?」"},
{"id": "clyu03:9200", "ko": "마치 당연하다는 듯, 이토는 무서운 소리를 아무렇지 않게 해 버렸다."},
{"id": "clyu03:9300", "ko": "「너 말이야…… 이건 부 활동이 아니니까 그럴 수 있을 리가 없잖아?」"},
{"id": "clyu03:9400", "ko": "게다가 안 그래도 노노 몰래 시작한 일인데, 그런 데 부비를 썼다는 걸 노노가 알기라도 하면 그야말로 무서운 일이 벌어질 게 뻔하다."},
{"id": "clyu03:9500", "ko": "「뭐? 그럼 어떡하냐, 거기 돈?!」"},
{"id": "clyu03:9600", "ko": "「몰라. 네가 멋대로 한 거잖아. 네가 알아서 해」"},
{"id": "clyu03:9700", "ko": "「아니, 무리 무리! 무리라니까! 그런 돈 없다고!」"}
]
