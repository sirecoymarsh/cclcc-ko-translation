[
{"id": "clka02:10000", "ko": "「내가 들어왔을 때 아무도 없었던 것 같은데」"},
{"id": "clka02:10100", "ko": "「응」"},
{"id": "clka02:10200", "ko": "카즈키는 고개를 살짝 움직여, 입에 물고 있는 막대 사탕, 롤리팝의 막대로 창가를 가리켰다."},
{"id": "clka02:10300", "ko": "창가 구석 자리에는 거의 카즈키 전용이 된 컴퓨터가 한 대 놓여 있다."},
{"id": "clka02:10400", "ko": "칸막이에 가려 디스플레이 화면은 이쪽에서는 보이지 않지만, 희미하게 켜져 있다는 건 알 수 있었다."},
{"id": "clka02:10500", "ko": "「계속 ⟦col:280aa02d1400⟧엠스⟦col:800000⟧ 하고 있었던 거야?」"},
{"id": "clka02:10600", "ko": "「응」"},
{"id": "clka02:10700", "ko": "수수께끼는 모두 풀렸다."},
{"id": "clka02:10800", "ko": "「미안. 몰랐어」"},
{"id": "clka02:10900", "ko": "「으음」"},
{"id": "clka02:11000", "ko": "말없이 눈을 가늘게 뜨고 째려본다."},
{"id": "clka02:11100", "ko": "하지만 어느 쪽이냐 하면 내가 피해자다. 카즈키가 이상한 혼잣말을 다 들어 버렸잖아."},
{"id": "clka02:11200", "ko": "「다른 애들은? 안 왔어?」"},
{"id": "clka02:11300", "ko": "「응」"},
{"id": "clka02:11400", "ko": "카즈키는 작업 책상을 가리킨다. 학생 가방이 몇 개나 놓여 있었다."},
{"id": "clka02:11500", "ko": "「아, 나갔구나」"},
{"id": "clka02:11600", "ko": "「응」"},
{"id": "clka02:11700", "ko": "하지만 그렇게 되면 곤란해진다."},
{"id": "clka02:11800", "ko": "사실 나는 여기서 혼자 생각할 일이 있었던 거다."},
{"id": "clka02:11900", "ko": "카즈키가 있으면 여기서는 무리다."},
{"id": "clka02:12000", "ko": "「음, 그러니까, 응」"},
{"id": "clka02:12100", "ko": "「응?」"},
{"id": "clka02:12200", "ko": "「이토한테 볼일이 있어. 찾으러 갔다 올게」"},
{"id": "clka02:12300", "ko": "적당히 거짓말을 한다."},
{"id": "clka02:12400", "ko": "「응」"},
{"id": "clka02:12500", "ko": "카즈키는 딱히 신경 쓰지도 않고 그대로 늘 앉는 자리로 돌아갔다."},
{"id": "clka02:12600", "ko": "그리고 묵묵히 ⟦col:280aa02d1400⟧엠스⟦col:800000⟧를 시작했다."},
{"id": "clka02:12700", "ko": "나는 방해하지 않도록 살며시 부실을 나왔다."},
{"id": "clka02:12800", "ko": "「……후우」"},
{"id": "clka02:12900", "ko": "가슴에 손을 댄다."},
{"id": "clka02:13000", "ko": "「……아직 두근거리네」"},
{"id": "clka02:13100", "ko": "아무래도 눈을 떴는데 바로 앞에 카즈키가 서 있는 건 당황스러웠다."},
{"id": "clka02:13200", "ko": "게다가 평소엔 거의 대화도 없는 카즈키와 닿을 듯 말 듯 가까워졌던 거다."},
{"id": "clka02:13300", "ko": "존재감이 옅어서 놓치기 쉽지만, 카즈키의 몸매는 신문부 최고라고 해도 과언이 아닐 정도다."},
{"id": "clka02:13400", "ko": "건전한 남자 고등학생으로서 두근거리지 않는 게 이상하겠지."},
{"id": "clka02:13500", "ko": "「……」"},
{"id": "clka02:13600", "ko": "「……그럼」"},
{"id": "clka02:13700", "ko": "「혼자 있을 수 있는 곳을 찾자」"},
{"id": "clka02:13800", "ko": "나중에 카즈키가 수상하게 여겨도 곤란하니까, 이토를 찾으면서 적당한 장소를 찾자."},
{"id": "clka02:13900", "ko": "「차분히 생각해야 해」"},
{"id": "clka02:14000", "ko": "나는 걸어가면서 주머니에서 스마트폰을 꺼냈다."},
{"id": "clka02:14100", "ko": "「침착하게, 그리고 논리적으로 결론을 내야 해」"},
{"id": "clka02:14200", "ko": "그리고 오늘 아침 일회용 계정에서 온 『그 이미지』를 띄운다."},
{"id": "clka02:14300", "ko": "「――이 셀카에 찍혀 있는 게 대체 누구인지를」"}
]
