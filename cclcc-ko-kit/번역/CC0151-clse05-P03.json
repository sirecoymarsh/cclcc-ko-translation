[
{"id": "clse05:13300", "ko": "「시, 싫다~. 그렇게 칭찬하지 마~」"},
{"id": "clse05:13400", "ko": "그녀는 더욱 새빨개지더니, 햄버그뿐만 아니라 곁들인 채소 같은 것도 작게 잘라서 몇 번이고 내 입에 넣어 주었다."},
{"id": "clse05:13500", "ko": "정신을 차려 보니 나는 오노에가 손수 만든 도시락을 전부 먹어 치운 뒤였다."},
{"id": "clse05:13600", "ko": "「잘 먹었습니다! 맛있었어, 고마워」"},
{"id": "clse05:13700", "ko": "「뭐, 뭔가 타쿠한테 솔직하게 칭찬받으니까 이상한 기분이야~」"},
{"id": "clse05:13800", "ko": "「……?」"},
{"id": "clse05:13900", "ko": "「뭐랄까, 타쿠한테는 늘 따끔하게 혼나기만 했으니까, 그거에 익숙해져 버렸달까……」"},
{"id": "clse05:14000", "ko": "「오노에, 너……」"},
{"id": "clse05:14100", "ko": "「우?」"},
{"id": "clse05:14200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:14300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:14400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:14500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:14600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:14700", "ko": "「어라, 안 되지. 그런 짓 해서 도망치려고 해도」"},
{"id": "clse05:14800", "ko": "「으윽……」"},
{"id": "clse05:14900", "ko": "이, 이 녀석."},
{"id": "clse05:15000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:15100", "ko": "「으그그……!」⟦n⟧⟦par⟧「으으음……!」"},
{"id": "clse05:15200", "ko": "우리는 코앞에서 서로 노려보았다."},
{"id": "clse05:15300", "ko": "게다가 어쩌면 꾸준한 『구속구 해방 작전』보다 빨리 탈출할 수 있을 거라고 생각했는데……"},
{"id": "clse05:15400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:15500", "ko": "「그, 그, 그것만은 그만둬~!」"},
{"id": "clse05:15600", "ko": "오노에가 아까 내던졌던 쇠집게를 주워 들려고 해서 나는 기겁해서 말렸다."},
{"id": "clse05:15700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:15800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:15900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:16000", "ko": "「우~ 그렇구나? 그럼 어쩔 수 없네~」"},
{"id": "clse05:16100", "ko": "그렇게 말하면서 다시 쿠웅 하는 무시무시한 소리와 함께 쇠집게를 내던졌다."},
{"id": "clse05:16200", "ko": "아무튼 저 고문 도구는 어떻게든 해야 해…… 이런저런 일을 당하는 걸 상상하기만 해도 등골이 얼어붙는다."},
{"id": "clse05:16300", "ko": "「자, 그럼. 밥도 먹었고…… 다음엔 뭘 할까?」"},
{"id": "clse05:16400", "ko": "「글쎄. 그, 오노에가 좋아하는 걸로 해」"},
{"id": "clse05:16500", "ko": "그렇게 무난하게 대답해 두었다."},
{"id": "clse05:16600", "ko": "여기서 그녀의 기분을 맞춰 두는 것보다 좋은 건 없다."},
{"id": "clse05:16700", "ko": "「………」"},
{"id": "clse05:16800", "ko": "「응? 왜 그래?」"},
{"id": "clse05:16900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:17000", "ko": "「………」"},
{"id": "clse05:17100", "ko": "야, 이봐, 오노에."},
{"id": "clse05:17200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:17300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:17400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:17500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:17600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:17700", "ko": "나 스스로도 창피한 대사라고 생각하지만, 이런 식의 말을 해 두면 그녀가 갑자기 폭발하거나 『검은 오노에』가 나오는 일은 없겠지."},
{"id": "clse05:17800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:17900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:18000", "ko": "「뭐?」"},
{"id": "clse05:18100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:18200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:18300", "ko": "………… 오노에."},
{"id": "clse05:18400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:18500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:18600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:18700", "ko": "그러니까, 너 말이야."},
{"id": "clse05:18800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse05:18900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:19000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse05:19100", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse05:19200", "ko": "「유이가……?」"},
{"id": "clse05:19300", "ko": "……전혀 몰랐다."},
{"id": "clse05:19400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:19500", "ko": "「………」"},
{"id": "clse05:19600", "ko": "「그래도 나는……」"},
{"id": "clse05:19700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse05:19800", "ko": "오노에의 눈은 어느새 눈물에 젖기 시작했다."},
{"id": "clse05:19900", "ko": "그렇군…… 『검은』 오노에도 분명 말했었다."},
{"id": "clse05:20000", "ko": "오노에 세리카는 망가져 버린다고."},
{"id": "clse05:20100", "ko": "그리고 그건――"},
{"id": "clse05:20200", "ko": "틀림없이 그녀에게 『사고 도촬』 같은 능력이 있었던 탓이다."},
{"id": "clse05:20300", "ko": "“연애” 같은 건 지금의 나에게는 그렇게 가치 있는 게 아니고…… 역시 “사회적인 사건 해결”이나 “수수께끼 풀기”야말로 내 관심사이자 삶의 보람이 되어 있다."},
{"id": "clse05:20400", "ko": "하지만 오노에에게는 그렇지 않았던 것이다. 그런데도 그녀는 내 생각을 도촬하고, 자기는 전혀 관심 없는 일에 계속 어울려 주고 있었던 것이다."}
]
