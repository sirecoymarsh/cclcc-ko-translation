[
{"id": "clse07:457300", "ko": "「…………」"},
{"id": "clse07:457400", "ko": "「음……」"},
{"id": "clse07:457500", "ko": "（엄마 『자, 히나에. 같이 돌아가자』）"},
{"id": "clse07:457600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:457700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:457800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:457900", "ko": "「…………」"},
{"id": "clse07:458000", "ko": "「어? 음……」"},
{"id": "clse07:458100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:458200", "ko": "「우와아아아아앗!!! 오노에! 너 언제부터!」"},
{"id": "clse07:458300", "ko": "「어? 아아, 이건 그러니까…… 대본이야, 대본, 연극」"},
{"id": "clse07:458400", "ko": "「바보 같은 소리 마. 내가 무대에 설 리가 없잖아」"},
{"id": "clse07:458500", "ko": "「그건 말이지……」"},
{"id": "clse07:458600", "ko": "「됐어. 어차피 필요 없는 거니까」"},
{"id": "clse07:458700", "ko": "「아, 어, 그러니까……」"},
{"id": "clse07:458800", "ko": "「저, 저는, 그……」"},
{"id": "clse07:458900", "ko": "「그, 그…… 저는 미야시로 타쿠루, 라고 합…… 니다……」"},
{"id": "clse07:459000", "ko": "「그, 관계라고 하셔도……」"},
{"id": "clse07:459100", "ko": "「아니아니아니, 무리지, 아무래도」"},
{"id": "clse07:459200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:459300", "ko": "「아, 아니…… 그게……」"},
{"id": "clse07:459400", "ko": "「어……」"},
{"id": "clse07:459500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:459600", "ko": "（아아…… 하늘이…… 파랗구나……）"},
{"id": "clse07:459700", "ko": "「네?」"},
{"id": "clse07:459800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:459900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:460000", "ko": "「네……?」"},
{"id": "clse07:460100", "ko": "「…………」"},
{"id": "clse07:460200", "ko": "（정말, 왜 내가――）"},
{"id": "clse07:460300", "ko": "「네, 넷!?」"},
{"id": "clse07:460400", "ko": "「네?」"},
{"id": "clse07:460500", "ko": "「아, 아니…… 그……」"},
{"id": "clse07:460600", "ko": "「그…… 뭐……」"},
{"id": "clse07:460700", "ko": "「아……」"},
{"id": "clse07:460800", "ko": "「아, 아뇨……! 그건 받을 수 없습니다!!」"},
{"id": "clse07:460900", "ko": "「아, 안 됩니다!」"},
{"id": "clse07:461000", "ko": "「거, 거기는 좋아서 있는 것뿐이고, 그렇게 곤란한 것도……」"},
{"id": "clse07:461100", "ko": "「뭐, 뭐가요?」"},
{"id": "clse07:461200", "ko": "「다녀왔어……」"},
{"id": "clse07:461300", "ko": "「응……?」"},
{"id": "clse07:461400", "ko": "「뭐, 뭐야?」"},
{"id": "clse07:461500", "ko": "「푸푸푸〜〜〜!!」"},
{"id": "clse07:461600", "ko": "「네가 이상한 소리를 하니까 그렇지!」"},
{"id": "clse07:461700", "ko": "「이상하잖아. 왜 내가 게이냐고?」"},
{"id": "clse07:461800", "ko": "「그야, 그건 아리무라가 만든 대본이잖아?」"},
{"id": "clse07:461900", "ko": "「그럴 리가 없잖아!」"},
{"id": "clse07:462000", "ko": "「이상한 기분이라니…… 뭔데?」"},
{"id": "clse07:462100", "ko": "「안 들어」"},
{"id": "clse07:462200", "ko": "「뭐, 뭐야?」"},
{"id": "clse07:462300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:462400", "ko": "「어느 쪽이야!」"},
{"id": "clse07:462500", "ko": "「그런 것보다, 애초에 모녀 싸움의 원인은 뭔데?」"},
{"id": "clse07:462600", "ko": "「후아아……」"},
{"id": "clse07:462700", "ko": "「응……?」"},
{"id": "clse07:462800", "ko": "「――!?」"},
{"id": "clse07:462900", "ko": "「…………」"},
{"id": "clse07:463000", "ko": "「후에? 아아, 좋은 아침, 아리무라」"},
{"id": "clse07:463100", "ko": "「……뭘?」"},
{"id": "clse07:463200", "ko": "「아아……」"},
{"id": "clse07:463300", "ko": "「말했지」"},
{"id": "clse07:463400", "ko": "「글쎄……」"},
{"id": "clse07:463500", "ko": "「읏……」"},
{"id": "clse07:463600", "ko": "「으……」"},
{"id": "clse07:463700", "ko": "「우왓!!」"},
{"id": "clse07:463800", "ko": "「…………」"},
{"id": "clse07:463900", "ko": "「후에? 아아, 좋은 아침, 아리무라」"},
{"id": "clse07:464000", "ko": "「……뭘?」"},
{"id": "clse07:464100", "ko": "「아아……」"},
{"id": "clse07:464200", "ko": "「말했지」"},
{"id": "clse07:464300", "ko": "「아아……」"},
{"id": "clse07:464400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:464500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:464600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:464700", "ko": "「호고오오오오옥!!」"},
{"id": "clse07:464800", "ko": "「…………」"},
{"id": "clse07:464900", "ko": "「응…… 아아, 좋은 아침」"},
{"id": "clse07:465000", "ko": "「그, 그렇지……」"},
{"id": "clse07:465100", "ko": "「설마…… 대본?」"},
{"id": "clse07:465200", "ko": "「대본이니까 말이지」"},
{"id": "clse07:465300", "ko": "「…………」"},
{"id": "clse07:465400", "ko": "「그보다 아리무라. 동아리 말인데, 한동안 신문부에는 얼굴 안 비치는 게 좋지 않을까?」"},
{"id": "clse07:465500", "ko": "「쓸데없는 데서 괜한 말을 툭 해 버릴 수도 있잖아. 아무 일도 없다고 해도, 이상한 소문이 나면 아리무라도 곤란하잖아?」"},
{"id": "clse07:465600", "ko": "「후우……」"},
{"id": "clse07:465700", "ko": "「…………」"},
{"id": "clse07:465800", "ko": "「아리무라…… 학교에서는 되도록 엮이지 말자고 방금 말했잖아」"},
{"id": "clse07:465900", "ko": "「왜, 왜 그래? 뭐 특종이라도 있었어?」"},
{"id": "clse07:466000", "ko": "「소문……?」"},
{"id": "clse07:466100", "ko": "「뭐!?」"},
{"id": "clse07:466200", "ko": "「그, 그건……」"},
{"id": "clse07:466300", "ko": "「야, 야, 아리무라!!!」"},
{"id": "clse07:466400", "ko": "「으…… 뭐, 그런 거야. 그러니까 이상한 일은 아무것도 없어. 정말로」"},
{"id": "clse07:466500", "ko": "「엥?」"},
{"id": "clse07:466600", "ko": "「이토……」"},
{"id": "clse07:466700", "ko": "「…………」"},
{"id": "clse07:466800", "ko": "「물론이죠!!!」"},
{"id": "clse07:466900", "ko": "「네?」"},
{"id": "clse07:467000", "ko": "「어, 어째서요!?」"},
{"id": "clse07:467100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:467200", "ko": "「아, 아니…… 없…… 습니다……」"}
]
