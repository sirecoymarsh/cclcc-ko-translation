[
{"id": "clka05:10000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:10100", "ko": "그건 채찍이었다."},
{"id": "clka05:10200", "ko": "그제야 나는 카즈키의 차림이 뜻하는 바를 알아차렸다."},
{"id": "clka05:10300", "ko": "「……그건, 설마」"},
{"id": "clka05:10400", "ko": "「여왕, 님?」"},
{"id": "clka05:10500", "ko": "그러자 카즈키는 생긋 웃었다."},
{"id": "clka05:10600", "ko": "「그래, 어린 양아♪」"},
{"id": "clka05:10700", "ko": "그리고 웃는 얼굴 그대로 그 채찍을 내 배에 내리쳤다."},
{"id": "clka05:10800", "ko": "「아얏! 뭐, 뭐 하는 거야!」"},
{"id": "clka05:10900", "ko": "「그건 내가 할 소리인데」"},
{"id": "clka05:11000", "ko": "「어린 양이 말해도 되는 건 내가 허락했을 때뿐이야. 가르쳐 줬잖아?」"},
{"id": "clka05:11100", "ko": "「무무무, 무슨 소리야!」"},
{"id": "clka05:11200", "ko": "「아얏!」"},
{"id": "clka05:11300", "ko": "「오늘은 어지간히 놀아 주길 바라나 보네」"},
{"id": "clka05:11400", "ko": "「그래도 기뻐. 그건 이걸 원한다는 뜻이니까」"},
{"id": "clka05:11500", "ko": "카즈키는 채찍 손잡이를 사랑스럽다는 듯 손바닥으로 쓰다듬으며 말했다."},
{"id": "clka05:11600", "ko": "「원하는 대로, 오늘은 잔뜩 놀아 줄・게」"},
{"id": "clka05:11700", "ko": "「아얏! 자, 잠깐! 왜 내가 맞아야 하는 건데!」"},
{"id": "clka05:11800", "ko": "「너는 내 하인이야. 잊어버렸니?」"},
{"id": "clka05:11900", "ko": "「어어어, 언제부터……?」"},
{"id": "clka05:12000", "ko": "「아주 옛날부터. 그리고 앞으로도 쭉」"},
{"id": "clka05:12100", "ko": "「잊어버린 거야? 슬퍼……」"},
{"id": "clka05:12200", "ko": "「하지만 괜찮아. 떠올리게 해 줄 테니까」"},
{"id": "clka05:12300", "ko": "「으응, 조금 다른가」"},
{"id": "clka05:12400", "ko": "「떠올릴 때까지 놀아 줄게」"},
{"id": "clka05:12500", "ko": "「아얏!」"},
{"id": "clka05:12600", "ko": "「아욱!」"},
{"id": "clka05:12700", "ko": "「으윽!」"},
{"id": "clka05:12800", "ko": "「우후후후후후후후후후후」"},
{"id": "clka05:12900", "ko": "카즈키는 즐겁게 웃으며 계속 채찍을 휘둘렀다."},
{"id": "clka05:13000", "ko": "……스스로도 내 망상력에 어이가 없다."},
{"id": "clka05:13100", "ko": "체육 창고 안에서 여학생이 올라타 있는 상황에서 여왕님 플레이를 망상해 버리다니."},
{"id": "clka05:13200", "ko": "게다가 상대는 카즈키라고. 노노나 아리무라라면 몰라도."},
{"id": "clka05:13300", "ko": "……아니, 딱히 노노나 아리무라라면 여왕님이 어울린다는 말은 아니라고."},
{"id": "clka05:13400", "ko": "아무튼 이 상황을 어떻게든 하자."},
{"id": "clka05:13500", "ko": "「카, 카즈키?」"},
{"id": "clka05:13600", "ko": "「……」"},
{"id": "clka05:13700", "ko": "「……」"},
{"id": "clka05:13800", "ko": "「……응」"},
{"id": "clka05:13900", "ko": "「이이이, 이 상황에 대해서 나는 아무 잘못도 없으니까」"},
{"id": "clka05:14000", "ko": "「덮쳐 온 건, 너너너, 너니까」"},
{"id": "clka05:14100", "ko": "아직 아무 말도 듣지 않았는데 변명해 버렸다. 스스로도 책임 회피하려는 이 쫄보 근성에 눈물이 난다."},
{"id": "clka05:14200", "ko": "「……」"},
{"id": "clka05:14300", "ko": "「……」"},
{"id": "clka05:14400", "ko": "「……타쿠루, 선배」"},
{"id": "clka05:14500", "ko": "「아, 아무튼, 일단 좀 비켜 줄래?」"},
{"id": "clka05:14600", "ko": "「그리고 무엇 때문에 나를 여기로 불렀는지 가르쳐 줘」"},
{"id": "clka05:14700", "ko": "그 순간, 카즈키의 표정이 바뀌었다."},
{"id": "clka05:14800", "ko": "「『무엇 때문에』라니, 뻔하잖아」"},
{"id": "clka05:14900", "ko": "「어?」"},
{"id": "clka05:15000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:15100", "ko": "「하나, 뿐이라고? 카즈키, 너 무슨――」"},
{"id": "clka05:15200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:15300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:15400", "ko": "「뭐!?」"},
{"id": "clka05:15500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:15600", "ko": "카즈키는 장난스럽게 웃더니 다시 고개를 들고 나를 내려다보았다."},
{"id": "clka05:15700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:15800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:15900", "ko": "분명히 평소의 카즈키가 아니었다."},
{"id": "clka05:16000", "ko": "겉모습은 그대로인데 말투와 표정이 완전히 바뀌어 있었다. 그것만으로도 모르는 사람을 상대하는 듯한 묘한 기분이 들었다."},
{"id": "clka05:16100", "ko": "「대, 대시!? 그게 뭔데!!」"},
{"id": "clka05:16200", "ko": "「아〜, 아직도 모르는구나! 충격이네〜」"},
{"id": "clka05:16300", "ko": "「자, 이러면 어때?」"},
{"id": "clka05:16400", "ko": "그렇게 말하며 카즈키는 왼손을 들어 눈가를 가렸다."},
{"id": "clka05:16500", "ko": "「어때? 생각났어?」"},
{"id": "clka05:16600", "ko": "「생각나다니, 대체 뭘――」"},
{"id": "clka05:16700", "ko": "그때, 머릿속에 사진 한 장이 번뜩 떠올랐다."},
{"id": "clka05:16800", "ko": "「호, 호, 혹」"},
{"id": "clka05:16900", "ko": "「호호호호호호호호혹」"},
{"id": "clka05:17000", "ko": "「혹시, 그 셀카 사진, 카즈키였어!?」"},
{"id": "clka05:17100", "ko": "「당연하잖아〜!」"},
{"id": "clka05:17200", "ko": "「어디로 보나 나잖아〜!」"},
{"id": "clka05:17300", "ko": "「여기까지 해야 알아주는 미야시로 선배 쪽이 나로서는 더 놀랍다고〜!」"},
{"id": "clka05:17400", "ko": "드, 듣고 보니 그 말대로다."},
{"id": "clka05:17500", "ko": "머리 모양도,"},
{"id": "clka05:17600", "ko": "니삭스도,"},
{"id": "clka05:17700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:17800", "ko": "그 사진에 찍힌 여자애가 틀림없다."},
{"id": "clka05:17900", "ko": "「……전혀 몰랐어」"},
{"id": "clka05:18000", "ko": "「아이참, 왜〜!」"},
{"id": "clka05:18100", "ko": "「애초에 카즈키가 그런 사진을 찍는다는 것 자체가 상상 밖이었으니까……」"},
{"id": "clka05:18200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:18300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:18400", "ko": "「뭐, 상관없지만〜. 그래서 여기로 불러낸 거고」"},
{"id": "clka05:18500", "ko": "「무, 무슨 소리야?」"},
{"id": "clka05:18600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:18700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:18800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:18900", "ko": "「응」"},
{"id": "clka05:19000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:19100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:19200", "ko": "「힉!」"},
{"id": "clka05:19300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:19400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:19500", "ko": "「시, 시작하다니, 뭐, 뭘……?」"},
{"id": "clka05:19600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:19700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:19800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:19900", "ko": "", "note": "보류 — 성적 묘사"}
]
