[
{"id": "clah07:9800", "ko": "（선배라면 귀찮다느니 하면서도 따라와 주겠지）"},
{"id": "clah07:9900", "ko": "（으음, 그래도 선배는 무서운 놀이기구 같은 거 못 탈 것 같고, 호러 쪽도 안 될 것 같고）"},
{"id": "clah07:10000", "ko": "（후훗. 그래도 내 앞에서는 센 척하거나 하면서……）"},
{"id": "clah07:10100", "ko": "「어이, 너」"},
{"id": "clah07:10200", "ko": "「에?」"},
{"id": "clah07:10300", "ko": "딴생각을 하며 걷고 있던 탓에, 앞쪽에서 아는 얼굴이 다가오고 있다는 걸 히나에는 알아차리지 못했다."},
{"id": "clah07:10400", "ko": "알았더라면 설령 상대가 히나에를 이미 봤다 해도 도중에 길을 바꿨을 텐데."},
{"id": "clah07:10500", "ko": "그만큼 히나에는 눈앞에 선 소녀, 쿠노사토 미오가 껄끄러웠다."},
{"id": "clah07:10600", "ko": "「……무슨 볼일 있슴까?」"},
{"id": "clah07:10700", "ko": "「뭘 히죽거리는지는 모르겠다만, 걸을 때는 앞을 똑바로 보고 걸어라」"},
{"id": "clah07:10800", "ko": "「하? 딱히 히죽거리지 않았거든요」"},
{"id": "clah07:10900", "ko": "「히죽거리고 있었지. 멀리서 봐도 기분 나쁠 정도로」"},
{"id": "clah07:11000", "ko": "깔보듯이 그렇게 말하고서 미오는 지나쳐 갔다."},
{"id": "clah07:11100", "ko": "⟦top:38⟧하지만."},
{"id": "clah07:11200", "ko": "「…………」"},
{"id": "clah07:11300", "ko": "지금의 히나에에게 그런 미오의 태도는 아무래도 상관없었다."},
{"id": "clah07:11400", "ko": "「히죽…… 거렸다고? 내가……?」"},
{"id": "clah07:11500", "ko": "미오의 말에 “거짓”은 없었다."},
{"id": "clah07:11600", "ko": "⟦top:38⟧그렇다는 건 사실이라는 것이다."},
{"id": "clah07:11700", "ko": "「어라? 나…… 거짓말…… 이지?」"},
{"id": "clah07:11800", "ko": "그 순간, 히나에는 알아 버렸다."},
{"id": "clah07:11900", "ko": "⟦top:38⟧자기 마음의 “진실”을."}
]
