[
{"id": "clyu01:10000", "ko": "「그럼, 지금부터 단 거 같이 먹으러 갈래?」"},
{"id": "clyu01:10100", "ko": "「단 거라……」"},
{"id": "clyu01:10200", "ko": "딱히 이후에 할 일이 있는 것도 아니니 거절할 이유는 없지만……"},
{"id": "clyu01:10300", "ko": "「타쿠루. 미안한데, 이따가 잠깐 괜찮을까?」"},
{"id": "clyu01:10400", "ko": "거 봐, 왔다."},
{"id": "clyu01:10500", "ko": "「미안해, 세리카. 타쿠루 좀 빌릴게」"},
{"id": "clyu01:10600", "ko": "「우~…… 그렇구나. 그럼 단 건 다음에 먹을까~」"},
{"id": "clyu01:10700", "ko": "잠깐, 기다려."},
{"id": "clyu01:10800", "ko": "내 의견은 아랑곳없이 이야기가 멋대로 진행되고 있잖아."},
{"id": "clyu01:10900", "ko": "「야, 쿠루스. 난 아직 간다고는……」"},
{"id": "clyu01:11000", "ko": "「할 얘기가 있어…… 부탁이야」"},
{"id": "clyu01:11100", "ko": "역시."},
{"id": "clyu01:11200", "ko": "어차피 우키 얘기라고 하겠지?"},
{"id": "clyu01:11300", "ko": "「실은, 유이 얘기인데……」"},
{"id": "clyu01:11400", "ko": "「유이 얘기?」"},
{"id": "clyu01:11500", "ko": "「왜 그래?」"},
{"id": "clyu01:11600", "ko": "「아, 아니…… 아까 흐름으로 봐선 당연히 우키 얘긴 줄 알았거든」"},
{"id": "clyu01:11700", "ko": "「우키? 왜?」"},
{"id": "clyu01:11800", "ko": "「그게 말야. 우키가 남 생각만 하는 게…… 라든가 그런 얘긴 줄……」"},
{"id": "clyu01:11900", "ko": "「……글쎄…… 그래도 그건 그것대로 우키가 하고 싶어서 하는 거니까……」"},
{"id": "clyu01:12000", "ko": "그렇군. 그럼 우키에 관해서는 쿠루스도 같은 의견이라는 건가."},
{"id": "clyu01:12100", "ko": "당연히 오지랖 넓은 노노가 남 생각만 하는 우키를 걱정해서 나한테…… 하는 얘긴 줄 알았는데, 아무래도 아니었던 모양이다."},
{"id": "clyu01:12200", "ko": "그런데 그렇다고 유이 일로 상담이라니…… 뭐지?"},
{"id": "clyu01:12300", "ko": "그 나이대 여자애의 고민 상담이란, 십중팔구 남자한테는 묻지 않는 법이라고 정해져 있다."},
{"id": "clyu01:12400", "ko": "남자인 나한테 상담해서 해결될 일이 있을 것 같지 않다."},
{"id": "clyu01:12500", "ko": "……잠깐."},
{"id": "clyu01:12600", "ko": "어쩌면 남자라서 할 수 있는 상담이라는 게……"},
{"id": "clyu01:12700", "ko": "……그런 게 있을까?"},
{"id": "clyu01:12800", "ko": "그때, 노크 소리가 울렸다."},
{"id": "clyu01:12900", "ko": "정신을 차려 보니, 나와 노노 말고는 부원들이 다 돌아가 버린 뒤였다."},
{"id": "clyu01:13000", "ko": "「저기~」"},
{"id": "clyu01:13100", "ko": "조심조심 문을 열고 들어온 건, 다름 아닌 유이 본인이었다."},
{"id": "clyu01:13200", "ko": "「유이? 왜 여기에?」"},
{"id": "clyu01:13300", "ko": "「노노 언니가 오라고 해서 왔는데……」"},
{"id": "clyu01:13400", "ko": "「마침 잘됐다. 지금 네 얘기를 하던 참이야, 유이」"},
{"id": "clyu01:13500", "ko": "「내 얘기?」"},
{"id": "clyu01:13600", "ko": "「그 일 말인데…… 나도 여러모로 생각해 봤는데, 역시 해결 방법은 그 방법밖에 없을 것 같아」"},
{"id": "clyu01:13700", "ko": "「아……」"},
{"id": "clyu01:13800", "ko": "노노의 말에, 석양에 물든 유이의 얼굴이 한층 더 붉어졌다."},
{"id": "clyu01:13900", "ko": "그 일?"},
{"id": "clyu01:14000", "ko": "「그래도, 그건……」"},
{"id": "clyu01:14100", "ko": "「부끄러운 건 알지만. 그래도 지금은 용기를 내야 할 때 아닐까」"},
{"id": "clyu01:14200", "ko": "대체 둘이 무슨 얘기를 하는 거지?"},
{"id": "clyu01:14300", "ko": "부끄럽고, 용기가 필요한 일?"},
{"id": "clyu01:14400", "ko": "「…………」"},
{"id": "clyu01:14500", "ko": "「자, 큰맘 먹고 부탁해 봐. 타쿠루라면 분명 기꺼이 도와줄 거야」"},
{"id": "clyu01:14600", "ko": "한동안 망설이던 유이였지만, 노노가 가볍게 등을 떠밀자 겨우 결심이 선 듯 고개를 들었다."},
{"id": "clyu01:14700", "ko": "「으, 응…… 알았어」"},
{"id": "clyu01:14800", "ko": "그리고 종종걸음으로 내 앞까지 오더니, 똑바로 내 얼굴을 올려다보았다."},
{"id": "clyu01:14900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:15000", "ko": "「저, 저기 말야…… 타쿠루 오빠……」"},
{"id": "clyu01:15100", "ko": "「뭐, 뭐야?」"},
{"id": "clyu01:15200", "ko": "「그, 그게…… 내…… 으……」"},
{"id": "clyu01:15300", "ko": "「어?」"},
{"id": "clyu01:15400", "ko": "「미안. 잘 안 들려」"},
{"id": "clyu01:15500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:15600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:15700", "ko": "「으…… 응……」"},
{"id": "clyu01:15800", "ko": "「뭐어어어어어어어어어어어?!」"},
{"id": "clyu01:15900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:16000", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:16100", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:16200", "ko": "「여, 역시 싫어?」"},
{"id": "clyu01:16300", "ko": "슬픈 얼굴로 말하는 유이에게 나는 점점 더 당황했다."},
{"id": "clyu01:16400", "ko": "「시, 싫다기보다는…… 그게, 그…… 왜?」"},
{"id": "clyu01:16500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:16600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:16700", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:16800", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:16900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:17000", "ko": "게다가……"},
{"id": "clyu01:17100", "ko": "「왜 내가?」"},
{"id": "clyu01:17200", "ko": "「그건, 노노 언니가……」"},
{"id": "clyu01:17300", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:17400", "ko": "그거야말로 미심쩍은 얘기잖아."},
{"id": "clyu01:17500", "ko": "설마 노노가 그런 수상쩍은 얘기에 놀아나다니……"},
{"id": "clyu01:17600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:17700", "ko": "「그, 그런 건 아니야!!」"},
{"id": "clyu01:17800", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:17900", "ko": "유이가 눈에 띄게 풀이 죽어 어깨를 떨궜다."},
{"id": "clyu01:18000", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:18100", "ko": "「아, 아니야! 난 그런 말 한마디도 안 했어!」"},
{"id": "clyu01:18200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:18300", "ko": "「그건……」"},
{"id": "clyu01:18400", "ko": "여기서 선언해도 되는 건가?"},
{"id": "clyu01:18500", "ko": "그런 말을 입에 올리면, 나는 뭔가 소중한 것을 잃어버릴 것 같은 기분이 든다……"},
{"id": "clyu01:18600", "ko": "「역시……」"},
{"id": "clyu01:18700", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:18800", "ko": "말해…… 버렸다……"},
{"id": "clyu01:18900", "ko": "그런데 뭘까."},
{"id": "clyu01:19000", "ko": "말해 버리고 나니, 왠지 속이 후련해진 것 같다."},
{"id": "clyu01:19100", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:19200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:19300", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:19400", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:19500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:19600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:19700", "ko": "", "note": "보류 — 성적 묘사(미성년). 다음 줄 노노의 「どこへ行くの？」가 이 줄의 「いくよ」(간다)를 받는 말장난"},
{"id": "clyu01:19800", "ko": "「어디 가는데?」"},
{"id": "clyu01:19900", "ko": "「엥?」"}
]
