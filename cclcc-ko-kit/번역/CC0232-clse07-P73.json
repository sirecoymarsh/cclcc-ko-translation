[
{"id": "clse07:704400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:704500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:704600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:704700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:704800", "ko": "「…………」"},
{"id": "clse07:704900", "ko": "「어? 아, 아아」"},
{"id": "clse07:705000", "ko": "「아, 아무튼 나한테 맡겨 두면 어떻게든 할 테니까」"},
{"id": "clse07:705100", "ko": "「…………」"},
{"id": "clse07:705200", "ko": "「하아……」"},
{"id": "clse07:705300", "ko": "「아아…… 고마워……」"},
{"id": "clse07:705400", "ko": "「어라? 뭐지, 이거?」"},
{"id": "clse07:705500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:705600", "ko": "「――!?」"},
{"id": "clse07:705700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:705800", "ko": "「유이…… 유토……」"},
{"id": "clse07:705900", "ko": "「읏…………」"},
{"id": "clse07:706000", "ko": "「으, 으으……」"},
{"id": "clse07:706100", "ko": "「…………」"},
{"id": "clse07:706200", "ko": "「어? 아, 아아」"},
{"id": "clse07:706300", "ko": "「으음……」"},
{"id": "clse07:706400", "ko": "「실은 말이야……」"},
{"id": "clse07:706500", "ko": "「다른 무슨 아이돌이 있는데?」"},
{"id": "clse07:706600", "ko": "「왜 원래 뜻으로 받아들이는 건데……」"},
{"id": "clse07:706700", "ko": "「뭐, 아이돌 활동이라고 해도 놀이 같은 거지만……」"},
{"id": "clse07:706800", "ko": "「뭐, 뭐어 나름대로는……」"},
{"id": "clse07:706900", "ko": "「아, 아이돌 여러분…… 죄송합니다……」"},
{"id": "clse07:707000", "ko": "「아, 알았어. 내 인식이 틀렸어……」"},
{"id": "clse07:707100", "ko": "「아이돌 활동은 나 같은 게 그렇게 가볍게 손댈 만한 게 아니었어. 포기할게」"},
{"id": "clse07:707200", "ko": "「뭐? 그치만 너희가 말했잖아. 가볍게 할 게 아니라고」"},
{"id": "clse07:707300", "ko": "「누가 유이랑 우키가 한다고 했어?」"},
{"id": "clse07:707400", "ko": "「아니, 그럴 리가 없잖아」"},
{"id": "clse07:707500", "ko": "「유닛을 짜는 건 유이랑 우키가 아니야. 유이랑 유토다」"},
{"id": "clse07:707600", "ko": "「물론 여자애 유닛이다」"},
{"id": "clse07:707700", "ko": "「어……?」"},
{"id": "clse07:707800", "ko": "「억지 부리지 마. 애초에 이런 건 예상 못 했으니까」"},
{"id": "clse07:707900", "ko": "「…………」"},
{"id": "clse07:708000", "ko": "「왜, 왜 내가 이토한테 질투 같은 걸 해야 하는 건데……」"},
{"id": "clse07:708100", "ko": "「딱히 쑥스러워하는 거 아니거든!」"},
{"id": "clse07:708200", "ko": "「뭐? 왜?」"},
{"id": "clse07:708300", "ko": "「뭐야? 딱히 남자끼리니까 괜찮잖아?」"},
{"id": "clse07:708400", "ko": "「…………」"},
{"id": "clse07:708500", "ko": "「뭐……」"},
{"id": "clse07:708600", "ko": "「이건……」"},
{"id": "clse07:708700", "ko": "「그보다 가발은 어디서 가져온 거야?」"},
{"id": "clse07:708800", "ko": "「아니, 나여도 되지 않아?」"},
{"id": "clse07:708900", "ko": "「『밀푀유』라. 헤에…… 나쁘지 않은 이름이잖아」"},
{"id": "clse07:709000", "ko": "「…………」"},
{"id": "clse07:709100", "ko": "「…………」"},
{"id": "clse07:709200", "ko": "「읏……」"},
{"id": "clse07:709300", "ko": "「야, 이토! 이건……」"},
{"id": "clse07:709400", "ko": "「아…… 네」"},
{"id": "clse07:709500", "ko": "「――가 아니라! 야, 이토! 이게 뭐야!?」"},
{"id": "clse07:709600", "ko": "「다짜고짜 수영복이라니, 좀 지나친 거 아냐?」"},
{"id": "clse07:709700", "ko": "「그, 그건 그렇지만…… 그, 그렇다고 해도…… 그, 천이 좀…… 너무 작지 않아?」"},
{"id": "clse07:709800", "ko": "「읏……」"},
{"id": "clse07:709900", "ko": "「스톱!! 안 돼 안 돼! 카메라 멈춰!」"},
{"id": "clse07:710000", "ko": "「됐으니까 아무튼 멈춰!」"},
{"id": "clse07:710100", "ko": "「이토는 프로듀서에서 내려와 줘야겠어」"},
{"id": "clse07:710200", "ko": "「더 이상 너한테 맡겨 둘 수 없다고 내가 판단했으니까. 아무리 그래도 그건 너무 지나쳐」"},
{"id": "clse07:710300", "ko": "「아니, 다른 방법도 있을 거야. 그게 생각나지 않는다면 역시 이토는 내려와 줄 수밖에 없어」"},
{"id": "clse07:710400", "ko": "「애초에 거기 빌릴 돈은 어떻게 한 거야? 수영복도 돈 들었을 거 아냐」"},
{"id": "clse07:710500", "ko": "「너 말이야…… 이건 동아리 활동이 아니니까 그런 게 될 리가 없잖아?」"},
{"id": "clse07:710600", "ko": "「몰라. 네가 멋대로 한 거잖아. 네가 알아서 해」"},
{"id": "clse07:710700", "ko": "「야, 아리무라. 괜찮은 거야, 저거……」"},
{"id": "clse07:710800", "ko": "「유니폼 만들 돈 같은 건 없었잖아」"},
{"id": "clse07:710900", "ko": "「그래? 그래도 유니폼이잖아? 재료비만 해도 꽤 들지 않아?」"},
{"id": "clse07:711000", "ko": "「오오오, 이건――!」"},
{"id": "clse07:711100", "ko": "「…………」"},
{"id": "clse07:711200", "ko": "「기다려, 아리무라」"},
{"id": "clse07:711300", "ko": "「아리무라…… 너, 전체적으로 촌스러워……」"},
{"id": "clse07:711400", "ko": "「그러니까 감각이 낡았다니까. 뭐야, 아까 그건」"},
{"id": "clse07:711500", "ko": "「어느 시대 아이돌이야, 그거」"},
{"id": "clse07:711600", "ko": "「설마 이다음에 회전목마 타고 손 흔들거나, 풀밭에 누워서 민들레 꽃잎을 한 장 한 장 세거나 하는 건 아니겠지?」"},
{"id": "clse07:711700", "ko": "「나한테……?」"},
{"id": "clse07:711800", "ko": "「알았어. 그렇게까지 말한다면, 앞으로는 내가 책임지고 두 사람을 프로듀스할게」"},
{"id": "clse07:711900", "ko": "「유이는 알지?」"},
{"id": "clse07:712000", "ko": "「그런 거다」"},
{"id": "clse07:712100", "ko": "「그래서 두 사람은 지금부터 이 곡에 맞춰 춤을 춰 줘야겠어」"},
{"id": "clse07:712200", "ko": "「그건, 왜. 유토도 그 차림에 익숙해져 두지 않으면 정작 중요할 때 행동거지에 티가 나잖아?」"},
{"id": "clse07:712300", "ko": "「그러니까 지금부터 아까 그 곡으로 춤을 춰 줘야 하는데…… 할 수 있지?」"},
{"id": "clse07:712400", "ko": "「유이…… 일단 오늘은 이 정도로 해 둘까」"},
{"id": "clse07:712500", "ko": "「쿠루스도 돌아왔고, 오늘은 이걸로 끝이다. 응?」"},
{"id": "clse07:712600", "ko": "「그래. 좋아」"},
{"id": "clse07:712700", "ko": "「뭐, 뭐어, 너무 깊이 고민하지 않아도 되지 않을까? 누구나 서툰 건 있는 거고, 조금씩 극복해 나가면」"},
{"id": "clse07:712800", "ko": "「그럼 어떡할래? 아이돌 활동 그만둘래?」"},
{"id": "clse07:712900", "ko": "「유, 유이…… 울 것까지는……」"},
{"id": "clse07:713000", "ko": "「괜찮아…… 유이라면 할 수 있어」"},
{"id": "clse07:713100", "ko": "「내가 곁에 있잖아」"},
{"id": "clse07:713200", "ko": "「그래……」"},
{"id": "clse07:713300", "ko": "「뭐, 뭔데?」"},
{"id": "clse07:713400", "ko": "「……그래」"},
{"id": "clse07:713500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:713600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:713700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:713800", "ko": "「응?」"},
{"id": "clse07:713900", "ko": "「미, 미안……」"},
{"id": "clse07:714000", "ko": "「그, 그렇구나……」"},
{"id": "clse07:714100", "ko": "「괜찮아, 유이? 좀 쉴래?」"},
{"id": "clse07:714200", "ko": "「해냈구나, 유이! 끝까지 쭉 제대로 췄어!」"},
{"id": "clse07:714300", "ko": "「그건 말인데…… 실은 두 사람한테 보여 주고 싶은 게 있어」"}
]
