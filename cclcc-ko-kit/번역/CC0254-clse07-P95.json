[
{"id": "clse07:899500", "ko": "「유이, 그렇게 수긍하긴 했지만, 사실은 해 보고 싶을 거예요. 그러니까……」"},
{"id": "clse07:899600", "ko": "「유이……」"},
{"id": "clse07:899700", "ko": "「그러니까, 그건 그……」"},
{"id": "clse07:899800", "ko": "「응」"},
{"id": "clse07:899900", "ko": "「네? 아, 아니에요. 그게 아니라, 저는 유이한테……」"},
{"id": "clse07:900000", "ko": "「그치만…… 유이, 사실은 하고 싶어 보였으니까. 그래도 괜한 짓이었나?」"},
{"id": "clse07:900100", "ko": "「왓」"},
{"id": "clse07:900200", "ko": "「그런…… 난 유이가 기뻐해 주길 바랐을 뿐인데」"},
{"id": "clse07:900300", "ko": "「어? 나, 나? 무, 무리야, 아이돌 같은 거, 그런 건……」"},
{"id": "clse07:900400", "ko": "「그런…… 나 같은 게……」"},
{"id": "clse07:900500", "ko": "「…………」"},
{"id": "clse07:900600", "ko": "「아니, 역시 나는……」"},
{"id": "clse07:900700", "ko": "「어?」"},
{"id": "clse07:900800", "ko": "「타쿠루 씨……」"},
{"id": "clse07:900900", "ko": "「저를? 유이가 필요로 한다고……?」"},
{"id": "clse07:901000", "ko": "「나라도…… 도움이 될 수 있을까?」"},
{"id": "clse07:901100", "ko": "「그게…… 죄송해요. 역시 무리예요」"},
{"id": "clse07:901200", "ko": "「읏……」"},
{"id": "clse07:901300", "ko": "「저기…… 제가 이상한 말 했나요?」"},
{"id": "clse07:901400", "ko": "「그런…… 가요? 그래도 저는 그런 식으로 사람들 앞에 나서는 건 못 해서……」"},
{"id": "clse07:901500", "ko": "「유이의 발목을 잡게 될 것 같기도 하고요……」"},
{"id": "clse07:901600", "ko": "「타, 타쿠루 씨…… 왜 그러는 걸까요?」"},
{"id": "clse07:901700", "ko": "「자매?」", "note": "타쿠루가 말한 「姉妹(ユニット)」를 되묻는 줄(CC0273 같은 장면 참고)"},
{"id": "clse07:901800", "ko": "「저, 저요? 그게…… 저는 괜찮다고 생각해요. 적어도 제가 하는 것보다는……」"},
{"id": "clse07:901900", "ko": "「그게……」"},
{"id": "clse07:902000", "ko": "「알겠어요」"},
{"id": "clse07:902100", "ko": "「아이돌 활동에도 돈이 드는군요……」"},
{"id": "clse07:902200", "ko": "「네, 네」"},
{"id": "clse07:902300", "ko": "「오래 기다리셨죠」"},
{"id": "clse07:902400", "ko": "「저, 저는 좋다고 생각하는데요……」"},
{"id": "clse07:902500", "ko": "「타쿠루 씨라면…… 분명 할 수 있을 거예요……」"},
{"id": "clse07:902600", "ko": "「…………」"},
{"id": "clse07:902700", "ko": "「그럼…… 해 볼게요」"},
{"id": "clse07:902800", "ko": "「『이, 이럴 때는, 그…… 그러니까…… 어, 어떡하죠……』」"},
{"id": "clse07:902900", "ko": "「죄송했어요, 타쿠루 씨」"},
{"id": "clse07:903000", "ko": "「어떻게 된 걸까요?」"},
{"id": "clse07:903100", "ko": "「…………」"},
{"id": "clse07:903200", "ko": "「「네. 선생님이 부탁하신 일을 끝내고 교실에 돌아갔더니 유이가 보이지 않아서, 당연히 먼저 간 줄 알았는데……」」", "note": "원문의 겹낫표 「「」」 그대로 둠"},
{"id": "clse07:903300", "ko": "「유이……」"},
{"id": "clse07:903400", "ko": "「괜찮아요? 다친 데는 없어요?」"},
{"id": "clse07:903500", "ko": "「…………」"},
{"id": "clse07:903600", "ko": "「……저기, 왜 그러세요?」"},
{"id": "clse07:903700", "ko": "「저도 아버지 일 도우러 갈게요」"},
{"id": "clse07:903800", "ko": "「네?」"},
{"id": "clse07:903900", "ko": "「아, 아리무라 씨, 그렇게 부끄러워할 만한 거였어요?」"},
{"id": "clse07:904000", "ko": "「저도요」"},
{"id": "clse07:904100", "ko": "「언니?!」"},
{"id": "clse07:904200", "ko": "「죄송해요, 타쿠루 씨……」"},
{"id": "clse07:904300", "ko": "「지금 따뜻한 차 탈게요」"},
{"id": "clse07:904400", "ko": "「뭐야~. 돌아왔구나」"},
{"id": "clse07:904500", "ko": "「딱히 안 돌아와도 됐는데」"},
{"id": "clse07:904600", "ko": "「나가고 싶어서 나간 거잖아? 그럼 마음대로 하면 되잖아」"},
{"id": "clse07:904700", "ko": "「우, 우키도 참, 무슨 소리야! 외로워한 적 없단 말야!」"},
{"id": "clse07:904800", "ko": "「아, 아아아, 안 했단 말야! 그런 거 안 했단 말야!」"},
{"id": "clse07:904900", "ko": "「읏?!」"},
{"id": "clse07:905000", "ko": "「아니란 말야! 딱히 아끼는 옷을 타쿠루 오빠한테 보여 주려고 했다든가, 그런 거 아니란 말야!!」"},
{"id": "clse07:905100", "ko": "「우~」"},
{"id": "clse07:905200", "ko": "「이, 일단 어서 오라고는 해 줄게……」"},
{"id": "clse07:905300", "ko": "「쿠루스? 뭐야? 타쿠루 오빠, 설마 집에서도 노노 언니를 쿠루스라고 부를 생각이야?」"},
{"id": "clse07:905400", "ko": "「노노 언니라면 아까 옷 갈아입고 온다고 방에 갔어」"},
{"id": "clse07:905500", "ko": "「타쿠루 오빠도 갈아입고 오지 그래?」"},
{"id": "clse07:905600", "ko": "「응. 노노 언니한테 무슨 볼일 있어?」"},
{"id": "clse07:905700", "ko": "「잘 먹겠습니다」"},
{"id": "clse07:905800", "ko": "「…………」"},
{"id": "clse07:905900", "ko": "「지, 집에서 먹는 카레는 어때?」"},
{"id": "clse07:906000", "ko": "「정말?!」"},
{"id": "clse07:906100", "ko": "「헤헤헤~」"},
{"id": "clse07:906200", "ko": "「에헴!!」"},
{"id": "clse07:906300", "ko": "「들었지, 센리 언니!」"},
{"id": "clse07:906400", "ko": "「어…… 그건 좀……」"},
{"id": "clse07:906500", "ko": "「얘, 유!!」"},
{"id": "clse07:906600", "ko": "「에이, 들어 있어. 봐, 거기」"},
{"id": "clse07:906700", "ko": "「본고장 카레에는 소고기가 안 들어갑니다」"},
{"id": "clse07:906800", "ko": "「그런 거 들어 본 적 없어」"},
{"id": "clse07:906900", "ko": "「안 돼. 텔레비전은 다들 다 먹고 나서라는 규칙이잖아」"},
{"id": "clse07:907000", "ko": "「아! 그 마술?! 말도 안 돼, 오늘이었나?」"},
{"id": "clse07:907100", "ko": "「아빠도 참, 또 그렇게 놀린다니까」"},
{"id": "clse07:907200", "ko": "「그게 놀리는 거라고. 애초에 나 이제 어린애 아니거든!」"},
{"id": "clse07:907300", "ko": "「그치? 우키도 그렇게 생각하지?」"},
{"id": "clse07:907400", "ko": "「애초에 내 건 그냥 꿈이 아니란 말야」"},
{"id": "clse07:907500", "ko": "「…………」"},
{"id": "clse07:907600", "ko": "「미안. 사실은 계속 비밀로 하려고 했는데, 역시 안 되겠지. 우린 가족이니까」"},
{"id": "clse07:907700", "ko": "「가족은 숨기는 거 없기. 그렇지, 센리 언니」"},
{"id": "clse07:907800", "ko": "「에잇」"},
{"id": "clse07:907900", "ko": "「파라파라파랄린, 파랄리릴~♪」"},
{"id": "clse07:908000", "ko": "「마법의 아이돌, 매지컬 유이, 등장이야. 후훗히♪」"},
{"id": "clse07:908100", "ko": "「후훗, 놀랐지, 타쿠루 오빠」"},
{"id": "clse07:908200", "ko": "「지금까지 말 안 해서 미안해. 내가 모두의 아이돌, 매지컬 유이였다는 거……」"},
{"id": "clse07:908300", "ko": "「그래도…… 타쿠루 오빠가 원한다면, 오빠만의 아이돌이 돼 줘도…… 괜찮은데?」"},
{"id": "clse07:908400", "ko": "「뭐, 뭐야?! 갑자기?」"},
{"id": "clse07:908500", "ko": "「갑자기 큰 소리로 부르니까 깜짝 놀랐잖아」"},
{"id": "clse07:908600", "ko": "「그래서, 뭔데?」"},
{"id": "clse07:908700", "ko": "「네에~」"},
{"id": "clse07:908800", "ko": "「유가 마술을?」"},
{"id": "clse07:908900", "ko": "「나? 뭐 괜찮은데……」"},
{"id": "clse07:909000", "ko": "「어…… 여기 들어가면 돼?」"},
{"id": "clse07:909100", "ko": "「꺄아아아아아아아아아아아아아!!!」"},
{"id": "clse07:909200", "ko": "「갸아아아아아아아아아아아아앗!!!」"},
{"id": "clse07:909300", "ko": "「뭐, 뭐야?! 갑자기?」"},
{"id": "clse07:909400", "ko": "「갑자기 큰 소리로 부르니까 깜짝 놀랐잖아」"}
]
