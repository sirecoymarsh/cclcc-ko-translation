[
{"id": "clse07:107900", "ko": "「내 몫이다아아아아아아앗!!」"},
{"id": "clse07:108000", "ko": "「우와, 더러워!」"},
{"id": "clse07:108100", "ko": "「그, 그럼, 가 볼까요!」"},
{"id": "clse07:108200", "ko": "「엥?」"},
{"id": "clse07:108300", "ko": "「바보! 하나! ⟦rb⟧그거⟦rt⟧⟦rbc⟧●●⟦/r⟧는 건드리면 안 된다고 했잖아!」"},
{"id": "clse07:108400", "ko": "「으아아아, 안 돼~! 절대로 안 떠올리려고 했는데에에! 신이시여, 기억을 지워 주세요~!」"},
{"id": "clse07:108500", "ko": "「하아~!? 쑥스러워하는 거 아니거든요~!? 나는 어른이니까! ⟦rb⟧그런 거⟦rt⟧⟦rbc⟧●●●⟦/r⟧ 별거 아니고~!」"},
{"id": "clse07:108600", "ko": "「그러니까 그런 야한 말투는 그만두라고~!」"},
{"id": "clse07:108700", "ko": "「그렇죠! 그런 고로, 다들 알았지!? 알았어!?」"},
{"id": "clse07:108800", "ko": "「네?」"},
{"id": "clse07:108900", "ko": "「그렇구나…… 그럼 실례해 볼까나~, 에헤헤」"},
{"id": "clse07:109000", "ko": "「에에~!? 왜~!?」"},
{"id": "clse07:109100", "ko": "「아무도 달라붙지 않거든!」"},
{"id": "clse07:109200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:109300", "ko": "「어라~, 무슨 일 있슴까, 선배!?」"},
{"id": "clse07:109400", "ko": "「아, 있다 있다. 세리~」"},
{"id": "clse07:109500", "ko": "「어때? 이제 얘기 끝났어?」"},
{"id": "clse07:109600", "ko": "「뭐~? 아직 얘기 안 했다고? 어쩔 수 없네~」"},
{"id": "clse07:109700", "ko": "「오, 역시 선배. 눈치가 빠르시네. 그런 고로 둘 좀 빌려 갈게요~」"},
{"id": "clse07:109800", "ko": "「아, 괜찮으면 선배도 같이 갈래요? 가게 안이 여자들뿐이지만」"},
{"id": "clse07:109900", "ko": "「어머, 아쉽네」"},
{"id": "clse07:110000", "ko": "「그보다 자, 빨리 안 가면 엄청 줄 서게 된다니까. 이 시간이 제일 사람 많으니까」"},
{"id": "clse07:110100", "ko": "「아이고~ 봉변이었네요」"},
{"id": "clse07:110200", "ko": "「어이, 그대들. 이제 슬슬 추가 주문을 해도 벌받지 않을 때다?」"},
{"id": "clse07:110300", "ko": "「음, 알았다. 천천히 있다 가거라」"},
{"id": "clse07:110400", "ko": "「잘 왔다. 뭐, 천천히 있다 가거라」"},
{"id": "clse07:110500", "ko": "「손님이 아닌 자는 이제 오지 마라」"},
{"id": "clse07:110600", "ko": "「오오, 그대인가. 잘 왔다! 일행이라면 늘 앉는 자리에 먼저――」"},
{"id": "clse07:110700", "ko": "「응?」"},
{"id": "clse07:110800", "ko": "「읍읍읍!?」"},
{"id": "clse07:110900", "ko": "「뭐, 뭐, 뭐냐!?」"},
{"id": "clse07:111000", "ko": "「오오, 타쿠~, 이 몸이 지금 돌아왔느니라」"},
{"id": "clse07:111100", "ko": "「오~? 그랬던가? 뭐 됐다. 그보다 자, 그거, 또 구해 와 주었느니라」"},
{"id": "clse07:111200", "ko": "「우홋. 오늘은 하루 벌이가 없나 했는데, 여기 와서 역전 홈런이로구먼」"},
{"id": "clse07:111300", "ko": "「좋아, 오늘은 한잔하겠다~. 타쿠도 어떠냐?」"},
{"id": "clse07:111400", "ko": "「그거 아쉽구먼」"},
{"id": "clse07:111500", "ko": "「이 몸이 지금 돌아왔느니라, 타쿠」"},
{"id": "clse07:111600", "ko": "「타쿠가 동료가 되어 주어서 이 몸도 기쁘구먼」"},
{"id": "clse07:111700", "ko": "「자, 이 몸의 동료가 된 증표로 이 몸의 가장 소중한 것을 내리겠노라. 명심하고 받거라」"},
{"id": "clse07:111800", "ko": "「오오! 오늘도 기운이 넘쳐 보이는구먼, 그대들. 하하하하」"},
{"id": "clse07:111900", "ko": "「오오, 매정한 소리를 하는 녀석이로구먼. 모처럼 훌륭한 보물을 가져와 주었건만」"},
{"id": "clse07:112000", "ko": "「음. 실은 말이다――!」"},
{"id": "clse07:112100", "ko": "「무, 무, 무슨 소리를 하는 게냐!? 이 몸은 그런 쩨쩨한 생각 따위 털끝만큼도 하지 않았느니라」"},
{"id": "clse07:112200", "ko": "「아, 아니, 그런……!」"},
{"id": "clse07:112300", "ko": "「오~, 타쿠. 자, 그거 또 손에 들어왔느니라」"},
{"id": "clse07:112400", "ko": "「오오, 타쿠~」"},
{"id": "clse07:112500", "ko": "「좁은 일본, 그렇게 서둘러 어디로 가느냐? 서둘러 봤자 세상은 그리 바뀌지 않는다~」"},
{"id": "clse07:112600", "ko": "「여동생? 혹시 전에 여기 왔던 중학생쯤 되는 애 말이냐? 그렇다면 조금 전에 봤느니라?」"},
{"id": "clse07:112700", "ko": "「응? 아~…… 그건 분명…… 어디였더라」"},
{"id": "clse07:112800", "ko": "「어른 남자랑 둘이서 걷고 있었지. 어디였더라?」"},
{"id": "clse07:112900", "ko": "「아니, 더 젊었던가. 어디였더라……」"},
{"id": "clse07:113000", "ko": "「…………」"},
{"id": "clse07:113100", "ko": "「…………」"},
{"id": "clse07:113200", "ko": "「……너…… 죽어……」"},
{"id": "clse07:113300", "ko": "「놓치지는…… 않아……」"},
{"id": "clse07:113400", "ko": "「……흑. 흑…… 흐흑…… 훌쩍」"},
{"id": "clse07:113500", "ko": "「흐으윽, 훌쩍, 으에에……」"},
{"id": "clse07:113600", "ko": "「흐윽, 괜찮아요. 저 같은 건 내버려 두세요. 으아앙……」"},
{"id": "clse07:113700", "ko": "「흑, 훌쩍…… 그치만, 그치만……」"},
{"id": "clse07:113800", "ko": "「역시 리얼충은 폭발해라~!」"},
{"id": "clse07:113900", "ko": "「흐윽, 죄송해요! 그래도 행복해 보이는 커플을 보면 저도 모르게 멈출 수가 없어요오!」"},
{"id": "clse07:114000", "ko": "「정말?」"},
{"id": "clse07:114100", "ko": "「그래……」"},
{"id": "clse07:114200", "ko": "「저기, 여러분. 너무하다고 생각하지 않아요? 매일매일 정성을 담아 쓴 편지인데……」"},
{"id": "clse07:114300", "ko": "「흐윽, 죄송해요……」"},
{"id": "clse07:114400", "ko": "「네, 여기는 『밤비나 밤비노』 고객 상담 센터입니다」"},
{"id": "clse07:114500", "ko": "「그거 정말 죄송합니다. 구입하셨을 때의 영수증이나 계산서는 가지고 계신가요?」"},
{"id": "clse07:114600", "ko": "「그럼 번거로우시겠지만 그것과 함께 착불로 저희 회사까지 보내 주시겠습니까」"},
{"id": "clse07:114700", "ko": "「잘 부탁드립니다. 담당 하이다가 접수했습니다」"},
{"id": "clse07:114800", "ko": "「쉿! 지금 카즈키한테 말 걸지 마. 이 녀석 파티는 다곤의 왕이랑 교전 중이야. 게다가 전멸 직전! 바람 앞의 등불!」"},
{"id": "clse07:114900", "ko": "「나한테 화내지 마. 애초에 자업자득이잖아? 그러니까 그렇게 충고했잖아. 아직 장비가 부족하다고!」"},
{"id": "clse07:115000", "ko": "「아~ 알았어 알았어. 쓸데없는 참견은 안 한다니까」"},
{"id": "clse07:115100", "ko": "「아~ 죽었다. 역시 죽었네」"},
{"id": "clse07:115200", "ko": "「그보다 카즈키? 그 층 보스라면 먼저 북쪽 던전에 가서 ⟦rb⟧수룡 살해의 검⟦rt⟧아쿠아그램⟦/r⟧을 손에 넣지 않으면 못 쓰러뜨린다?」"},
{"id": "clse07:115300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:115400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:115500", "ko": "「윽?」"},
{"id": "clse07:115600", "ko": "「아, 아, 알고 있습니다, 부부장님!」"},
{"id": "clse07:115700", "ko": "「호오~」"},
{"id": "clse07:115800", "ko": "「아니~ 약속대로의 반응이라 그만」"},
{"id": "clse07:115900", "ko": "「그런 말을 하려면 “전통 예능”이지, 오노에」"},
{"id": "clse07:116000", "ko": "「바보, 눈치 좀 채라, 미야시로」"},
{"id": "clse07:116100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:116200", "ko": "「윽!?」"},
{"id": "clse07:116300", "ko": "「안 했어」"},
{"id": "clse07:116400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:116500", "ko": "「………」"},
{"id": "clse07:116600", "ko": "「어느 사건이든 시시하네!」"},
{"id": "clse07:116700", "ko": "「야, 미야시로? 이럴 거면 『시부야의 새로운 숨은 명소』라든가 『앞으로 유행할 패션』이라든가, 그런 특집이 더 먹히지 않겠어?」"},
{"id": "clse07:116800", "ko": "「오노에 같은 애한테 메인 기사를 써 달라고 해서 말이야」"},
{"id": "clse07:116900", "ko": "「정말이야. 이것저것 취재도 하고 꽤 힘들다고」"},
{"id": "clse07:117000", "ko": "「뭐어?」"},
{"id": "clse07:117100", "ko": "「왜 그래, 미야시로? 그보다 아까부터 이쪽을 힐끔힐끔 보는 것 같은데…… 특종은 포기하고 역시 이쪽 기획을 할 거냐? 재밌다고~?」"},
{"id": "clse07:117200", "ko": "「마지막 거? YES-NO 심리 테스트?」"},
{"id": "clse07:117300", "ko": "「아니~ 소재 생각하느라 꽤 힘들었다고」"},
{"id": "clse07:117400", "ko": "「포기해, 미야시로. 네 이미지는 지금 바닥까지 떨어졌어」"},
{"id": "clse07:117500", "ko": "「응~ 절친? 그게 뭔데, 맛있는 거냐?」"},
{"id": "clse07:117600", "ko": "「그보다 좀, 우리가 만든 심리 테스트 해 봐 주지 않을래? 학교 신문 장난 코너라지만 엉터리면 곤란하니까」"},
{"id": "clse07:117700", "ko": "「역시 너는 이쪽이냐~」"}
]
