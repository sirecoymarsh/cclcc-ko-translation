[
{"id": "clka05:0", "ko": "「실례합니다……」"},
{"id": "clka05:100", "ko": "체육 창고 안은 캄캄해서 잘 보이지 않았다."},
{"id": "clka05:200", "ko": "밖에 있으면 눈에 띄니까 일단 안으로 들어가 버리자."},
{"id": "clka05:300", "ko": "「카즈키…… 있는 거야……?」"},
{"id": "clka05:400", "ko": "「힉!」"},
{"id": "clka05:500", "ko": "문이 저절로 닫힌 모양이다."},
{"id": "clka05:600", "ko": "「……진정해. 딱히 갇힌 것도 아니야」"},
{"id": "clka05:700", "ko": "서서히 눈이 익숙해지면서 창고 안에 어지럽게 쌓인 물건들이 보이기 시작했다."},
{"id": "clka05:800", "ko": "「우와, 땀 냄새……」"},
{"id": "clka05:900", "ko": "운동장 구석에 있는 체육 창고는 말 그대로 체육에 쓰는 비품 창고였다."},
{"id": "clka05:1000", "ko": "그렇다고 해도 들어 있는 건 줄다리기 줄이라든가 큰 공이라든가, 체육대회 같은 특별한 행사에서밖에 본 적 없는 도구뿐."},
{"id": "clka05:1100", "ko": "운동부가 쓰는 비품은 각 동아리가 보관하고 있으니 여기를 찾는 사람은 거의 없다."},
{"id": "clka05:1200", "ko": "나는 일부러 사무실에서 열쇠를 빌려 왔다."},
{"id": "clka05:1300", "ko": "그 메일에 따라서."},
{"id": "clka05:1400", "ko": "「타쿠루, 왜 그래?」"},
{"id": "clka05:1500", "ko": "「누구한테서 온 메일임까? 혹시 고백이라든가!? 제법인데요, 요 요!」"},
{"id": "clka05:1600", "ko": "「아, 아니, 잘못 걸려 온 전화 아닐까? 금방 끊긴 것 같아」"},
{"id": "clka05:1700", "ko": "「……흐응? 뭐, 상관없지만요」"},
{"id": "clka05:1800", "ko": "「그, 그렇지」"},
{"id": "clka05:1900", "ko": "「잠깐 카즈키를 찾으러 갔다 올게. 자세한 얘기를 듣고 싶고」"},
{"id": "clka05:2000", "ko": "「아, 그럼 나도――」"},
{"id": "clka05:2100", "ko": "「아아아아니, 나, 나 혼자 갈 테니까! 다다다들 여기서 기다려 줘!」"},
{"id": "clka05:2200", "ko": "「대놓고 목소리가 뒤집혔는데. 무슨 일 있냐?」"},
{"id": "clka05:2300", "ko": "「아무것도 아니야! 아무것도 아니니까! 알았지!? 따라오지 마!?」"},
{"id": "clka05:2400", "ko": "「잠깐, 타쿠루!」"},
{"id": "clka05:2500", "ko": "「괜찮아. 태연한 척했으니까 다들 수상하게 여기지는 않았을 거야」"},
{"id": "clka05:2600", "ko": "아까는 스스로도 내 연기력에 놀랄 정도였다."},
{"id": "clka05:2700", "ko": "배우를 목표로 하는 것도 방법일지도 모른다."},
{"id": "clka05:2800", "ko": "「그럼……」"},
{"id": "clka05:2900", "ko": "다시 한번 스마트폰에 온 메일을 확인한다."},
{"id": "clka05:3000", "ko": "「이런 데로 불러내서 무슨 볼일이지?」"},
{"id": "clka05:3100", "ko": "카즈키가 일부러 단둘이 되어서 할 필요가 있는 이야기."},
{"id": "clka05:3200", "ko": "……"},
{"id": "clka05:3300", "ko": "…………"},
{"id": "clka05:3400", "ko": "………………"},
{"id": "clka05:3500", "ko": "흠. 전혀 짐작이 안 간다."},
{"id": "clka05:3600", "ko": "「……아니, 잠깐?」"},
{"id": "clka05:3700", "ko": "「혹시……!」"},
{"id": "clka05:3800", "ko": "「설마!」"},
{"id": "clka05:3900", "ko": "「여기 찍혀 있는 이 여자애가――!」"},
{"id": "clka05:4000", "ko": "「――카즈키의 친구라든가?」"},
{"id": "clka05:4100", "ko": "있을 수 있겠네."},
{"id": "clka05:4200", "ko": "이 여자애는 신문부원 중 누군가일 가능성이 높다."},
{"id": "clka05:4300", "ko": "그리고 카즈키의 친구는 곧 신문부원 중 누군가."},
{"id": "clka05:4400", "ko": "완벽한 방정식이다!"},
{"id": "clka05:4500", "ko": "「아니 그래도, 그거라면 부실에서 가르쳐 줘도 되잖아」"},
{"id": "clka05:4600", "ko": "「뭐, 이 사진을 남들 앞에 꺼낼 수 없는 건 확실하니까, 카즈키가 그걸 배려했을지도 몰라」"},
{"id": "clka05:4700", "ko": "「어쨌든 본인한테 물어보면 확실해지겠지」"},
{"id": "clka05:4800", "ko": "「그런데 늦네――」"},
{"id": "clka05:4900", "ko": "그때,"},
{"id": "clka05:5000", "ko": "갑자기 뜀틀 그늘에서 누군가가 나타나 나에게 덤벼들었다!"},
{"id": "clka05:5100", "ko": "「뭐뭐뭐뭐뭐엇!?」"},
{"id": "clka05:5200", "ko": "갑자기 나타난 누군가는 내 두 어깨를 붙잡고 그대로 바닥에 밀어 넘어뜨렸다."},
{"id": "clka05:5300", "ko": "「크악!?」"},
{"id": "clka05:5400", "ko": "상대는 그대로 내 몸 위를 덮었다."},
{"id": "clka05:5500", "ko": "갑작스러운 일에 혼란에 빠진 나는, 솔직히 완전 겁먹으면서도 나를 짓누른 상대를 올려다본다."},
{"id": "clka05:5600", "ko": "그러자――"},
{"id": "clka05:5700", "ko": "「카, 카즈키!?」"},
{"id": "clka05:5800", "ko": "「……」"},
{"id": "clka05:5900", "ko": "카즈키는 내 허리 언저리에 올라타서 두 어깨를 꽉 누르고 있었다."},
{"id": "clka05:6000", "ko": "「……」"},
{"id": "clka05:6100", "ko": "평소의 무표정으로 가만히 나를 내려다보고 있다."},
{"id": "clka05:6200", "ko": "「카, 카즈키? 이, 일단 좀 비켜 줄래?」"},
{"id": "clka05:6300", "ko": "몸을 비틀어 빠져나가려 했지만, 의외로 힘센 카즈키의 손이 꽉 붙잡고 있어서 잘 빠져나갈 수가 없다."},
{"id": "clka05:6400", "ko": "「……」"},
{"id": "clka05:6500", "ko": "이건 대체 어떤 상황이지?"},
{"id": "clka05:6600", "ko": "무슨 일이 일어나고 있는 거야?"},
{"id": "clka05:6700", "ko": "대체 카즈키는 뭘 하려는 거지?"},
{"id": "clka05:6800", "ko": "「카, 카즈키, 네 목적은 뭐야――」"},
{"id": "clka05:6900", "ko": "「……」"},
{"id": "clka05:7000", "ko": "카즈키는 뭔가 결의를 품은 눈으로 나를 내려다보고 있었다."},
{"id": "clka05:7100", "ko": "「카즈키……?」"},
{"id": "clka05:7200", "ko": "「……타」"},
{"id": "clka05:7300", "ko": "일자로 꾹 다물고 있던 카즈키의 입술이 작게 열렸다."},
{"id": "clka05:7400", "ko": "「……타쿠루」"},
{"id": "clka05:7500", "ko": "「……타쿠루, 선배」"},
{"id": "clka05:7600", "ko": "「카, 카즈키!?」"},
{"id": "clka05:7700", "ko": "「대체 왜 그래!?」"},
{"id": "clka05:7800", "ko": "「……」"},
{"id": "clka05:7900", "ko": "「……어머?」"},
{"id": "clka05:8000", "ko": "「놀랍네」"},
{"id": "clka05:8100", "ko": "「어?」"},
{"id": "clka05:8200", "ko": "카즈키는 지금까지 들어 본 적 없는, 어른스럽다고 할까, 요염한 말투로 중얼거렸다."},
{"id": "clka05:8300", "ko": "「아기 양이 언제부터 내 허락도 없이 입을 열게 된 걸까?」"},
{"id": "clka05:8400", "ko": "「아기…… 양?」"},
{"id": "clka05:8500", "ko": "나는 다시 카즈키의 모습을 훑어보았다."},
{"id": "clka05:8600", "ko": "놀랍게도 카즈키의 옷차림이 어느새 교복에서 위아래 모두 광택 나는 검은 옷으로 바뀌어 있었다."},
{"id": "clka05:8700", "ko": "아래는 검은 비닐로 된 짧은 반바지를 입고 있다."},
{"id": "clka05:8800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:8900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:9000", "ko": "무릎 아래까지 오는 가죽 부츠는 정말 걸을 수 있나 싶을 만큼 굽이 높다."},
{"id": "clka05:9100", "ko": "위에 입은 건 비키니 톱처럼 보이는데, 이것도 검은 비닐."},
{"id": "clka05:9200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:9300", "ko": "그리고 무엇보다."},
{"id": "clka05:9400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:9500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:9600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:9700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:9800", "ko": "건강한 남자라면 거기에 눈길을 빼앗기지 않는 건 불가능할 것이다."},
{"id": "clka05:9900", "ko": "하지만 나는 거기에 주목할 수 없었다."}
]
