[
{"id": "clka10:20000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:20900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:21000", "ko": "「에?」"},
{"id": "clka10:21100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:21200", "ko": "「뭐, 뭘」"},
{"id": "clka10:21300", "ko": "「후훗」"},
{"id": "clka10:21400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:21500", "ko": "「뭐!?」"},
{"id": "clka10:21600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:21700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:21800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:21900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22200", "ko": "「주, 준비? 뭐…… 무슨?」"},
{"id": "clka10:22300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22600", "ko": "「뭐!?」"},
{"id": "clka10:22700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:22900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23100", "ko": "「뭐, 뭐가?」"},
{"id": "clka10:23200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:23900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:24000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:24100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:24200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:24300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:24400", "ko": "……무슨 바보 같은 생각을 하는 거야, 나는."},
{"id": "clka10:24500", "ko": "지금까지의 경위로 보아, 『하나』는 그냥 나를 놀리고 싶은 것뿐이고 선을 넘을 생각은 없다는 걸 알고 있다."},
{"id": "clka10:24600", "ko": "게다가 『하나』는 카즈키의 뜻을 존중하는 것처럼도 보인다."},
{"id": "clka10:24700", "ko": "그러니까 내가 이성을 지키는 한, 그런 전개는 되지 않을 것이다."},
{"id": "clka10:24800", "ko": "진정해. 나."},
{"id": "clka10:24900", "ko": "「……라는 건 거짓말」"},
{"id": "clka10:25000", "ko": "「……뭐?」"},
{"id": "clka10:25100", "ko": "「하나가 부끄러워서 선배한테 먼저 샤워하게 했잖아」"},
{"id": "clka10:25200", "ko": "「그런데 역시 몸이 완전히 식어서 한계였나 봐」"},
{"id": "clka10:25300", "ko": "「……재채기를 꽤 했었지」"},
{"id": "clka10:25400", "ko": "「응응응. 그래서 더는 못 참겠다고, 어떡하냐고 ⟦rb⟧나⟦rt⟧⟦rbc⟧●⟦/r⟧한테 상담해 왔거든」"},
{"id": "clka10:25500", "ko": "「너한테?」"},
{"id": "clka10:25600", "ko": "그런 것도 가능한가."},
{"id": "clka10:25700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:25800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:25900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:26000", "ko": "「거, 거절해!」"},
{"id": "clka10:26100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:26200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:26300", "ko": "「네가 신경 안 써도 내가 신경 쓰이잖아!?」"},
{"id": "clka10:26400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:26500", "ko": "「아무렇지 않게 엄청난 말을 했네, 방금!?」"},
{"id": "clka10:26600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:26700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:26800", "ko": "「바, 바보, 그만해!」"},
{"id": "clka10:26900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:27000", "ko": "「에〜 그럼 말이야, 이런 건 어때?」"},
{"id": "clka10:27100", "ko": "「어떻냐니?」"},
{"id": "clka10:27200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:27300", "ko": "「뭐!?」"},
{"id": "clka10:27400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:27500", "ko": "그동안에도 『하나』는 계속 내 팔을 잡아당기고 있었다."},
{"id": "clka10:27600", "ko": "그 결과 내 몸에 절묘한 운동 에너지가 더해져서, 두 발이 바닥 타일에서 미끄덩 미끄러졌다."},
{"id": "clka10:27700", "ko": "「어?」"},
{"id": "clka10:27800", "ko": "「어?」"},
{"id": "clka10:27900", "ko": "순식간에 풍경이 한 바퀴 돌고――"},
{"id": "clka10:28000", "ko": "――나는 머리부터 바닥에 부딪혔다."},
{"id": "clka10:28100", "ko": "「아각!!」"},
{"id": "clka10:28200", "ko": "「말도 안 돼!」"},
{"id": "clka10:28300", "ko": "「잠깐 선배! 괜찮아!?」"},
{"id": "clka10:28400", "ko": "걱정스럽게 소리치는 『하나』에게 대답도 하지 못한 채, 내 의식은 급속히 흐려져 갔다."},
{"id": "clka10:28500", "ko": "「일어나! 저기, 일어나라니까!」"},
{"id": "clka10:28600", "ko": "아아."},
{"id": "clka10:28700", "ko": "「선배!」"},
{"id": "clka10:28800", "ko": "오늘은 넘어지기만 하네……"},
{"id": "clka10:28900", "ko": "「……이제, 그만두고 싶어…… 일지도」"},
{"id": "clka10:29000", "ko": "「왜?」"},
{"id": "clka10:29100", "ko": "「으음……!」"},
{"id": "clka10:29200", "ko": "「……으음……」"},
{"id": "clka10:29300", "ko": "누군가의 목소리가 들린 것 같아서 희미하게 눈을 뜬다."},
{"id": "clka10:29400", "ko": "머릿속에 안개가 낀 것 같아서, 내가 지금 어디 있는지 한순간 알 수 없었다."},
{"id": "clka10:29500", "ko": "「……아얏」"},
{"id": "clka10:29600", "ko": "뒤통수에 작은 통증이 지나갔고, 덕분에 머릿속 안개가 걷혔다."},
{"id": "clka10:29700", "ko": "（욕실에서 머리를 부딪쳐서 기절했던 건가. 한심한 얘기네……）"},
{"id": "clka10:29800", "ko": "아무래도 침대에 누워 있는 모양이다. 아직 뒤통수가 조금 아프지만 그 밖에는 멀쩡하다."},
{"id": "clka10:29900", "ko": "（영차……）"}
]
