[
{"id": "clse07:714400", "ko": "「그래, 『밀푀유』 채널이다」"},
{"id": "clse07:714500", "ko": "「그래……」"},
{"id": "clse07:714600", "ko": "「알려 주면 둘 다 의식해 버리잖아」"},
{"id": "clse07:714700", "ko": "「거짓말 아니야. 이만큼이나 많은 사람들이 두 사람을 응원해 주고 있어」"},
{"id": "clse07:714800", "ko": "「응?」"},
{"id": "clse07:714900", "ko": "「우왓! 야, 껴안지 말라니까……」"},
{"id": "clse07:715000", "ko": "「야, 야, 그만하라니까!」"},
{"id": "clse07:715100", "ko": "「벼, 별로 쑥스러워하는 건……」"},
{"id": "clse07:715200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:715300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:715400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:715500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:715600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:715700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:715800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:715900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:716000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:716100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:716200", "ko": "「…………」"},
{"id": "clse07:716300", "ko": "「아, 아니…… 딱히, 아무것도…… 아니야……」"},
{"id": "clse07:716400", "ko": "「쿠…… 쿠루스…… 아니야, 이건――」"},
{"id": "clse07:716500", "ko": "「기, 기다려, 노노…… 성급하게 굴지 마! 얘기하면 알 거야!!」"},
{"id": "clse07:716600", "ko": "「야, 야, 유이…… 적당히 하라니까」"},
{"id": "clse07:716700", "ko": "「두, 둘 다, 좀 진정하고……」"},
{"id": "clse07:716800", "ko": "「윽……」"},
{"id": "clse07:716900", "ko": "「엥……?」"},
{"id": "clse07:717000", "ko": "「어? 잠깐. 농담이지? 그치? 질 나쁜 농담이지?」"},
{"id": "clse07:717100", "ko": "「힉――!!」"},
{"id": "clse07:717200", "ko": "「…………」"},
{"id": "clse07:717300", "ko": "「아, 아아. 좀 피곤할 뿐이야. 괜찮아」"},
{"id": "clse07:717400", "ko": "「후훗」"},
{"id": "clse07:717500", "ko": "「…………」"},
{"id": "clse07:717600", "ko": "「（역시 슬슬 새로운 전개를 보여 줘야 할지도 모르겠군……）」"},
{"id": "clse07:717700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:717800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:717900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:718000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:718100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:718200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:718300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:718400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:718500", "ko": "「어……? 거짓말…… 이지?」"},
{"id": "clse07:718600", "ko": "「뭐야…… 이토, 너, 보고 있었냐……」"},
{"id": "clse07:718700", "ko": "「랭킹……?」"},
{"id": "clse07:718800", "ko": "「아, 아니…… 물론 알고 있었던 게 당연하잖아」"},
{"id": "clse07:718900", "ko": "「뭐, 뭐 그렇지! 나한테 걸리면 이 정도는 간단해」"},
{"id": "clse07:719000", "ko": "「쿠, 쿠노사토 씨…… 뭐예요, 느닷없이」"},
{"id": "clse07:719100", "ko": "「그거라니요?」"},
{"id": "clse07:719200", "ko": "「뭐――」"},
{"id": "clse07:719300", "ko": "「아니, 그건 유이의 꿈을 이뤄 주기 위해서고, 유토도 납득해 줬고……」"},
{"id": "clse07:719400", "ko": "「네, 네……」"},
{"id": "clse07:719500", "ko": "「네?」"},
{"id": "clse07:719600", "ko": "「…………뭐, 뭐였지, 방금 그건?」"},
{"id": "clse07:719700", "ko": "「응……?」"},
{"id": "clse07:719800", "ko": "「음…… 뭐, 괜찮지 않아?」"},
{"id": "clse07:719900", "ko": "「――!!」"},
{"id": "clse07:720000", "ko": "「뭐야, 아리무라냐. 놀래키지 마」"},
{"id": "clse07:720100", "ko": "「바보야, 큰 소리 내지 마. 그런 거 아니라니까」"},
{"id": "clse07:720200", "ko": "「유이랑 유토가 둘이서 니야생을 시작했거든. 그걸 보고 있었어」"},
{"id": "clse07:720300", "ko": "「그보다 아리무라. 뭐가 문제라는 거야?」"},
{"id": "clse07:720400", "ko": "「뭐? 무슨 소리야?」"},
{"id": "clse07:720500", "ko": "「조, 종이? 종이라니 그 종이!? 왜?」"},
{"id": "clse07:720600", "ko": "「가슴 펴고 있을 때냐!」"},
{"id": "clse07:720700", "ko": "「바보야, 좋아할 때냐!」"},
{"id": "clse07:720800", "ko": "「어?」"},
{"id": "clse07:720900", "ko": "「뭐, 그렇지……」"},
{"id": "clse07:721000", "ko": "「앞으로 조심할 것. 알았지?」"},
{"id": "clse07:721100", "ko": "「글쎄. 일단 일주일은 활동을 자제하게 될 거야. 그 결과 지금까지 봐 주던 사람들이 떠나 버릴지도 모르지만, 그건 어쩔 수 없다고 생각할 수밖에 없어」"},
{"id": "clse07:721200", "ko": "「어떻게 된 거야…… 이거……?」"},
{"id": "clse07:721300", "ko": "「……아마 BAN당한 걸로 더 화제가 됐다는 거 아닐까 싶어」"},
{"id": "clse07:721400", "ko": "「문제는 앞으로의 활동을 어떻게 하느냐, 로군……」"},
{"id": "clse07:721500", "ko": "「…………」"},
{"id": "clse07:721600", "ko": "「아니. 유이는 왜 그렇게 생각해?」"},
{"id": "clse07:721700", "ko": "「…………」"},
{"id": "clse07:721800", "ko": "「아니…… 나도 그 말이 맞다고 생각해……」"},
{"id": "clse07:721900", "ko": "「그래……」"},
{"id": "clse07:722000", "ko": "「솔직히 감탄했어. 유이도 제대로 이것저것 생각하고 있구나. 감탄했다」"},
{"id": "clse07:722100", "ko": "「…………」"},
{"id": "clse07:722200", "ko": "「뭐야. 오노에치고는 웬일로 정보가 빠르네」"},
{"id": "clse07:722300", "ko": "「헤에……」"},
{"id": "clse07:722400", "ko": "「어떻게 할지 고민 중이야. 이벤트라고 해도 아직 자기들 곡이 있는 것도 아니고, 게다가……」"},
{"id": "clse07:722500", "ko": "「……어?」"},
{"id": "clse07:722600", "ko": "「……메이저 데뷔……」"},
{"id": "clse07:722700", "ko": "「두, 두 사람한테 CD 내지 않겠냐고!! 게다가 텔레비전 출연 의뢰도!」"},
{"id": "clse07:722800", "ko": "「대단한 게 당연하잖아! 메이저 데뷔라고? 전국 가게에 CD가 깔린다고?」"},
{"id": "clse07:722900", "ko": "「응……?」"},
{"id": "clse07:723000", "ko": "「아무래도 두 사람이 방송을 시작한 것 같아」"},
{"id": "clse07:723100", "ko": "「둘 다 슬슬 익숙해졌으니까 괜찮아」"},
{"id": "clse07:723200", "ko": "「그보다 나는 프로듀서로서 앞으로의 활동 방침을 정해야 하니까」"},
{"id": "clse07:723300", "ko": "「그런 이유로 동아리 쪽은 모두한테 맡길게! 나머지는 잘 부탁해!」"},
{"id": "clse07:723400", "ko": "「후우……」"},
{"id": "clse07:723500", "ko": "「그러고 보니 밤에는 날씨가 꽤 험해진다고 텔레비전에서 그러더라」"},
{"id": "clse07:723600", "ko": "「아침에는 그친다고 했으니까 괜찮지 않을까?」"},
{"id": "clse07:723700", "ko": "「뭐, 뭐어, 오빠로서 당연한 일이야……」"},
{"id": "clse07:723800", "ko": "「그건 그렇고, 많이도 오네……」"},
{"id": "clse07:723900", "ko": "「……?」"},
{"id": "clse07:724000", "ko": "「…………」"},
{"id": "clse07:724100", "ko": "「아, 아니……」"},
{"id": "clse07:724200", "ko": "「그, 그래……」"},
{"id": "clse07:724300", "ko": "「（진정하세요, 타쿠루. 그 아이는 여동생이잖아요）」"}
]
