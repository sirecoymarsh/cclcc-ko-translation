[
{"id": "clse07:59800", "ko": "「아이고 참」"},
{"id": "clse07:59900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:60900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:61000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:61100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:61200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:61300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:61400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:61500", "ko": "「네?」"},
{"id": "clse07:61600", "ko": "「……무슨 볼일임까?」"},
{"id": "clse07:61700", "ko": "「뭐요? 딱히 실실 웃고 있지 않았거든요」"},
{"id": "clse07:61800", "ko": "「…………」"},
{"id": "clse07:61900", "ko": "「실실…… 웃고 있었어? 내가……?」"},
{"id": "clse07:62000", "ko": "「어라? 나…… 거짓말…… 이지?」"},
{"id": "clse07:62100", "ko": "「재미없는 농담」"},
{"id": "clse07:62200", "ko": "「왜 온 거야?」"},
{"id": "clse07:62300", "ko": "「……거짓말만 하고」"},
{"id": "clse07:62400", "ko": "「…………」"},
{"id": "clse07:62500", "ko": "「아아아아앗!」"},
{"id": "clse07:62600", "ko": "「그, 그러고 보니 엄마. 나 없는 동안 내 방에 멋대로 들어가지 않았지?」"},
{"id": "clse07:62700", "ko": "「아무리 가족이라도 남의 프라이버시를 침해하지 마?」"},
{"id": "clse07:62800", "ko": "「엄마! 엄마야말로 요즘은 집에 들어오는 거지!?」"},
{"id": "clse07:62900", "ko": "「그, 그래……」"},
{"id": "clse07:63000", "ko": "「맞다! 있잖아, 저번에――」"},
{"id": "clse07:63100", "ko": "「…………」"},
{"id": "clse07:63200", "ko": "「됐어요…… 이제……」"},
{"id": "clse07:63300", "ko": "「보란 듯이 굴어서 미안해, 엄마. 나, 돌아갈게……」"},
{"id": "clse07:63400", "ko": "「됐잖아. 내가 돌아간다고 하는데」"},
{"id": "clse07:63500", "ko": "「――읏」"},
{"id": "clse07:63600", "ko": "「그만해!!!」"},
{"id": "clse07:63700", "ko": "「폐를 끼친 건 알아…… 그러니까 말하지 마……」"},
{"id": "clse07:63800", "ko": "「소리 내서…… 말하지 마……」"},
{"id": "clse07:63900", "ko": "「엄마…… 선배는 처음부터 상관없으니까…… 내가 멋대로 쳐들어가서 억지로 얹혀살았던 것뿐이니까……」"},
{"id": "clse07:64000", "ko": "「선배도, 폐 끼쳐서 죄송해요……」"},
{"id": "clse07:64100", "ko": "『폐를 끼친 건 알아…… 그러니까 말하지 마……』"},
{"id": "clse07:64200", "ko": "『소리 내서…… 말하지 마……』"},
{"id": "clse07:64300", "ko": "「앗!!」"},
{"id": "clse07:64400", "ko": "「――읏!!」"},
{"id": "clse07:64500", "ko": "「어……!?」"},
{"id": "clse07:64600", "ko": "「미야시로 선배……」"},
{"id": "clse07:64700", "ko": "「그치만……」"},
{"id": "clse07:64800", "ko": "「싫어, 듣고 싶지 않아!」"},
{"id": "clse07:64900", "ko": "「선배…… 나 말이야, 옛날부터 계속 진실을 알고 싶었어……」"},
{"id": "clse07:65000", "ko": "「우리 집은 아빠도 엄마도 거짓말만 해. 입으로는 사랑한다고 하면서, 자기들은 밖에서 멋대로 하고……」"},
{"id": "clse07:65100", "ko": "「그래서 나는 계속 진실을 알고 싶다고 생각했어. 말 깊숙이 숨겨진 진짜 마음을……」"},
{"id": "clse07:65200", "ko": "「그러니까 이 능력은 내가 바란 능력이야. 이 능력만 있으면 나는 행복해질 수 있을 터였어……」"},
{"id": "clse07:65300", "ko": "「그런데 말이야…… 그런데 현실은 완전히 반대였어. 진실 같은 걸 알아도 행복한 일은 아무것도 없었어……」"},
{"id": "clse07:65400", "ko": "「이 세상에 거짓말 안 하는 사람 같은 건 없어. 누구나 다 거짓말을 하면서 살고 있었어……」"},
{"id": "clse07:65500", "ko": "「부모님도 오빠도, 친구도 선생님도, 높으신 정치인도, 다들 다들 거짓말을 해……」"},
{"id": "clse07:65600", "ko": "「물론 그중에는 나쁘지 않은 거짓말도 있었어. 하지만 귀를 막고 싶어지는 거짓말도 잔뜩 있었어……」"},
{"id": "clse07:65700", "ko": "「나를 말로는 친구라고 하면서 속으로는 싫어하는 애도 있었어」"},
{"id": "clse07:65800", "ko": "「매일 계속 같이 있는데. 서로 웃고 있는데, 사실은 서로 싫어하는 애들도 있었어……」"},
{"id": "clse07:65900", "ko": "「그래서 말이야…… 나는 나 자신을 거짓말로 두껍게 칠하기로 했어. 누구하고도 진짜 마음으로 마주하지 않아도 되도록……」"},
{"id": "clse07:66000", "ko": "「그러면 누가 거짓말을 하더라도 마음이 아프지 않으니까……」"},
{"id": "clse07:66100", "ko": "「그렇게 나를 거짓말로 굳혀 가는 사이에 나는 점점 거짓말에 익숙해졌어. 남의 거짓말도 아무렇지 않게 받아들일 수 있게 됐어」"},
{"id": "clse07:66200", "ko": "「이제 누군가의 진짜 마음을 아는 게 무섭다니, 그런 식으로 생각할 일은 없을 터였어……」"},
{"id": "clse07:66300", "ko": "「그래…… 계속 거짓말일 생각이었는데……」"},
{"id": "clse07:66400", "ko": "「그냥 사람 좋은 선배를 놀리고 어리광 부리고…… 그것뿐일 생각이었는데……」"},
{"id": "clse07:66500", "ko": "「그런데……」"},
{"id": "clse07:66600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:66700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:66800", "ko": "「만약에!」"},
{"id": "clse07:66900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:67000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:67100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:67200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:67300", "ko": "「그러니까……」"},
{"id": "clse07:67400", "ko": "「안녕……」"},
{"id": "clse07:67500", "ko": "「――!!」"},
{"id": "clse07:67600", "ko": "「…………」"},
{"id": "clse07:67700", "ko": "「읏……!」"},
{"id": "clse07:67800", "ko": "「선배!!」"},
{"id": "clse07:67900", "ko": "「선배!」"},
{"id": "clse07:68000", "ko": "「응……」"},
{"id": "clse07:68100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:68200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:68300", "ko": "「선배……」"},
{"id": "clse07:68400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:68500", "ko": "「사과로 끝날 거면 짭새는 필요 없다 이거여」"},
{"id": "clse07:68600", "ko": "「그런 건 스스로 생각하세요」"},
{"id": "clse07:68700", "ko": "「하하~앙…… 그렇군요, 그런 거예요 그런 거예요, 그런 거군요」"},
{"id": "clse07:68800", "ko": "「그렇다면 선배, 제가 싫어진 거죠」"},
{"id": "clse07:68900", "ko": "「그래. 그게 틀림없어. 그러니까 그런 소리를 하는 거야」"},
{"id": "clse07:69000", "ko": "「영문 모를 소리 아니거든!」"},
{"id": "clse07:69100", "ko": "「읏……!」"},
{"id": "clse07:69200", "ko": "「선배……」"},
{"id": "clse07:69300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:69400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:69500", "ko": "「아이고~ 쑥스럽네요~」"},
{"id": "clse07:69600", "ko": "「맞아 맞아~」"},
{"id": "clse07:69700", "ko": "", "note": "보류 — 연애 묘사(학생)"}
]
