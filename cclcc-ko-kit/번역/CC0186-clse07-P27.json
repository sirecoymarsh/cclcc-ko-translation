[
{"id": "clse07:254200", "ko": "「차?」"},
{"id": "clse07:254300", "ko": "「……차아!」"},
{"id": "clse07:254400", "ko": "「자, 말해 버려!」"},
{"id": "clse07:254500", "ko": "「으음!」"},
{"id": "clse07:254600", "ko": "「차…… 착각인 거야!?」", "note": "思いこみ → 착각(앞 묶음에서 첫소리 「차」로 끊어 맞춤)"},
{"id": "clse07:254700", "ko": "「대〜정답!」"},
{"id": "clse07:254800", "ko": "「거, 짓말!?」"},
{"id": "clse07:254900", "ko": "「나는 능력으로 태어난 게 아니야」"},
{"id": "clse07:255000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:255100", "ko": "「하지만 그건 또 하나의 인격이 있다고 스스로한테 암시를 건 것뿐이고, 어느 쪽이든 너라는 거지」"},
{"id": "clse07:255200", "ko": "「다만 이쪽 인격으로 바뀌어 있는 동안은 『이건 내 의지가 아니야』라고 핑계를 대고 리미터를 풀 수 있어」"},
{"id": "clse07:255300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:255400", "ko": "「그게 좋은 일인지 나쁜 일인지는 모르겠지만, 나는 딱히 신경 안 써」"},
{"id": "clse07:255500", "ko": "「그야, 나는 너니까」"},
{"id": "clse07:255600", "ko": "「자자자자자자자, 잠깐만!」"},
{"id": "clse07:255700", "ko": "「어, 그럼, 어?」"},
{"id": "clse07:255800", "ko": "「네가, 아니라 내가 지금까지 해 온 일은……」"},
{"id": "clse07:255900", "ko": "「으음, 글쎄……」"},
{"id": "clse07:256000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:256100", "ko": "「하우우웃!?」"},
{"id": "clse07:256200", "ko": "「그그그그, 그리고, 네가, 나라는 건……」"},
{"id": "clse07:256300", "ko": "「네가 지금까지 선배한테 해 온 일들은……」"},
{"id": "clse07:256400", "ko": "「그런 거야」"},
{"id": "clse07:256500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:256600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:256700", "ko": "「하와와아아아아아앗!!!!????」"},
{"id": "clse07:256800", "ko": "「하우우……」"},
{"id": "clse07:256900", "ko": "「정신 차려. 이런 데서 기절하지 마. 내 몸이 감기 걸리잖아」"},
{"id": "clse07:257000", "ko": "「게다가 내일 아침에 청소부나 누군가한테 발견됐을 때 뭐라고 변명할 건데?」"},
{"id": "clse07:257100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:257200", "ko": "「으으으, 나 자신한테 잔소리 듣고 있어……」"},
{"id": "clse07:257300", "ko": "「아」"},
{"id": "clse07:257400", "ko": "「어?」"},
{"id": "clse07:257500", "ko": "「지금 『나 자신』이라고 했지. 그거 좋은 경향이야」"},
{"id": "clse07:257600", "ko": "「내가 너라는 걸 받아들이고 있는 거야」"},
{"id": "clse07:257700", "ko": "「아……」"},
{"id": "clse07:257800", "ko": "「솔직하게, 단순하게 생각하면 답은 금방 찾을 수 있어」"},
{"id": "clse07:257900", "ko": "「응……」"},
{"id": "clse07:258000", "ko": "「그래…… 일지도」"},
{"id": "clse07:258100", "ko": "「음후. 솔직해서 좋아」"},
{"id": "clse07:258200", "ko": "「그럼 하나 더 솔직해져 볼까」"},
{"id": "clse07:258300", "ko": "「하나 더?」"},
{"id": "clse07:258400", "ko": "「응」"},
{"id": "clse07:258500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:258600", "ko": "「하왓!?」"},
{"id": "clse07:258700", "ko": "「그건, 그러니까, 그……」"},
{"id": "clse07:258800", "ko": "「으으응……!」"},
{"id": "clse07:258900", "ko": "「자기 자신한테 거짓말할 필요는 없어. 아무도 안 듣고 있으니까」"},
{"id": "clse07:259000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:259100", "ko": "「그……」"},
{"id": "clse07:259200", "ko": "「타쿠루, 선배는……」"},
{"id": "clse07:259300", "ko": "「……」"},
{"id": "clse07:259400", "ko": "「……응」"},
{"id": "clse07:259500", "ko": "「타쿠루 선배는, 나한테 있을 곳을 줬어」"},
{"id": "clse07:259600", "ko": "「선배는, 갑자기 신문부에 눌러앉은 나를, 사정도 묻지 않고 받아 줬어」"},
{"id": "clse07:259700", "ko": "「말없이 엠스만 계속해도, 불평하지 않았어」"},
{"id": "clse07:259800", "ko": "「내가 말하기 싫어하는 이유도 묻지 않았어」"},
{"id": "clse07:259900", "ko": "「분명, 그건, 선배한테는 아무것도 아닌 일이야」"},
{"id": "clse07:260000", "ko": "「분명, 나는 부원 수 채우기일 뿐이야」"},
{"id": "clse07:260100", "ko": "「그래도, 기뻤어」"},
{"id": "clse07:260200", "ko": "「나를 필요로 해 주고, 내가 하고 싶은 걸 존중해 주는 게 기뻤어」"},
{"id": "clse07:260300", "ko": "「그리고, 타쿠루 선배는, 상냥한 사람이야」"},
{"id": "clse07:260400", "ko": "「평소에는 엄청 잘난 척하고, 다들 바보 취급하는 말투로만 말하지만, 사실은 정말 상냥한 사람이야」"},
{"id": "clse07:260500", "ko": "「분명, 지금도, 나를 찾아서 뛰어다니고 있을 거야」"},
{"id": "clse07:260600", "ko": "「그러니까, 나는……」"},
{"id": "clse07:260700", "ko": "「나, 나는……」"},
{"id": "clse07:260800", "ko": "「나는?」"},
{"id": "clse07:260900", "ko": "「괜찮아, 내가 있으니까. 말해 봐」"},
{"id": "clse07:261000", "ko": "「……」"},
{"id": "clse07:261100", "ko": "「……응」"},
{"id": "clse07:261200", "ko": "「나는……」"},
{"id": "clse07:261300", "ko": "「타쿠루 선배가……」"},
{"id": "clse07:261400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:261500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:261600", "ko": "「……」"},
{"id": "clse07:261700", "ko": "「……응」"},
{"id": "clse07:261800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:261900", "ko": "「……응」"},
{"id": "clse07:262000", "ko": "「……응……!」"},
{"id": "clse07:262100", "ko": "「어, 뭐야……?」"},
{"id": "clse07:262200", "ko": "「이제 머릿속 대화는 끝. 현실로 돌아가」"},
{"id": "clse07:262300", "ko": "「어, 어디? 어디 있는 거야?」"},
{"id": "clse07:262400", "ko": "「아무 데도 없어」"},
{"id": "clse07:262500", "ko": "「나는 처음부터 아무 데도 없어」"},
{"id": "clse07:262600", "ko": "「지금은 네 마음속으로 돌아간 참이야. 그리고 곧 사라져」"},
{"id": "clse07:262700", "ko": "「네가 솔직하게 자기 마음을 말할 수 있는 동안은, 이제 나오지 않을 거야」"},
{"id": "clse07:262800", "ko": "「그러니까 내가 안 나와도 되게, 힘내」"},
{"id": "clse07:262900", "ko": "「……응」"},
{"id": "clse07:263000", "ko": "「힘낼게」"},
{"id": "clse07:263100", "ko": "「좋아!」"},
{"id": "clse07:263200", "ko": "「어때? 지금 기분은」"},
{"id": "clse07:263300", "ko": "「……솔직히 말하면」"},
{"id": "clse07:263400", "ko": "「……엄청, 부끄러워……!」"},
{"id": "clse07:263500", "ko": "「아핫!」"},
{"id": "clse07:263600", "ko": "「그렇지. 알아」"},
{"id": "clse07:263700", "ko": "「하지만 말이야, 이다음에 더 부끄러운 일이 생길 테니까, 기절하지 않게 조심해」"},
{"id": "clse07:263800", "ko": "「어?」"},
{"id": "clse07:263900", "ko": "「미안해, 나, 너한테 거짓말했어」"},
{"id": "clse07:264000", "ko": "「어?」"},
{"id": "clse07:264100", "ko": "「여기엔 아무도 없다고 했잖아」"}
]
