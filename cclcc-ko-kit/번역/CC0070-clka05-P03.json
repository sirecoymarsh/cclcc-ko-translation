[
{"id": "clka05:20000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:20100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:20200", "ko": "「아니아니아니아니야!」"},
{"id": "clka05:20300", "ko": "「상황을 이해 못 하고 있을 뿐이야!」"},
{"id": "clka05:20400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:20500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:20600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:20700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:20800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:20900", "ko": "「뭐어!?」"},
{"id": "clka05:21000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21200", "ko": "「아니, 저기!?」"},
{"id": "clka05:21300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:21900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:22000", "ko": "――그 직전, 체육 창고 문이 열리고 몇 사람이 우르르 들어왔다."},
{"id": "clka05:22100", "ko": "「타쿠루! 카즈키!」"},
{"id": "clka05:22200", "ko": "들어온 건 쿠루스 일행 신문부 멤버들이었다."},
{"id": "clka05:22300", "ko": "「카와하라가 카즈키가 여기 들어가는 걸 봤다고 알려 줬어」"},
{"id": "clka05:22400", "ko": "쿠루스는 걱정스러운 얼굴로 말하고 있지만, 창고가 어두운 탓인지 우리 쪽이 잘 보이지 않는 모양이었다."},
{"id": "clka05:22500", "ko": "「골똘한 얼굴로 안에 들어갔으니까 상태를 보는 게 좋겠다고」"},
{"id": "clka05:22600", "ko": "「무슨 걱정거리가 있으면 언제든지 상담을――」"},
{"id": "clka05:22700", "ko": "겨우 눈이 익숙해졌는지, 쿠루스는 나와 카즈키의 모습을 보고 멍하니 있다."},
{"id": "clka05:22800", "ko": "「……너희, 뭐 하는 거야?」"},
{"id": "clka05:22900", "ko": "「뭐 하냐니……」"},
{"id": "clka05:23000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:23100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:23200", "ko": "상황만 보면 뻔하겠지."},
{"id": "clka05:23300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:23400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:23500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:23600", "ko": "「타, 타쿠루…… 너, 설마……!」"},
{"id": "clka05:23700", "ko": "「자, 잠깐만 쿠루스! 이건 사정이 있어!」"},
{"id": "clka05:23800", "ko": "「카즈키! 너도 설명 좀 해 줘!」"},
{"id": "clka05:23900", "ko": "나는 카즈키를 향해 소리쳤다."},
{"id": "clka05:24000", "ko": "그러자."},
{"id": "clka05:24100", "ko": "「……」"},
{"id": "clka05:24200", "ko": "아까까지의 적극성은 어디로 갔는지. 카즈키는 평소의 멍한 표정으로 나를 마주 보고 있었다."},
{"id": "clka05:24300", "ko": "「카즈키?」"},
{"id": "clka05:24400", "ko": "「응?」"},
{"id": "clka05:24500", "ko": "눈을 깜빡깜빡하는 카즈키."},
{"id": "clka05:24600", "ko": "「야! 모르는 척하지 마! 애초에 네가――!」"},
{"id": "clka05:24700", "ko": "나는 허둥지둥 몸을 일으켰다."},
{"id": "clka05:24800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:24900", "ko": "「……」"},
{"id": "clka05:25000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:25100", "ko": "한순간의 침묵 뒤."},
{"id": "clka05:25200", "ko": "「으음!」"},
{"id": "clka05:25300", "ko": "카즈키는 얼굴이 새빨개져서 나를 밀쳐 내고 옆으로 펄쩍 물러났다."},
{"id": "clka05:25400", "ko": "「으음! 으음!」"},
{"id": "clka05:25500", "ko": "두 손으로 몸을 가린 카즈키는 항의하듯 소리를 냈다. 입은 다물고 있지만 화난 얼굴이고, 눈가에는 눈물이 맺혀 있다."},
{"id": "clka05:25600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka05:25700", "ko": "「으으으응!」"},
{"id": "clka05:25800", "ko": "고개를 붕붕 가로젓는다."},
{"id": "clka05:25900", "ko": "「……타쿠루」"},
{"id": "clka05:26000", "ko": "「헉! 쿠, 쿠루스!?」"},
{"id": "clka05:26100", "ko": "「타쿠루」"},
{"id": "clka05:26200", "ko": "「각오는 됐겠지?」"}
]
