[
{"id": "clse07:774400", "ko": "「역시 닮았지~」"},
{"id": "clse07:774500", "ko": "「응? 그래? 나 못 들었는――읍읍」"},
{"id": "clse07:774600", "ko": "「으읍~, 음~!」"},
{"id": "clse07:774700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:774800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:774900", "ko": "「그건 그렇고 센리, 늦네~. 무슨 일이지?」"},
{"id": "clse07:775000", "ko": "「신경 쓰이면 전화해 보지 그래?」"},
{"id": "clse07:775100", "ko": "「아, 아니~, 그래도 설마, 아무리 그래도……」"},
{"id": "clse07:775200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:775300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:775400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:775500", "ko": "「있잖아~, 타쿠~?」"},
{"id": "clse07:775600", "ko": "「그렇게 티 나게 눈 피하지 않아도 되는데……」"},
{"id": "clse07:775700", "ko": "「……딱히 눈만 봐도 멋대로 발동하는 능력은 아니거든. 게다가 지금은 웬만한 일이 아니면 남의 마음 같은 거 안 읽으려고 하고 있어?」"},
{"id": "clse07:775800", "ko": "「응. 노노한테 따끔하게 한 소리 들었으니까」"},
{"id": "clse07:775900", "ko": "「노노는 말이야, 내가 그만 사고 도촬을 하면 엄청 무섭다~. 왠지 잔소리 많은 엄마 같아」"},
{"id": "clse07:776000", "ko": "「아~, 그거 좀 알 것 같아~」"},
{"id": "clse07:776100", "ko": "「거짓말이에요~」"},
{"id": "clse07:776200", "ko": "「그러니까 말이야, 타쿠? 나, 지금은 사고 도촬을 할 것 같아도 열심히 참고 있어. 그러니까 괜찮아」"},
{"id": "clse07:776300", "ko": "「응? 아, 응」"},
{"id": "clse07:776400", "ko": "「응?」"},
{"id": "clse07:776500", "ko": "「으~, 뭐랄까, 평소처럼 해 줘~. 그렇게 빤히 쳐다보면 쑥스럽잖아」"},
{"id": "clse07:776600", "ko": "「옛날 방식?」"},
{"id": "clse07:776700", "ko": "「아~, 나도 갈래 갈래~」"},
{"id": "clse07:776800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:776900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:777000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:777100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:777200", "ko": "「에~. 그런가~」"},
{"id": "clse07:777300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:777400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:777500", "ko": "「응? 타쿠는 왜 사과하는 거야?」"},
{"id": "clse07:777600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:777700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:777800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:777900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:778000", "ko": "「뭐가 어쨌다고? 뭐가?」"},
{"id": "clse07:778100", "ko": "「아~! 겐 씨 찾았다~!」"},
{"id": "clse07:778200", "ko": "「안 돼, 겐 씨! 주워 온 야한 책 다섯 권 세트를 타쿠한테 천 엔에 팔려고 하면!」"},
{"id": "clse07:778300", "ko": "「잘하면 이천 엔에도 팔 수 있겠다! 하고 생각하는 주제에~」"},
{"id": "clse07:778400", "ko": "「응? 어? 으응. 아무것도 아니야, 아무것도. 그래서 그 책, 나중에 몰래 겐 씨한테 살 생각이야?」"},
{"id": "clse07:778500", "ko": "「노노도 그랬지만, 능력 같은 거 안 써도 타쿠 거짓말은 금방 알겠다니까~」"},
{"id": "clse07:778600", "ko": "「그래도 말이야. 타쿠는 그…… 그런 책의 어디가 좋은 걸까……」"},
{"id": "clse07:778700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:778800", "ko": "「니즈?」"},
{"id": "clse07:778900", "ko": "「…………」"},
{"id": "clse07:779000", "ko": "「있지, 타쿠. 잠깐 와 봐」"},
{"id": "clse07:779100", "ko": "「그렇구나. 역시 그런 거였어. 알아 버렸어」"},
{"id": "clse07:779200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:779300", "ko": "「………」"},
{"id": "clse07:779400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:779500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:779600", "ko": "「………」"},
{"id": "clse07:779700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:779800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:779900", "ko": "「아, 여보세요, 노노? 잠깐 질문해도 될까~?」"},
{"id": "clse07:780000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:780100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:780200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:780300", "ko": "「우왓!? 잠깐, 타쿠!? 뭐 하는 거야!?」"},
{"id": "clse07:780400", "ko": "「뭐…… 하는 거야?」"},
{"id": "clse07:780500", "ko": "「갑자기 알 수 없는 소리를 외치면서 트레일러 하우스 쪽으로 달려갔어」"},
{"id": "clse07:780600", "ko": "「그러고는 전력으로 비명 지르면서 다이빙해서 문에 쾅 하고 부딪히고」"},
{"id": "clse07:780700", "ko": "「그래서 지금은 코피 뿜으면서 쓰러져 있어」"},
{"id": "clse07:780800", "ko": "「멋대로 납득하지 마~! 하나도 모르겠다고~!」"},
{"id": "clse07:780900", "ko": "「??? 왜 그래?」"},
{"id": "clse07:781000", "ko": "「응? 어라? 뭔가 화났어?」"},
{"id": "clse07:781100", "ko": "「내 탓? 이라니, 왜?」"},
{"id": "clse07:781200", "ko": "「응? 그, 그러니까 그렇게 말했잖아」"},
{"id": "clse07:781300", "ko": "「사고 도촬 같은 거 이제 안 해. 노노한테 주의받은 거 타쿠도 알잖아?」"},
{"id": "clse07:781400", "ko": "「…… 아, 그건 그…… 겐 씨가 나쁜 생각을 하는 것 같아서. 응, 정말 그것뿐이야」"},
{"id": "clse07:781500", "ko": "「…………」"},
{"id": "clse07:781600", "ko": "「……? 뭐어~?」"},
{"id": "clse07:781700", "ko": "「뭐, 무슨 소리야?」"},
{"id": "clse07:781800", "ko": "「에에에? 그런 거 안 했어! 안 했다니까!」"},
{"id": "clse07:781900", "ko": "「나는 오히려 타쿠가 계속 나를 쳐다보니까 뭘까~? 하고 보고 있었을 뿐이야~?」"},
{"id": "clse07:782000", "ko": "「응. 확실히 내 능력은 안 좋다~ 싶어서 되도록 안 쓰려고 하는데……」"},
{"id": "clse07:782100", "ko": "「으, 으응. 알아주면 그걸로 됐어. 응」"},
{"id": "clse07:782200", "ko": "「그보다 타쿠는 왜 계속 나를 보고 있었어?」"},
{"id": "clse07:782300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:782400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:782500", "ko": "「응? 아아, 타쿠」"},
{"id": "clse07:782600", "ko": "「음~, 실은 오늘 볼일이 좀 있어서. 내일이어도 될까~?」"},
{"id": "clse07:782700", "ko": "「미, 미안해, 타쿠. 실은 말이야, 그, 그게, 볼일이 히나네랑 있는 거거든~」"},
{"id": "clse07:782800", "ko": "「응? 으으…… 그게…… 저기…… 있잖아」"},
{"id": "clse07:782900", "ko": "「으, 응. 그러니까, 그러니까…… 처음에 이상하다고 생각한 건, 그…… 『사고 도촬』이 잘 안 되게 된 거라서……」"},
{"id": "clse07:783000", "ko": "「아, 물론 평소에는 안 써. 노노한테 주의받았으니까. 그런데 그…… 왠지 타쿠가 무슨 생각을 하는지 엄청 신경 쓰일 때가 있어서. 그만…… 타쿠한테만」"},
{"id": "clse07:783100", "ko": "「응, 정말이야! 신문부 다른 애들한테는 안 했어」"},
{"id": "clse07:783200", "ko": "「어? 아, 그건……」"},
{"id": "clse07:783300", "ko": "「그, 그건 말이야, 그, 아닌 건 아닌데, 달라」"},
{"id": "clse07:783400", "ko": "「나 말이야, 요즘 타쿠 생각⟦rb⟧만⟦rt⟧⟦rbc⟧●⟦/r⟧ 안 보이게 된 것 같아서……」"}
]
