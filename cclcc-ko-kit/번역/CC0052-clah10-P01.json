[
{"id": "clah10:0", "ko": "「좋은 아침, 타쿠루」"},
{"id": "clah10:100", "ko": "아침에 학교에 도착하자마자 노노와 마주쳤다."},
{"id": "clah10:200", "ko": "「응……」"},
{"id": "clah10:300", "ko": "「정말, 또 아침부터 그렇게 어두운 얼굴을 하고」"},
{"id": "clah10:400", "ko": "「미안하게 됐네. 난 원래 이런 얼굴이야」"},
{"id": "clah10:500", "ko": "「어머, 오늘은 꽤 심기가 불편하구나. 또 아리무라랑 싸우기라도 했어?」"},
{"id": "clah10:600", "ko": "「아, 아리무라는 상관없어!」"},
{"id": "clah10:700", "ko": "「……뭘 그렇게까지 발끈하고 그래……」"},
{"id": "clah10:800", "ko": "아……"},
{"id": "clah10:900", "ko": "「어머어머, 또 그렇게 구김투성이 셔츠나 입고」"},
{"id": "clah10:1000", "ko": "「어……?」"},
{"id": "clah10:1100", "ko": "「요즘은 제대로 하고 다닌다 싶었는데, 왜 그래……?」"},
{"id": "clah10:1200", "ko": "셔츠 주름 같은 건 지금까지 신경 써 본 적도 없었다."},
{"id": "clah10:1300", "ko": "입을 수만 있으면 다 똑같다고 생각했다."},
{"id": "clah10:1400", "ko": "그런가…… 그 녀석……"},
{"id": "clah10:1500", "ko": "「타쿠루?」"},
{"id": "clah10:1600", "ko": "점심 종이 울리자마자 이토가 찾아왔다."},
{"id": "clah10:1700", "ko": "「아〜, 끝났다 끝났어. 야, 점심――」"},
{"id": "clah10:1800", "ko": "「미안, 이토. 나 잠깐 갈 데가 있어서」"},
{"id": "clah10:1900", "ko": "「응? 아, 그렇군. 또 아리무라가 싸 준 사랑의 도시락이냐〜」"},
{"id": "clah10:2000", "ko": "분명 아리무라네 반은……"},
{"id": "clah10:2100", "ko": "「어라, 타쿠?」"},
{"id": "clah10:2200", "ko": "「아, 오노에. 마침 잘 만났다」"},
{"id": "clah10:2300", "ko": "「뭐야 뭐야, 나한테 무슨 볼일이라도 있어?」"},
{"id": "clah10:2400", "ko": "「아〜, 아니……」"},
{"id": "clah10:2500", "ko": "「뭐야〜, 내가 아니라 히나한테 볼일이구나……」"},
{"id": "clah10:2600", "ko": "평소엔 눈치가 없으면서, 이럴 때만 감이 좋네."},
{"id": "clah10:2700", "ko": "혹시 능력을 쓴 건가?"},
{"id": "clah10:2800", "ko": "뭐, 어느 쪽이든 상관없다."},
{"id": "clah10:2900", "ko": "「어라? 근데 오늘 히나 결석 아니었나?」"},
{"id": "clah10:3000", "ko": "「그런…… 거야?」"},
{"id": "clah10:3100", "ko": "「응? 타쿠, 히나랑 같이 있었던 거 아니야?」"},
{"id": "clah10:3200", "ko": "「아, 응…… 뭐, 이것저것 좀 있어서……」"},
{"id": "clah10:3300", "ko": "「그렇구나……」"},
{"id": "clah10:3400", "ko": "「미안, 고마워」"},
{"id": "clah10:3500", "ko": "「으, 응……」"},
{"id": "clah10:3600", "ko": "「…………」"},
{"id": "clah10:3700", "ko": "학교를 쉬다니, 대체 무슨 일이지?"},
{"id": "clah10:3800", "ko": "역시 저번에 그런 차림으로 요리를 해서 감기라도 걸린 건……"},
{"id": "clah10:3900", "ko": "아니면 집에서 또 무슨 일이 있었다든가."},
{"id": "clah10:4000", "ko": "……아, 또다."},
{"id": "clah10:4100", "ko": "나는 또 아리무라 생각을 하고 있다."},
{"id": "clah10:4200", "ko": "어제부터 계속 이렇다."},
{"id": "clah10:4300", "ko": "툭하면 그 녀석 생각만 하게 된다."},
{"id": "clah10:4400", "ko": "일어나서 학교에 가는 동안에도, 수업 중에도 쉬는 시간에도 집에 돌아와서도."},
{"id": "clah10:4500", "ko": "어째서 이렇게까지……"},
{"id": "clah10:4600", "ko": "아니, 그 이유는 나도 이미 진작 알고 있다."},
{"id": "clah10:4700", "ko": "아리무라를 만나고 싶은 거다, 나는."},
{"id": "clah10:4800", "ko": "시끄럽고, 넉살 좋고 변덕스럽고, 귀찮고 성가시다고 생각한 적도 있었지만, 그래도 그 녀석과 있으면 나는 즐거운 거다."},
{"id": "clah10:4900", "ko": "즐거웠던 거다."},
{"id": "clah10:5000", "ko": "요 며칠이."},
{"id": "clah10:5100", "ko": "그래."},
{"id": "clah10:5200", "ko": "인정하자."},
{"id": "clah10:5300", "ko": "승부는 내 패배다."},
{"id": "clah10:5400", "ko": "네가 이겼어, 아리무라."},
{"id": "clah10:5500", "ko": "나는 분명 너에게 끌리고 있는 거야."},
{"id": "clah10:5600", "ko": "시시한 기 싸움에서 시작된 다툼이었지만, 그래도 승부는 승부다."},
{"id": "clah10:5700", "ko": "그러니까 적어도 『내가 졌다』 정도는 말하게 해 줘."},
{"id": "clah10:5800", "ko": "「…………」"},
{"id": "clah10:5900", "ko": "스마트폰을 꺼내서 아리무라의 이름을 띄운다."},
{"id": "clah10:6000", "ko": "뭔가 말을 입력하려다가 손가락이 멈췄다."},
{"id": "clah10:6100", "ko": "이렇게 글자로 쓴 말로는 진짜인지 거짓인지 알 수 없잖아."},
{"id": "clah10:6200", "ko": "나는 제대로 소리 내어 전해야 하는 거다."},
{"id": "clah10:6300", "ko": "「아…………」"},
{"id": "clah10:6400", "ko": "『민폐 끼친 건 알아…… 그러니까 말하지 마……』"},
{"id": "clah10:6500", "ko": "『입 밖에…… 내지 마……』"},
{"id": "clah10:6600", "ko": "그때 아리무라가 한 말."},
{"id": "clah10:6700", "ko": "계속 위화감을 느꼈던 그 말."},
{"id": "clah10:6800", "ko": "그건 어쩌면……"},
{"id": "clah10:6900", "ko": "⟦rb⟧내⟦rt⟧⟦rbc⟧●⟦/r⟧ ⟦rb⟧말의⟦rt⟧⟦rbc⟧●●⟦/r⟧ ⟦rb⟧진위를⟦rt⟧⟦rbc⟧●●●⟦/r⟧ ⟦rb⟧알고 싶지⟦rt⟧⟦rbc⟧●●●●⟦/r⟧ ⟦rb⟧않았다⟦rt⟧⟦rbc⟧●●●⟦/r⟧는 거 아닐까?"},
{"id": "clah10:7000", "ko": "「――!!」"},
{"id": "clah10:7100", "ko": "나는 그날 내팽개쳐 둔 채였던 아리무라의 대본 페이지를 넘겼다."},
{"id": "clah10:7200", "ko": "『저는 히나에 씨를 좋아합니다!』"},
{"id": "clah10:7300", "ko": "『그러니까 히나에 씨를 돌려보내고 싶지 않습니다』"},
{"id": "clah10:7400", "ko": "『이것이 거짓 없는 제 마음입니다』"},
{"id": "clah10:7500", "ko": "「……역시 문예부는 안 맞아, 그 녀석……」"},
{"id": "clah10:7600", "ko": "만약 그때 내가 이 말을 입에 담았다면, 아리무라는 싫든 좋든 그게 진짜인지 거짓인지 알아 버렸을 것이다."},
{"id": "clah10:7700", "ko": "설령 그게 지어낸 대사라 해도."},
{"id": "clah10:7800", "ko": "그럼 왜 아리무라는 내 본심을 알고 싶지 않았을까?"},
{"id": "clah10:7900", "ko": "만약 내 말이 거짓이 아니었다면―― 그건 내가 아리무라를 정말로 좋아한다는 뜻이 된다."},
{"id": "clah10:8000", "ko": "그 경우 아리무라가 듣고 싶지 않았던 이유는 하나."},
{"id": "clah10:8100", "ko": "내가 자기를 좋아한다는 사실을 알고 싶지 않았다는 것이다."},
{"id": "clah10:8200", "ko": "어째서?"},
{"id": "clah10:8300", "ko": "내가 아리무라의 공세에 넘어가서 아리무라를 정말로 좋아하게 되면 곤란하니까?"},
{"id": "clah10:8400", "ko": "좋아하지도 않는 상대가 진심으로 호감을 품으면 곤란하다. 그렇기에 나를 거절했다―― 그런 얘기가 된다."},
{"id": "clah10:8500", "ko": "하지만 그때의 아리무라는 불안한 듯한…… 금방이라도 울음을 터뜨릴 것 같은, 그런 얼굴을 하고 있었다."},
{"id": "clah10:8600", "ko": "그게 누군가의 호감을 거절하는 사람의 얼굴일까?"},
{"id": "clah10:8700", "ko": "나는 그렇게 생각되지 않는다."},
{"id": "clah10:8800", "ko": "그럼 다른 이유는?"},
{"id": "clah10:8900", "ko": "또 하나 생각할 수 있는 이유가 있다면 그건―― 내 말이 거짓이었을 경우다."},
{"id": "clah10:9000", "ko": "대본대로 『아리무라를 좋아한다』고 고한 내 말이 거짓이라면, 실제로 나는 아리무라를 좋아하지 않는다는 뜻이 된다."},
{"id": "clah10:9100", "ko": "만약 아리무라가 그 사실을 알게 되는 걸 거부한 거라면, 그건 왜지?"},
{"id": "clah10:9200", "ko": "（설마, 아리무라도 나를……?）"},
{"id": "clah10:9300", "ko": "자신이 호감을 품고 있는 상대가, 만약 자신을 좋아하지 않는다면――"},
{"id": "clah10:9400", "ko": "그 사실을 아는 게 무서워서, 아리무라는 그때 나한테 입 밖에 내지 말라고, 그렇게 말한 게 아닐까?"},
{"id": "clah10:9500", "ko": "물론 내가 싫어져서 거절했을 가능성도 있다."},
{"id": "clah10:9600", "ko": "하지만 나는 또 하나의 가능성을 믿고 싶었다."},
{"id": "clah10:9700", "ko": "아리무라가 나를 좋아할 가능성을……"},
{"id": "clah10:9800", "ko": "그렇다면 나는 더더욱 아리무라를 만나야 한다."},
{"id": "clah10:9900", "ko": "만나서 마음을 소리 내어 전해야 한다."}
]
