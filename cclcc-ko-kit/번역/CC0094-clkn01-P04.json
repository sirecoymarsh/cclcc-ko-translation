[
{"id": "clkn01:29600", "ko": "「들었지, 센리 언니!」"},
{"id": "clkn01:29700", "ko": "「어머어머. 그럼 앞으로 저녁은 계속 유이한테 맡길까?」"},
{"id": "clkn01:29800", "ko": "「어…… 그건 좀……」"},
{"id": "clkn01:29900", "ko": "「맞아~. 유이 누나한테 맡기면 매일 카레 아니면 스튜만 나올 거야~」"},
{"id": "clkn01:30000", "ko": "「야, 유!!」"},
{"id": "clkn01:30100", "ko": "「으악, 우키 누나, 살려 줘~」"},
{"id": "clkn01:30200", "ko": "「네엣?」"},
{"id": "clkn01:30300", "ko": "확실히 유토 말대로, 유이가 센리의 경지에 이르려면 아직 멀었을 것이다."},
{"id": "clkn01:30400", "ko": "예를 들면 곁들여 나온 이 락교."},
{"id": "clkn01:30500", "ko": "이것도 분명 센리가 집에서 직접 담근 것일 터다."},
{"id": "clkn01:30600", "ko": "집안 살림을 제대로 생각해서 싸고 맛있는 걸 만드는 건, 그렇게 쉽게 할 수 있는 일이 아니다."},
{"id": "clkn01:30700", "ko": "「근데 말이야, 고기가 안 들어 있잖냐, 고기가」"},
{"id": "clkn01:30800", "ko": "「에~ 들어 있어. 봐, 거기」"},
{"id": "clkn01:30900", "ko": "「요것밖에 없잖냐. 게다가 닭고기라니. 카레라 하면 소고기지, 소고기」"},
{"id": "clkn01:31000", "ko": "「본고장 카레에는 소고기가 안 들어가거든요」"},
{"id": "clkn01:31100", "ko": "「하여간, 그런 데만 센리를 닮아 가지고」"},
{"id": "clkn01:31200", "ko": "「어머. 그게 뭐 문제라도?」"},
{"id": "clkn01:31300", "ko": "「응? 아, 아니…… 그런 건 아니고……」"},
{"id": "clkn01:31400", "ko": "「어, 야. 타쿠루 카레에는 고기가 잔뜩 들어 있잖냐! 편애다, 편애! 가족은 모두 평등하게, 그게 ⟦rb⟧아오바 기숙사⟦rt⟧우리 집⟦/r⟧ 규칙이잖냐」"},
{"id": "clkn01:31500", "ko": "「그런 거 들어 본 적 없거든」"},
{"id": "clkn01:31600", "ko": "「방금 정했다. 자, 타쿠루! 고기 내놔, 고기!」"},
{"id": "clkn01:31700", "ko": "「닭고기는 싫다면서?」"},
{"id": "clkn01:31800", "ko": "「닭고기라도 없는 것보단 낫다! 내놔!」"},
{"id": "clkn01:31900", "ko": "「아!! 그거 제일 큰 건데!」"},
{"id": "clkn01:32000", "ko": "「앙…… 흐흥, 벌써 먹어 치웠다고」"},
{"id": "clkn01:32100", "ko": "「젠장~……!」"},
{"id": "clkn01:32200", "ko": "「정말, 아빠도 참, 애도 아니고. 타쿠루도, 내 고기 줄 테니까 상대하지 마」"},
{"id": "clkn01:32300", "ko": "……이런 것도 화목한 가족의 한때라고 하는 거겠지, 분명."},
{"id": "clkn01:32400", "ko": "그래도 그것도 나쁘지 않다――그렇게 생각할 수 있게 된 것도, 한동안 혼자 살아 봤기 때문일지도 모른다."},
{"id": "clkn01:32500", "ko": "「잘 먹었습니다! 저기, 텔레비전 켜도 돼?」"},
{"id": "clkn01:32600", "ko": "「안 돼. 텔레비전은 다 같이 다 먹고 나서라는 규칙이잖아」"},
{"id": "clkn01:32700", "ko": "「그치만 있잖아, 오늘 그거 하는 날이야. 유이 누나도 보고 싶다고 했던……」"},
{"id": "clkn01:32800", "ko": "「아! 그 마술 하는 거!? 말도 안 돼, 오늘이었어?」"},
{"id": "clkn01:32900", "ko": "「뭐냐, 유이. 너 아직도 마술이니 뭐니 하는 걸 좋아하냐?」"},
{"id": "clkn01:33000", "ko": "「아직도요?」"},
{"id": "clkn01:33100", "ko": "「유이 녀석, 옛날에 자주 그랬거든. 마법을 쓸 수 있으면 좋겠다느니 어쩌느니」"},
{"id": "clkn01:33200", "ko": "마법……"},
{"id": "clkn01:33300", "ko": "「아빠는 또 그렇게 놀리고」"},
{"id": "clkn01:33400", "ko": "「놀리는 게 아니라니까. 언제까지고 애 그대로구나 싶었을 뿐이다」"},
{"id": "clkn01:33500", "ko": "그러고 보니 어릴 때는 마술이 마법처럼 보였었지."},
{"id": "clkn01:33600", "ko": "누구에게나 그런 걸 동경하는 시기는 있는 법이다."},
{"id": "clkn01:33700", "ko": "그런 의미에서는 기가로매니악스의 능력도 마법 같은 거지만."},
{"id": "clkn01:33800", "ko": "「그게 놀리는 거라고. 애초에 나 이제 애 아니거든!」"},
{"id": "clkn01:33900", "ko": "「그래도 만약 정말로 마법을 쓸 수 있다면 멋질 것 같아요」"},
{"id": "clkn01:34000", "ko": "「그치? 우키도 그렇게 생각하지?」"},
{"id": "clkn01:34100", "ko": "그나저나 유이한테도 이런 면이 있었구나."},
{"id": "clkn01:34200", "ko": "아버지는 언제까지고 애 그대로라고 했지만, 내가 보기에 유이는 오히려 발돋움해서 어른인 척하는 것처럼 보였다."},
{"id": "clkn01:34300", "ko": "어쩌면 나는 지금까지 유이를 제대로 보지 않았던 건지도 모른다."},
{"id": "clkn01:34400", "ko": "「애초에 내 건 그냥 꿈이 아니거든」"},
{"id": "clkn01:34500", "ko": "「꿈이 아니라고? 뭐냐, 그게. 대체 무슨 뜻이냐?」"},
{"id": "clkn01:34600", "ko": "「…………」"},
{"id": "clkn01:34700", "ko": "그때까지 입을 삐죽거리던 유이가 문득 진지한 표정을 지었다."},
{"id": "clkn01:34800", "ko": "「유이?」"},
{"id": "clkn01:34900", "ko": "「미안. 사실 계속 말 안 하려고 했는데, 역시 안 되겠지. 우린 가족인걸」"},
{"id": "clkn01:35000", "ko": "「가족끼리는 숨기는 거 없기. 그렇지, 센리 언니?」"},
{"id": "clkn01:35100", "ko": "「……무슨 말이야? 유이, 너 우리한테 뭔가 숨기고 있어?」"},
{"id": "clkn01:35200", "ko": "유이는 센리의 물음에 대답하지 않고, 대신 옷깃에 달린 작은 장식을 떼어 손끝으로 톡 두드렸다."},
{"id": "clkn01:35300", "ko": "「얍!」"},
{"id": "clkn01:35400", "ko": "퐁."},
{"id": "clkn01:35500", "ko": "경쾌한 소리와 함께 장식이 요술봉으로 변했다."},
{"id": "clkn01:35600", "ko": "아니, 언뜻 요술봉처럼 보였지만, 그건――."},
{"id": "clkn01:35700", "ko": "⟦col:280aa02d1400⟧디소드⟦col:800000⟧!?"},
{"id": "clkn01:35800", "ko": "설마 유이, 너는――."},
{"id": "clkn01:35900", "ko": "「파라파라파라린, 파라리리루~♪」"},
{"id": "clkn01:36000", "ko": "손에 든 요술봉으로 커다랗게 하트를 그렸다."},
{"id": "clkn01:36100", "ko": "그러자 허공에 팬시한 상자가 여러 개 나타나 유이를 감쌌다."},
{"id": "clkn01:36200", "ko": "어디선가 형형색색의 별과 리본이 무수히 춤추듯 흩날리고, 이윽고 상자 속에서 튀어나온 것은――."},
{"id": "clkn01:36300", "ko": "「마법의 아이돌, ⟦col:280aa02d1400⟧매지컬 유이⟦col:800000⟧ 등장이야. 후훗히♪」", "note": "새 용어: マジカル・ユイ → 매지컬 유이"},
{"id": "clkn01:36400", "ko": "「매지컬…… 유이……」"},
{"id": "clkn01:36500", "ko": "「후훗, 놀랐어, 타쿠루 오빠?」"},
{"id": "clkn01:36600", "ko": "「노, 놀랄 수밖에 없잖아! 게다가 뭐야, 마법의 아이돌이라니!」"},
{"id": "clkn01:36700", "ko": "「어? 타쿠루…… 몰라? 요즘 텔레비전에서 엄청 인기 있는 아이돌, 매지컬 유이 말이야」"},
{"id": "clkn01:36800", "ko": "「뭐?」"},
{"id": "clkn01:36900", "ko": "매지컬 유이?"},
{"id": "clkn01:37000", "ko": "텔레비전에서 유명한?"},
{"id": "clkn01:37100", "ko": "그게 뭔데?"},
{"id": "clkn01:37200", "ko": "「타쿠루……」"},
{"id": "clkn01:37300", "ko": "「무, 물론 알고 있었지! 나를 누구라고 생각하는 거야. 그런 흔해 빠진 정보 약자랑 똑같이 취급하지 말아 줘」"},
{"id": "clkn01:37400", "ko": "「그렇……겠지. 그래도 놀랍다……」"},
{"id": "clkn01:37500", "ko": "「설마…… 그 매지컬 유이가 유이였을 줄이야……」"},
{"id": "clkn01:37600", "ko": "「나도 깜짝 놀랐어」"},
{"id": "clkn01:37700", "ko": "「다, 당연히 난 알고 있었지만!」"},
{"id": "clkn01:37800", "ko": "「유이. 마법으로 고기 좀 꺼내 줘라, 고기!」"},
{"id": "clkn01:37900", "ko": "「저기, 사인해 주세요……」"},
{"id": "clkn01:38000", "ko": "「나도 나도!!」"},
{"id": "clkn01:38100", "ko": "정말로…… 아이돌이라고?"},
{"id": "clkn01:38200", "ko": "「지금까지 말 안 해서 미안해. 내가 모두의 아이돌, 매지컬 유이였다는 거……」"},
{"id": "clkn01:38300", "ko": "「유이……」"},
{"id": "clkn01:38400", "ko": "「그래도…… 타쿠루 오빠가 원한다면, 오빠만의 아이돌이 돼도…… 괜찮아」"},
{"id": "clkn01:38500", "ko": "「유……」"},
{"id": "clkn01:38600", "ko": "「유이이이이이이이이이!!」"},
{"id": "clkn01:38700", "ko": "「뭐, 뭐야!? 갑자기?」"},
{"id": "clkn01:38800", "ko": "「어?」"},
{"id": "clkn01:38900", "ko": "「갑자기 큰 소리로 부르니까 깜짝 놀랐잖아」"},
{"id": "clkn01:39000", "ko": "「아……」"},
{"id": "clkn01:39100", "ko": "아차…… 또 망상에 빠져 버렸다."},
{"id": "clkn01:39200", "ko": "「그래서, 뭔데?」"},
{"id": "clkn01:39300", "ko": "「아, 아니…… 그…… 텔레비전은…… 나중에 봐라……」"},
{"id": "clkn01:39400", "ko": "「에에에에」"},
{"id": "clkn01:39500", "ko": "「안 돼, 유토. 모처럼 타쿠루가 돌아왔잖아. 오늘은 다 같이 이야기하자. 유이도, 알았지?」"}
]
