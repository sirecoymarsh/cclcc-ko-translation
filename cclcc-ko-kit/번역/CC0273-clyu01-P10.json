[
{"id": "clyu01:89500", "ko": "졸린 눈을 비비며 유토가 방 앞에 서 있었다."},
{"id": "clyu01:89600", "ko": "「아, 미안, 유. 깨웠지?」"},
{"id": "clyu01:89700", "ko": "「아니, 괜찮아」"},
{"id": "clyu01:89800", "ko": "천진한 얼굴로 고개를 끄덕인 유토는, 유이가 머리를 쓰다듬어 주자 수줍은 듯한 웃음을 지었다."},
{"id": "clyu01:89900", "ko": "그 모습을 본 순간, 내 머릿속에 번개가 내리쳤다."},
{"id": "clyu01:90000", "ko": "「이거다!!!!!」"},
{"id": "clyu01:90100", "ko": "「어?」"},
{"id": "clyu01:90200", "ko": "「뭐, 뭐야?」"},
{"id": "clyu01:90300", "ko": "「후후후…… 된다, 이거라면 된다!! 하~하하하!」"},
{"id": "clyu01:90400", "ko": "「타, 타쿠루 씨…… 왜 그러는 걸까요?」"},
{"id": "clyu01:90500", "ko": "「……글쎄?」"},
{"id": "clyu01:90600", "ko": "내가 생각해도 내 번뜩임이 무섭다."},
{"id": "clyu01:90700", "ko": "어쩌면 아까의 망상이 영향을 준 건지도 모른다."},
{"id": "clyu01:90800", "ko": "그렇다면 내 망상벽도 쓸모가 있을 때가 있다는 거다."},
{"id": "clyu01:90900", "ko": "「유이. 오늘부터 너는 아이돌이다!」"},
{"id": "clyu01:91000", "ko": "「어? 뭐야, 갑자기?」"},
{"id": "clyu01:91100", "ko": "「그리고 유토! 너도다!」"},
{"id": "clyu01:91200", "ko": "「……?」"},
{"id": "clyu01:91300", "ko": "「모르겠어? 오늘부터 너희 둘은 유이와 유. 자매 유닛으로 아이돌 활동을 시작하는 거다!!」"},
{"id": "clyu01:91400", "ko": "「자매?」"},
{"id": "clyu01:91500", "ko": "「???」"},
{"id": "clyu01:91600", "ko": "「그건………… 뭐어어어어어어어어?」"},
{"id": "clyu01:91700", "ko": "유토와 우키는 이해가 따라가지 못하는지 어리둥절해했지만, 유이는 금방 내가 하려는 말을 알아들은 모양이다."},
{"id": "clyu01:91800", "ko": "「자매라는 건, 유도 여자애가 된다는 거야?」"},
{"id": "clyu01:91900", "ko": "「어? 내가 여자애? 그런 거 싫어!」"},
{"id": "clyu01:92000", "ko": "「아니, 유토…… 너라면 될 수 있어! 내가 장담하지」"},
{"id": "clyu01:92100", "ko": "「그런 거 장담해 주지 않아도 돼~」"},
{"id": "clyu01:92200", "ko": "「그래도, 그렇구나…… 나도 유가 같이 하면 든든할지도……」"},
{"id": "clyu01:92300", "ko": "유이가 툭 중얼거리자, 유토는 나와 유이의 얼굴을 번갈아 보며 쩔쩔맸다."},
{"id": "clyu01:92400", "ko": "「있잖아, 유…… 같이 아이돌 활동…… 해 줄래?」"},
{"id": "clyu01:92500", "ko": "「누나……」"},
{"id": "clyu01:92600", "ko": "늘 유토에게 부탁할 때는 강하게 나가던 유이도 이때만큼은 달랐다."},
{"id": "clyu01:92700", "ko": "평소엔 잘 보이지 않던, 애원하는 듯한 유이의 태도에 유토는 눈에 띄게 당황하는 것 같았다."},
{"id": "clyu01:92800", "ko": "여기서…… 분명 한 번만 더 밀어붙이면 넘어올…… 거다!"},
{"id": "clyu01:92900", "ko": "「있잖아, 우키는 어떻게 생각해? 유토한테는 무리일 것 같아?」"},
{"id": "clyu01:93000", "ko": "「저, 저요? 그게…… 저는 괜찮다고 생각해요. 적어도 제가 하는 것보다는……」"},
{"id": "clyu01:93100", "ko": "「우키 누나까지……」"},
{"id": "clyu01:93200", "ko": "「있잖아, 유토」"},
{"id": "clyu01:93300", "ko": "나는 유토의 어깨에 팔을 두르고 귓가에 대고 설득했다."},
{"id": "clyu01:93400", "ko": "「만약 아이돌 활동으로 성공하면, 갖고 싶은 거 뭐든지 살 수 있다?」"},
{"id": "clyu01:93500", "ko": "「……뭐든지?」"},
{"id": "clyu01:93600", "ko": "「그래……」"},
{"id": "clyu01:93700", "ko": "「……⟦col:280aa02d1400⟧프리스테이션 4⟦col:800000⟧도?」", "note": "プリステ４ = 플레이스테이션 4 패러디"},
{"id": "clyu01:93800", "ko": "「물론이지! ⟦col:280aa02d1400⟧프리스테이션 베다⟦col:800000⟧도 살 수 있어!」", "note": "プリステ・ヴェーダ = 플레이스테이션 비타 패러디"},
{"id": "clyu01:93900", "ko": "「…………」"},
{"id": "clyu01:94000", "ko": "「어때, 유토. 해 보지 않을래?」"},
{"id": "clyu01:94100", "ko": "「우……」"},
{"id": "clyu01:94200", "ko": "유토는 그래도 고민하는 것 같았지만, 이윽고……"},
{"id": "clyu01:94300", "ko": "「알았어…… 나, 해 볼게! 누나를 위해서!」"},
{"id": "clyu01:94400", "ko": "「정말?!」"},
{"id": "clyu01:94500", "ko": "「응!」"},
{"id": "clyu01:94600", "ko": "「유!」"},
{"id": "clyu01:94700", "ko": "「아, 아파 누나」"},
{"id": "clyu01:94800", "ko": "유이가 유토를 꼭 끌어안자, 유토는 쑥스러운 듯 말했다."},
{"id": "clyu01:94900", "ko": "그걸 보며 나는 생각했다."},
{"id": "clyu01:95000", "ko": "（이거라면 된다――!!）"},
{"id": "clyu01:95100", "ko": "――라고."},
{"id": "clyu01:95200", "ko": "만약 두 사람의 아이돌 활동이 되도록 많은 사람들에게 지지받아, 그 결과 영상 조회 수가 올라간다면……"},
{"id": "clyu01:95300", "ko": "두 사람을 홍보 매체 삼아 우리 헤키호 학원 신문부의 이름을 알리고, 우리의 존재와 활동도 더 많은 사람에게 인정받을지도 모른다."},
{"id": "clyu01:95400", "ko": "그래! 좋아! 좋다고!"},
{"id": "clyu01:95500", "ko": "멋진 비전! 그야말로 일석이조 아닌가!"},
{"id": "clyu01:95600", "ko": "「아, 맞다…… 둘 다. 거듭 말해 두는데, 이 일은 쿠루스한테는 비밀이다」"},
{"id": "clyu01:95700", "ko": "「응, 알아」"},
{"id": "clyu01:95800", "ko": "역시 유이는 그쯤은 이해하는 것 같았지만……"},
{"id": "clyu01:95900", "ko": "「노노 누나한테는 말하면 안 돼?」"},
{"id": "clyu01:96000", "ko": "이쪽은 그렇지도 않은 모양이었다."},
{"id": "clyu01:96100", "ko": "「쿠루스는 설득하는 데 시간이 걸리니까. 어느 정도 결과를 내고 나서가 아니면 절대 반대할 거야」"},
{"id": "clyu01:96200", "ko": "「노노 언니는 고지식하니까」"},
{"id": "clyu01:96300", "ko": "반대만 하면 그나마 낫다."},
{"id": "clyu01:96400", "ko": "거기에 내가 관여하고 있다는 걸 노노가 알기라도 해 봐라."},
{"id": "clyu01:96500", "ko": "대체 어떤 일이 벌어질지……"},
{"id": "clyu01:96600", "ko": "「알았어. 노노 누나한테는 말 안 할게」"},
{"id": "clyu01:96700", "ko": "「우키도, 알았지?」"},
{"id": "clyu01:96800", "ko": "「그게……」"},
{"id": "clyu01:96900", "ko": "아무래도 우키는 신세 지고 있는 노노에게 비밀로 한다는 데 꺼림칙함을 느끼는 모양이다."},
{"id": "clyu01:97000", "ko": "「걱정 마. 그 녀석한테는 적당한 때를 봐서 내가 제대로 말할 테니까」"},
{"id": "clyu01:97100", "ko": "「알겠어요」"},
{"id": "clyu01:97200", "ko": "조금 불안해하던 우키도 겨우 납득해 준 것 같다."},
{"id": "clyu01:97300", "ko": "「그럼 다시 한번, 잘 부탁드립니다. ⟦col:280aa02d1400⟧프로듀서⟦col:800000⟧님!」"},
{"id": "clyu01:97400", "ko": "얘기가 다 끝나자, 유이가 나를 올려다보고 고개를 숙였다."},
{"id": "clyu01:97500", "ko": "「프로듀서……?」"},
{"id": "clyu01:97600", "ko": "「응. 아이돌을 돌봐 주는 사람을 “프로듀서”라고 하잖아? 그러니까 타쿠루 오빠가 프로듀서」"},
{"id": "clyu01:97700", "ko": "내가…… 프로듀서."},
{"id": "clyu01:97800", "ko": "「부탁드려요, 프로듀서님」"},
{"id": "clyu01:97900", "ko": "프로듀서……"},
{"id": "clyu01:98000", "ko": "응, 나쁘지 않을지도 모른다."},
{"id": "clyu01:98100", "ko": "게다가 만약 이 계획이 순조롭게 진행돼서 두 사람이 아이돌로 인기를 얻기라도 하면……"},
{"id": "clyu01:98200", "ko": "그러면 나도 프로듀서로서 일약 유명인이!"},
{"id": "clyu01:98300", "ko": "아, 아니. 나는 딱히 유명해지고 싶은 게 아니다."},
{"id": "clyu01:98400", "ko": "그저 맏이로서, 두 사람의 미래를 위해 협력해 줄 뿐이다."},
{"id": "clyu01:98500", "ko": "그래도……"},
{"id": "clyu01:98600", "ko": "「봐 봐, 저기, 저 사람……」"},
{"id": "clyu01:98700", "ko": "「와! 미야시로 프로듀서 맞지? 수많은 일류 아이돌을 키워 냈다는」"},
{"id": "clyu01:98800", "ko": "「나도 프로듀스 받고 싶다~」"},
{"id": "clyu01:98900", "ko": "「바보야. 너 같은 건 프로듀스해 줘도 뜰 리가 없잖아. 그보다 내가」"},
{"id": "clyu01:99000", "ko": "「아니, 나야!」"},
{"id": "clyu01:99100", "ko": "「무슨 소리야. 나야!!」"},
{"id": "clyu01:99200", "ko": "（정말이지. 곤란하다니까……）"},
{"id": "clyu01:99300", "ko": "요즘은 잠깐 걷기만 해도 다들 이렇다."},
{"id": "clyu01:99400", "ko": "너희 같은 아무 장점도 없는 여자애들을 내가 상대해 줄 거라고 생각하는 건가?"}
]
