[
{"id": "clse07:607300", "ko": "「……일단 신조 씨한테라도 상담해 볼게……」"},
{"id": "clse07:607400", "ko": "「센리?」"},
{"id": "clse07:607500", "ko": "「어쩔 수 없지……」"},
{"id": "clse07:607600", "ko": "「잘 자, 센리……」"},
{"id": "clse07:607700", "ko": "「그렇…… 군요」"},
{"id": "clse07:607800", "ko": "「왜 쿠노사토 씨까지 와 있는 거예요?」"},
{"id": "clse07:607900", "ko": "「그만하세요, 구경거리도 아니고」"},
{"id": "clse07:608000", "ko": "「아아, 잠깐, 그렇게 만지면――」"},
{"id": "clse07:608100", "ko": "「쿠노사토 씨가 울렸으니까, 쿠노사토 씨가 어떻게 좀 해 보세요」"},
{"id": "clse07:608200", "ko": "「안아 주면 그치지 않을까요?」"},
{"id": "clse07:608300", "ko": "「그거 말고 누가 있는데요」"},
{"id": "clse07:608400", "ko": "「그러니까 쿠노사토 씨가 울렸잖아요」"},
{"id": "clse07:608500", "ko": "「헤에. 쿠노사토 씨나 되는 사람이, 나도 할 수 있는 걸 못 하다니……」"},
{"id": "clse07:608600", "ko": "「목 뒤를 제대로 받쳐 주세요」"},
{"id": "clse07:608700", "ko": "「그렇게 굳어 있으면 안 돼요. 그리고, 살살 흔들어 준다든가」"},
{"id": "clse07:608800", "ko": "「그다음은 웃는 얼굴이에요, 웃는 얼굴」"},
{"id": "clse07:608900", "ko": "「좀 더 웃어요」"},
{"id": "clse07:609000", "ko": "「아아, 꽤 볼만했어」"},
{"id": "clse07:609100", "ko": "「놀리지 마. 나도 그 정도는 할 수 있어」"},
{"id": "clse07:609200", "ko": "「어?」"},
{"id": "clse07:609300", "ko": "「노, 노노…… 너, 무슨 소리 하는 거야?」"},
{"id": "clse07:609400", "ko": "「분유지?」"},
{"id": "clse07:609500", "ko": "「자, 분유」"},
{"id": "clse07:609600", "ko": "「왜 그러지?」"},
{"id": "clse07:609700", "ko": "「…………」"},
{"id": "clse07:609800", "ko": "「…………」"},
{"id": "clse07:609900", "ko": "「뭐!?」"},
{"id": "clse07:610000", "ko": "「…………!」"},
{"id": "clse07:610100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:610200", "ko": "「뭐!?」"},
{"id": "clse07:610300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:610400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:610500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:610600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:610700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:610800", "ko": "「헉!?」"},
{"id": "clse07:610900", "ko": "「미, 미안해요!」"},
{"id": "clse07:611000", "ko": "「아, 아니…… 아무것도 아니야. 아무것도……」"},
{"id": "clse07:611100", "ko": "「노노!」"},
{"id": "clse07:611200", "ko": "「히카리를…… 안게 해 주지 않을래?」"},
{"id": "clse07:611300", "ko": "「됐으니까, 히카리를 이리 줘」"},
{"id": "clse07:611400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:611500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:611600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:611700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:611800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:611900", "ko": "「헉!?」"},
{"id": "clse07:612000", "ko": "「아, 아아……」"},
{"id": "clse07:612100", "ko": "「말해 두는데, 나는 젖 안 줄 거니까」"},
{"id": "clse07:612200", "ko": "「…………」"},
{"id": "clse07:612300", "ko": "「정말 괜찮아?」"},
{"id": "clse07:612400", "ko": "「알았어……」"},
{"id": "clse07:612500", "ko": "「우리 집에 아기가 있다는 걸 들키지 않게, 지? 그렇게 몇 번이나 말 안 해도 안다니까」"},
{"id": "clse07:612600", "ko": "「응……」"},
{"id": "clse07:612700", "ko": "「챙겼어」"},
{"id": "clse07:612800", "ko": "「…………」"},
{"id": "clse07:612900", "ko": "「무, 무슨 소리야! 왜 내가 아빠인데!」"},
{"id": "clse07:613000", "ko": "「읏…… 알고 있어」"},
{"id": "clse07:613100", "ko": "「다, 다녀왔어……」"},
{"id": "clse07:613200", "ko": "「나는 비밀로 하려고 노력은 했어……」"},
{"id": "clse07:613300", "ko": "「아니, 남자애야」"},
{"id": "clse07:613400", "ko": "「이토, 너……」"},
{"id": "clse07:613500", "ko": "「알아」"},
{"id": "clse07:613600", "ko": "「자」"},
{"id": "clse07:613700", "ko": "「왜, 왜 그렇게 되는 건데!」"},
{"id": "clse07:613800", "ko": "「아니, 그러니까, 왜 그런 얘기가 되는 건데! 쿠루스도 쿠루스지, 『그럴까?』가 아니잖아」"},
{"id": "clse07:613900", "ko": "「그럴 리가 없잖아」"},
{"id": "clse07:614000", "ko": "「뭐!」"},
{"id": "clse07:614100", "ko": "「바, 바보야, 아리무라! 이럴 때 능력 쓰지 마!」"},
{"id": "clse07:614200", "ko": "「…………」"},
{"id": "clse07:614300", "ko": "「유이라면 방에서 숙제하고 있어. 잔뜩 있는 걸 잊고 있었대」"},
{"id": "clse07:614400", "ko": "「마찬가지……」"},
{"id": "clse07:614500", "ko": "「그, 그렇게 몇 번이나 말 안 해도 알고 있다니까」"},
{"id": "clse07:614600", "ko": "「으, 응……」"},
{"id": "clse07:614700", "ko": "（어라?）"},
{"id": "clse07:614800", "ko": "「아니라니, 뭐가?」"},
{"id": "clse07:614900", "ko": "「우와아아아아앗!!! 미, 미안!!」"},
{"id": "clse07:615000", "ko": "「아, 알았어!」"},
{"id": "clse07:615100", "ko": "「…………」"},
{"id": "clse07:615200", "ko": "「아…… 미안미안, 추웠지」"},
{"id": "clse07:615300", "ko": "「오늘도 괜찮아?」"},
{"id": "clse07:615400", "ko": "「그럼 다녀올게」"},
{"id": "clse07:615500", "ko": "「알았어. 그럼 끝나면 연락할게」"},
{"id": "clse07:615600", "ko": "「우와……」"},
{"id": "clse07:615700", "ko": "（잘 먹겠습니다）"},
{"id": "clse07:615800", "ko": "「어?」"},
{"id": "clse07:615900", "ko": "「카와하라……」"},
{"id": "clse07:616000", "ko": "「아……」"},
{"id": "clse07:616100", "ko": "「저기…… 무슨, 일인데요?」"},
{"id": "clse07:616200", "ko": "「아, 응…… 인플루엔자라서, 나아도 바로 나올 수는 없고……」"},
{"id": "clse07:616300", "ko": "「그, 그치만…… 나랑 쿠루스는 남매니까……」"},
{"id": "clse07:616400", "ko": "「저, 저기…… 아직 뭔가……」"},
{"id": "clse07:616500", "ko": "「……너, 와 있었으면 들어오지 그랬어」"},
{"id": "clse07:616600", "ko": "「……별거 아니야, 쿠루스 얘기야」"},
{"id": "clse07:616700", "ko": "「쉬어. 그러니까 오늘도 동아리 활동은 없어」"},
{"id": "clse07:616800", "ko": "「왜 점심시간까지 네가 여기 오는 거냐, 아리무라」"},
{"id": "clse07:616900", "ko": "「몰라, 그런 거」"},
{"id": "clse07:617000", "ko": "「확실히……」"},
{"id": "clse07:617100", "ko": "「뭐, 그런 건 일종의 열병 같은 거겠지」"},
{"id": "clse07:617200", "ko": "「야야, 아직도 다른 가게에 들르는 거야? 그럴 거면 아까 가게에서 다 사 두면 되지 않았어?」"}
]
