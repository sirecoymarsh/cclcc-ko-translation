[
{"id": "clkn16:30000", "ko": "젠장! 뭐야, 바보 자식들."},
{"id": "clkn16:30100", "ko": "이런 건…… 기대했던 것 이상이잖아……"},
{"id": "clkn16:30200", "ko": "「하하…… 들었어, 센리? 다들 너를 인정해 줬어」"},
{"id": "clkn16:30300", "ko": "「응……」"},
{"id": "clkn16:30400", "ko": "지금까지 그 애가 해 온 일은 틀리지 않았던 거다."},
{"id": "clkn16:30500", "ko": "알아…… 줬구나."},
{"id": "clkn16:30600", "ko": "「타쿠루…… 울어?」"},
{"id": "clkn16:30700", "ko": "「우, 울 리가 없잖아. 그러는 센리야말로」"},
{"id": "clkn16:30800", "ko": "「그치만…… 기뻐서……」"},
{"id": "clkn16:30900", "ko": "센리는 뺨을 타고 흘러내리는 맑은 눈물방울을 닦으며 미소 지었다."},
{"id": "clkn16:31000", "ko": "「그래도 조금 기분이 복잡하네……」"},
{"id": "clkn16:31100", "ko": "「뭐, 이 정도는 받아들여야지……」"},
{"id": "clkn16:31200", "ko": "「여제! 여제! 여제!!」⟦n⟧⟦par⟧「여제! 여제! 여제!!」⟦n⟧⟦par⟧「여제! 여제! 여제!!」"},
{"id": "clkn16:31300", "ko": "「우~……」"},
{"id": "clkn16:31400", "ko": "「야, 아리무라, 너 왜 울어?」"},
{"id": "clkn16:31500", "ko": "「아, 안 울었거든요! 우는 거 아니거든요. 이토 선배, 바보!」"},
{"id": "clkn16:31600", "ko": "「어…… 왜?」"},
{"id": "clkn16:31700", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:31800", "ko": "「어?」"},
{"id": "clkn16:31900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32200", "ko": "「아, 아니야, 그건 그러니까……!」"},
{"id": "clkn16:32300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32400", "ko": "「아니, 지금 거기서 그 태클을 걸어!?」"},
{"id": "clkn16:32500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32600", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32700", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32800", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:32900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:33000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:33100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:33200", "ko": "으…… 기세에 휩쓸려서 나는 엄청나게 창피한 짓을 해 버린 게 아닐까."},
{"id": "clkn16:33300", "ko": "모처럼 의혹이 풀려서 퇴학은 면했는데, 앞으로 학교에 올 자신이 없다."},
{"id": "clkn16:33400", "ko": "뭐, 그래도……"},
{"id": "clkn16:33500", "ko": "「후훗…… 기뻤어, 타쿠루. 고마워」"},
{"id": "clkn16:33600", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:33700", "ko": "「음……」"},
{"id": "clkn16:33800", "ko": "「응? 카즈키, 왜 그래?」"},
{"id": "clkn16:33900", "ko": "「응……」"},
{"id": "clkn16:34000", "ko": "「어? 카와하라?」"},
{"id": "clkn16:34100", "ko": "「아…… 아아…… 아아아……」"},
{"id": "clkn16:34200", "ko": "「아~ 글렀네. 충격받은 나머지 선 채로 기절했어……」"},
{"id": "clkn16:34300", "ko": "「근데 말이야~ 이거 그 말도 안 되는 교칙도 무효라는 걸로 봐도 되나?」"},
{"id": "clkn16:34400", "ko": "「응? 음~ 그런 거 아닐까?」"},
{"id": "clkn16:34500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:34600", "ko": "「한 방이라니?」"},
{"id": "clkn16:34700", "ko": "또 아리무라 녀석이 뭔가 이상한 소리를 꺼냈다."},
{"id": "clkn16:34800", "ko": "이럴 때는 꼭 좋은 일이 없다."},
{"id": "clkn16:34900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:35000", "ko": "역시!!"},
{"id": "clkn16:35100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:35200", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:35300", "ko": "뭐야, 아까부터 이 단결력은!?"},
{"id": "clkn16:35400", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:35500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:35600", "ko": "「워워워, 신지 진정해」"},
{"id": "clkn16:35700", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:35800", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:35900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:36000", "ko": "「으……」"},
{"id": "clkn16:36100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:36200", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:36300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:36400", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:36500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:36600", "ko": "「…………」"},
{"id": "clkn16:36700", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn16:36800", "ko": "「……라니, 할 수 있겠냐아아아아아아아아!!」"},
{"id": "clkn16:36900", "ko": "「센리!」"},
{"id": "clkn16:37000", "ko": "「응!」"},
{"id": "clkn16:37100", "ko": "「아아아아, 도망쳤다아아!!」"},
{"id": "clkn16:37200", "ko": "나는 센리의 손을 잡고 달려 나갔다."},
{"id": "clkn16:37300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
