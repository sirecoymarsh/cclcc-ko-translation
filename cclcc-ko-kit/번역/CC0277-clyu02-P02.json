[
{"id": "clyu02:9600", "ko": "「그렇지. 우선 내가 내 방식대로 프로듀스해 주마」"},
{"id": "clyu02:9700", "ko": "뭔가 이상한 방향으로 얘기가 흘러가기 시작했는데!"},
{"id": "clyu02:9800", "ko": "「그런 얼굴 하지 말라니까. 뭐, 속는 셈 치고 맡겨 주면 돼」"},
{"id": "clyu02:9900", "ko": "흠……"},
{"id": "clyu02:10000", "ko": "막혀 있던 건 사실이고, 게다가 나 혼자 생각해 봤자 나올 아이디어는 뻔하다."},
{"id": "clyu02:10100", "ko": "그렇다면 지금은 믿어 보는 것도 나쁘지 않을지도 모른다."},
{"id": "clyu02:10200", "ko": "「우~……」"},
{"id": "clyu02:10300", "ko": "유이나 유토를 부실에 데려왔다가는 노노가 왔을 때 얼버무리지 못할지도 모른다는 이유로, 우리는 장소를 트레일러 하우스로 옮겼다…… 까지는 좋았는데……"},
{"id": "clyu02:10400", "ko": "「좁아…… 일지도……」"},
{"id": "clyu02:10500", "ko": "「진짜로요. 미야시로 선배, 좀 더 넓은 데로 이사해 주면 안 돼요?」"},
{"id": "clyu02:10600", "ko": "「무리한 소리 하지 마. 애초에 이런 건 생각도 안 했으니까」"},
{"id": "clyu02:10700", "ko": "「그보다, 타쿠루 오빠, 이런 데서 살고 있었구나」"},
{"id": "clyu02:10800", "ko": "「차 안에서라니, 좋겠다~」"},
{"id": "clyu02:10900", "ko": "그러고 보니 두 사람을 여기 들인 건 처음이었지."},
{"id": "clyu02:11000", "ko": "「어흠. 그런 고로, 우선 내가 너희 프로듀스를 맡게 됐다」"},
{"id": "clyu02:11100", "ko": "「네…… 이토 씨가요~?」"},
{"id": "clyu02:11200", "ko": "「으…… 유이까지 미야시로 같은 반응……」"},
{"id": "clyu02:11300", "ko": "「아~, 아뇨, 죄송해요. 부탁드려요, 이토 ⟦col:280aa02d1400⟧프로듀서⟦col:800000⟧」"},
{"id": "clyu02:11400", "ko": "「부탁드려요, 이토 프로듀서」"},
{"id": "clyu02:11500", "ko": "음……"},
{"id": "clyu02:11600", "ko": "「프로듀서…… 으~음, 좋은 울림!」"},
{"id": "clyu02:11700", "ko": "「…………」"},
{"id": "clyu02:11800", "ko": "「어라? 타쿠, 왜 그래? 혹시 신지가 프로듀서라고 불려서 좀 질투하는 거야?」"},
{"id": "clyu02:11900", "ko": "「왜, 왜 내가 이토한테 질투 같은 걸 해야 하는데……」"},
{"id": "clyu02:12000", "ko": "「자자, 부끄러워할 거 없잖아~」"},
{"id": "clyu02:12100", "ko": "「딱히 부끄러워하는 거 아니거든!」"},
{"id": "clyu02:12200", "ko": "그래. 내가 이토한테 질투라니……"},
{"id": "clyu02:12300", "ko": "「자 그럼, 바로 앞으로의 계획을…… 이라고 하고 싶지만, 우선 맨 처음에 확인해 둬야 할 게 있다. 알지?」"},
{"id": "clyu02:12400", "ko": "「그 말은, 그거로군요?」"},
{"id": "clyu02:12500", "ko": "「그래, 그거다」"},
{"id": "clyu02:12600", "ko": "이토와 아리무라는 눈짓을 주고받으며 서로 고개를 끄덕였다."},
{"id": "clyu02:12700", "ko": "「응? 그거?」"},
{"id": "clyu02:12800", "ko": "「그래! 유토가 여자애로 통하는지 어떤지 확인이다!!」"},
{"id": "clyu02:12900", "ko": "……그러고 보니 그렇다."},
{"id": "clyu02:13000", "ko": "평소 유토의 모습만 보고 나는 멋대로 괜찮을 거라고 생각했지만, 실제로 여장을 해 보면…… 하는 일은 흔하다."},
{"id": "clyu02:13100", "ko": "전에 학교 축제에서 귀여운 타입이라고 불리던 남자애에게 여장을 시켰더니 역시 아무리 봐도 남자라서 다들 실망한…… 일도 있었다."},
{"id": "clyu02:13200", "ko": "「유이, 그거 가져왔어?」"},
{"id": "clyu02:13300", "ko": "「아, 네. 일단은……」"},
{"id": "clyu02:13400", "ko": "그렇게 말하며 유이는 손에 들고 있던 종이봉투를 내밀었다."},
{"id": "clyu02:13500", "ko": "아무래도 아리무라 녀석, 미리 유이한테 연락해서 옷을 가져오게 한 모양이다."},
{"id": "clyu02:13600", "ko": "그보다 언제 유이 연락처를 물어본 거야?"},
{"id": "clyu02:13700", "ko": "정말 빈틈없는 녀석."},
{"id": "clyu02:13800", "ko": "「오케이 오케이. 그럼 남자분들은 일단 나가 주실까요~」"},
{"id": "clyu02:13900", "ko": "「뭐? 왜?」"},
{"id": "clyu02:14000", "ko": "「갈아입으니까 당연하잖아」"},
{"id": "clyu02:14100", "ko": "「뭐야? 딱히 남자끼리니까 괜찮잖아?」"},
{"id": "clyu02:14200", "ko": "「하아…… 그런 의식부터가 글러 먹었슴다~. 앞으로 여자애로 팔아 나갈 거잖아? 그럼 여자애로 대해야지」"},
{"id": "clyu02:14300", "ko": "……그런 건가?"},
{"id": "clyu02:14400", "ko": "「자자, 알았으면 나가. 이토 선배도」"},
{"id": "clyu02:14500", "ko": "「으응~!」"},
{"id": "clyu02:14600", "ko": "「어, 어어……」"},
{"id": "clyu02:14700", "ko": "카즈키가 등을 떠미는 바람에 우리는 밖으로 쫓겨나고 말았다."},
{"id": "clyu02:14800", "ko": "「…………」"},
{"id": "clyu02:14900", "ko": "「…………」"},
{"id": "clyu02:15000", "ko": "그로부터 족히 15분 정도…… 내 방 안에서 꺄아꺄아 하는 높은 목소리가 터져 나오는 가운데, 우리는 그저 하염없이 기다려야 했고."},
{"id": "clyu02:15100", "ko": "그리고――"},
{"id": "clyu02:15200", "ko": "「타쿠~. 신지~, 준비 다 됐어~」"},
{"id": "clyu02:15300", "ko": "겨우 안으로 들어가도 된다는 허락이 떨어졌다."},
{"id": "clyu02:15400", "ko": "「응후후~」"},
{"id": "clyu02:15500", "ko": "안에 들어가 보니, 아리무라를 비롯한 여자들이 만든 벽 뒤에 유토가 숨어 있는 것 같았다."},
{"id": "clyu02:15600", "ko": "정말이지, 뜸 들이기는."},
{"id": "clyu02:15700", "ko": "말해 두지만, 상대는 유토라고?"},
{"id": "clyu02:15800", "ko": "아무리 여자애 차림을 했다고 해도, 그렇게 쉽게 놀랄 리가 없잖아."},
{"id": "clyu02:15900", "ko": "「그럼, 유토에서 이름을 바꾼 유의 등장입니다. 자, 나오세요~!」"},
{"id": "clyu02:16000", "ko": "구령에 맞춰 여자들이 일제히 양옆으로 비켜서자, 그 안쪽에서 뒤돌아 있던 유토가 휙 돌아섰다."},
{"id": "clyu02:16100", "ko": "「뭐……」"},
{"id": "clyu02:16200", "ko": "「호……」"},
{"id": "clyu02:16300", "ko": "순간, 내 트레일러 하우스 안에 가련한 꽃잎이 흩날린 것 같은 기분이 들었다."},
{"id": "clyu02:16400", "ko": "「우~……」"},
{"id": "clyu02:16500", "ko": "부끄러운 듯 쭈뼛쭈뼛 두 무릎을 비비는 유토."},
{"id": "clyu02:16600", "ko": "그 모습이 귀여움을 한층 더 돋보이게 했다."},
{"id": "clyu02:16700", "ko": "「어떰까 어떰까?」"},
{"id": "clyu02:16800", "ko": "「이건……」"},
{"id": "clyu02:16900", "ko": "「예상 이상이군……」"},
{"id": "clyu02:17000", "ko": "「그렇지~. 어디서 어떻게 봐도 여자애야~」"},
{"id": "clyu02:17100", "ko": "「……응!」"},
{"id": "clyu02:17200", "ko": "「너, 너무 빤히 보지 마~. 부끄러워~」"},
{"id": "clyu02:17300", "ko": "「그보다 가발은 어디서 가져온 거야?」"},
{"id": "clyu02:17400", "ko": "「당근, 연극부 애한테 빌려 왔어요」"},
{"id": "clyu02:17500", "ko": "언제 그랬대…… 정말 빈틈없는 녀석."},
{"id": "clyu02:17600", "ko": "그런데 설마 머리 모양과 옷만 바꿨는데 이렇게까지 여자애처럼 보일 줄이야……"},
{"id": "clyu02:17700", "ko": "역시 내 안목은 틀리지 않았다."},
{"id": "clyu02:17800", "ko": "「그게…… 나, 괜찮을까?」"},
{"id": "clyu02:17900", "ko": "「괜찮고말고. 완전 완전 완전 괜찮아!」"},
{"id": "clyu02:18000", "ko": "「그러고 보니~, 역시 자기를 가리킬 때는 여자애답게 말투도 바꾸는 게 좋으려나?」", "note": "원문은 1인칭 「僕」를 여자애다운 「私」로 바꿀지의 얘기 — 한국어 1인칭엔 성별 구분이 없어 「말투」로 옮김(18200·18300도 같음)"},
{"id": "clyu02:18100", "ko": "「에엣? 그런 거 나 못 해~」"},
{"id": "clyu02:18200", "ko": "「아니, 지금처럼 말해도 되지 않아?」"},
{"id": "clyu02:18300", "ko": "「그러게. 무리하는 것보다 ⟦col:280aa02d1400⟧보이시한 말투⟦col:800000⟧로 밀고 나가는 게 나아」", "note": "「僕っ子」(자기를 僕라고 부르는 여자 캐릭터) → 「보이시한 말투」"},
{"id": "clyu02:18400", "ko": "「다행이다아……」"},
{"id": "clyu02:18500", "ko": "그나저나 익숙해진다는 건 무서운 일이다."},
{"id": "clyu02:18600", "ko": "본 순간에는 유토가 여자애 차림을 하고 있는 게 어색했지만, 불과 몇 분 만에 벌써 익숙해지고 있었다."},
{"id": "clyu02:18700", "ko": "「그러고 보니, 두 사람 유닛 이름은 벌써 정했어?」"},
{"id": "clyu02:18800", "ko": "「에헤헤…… 그건 어제 자기 전에 열심히 생각했어. 그치?」"},
{"id": "clyu02:18900", "ko": "「으, 응」"},
{"id": "clyu02:19000", "ko": "둘이서 생각한 것처럼 말하지만, 아마 유이가 정했겠지."},
{"id": "clyu02:19100", "ko": "「우리 유닛 이름은~. 하나, 둘!」"},
{"id": "clyu02:19200", "ko": "「『⟦col:280aa02d1400⟧밀푀유⟦col:800000⟧』예요」⟦n⟧⟦par⟧「밀푀유, 예요」"},
{"id": "clyu02:19300", "ko": "「『밀푀유』라. 흐음…… 나쁘지 않은 이름이잖아」"},
{"id": "clyu02:19400", "ko": "「그치 그치?」"},
{"id": "clyu02:19500", "ko": "유이가 생각한 이름이 칭찬받아서인지, 유토도 왠지 기뻐 보였다."}
]
