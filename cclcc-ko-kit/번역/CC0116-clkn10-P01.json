[
{"id": "clkn10:0", "ko": "다음 날."},
{"id": "clkn10:100", "ko": "「정말 괜찮겠어?」"},
{"id": "clkn10:200", "ko": "「응. 둘 다 쉴 수는 없잖아. 그러니까 학교에는 ⟦col:280aa02d1400⟧독감⟦col:800000⟧이라고 해 둘게」"},
{"id": "clkn10:300", "ko": "일단 아버지가 돌아올 때까지 히카리를 혼자 둘 수는 없다."},
{"id": "clkn10:400", "ko": "당연히 어디에 맡길 수도 없으니, 집에서 누군가가 돌보는 수밖에 없다."},
{"id": "clkn10:500", "ko": "그렇다고 유이나 유토, 우키한테 히카리를 맡기고 우리는…… 하는 것도 무리다."},
{"id": "clkn10:600", "ko": "그렇다면 이렇게 되는 건 당연하다면 당연했다."},
{"id": "clkn10:700", "ko": "「그 대신 되도록 빨리 와 줘」"},
{"id": "clkn10:800", "ko": "「알았어……」"},
{"id": "clkn10:900", "ko": "「그리고 학교 사람들한테는……」"},
{"id": "clkn10:1000", "ko": "「우리 집에 아기가 있다는 거 들키지 않게, 지? 그렇게 몇 번이나 말 안 해도 안다니까」"},
{"id": "clkn10:1100", "ko": "「그럼 다행이지만……」"},
{"id": "clkn10:1200", "ko": "안 그래도 귀찮은 일이 이것저것 벌어지고 있는 지금, 문제를 더 만들고 싶지 않다."},
{"id": "clkn10:1300", "ko": "「아, 맞다. 도시락은 잘 챙겼어?」"},
{"id": "clkn10:1400", "ko": "「응……」"},
{"id": "clkn10:1500", "ko": "「손수건은?」"},
{"id": "clkn10:1600", "ko": "「챙겼어」"},
{"id": "clkn10:1700", "ko": "「아. 잠깐. 봐, 옷깃 비뚤어졌어」"},
{"id": "clkn10:1800", "ko": "「…………」"},
{"id": "clkn10:1900", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn10:2000", "ko": "「뭐, 무슨 소리야! 내가 왜 아빠야!」"},
{"id": "clkn10:2100", "ko": "「후훗, 그냥 농담이야. 그보다 자, 서두르지 않으면 늦어」"},
{"id": "clkn10:2200", "ko": "「읏…… 알아」"},
{"id": "clkn10:2300", "ko": "「잘 다녀와~」"},
{"id": "clkn10:2400", "ko": "아무튼 지금은 아무 일도 없었던 것처럼 지내는 게 최선이다."},
{"id": "clkn10:2500", "ko": "「다, 다녀왔어……」"},
{"id": "clkn10:2600", "ko": "「어서 와, 타쿠루. 괜찮았어? 아무한테도――」"},
{"id": "clkn10:2700", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:2800", "ko": "「아리무라…… 게다가 다들……」"},
{"id": "clkn10:2900", "ko": "「와 버렸어…… 일지도……」"},
{"id": "clkn10:3000", "ko": "「우와, 진짜 아기가 있잖아. 대박」"},
{"id": "clkn10:3100", "ko": "「이게 어떻게 된 거야, 타쿠루?」"},
{"id": "clkn10:3200", "ko": "「나는 비밀로 하려고 노력은 했어……」"},
{"id": "clkn10:3300", "ko": "「아니~ 미야시로 선배 언행이 수상해서 살~짝 떠봤더니, 대놓고 거짓말을 하고 있길래~ 세리한테 좀 부탁해서~」"},
{"id": "clkn10:3400", "ko": "애초에 아리무라나 오노에 같은 성가신 능력의 소유자들이 있는 그 학교에서, 이런 큰 비밀을 숨기는 건 처음부터 무리였다."},
{"id": "clkn10:3500", "ko": "「미안해~ 노노」"},
{"id": "clkn10:3600", "ko": "「헤헷. 미야시로가 몰래 돌아가려고 하길래 다 같이 뒤를 밟아 왔지」"},
{"id": "clkn10:3700", "ko": "집에 들어가려는 순간 녀석들한테 붙잡혀서 이 꼴이 된 것이다."},
{"id": "clkn10:3800", "ko": "다행이었던 건 노노가 센리의 모습이 아니었다는 점이겠지."},
{"id": "clkn10:3900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:4000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:4100", "ko": "「말해 두지만, 이 아이는 저희 아이가 아니에요」"},
{"id": "clkn10:4200", "ko": "「알아요~. 농담임다, 농담」"},
{"id": "clkn10:4300", "ko": "아리무라는 농담이었을지도 모르지만, 오노에는 분명 진심이었을 것이다."},
{"id": "clkn10:4400", "ko": "「야, 이 아기 여자애냐?」"},
{"id": "clkn10:4500", "ko": "「아니, 남자애야」"},
{"id": "clkn10:4600", "ko": "", "note": "보류 — 아동 대상 연애 농담"},
{"id": "clkn10:4700", "ko": "「음…………」"},
{"id": "clkn10:4800", "ko": "「…………」"},
{"id": "clkn10:4900", "ko": "「어……?」"},
{"id": "clkn10:5000", "ko": "「신지……」"},
{"id": "clkn10:5100", "ko": "「이토, 너……」"},
{"id": "clkn10:5200", "ko": "「경찰 아저씨~ 이 사람이에요~」"},
{"id": "clkn10:5300", "ko": "「아, 아니야, 농담! 농담이라니까!」"},
{"id": "clkn10:5400", "ko": "「아뇨, 방금 그건 거짓말이 아니었어요」"},
{"id": "clkn10:5500", "ko": "「으아아아아아아아아아, 아니라고오오오오, 믿어 줘어어어어어!!」"},
{"id": "clkn10:5600", "ko": "「으앗! 신지가 큰 소리를 내니까 울기 시작했잖아~」"},
{"id": "clkn10:5700", "ko": "「내 탓이냐!? 내 탓이라고?」"},
{"id": "clkn10:5800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn10:5900", "ko": "「응……!?」"},
{"id": "clkn10:6000", "ko": "「음~ 이렇게 우는 건…… 타쿠루」"},
{"id": "clkn10:6100", "ko": "「알아」"},
{"id": "clkn10:6200", "ko": "노노에게 고개를 끄덕이고, 나는 거실 안쪽에 둔 종이 기저귀를 가져왔다."},
{"id": "clkn10:6300", "ko": "그사이 노노는 능숙하게 아기 기저귀를 벗기고 있었다."},
{"id": "clkn10:6400", "ko": "「자」"},
{"id": "clkn10:6500", "ko": "「고마워. 자, 히카리…… 옳지 옳지……」"},
{"id": "clkn10:6600", "ko": "노노가 기저귀를 갈고 안아 주자 아기는 금세 울음을 그쳤다."},
{"id": "clkn10:6700", "ko": "「오오~ 왠지 완전히 엄마 같다, 노노」"},
{"id": "clkn10:6800", "ko": "「응……」"},
{"id": "clkn10:6900", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:7000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:7100", "ko": "「왜, 왜 그렇게 되는 건데!」"},
{"id": "clkn10:7200", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:7300", "ko": "「응……」"},
{"id": "clkn10:7400", "ko": "「부부장은 엄청 극성인 교육 엄마가 될 것 같지 않냐」"},
{"id": "clkn10:7500", "ko": "「그렇지 않아~. 노노는 너그러우니까 꽤 좋은 엄마가 될 것 같은데~」"},
{"id": "clkn10:7600", "ko": "「그럴까?」"},
{"id": "clkn10:7700", "ko": "「아니, 그러니까 왜 그런 얘기가 되는 건데! 쿠루스도 쿠루스지, ‘그럴까?’가 아니잖아」"},
{"id": "clkn10:7800", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:7900", "ko": "「그럴 리가 없잖아」"},
{"id": "clkn10:8000", "ko": "「흐음~?」"},
{"id": "clkn10:8100", "ko": "히죽거리며 아리무라가 내 얼굴을 들여다본다."},
{"id": "clkn10:8200", "ko": "――! 이 녀석, 설마――!"},
{"id": "clkn10:8300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn10:8400", "ko": "「어……?」"},
{"id": "clkn10:8500", "ko": "「뭐!」"},
{"id": "clkn10:8600", "ko": "「타쿠루……」"},
{"id": "clkn10:8700", "ko": "「바, 바보, 아리무라! 이럴 때 능력 쓰지 마!」"},
{"id": "clkn10:8800", "ko": "「믿거나 말거나, 그건 여러분의 몫입니다…… 라나 뭐라나」"},
{"id": "clkn10:8900", "ko": "이 녀석――!"},
{"id": "clkn10:9000", "ko": "「……저, 그게…… 히카리가 졸려 보이니까 재우고 올게!」"},
{"id": "clkn10:9100", "ko": "봐라. 이상한 분위기가 돼 버렸잖아."},
{"id": "clkn10:9200", "ko": "하지만……"},
{"id": "clkn10:9300", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn10:9400", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn10:9500", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn10:9600", "ko": "「…………」"},
{"id": "clkn10:9700", "ko": "밤이 되어도 아리무라가 한 말이 머리에서 떠나지 않았다."},
{"id": "clkn10:9800", "ko": "만약――어디까지나 만약이다."},
{"id": "clkn10:9900", "ko": "", "note": "보류 — 연애 묘사(가족)"}
]
