[
{"id": "clkn13:0", "ko": "「…………」"},
{"id": "clkn13:100", "ko": "――잠이 오지 않는다."},
{"id": "clkn13:200", "ko": "⟦top:76⟧――아무리 눈을 감고 있어도 잠이 오지 않는다."},
{"id": "clkn13:300", "ko": "히카리는 옆에서 새근새근 자고 있다."},
{"id": "clkn13:400", "ko": "똑바로 누운 채, 노노는 손바닥을 살며시 천장을 향해 들어 보았다."},
{"id": "clkn13:500", "ko": "⟦top:76⟧하얗고 매끄러운 피부."},
{"id": "clkn13:600", "ko": "건강한 빛깔의 손톱."},
{"id": "clkn13:700", "ko": "자신의 것이면서 자신의 것이 아닌 손――."},
{"id": "clkn13:800", "ko": "센리는 줄곧 노노가 되고 싶었다."},
{"id": "clkn13:900", "ko": "그래서 노노가 될 수 있었을 때는 순수하게 기뻤다."},
{"id": "clkn13:1000", "ko": "모두가 말을 걸어 주는 것도, 의지해 주는 것도, 웃어 주는 것도, 그때까지의 센리에게는 없었던 것."},
{"id": "clkn13:1100", "ko": "그래서 그 모든 게 견딜 수 없이 기뻤다."},
{"id": "clkn13:1200", "ko": "하지만 그 기쁨은 이윽고 죄의식으로 바뀌어 갔다."},
{"id": "clkn13:1300", "ko": "⟦top:76⟧소중한 사람들을 계속 속이고 있다는 가책."},
{"id": "clkn13:1400", "ko": "큰맘 먹고 진실을 털어놓았을 때도 소중한 사람들은 그녀를 탓하지 않았다."},
{"id": "clkn13:1500", "ko": "물론 그들의 마음속이 복잡했으리라는 건 그녀도 알고 있었다."},
{"id": "clkn13:1600", "ko": "그래도 “가족”은 받아들여 주었다."},
{"id": "clkn13:1700", "ko": "히카리가 다시 이어 준 타쿠루와의 나날은 따뜻하고 눈부셔서."},
{"id": "clkn13:1800", "ko": "그녀에게 다시 한번 기쁨을 주었다."},
{"id": "clkn13:1900", "ko": "⟦top:38⟧하지만 지금, 그녀의 능력이 타쿠루를 괴롭히고 있다."},
{"id": "clkn13:2000", "ko": "「이기적이야…… 나……」"},
{"id": "clkn13:2100", "ko": "자신이 진실을 밝히면 모든 게 수습된다."},
{"id": "clkn13:2200", "ko": "⟦top:76⟧알고 있다."},
{"id": "clkn13:2300", "ko": "알고는 있지만, 분명 마음 어딘가에서 그걸 두려워하고 있는 것이다."},
{"id": "clkn13:2400", "ko": "⟦top:76⟧다시 볼품없는 자신으로 돌아가, 주위가 실망하는 것을."},
{"id": "clkn13:2500", "ko": "⟦top:76⟧모두가 자신을 거짓말쟁이라고 경멸하는 것을."},
{"id": "clkn13:2600", "ko": "지금까지 “쿠루스 노노”라는 이름의 갑옷으로 무장하고 있던 자신."},
{"id": "clkn13:2700", "ko": "거기에 아주 작은 금이 갈 것 같아진 것만으로 그녀는 아무것도 할 수 없게 되어 버렸다."},
{"id": "clkn13:2800", "ko": "지금 벌어지고 있는 학생회의 폭주."},
{"id": "clkn13:2900", "ko": "⟦top:38⟧평소의 그녀――쿠루스 노노였다면, 그런 횡포는 결코 용납하지 않았을 것이다."},
{"id": "clkn13:3000", "ko": "⟦top:38⟧하지만 지금은 아무것도 하지 못하고 있다."},
{"id": "clkn13:3100", "ko": "변했다고 생각했다."},
{"id": "clkn13:3200", "ko": "변할 수 있었던 게 아닐까 생각하기 시작했었다."},
{"id": "clkn13:3300", "ko": "⟦top:76⟧하지만 결국 “쿠루스 노노”라는 껍데기 아래는 미나미사와 센리라는 약한 자신일 뿐이라는 걸 뼈저리게 깨달았다."},
{"id": "clkn13:3400", "ko": "카와하라에게 겁먹은 자신."},
{"id": "clkn13:3500", "ko": "⟦top:38⟧진실이 알려지는 걸 두려워하는 자신."},
{"id": "clkn13:3600", "ko": "⟦top:38⟧겁 많고 나약하고."},
{"id": "clkn13:3700", "ko": "⟦top:38⟧이기적이고 욕심 많고."},
{"id": "clkn13:3800", "ko": "⟦top:38⟧그게 진짜 자신."},
{"id": "clkn13:3900", "ko": "결국."},
{"id": "clkn13:4000", "ko": "「내가 제일 소중한 건 나야……」"},
{"id": "clkn13:4100", "ko": "「있잖아, 히카리……」"},
{"id": "clkn13:4200", "ko": "「나, 어떻게 하면 좋을까?」"},
{"id": "clkn13:4300", "ko": "「어떻게 하면……」"}
]
