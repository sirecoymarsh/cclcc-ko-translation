[
{"id": "clkn07:10000", "ko": "「저기, 타쿠루…… 물 온도는 어때?」"},
{"id": "clkn07:10100", "ko": "「어? 아…… 응, 딱 좋아」"},
{"id": "clkn07:10200", "ko": "「그래」"},
{"id": "clkn07:10300", "ko": "응? 이 말투…… 혹시 센리 녀석, 노노 모습으로 돌아가 있는 건가?"},
{"id": "clkn07:10400", "ko": "그런데 왜?"},
{"id": "clkn07:10500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:10600", "ko": "「뭐!? 자, 잠깐만! 너 무슨 소리야!?」"},
{"id": "clkn07:10700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:10800", "ko": "「아니 아니 아니 아니, 아무리 그래도 그건 곤란하지!!」"},
{"id": "clkn07:10900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:11000", "ko": "「그럼 다시 입으면 되잖아!! 아무튼 아무리 남매라도 그런 건――」"},
{"id": "clkn07:11100", "ko": "「타쿠루 말이 맞아」"},
{"id": "clkn07:11200", "ko": "어, 어라?"},
{"id": "clkn07:11300", "ko": "혹시 이번엔…… 센리인가?"},
{"id": "clkn07:11400", "ko": "그렇다는 건 원래대로 돌아온…… 건가?"},
{"id": "clkn07:11500", "ko": "근데 왜?"},
{"id": "clkn07:11600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:11700", "ko": "뭐?"},
{"id": "clkn07:11800", "ko": "대체 뭐가 어떻게 된……"},
{"id": "clkn07:11900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:12000", "ko": "「으……」"},
{"id": "clkn07:12100", "ko": "「정말, 제대로 듣고 있는 거야, 타쿠루?」"},
{"id": "clkn07:12200", "ko": "「잠깐만…… 도무지 영문을 모르겠는데……」"},
{"id": "clkn07:12300", "ko": "「모르겠다니, 뭐가?」"},
{"id": "clkn07:12400", "ko": "「그러니까, 왜 노노랑 센리가 동시에 둘 다 있는 거야?」"},
{"id": "clkn07:12500", "ko": "「왜냐니……」"},
{"id": "clkn07:12600", "ko": "「그야 우리 둘 다 타쿠루의 누나니까」"},
{"id": "clkn07:12700", "ko": "「그치?」"},
{"id": "clkn07:12800", "ko": "그치라니…… 그거 전혀 설명이 안 되거든!"},
{"id": "clkn07:12900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:13000", "ko": "", "note": "보류 — 성적 묘사"},
