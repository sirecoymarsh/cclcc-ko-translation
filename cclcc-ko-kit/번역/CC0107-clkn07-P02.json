{"id": "clkn07:14000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:14100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:14200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:14300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:14400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:14500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:14600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn07:14700", "ko": "「타쿠루. 먼저 목욕해」"},
{"id": "clkn07:14800", "ko": "「어? 아……」"},
{"id": "clkn07:14900", "ko": "「왜 그래, 타쿠루 오빠?」"},
{"id": "clkn07:15000", "ko": "「아, 아니…… 아무것도 아니야. 그…… 목욕은 나중에 할게. 응……」"},
{"id": "clkn07:15100", "ko": "지금 들어가면 이것저것 떠올라 버릴 것 같다."},
{"id": "clkn07:15200", "ko": "「그래? 그럼 아빠, 얼른 들어가」"},
{"id": "clkn07:15300", "ko": "「오냐. 그렇지, 타쿠루. 가끔은 같이――」"},
{"id": "clkn07:15400", "ko": "「사양할게요!」"},
{"id": "clkn07:15500", "ko": "「어, 어어…… 그, 그러냐……」"},
{"id": "clkn07:15600", "ko": "아니, 바보 같은 생각 그만하고 목욕하고 얼른 자자."},
{"id": "clkn07:15700", "ko": "「그럼 난 이만 잘게」"},
{"id": "clkn07:15800", "ko": "「응, 잘 자」"},
{"id": "clkn07:15900", "ko": "「잘 자, 타쿠루 오빠」"},
{"id": "clkn07:16000", "ko": "거실에 남아 있던 두 사람에게 잘 자라고 인사하고, 내 방으로 향했다."},
{"id": "clkn07:16100", "ko": "「응……?」"},
{"id": "clkn07:16200", "ko": "방에 돌아오자마자 위화감이 들었다."},
{"id": "clkn07:16300", "ko": "침대 한가운데가 불룩하게 솟아 있다."},
{"id": "clkn07:16400", "ko": "누가…… 있는 건가?"},
{"id": "clkn07:16500", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:16600", "ko": "어째선지 아까 아버지가 한 말이 떠올라 버렸다."},
{"id": "clkn07:16700", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:16800", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:16900", "ko": "아니, 그건 아니다."},
{"id": "clkn07:17000", "ko": "두 사람은 내가 방으로 돌아오기 전에 거실에 있었다."},
{"id": "clkn07:17100", "ko": "설마 우키일 리는 없을 테니, 그렇다면…… 유토로군."},
{"id": "clkn07:17200", "ko": "그렇구나."},
{"id": "clkn07:17300", "ko": "유토 녀석, 요즘 좀 컸나 싶었는데, 혼자 못 자서 내 침대에 기어들어 오다니 역시 아직 애구나."},
{"id": "clkn07:17400", "ko": "「어쩔 수 없지. 같이 잘까」"},
{"id": "clkn07:17500", "ko": "그렇게 말하며 침대에 들어가려는 순간, 이불이 확 젖혀졌다."},
{"id": "clkn07:17600", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:17700", "ko": "「우와아아아아아앗!! 아, 아버지!? 왜!!」"},
{"id": "clkn07:17800", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:17900", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18000", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18100", "ko": "피가 섞였니 마니 하기 이전의 문제다!"},
{"id": "clkn07:18200", "ko": "「아, 아니, 이상한 농담 그만해, 아버지!」"},
{"id": "clkn07:18300", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18400", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18500", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18600", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18700", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18800", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:18900", "ko": "「히이이이이이이이이이이익!!!」"},
{"id": "clkn07:19000", "ko": "뭐야, 이건."},
{"id": "clkn07:19100", "ko": "꿈인가?"},
{"id": "clkn07:19200", "ko": "그래, 꿈이다."},
{"id": "clkn07:19300", "ko": "이건 악몽임이 틀림없다?"},
{"id": "clkn07:19400", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:19500", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:19600", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn07:19700", "ko": "「사, 살려 줘! 누구 없어! 센리! 유이! 우키! 유토! 아무나 좋아! 제발, 살려 줘어어어어어어어어어어!!!」"},
{"id": "clkn07:19800", "ko": "「야, 왜 그러냐, 타쿠루?」"},
{"id": "clkn07:19900", "ko": "「우와아아아아아아아앗!!」"}
]
