[
{"id": "clka06:19800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:19900", "ko": "「자자자, 장난치지 마!」"},
{"id": "clka06:20000", "ko": "나는 의자에서 펄쩍 물러나, 더 뒷걸음질 쳐서 벽까지 물러났다."},
{"id": "clka06:20100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:20200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:20300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka06:20400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:20500", "ko": "「내 얘기는 아무래도 상관없잖아!」"},
{"id": "clka06:20600", "ko": "「저기, 미야시로 선배」"},
{"id": "clka06:20700", "ko": "「우왓!?」"},
{"id": "clka06:20800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka06:20900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:21000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka06:21100", "ko": "「아…… 안, 돼!」"},
{"id": "clka06:21200", "ko": "「너는…… 카즈키가 아니니까!」"},
{"id": "clka06:21300", "ko": "「그 몸은 카즈키 거지, 네 게 아니야!」"},
{"id": "clka06:21400", "ko": "「그러니까 그 몸을 마음대로 하는 건 용납될 일이 아니잖아!」"},
{"id": "clka06:21500", "ko": "나로서는 궁여지책으로 떠오른 말을 했을 뿐이었다. 하지만."},
{"id": "clka06:21600", "ko": "「와우」"},
{"id": "clka06:21700", "ko": "카즈키 아닌 카즈키는 눈을 크게 뜨고 감탄한 듯 그렇게 말했다."},
{"id": "clka06:21800", "ko": "「그렇게 나오셨군요. 과연, 일리가 있네요」"},
{"id": "clka06:21900", "ko": "「으음, 그렇다면……」"},
{"id": "clka06:22000", "ko": "카즈키 아닌 카즈키는 팔짱을 끼고 그 자리에서 생각하기 시작했다."},
{"id": "clka06:22100", "ko": "「……아, 맞다!」"},
{"id": "clka06:22200", "ko": "뭔가 생각난 모양인지 갑자기 웃는 얼굴이 된다."},
{"id": "clka06:22300", "ko": "그리고 재빨리 내 곁으로 달려와 귓가에 작게 속삭였다."},
{"id": "clka06:22400", "ko": "「아까 그 사진, 한 번 더 봐 줄래요?」"},
{"id": "clka06:22500", "ko": "「어?」"},
{"id": "clka06:22600", "ko": "「그 사진에서 ⟦rb⟧제⟦rt⟧⟦rbc⟧●⟦/r⟧ ⟦rb⟧옆에⟦rt⟧⟦rbc⟧●●⟦/r⟧ 있는 물건, 잘 보세요」"},
{"id": "clka06:22700", "ko": "「뭐?」"},
{"id": "clka06:22800", "ko": "「자, 빨리!」"},
{"id": "clka06:22900", "ko": "「아, 응……」"},
{"id": "clka06:23000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka06:23100", "ko": "「딱히 아무것도 안 찍혀……」"},
{"id": "clka06:23200", "ko": "「……응?」"},
{"id": "clka06:23300", "ko": "카즈키 옆 부분을 손가락으로 벌려 확대한다."},
{"id": "clka06:23400", "ko": "거기에는 잡지가 한 권 놓여 있었다."},
{"id": "clka06:23500", "ko": "「⟦col:280aa02d1400⟧쿨 캣 프레스⟦col:800000⟧인가?」"},
{"id": "clka06:23600", "ko": "왜 놓쳤던 걸까. 이건 확실히 쿨 캣 프레스다."},
{"id": "clka06:23700", "ko": "내 캠핑카에는 겐 씨한테서 사들인 이 잡지가 꽤 많이 보관돼 있다."},
{"id": "clka06:23800", "ko": "그것들은 평소엔 눈에 띄지 않는 곳에 넣어 두었다. 신문부의 누구도 그 장소를 모를 것이다."},
{"id": "clka06:23900", "ko": "그게 왜 여기 있는 거지?"},
{"id": "clka06:24000", "ko": "「낯익은 호 아니에요?」"},
{"id": "clka06:24100", "ko": "「……?」"},
{"id": "clka06:24200", "ko": "이상한 기분이 든다."},
{"id": "clka06:24300", "ko": "이상하게도 ⟦rb⟧본 기억이⟦rt⟧⟦rbc⟧●●●●⟦/r⟧ ⟦rb⟧없다⟦rt⟧⟦rbc⟧●●⟦/r⟧."},
{"id": "clka06:24400", "ko": "왜 이 잡지가 찍혀 있는지도 이상하지만, 찍혀 있는 그 호를 내가 모른다는 건 더 이상한 일이다."},
{"id": "clka06:24500", "ko": "다시 한번 확대된 잡지 표지를 관찰한다."},
{"id": "clka06:24600", "ko": "특집 기사 글자가 늘어서 있지만, 역시 스마트폰 화질로는 뭉개져서 잘 읽을 수 없다."},
{"id": "clka06:24700", "ko": "제목 일부가 크게 쓰인 부분을 간신히 읽어 낼 수 있었다."},
{"id": "clka06:24800", "ko": "「……『바꿔 줘』……?」"},
{"id": "clka06:24900", "ko": "「후훗♪」"},
{"id": "clka06:25000", "ko": "그 순간."},
{"id": "clka06:25100", "ko": "나는 열 생각이 없었던 기억의 문을 억지로 열어 버렸다."}
]
