[
{"id": "clse07:417300", "ko": "「그러니까 신경 쓰지 마, 쿠루스. 일단 이토의 플랜으로 진행해 두고――」"},
{"id": "clse07:417400", "ko": "「그리고 나는 그동안에도 특종을 찾을게. 뭔가 큰 건을 잡으면 다시 지면을 새로 짠다. 이런 식으로 어때?」"},
{"id": "clse07:417500", "ko": "「그럼 쿠루스랑 오노에 일행은 먼저 취재를 부탁해. 패션 같은 건 나는 전혀 모르니까」"},
{"id": "clse07:417600", "ko": "「그건 물론―― 이 아니라, 아리무라! 너는 당연히 안 되지!」"},
{"id": "clse07:417700", "ko": "「그렇게 생각하면 얼른 문예부로 돌아가라고」"},
{"id": "clse07:417800", "ko": "（그보다, 반드시 큰 특종을 찾아야 해）"},
{"id": "clse07:417900", "ko": "「엇? 아, 죄송합니다」"},
{"id": "clse07:418000", "ko": "（아무리 그래도 이건 곤란하군）"},
{"id": "clse07:418100", "ko": "「어?」"},
{"id": "clse07:418200", "ko": "「아, 카와하라……」"},
{"id": "clse07:418300", "ko": "「……저기…… 무슨 일이라도?」"},
{"id": "clse07:418400", "ko": "「무슨 볼일, 있어요?」"},
{"id": "clse07:418500", "ko": "（바보 카와하라! 방금 그건 『거기 멍하니 서 있지 말고 얼른 앉아서 주문해』라는 뜻이라고!）"},
{"id": "clse07:418600", "ko": "「쿠루스라면 먼저 갔어요. 오늘은 아오바 기숙사 식사 당번이라던가……」"},
{"id": "clse07:418700", "ko": "「………」"},
{"id": "clse07:418800", "ko": "「하아……」"},
{"id": "clse07:418900", "ko": "「………」"},
{"id": "clse07:419000", "ko": "「기다려, 카와하라. 우리는 딱히 놀고 있는 게 아니야……」"},
{"id": "clse07:419100", "ko": "「으……」"},
{"id": "clse07:419200", "ko": "「엇?」"},
{"id": "clse07:419300", "ko": "「저, 저기, 쿠루스도―― 학생회장도 그거 알고 있는 건가요?」"},
{"id": "clse07:419400", "ko": "「그, 저기――」"},
{"id": "clse07:419500", "ko": "（과연, 이건 그러니까……）"},
{"id": "clse07:419600", "ko": "「……좋아」"},
{"id": "clse07:419700", "ko": "（………… 지금 오노에가 사고 도촬하고 있었다면 『타쿠는 최악이야』라는 소리를 들을 것 같군）"},
{"id": "clse07:419800", "ko": "「그리고 다음 일요일――」"},
{"id": "clse07:419900", "ko": "「………」"},
{"id": "clse07:420000", "ko": "「………」"},
{"id": "clse07:420100", "ko": "「………」"},
{"id": "clse07:420200", "ko": "「………」"},
{"id": "clse07:420300", "ko": "「에헴. ……확실히 말해도 되냐, 너희?」"},
{"id": "clse07:420400", "ko": "「왜 이런 데에 내가 있는 거야!? 유행하는 옷 취재 같은 건 너희한테 맡겼잖아!?」"},
{"id": "clse07:420500", "ko": "「그러니까 쇼핑이 아니잖아, 쿠루스!」"},
{"id": "clse07:420600", "ko": "「아무튼 나는 이만 갈 거니까. 그럼 간다」"},
{"id": "clse07:420700", "ko": "「뭐? 뭔데」"},
{"id": "clse07:420800", "ko": "「엄청난 이벤트?」"},
{"id": "clse07:420900", "ko": "「……읏」"},
{"id": "clse07:421000", "ko": "「뭐, 라고?」"},
{"id": "clse07:421100", "ko": "「으아아……읏」"},
{"id": "clse07:421200", "ko": "「뭐? 왜, 쿠루스?」"},
{"id": "clse07:421300", "ko": "「우와아앗!?」"},
{"id": "clse07:421400", "ko": "「무, 무, 무슨 소리냐니, 너, 그거!」"},
{"id": "clse07:421500", "ko": "「아니아니아니! 수영복 입고 매장 안을 돌아다니는 건 그냥 시착이 아니잖아!? 이상하잖아!?」"},
{"id": "clse07:421600", "ko": "「네?」"},
{"id": "clse07:421700", "ko": "「갸아아아!」"},
{"id": "clse07:421800", "ko": "「아, 아무튼! 수영복 시착은 괜찮지만, 그걸로 어슬렁거리는 건 그냥 치녀니까――」"},
{"id": "clse07:421900", "ko": "（그렇군! 그 애의 능력!）"},
{"id": "clse07:422000", "ko": "「어이, 우키!? 혹시 이거 네 탓이야!?」"},
{"id": "clse07:422100", "ko": "「으아앗!?」"},
{"id": "clse07:422200", "ko": "「『나도』가 아니라! 그만둬〜!」"},
{"id": "clse07:422300", "ko": "「우키!? 대체 누구 망상이야, 이거!?」"},
{"id": "clse07:422400", "ko": "「어이, 우키!?」"},
{"id": "clse07:422500", "ko": "「라니, 나아!?」"},
{"id": "clse07:422600", "ko": "「아쉽다는 건 뭐야, 아쉽다는 건!?」"},
{"id": "clse07:422700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:422800", "ko": "「아니거든! 너는 너대로 남 듣기 안 좋은 소리 하지 마〜」"},
{"id": "clse07:422900", "ko": "「라니, 쿠루스가 그런 말을 할 리가 있냐〜!」"},
{"id": "clse07:423000", "ko": "「그러니까 그런 슬픈 눈은 그만해 줘〜」"},
{"id": "clse07:423100", "ko": "「참을 필요 없어! 이 망상을 어떻게 좀 해!」"},
{"id": "clse07:423200", "ko": "「됐으니까! 빨리!」"},
{"id": "clse07:423300", "ko": "「그렇구나, 알았어! 나머지는 맡긴다!」"},
{"id": "clse07:423400", "ko": "「하아하아하아……」"},
{"id": "clse07:423500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:423600", "ko": "（어? 누가 있나?）"},
{"id": "clse07:423700", "ko": "（카즈키? 아리무라?）"},
{"id": "clse07:423800", "ko": "「???」"},
{"id": "clse07:423900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:424000", "ko": "（어라?）"},
{"id": "clse07:424100", "ko": "（앗, 큰일이다!）"},
{"id": "clse07:424200", "ko": "（……응?）"},
{"id": "clse07:424300", "ko": "「크흠 크흠!」"},
{"id": "clse07:424400", "ko": "「아아, 나다. 일요일인데 동아리 활동인가. 수고」"},
{"id": "clse07:424500", "ko": "「정보 수집하러 왔어. 그보다 아리무라야말로 뭐 하고 있었어? 여기는 문예부가 아니라고 몇 번을 말해야……」"},
{"id": "clse07:424600", "ko": "「엇!? 그거 내는 거야!? TV 시나리오상에!?」"},
{"id": "clse07:424700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:424800", "ko": "「그, 그런 건가?」"},
{"id": "clse07:424900", "ko": "「이벤트?」"},
{"id": "clse07:425000", "ko": "「아아, 이벤트라니…… 온라인 게임 길드의……」"},
{"id": "clse07:425100", "ko": "「으아〜!?」"},
{"id": "clse07:425200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:425300", "ko": "「………」"},
{"id": "clse07:425400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:425500", "ko": "「가가가, 간다!」"},
{"id": "clse07:425600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:425700", "ko": "「너, 역시 뭔가 잘못됐어! 확실해!」"},
{"id": "clse07:425800", "ko": "「나쁜 말 안 할 테니까 다시 써. 그런 게 TV에 방송될 리가 없잖아!? 신인상 같은 건 못 탄다고!」"},
{"id": "clse07:425900", "ko": "「어떻게 봐도 임팩트밖에 없잖아!」"},
{"id": "clse07:426000", "ko": "「뭐, 뭔가…… 오늘은 지쳤다……」"},
{"id": "clse07:426100", "ko": "「……으음」"},
{"id": "clse07:426200", "ko": "「다들 더 굉장했던 것 같은데 말이야〜」"},
{"id": "clse07:426300", "ko": "「아니, 어느 사건이든 더 이렇게―― 라니, 우왓!?」"},
{"id": "clse07:426400", "ko": "「오, 오, 오노에! 너 언제부터!?」"},
{"id": "clse07:426500", "ko": "「문이 열려 있어도 노크 정도는 하고 들어와. 대체 언제부터 거기 앉아 있었던 거야」"},
{"id": "clse07:426600", "ko": "「거의 처음부터잖아, 그거! 방심할 틈도 없군……」"},
{"id": "clse07:426700", "ko": "「오백 엔…… 늘 사던 거?」"},
{"id": "clse07:426800", "ko": "「라니, 설마!?」"},
{"id": "clse07:426900", "ko": "「타아〜!」"},
{"id": "clse07:427000", "ko": "「이봐, 오노에? 이 내가 이런 수준 낮은 책을 읽을 리가 없잖아?」"},
{"id": "clse07:427100", "ko": "「와와와! 너는 남의 집을 멋대로 뒤지지 마!」"},
{"id": "clse07:427200", "ko": "（뭐, 뭐 이런 녀석이……）"}
]
