[
{"id": "clkn04:0", "ko": "「미야시로오. 부실 갈 거지?」"},
{"id": "clkn04:100", "ko": "「당연하지」"},
{"id": "clkn04:200", "ko": "방과 후가 되어 평소처럼 이토와 함께 부실로 가는 길에, 별로 마주치고 싶지 않은 얼굴을 발견했다."},
{"id": "clkn04:300", "ko": "「이토, 저쪽에서 주스 사 들고 가지 않을래? 내가 살게」"},
{"id": "clkn04:400", "ko": "「뭐? 진짜? 무슨 바람이 분 거냐?」"},
{"id": "clkn04:500", "ko": "「뭐든 상관없잖아?」"},
{"id": "clkn04:600", "ko": "「아니, 네가 갑자기 그런 말을 하다니, 뭔가 꿍꿍이가 있는 게 분명해」"},
{"id": "clkn04:700", "ko": "「꿍꿍이 같은 거 없다니까」"},
{"id": "clkn04:800", "ko": "「정말이냐~? 음, 그럼……」"},
{"id": "clkn04:900", "ko": "「응?」"},
{"id": "clkn04:1000", "ko": "「아……」"},
{"id": "clkn04:1100", "ko": "젠장!"},
{"id": "clkn04:1200", "ko": "이토가 꾸물대는 바람에 저쪽이 눈치채 버렸잖아."},
{"id": "clkn04:1300", "ko": "「미야시로 아니냐」"},
{"id": "clkn04:1400", "ko": "어차피 또 질척질척 질척질척 싫은 소리를 해 댈 게 뻔하다."},
{"id": "clkn04:1500", "ko": "그래서 돌아서 가려고 했던 건데."},
{"id": "clkn04:1600", "ko": "「아, 안녕……」"},
{"id": "clkn04:1700", "ko": "「왜 그래, 기운이 없네? 어디 안 좋냐?」"},
{"id": "clkn04:1800", "ko": "뭐――!"},
{"id": "clkn04:1900", "ko": "카와하라가 나를 걱정하는 듯한 말을 했……다고?"},
{"id": "clkn04:2000", "ko": "「아니 아니, 미야시로는 맨날 이런 느낌이잖아」"},
{"id": "clkn04:2100", "ko": "「하긴, 그랬지」"},
{"id": "clkn04:2200", "ko": "「그게…… 그래서, 무슨 일……?」"},
{"id": "clkn04:2300", "ko": "「흥, 역시 이 내가 너 따위한테 질 리가 없었지」"},
{"id": "clkn04:2400", "ko": "「뭐……?」"},
{"id": "clkn04:2500", "ko": "「미안하지만 승부는 내 승리다. 그렇다고 날 원망하지는 마라」"},
{"id": "clkn04:2600", "ko": "「원망하려면 한심한 너 자신을 원망하라고. 하하하하하하」"},
{"id": "clkn04:2700", "ko": "할 말만 하고, 카와하라는 웃으면서 그대로 가 버렸다."},
{"id": "clkn04:2800", "ko": "「뭐였냐, 저건?」"},
{"id": "clkn04:2900", "ko": "「글쎄……」"},
{"id": "clkn04:3000", "ko": "승부라고 했는데…… 설마 저번 신문부 승부 얘긴가?"},
{"id": "clkn04:3100", "ko": "그렇다면 그건 없던 일이 됐을 텐데."},
{"id": "clkn04:3200", "ko": "「뭐, 신경 꺼. 그보다 가자고. 주스다, 주스」"},
{"id": "clkn04:3300", "ko": "「뭐? 무슨 소리야?」"},
{"id": "clkn04:3400", "ko": "「무슨 소리냐니…… 사 준다며?」"},
{"id": "clkn04:3500", "ko": "「내가 왜 이토한테 주스를 사 줘야 되는데」"},
{"id": "clkn04:3600", "ko": "「뭐! 너……」"},
{"id": "clkn04:3700", "ko": "「바보 같은 소리 하지 말고 부활동 가자」"},
{"id": "clkn04:3800", "ko": "「아니 아니 아니, 네가 사 준다고 했잖아」"},
{"id": "clkn04:3900", "ko": "「그런 옛날 일은 잊어버렸다」"},
{"id": "clkn04:4000", "ko": "「치매냐? 할아버지냐?」"},
{"id": "clkn04:4100", "ko": "정말 끈질긴 녀석이다."},
{"id": "clkn04:4200", "ko": "애초에 이토 때문에 영문 모를 굴욕감까지 맛봤는데, 주스까지 사 줄 의리 따윈 전혀 없다."},
{"id": "clkn04:4300", "ko": "오히려 내가 얻어먹고 싶을 정도다."},
{"id": "clkn04:4400", "ko": "「아 진짜, 할아버지 둘, 시끄러워~」"},
{"id": "clkn04:4500", "ko": "「누가 할아버지야!」"},
{"id": "clkn04:4600", "ko": "「저희가 보기엔 둘 다 한 살 위니까, 충분히 할아버지임다」"},
{"id": "clkn04:4700", "ko": "「그 논리대로라면…… 히나 씨도 나보다 한 살 위니까……」"},
{"id": "clkn04:4800", "ko": "「셧업, 하나! 더 말하면 무서운 꼴 당한다~」"},
{"id": "clkn04:4900", "ko": "「응……」"},
{"id": "clkn04:5000", "ko": "새삼 부실 안을 둘러보니, 우키와 노노 말고는 이미 다 모여 있다."},
{"id": "clkn04:5100", "ko": "아리무라는 부원이 아니지만."},
{"id": "clkn04:5200", "ko": "「쿠루스 녀석, 늦네」"},
{"id": "clkn04:5300", "ko": "「학생회 일도 있고, 어쩔 수 없지」"},
{"id": "clkn04:5400", "ko": "「학생회 일은 아니야…… 일지도……」"},
{"id": "clkn04:5500", "ko": "「카즈키, 뭐 아는 거 있어?」"},
{"id": "clkn04:5600", "ko": "「오는 길에 만났어…… 일지도……」"},
{"id": "clkn04:5700", "ko": "「그래서? 노노는 뭐래?」"},
{"id": "clkn04:5800", "ko": "「……볼일이 좀 있어서 늦을지도 모른대……」"},
{"id": "clkn04:5900", "ko": "학생회 말고 그렇게 중요한 볼일이 있다고?"},
{"id": "clkn04:6000", "ko": "「참 나…… 저 녀석, 부활동을 우습게 보네」"},
{"id": "clkn04:6100", "ko": "나는 스마트폰을 꺼냈다."},
{"id": "clkn04:6200", "ko": "「굳이 전화까지 안 해도 되는데」"},
{"id": "clkn04:6300", "ko": "「이런 건 따끔하게 말해 둬야 하는 거야」"},
{"id": "clkn04:6400", "ko": "한동안 신호가 가더니, 겨우 전화를 받는 기척이 났다."},
{"id": "clkn04:6500", "ko": "전화를 받을 수 있다는 건, 역시 별일 아닌 거 아냐."},
{"id": "clkn04:6600", "ko": "「아, 타쿠루? 미안해. 늦는다고 카즈키한테 전했는데」"},
{"id": "clkn04:6700", "ko": "「그건 들었어. 그래도 이유를――」"},
{"id": "clkn04:6800", "ko": "「아, 미안. 이따 봐!」"},
{"id": "clkn04:6900", "ko": "「야, 노노!!」"},
{"id": "clkn04:7000", "ko": "젠장! 끊어 버렸다!"},
{"id": "clkn04:7100", "ko": "「응?」"},
{"id": "clkn04:7200", "ko": "아니, 전화는 통화 중인 상태 그대로다."},
{"id": "clkn04:7300", "ko": "혹시 ⟦rb⟧노노⟦rt⟧그 녀석⟦/r⟧, 허둥대다가 끊는 걸 잊은 건가?"},
{"id": "clkn04:7400", "ko": "「아아아아아아아아아앗!!」"},
{"id": "clkn04:7500", "ko": "갑작스러운 아리무라의 큰 소리에 다들 펄쩍 뛰었다."},
{"id": "clkn04:7600", "ko": "「뭐, 뭐야, 아리무라? 왜 그래?」"},
{"id": "clkn04:7700", "ko": "「쿠루스 선배」"},
{"id": "clkn04:7800", "ko": "아리무라는 창밖을 가리키며 말했다."},
{"id": "clkn04:7900", "ko": "창가로 가서 내다보니, 정말 아리무라 말대로 거기에 노노가 서 있었다."},
{"id": "clkn04:8000", "ko": "신문부실은 별관이라 불리는 건물 4층에 있어서, 조금 떨어진 건너편 특별관 옥상에 있는 테니스 코트가 보인다.", "note": "새 용어: 分棟 → 별관, 特別棟 → 특별관"},
{"id": "clkn04:8100", "ko": "평소에는 테니스부원들로 북적이지만, 아무래도 오늘은 부활동도 쉬는 모양이다."},
{"id": "clkn04:8200", "ko": "노노는 혼자 거기에 덩그러니 서 있었다."},
{"id": "clkn04:8300", "ko": "이런 곳에 왜……"},
{"id": "clkn04:8400", "ko": "「불러 볼까? 어이~ 노노――」"},
{"id": "clkn04:8500", "ko": "「기다려, 오노에! 누가 왔어!!」"},
{"id": "clkn04:8600", "ko": "이토의 말에 모두가 그쪽을 바라봤다."},
{"id": "clkn04:8700", "ko": "거기에 나타난 건, 다름 아닌――카와하라였다."},
{"id": "clkn04:8800", "ko": "창밖을 들여다보던 모두가 어째선지 숨듯이 몸을 낮췄다."},
{"id": "clkn04:8900", "ko": "「미안하다, 쿠루스」"},
{"id": "clkn04:9000", "ko": "아직 통화 중인 노노의 스마트폰을 통해 카와하라의 목소리가 들렸다."},
{"id": "clkn04:9100", "ko": "그 말로 미루어, 노노를 이런 곳에 불러낸 게 카와하라라는 걸 알았다."},
{"id": "clkn04:9200", "ko": "「무슨 얘기 하는 걸까?」"},
{"id": "clkn04:9300", "ko": "「어? 아, 아니…… 글쎄……」"},
{"id": "clkn04:9400", "ko": "오노에의 말에 저도 모르게 소리를 내자, 그걸 날카롭게 알아챈 사람이 있었다."},
{"id": "clkn04:9500", "ko": "「어라? 선배~. 혹시……」"},
{"id": "clkn04:9600", "ko": "아차! 방금 그 한마디로 들켜 버렸다!"},
{"id": "clkn04:9700", "ko": "「아, 역시!」"},
{"id": "clkn04:9800", "ko": "「아, 아니, 이건――!」"},
{"id": "clkn04:9900", "ko": "「선배…… 엿듣는 거예요?」"}
]
