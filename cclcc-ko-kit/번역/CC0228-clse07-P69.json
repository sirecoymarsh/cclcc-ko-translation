[
{"id": "clse07:667100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:667200", "ko": "「네……?」"},
{"id": "clse07:667300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:667400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:667500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:667600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:667700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:667800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:667900", "ko": "（마, 망상!? 방금 게 전부!? 나, 나는 무슨 생각을 하고 있는 거야!?）"},
{"id": "clse07:668000", "ko": "「그, 그, 그런 부끄러운 생각 안 했다니까!」"},
{"id": "clse07:668100", "ko": "「그, 그, 그것만은 봐줘――! 부탁이야!」"},
{"id": "clse07:668200", "ko": "「그, 그렇지. 모처럼 만들어 와 줬으니, 좀 먹여 줄래?」"},
{"id": "clse07:668300", "ko": "「……?」"},
{"id": "clse07:668400", "ko": "「……뭐, 뭐야, 그거……?」"},
{"id": "clse07:668500", "ko": "（전혀, 하나도, 조금도 안 숨겨졌다고, 오노에!!）"},
{"id": "clse07:668600", "ko": "「저, 저기? 그러니까 그게 뭐냐고……」"},
{"id": "clse07:668700", "ko": "「아니, 기다려 줘! 유동식이었던 건 시부야 지진 뒤에 재활 초기 때 얘기고―― 지금은 뭐든 평범하게 먹을 수 있다니까! 알잖아!?」"},
{"id": "clse07:668800", "ko": "「으…… 윽……」"},
{"id": "clse07:668900", "ko": "「（전부 다야! 아무 생각 없이 이것저것 다 집어넣으면 그렇게 되는 게 당연하잖아!」"},
{"id": "clse07:669000", "ko": "（전혀 달라! 낫토 장인한테 사과해!）"},
{"id": "clse07:669100", "ko": "「……!?」"},
{"id": "clse07:669200", "ko": "「치과?」"},
{"id": "clse07:669300", "ko": "「기, 기다려, 너! 그건 하지 마! 그만둬!」"},
{"id": "clse07:669400", "ko": "「으읍! 우구웁!」"},
{"id": "clse07:669500", "ko": "「읍, 으으으으으으읍!」"},
{"id": "clse07:669600", "ko": "（어떻게 되긴! 네가 이런 고문 같은 짓을 하니까――!!）"},
{"id": "clse07:669700", "ko": "「어, 라?」"},
{"id": "clse07:669800", "ko": "「아, 아아……」"},
{"id": "clse07:669900", "ko": "（마, 망상!? 무슨 망상을 하는 거야, 나는……）"},
{"id": "clse07:670000", "ko": "（……아니, 그래도 평소에 쿠루스나 쿠노사토 씨한테 혼나는 사이에 어느새……?）"},
{"id": "clse07:670100", "ko": "「저기, 오노에?」"},
{"id": "clse07:670200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:670300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:670400", "ko": "「나쁜 짓?」"},
{"id": "clse07:670500", "ko": "「아니야!」"},
{"id": "clse07:670600", "ko": "「윽……」"},
{"id": "clse07:670700", "ko": "「이제 충분해! 확인하고 싶은 건 끝났어! 이제 그만해도 돼, 오노에!」"},
{"id": "clse07:670800", "ko": "「그러니까 아니라니까, 아니야!」"},
{"id": "clse07:670900", "ko": "「글쎄. 음, 오노에가 좋아하는 걸로 해」"},
{"id": "clse07:671000", "ko": "「응? 왜 그래?」"},
{"id": "clse07:671100", "ko": "「………」"},
{"id": "clse07:671200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:671300", "ko": "「에엥?」"},
{"id": "clse07:671400", "ko": "「유이가……?」"},
{"id": "clse07:671500", "ko": "「………」"},
{"id": "clse07:671600", "ko": "「오노에……」"},
{"id": "clse07:671700", "ko": "「뭐?」"},
{"id": "clse07:671800", "ko": "「계속 신경 쓰였는데, 『만들어졌다』는 게 무슨 뜻이야. 누구한테? 무엇을 위해? 어떻게?」"},
{"id": "clse07:671900", "ko": "「그러니까 그 수수께끼 같은 소리는 그만해 줘. 지금 인격인 네가 머리 좋은 건 알았으니까」"},
{"id": "clse07:672000", "ko": "「………눈치채고 있었구나」"},
{"id": "clse07:672100", "ko": "「………」"},
{"id": "clse07:672200", "ko": "「우아아아아아아!」"},
{"id": "clse07:672300", "ko": "「그, 그만둬! 소, 손이……!」"},
{"id": "clse07:672400", "ko": "「그만둬! 놔!」"},
{"id": "clse07:672500", "ko": "「이이이익!」"},
{"id": "clse07:672600", "ko": "「미안하게 됐군. 이렇게 하는 수밖에 없었어」"},
{"id": "clse07:672700", "ko": "（그래도 설마 이렇게 많은 바늘이……）"},
{"id": "clse07:672800", "ko": "「너, 방심하고 있었지? 내 ⟦rb⟧염동력⟦rt⟧능력⟦/r⟧ 따위 별거 아니라고. 하지만 이 정도는 할 수 있어」"},
{"id": "clse07:672900", "ko": "「온몸에 바늘에 찔린 상처나 긁힌 상처 같은 게 있으면, 아무리 숨기려 해도 신조 씨나 쿠루스, 아니면 아리무라쯤은 반드시 수상하게 여길 거야」"},
{"id": "clse07:673000", "ko": "「게다가 여기 있는 바늘은 전부 방치된 채라 소독도 전혀 안 돼 있어. 녹투성이인 것도 많고」"},
{"id": "clse07:673100", "ko": "「이런 위험한 바늘에 다치면 금방 곪을 거야. 끝까지 숨기는 건 불가능해지지」"},
{"id": "clse07:673200", "ko": "「게다가 상처에 섞어서, 이 병원을 가리키는 『AH』라는 메시지도 여기저기 새겨 넣으면 어떨까?」"},
{"id": "clse07:673300", "ko": "「그러면 신조 씨네는 반드시 이 병원의 존재를 떠올릴 거야. 내가 여기 갇혀 있을 가능성도 알아챌 거고. 아니야!?」"},
{"id": "clse07:673400", "ko": "「나를 풀어 줘! 설령 네가 평소의 오노에가 아니라고 해도…… 사실은 이런 짓 하고 싶지 않아!」"},
{"id": "clse07:673500", "ko": "「그렇게 새하얗고 예쁜 피부에 끔찍한 상처 같은 거 내고 싶지 않다고!」"},
{"id": "clse07:673600", "ko": "「아니야! 빈말 같은 게 아니라――!」"},
{"id": "clse07:673700", "ko": "「물이나 식량은 어떡하고?」"},
{"id": "clse07:673800", "ko": "「……오노에. 너…… 그걸로 행복해?」"},
{"id": "clse07:673900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:674000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:674100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:674200", "ko": "「………?」"},
{"id": "clse07:674300", "ko": "「…………」"},
{"id": "clse07:674400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:674500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:674600", "ko": "「……오노에……」"},
{"id": "clse07:674700", "ko": "「……저기, 오노에……」"},
{"id": "clse07:674800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:674900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675600", "ko": "「……저기, 너 말이야……」"},
{"id": "clse07:675700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:675900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:676000", "ko": "「저기, 오노에? 슬슬 정말 그만두지 않을래? 계속 이 방에 틀어박혀서 이런 짓 계속해 봤자 허무할 뿐이잖아?」"},
{"id": "clse07:676100", "ko": "「이럴 바에야 나는 평소처럼 트레일러 하우스에서 PC나 텔레비전을 보면서 너랑 바보 같은 얘기를 하고, 가끔 장난치는 쪽이 훨씬 즐거워」"}
]
