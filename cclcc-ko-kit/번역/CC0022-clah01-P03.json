[
{"id": "clah01:19900", "ko": "「만・지・고・싶어!!」"},
{"id": "clah01:20000", "ko": "「앙!!」"},
{"id": "clah01:20100", "ko": "나는 정신없이, 달려들듯이 그녀의 ⟦rb⟧거기⟦rt⟧⟦rbc⟧●●⟦/r⟧를 손가락으로 더듬었다."},
{"id": "clah01:20200", "ko": "「이, 이게 여자애의……!」"},
{"id": "clah01:20300", "ko": "이 얼마나 말랑한가."},
{"id": "clah01:20400", "ko": "이런 게 이 세상에 존재하다니!"},
{"id": "clah01:20500", "ko": "「안 돼요, 선배…… 그렇게 세게 하면……!」"},
{"id": "clah01:20600", "ko": "「그럼 여긴 어때?」"},
{"id": "clah01:20700", "ko": "「읏……!! 싫어, 그런 곳……!」"},
{"id": "clah01:20800", "ko": "「봐…… 여긴 오독오독해……」"},
{"id": "clah01:20900", "ko": "「말하지 마요……」"},
{"id": "clah01:21000", "ko": "「이 안쪽은 어떻게 되어 있을까……?」"},
{"id": "clah01:21100", "ko": "「그, 그렇게 안쪽까지…… 부끄러워……」"},
{"id": "clah01:21200", "ko": "「부끄러워하지 마…… 더 잘 보여 줘……」"},
{"id": "clah01:21300", "ko": "「아앗…… 거긴……!」"},
{"id": "clah01:21400", "ko": "「아아…… 굉장해! 굉장해…… 아리무라의 귀!」"},
{"id": "clah01:21500", "ko": "「하앙〜!!」"},
{"id": "clah01:21600", "ko": "말랑한 귓불."},
{"id": "clah01:21700", "ko": "연골은 오독오독하고, 귓구멍도 이상적이다!!!"},
{"id": "clah01:21800", "ko": "「귀, 최고오오오오오오!!!」"},
{"id": "clah01:21900", "ko": "「……라는 건, 물론 농담이지만요」"},
{"id": "clah01:22000", "ko": "「엥?」"},
{"id": "clah01:22100", "ko": "……아아…… 망상인가."},
{"id": "clah01:22200", "ko": "그보다, 뭐야 방금 그 망상은!?"},
{"id": "clah01:22300", "ko": "나는 딱히 귀에 특별한 페티시즘 같은 거 없다고!!"},
{"id": "clah01:22400", "ko": "아마……"},
{"id": "clah01:22500", "ko": "「그래도 뭐, 예상대로임다」"},
{"id": "clah01:22600", "ko": "「……뭐가?」"},
{"id": "clah01:22700", "ko": "아니, 이제 안 되겠다!"},
{"id": "clah01:22800", "ko": "아무리 나라도 이런 소리를 들으면 참을 수 없다!!"},
{"id": "clah01:22900", "ko": "「아리무라아아아아아!!」"},
{"id": "clah01:23000", "ko": "「꺄앗!!」"},
{"id": "clah01:23100", "ko": "나는 거의 다이빙하듯이 아리무라에게 달려들려고 했다."},
{"id": "clah01:23200", "ko": "그때――"},
{"id": "clah01:23300", "ko": "「뭐――!?」"},
{"id": "clah01:23400", "ko": "발밑의 땅이 사라졌나 싶더니 하늘과 땅이 뒤집힌 듯한 감각이 덮쳐 왔고, 다음 순간에는 격렬한 충격이 온몸을 덮쳤다."},
{"id": "clah01:23500", "ko": "뭐, 뭐야?"},
{"id": "clah01:23600", "ko": "무슨 일이 일어났는지 이해가 따라가지 못한다."},
{"id": "clah01:23700", "ko": "겨우 위아래가 구분될 즈음 올려다보니, 거기에는 네모난 빛의 틀이 떠 있었다."},
{"id": "clah01:23800", "ko": "「야아, 진짜 바보구나, 미야시로」"},
{"id": "clah01:23900", "ko": "「이토……」"},
{"id": "clah01:24000", "ko": "설마 이건…… 구덩이 함정?"},
{"id": "clah01:24100", "ko": "구덩이 속에서 필사적으로 기어 올라오니, 거기에는 신문부 녀석들이 히죽히죽 모여 있었다."},
{"id": "clah01:24200", "ko": "「뭐, 뭐야 이거? 어떻게 된 거야?」"},
{"id": "clah01:24300", "ko": "「아직도 모르겠어?」"},
{"id": "clah01:24400", "ko": "「몰래카메라…… 일지도」"},
{"id": "clah01:24500", "ko": "핸디 카메라를 든 카즈키가 말했다."},
{"id": "clah01:24600", "ko": "「몰래카메라?」"},
{"id": "clah01:24700", "ko": "「그래. 신문부의 새로운 시도로 이번부터 웹으로 영상 방송을 하기로 했거든. 그 첫 번째가 이거다」"},
{"id": "clah01:24800", "ko": "영상 방송…… 이라고?"},
{"id": "clah01:24900", "ko": "「잠깐! 나는 그런 얘기 못 들었어!」"},
{"id": "clah01:25000", "ko": "「그야 그렇지. 말 안 했으니까」"},
{"id": "clah01:25100", "ko": "그럼……"},
{"id": "clah01:25200", "ko": "「게다가 이번엔 첫 회라서 이쪽에서도 보고 계십니다〜!」"},
{"id": "clah01:25300", "ko": "「안녕하세요. ⟦col:280aa02d1400⟧시부야 늬우스⟦col:800000⟧의 ⟦col:280aa02e1400⟧케이 씨⟦col:800000⟧입니다. 방금 몰래카메라 보셨나요?」", "note": "渋谷にうず(ニュース를 옛 표기처럼 쓴 프로그램 이름) → 「시부야 늬우스」"},
{"id": "clah01:25400", "ko": "그럴 수가…… 시부야 늬우스에서 방금 그게……?"},
{"id": "clah01:25500", "ko": "「그것만이 아니라고」"},
{"id": "clah01:25600", "ko": "「안녕하세요〜. 니코니야 뉴스 속보의 와타베입니다!」"},
{"id": "clah01:25700", "ko": "「야아, 보셨습니까, 방금 미야시로 소년의 놀란 얼굴! 걸작이었네요!」"},
{"id": "clah01:25800", "ko": "「그럼 방금 장면을 한 번 더 보시겠습니다〜!」"},
{"id": "clah01:25900", "ko": "「그, 그만둬어어어엇!!」"},
{"id": "clah01:26000", "ko": "나는 이토가 내민 태블릿을 빼앗아 전원을 꺼 버렸다."},
{"id": "clah01:26100", "ko": "「미안해요〜, 선배. 저는 싫다고 했는데요오」"},
{"id": "clah01:26200", "ko": "「그치만 대본 쓴 건 히나 씨…… 일지도……」"},
{"id": "clah01:26300", "ko": "「아이잉, 하나도 참, 그건 말하면 안 되지〜」"},
{"id": "clah01:26400", "ko": "이 녀석……!"},
{"id": "clah01:26500", "ko": "「그래도 덕분에 우리 신문부의 평판은 하늘을 찌르고 있어」"},
{"id": "clah01:26600", "ko": "「봐. ⟦col:280aa02d1400⟧SNS⟦col:800000⟧ ⟦col:280aa02e1400⟧트렌드⟦col:800000⟧에도 들어갔다고!」"},
{"id": "clah01:26700", "ko": "이럴 수가……!"},
{"id": "clah01:26800", "ko": "분명 이 영상은 인터넷에서 퍼져 순식간에 확산될 것이다."},
{"id": "clah01:26900", "ko": "학교 전체, 아니, 시부야 전체…… 아니, 전 세계 사람들이 내가 여자애한테 달려들었다는 사실을 비웃고, 조롱하고, 그리고 경멸하는 거다!"},
{"id": "clah01:27000", "ko": "「이, 이럴 수가…… 내 인생은 이제 끝이다아아아……!」"},
{"id": "clah01:27100", "ko": "「…………」"},
{"id": "clah01:27200", "ko": "어, 어라?"},
{"id": "clah01:27300", "ko": "그, 그렇구나, 망상이었나……"},
{"id": "clah01:27400", "ko": "「치〜. 농담이라고는 해도 이렇게까지 말했는데 아무 반응도 없다니, 히나에, 좀 충격〜」"},
{"id": "clah01:27500", "ko": "……다행이다."},
{"id": "clah01:27600", "ko": "그냥 망상이라서."},
{"id": "clah01:27700", "ko": "그때 아리무라의 그 말에 넘어갔다면 하마터면 온 동네의 웃음거리가 될 뻔했다."},
{"id": "clah01:27800", "ko": "「그래도 뭐, 예상대로지?」"},
{"id": "clah01:27900", "ko": "「……뭐가?」"},
{"id": "clah01:28000", "ko": "그래."},
{"id": "clah01:28100", "ko": "이런 뻔히 보이는 농담에 어울려 줄 수는 없다."},
{"id": "clah01:28200", "ko": "무시다, 무시."},
{"id": "clah01:28300", "ko": "「치〜. 농담이라고는 해도 이렇게까지 말했는데 아무 반응도 없다니, 히나에, 좀 충격〜」"},
{"id": "clah01:28400", "ko": "여, 역시나."},
{"id": "clah01:28500", "ko": "조금이라도 그 말에 넘어갔다면, 분명 이 녀석은 그걸 꼬투리 삼아 나를 협박하거나 뭐 그랬을 게 틀림없다."},
{"id": "clah01:28600", "ko": "「그래도 뭐, 예상대로지?」"},
{"id": "clah01:28700", "ko": "「……뭐가?」"},
{"id": "clah01:28800", "ko": "「그러니까. 보통 남자애라면 이런 데서 그런 말 들으면 이상한 짓을 하려고 든다고」"},
{"id": "clah01:28900", "ko": "「그 점에서 선배는 아무 짓도 안 했죠. 그렇다는 건 그만큼 미야시로 선배가 무해한 사람이라는 거 아니겠슴까」"},
{"id": "clah01:29000", "ko": "무해하다는 말은 남자에게 결코 칭찬이 아니라고 생각한다."},
{"id": "clah01:29100", "ko": "그 분위기를 느꼈는지 아리무라는 허둥지둥 얼버무렸다."},
{"id": "clah01:29200", "ko": "「아, 물론 좋은 의미로요?」"},
{"id": "clah01:29300", "ko": "“좋은 의미로”라는 건 편리한 말이지."},
{"id": "clah01:29400", "ko": "뭐든 일단 그렇게 덧붙여 두면 수습이 되니까."},
{"id": "clah01:29500", "ko": "「그런 고로오…… 당분간 신세 좀 지겠슴다」"},
{"id": "clah01:29600", "ko": "「안 돼!」"},
{"id": "clah01:29700", "ko": "「된다고 말해 주지 않으면 아까 그거 폭로할 거예요」"},
{"id": "clah01:29800", "ko": "「아까 그거라니, 뭔데?」"}
]
