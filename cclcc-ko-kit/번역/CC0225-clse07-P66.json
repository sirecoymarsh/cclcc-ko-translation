[
{"id": "clse07:637300", "ko": "「그게……」"},
{"id": "clse07:637400", "ko": "「……아무래도 그동안 있었던 일을 전부 잊어버린 것 같아서요……」"},
{"id": "clse07:637500", "ko": "「마음대로 하세요……」"},
{"id": "clse07:637600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:637700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:637800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:637900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:638000", "ko": "「기각이다!!」"},
{"id": "clse07:638100", "ko": "「볼일?」"},
{"id": "clse07:638200", "ko": "「벼, 별로 신경 쓰이지는……」"},
{"id": "clse07:638300", "ko": "「아! 아리무라! 너 언제……」"},
{"id": "clse07:638400", "ko": "「시끄럽네. 뭐야, 이토?」"},
{"id": "clse07:638500", "ko": "「뭐?」"},
{"id": "clse07:638600", "ko": "「응?」"},
{"id": "clse07:638700", "ko": "「그러니까, 너……」"},
{"id": "clse07:638800", "ko": "「윽……」"},
{"id": "clse07:638900", "ko": "「아〜……」"},
{"id": "clse07:639000", "ko": "「벼, 별로 난 걱정 같은 거 안 했거든!」"},
{"id": "clse07:639100", "ko": "「바보야! 아리무라! 그만둬!」"},
{"id": "clse07:639200", "ko": "「그러니까 그만두라고!!!」"},
{"id": "clse07:639300", "ko": "「어? 아, 될 수 있으면 마운틴 뷰가……」"},
{"id": "clse07:639400", "ko": "「윽……」"},
{"id": "clse07:639500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:639600", "ko": "「…………」"},
{"id": "clse07:639700", "ko": "「어? 아, 아아…… 아니, 아무것도. 없어……!」"},
{"id": "clse07:639800", "ko": "「어?」"},
{"id": "clse07:639900", "ko": "「어, 어떻게 그걸……」"},
{"id": "clse07:640000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:640100", "ko": "「아, 아아……」"},
{"id": "clse07:640200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:640300", "ko": "「어?」"},
{"id": "clse07:640400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:640500", "ko": "「어……?」"},
{"id": "clse07:640600", "ko": "「응?」"},
{"id": "clse07:640700", "ko": "（으〜, 안 되겠다. 아무리 생각해도 좋은 아이디어가 안 나와……）"},
{"id": "clse07:640800", "ko": "（그러니까…… 우선 권두에 수영복 같은 화보가 있고……）"},
{"id": "clse07:640900", "ko": "（――는 무슨, 바・보・냐!）"},
{"id": "clse07:641000", "ko": "（큭…… 아프다. 머리도 아프지만…… 내 기자 혼도 아프다）"},
{"id": "clse07:641100", "ko": "「우왓!?」"},
{"id": "clse07:641200", "ko": "「그치만 너, 사고 도촬――」"},
{"id": "clse07:641300", "ko": "「그, 그래?」"},
{"id": "clse07:641400", "ko": "「쿠루스한테?」"},
{"id": "clse07:641500", "ko": "「……그렇군」"},
{"id": "clse07:641600", "ko": "「잔소리 많은 엄마라기보다는, 동네 오지랖 넓은 아줌마 같은 느낌 아냐?」"},
{"id": "clse07:641700", "ko": "「농담이에요〜」"},
{"id": "clse07:641800", "ko": "「흐응, 그렇구나. 그럼 아까 건 미안했어」"},
{"id": "clse07:641900", "ko": "「이제 아까 같은 짓은 안 할게」"},
{"id": "clse07:642000", "ko": "「……? 뭐야?」"},
{"id": "clse07:642100", "ko": "「아니, 왜 이번엔 네가 눈을 피하는 건데?」"},
{"id": "clse07:642200", "ko": "「어, 어어. 그래……」"},
{"id": "clse07:642300", "ko": "「이봐 이봐, 쿠루스? 누구한테 하는 소리야? 내 정보망에는 기삿거리가 얼마든지 굴러다닌다고. 오히려 뭘 골라야 할지 곤란할 정도야」"},
{"id": "clse07:642400", "ko": "「…… 너 말이야? 오노에한테는 주의를 줘 놓고 자기는 괜찮은 거야? 사고 도촬」"},
{"id": "clse07:642500", "ko": "「큭……」"},
{"id": "clse07:642600", "ko": "「뭐, 아무튼 여기서 빈둥거려 봤자 좋은 아이디어가 굴러들어오는 것도 아니고…… 좀 옛날 방식으로 가 볼까」"},
{"id": "clse07:642700", "ko": "「『특종은 발로 찾아라』라고 하잖아. 요즘 재밌는 얘기 없는지 겐 씨한테라도 물어보고 다닐게」"},
{"id": "clse07:642800", "ko": "「괜찮아. 무리는 안 한다니까」"},
{"id": "clse07:642900", "ko": "「알았어〜」"},
{"id": "clse07:643000", "ko": "「그러니까, 이 시간이면 아마 겐 씨는 이 근처에 있을 텐데」"},
{"id": "clse07:643100", "ko": "「뭐야, 그거?」"},
{"id": "clse07:643200", "ko": "「…………」"},
{"id": "clse07:643300", "ko": "「우승?」"},
{"id": "clse07:643400", "ko": "「아니, 그건 네가 겐 씨랑 친해서잖아. 점수를 덤으로 얹어 준 거라고」"},
{"id": "clse07:643500", "ko": "「엉?」"},
{"id": "clse07:643600", "ko": "「무, 무슨 소리야. 그런 건……」"},
{"id": "clse07:643700", "ko": "「오노에, 미안! 잘못했어! 내가 나빴어!」"},
{"id": "clse07:643800", "ko": "「……에엥?」"},
{"id": "clse07:643900", "ko": "「아니아니 잠깐잠깐! 그런 생각 안 했다니까!」"},
{"id": "clse07:644000", "ko": "「뭐? 쿠루스가 왜?」"},
{"id": "clse07:644100", "ko": "「야, 왜 그래, 너!?」"},
{"id": "clse07:644200", "ko": "「아니, 그치만…… 난 딱히 카즈키나 쿠루스 생각 같은 건 안 했어. 너라면 사고 도촬하면 그 정도는 금방――」"},
{"id": "clse07:644300", "ko": "（……그렇군, 그런 거였나）"},
{"id": "clse07:644400", "ko": "「우웁. 대낮부터 술은 그만 마셔. 그리고 지금은 우리 집 안에 들어오지 말아 줘. 숨결만으로도 나까지 취할 것 같아」"},
{"id": "clse07:644500", "ko": "「응?」"},
{"id": "clse07:644600", "ko": "（오노에. 너, 역시 『사고 도촬』 마구 쓰고 있잖아!）"},
{"id": "clse07:644700", "ko": "（응? 그런데…… 그럼 아까는 왜?）"},
{"id": "clse07:644800", "ko": "（아, 아차! 그만 쓸데없는 소리를!）"},
{"id": "clse07:644900", "ko": "「……? 왜 그래?」"},
{"id": "clse07:645000", "ko": "「안 사! 그보다, 산 적 한 번도 없거든!」"},
{"id": "clse07:645100", "ko": "「우굿」"},
{"id": "clse07:645200", "ko": "「그러니까! 너, 오해하고 있어. 그런 책, 『좋다』고 생각한 적 한 번도 없으니까!」"},
{"id": "clse07:645300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:645400", "ko": "（으그그……）"},
{"id": "clse07:645500", "ko": "「어? 뭐, 뭐야?」"},
{"id": "clse07:645600", "ko": "「뭐, 뭐가?」"},
{"id": "clse07:645700", "ko": "「흐아하앗!?」"},
{"id": "clse07:645800", "ko": "（――으아아〜〜）"},
{"id": "clse07:645900", "ko": "「아, 아니, 기다려, 오노에! 너는 뭔가 엄청난 착각을 하고 있어!」"},
{"id": "clse07:646000", "ko": "「그, 그러니까, 그, 그만두라니까!」"},
{"id": "clse07:646100", "ko": "「자, 자, 오노에! 이제 충분하니까! 빨리 옷 바로 입어, 알았지!?」"},
{"id": "clse07:646200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:646300", "ko": "「…………」"},
{"id": "clse07:646400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:646500", "ko": "（어!? 갑자기 전화!? 누구랑 얘기하려는 거야, 오노에!?）"},
{"id": "clse07:646600", "ko": "「우와아아, 그만둬 바보야! 너, 쿠루스한테 뭘 물어보려는 거야!」"},
{"id": "clse07:646700", "ko": "「아니, 하지만 말이지!」"},
{"id": "clse07:646800", "ko": "（지, 지금부터 도망칠 수 있다면 어디지?）"},
{"id": "clse07:646900", "ko": "（이토네 집은 10초도 안 돼서 들킨다. 그렇다고 아리무라나 카즈키가 나를 숨겨 줄 리도 없고……）"},
{"id": "clse07:647000", "ko": "（그래! 여기선 확 허를 찔러서 아오바 기숙사다! 유토 방 벽장에 일주일쯤 숨어 있으면!）"},
{"id": "clse07:647100", "ko": "（――잠깐! 무리다! 그 녀석 방은 유이랑 같이 쓰잖아! 한 방에 들킨다!）"},
{"id": "clse07:647200", "ko": "（크으윽. 이렇게 된 이상…… 유이한테도 고개를 숙일까!?）"}
]
