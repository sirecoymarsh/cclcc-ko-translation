[
{"id": "clkn02:10000", "ko": "「문제는 맛이지……」"},
{"id": "clkn02:10100", "ko": "「흥!」"},
{"id": "clkn02:10200", "ko": "「오노에 건?」"},
{"id": "clkn02:10300", "ko": "「응? 내 건 말이지~…… 이거」"},
{"id": "clkn02:10400", "ko": "그러면서 꺼낸 베이글은 어떤가 하면――."},
{"id": "clkn02:10500", "ko": "「뭐, 뭐랄까…… 응, 맛도 문제겠네……」"},
{"id": "clkn02:10600", "ko": "오노에 건 말할 것도 없고, 다른 하나도 만든 게 그 아리무라다."},
{"id": "clkn02:10700", "ko": "겉보기는 나쁘지 않다 쳐도, 과연 먹을 수 있는 물건일까."},
{"id": "clkn02:10800", "ko": "역시 여기선 어떻게든 안 먹고 넘어갈 방법이 없을까……"},
{"id": "clkn02:10900", "ko": "「세리」"},
{"id": "clkn02:11000", "ko": "「오케이」"},
{"id": "clkn02:11100", "ko": "「응?」"},
{"id": "clkn02:11200", "ko": "두 사람이 눈짓을 주고받는가 싶더니, 갑자기 오노에가 내 뒤로 돌아왔다."},
{"id": "clkn02:11300", "ko": "「야, 오노에…… 대체 뭘…… 읏!」"},
{"id": "clkn02:11400", "ko": "오노에가 다짜고짜 뒤에서 나를 꽉 붙들었다."},
{"id": "clkn02:11500", "ko": "「있잖아, 타쿠. 여자애의 호의는 순순히 받아야 하는 거야. 그러니까……」"},
{"id": "clkn02:11600", "ko": "「그, 그만――」"},
{"id": "clkn02:11700", "ko": "「군소리 말고 먹어라~!! 으랴앗!」"},
{"id": "clkn02:11800", "ko": "아리무라가 내 입속 가득 베이글을 쑤셔 넣었다."},
{"id": "clkn02:11900", "ko": "「우읍읍읍!!」"},
{"id": "clkn02:12000", "ko": "이, 이건――맛이 어떻고 저떻고 하기 이전에, 입안의 수분을 몽땅 빼앗아 가는 녀석이다!!!"},
{"id": "clkn02:12100", "ko": "「많이 있으니까 잔뜩 먹어, 타쿠」"},
{"id": "clkn02:12200", "ko": "「자아 자아, 많이 드셔 주실 거죠~?」"},
{"id": "clkn02:12300", "ko": "「무, 뭄…… 뭄을……」"},
{"id": "clkn02:12400", "ko": "「물로 꿀꺽 넘기려는 건 안 돼, 안 돼. 제대로 음미하면서 먹어야지」"},
{"id": "clkn02:12500", "ko": "그게 아니야!"},
{"id": "clkn02:12600", "ko": "그게 아니라, 누가 나한테 수분을……!!"},
{"id": "clkn02:12700", "ko": "「푸웁! 콜록, 컥……!」"},
{"id": "clkn02:12800", "ko": "큰일이다!"},
{"id": "clkn02:12900", "ko": "이대로라면 정말 의식이……"},
{"id": "clkn02:13000", "ko": "「으…… 으으……」"},
{"id": "clkn02:13100", "ko": "「어라? 있잖아, 히나. 타쿠가 좀 이상한……」"},
{"id": "clkn02:13200", "ko": "「아~ 이런 건 거짓말, 거짓말…… 응? 거짓말이…… 아닌 것 같네……」"},
{"id": "clkn02:13300", "ko": "「타쿠! 정신 차려, 타쿠!! 타쿠, 좀~!!」"},
{"id": "clkn02:13400", "ko": "「푸, 하아…… 호되게 당했네……」"},
{"id": "clkn02:13500", "ko": "아리무라가 갖고 있던 과일 우유를 단숨에 들이켜고 나서야 겨우 살아난 기분이 들었다."},
{"id": "clkn02:13600", "ko": "위험했다…… 강 건너에 엄청 예쁜 꽃밭이 보였다고."},
{"id": "clkn02:13700", "ko": "「위험했네~, 타쿠」"},
{"id": "clkn02:13800", "ko": "「어휴, 손이 많이 가네요~. 저희가 없었으면 어떻게 됐을지」"},
{"id": "clkn02:13900", "ko": "「야! 누구 때문에 이런 꼴을――」"},
{"id": "clkn02:14000", "ko": "「미야시로오오……」"},
{"id": "clkn02:14100", "ko": "원망스러운 목소리에 고개를 들자, 어느새 이토가 서 있었다."},
{"id": "clkn02:14200", "ko": "「모처럼 눈치 있게 네 몫의 빵까지 사 왔더니, 그런 나를 제쳐 두고 혼자 여자애가 손수 만든 베이글이라고오?」"},
{"id": "clkn02:14300", "ko": "「아, 아니, 그 덕분에 방금 목숨을 잃을 뻔했다고?」"},
{"id": "clkn02:14400", "ko": "「여자애 요리로 죽을 수 있다면 소원 성취지!」"},
{"id": "clkn02:14500", "ko": "「여자애라고 해도 오노에랑 아리무라라고」"},
{"id": "clkn02:14600", "ko": "「상관없어! 일단이라고는 해도, 오노에도 아리무라도 여자는 여자다!」"},
{"id": "clkn02:14700", "ko": "「호오~. 아무래도 두 분 다 목숨이 아깝지 않은 모양이네요……」"},
{"id": "clkn02:14800", "ko": "「힉! 죄, 죄송합니다! 베이글은 이제 봐주세요!」"},
{"id": "clkn02:14900", "ko": "「그럼 나한테! 미야시로 몫의 베이글도 이 비천한 저에게 주실 수 있으시겠습니까!?」"},
{"id": "clkn02:15000", "ko": "「어…… 아~ 역시 그런 식으로 나오시니까 좀 깨네요……」"},
{"id": "clkn02:15100", "ko": "「이토……」"},
{"id": "clkn02:15200", "ko": "「아, 미안, 신지. 베이글 이제 없다」"},
{"id": "clkn02:15300", "ko": "「노오오오오오오오오오!!!」"},
{"id": "clkn02:15400", "ko": "그렇게까지 분해할 일이냐?"},
{"id": "clkn02:15500", "ko": "「이렇게 된 이상, 사 온 빵 전부 먹어 주마! 햄 샌드위치도 달걀 샌드위치도 전부 먹어 버릴 테다!!」"},
{"id": "clkn02:15600", "ko": "선언하자마자 이토는 엄청난 기세로 빵을 허겁지겁 먹어 치우기 시작했다."},
{"id": "clkn02:15700", "ko": "애초에 나도 이미 배가 불러서, 얼마든지 먹어도 상관없는데."},
{"id": "clkn02:15800", "ko": "「읍…… 큰일이다…… 괴로워. 못 움직이겠어……」"},
{"id": "clkn02:15900", "ko": "「그렇게 잔뜩 먹으니까 그렇지~」"},
{"id": "clkn02:16000", "ko": "「……아, 그러고 보니 아까 교실 밖에 부부장이 있던데, 그건 뭐였을까……」"},
{"id": "clkn02:16100", "ko": "「쿠루스가?」"},
{"id": "clkn02:16200", "ko": "「어. 뭔가 봉투 같은 걸 들고 있던데……」"},
{"id": "clkn02:16300", "ko": "「봉투? 서, 설마 쿠루스도 베이글을……」"},
{"id": "clkn02:16400", "ko": "「그건 2학년 수업이니까, 3학년인 쿠루스 선배는 안 만들었을 거예요」"},
{"id": "clkn02:16500", "ko": "다행이다."},
{"id": "clkn02:16600", "ko": "베이글은 당분간 사양이다."},
{"id": "clkn02:16700", "ko": "「음~. 그럼 노노는 뭐 하러 왔던 걸까?」", "note": "のんちゃん(세리카가 노노를 부르는 애칭) → 「노노」(ちゃん 생략 규칙, 真ちゃん=신지와 같은 방식)"},
{"id": "clkn02:16800", "ko": "「글쎄…… 뭐, 그래도 안 왔다는 건 별일 아니었던 거 아냐?」"},
{"id": "clkn02:16900", "ko": "쿠루스니까, 뭔가 중요한 일이었다면 말을 걸었을 테고, 그러지 않았다는 건 그냥 우연히 지나가던 길이었다는 거겠지."}
]
