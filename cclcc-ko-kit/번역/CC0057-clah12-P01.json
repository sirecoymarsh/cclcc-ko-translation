[
{"id": "clah12:0", "ko": "그로부터 며칠 뒤――"},
{"id": "clah12:100", "ko": "「그러니까 몇 번이나 사과했잖아」"},
{"id": "clah12:200", "ko": "「사과해서 끝날 거면 ⟦col:280aa02d1400⟧짭새⟦col:800000⟧는 필요 없다 이 말이오」", "note": "マッポ(경찰 속어)·ぜよ(일부러 꾸민 옛 말투) → 「짭새」·「~이 말이오」"},
{"id": "clah12:300", "ko": "「여어〜」"},
{"id": "clah12:400", "ko": "「그럼 어쩌라는 건데?」"},
{"id": "clah12:500", "ko": "「그런 건 스스로 생각하세요」"},
{"id": "clah12:600", "ko": "「야야, 꽤 시끄럽다 했더니 무슨 소동이야?」"},
{"id": "clah12:700", "ko": "「그게, 타쿠랑 히나가……」"},
{"id": "clah12:800", "ko": "「뭐야, 너네. 싸움이냐?」"},
{"id": "clah12:900", "ko": "「내버려 둬, 이토」"},
{"id": "clah12:1000", "ko": "「아니, 그렇게 말해도 복도까지 다 들리고……」"},
{"id": "clah12:1100", "ko": "「아무튼 나는 더는 사과 안 할 거야」"},
{"id": "clah12:1200", "ko": "「야, 미야시로」"},
{"id": "clah12:1300", "ko": "「흐흐〜응…… 과연, 그렇군요 그렇군요, 그런 거였군요」"},
{"id": "clah12:1400", "ko": "「아리무라도 말이야…… 뭔지는 모르겠지만 그쯤에서……」"},
{"id": "clah12:1500", "ko": "「그런 거라니, 뭔데?」"},
{"id": "clah12:1600", "ko": "「보아하니 선배, 저 같은 건 싫어진 거죠」"},
{"id": "clah12:1700", "ko": "「뭐?」"},
{"id": "clah12:1800", "ko": "「그래. 틀림없어. 그러니까 그런 소리를 하는 거야」"},
{"id": "clah12:1900", "ko": "「야, 영문 모를 소리 하지 마」"},
{"id": "clah12:2000", "ko": "「영문 모를 소리 아니란 말이야」"},
{"id": "clah12:2100", "ko": "「있잖아…… 자꾸 그렇게 영문 모를 소리만 하면 진짜로 싫어진다」"},
{"id": "clah12:2200", "ko": "「읏……!」"},
{"id": "clah12:2300", "ko": "「미, 미야시로!! 너, 그건 아무리 그래도 안 되지」"},
{"id": "clah12:2400", "ko": "「선배……」"},
{"id": "clah12:2500", "ko": "「아리무라도 진정해. 응?」"},
{"id": "clah12:2600", "ko": "「선배………… 좋아!!!」"},
{"id": "clah12:2700", "ko": "「뭐어어어어어어어?」"},
{"id": "clah12:2800", "ko": "「정말. 저를 그렇게 생각해 주다니 기뻐요! 정말 좋아!」"},
{"id": "clah12:2900", "ko": "「어, 야…… 이봐, 껴안지 말라니까」"},
{"id": "clah12:3000", "ko": "「뭐, 뭐야 그게에에!?」"},
{"id": "clah12:3100", "ko": "「그러니까 말했잖아……」"},
{"id": "clah12:3200", "ko": "「타쿠랑 히나, 여전히 알콩달콩하네〜」"},
{"id": "clah12:3300", "ko": "결국 그날부터 우리―― 히나에와 나는 사귀게 되었다."},
{"id": "clah12:3400", "ko": "솔직히 말하면 처음에는 나도 불안했다."},
{"id": "clah12:3500", "ko": "만약 문득 어느 순간 내 마음이 멀어져 버리면 어떻게 될까."},
{"id": "clah12:3600", "ko": "예를 들면 그래―― 아까처럼 싸웠을 때 같은 경우다."},
{"id": "clah12:3700", "ko": "하지만 실제로 사귀기 시작해 보니 알았다."},
{"id": "clah12:3800", "ko": "진짜 마음이 상대에게 훤히 다 보인다는 건, 그건 그거대로 서로의 마음을 늘 확인할 수 있다는 뜻이기도 한 것이다."},
{"id": "clah12:3900", "ko": "아까처럼 갑자기 싸워 봤자, 그 속에 있는 내 마음이 히나에에게는 훤히 들여다보이니까, 결과적으로 싸움도 오래가지 않는다."},
{"id": "clah12:4000", "ko": "상대가 자기를 좋아한다는 걸 알고 있으면, 그렇게 쉽게 마음이 멀어지는 일은 없을지도 모른다."},
{"id": "clah12:4100", "ko": "말하자면 외국인들이 늘 애정을 서로 확인하는 것과 마찬가지다."},
{"id": "clah12:4200", "ko": "「음……」"},
{"id": "clah12:4300", "ko": "「얘, 카즈키. 또 그렇게……」"},
{"id": "clah12:4400", "ko": "「응? 뭐야, 왜 그래 하나?」"},
{"id": "clah12:4500", "ko": "「응……」"},
{"id": "clah12:4600", "ko": "카즈키가 재촉해서 PC 모니터를 보니, 거기에는 ⟦col:280aa02d1400⟧SNS⟦col:800000⟧ 사이트가 떠 있었다."},
{"id": "clah12:4700", "ko": "댓글을 보면 외국 관광객이 올린 것 같은데, 거기에는――"},
{"id": "clah12:4800", "ko": "「와와, ⟦col:280aa02d1400⟧스크램블 교차로⟦col:800000⟧ 한복판에서 끌어안고 있어……」"},
{"id": "clah12:4900", "ko": "응……?"},
{"id": "clah12:5000", "ko": "「어머? 이거, 타쿠루랑 아리무라 아니야……?」"},
{"id": "clah12:5100", "ko": "「뭐!?」"},
{"id": "clah12:5200", "ko": "「으아아아아아아아!!!」"},
{"id": "clah12:5300", "ko": "「이 동영상…… 해외 사이트에서 화제가 되고 있어…… 일지도……」"},
{"id": "clah12:5400", "ko": "「어디어디? 좀 더 잘 보여 줘?」"},
{"id": "clah12:5500", "ko": "『나는 너를…… 정말 싫어해애애애애애애앳!』"},
{"id": "clah12:5600", "ko": "「야! 스피커 볼륨 올리지 마!」"},
{"id": "clah12:5700", "ko": "「흐응, 이게 소문의……」"},
{"id": "clah12:5800", "ko": "「아이고, 쑥스럽구먼」"},
{"id": "clah12:5900", "ko": "「잠깐! 구경거리가 아니라고! 카즈키도 당장 닫아!」"},
{"id": "clah12:6000", "ko": "「에에, 왜〜. 모처럼인데 보여 줘도 되잖아」"},
{"id": "clah12:6100", "ko": "「맞아 맞아〜」"},
{"id": "clah12:6200", "ko": "「아니, 왜 너까지 같이 그러는 건데, 히나에」"},
{"id": "clah12:6300", "ko": "「그치만〜, 선배의 고백 장면, 저도 보고 싶잖아요〜」"},
{"id": "clah12:6400", "ko": "「그런 거 볼 필요 없어!」"},
{"id": "clah12:6500", "ko": "「너무해! 보아하니 저 싫어진 거죠」"},
{"id": "clah12:6600", "ko": "「자꾸 그렇게 영문 모를 소리만 하면 싫어진다」"},
{"id": "clah12:6700", "ko": "「선배………… 좋아!」"},
{"id": "clah12:6800", "ko": "「너네, 개그 콤비냐……」"},
{"id": "clah12:6900", "ko": "뭐, 이런 식으로 우리 관계는 지금으로선 순조로웠다."},
{"id": "clah12:7000", "ko": "「잘 먹었어. 맛있었어」"},
{"id": "clah12:7100", "ko": "「정말요? 그럼 또 만들어 올게요」"},
{"id": "clah12:7200", "ko": "다 먹은 도시락통을 귀여운 주머니에 챙겨 넣으며 히나에는 기쁜 듯이 웃었다."},
{"id": "clah12:7300", "ko": "아무래도 그날 이후로 히나에는 내 방에 얹혀사는 걸 그만두었다."},
{"id": "clah12:7400", "ko": "정식으로 사귀기 시작했으니 제대로 선을 그어야 한다는 게 히나에의 의견이었고, 나도 그 의견에는 찬성이었다."},
{"id": "clah12:7500", "ko": "사귀지도 않는 남녀가 함께 지내는 것보다 사귀는 남녀가 함께 지내는 쪽이 더 문제가 있어 보인다는 건, 어쩐지 아이러니한 기분도 들지만……"},
{"id": "clah12:7600", "ko": "그 대신이라고 하긴 뭣하지만, 요즘 우리는 매일 이렇게 둘이서 점심을 먹고 있다."},
{"id": "clah12:7700", "ko": "히나에의 도시락이 빈말이 아니라 맛있다는 건, 내 감상을 들은 히나에의 반응을 보면 알 수 있겠지."},
{"id": "clah12:7800", "ko": "「선배…… 이제 조금 있으면 졸업하는 거죠」"},
{"id": "clah12:7900", "ko": "「아, 그렇지……」"},
{"id": "clah12:8000", "ko": "솔직히 별로 실감은 안 나지만, 여기 다니는 것도 이제 곧 끝이다."},
{"id": "clah12:8100", "ko": "「아〜아, 선배랑 좀 더 일찍 알고 지냈으면 좋았을 텐데」"},
{"id": "clah12:8200", "ko": "「그랬으면 좀 더, 좀 더 이렇게 같이 시간을 보낼 수 있었을 텐데」"},
{"id": "clah12:8300", "ko": "내 앞에서 “연기하는 것”을 그만둔 히나에는 이렇게 솔직한 모습을 보이는 일이 늘었다."},
{"id": "clah12:8400", "ko": "이것도 나만 알고 있는, 나만의 히나에다."},
{"id": "clah12:8500", "ko": "만약 이런 모습을 다른 남자가 본다면, 분명 다들 히나에를 가만두지 않겠지."},
{"id": "clah12:8600", "ko": "하지만 그런가…… 졸업하면 이렇게 학교에서 못 만나게 된다는 건……"},
{"id": "clah12:8700", "ko": "「걱정이네……」"},
{"id": "clah12:8800", "ko": "「뭐가요?」"},
{"id": "clah12:8900", "ko": "「졸업한 뒤에 학교에서 히나에한테 들이대는 녀석이 안 나온다는 보장도 없잖아」"},
{"id": "clah12:9000", "ko": "「정말, 선배도 참. 그런 걱정은 필요 없어요. 왜냐하면……」"},
{"id": "clah12:9100", "ko": "히나에가 내 어깨에 머리를 기대며 말했다."},
{"id": "clah12:9200", "ko": "「저는 선배 말고 다른 사람한테는 관심 없으니까요……」"},
{"id": "clah12:9300", "ko": "아아……"},
{"id": "clah12:9400", "ko": "이런 걸 행복이라고 하는 거겠지."},
{"id": "clah12:9500", "ko": "「하암…… 안심했더니 좀 졸리네」"},
{"id": "clah12:9600", "ko": "「후훗…… 어쩔 수 없네요……」"},
{"id": "clah12:9700", "ko": "「……어쩐지 미안하다」"},
{"id": "clah12:9800", "ko": "「그런 말 하면서, 처음부터 그럴 생각이었죠?」"},
{"id": "clah12:9900", "ko": "역시나다. 전부 꿰뚫어 보고 있다."}
]
