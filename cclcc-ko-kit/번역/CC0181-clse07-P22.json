[
{"id": "clse07:204200", "ko": "「……」"},
{"id": "clse07:204300", "ko": "「……」"},
{"id": "clse07:204400", "ko": "「……타」"},
{"id": "clse07:204500", "ko": "「……타쿠루」"},
{"id": "clse07:204600", "ko": "「……타쿠루, 선배」"},
{"id": "clse07:204700", "ko": "「……」"},
{"id": "clse07:204800", "ko": "「……어머?」"},
{"id": "clse07:204900", "ko": "「놀랍네」"},
{"id": "clse07:205000", "ko": "「우리 어린 양은 언제부터 내 허락도 없이 입을 열게 됐을까?」"},
{"id": "clse07:205100", "ko": "「그래, 어린 양♪」"},
{"id": "clse07:205200", "ko": "「그건 내가 할 말인데」"},
{"id": "clse07:205300", "ko": "「어린 양이 말해도 되는 건 내가 허락했을 때뿐이야. 가르쳐 줬잖니?」"},
{"id": "clse07:205400", "ko": "「오늘은 어지간히 놀아 주길 바라나 보네」"},
{"id": "clse07:205500", "ko": "「그래도 기뻐. 그건 이걸 원한다는 뜻이니까」"},
{"id": "clse07:205600", "ko": "「원하는 대로, 오늘은 실컷 놀・아・줄・게」"},
{"id": "clse07:205700", "ko": "「너는 내 하인이야. 잊어버렸으려나?」"},
{"id": "clse07:205800", "ko": "「아주 옛날부터. 그리고 앞으로도 쭉」"},
{"id": "clse07:205900", "ko": "「잊어버린 거야? 슬퍼……」"},
{"id": "clse07:206000", "ko": "「하지만 괜찮아. 떠올리게 해 줄 테니까」"},
{"id": "clse07:206100", "ko": "「아니, 좀 다르려나」"},
{"id": "clse07:206200", "ko": "「떠올릴 때까지 놀아 줄게」"},
{"id": "clse07:206300", "ko": "「우후후후후후후후후후후후」"},
{"id": "clse07:206400", "ko": "「……」"},
{"id": "clse07:206500", "ko": "「……」"},
{"id": "clse07:206600", "ko": "「……응」"},
{"id": "clse07:206700", "ko": "「……」"},
{"id": "clse07:206800", "ko": "「……」"},
{"id": "clse07:206900", "ko": "「……미야시로, 선배」"},
{"id": "clse07:207000", "ko": "「『뭘 위해서』냐니, 뻔하잖아」"},
{"id": "clse07:207100", "ko": "「아무도 없는 곳에서 남자애랑 여자애가 할 일이라고 하면 하나뿐이잖아?」"},
{"id": "clse07:207200", "ko": "「야・한・짓♪」"},
{"id": "clse07:207300", "ko": "「음후. 얼굴 빨개졌다. 귀여워♪」"},
{"id": "clse07:207400", "ko": "「미야시로 선배 너무하단 말이야. 내가 그렇게 대시했는데 전혀 눈치채 주지도 않고」"},
{"id": "clse07:207500", "ko": "「그래서 직접 행동에 나서기로 했어. 기정사실이라는 거?」"},
{"id": "clse07:207600", "ko": "「아〜, 아직도 모르는구나! 충격인데〜」"},
{"id": "clse07:207700", "ko": "「자, 이러면 어때?」"},
{"id": "clse07:207800", "ko": "「어때? 생각났어?」"},
{"id": "clse07:207900", "ko": "「당연하지〜!」"},
{"id": "clse07:208000", "ko": "「어딜 어떻게 봐도 나잖아〜!」"},
{"id": "clse07:208100", "ko": "「여기까지 해야 알아보는 미야시로 선배 쪽이 나로서는 더 놀랍다고〜!」"},
{"id": "clse07:208200", "ko": "「아이참, 왜〜!」"},
{"id": "clse07:208300", "ko": "「너무해〜. 미야시로 선배한테 나는 성적 대상에 안 들어간다는 거야〜?」"},
{"id": "clse07:208400", "ko": "「뭐, 상관없지만〜. 그래서 여기로 불러낸 거고」"},
{"id": "clse07:208500", "ko": "「미야시로 선배한테 내 매력을 알게 해 주려고」"},
{"id": "clse07:208600", "ko": "「으음, 좀 다른가. 알게 해 주는 게 아니라, ⟦rb⟧맛보게⟦rt⟧⟦rbc⟧●●●⟦/r⟧ ⟦rb⟧해 주는⟦rt⟧⟦rbc⟧●●●⟦/r⟧ 거야」"},
{"id": "clse07:208700", "ko": "「그래」"},
{"id": "clse07:208800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:208900", "ko": "「아하하! 미야시로 선배 귀여워〜!」"},
{"id": "clse07:209000", "ko": "「그럼, 시작해 볼까」"},
{"id": "clse07:209100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:209200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:209300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:209400", "ko": "「머리로 생각하면 안 돼. 좀 더 본능대로 움직이는 미야시로 선배가 보고 싶은데〜」"},
{"id": "clse07:209500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:209600", "ko": "「아이참, 역시 나한테 말하게 하고 싶은 거구나. 음흉하긴〜」"},
{"id": "clse07:209700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:209800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:209900", "ko": "「……」"},
{"id": "clse07:210000", "ko": "「응?」"},
{"id": "clse07:210100", "ko": "「……」"},
{"id": "clse07:210200", "ko": "「으읏!」"},
{"id": "clse07:210300", "ko": "「으읏! 으읏!」"},
{"id": "clse07:210400", "ko": "「으으으응!」"},
{"id": "clse07:210500", "ko": "「힉!」"},
{"id": "clse07:210600", "ko": "「으으읏!!」"},
{"id": "clse07:210700", "ko": "「으으으읏!!!!」"},
{"id": "clse07:210800", "ko": "「…………」"},
{"id": "clse07:210900", "ko": "「음후」"},
{"id": "clse07:211000", "ko": "「음후」"},
{"id": "clse07:211100", "ko": "「음후후」"},
{"id": "clse07:211200", "ko": "「앗하하! 더, 더는 못 참겠어!」"},
{"id": "clse07:211300", "ko": "「미, 미야시로 선배, 아무리 그래도 너무 착하잖아!! 앗하하하!!」"},
{"id": "clse07:211400", "ko": "「이히힛히! ……후우. 너무 웃겨서 웃다 죽을 뻔했어요」"},
{"id": "clse07:211500", "ko": "「음, 미야시로 선배는 무죄예요」"},
{"id": "clse07:211600", "ko": "「체육관 창고로 불러낸 건 저예요. 밀어 넘어뜨린 것도 저고요」"},
{"id": "clse07:211700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:211800", "ko": "「알겠어요. 사실은 숨긴 채로 둬도 되지만, 제대로 설명할게요」"},
{"id": "clse07:211900", "ko": "「자기 존엄까지 버려 가며 저를 지키려 한 미야시로 선배의 기사도 정신에 대한 보답이에요. 미야시로 선배, 다시 반했어요」"},
{"id": "clse07:212000", "ko": "「자자자, 여러분. 미야시로 선배는 일단은 저랑 하나를 지키려고 한 거니까, 그 마음씨를 봐서 이번엔 용서해 주자고요」"},
{"id": "clse07:212100", "ko": "「네, 말했어요」"},
{"id": "clse07:212200", "ko": "「저는 하나가 아니에요. 아, 아니, 이 몸은 분명 하나의 몸이지만, 저는 하나가 아니에요」"},
{"id": "clse07:212300", "ko": "「저는 하나가 만들어 낸 또 하나의 인격이에요」"},
{"id": "clse07:212400", "ko": "「네. 어느 날 하나는 이렇게 생각했어요. 이대로라면 한정된 학창 시절을 엠스에 다 써 버리고 끝나 버린다고」"},
{"id": "clse07:212500", "ko": "「뭐, 그건 그거대로 상관없지만. 이왕이면 이 남아도는 팔팔한 몸을 유용하게 쓰고 싶다고 생각했죠. 사춘기 소녀라면 누구나 생각하는 거예요. 나도 백마 탄 왕자님 품에 안기고 싶다고! 단, 부자에 잘생긴 사람 한정!」"},
{"id": "clse07:212600", "ko": "「하지만 하나는 이성은커녕 동성하고도 제대로 이야기를 못 해요. 게다가 설령 마음에 둔 분과 이야기할 수 있게 된다 해도, 하나의 능력은 하나가 말을 하는 한 무작위로 발동해요. 그건 피하고 싶었죠」"},
{"id": "clse07:212700", "ko": "「그래서 하나는 자기 대신 이 팔팔한 몸을 유용하게 써 줄 『또 하나의 자신』을 원했어요」"},
{"id": "clse07:212800", "ko": "「남녀 가리지 않고 편하게 이야기할 수 있고, 이야기를 해도 능력이 발동하지 않는 『또 하나의 자신』이요」"},
{"id": "clse07:212900", "ko": "「그 소원을 입 밖에 낸 순간 하나의 망상 구현화 능력이 발동해서, 저라는 인격이 태어난 거예요」"},
{"id": "clse07:213000", "ko": "「대인 커뮤니케이션 능력 제로인 하나가 장밋빛 청춘을 만끽하기 위해 만들어 낸 제2의 인격. 그게 저예요」"},
{"id": "clse07:213100", "ko": "「그야 물론 남자애랑 야한 짓을 하는 거죠♪」"},
{"id": "clse07:213200", "ko": "「음후」"},
{"id": "clse07:213300", "ko": "「그렇긴 해도 뭐, 기간 한정이에요. 하나도 저한테 무기한으로 몸을 빌려줄 생각은 없는지, 망상이 구현화된 시점부터 남은 시간이 정해져 있어요」"},
{"id": "clse07:213400", "ko": "「기한은 오늘 하루. 정확히는 잠들 때까지. 내일 눈을 뜨면 저는 깨끗이 사라져 있을 테니까, 그 점은 걱정 마시길」"},
{"id": "clse07:213500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:213600", "ko": "「자, 그런 사정이니까요」"},
{"id": "clse07:213700", "ko": "「하나의 꿈을 이뤄 주세요. 미야시로 선배」"},
{"id": "clse07:213800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:213900", "ko": "「네? 미야시로 선배」"},
{"id": "clse07:214000", "ko": "「정말, 안 되는 건가요……?」"},
{"id": "clse07:214100", "ko": "「와우」"}
]
