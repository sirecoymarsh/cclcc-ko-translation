[
{"id": "clse07:318100", "ko": "「타쿠루. 혹시 아리무라랑 싸우기라도 했니?」"},
{"id": "clse07:318200", "ko": "「그래? 그럼 다행이지만……」"},
{"id": "clse07:318300", "ko": "「아아, 아리무라. 왔구나. 다행이다」"},
{"id": "clse07:318400", "ko": "「그럼 정말 싸운 건 아니었구나」"},
{"id": "clse07:318500", "ko": "「아, 잠깐 타쿠루!」"},
{"id": "clse07:318600", "ko": "「타쿠루. 그리고 아리무라도, 그 소문 사실이야?」"},
{"id": "clse07:318700", "ko": "「그래서, 사실이야, 아니야?」"},
{"id": "clse07:318800", "ko": "「사실이라는 건, 아리무라, 너 타쿠루 방에?」"},
{"id": "clse07:318900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:319000", "ko": "「두 사람을 모르는 사람이라면 몰라도, 그치……」"},
{"id": "clse07:319100", "ko": "「뭐, 타쿠루랑 아리무라라면 괜찮겠지」"},
{"id": "clse07:319200", "ko": "「그래도 이토, 아까 그 말은 아무래도 아리무라한테 실례야」"},
{"id": "clse07:319300", "ko": "「아리무라 도시락, 분명 맛있을 거야. 그치, 타쿠루?」"},
{"id": "clse07:319400", "ko": "「실은 말이지. 그 레시피, 어제 아리무라가 가르쳐 달라고――」"},
{"id": "clse07:319500", "ko": "「어머, 그랬던가?」"},
{"id": "clse07:319600", "ko": "「말해 줬으면 우리 집 욕실 쓰게 해 줬을 텐데」"},
{"id": "clse07:319700", "ko": "「우리 집이면 상관없어. 뭣하면 같이 들어갈래?」"},
{"id": "clse07:319800", "ko": "「어머, 왜?」"},
{"id": "clse07:319900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:320000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:320100", "ko": "「있잖아, 아리무라. 전에도 말한 것 같은데……」"},
{"id": "clse07:320200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:320300", "ko": "「뭐?」"},
{"id": "clse07:320400", "ko": "「뭐가?」"},
{"id": "clse07:320500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:320600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:320700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:320800", "ko": "「정말, 세리카도 참……」"},
{"id": "clse07:320900", "ko": "「좋은 아침, 타쿠루」"},
{"id": "clse07:321000", "ko": "「정말, 또 아침부터 그렇게 어두운 얼굴 하고」"},
{"id": "clse07:321100", "ko": "「어머, 오늘은 꽤 기분이 안 좋네. 또 아리무라랑 싸우기라도 했어?」"},
{"id": "clse07:321200", "ko": "「……뭘 그렇게까지 발끈하고 그래……」"},
{"id": "clse07:321300", "ko": "「어머어머, 또 그런 구김투성이 셔츠를 입고」"},
{"id": "clse07:321400", "ko": "「요즘은 잘하는 줄 알았는데, 왜 그래……?」"},
{"id": "clse07:321500", "ko": "「타쿠루?」"},
{"id": "clse07:321600", "ko": "「이토. 그런 눈치 없는 말투는 그만둬」"},
{"id": "clse07:321700", "ko": "「아리무라, 아직 시부야에 있다거나, 그런 건 아닐까?」"},
{"id": "clse07:321800", "ko": "「그래. 이토 말대로 언제까지고 얼굴 안 보고 지낼 수는 없을 테니까, 언젠가 꼭 만날 수 있을 거야……」"},
{"id": "clse07:321900", "ko": "「카즈키. 아무리 게임이 막혔다고 그렇게 벽을 치면 안 된다고 늘 말하잖아」"},
{"id": "clse07:322000", "ko": "「카즈키…… 어떻게 이걸……?」"},
{"id": "clse07:322100", "ko": "「타쿠루. 생각은 나중에 해. 지금은 움직여야 해!」"},
{"id": "clse07:322200", "ko": "「내버려 둬, 이토」"},
{"id": "clse07:322300", "ko": "「그러니까 말했잖아……」"},
{"id": "clse07:322400", "ko": "「얘, 카즈키. 또 그러고……」"},
{"id": "clse07:322500", "ko": "「어머? 이거, 타쿠루랑 아리무라 아니야……?」"},
{"id": "clse07:322600", "ko": "「흐응, 이게 소문의……」"},
{"id": "clse07:322700", "ko": "「확실히 그러네. 원본 데이터도 지워 두는 게 좋겠어」"},
{"id": "clse07:322800", "ko": "「늦었잖아, 타쿠루. 지금까지 뭐 하고 있었어?」"},
{"id": "clse07:322900", "ko": "「너 부장이잖아. 부원한테 취재를 맡겨 놓기만 하면 안 되지?」"},
{"id": "clse07:323000", "ko": "「당연하지. 하루 종일 시부야 거리를 촬영하고, 뒤풀이를 겸해서」"},
{"id": "clse07:323100", "ko": "「타쿠루? 왜 그래?」"},
{"id": "clse07:323200", "ko": "「뭐라고!?」"},
{"id": "clse07:323300", "ko": "「타쿠루!」"},
{"id": "clse07:323400", "ko": "「너 말이야, 늘 말하잖아! 교복은 구겨지니까 입은 채로 자면 안 된다고!」"},
{"id": "clse07:323500", "ko": "「뭐라고!? 이건 아주 중요한 거야!」"},
{"id": "clse07:323600", "ko": "「혼자 살고 있으니까 몸가짐이 소홀해지는 거야! 타쿠루, 너 역시 아오바 기숙사로 돌아와야 해!」"},
{"id": "clse07:323700", "ko": "「이토, 우리 헤키호 학원의 교칙에 대해 하고 싶은 말이라도 있니?」"},
{"id": "clse07:323800", "ko": "「아니면 나 개인한테 하고 싶은 말이라도 있니?」"},
{"id": "clse07:323900", "ko": "「그래, 좋은 마음가짐이야」"},
{"id": "clse07:324000", "ko": "「동아리 활동을 하는 이상 휴일에도 교복을 입는 게 기본 원칙이야」"},
{"id": "clse07:324100", "ko": "「타쿠루? 정말 왜 그래? 어디 안 좋니?」"},
{"id": "clse07:324200", "ko": "「실은?」"},
{"id": "clse07:324300", "ko": "「…………」"},
{"id": "clse07:324400", "ko": "「타쿠루……」"},
{"id": "clse07:324500", "ko": "「기억 안 나? 어제 일」"},
{"id": "clse07:324600", "ko": "「정말? 아무것도? 어젯밤 일도?」"},
{"id": "clse07:324700", "ko": "「그럴 수가……」"},
{"id": "clse07:324800", "ko": "「앗하하하!」"},
{"id": "clse07:324900", "ko": "「다, 다들, 너, 너무 웃잖아!? 타, 쿠루한테, 실례, 잖아. 그, 그치?」"},
{"id": "clse07:325000", "ko": "「우후, 우후후후……」"},
{"id": "clse07:325100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:325200", "ko": "「타쿠루〜!?」"},
{"id": "clse07:325300", "ko": "「그러고 보니 그러네」"},
{"id": "clse07:325400", "ko": "「그건 나도 동감이야…… 타쿠루가 그런 말을 쓰다니」"},
{"id": "clse07:325500", "ko": "「그래도 그 춤은 좀 천박하다고 생각했어」"},
{"id": "clse07:325600", "ko": "「타쿠루, 농담이 아니라 정말 아무것도 기억 안 나는구나?」"},
{"id": "clse07:325700", "ko": "「알았어. 뭐 확실히 그건 잊는 게 나은 기억일지도, 큭, 후후……」"},
{"id": "clse07:325800", "ko": "「미, 미안. 나도 모르게……」"},
{"id": "clse07:325900", "ko": "「에헴」"},
{"id": "clse07:326000", "ko": "「어제는 말이지, 아침부터 신문부원이 전부 모여서 시부야 취재를 했어」"},
{"id": "clse07:326100", "ko": "「문화제용 기사 소재를 모으려고, 시부야의 역사를 더듬어 볼 수 있는 곳을 돌았지」"},
{"id": "clse07:326200", "ko": "「암거에 숨어 있는 시부야강이라든가, 시부야 지진 부흥의 상징인 히카리오라든가」"},
{"id": "clse07:326300", "ko": "「그런데 이토는 계속 몰래 와 있는 아이돌이 없나 찾느라 제대로 사진을 안 찍어 주고」"},
{"id": "clse07:326400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:326500", "ko": "「뭐, 그래도 어떻게든 취재가 끝나서 미야시타 공원에 돌아온 게 저녁쯤이었지」"},
{"id": "clse07:326600", "ko": "「그래도 돌아가기엔 이르니까 자연스럽게 뒤풀이를 하자는 얘기가 나와서」"},
{"id": "clse07:326700", "ko": "「제일 먼저 돌아간 건 아리무라였던가?」"},
{"id": "clse07:326800", "ko": "「나랑 세리카는 같이 돌아갔지?」"},
{"id": "clse07:326900", "ko": "「이토가 남아 줬어. 타쿠루, 이토한테 고마워해」"},
{"id": "clse07:327000", "ko": "「응? 뭐가?」"},
{"id": "clse07:327100", "ko": "「아직 잠이 덜 깼나. 다른 사람은 아무도 없었어」"},
{"id": "clse07:327200", "ko": "「그렇게까지 말하는 근거라도 있는 거야?」"},
{"id": "clse07:327300", "ko": "「여기서 지시를 내려 줬어. 취재조도 중간에 두 조로 나뉘어서 따로 움직이기도 했고」"},
{"id": "clse07:327400", "ko": "「확실히, 평소랑은 좀 달랐나」"},
{"id": "clse07:327500", "ko": "「뭐랄까, 즐거워 보였어」"},
{"id": "clse07:327600", "ko": "「타쿠루, 왜 그래?」"},
{"id": "clse07:327700", "ko": "「잠깐, 타쿠루!」"},
{"id": "clse07:327800", "ko": "「타쿠루! 카즈키!」"},
{"id": "clse07:327900", "ko": "「카와하라가, 카즈키가 여기 들어가는 걸 봤다고 알려 줬어」"},
{"id": "clse07:328000", "ko": "「심각한 얼굴로 안에 들어갔으니까 상태를 보는 게 좋을지도 모른다고」"}
]
