[
{"id": "clyu05:10000", "ko": "결국 나는 유이의 응석을 받아 주고 있었다."},
{"id": "clyu05:10100", "ko": "유이의 머리를 살며시 쓰다듬어 준다."},
{"id": "clyu05:10200", "ko": "생각해 보면 유이에게 이런 걸 해 주는 건 처음일지도 모른다……"},
{"id": "clyu05:10300", "ko": "「내가 있잖아」"},
{"id": "clyu05:10400", "ko": "「정말?」"},
{"id": "clyu05:10500", "ko": "「그래……」"},
{"id": "clyu05:10600", "ko": "유이는 촉촉한 눈으로 나를 올려다보았다."},
{"id": "clyu05:10700", "ko": "「있잖아…… 타쿠루 오빠. 부탁이 있는데……」"},
{"id": "clyu05:10800", "ko": "「뭐, 뭐야?」"},
{"id": "clyu05:10900", "ko": "「조금만 더 그렇게 쓰다듬어 줄래?」"},
{"id": "clyu05:11000", "ko": "「……그래」"},
{"id": "clyu05:11100", "ko": "「……고마워」"},
{"id": "clyu05:11200", "ko": "그렇게 말하고 유이는 내 가슴에 얼굴을 묻었다."},
{"id": "clyu05:11300", "ko": "", "note": "보류 — 연애 묘사(미성년·가족, 11300~11900)"},
{"id": "clyu05:11400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
