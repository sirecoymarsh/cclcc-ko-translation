[
{"id": "clah06:10000", "ko": "「흐윽…… 흐어어어어어엉〜……」"},
{"id": "clah06:10100", "ko": "「아리무라……」"},
{"id": "clah06:10200", "ko": "「그러니까 말했잖슴까아…… 쥐약이라고오오……」", "note": "탁점을 붙여 일그러진 울음 섞인 발음 → 늘인 소리로"},
{"id": "clah06:10300", "ko": "「저어 그런 이야기는 안 된다구요오오오……」"},
{"id": "clah06:10400", "ko": "쥐약이라는 게 그런 뜻이었나……"},
{"id": "clah06:10500", "ko": "「으으…… 히끅……」"},
{"id": "clah06:10600", "ko": "정말이지……"},
{"id": "clah06:10700", "ko": "정말, 여동생이라고 할까…… 유이나 우키보다도 훨씬 어린애 같네."},
{"id": "clah06:10800", "ko": "「알았으니까 그만 울어, 응?」"},
{"id": "clah06:10900", "ko": "지나가는 사람들이 나를 힐끔힐끔 쳐다보고 있다."},
{"id": "clah06:11000", "ko": "이래서야 꼭 내가 울린 것 같잖아."},
{"id": "clah06:11100", "ko": "「그럼, 제 부탁 들어 줄 거예요오〜?」"},
{"id": "clah06:11200", "ko": "「부탁? 뭔데」"},
{"id": "clah06:11300", "ko": "「크레이프 먹고 싶어……」"},
{"id": "clah06:11400", "ko": "「에헤헤헤에」"},
{"id": "clah06:11500", "ko": "크레이프를 사 주자마자 완전히 기분이 풀리다니, 속 보이는 녀석이다."},
{"id": "clah06:11600", "ko": "그건 그렇고……"},
{"id": "clah06:11700", "ko": "「응? 혹시 크림 묻었어요?」"},
{"id": "clah06:11800", "ko": "「아니……」"},
{"id": "clah06:11900", "ko": "뭔가, 학교에 있을 때하고도, 내 방에서 이것저것 할 때하고도 다르단 말이지."},
{"id": "clah06:12000", "ko": "솔직하다고 할까 뭐랄까."},
{"id": "clah06:12100", "ko": "이것도 “휴일” 탓인가?"},
{"id": "clah06:12200", "ko": "늘 이런 식이면 아리무라도 꽤 귀여운 구석이 있는데."},
{"id": "clah06:12300", "ko": "「뭐, 뭠까 뭠까? 아까부터 빤히 쳐다보고〜」"},
{"id": "clah06:12400", "ko": "「벼, 별로……」"},
{"id": "clah06:12500", "ko": "「아〜, 혹시 혹시〜. “아리무라도 이렇게 보니까 귀엽네” 같은 생각 해 버렸어요〜?」"},
{"id": "clah06:12600", "ko": "「그, 그런 생각 안 했거든」"},
{"id": "clah06:12700", "ko": "「에?」"},
{"id": "clah06:12800", "ko": "「아………」"},
{"id": "clah06:12900", "ko": "아차……!"},
{"id": "clah06:13000", "ko": "무심코 입 밖에 내 버렸다."},
{"id": "clah06:13100", "ko": "이건 분명……"},
{"id": "clah06:13200", "ko": "「앗싸아아, 왔다〜! 드디어 선배도 이 히나에의 매력에 넘어갔군요!」"},
{"id": "clah06:13300", "ko": "「후훗후〜웅. 뭐, 어쩔 수 없슴다. 저 깜찍하니까아」"},
{"id": "clah06:13400", "ko": "「저기. 지금 어떤 기분? 어떤 기분?」"},
{"id": "clah06:13500", "ko": "하는 식으로, 개선장군이라도 된 것처럼 약 올릴 게 틀림없다."},
{"id": "clah06:13600", "ko": "「아, 아니야. 방금 그건――」"},
{"id": "clah06:13700", "ko": "「…………」"},
{"id": "clah06:13800", "ko": "어라?"},
{"id": "clah06:13900", "ko": "「에, 그러니까……」"},
{"id": "clah06:14000", "ko": "이 녀석…… 설마."},
{"id": "clah06:14100", "ko": "「아리무라…… 혹시 쑥스러워하는 거야?」"},
{"id": "clah06:14200", "ko": "「네? 벼, 별로 안 쑥스러워하거든뇨!」"},
{"id": "clah06:14300", "ko": "혀 꼬였다."},
{"id": "clah06:14400", "ko": "누가 봐도 쑥스러워하고 있다."},
{"id": "clah06:14500", "ko": "혹시 아리무라, 의외로 맷집이 약한 건가?"},
{"id": "clah06:14600", "ko": "그러고 보니 늘 짜증 날 만큼 자화자찬을 하니까, 주위에서 그런 말을 들은 적은 사실 별로 없는 거 아닐까?"},
{"id": "clah06:14700", "ko": "이건…… 혹시 파고들 틈이 아닐까."},
{"id": "clah06:14800", "ko": "「뭐, 뭐어, 그러니까…… 어디까지나 겉모습만 놓고 보면, 아리무라도 꽤 귀여운 편이 아닌가 싶은데……」"},
{"id": "clah06:14900", "ko": "아차!"},
{"id": "clah06:15000", "ko": "놀리려던 건데, 오히려 내 쪽이 평소에 이런 말을 해 본 적이 없다 보니 그냥 평범하게 칭찬하는 꼴이 되어 버렸다!"},
{"id": "clah06:15100", "ko": "「그, 그래…… 요? 그건 저기…… 고맙…… 습니다……」"},
{"id": "clah06:15200", "ko": "「…………」"},
{"id": "clah06:15300", "ko": "어색하다……"},
{"id": "clah06:15400", "ko": "이래서야 중학생 커플이잖아."},
{"id": "clah06:15500", "ko": "「서, 선배 크레이프 맛있어 보임다〜!」"},
{"id": "clah06:15600", "ko": "「어?」"},
{"id": "clah06:15700", "ko": "「빈틈이다〜! 앙!」"},
{"id": "clah06:15800", "ko": "「아……」"},
{"id": "clah06:15900", "ko": "혹시 쑥스러운 걸 얼버무리려고 그런 건지도 모르지만, 방금 그건……"},
{"id": "clah06:16000", "ko": "아니, 그래도……"},
{"id": "clah06:16100", "ko": "「음…… 맛있다〜」"},
{"id": "clah06:16200", "ko": "그래."},
{"id": "clah06:16300", "ko": "오노에는 맨날 남의 걸 가로채 먹고, 아무리 그래도 요즘 세상에 간접 키스로 쑥스러워하는 여자애는 없겠지."},
{"id": "clah06:16400", "ko": "「아……」"},
{"id": "clah06:16500", "ko": "에에에에에, 쑥스러워하고 있어!?"},
{"id": "clah06:16600", "ko": "그것도 이제 와서?"},
{"id": "clah06:16700", "ko": "지금까지 그렇게 『아〜 해』 같은 걸 강요해 놓고서?"},
{"id": "clah06:16800", "ko": "「에, 에〜또, 방금 그건 그게에……」"},
{"id": "clah06:16900", "ko": "아니, 잠깐."},
{"id": "clah06:17000", "ko": "뭔가 이상하다."},
{"id": "clah06:17100", "ko": "그 아리무라가 고작 이 정도로 쑥스러워할까."},
{"id": "clah06:17200", "ko": "……역시 아니지."},
{"id": "clah06:17300", "ko": "다른 사람도 아니고 아리무라가 그런 순진한 반응을 보일 리 없다."},
{"id": "clah06:17400", "ko": "하지만……"},
{"id": "clah06:17500", "ko": "「…………」"},
{"id": "clah06:17600", "ko": "쑥스러워하는 모습―― 이것만큼은 거짓으로 보이지 않는다."},
{"id": "clah06:17700", "ko": "왠지 몸을 배배 꼬는 것 같기도 하고."},
{"id": "clah06:17800", "ko": "그렇다는 건, 달리 뭔가 쑥스러워하거나 부끄러워할 이유가 있다는 거다."},
{"id": "clah06:17900", "ko": "대체 뭐지?"},
{"id": "clah06:18000", "ko": "「꺄앗!!!」"},
{"id": "clah06:18100", "ko": "그때, 갑자기 우리 사이로 돌풍이 휙 불어 지나갔다."},
{"id": "clah06:18200", "ko": "아리무라가 치마를 누르며 얼굴이 새빨개져 있다."},
{"id": "clah06:18300", "ko": "뭐지?"},
{"id": "clah06:18400", "ko": "「……보, 봤어?」"},
{"id": "clah06:18500", "ko": "「어?」"},
{"id": "clah06:18600", "ko": "「봤죠?」"},
{"id": "clah06:18700", "ko": "「보, 봤다니…… 뭘?」"},
{"id": "clah06:18800", "ko": "「읏…… 시치미 떼지 마세요. 봤으면서」"},
{"id": "clah06:18900", "ko": "아니, 결단코 안 봤다."},
{"id": "clah06:19000", "ko": "하지만 아까와도 다른 아리무라의 모습에, 나는 어안이 벙벙해서 아무 말도 하지 못했다."},
{"id": "clah06:19100", "ko": "「그게…… 늘 이런 건 아니에요! 어쩌다 그런 거예요! 어쩌다 오늘은…… 없을 뿐이고!」"},
{"id": "clah06:19200", "ko": "「없어?」"},
{"id": "clah06:19300", "ko": "뭐가?"},
{"id": "clah06:19400", "ko": "「참…… 알면서」"},
{"id": "clah06:19500", "ko": "아리무라는 아까부터 유난히 치마를 신경 쓰고 있다."},
{"id": "clah06:19600", "ko": "서, 설마……"},
{"id": "clah06:19700", "ko": "「너, 너 설마 안 입은 거냐!?」"},
{"id": "clah06:19800", "ko": "「읏…………」"},
{"id": "clah06:19900", "ko": "아리무라는 부끄러운 듯 얼굴을 붉히고, 나를 올려다보며 작게 고개를 끄덕였다."}
]
