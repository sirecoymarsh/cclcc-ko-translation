[
{"id": "clyu06:0", "ko": "그리고 다음 날도――"},
{"id": "clyu06:100", "ko": "「거기 리듬은 탄, 타탄, 탄이야!」"},
{"id": "clyu06:200", "ko": "「그러니까…… 탁, 탁탁, 탁……?」"},
{"id": "clyu06:300", "ko": "「그러니까, 탄, 타탄, 탄, 이라니까~」"},
{"id": "clyu06:400", "ko": "「우우……」"},
{"id": "clyu06:500", "ko": "「그리고 여기서 스텝이야!」"},
{"id": "clyu06:600", "ko": "「스, 스텝……!」"},
{"id": "clyu06:700", "ko": "그다음 날도――"},
{"id": "clyu06:800", "ko": "「자, 턴!」"},
{"id": "clyu06:900", "ko": "「터, 턴…… 꺅!!」⟦avs⟧⟦n⟧⟦n⟧"},
{"id": "clyu06:1000", "ko": "「괜찮아, 유이? 좀 쉴래?」"},
{"id": "clyu06:1100", "ko": "「아, 아니. 아직 괜찮아! 유, 방금 거기 한 번 더!」"},
{"id": "clyu06:1200", "ko": "「으, 응……」"},
{"id": "clyu06:1300", "ko": "유이와 유토의 연습은 날이면 날마다 이어졌다."},
{"id": "clyu06:1400", "ko": "그건 내가 상상했던 것보다 훨씬 진지하고 혹독했다."},
{"id": "clyu06:1500", "ko": "유이뿐만 아니라 유토도 마찬가지다."},
{"id": "clyu06:1600", "ko": "처음엔 마지못해 했던 만큼 더 빨리 질려서 내팽개칠 줄 알았는데, 결코 그런 일은 없었다."},
{"id": "clyu06:1700", "ko": "그리고 열흘쯤 지나자 그 성과가 눈에 보이기 시작했다."},
{"id": "clyu06:1800", "ko": "「마지막으로 여기서 포즈!」"},
{"id": "clyu06:1900", "ko": "「!!!」"},
{"id": "clyu06:2000", "ko": "「…………」"},
{"id": "clyu06:2100", "ko": "「하아…… 하아…… 어때……?」"},
{"id": "clyu06:2200", "ko": "조심스레 내 얼굴을 살피는 유이에게 나는 힘차게 엄지를 세워 보였다."},
{"id": "clyu06:2300", "ko": "「해냈구나, 유이! 끝까지 제대로 췄어!」"},
{"id": "clyu06:2400", "ko": "「정말?!」"},
{"id": "clyu06:2500", "ko": "「응! 제대로 했어!」"},
{"id": "clyu06:2600", "ko": "「해냈다아아아아아아아!!」"},
{"id": "clyu06:2700", "ko": "펄쩍 뛰며 기뻐하는 유이를 보니 내 얼굴도 저절로 풀어졌다."},
{"id": "clyu06:2800", "ko": "「이것도 타쿠루 오빠랑 유 덕분이야! 고마워~!」"},
{"id": "clyu06:2900", "ko": "「아니, 누나가 열심히 했으니까 그런 거야」"},
{"id": "clyu06:3000", "ko": "손을 맞잡고 기뻐하는 두 사람을 보며 나는 절실히 느끼고 있었다."},
{"id": "clyu06:3100", "ko": "――⟦rb⟧이건⟦rt⟧⟦rbc⟧●●⟦/r⟧ ⟦rb⟧좋은 그림이⟦rt⟧⟦rbc⟧●●●●●⟦/r⟧ ⟦rb⟧나왔다⟦rt⟧⟦rbc⟧●●●⟦/r⟧――라고."},
{"id": "clyu06:3200", "ko": "「있잖아 있잖아! 이걸로 드디어 “⟦col:280aa02d1400⟧춤춰 봤다⟦col:800000⟧”에 올릴 수 있지?」"},
{"id": "clyu06:3300", "ko": "「그거 말인데…… 실은 둘한테 보여 주고 싶은 게 있어」"},
{"id": "clyu06:3400", "ko": "「보여 주고 싶은…… 거?」"},
{"id": "clyu06:3500", "ko": "나는 두 사람을 손짓해 부르고는 태블릿을 꺼냈다."},
{"id": "clyu06:3600", "ko": "그 페이지를 들여다본 두 사람의 의아한 얼굴이 차츰 놀라움으로 바뀌어 갔다."},
{"id": "clyu06:3700", "ko": "「타쿠루 오빠…… 이거……」"},
{"id": "clyu06:3800", "ko": "「그래, 『⟦col:280aa02d1400⟧밀푀유⟦col:800000⟧』 채널이다」"},
{"id": "clyu06:3900", "ko": "지금까지 나는 자기 동작을 다시 볼 수 있게 한다는 명목으로 두 사람의 춤을 녹화하고 있었다."},
{"id": "clyu06:4000", "ko": "그렇게 날마다 쌓여 가는 영상을 보기 좋은 길이로 편집해서, 매일 몰래 니야동에 올리고 있었던 것이다."},
{"id": "clyu06:4100", "ko": "「이거…… 정말 우리……?」"},
{"id": "clyu06:4200", "ko": "「그래……」"},
{"id": "clyu06:4300", "ko": "「봐, 누나…… 조회 수…… 이렇게 많은 사람이 보고 있어?」"},
{"id": "clyu06:4400", "ko": "「정말이네……」"},
{"id": "clyu06:4500", "ko": "영상을 올리기 시작한 처음 이틀 정도는 그야말로 엉망이었다."},
{"id": "clyu06:4600", "ko": "애초에 시청자 수가 적은 데다, 못한다느니 그만두라느니 하는 신랄한 댓글만 달렸다."},
{"id": "clyu06:4700", "ko": "분위기가 바뀐 건 사흘이 지났을 무렵이었다."},
{"id": "clyu06:4800", "ko": "그때까지 달리던 욕설과 악담이 차츰 응원으로 바뀌기 시작했다."},
{"id": "clyu06:4900", "ko": "유이의 필사적인 모습과 아무리 실패해도 꺾이지 않는 노력에, 다들 마음이 움직이기 시작한 것이다."},
{"id": "clyu06:5000", "ko": "그와 동시에 조회 수도 점점 늘어 갔다."},
{"id": "clyu06:5100", "ko": "「그런데 타쿠루 형, 언제……」"},
{"id": "clyu06:5200", "ko": "「그러게. 알려 줬으면 좋았잖아……」"},
{"id": "clyu06:5300", "ko": "「알려 주면 둘 다 의식하게 되잖아」"},
{"id": "clyu06:5400", "ko": "「그건 그렇지만……」"},
{"id": "clyu06:5500", "ko": "이런 건 되도록 자연스러운 게 좋다."},
{"id": "clyu06:5600", "ko": "그래야 보는 사람이 공감할 수 있는 법이다."},
{"id": "clyu06:5700", "ko": "「그래도, 왠지 거짓말 같아……」"},
{"id": "clyu06:5800", "ko": "「거짓말 아니야. 이만큼이나 되는 사람들이 너희 둘을 응원해 주고 있어」"},
{"id": "clyu06:5900", "ko": "아이돌이라고 당당히 말하기에는 그 조회 수는 아직 멀었을지도 모른다."},
{"id": "clyu06:6000", "ko": "그래도 두 사람에게 용기를 주기에는 충분했다."},
{"id": "clyu06:6100", "ko": "「유!」"},
{"id": "clyu06:6200", "ko": "「응!」"},
{"id": "clyu06:6300", "ko": "「해냈다!」"},
{"id": "clyu06:6400", "ko": "손을 꼭 맞잡고 함께 기쁨을 곱씹더니, 유이는 나를 마주 보았다."},
{"id": "clyu06:6500", "ko": "「타쿠루 오빠……」"},
{"id": "clyu06:6600", "ko": "「응?」"},
{"id": "clyu06:6700", "ko": "「고마워!!」⟦avs⟧⟦n⟧⟦n⟧"},
{"id": "clyu06:6800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:6900", "ko": "「우왓! 야, 매달리지 말라니까……」"},
{"id": "clyu06:7000", "ko": "「에헤헤. 그치만 기쁘단 말야」"},
{"id": "clyu06:7100", "ko": "「야, 야, 그만하라니까!」"},
{"id": "clyu06:7200", "ko": "「어때, 조금쯤은. 남매잖아?」"},
{"id": "clyu06:7300", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:7400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:7500", "ko": "「아하하. 타쿠루 형, 쑥스러워한다 쑥스러워한다」"},
{"id": "clyu06:7600", "ko": "「따, 딱히 쑥스러워하는 거 아니……」"},
{"id": "clyu06:7700", "ko": "내가 당황하는 데는 또 하나 큰 이유가 있었다."},
{"id": "clyu06:7800", "ko": "만약……"},
{"id": "clyu06:7900", "ko": "만약 이런 모습을 노노한테라도 들키기라도 하면――"},
{"id": "clyu06:8000", "ko": "「저기, 유이. 타쿠루가 안 보이는데, 어디 갔는지 알――」"},
{"id": "clyu06:8100", "ko": "으레 나쁜 예감은 들어맞는 법이다."},
{"id": "clyu06:8200", "ko": "노노는 들어오자마자 우리 모습을 보고 굳어 버렸다."},
{"id": "clyu06:8300", "ko": "「타쿠루……」"},
{"id": "clyu06:8400", "ko": "쿠…… 쿠루스…… 아니야, 이건――"},
{"id": "clyu06:8500", "ko": "「어머, 타쿠루. 잘됐네~. 유이가 놀아 줘서」"},
{"id": "clyu06:8600", "ko": "（어……?）"},
{"id": "clyu06:8700", "ko": "무슨 소리지?"},
{"id": "clyu06:8800", "ko": "화가…… 안 났다."},
{"id": "clyu06:8900", "ko": "아니, 침착하게 생각해 보면 노노는 그냥 누나고, 유이와도 떳떳하지 못한 짓은 하나도 안 했으니 혼날 이유도 없지만."},
{"id": "clyu06:9000", "ko": "「후훗. 타쿠루. 착하게 있었나 보구나」"},
{"id": "clyu06:9100", "ko": "뭐?"},
{"id": "clyu06:9200", "ko": "무슨 소리야, 노노 녀석."},
{"id": "clyu06:9300", "ko": "착하게 있었냐니―― 완전히 애 취급이잖아."},
{"id": "clyu06:9400", "ko": "아니면 사실은 화가 나서 나를 놀리는 건가?"},
{"id": "clyu06:9500", "ko": "「자, 타쿠루. 이리 오렴. 착하지 착하지 해 줄게」"},
{"id": "clyu06:9600", "ko": "노노는 어째선지 갑자기 그 자리에 쪼그려 앉아 두 팔을 벌려 보였다."},
{"id": "clyu06:9700", "ko": "역시 나를 놀리고 있는 모양이다."},
{"id": "clyu06:9800", "ko": "“착하지 착하지”는 무슨."},
{"id": "clyu06:9900", "ko": "그런 걸 해 달라고 한 적――"}
]
