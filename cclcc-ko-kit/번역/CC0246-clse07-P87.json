[
{"id": "clse07:829500", "ko": "「어, 어떻게……!?」"},
{"id": "clse07:829600", "ko": "「오, 오지 마! 오면 이 녀석을 죽인다!!」"},
{"id": "clse07:829700", "ko": "「나, 나가……」"},
{"id": "clse07:829800", "ko": "「지, 지금 당장 여기서 나가! 안 그러면 이 녀석을 죽인다――!」"},
{"id": "clse07:829900", "ko": "「몇 번이나 말하게 하지 마! 빨리, 빨리 나가――」"},
{"id": "clse07:830000", "ko": "「뭐, 뭐야!?」"},
{"id": "clse07:830100", "ko": "「크억!!」"},
{"id": "clse07:830200", "ko": "「우윽!」"},
{"id": "clse07:830300", "ko": "「웁…… 우웨에에에에엑」"},
{"id": "clse07:830400", "ko": "「보지 마! 이, 이쪽 보지 마!」"},
{"id": "clse07:830500", "ko": "「좋아. 오랜만에 가족이 다 모였구나. 그럼, 잘 먹겠습니다!」"},
{"id": "clse07:830600", "ko": "「그보다 말이다, 고기가 안 들어 있잖냐, 고기가」"},
{"id": "clse07:830700", "ko": "「요것뿐이잖냐. 게다가 닭고기라니. 카레라면 소고기지, 소고기」"},
{"id": "clse07:830800", "ko": "「참 나, 그런 데만 센리를 닮아 가지고는」"},
{"id": "clse07:830900", "ko": "「어? 아, 아니…… 그런 건 아니고……」"},
{"id": "clse07:831000", "ko": "「……어이, 잠깐. 타쿠루 카레엔 고기가 잔뜩 들었잖냐! 편애다, 편애! 가족은 모두 평등하게, 그게 ⟦rb⟧아오바 기숙사⟦rt⟧우리 집⟦/r⟧ 규칙이잖냐」"},
{"id": "clse07:831100", "ko": "「방금 정했다. 자, 타쿠루! 고기 내놔, 고기!」"},
{"id": "clse07:831200", "ko": "「닭고기라도 없는 것보단 낫다! 내놔!」"},
{"id": "clse07:831300", "ko": "「앙…… 헹, 벌써 먹어 치웠다」"},
{"id": "clse07:831400", "ko": "「뭐냐, 유이. 너, 아직도 마술이니 뭐니 하는 게 좋냐?」"},
{"id": "clse07:831500", "ko": "「유이 녀석, 옛날에 자주 그랬거든. 마법을 쓸 수 있으면 좋겠다느니 뭐니」"},
{"id": "clse07:831600", "ko": "「바보 취급하는 게 아니라니까. 언제까지고 어린애 그대로라고 생각했을 뿐이다」"},
{"id": "clse07:831700", "ko": "「꿈이 아니라고? 뭐냐, 그게. 대체 무슨 뜻이냐?」"},
{"id": "clse07:831800", "ko": "「유이. 마법으로 고기 좀 꺼내 줘라, 고기!」"},
{"id": "clse07:831900", "ko": "「어이어이, 타쿠루. 뭘 그렇게 필사적이냐」"},
{"id": "clse07:832000", "ko": "「뭐, 어쨌든 이렇게 가족끼리 오붓하게 있는 것도 좋잖냐, 응? 타쿠루?」"},
{"id": "clse07:832100", "ko": "「하하하! 그럼 가끔이라도 좋으니까, 이렇게 돌아와라」"},
{"id": "clse07:832200", "ko": "「잘 먹었습니다」"},
{"id": "clse07:832300", "ko": "「저 녀석…… 등에 눈이라도 달렸냐?」"},
{"id": "clse07:832400", "ko": "「어쩔 수 없지, 욕실 청소나 하고 올까」"},
{"id": "clse07:832500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:832600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:832700", "ko": "「와하하! 그렇냐. 알고 있으면 됐다」"},
{"id": "clse07:832800", "ko": "「오우. 그렇지, 타쿠루. 가끔은 같이――」"},
{"id": "clse07:832900", "ko": "「어, 어어…… 그, 그러냐……」"},
{"id": "clse07:833000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:833300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:833900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:834000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:834100", "ko": "「어이, 왜 그러냐, 타쿠루?」"},
{"id": "clse07:834200", "ko": "「뭐, 뭐야. 사람을 괴물 보듯이」"},
{"id": "clse07:834300", "ko": "「왜 그래? 숨이 차잖냐. 감기냐?」"},
{"id": "clse07:834400", "ko": "「그…… 그러냐? 그럼 됐다만」"},
{"id": "clse07:834500", "ko": "「생후 3개월쯤 됐겠군」"},
{"id": "clse07:834600", "ko": "「그렇지. 하지만 이 편지를 쓴 엄마가 안 돌아온다고 아직 정해진 건 아니다」"},
{"id": "clse07:834700", "ko": "「그래. 이런 경우, 나중에 후회하고 돌아오는 예도 적지 않으니까」"},
{"id": "clse07:834800", "ko": "「그래서, 이 아기 말인데……」"},
{"id": "clse07:834900", "ko": "「어, 어째서 그렇게 되는 거냐!」"},
{"id": "clse07:835000", "ko": "「지금도 줄이고 있는데 말이지……」"},
{"id": "clse07:835100", "ko": "「미안하지만 나는 오늘 오후부터 1주일쯤 학회 때문에 나가 봐야 한다」"},
{"id": "clse07:835200", "ko": "「하하하! 잠깐 못 본 사이에 너희도 육아가 완전히 몸에 뱄구나」"},
{"id": "clse07:835300", "ko": "「너는 여전히 딱딱하구나. 그런 건 생각해 봤자 소용없다. 될 대로 되는 거야」"},
{"id": "clse07:835400", "ko": "「뭐, 일단 내일부터 한동안 아기는 내가 봐 줄 테니까. 너는 학교나 제대로 가라」"},
{"id": "clse07:835500", "ko": "「당연하지. 날 누구라고 생각하는 거냐」"},
{"id": "clse07:835600", "ko": "「아이고~…… 너희, 가족이면 날 좀 믿어 줘라……」"},
{"id": "clse07:835700", "ko": "「봐라, 히카리도 이렇게 말하잖냐」"},
{"id": "clse07:835800", "ko": "「안다니까. 너는 여전히 걱정이 많구나」"},
{"id": "clse07:835900", "ko": "「오냐, 다녀와라!」"},
{"id": "clse07:836000", "ko": "「그 미안하다는 마음을, 앞으로는 아이한테 쏟아 주게」"},
{"id": "clse07:836100", "ko": "「자, 모두 웃으면서 배웅해 줘라」"},
{"id": "clse07:836200", "ko": "「자, 너희도」"},
{"id": "clse07:836300", "ko": "「그 미안하다는 마음을, 앞으로는 아이한테 쏟아 주게」"},
{"id": "clse07:836400", "ko": "「자, 모두 웃으면서 배웅해 줘라」"},
{"id": "clse07:836500", "ko": "「자, 너희도」"},
{"id": "clse07:836600", "ko": "「우키. 이거, 부탁한다」"},
{"id": "clse07:836700", "ko": "「어이, 우키. 그거 어디 뒀더라? 그러니까, 왜, 그거 말이다!」"},
{"id": "clse07:836800", "ko": "「응? 아아, 진짜네. 나이 먹으면 툭하면 이래. 싫어진다니까」"},
{"id": "clse07:836900", "ko": "「그나저나 우키. 너, 용케 알았구나」"},
{"id": "clse07:837000", "ko": "「하핫, 역시구나」"},
{"id": "clse07:837100", "ko": "「하하하! 뭐 어떠냐. 젊은 녀석은 많이 먹어야지」"},
{"id": "clse07:837200", "ko": "「일부러 오게 해서 미안하다」"},
{"id": "clse07:837300", "ko": "「너는 여전히 입이 험하군」"},
{"id": "clse07:837400", "ko": "「네가 봐 줬으면 하는 건 이 “소녀”다. 나이는 올해로 열다섯 살이 된다」"},
{"id": "clse07:837500", "ko": "「온갖 검사도 치료도 다 했다. 그래도 어떻게 판단해야 할지 모르겠어. 그래서 전문가로서 네 의견을 듣고 싶다―― 여기까지 말하면 알겠지?」"},
{"id": "clse07:837600", "ko": "「자세한 건 나중에 얘기하지. 일단 봐 주지 않겠나」"},
{"id": "clse07:837700", "ko": "「그래. 사쿠마 일당―― 기가로매니악스 연구를 계속하던 의사 놈들 말이다―― 그놈들을 전원 체포했는데, 그중 한 명의 병원에 감금되어 있었다」"},
{"id": "clse07:837800", "ko": "「그게…… 이 아이한테만은 효과가 없어」"},
{"id": "clse07:837900", "ko": "「이게 진료 기록이다. 이 아이를 감금했던 의사의 것인데…… 읽어 봐 줘」"},
{"id": "clse07:838000", "ko": "「그래. 이 아이를 연구하던 의사도 마지막엔 감당할 수 없게 된 모양이라. 이렇게 묶어 둔 채로 약으로 안락사시킬 생각이었던 것 같다」"},
{"id": "clse07:838100", "ko": "「진료 기록을 읽어 보면 알 거다. 우리가 손쓸 수 없어서 너를 여기로 부른 이유도」"},
{"id": "clse07:838200", "ko": "「진료 기록과 함께 이 환자에 관한 보고서도 압수했다. 나는 어려운 이론엔 약해서 제대로 이해하진 못했지만…… 엄청난 능력자라는 것만은 알겠어」"},
{"id": "clse07:838300", "ko": "「쿠, 쿠노사토 씨? 왜 그래?」"},
{"id": "clse07:838400", "ko": "「그렇군. 얘기는 대충 알았다」"},
{"id": "clse07:838500", "ko": "「뭐, 이번엔 특별히 봐주겠다, 미야시로 군. 호텔 안에 침입했다면 서까지 가야 했겠지만, 미수니까……」"},
{"id": "clse07:838600", "ko": "「……… 이봐? 나는 정처 없이 돌아다니는 것도 아니고, 너희랑 잡담을 하는 것도 아니다」"}
]
