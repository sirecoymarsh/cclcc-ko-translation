[
{"id": "clse07:127800", "ko": "「그야 확실히 처음에는 이상한 고집 싸움으로 시작된 일일지도 모르지만, 그렇다고 너까지 그렇게 고집부릴 필요는 없잖아」"},
{"id": "clse07:127900", "ko": "「부리고 있어」"},
{"id": "clse07:128000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:128100", "ko": "「그 누구에게나 싹싹한 아리무라가? 갈 데라면 얼마든지 있겠지」"},
{"id": "clse07:128200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:128300", "ko": "「그러니까 왜 그렇게 부정하고 싶어 하는 건데」"},
{"id": "clse07:128400", "ko": "「그럼 질문을 바꿔 볼까」"},
{"id": "clse07:128500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:128600", "ko": "「앙?」"},
{"id": "clse07:128700", "ko": "「어? 아, 야……!」"},
{"id": "clse07:128800", "ko": "「어휴. 손이 많이 가는구먼」"},
{"id": "clse07:128900", "ko": "「아~ 끝났다 끝났다. 야, 점심――」"},
{"id": "clse07:129000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:129100", "ko": "「그 모양을 보니 또 없었던 모양이네」"},
{"id": "clse07:129200", "ko": "「그나저나 왠지 아리무라답지 않단 말이지~. 이럴 때는 부딪혀서 깨지자는 식으로 돌진할 것 같은 타입인데」"},
{"id": "clse07:129300", "ko": "「흐~응」"},
{"id": "clse07:129400", "ko": "「아니~ 너도 제대로 볼 데는 보는구나 싶어서」"},
{"id": "clse07:129500", "ko": "「역시 수업 끝나자마자 집에 간 거 아니야?」"},
{"id": "clse07:129600", "ko": "「이렇게 되니까 너, 좀 스토커 같다, 미야시로」"},
{"id": "clse07:129700", "ko": "「확실히 그렇지. 그렇게 언제까지나 안 만날 수도 없을 텐데」"},
{"id": "clse07:129800", "ko": "「야, 미야시로. 너 아리무라가 갈 만한 곳 같은 거 짐작 가는 데 없냐?」"},
{"id": "clse07:129900", "ko": "「역시 내일 학교에 오길 기다리는 수밖에 없나」"},
{"id": "clse07:130000", "ko": "「아, 뭐야? 이벤트 공략법이라도 알아냈냐?」"},
{"id": "clse07:130100", "ko": "「네 지인이라는 건 대체 어떤 녀석인데?」"},
{"id": "clse07:130200", "ko": "「여어~」"},
{"id": "clse07:130300", "ko": "「어이어이, 엄청 시끌벅적하다 싶었더니 무슨 소동이야?」"},
{"id": "clse07:130400", "ko": "「뭐야, 너희. 싸움이냐?」"},
{"id": "clse07:130500", "ko": "「아니, 그렇게 말해도 복도까지 들린다고……」"},
{"id": "clse07:130600", "ko": "「어이, 미야시로」"},
{"id": "clse07:130700", "ko": "「아리무라도 말이야…… 뭔지는 모르겠지만, 그 정도로……」"},
{"id": "clse07:130800", "ko": "「미, 미야시로!! 너, 그건 아무리 그래도 안 되지」"},
{"id": "clse07:130900", "ko": "「아리무라도 진정해. 응?」"},
{"id": "clse07:131000", "ko": "「하아아아아아아아아?」"},
{"id": "clse07:131100", "ko": "「뭐, 뭐야 그게에에!?」"},
{"id": "clse07:131200", "ko": "「뭐!?」"},
{"id": "clse07:131300", "ko": "「너희, 개그 콤비냐……」"},
{"id": "clse07:131400", "ko": "「아니~ 여기는 잘라 내기엔 아깝잖아」"},
{"id": "clse07:131500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:131600", "ko": "「왜 자연스럽게 디스당하는 거야 나!?」"},
{"id": "clse07:131700", "ko": "「오오, 미야시로, 늦었네. 네가 안 와서 벌써 찍고 와 버렸다」"},
{"id": "clse07:131800", "ko": "「그래. 부실에 한 번 모이는 시간도 아까우니까 카메라는 미리 가방에 넣어 두라고」"},
{"id": "clse07:131900", "ko": "「사실은 일요일에 교복 같은 거 입고 싶지 않았지만. 학생회장님께서 강경하게 주장하셔서」"},
{"id": "clse07:132000", "ko": "「힉! 당치도 않습니다!」"},
{"id": "clse07:132100", "ko": "「…………」"},
{"id": "clse07:132200", "ko": "「아하하하하!」"},
{"id": "clse07:132300", "ko": "「이, 히~힛힛! 미야시로답다!」"},
{"id": "clse07:132400", "ko": "「그야 잊고 싶어지기도 하겠지!」"},
{"id": "clse07:132500", "ko": "「그때의 너는 빛나고 있었는데 말이야」"},
{"id": "clse07:132600", "ko": "「아리무라, 알려 줘」"},
{"id": "clse07:132700", "ko": "「오리지널 노래는 꽤 빠져들었다고」"},
{"id": "clse07:132800", "ko": "「그러니까 잊은 채로 있는 게 너를 위한 거라니까」"},
{"id": "clse07:132900", "ko": "「그치만 말이야, 그때의 너 진짜 웃겨서, 힛힛힛!」"},
{"id": "clse07:133000", "ko": "「미안 미안. 모처럼의 휴일이니까 좀 재밋거리가 필요했던 거야」"},
{"id": "clse07:133100", "ko": "「적당히 과자랑 음료수를 사서 미야시로 차 안에서 연회를 했지」"},
{"id": "clse07:133200", "ko": "「그래서 말이야, 미야시로는 엔진 전개로 종횡무진 대활약이었는데」"},
{"id": "clse07:133300", "ko": "「좀 지나니까 침대에 쓰러져서 잠들어 버렸어. 그대로 해산 분위기가 됐지」"},
{"id": "clse07:133400", "ko": "「신경 쓰지 마」"},
{"id": "clse07:133500", "ko": "「바보냐」"},
{"id": "clse07:133600", "ko": "「미야시로 PC 빌려서 게임하고 있었어. 우리 집에선 부모님이 시끄러우니까」"},
{"id": "clse07:133700", "ko": "「그렇다곤 해도 나도 금방 자 버렸어. 아침에 눈을 떴더니 미야시로가 일단 숨은 쉬고 있길래 집에 갔지」"},
{"id": "clse07:133800", "ko": "「그 뒤라니, 딱히 아무것도 없어」"},
{"id": "clse07:133900", "ko": "「다른 신문부원은 없으니까. 카즈키는 뒤풀이가 끝나기 전에 가 버렸고」"},
{"id": "clse07:134000", "ko": "「여기야. 네 캠핑카」"},
{"id": "clse07:134100", "ko": "「카즈키는 체력이 없어 보이니까, 걷는 도중에 지쳐 버리는 것보다는 낫다고 생각해서」"},
{"id": "clse07:134200", "ko": "「아니, 몰라. 우리가 차로 돌아왔더니 엇갈려서 밖으로 나가서, 그대로」"},
{"id": "clse07:134300", "ko": "「카즈키라면 미야시로가 돌아오기 조금 전에 나갔어」"},
{"id": "clse07:134400", "ko": "「그래~? 평소의 말 없고 무표정한 얼굴이었는데?」"},
{"id": "clse07:134500", "ko": "「대놓고 목소리가 들떠 있잖아. 무슨 일 있냐?」"},
{"id": "clse07:134600", "ko": "「아니~ 너 같은 타입은 언젠가 어디선가 이렇게 될 거라고 생각했지」"},
{"id": "clse07:134700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:134800", "ko": "「뭐, 한 달에 한 번쯤은 면회 가 줄 테니까 걱정 마」"},
{"id": "clse07:134900", "ko": "「으음」"},
{"id": "clse07:135000", "ko": "「그래도 말이야, 평소의 미야시로였다면 그런 메일은 수상하다고 무시하지 않겠어?」"},
{"id": "clse07:135100", "ko": "「응? 뭐야?」"},
{"id": "clse07:135200", "ko": "「아리무라, 방금 웃었냐?」"},
{"id": "clse07:135300", "ko": "「혹시…… 카즈키?」"},
{"id": "clse07:135400", "ko": "「아리무라가 그렇게 말한다면 그런 거겠지」"},
{"id": "clse07:135500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:135600", "ko": "「인격~?」"},
{"id": "clse07:135700", "ko": "「뭔가 순수한 건지 비뚤어진 건지 모르겠네」"},
{"id": "clse07:135800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:135900", "ko": "「아~ 알았다」"},
{"id": "clse07:136000", "ko": "「미야시로한테는 가장 인연이 먼 말이니까 뇌가 받아들이지 않는 거구나」"},
{"id": "clse07:136100", "ko": "「미야시로, 미안했다」"},
{"id": "clse07:136200", "ko": "「너한테 아직 그런 자존심이 남아 있었다는 걸 알아주지 못해서」"},
{"id": "clse07:136300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:136400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:136500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:136600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:136700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:136800", "ko": "「네」"},
{"id": "clse07:136900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:137000", "ko": "「네」"},
{"id": "clse07:137100", "ko": "「어디 이상한 데라도 있었냐?」"},
{"id": "clse07:137200", "ko": "「나, 나, 나 같은 건, 가, 감동해 버렸어……!」"},
{"id": "clse07:137300", "ko": "「솔직히 미야시로는 언젠가 이런 짓을 할 것 같았어. 나는」"},
{"id": "clse07:137400", "ko": "「그래도 역시 너는 최악이야, 미야시로」"},
{"id": "clse07:137500", "ko": "「최악!」"},
{"id": "clse07:137600", "ko": "「어, 그래? 나는 전혀 몰랐는데」"},
{"id": "clse07:137700", "ko": "「네」"}
]
