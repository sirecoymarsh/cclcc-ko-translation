[
{"id": "clse01:25900", "ko": "「흐흥, 처음부터 얌전히 그렇게 하면 됐잖아」"},
{"id": "clse01:26000", "ko": "그리고 코웃음을 친 유이는――"},
{"id": "clse01:26100", "ko": "다음 순간, 평소의 그녀에게선 상상도 할 수 없는 무시무시한 행동에 나섰다."},
{"id": "clse01:26200", "ko": "「타쿠루 오빠, 엎드려 비는 자세가 영 아닌데? 좀 더 이렇게 머리를 바닥에 문지르는 거야. 이렇게, 꾹꾹꾹 하고」"},
{"id": "clse01:26300", "ko": "「아야야야야! 그, 그만해! 누구한테 이런 걸 배운 거야!」"},
{"id": "clse01:26400", "ko": "「노노 언니한테 배웠지 누구겠어?」"},
{"id": "clse01:26500", "ko": "「뭐어어어!?」"},
{"id": "clse01:26600", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:26700", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:26800", "ko": "「자아? 좀 더 제대로 부탁해 봐! 노노 언니 불러 버린다?」"},
{"id": "clse01:26900", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:27000", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:27100", "ko": "「후후후, 어쩔 수 없네. 하긴 타쿠루 오빠는 내가 도와주지 않으면 아무것도 못 하는 한심한 인간이니까~」"},
{"id": "clse01:27200", "ko": "「그렇지? 응? 꾹꾹꾹……」"},
{"id": "clse01:27300", "ko": "「아야야야야야! 찌부러진다 찌부러져! 야! 좀 봐주면서 해, 유이!」"},
{"id": "clse01:27400", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:27500", "ko": "「으그그. 죄, 죄송합니다, 유이⟦rb⟧님⟦rt⟧⟦rbc⟧●⟦/r⟧」"},
{"id": "clse01:27600", "ko": "나는 눈을 치켜뜨고 유이를 노려보며 말했다."},
{"id": "clse01:27700", "ko": "하지만 거기서 흠칫 굳어 버렸다."},
{"id": "clse01:27800", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:27900", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:28000", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:28100", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:28200", "ko": "「잠깐, 야!? 뭘 보는 건데!?」"},
{"id": "clse01:28300", "ko": "「어? 딱히 아무것도」"},
{"id": "clse01:28400", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:28500", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:28600", "ko": "「뭐라고~?」"},
{"id": "clse01:28700", "ko": "「아야야야야야!」"},
{"id": "clse01:28800", "ko": "머리를 더 세게 빠득빠득 짓밟혔다."},
{"id": "clse01:28900", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:29000", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:29100", "ko": "「저기, 노노 언니~!? 여기 수상한 사람이 숨어 있어~!?」"},
{"id": "clse01:29200", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:29300", "ko": "「무~. 영 진심이 안 느껴지는데!」"},
{"id": "clse01:29400", "ko": "아니, 진심이고 뭐고!"},
{"id": "clse01:29500", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:29600", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:29700", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:29800", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:29900", "ko": "――하고 하마터면 말이 헛나올 뻔했지만, 더 이상 기분을 상하게 했다간 정말로 쿠루스를 불러 버릴 것 같아서 아슬아슬하게 자제했다."},
{"id": "clse01:30000", "ko": "「흥, 뭐, 됐어. 아무튼 지금 타쿠루 오빠는 내 노예라는 걸로 된 거지?」"},
{"id": "clse01:30100", "ko": "「뭐? 노예라니, 아무리 그래도 너……」"},
{"id": "clse01:30200", "ko": "그렇게 태클을 걸려던 순간, 더욱 생각지도 못한 말이 머리 위에서 날아들었다."},
{"id": "clse01:30300", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:30400", "ko": "「……뭐라고?」"},
{"id": "clse01:30500", "ko": "……개?"},
{"id": "clse01:30600", "ko": "그러니까, DOG?"},
{"id": "clse01:30700", "ko": "대체 무슨 소리를 하는 거야, 이 녀석은."},
{"id": "clse01:30800", "ko": "영문을 몰라 내가 눈을 희번덕거리는 사이, 유이는 벽장을 드르륵 열더니――."},
{"id": "clse01:30900", "ko": "느닷없이 터무니없는 걸 끄집어냈다."},
{"id": "clse01:31000", "ko": "「나 말이야, 계속 개를 키우고 싶었어. 근데 아오바 기숙사는 애완동물 금지잖아?」"},
{"id": "clse01:31100", "ko": "「그래도 언젠가 몰래 키워 버리려고 준비해 뒀거든. 우후후」"},
{"id": "clse01:31200", "ko": "「너, 너, 그거……!」"},
{"id": "clse01:31300", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:31400", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:31500", "ko": "이 녀석, 설마?"},
{"id": "clse01:31600", "ko": "진심…… 인 건가……!?"},
{"id": "clse01:31700", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:31800", "ko": "「자, 자, 잠깐만 기다려 줘, 유이!?」"},
{"id": "clse01:31900", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:32000", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:32100", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:32200", "ko": "……이, 이 녀석, 장난으로 하는 게 아니다. 진심이다."},
{"id": "clse01:32300", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:32400", "ko": "「크억……」"},
{"id": "clse01:32500", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:32600", "ko": "「……준비……?」"},
{"id": "clse01:32700", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse01:32800", "ko": "「무슨 소리야, 너는~~!」"},
{"id": "clse01:32900", "ko": "그런 건 절대로 무리다~~!"},
{"id": "clse01:33000", "ko": "그런 짓을 했다간 단번에 경찰 신세를 지게 된다."},
{"id": "clse01:33100", "ko": "아무리 충격적인 뉴스를 찾고 있는 우리 신문부라지만, 그렇게 되면 나 자신이 톱뉴스가 될 수도 있다!"},
{"id": "clse01:33200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse01:33300", "ko": "「그・만・해~~!」"},
{"id": "clse01:33400", "ko": "나는 마침내 참다못해 유이에게 달려들었다."},
{"id": "clse01:33500", "ko": "다음 순간, 쾅 하는 엄청난 소리가 귓가에서 울렸다."},
{"id": "clse01:33600", "ko": "이어서 격렬한 통증이 내 온몸을 덮친다."},
{"id": "clse01:33700", "ko": "「우왓!? 잠깐 타쿠!? 뭐 하는 거야!?」"},
{"id": "clse01:33800", "ko": "세리카의 깜짝 놀란 목소리가 머리 위에서 들렸다."},
{"id": "clse01:33900", "ko": "정신을 차려 보니 나는 내 트레일러 하우스 입구로 힘껏 다이브했고, 부딪힌 반동으로 땅바닥에 나자빠져 있었다."},
{"id": "clse01:34000", "ko": "「…………」"},
{"id": "clse01:34100", "ko": "「뭐…… 하는 거야?」"},
{"id": "clse01:34200", "ko": "「그게…… 뭘 했어? 내가?」"},
{"id": "clse01:34300", "ko": "「갑자기 영문 모를 소리를 외치면서 트레일러 하우스 쪽으로 달려갔어」"},
{"id": "clse01:34400", "ko": "「그, 그래……」"},
{"id": "clse01:34500", "ko": "「그러고 나서 전력으로 절규하면서 다이브해서 문에 쾅 하고 부딪혔고」"},
{"id": "clse01:34600", "ko": "「그, 그래……」"}
]
