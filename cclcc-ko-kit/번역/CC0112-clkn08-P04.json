[
{"id": "clkn08:30000", "ko": "「타쿠루도 언젠가 그렇게 아기를 안는 날이 오려나」"},
{"id": "clkn08:30100", "ko": "내가 아빠가 되는 날?"},
{"id": "clkn08:30200", "ko": "전혀 상상이 안 가지만."},
{"id": "clkn08:30300", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn08:30400", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn08:30500", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn08:30600", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn08:30700", "ko": "「흠흠!」"},
{"id": "clkn08:30800", "ko": "「우왓!」"},
{"id": "clkn08:30900", "ko": "위험해!"},
{"id": "clkn08:31000", "ko": "갑자기 유이가 말을 거는 바람에 하마터면 아기를 떨어뜨릴 뻔했다."},
{"id": "clkn08:31100", "ko": "「이불 다 깔았는데요~」"},
{"id": "clkn08:31200", "ko": "「아, 응. 고마워!」"},
{"id": "clkn08:31300", "ko": "「? 센리 누나네, 무슨 얘기 하고 있었어?」"},
{"id": "clkn08:31400", "ko": "「아, 아무것도 아니야, 아무것도!」"},
{"id": "clkn08:31500", "ko": "때를 맞춘 듯이 아기가 울기 시작했다."},
{"id": "clkn08:31600", "ko": "「그, 그렇지! 맘마 먹고 싶었구나! 미안해, 지금 준비해 주께여~」"},
{"id": "clkn08:31700", "ko": "「지, 지쳤다~」"},
{"id": "clkn08:31800", "ko": "아기 돌보는 게 이렇게 지치는 일인 줄은 몰랐다."},
{"id": "clkn08:31900", "ko": "「자, 타쿠루…… 수고했어」"},
{"id": "clkn08:32000", "ko": "센리가 컵에 따른 ⟦col:280aa02d1400⟧마운틴 뷰⟦col:800000⟧를 내 앞에 놓아 주었다."},
{"id": "clkn08:32100", "ko": "평소에는 그런 것만 마신다고 화를 내면서, 오늘만큼은 조금 위로해 주려는 모양이다."},
{"id": "clkn08:32200", "ko": "유이네는 녹초가 돼서 벌써 잠들어 버렸다."},
{"id": "clkn08:32300", "ko": "그런데도 막 우린 따뜻한 차를 홀짝이는 센리는 꽤 멀쩡해 보인다."},
{"id": "clkn08:32400", "ko": "대단하다."},
{"id": "clkn08:32500", "ko": "「고마워. 타쿠루가 있어 줘서 살았어」"},
{"id": "clkn08:32600", "ko": "「아무리 나라도 그 상황에서 가 버릴 수는 없잖아」"},
{"id": "clkn08:32700", "ko": "「응. 그렇구나. 타쿠루는 착하니까」"},
{"id": "clkn08:32800", "ko": "아기는 센리 방에 이불을 깔고 재우기로 했다."},
{"id": "clkn08:32900", "ko": "아직 기어 다니지도 못한다지만, 침대라면 만에 하나라는 것도 있을 수 있다."},
{"id": "clkn08:33000", "ko": "「저기, 타쿠루…… 그 아이 엄마, 어떻게든 찾을 수 없을까?」"},
{"id": "clkn08:33100", "ko": "지금으로선 이름 말고는 아무 단서도 없고, 무작정 찾아다녀 봤자 찾을 수 있을 것 같지 않다."},
{"id": "clkn08:33200", "ko": "그렇긴 해도……"},
{"id": "clkn08:33300", "ko": "「……일단 신조 씨한테라도 상담해 볼게……」"},
{"id": "clkn08:33400", "ko": "「…………」"},
{"id": "clkn08:33500", "ko": "응?"},
{"id": "clkn08:33600", "ko": "대답이 없다……"},
{"id": "clkn08:33700", "ko": "「센리?」"},
{"id": "clkn08:33800", "ko": "「새근…… 새근……」"},
{"id": "clkn08:33900", "ko": "아무래도 멀쩡해 보였던 건 내 착각이었던 모양이다."},
{"id": "clkn08:34000", "ko": "센리는 내 어깨에 머리를 기댄 채 작은 숨소리를 내며 자고 있었다."},
{"id": "clkn08:34100", "ko": "「어쩔 수 없지……」"},
{"id": "clkn08:34200", "ko": "조금만 더 이대로 둬 줄까."},
{"id": "clkn08:34300", "ko": "「잘 자, 센리……」"}
]
