[
{"id": "clah13:0", "ko": "「선배……」"},
{"id": "clah13:100", "ko": "「응……」"},
{"id": "clah13:200", "ko": "「서언배…… 일어나, 선배……」"},
{"id": "clah13:300", "ko": "「으음……」"},
{"id": "clah13:400", "ko": "「정말, 어쩔 수 없다니까……」"},
{"id": "clah13:500", "ko": "「…………」"},
{"id": "clah13:600", "ko": "「응?」"},
{"id": "clah13:700", "ko": "「아, 겨우 일어났다」"},
{"id": "clah13:800", "ko": "「아…… 미안. 그만 꾸벅꾸벅 졸아서……」"},
{"id": "clah13:900", "ko": "「후후…… 뭐, 괜찮아요. 자는 얼굴도 귀여웠으니까」"},
{"id": "clah13:1000", "ko": "그 뒤로 나와 히나에는 사귀기 시작했다."},
{"id": "clah13:1100", "ko": "그 일이 있은 뒤 엄마와의 갈등도 일단은 풀려서, 이제 드디어 히나에도 집에 돌아가겠지―― 라고 생각했는데……"},
{"id": "clah13:1200", "ko": "「그보다, 괜찮은 걸까. 정말……」"},
{"id": "clah13:1300", "ko": "「뭐가요?」"},
{"id": "clah13:1400", "ko": "「이대로 같이 생활해도…… 어머님도 화나신 거 아냐?」"},
{"id": "clah13:1500", "ko": "그렇다."},
{"id": "clah13:1600", "ko": "히나에는 결국 집에 돌아가지 않고 내 이 집에 계속 얹혀살고 있었다."},
{"id": "clah13:1700", "ko": "「괜찮아요. 어차피 아빠나 엄마도 제멋대로 하고 있으니까」"},
{"id": "clah13:1800", "ko": "「그래도 그렇다고……」"},
{"id": "clah13:1900", "ko": "「그럼 선배는 제가 돌아가 버려도 괜찮아요?」"},
{"id": "clah13:2000", "ko": "「내일부터 다시 청소도 빨래도 밥도, 저어언부 혼자 하게 될 텐데요?」"},
{"id": "clah13:2100", "ko": "「으……」"},
{"id": "clah13:2200", "ko": "「게다가……」"},
{"id": "clah13:2300", "ko": "히나에는 내 귓가에 얼굴을 가까이 대고 속삭였다."},
{"id": "clah13:2400", "ko": "「이렇게 같이 지내지도 못하게 될 텐데요〜?」"},
{"id": "clah13:2500", "ko": "「……그건…… 싫어」"},
{"id": "clah13:2600", "ko": "「후훗, 솔직해서 착하네요」"},
{"id": "clah13:2700", "ko": "히나에의 귀여운 입술이 내 귀에 닿았다."},
{"id": "clah13:2800", "ko": "히나에와 잘 사귀는 비결은 거짓말을 하지 않는 것이다."},
{"id": "clah13:2900", "ko": "어차피 거짓말을 해 봤자 들키니까, 꾸며 봤자 헛수고라는 거다."},
{"id": "clah13:3000", "ko": "반대로 말하면 그것만 지키면 히나에는 나한테 화낼 일도 없다."},
{"id": "clah13:3100", "ko": "화낼 일이 없으면 서로 반발할 일도 없다."},
{"id": "clah13:3200", "ko": "「게다가 있잖아. 사실은 엄마도 허락해 줬어」"},
{"id": "clah13:3300", "ko": "「허락이라니…… 여기서 사는 걸?」"},
{"id": "clah13:3400", "ko": "「물론, 장래에 제대로 책임져 준다면, 이지만」"},
{"id": "clah13:3500", "ko": "책임……"},
{"id": "clah13:3600", "ko": "혹시…… 나를 시험하는 걸까?"},
{"id": "clah13:3700", "ko": "「나는――」"},
{"id": "clah13:3800", "ko": "「……라는 건 농담이에요, 농담」"},
{"id": "clah13:3900", "ko": "「어?」"},
{"id": "clah13:4000", "ko": "「저, 딱히 그런 걸로 묶어 두거나 하지 않을 거니까요」"},
{"id": "clah13:4100", "ko": "「히나에……」"},
{"id": "clah13:4200", "ko": "혹시 그때처럼 또 무서워진 걸까."},
{"id": "clah13:4300", "ko": "내 말을 듣는 게."},
{"id": "clah13:4400", "ko": "하지만 분명 괜찮다."},
{"id": "clah13:4500", "ko": "나는 이제 히나에를 불안하게 하지 않을 거다."},
{"id": "clah13:4600", "ko": "왜냐하면 그때 결심했으니까."},
{"id": "clah13:4700", "ko": "그래서 나는 히나에의 눈을 똑바로 바라보며 말했다."},
{"id": "clah13:4800", "ko": "「졸업하면 말이야. 제대로 인사드리러 갈게」"},
{"id": "clah13:4900", "ko": "「에?」"},
{"id": "clah13:5000", "ko": "「어머님이랑 아버님. 그리고 형님께도……」"},
{"id": "clah13:5100", "ko": "「선배……」"},
{"id": "clah13:5200", "ko": "물론 그다음은 아직 먼 미래의 이야기지만."},
{"id": "clah13:5300", "ko": "그래도."},
{"id": "clah13:5400", "ko": "「있잖아, 선배?」"},
{"id": "clah13:5500", "ko": "「응?」"},
{"id": "clah13:5600", "ko": "「나 좋아해?」"},
{"id": "clah13:5700", "ko": "「알면서……」"},
{"id": "clah13:5800", "ko": "「그런 걸로는 안 돼. 제대로 말해 주지 않으면 싫어」"},
{"id": "clah13:5900", "ko": "「좋아해……」"},
{"id": "clah13:6000", "ko": "「응…… 나도 정말 좋아……」"},
{"id": "clah13:6100", "ko": "나는 결심했으니까."},
{"id": "clah13:6200", "ko": "앞으로도 히나에와 함께 걸어가겠다고."},
{"id": "clah13:6300", "ko": "「에잇!」"},
{"id": "clah13:6400", "ko": "「어?」"},
{"id": "clah13:6500", "ko": "「후훗……」"},
{"id": "clah13:6600", "ko": "「아, 잠, 잠깐만!」"},
{"id": "clah13:6700", "ko": "「안〜돼! 역시 저를 이렇게까지 좋아하게 만든 책임, 져 주셔야겠어요」"},
{"id": "clah13:6800", "ko": "「아앗!!」"},
{"id": "clah13:6900", "ko": "「후후후후, 평생 안 놓아줄 거예요〜」"}
]
