[
{"id": "clyu01:0", "ko": "「자, 그럼. 다음 신문 특집을 어떻게 할 것인가, 말인데……」"},
{"id": "clyu01:100", "ko": "카와하라와의 사나이 대 사나이의 승부가 없던 일이 된 건 좋았지만, 그러고 나니 앞으로의 활동 방침을 정해야 했다."},
{"id": "clyu01:200", "ko": "그렇다고는 해도, 말을 꺼낸 건 좋았지만 나도 이렇다 할 아이디어는 없어서, 결국 다시 다들 의견을 듣고 있는 참이다."},
{"id": "clyu01:300", "ko": "「미인 대회는 어때?」"},
{"id": "clyu01:400", "ko": "「……미인 대회라니, 그 미인 대회?」"},
{"id": "clyu01:500", "ko": "「그거 말고 무슨 미인 대회가 있냐?」"},
{"id": "clyu01:600", "ko": "이토가 왠지 가슴을 펴고 말했다."},
{"id": "clyu01:700", "ko": "「봐, 저번 YES-NO 판정이 꽤 평이 좋았잖아? 역시 말야, 민중은 그런 분위기를 원하는 거라고 생각해」"},
{"id": "clyu01:800", "ko": "이토 말대로, 몹시 마음에 들지 않지만, 그 대충 얼버무린 듯한 바보 같은 기획은 지금까지의 기사에 비해서도 어째선지 반응이 좋았다."},
{"id": "clyu01:900", "ko": "「그러니까 말야. 교내에서 미인이라고 생각하는 사람한테 투표하게 해서――」"},
{"id": "clyu01:1000", "ko": "하지만 그렇다고 해서 그런 기획은 분명……"},
{"id": "clyu01:1100", "ko": "「기각입니다」"},
{"id": "clyu01:1200", "ko": "이렇게 될 게 뻔하다."},
{"id": "clyu01:1300", "ko": "「에이, 왜?」"},
{"id": "clyu01:1400", "ko": "「알아요, 이토 선배? 그런 거, 요즘엔 ⟦col:280aa02d1400⟧성희롱⟦col:800000⟧에 해당하는 거임다」"},
{"id": "clyu01:1500", "ko": "「나왔다! 우승 못 하는 녀석의 시샘. 그렇게 속이 좁으니까 안 뽑히는――」⟦avs⟧⟦n⟧⟦n⟧"},
{"id": "clyu01:1600", "ko": "「…………」"},
{"id": "clyu01:1700", "ko": "「우와아아아아아! 농담이야, 농담! 보고만 있지 말고 말려 줘, 미야시로오~!」"},
{"id": "clyu01:1800", "ko": "「자업자득이잖아」"},
{"id": "clyu01:1900", "ko": "「너무해~」"},
{"id": "clyu01:2000", "ko": "「자~, 어떻게 해 드릴까요, 오호호호호」"},
{"id": "clyu01:2100", "ko": "「히이익!」"},
{"id": "clyu01:2200", "ko": "「자자, 히나도 그쯤 해 둬~」"},
{"id": "clyu01:2300", "ko": "「……쳇, 어쩔 수 없지. 세리가 그렇게 말한다면……」"},
{"id": "clyu01:2400", "ko": "아리무라가 두 손을 내리자, 그때까지 보이던 거대한 ⟦col:280aa02d1400⟧디소드⟦col:800000⟧가 순식간에 사라졌다."},
{"id": "clyu01:2500", "ko": "「휴……」"},
{"id": "clyu01:2600", "ko": "「그 대신, 하나한테 저주의 말이라도 퍼부어 달라고 할까요」"},
{"id": "clyu01:2700", "ko": "「응, 알았어…… 일지도」"},
{"id": "clyu01:2800", "ko": "「아니아니! 그건 농담으로 안 끝난다고!!」"},
{"id": "clyu01:2900", "ko": "아이고, 여전히 시끄럽기 짝이 없다."},
{"id": "clyu01:3000", "ko": "대체 어째서 이 부에는 이런 녀석들만 모인 걸까."},
{"id": "clyu01:3100", "ko": "이 중에서 유일하게 멀쩡한 사람이라고 하면……"},
{"id": "clyu01:3200", "ko": "「자, 여기요. ⟦col:280aa02d1400⟧마운틴 뷰⟦col:800000⟧예요」"},
{"id": "clyu01:3300", "ko": "「아, 어. 땡큐」"},
{"id": "clyu01:3400", "ko": "「오노에 씨는 자몽 주스면 됐죠?」"},
{"id": "clyu01:3500", "ko": "「오케이. 고마워, 우키」"},
{"id": "clyu01:3600", "ko": "「아리무라 씨의 애플티와 언니의 ⟦col:280aa02d1400⟧다즐링⟦col:800000⟧은 지금 탈게요」"},
{"id": "clyu01:3700", "ko": "「웅~. 그라치에」"},
{"id": "clyu01:3800", "ko": "「늘 미안해, 우키」"},
{"id": "clyu01:3900", "ko": "「아뇨. 좋아서 하는 일이니까요」"},
{"id": "clyu01:4000", "ko": "표정 하나 바꾸지 않고 그렇게 말하더니, 우키는 다시 담담하게 홍차를 타기 시작했다."},
{"id": "clyu01:4100", "ko": "늘 시끌벅적한 이 신문부 안에서 유일한 위안이라면 우키 정도다."},
{"id": "clyu01:4200", "ko": "하긴 우키는 고등부 학생이 아니니까 정확히는 부원이 아니지만, 그걸 따지자면 완전히 부원이 아닌 녀석도 있으니 문제없겠지."},
{"id": "clyu01:4300", "ko": "「있잖아, 우키는 지금 뭔가 관심 있는 거 없어?」"},
{"id": "clyu01:4400", "ko": "「저, 말인가요?」"},
{"id": "clyu01:4500", "ko": "「응. 이런 기사가 읽고 싶다든가, 이런 특집이 있으면 재밌겠다든가」"},
{"id": "clyu01:4600", "ko": "「저는…… 딱히……」"},
{"id": "clyu01:4700", "ko": "「그보다~, 우키는 취미 같은 거 있어?」"},
{"id": "clyu01:4800", "ko": "「취미, 말인가요? 글쎄요…… 일 거들기라든가」"},
{"id": "clyu01:4900", "ko": "「그런 건 취미라고 안 한다니까」"},
{"id": "clyu01:5000", "ko": "「그래도 말야. 실제로 야마조에가 있으면 편하잖아」"},
{"id": "clyu01:5100", "ko": "「어……」"},
{"id": "clyu01:5200", "ko": "「봐. 차도 이렇게 전원 취향을 파악해서 타 주고, 부실 정리도 청소도 저~언부 해 주고」"},
{"id": "clyu01:5300", "ko": "「…………」⟦n⟧⟦par⟧「…………」⟦n⟧⟦par⟧「…………」"},
{"id": "clyu01:5400", "ko": "「우리 집에도 야마조에가 한 명 있으면 편하고 좋을 텐데」"},
{"id": "clyu01:5500", "ko": "「…………」⟦n⟧⟦par⟧「…………」⟦n⟧⟦par⟧「…………」"},
{"id": "clyu01:5600", "ko": "아~아."},
{"id": "clyu01:5700", "ko": "이 바보, 눈치 못 챘군."},
{"id": "clyu01:5800", "ko": "「야, 이토……」"},
{"id": "clyu01:5900", "ko": "「맞다, 야마조에. 다음에 우리 집 와서 방 좀 치워 주지 않을래?」"},
{"id": "clyu01:6000", "ko": "「이토」"},
{"id": "clyu01:6100", "ko": "「아? 왜?」"},
{"id": "clyu01:6200", "ko": "「…………!」⟦n⟧⟦par⟧「…………!」⟦n⟧⟦par⟧「…………!」"},
{"id": "clyu01:6300", "ko": "「어, 어라? 나 뭐 이상한 말 했어?」"},
{"id": "clyu01:6400", "ko": "「했어? 가 아니잖아, 신지」"},
{"id": "clyu01:6500", "ko": "「같은 말이라도 하는 방식이 있잖아」"},
{"id": "clyu01:6600", "ko": "「맞아 맞아~. “편하다”니 실례잖아~」"},
{"id": "clyu01:6700", "ko": "「최악…… 일지도……」"},
{"id": "clyu01:6800", "ko": "「아, 아니라니까, 딱히 난 악의가 있어서 한 말은……」"},
{"id": "clyu01:6900", "ko": "뭐, 악의가 없다는 건 사실이겠지."},
{"id": "clyu01:7000", "ko": "그냥 바보일 뿐이고."},
{"id": "clyu01:7100", "ko": "게다가……"},
{"id": "clyu01:7200", "ko": "「…………」"},
{"id": "clyu01:7300", "ko": "「그보다 왜 쑥스러워하는 건데, 우키~」"},
{"id": "clyu01:7400", "ko": "「아뇨…… 뭐랄까 그게…… 그런 말, 별로 들어 본 적이 없어서……」"},
{"id": "clyu01:7500", "ko": "「거 봐. 야마조에도 기분 나빠하지 않잖아, 됐잖아~」"},
{"id": "clyu01:7600", "ko": "「이. 토. 군.」", "note": "한 글자씩 끊어 부르는 위협 — くん까지 소리 내어 끊으므로 「군」을 살림(평소 노노 → 이토는 「이토」)"},
{"id": "clyu01:7700", "ko": "「죄송합니다」"},
{"id": "clyu01:7800", "ko": "뭐, 바보 이토의 말투는 별개로 치고, 내가 보기엔 딱히 강요하는 것도 아니니 괜찮지 않나 싶은데."},
{"id": "clyu01:7900", "ko": "게다가 우키도 억지로 하는 건 아니고, 오히려 좋아서 하는 것 같기도 하다."},
{"id": "clyu01:8000", "ko": "실제로――"},
{"id": "clyu01:8100", "ko": "「아뇨. 신경 쓰지 마세요. 제가 좋아서 하는 일이라서요」"},
{"id": "clyu01:8200", "ko": "우키도 이렇게 말하고 있으니까."},
{"id": "clyu01:8300", "ko": "「뭐…… 우키가 그걸로 괜찮다면 됐지만」"},
{"id": "clyu01:8400", "ko": "「네. 저는 이렇게 여러분께 도움이 될 수 있어서 기뻐요」"},
{"id": "clyu01:8500", "ko": "「우키~! 너 진짜 착한 애구나~!」"},
{"id": "clyu01:8600", "ko": "「응……!」"},
{"id": "clyu01:8700", "ko": "「어라? 잠깐만! 그 말은, 나 괜히 혼만 난 거 아냐?!」"},
{"id": "clyu01:8800", "ko": "「그런 말 하면서. 사실은 나쁘지 않다고 생각하는 주제에~」"},
{"id": "clyu01:8900", "ko": "「아니 뭐, 그게……」"},
{"id": "clyu01:9000", "ko": "「신지, 그거 좀 변태 같아~?」"},
{"id": "clyu01:9100", "ko": "뭐, 본인이 좋을 대로 하는 게 제일이지."},
{"id": "clyu01:9200", "ko": "그래도 이 이야기 흐름이라면 아마 쿠루스 녀석……"},
{"id": "clyu01:9300", "ko": "「그럼 오늘은 이만 돌아가 볼까」"},
{"id": "clyu01:9400", "ko": "결국 앞으로의 부 활동은 딱히 정해진 것 없이, 어영부영 해산하게 되었다."},
{"id": "clyu01:9500", "ko": "학교 행사로도 앞으로 딱히 뭐가 있는 것도 아니고."},
{"id": "clyu01:9600", "ko": "이러쿵저러쿵하는 사이에 기말고사가 시작될 테고, 이 시기의 부 활동은 원래 이런 거라면 이런 거다."},
{"id": "clyu01:9700", "ko": "그건 그것대로 아쉽긴 하지만."},
{"id": "clyu01:9800", "ko": "「저기, 타쿠. 타쿠는 곧장 집에 가?」"},
{"id": "clyu01:9900", "ko": "「아니, 딱히 아무 생각 없는데」"}
]
