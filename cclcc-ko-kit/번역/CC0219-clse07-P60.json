[
{"id": "clse07:577300", "ko": "「아, 아니야! 난 아무한테도 말 안…… 했습니다……」"},
{"id": "clse07:577400", "ko": "「아니, 쿠루스! 이 건에 관해서는 나는――」"},
{"id": "clse07:577500", "ko": "「네」"},
{"id": "clse07:577600", "ko": "「아니, 딱히 난 신경 안 쓰는데……」"},
{"id": "clse07:577700", "ko": "「진짜라니까」"},
{"id": "clse07:577800", "ko": "「어?」"},
{"id": "clse07:577900", "ko": "「……쿠루스…… 진심으로 하는 소리야, 그거」"},
{"id": "clse07:578000", "ko": "「왜. 쿠루스는 쿠루스잖아」"},
{"id": "clse07:578100", "ko": "「애초에 나는 이제 아오바 기숙사에서 살지 않아. 그런데 학교에서 “노노”라고 부르면 이상하게 생각할 거 아냐」"},
{"id": "clse07:578200", "ko": "「그렇긴 한데, 개중에는 모르는 녀석도 있으니까……」"},
{"id": "clse07:578300", "ko": "「아니. 아무래도 그럴 수는 없지」"},
{"id": "clse07:578400", "ko": "「어? 집이라니, 아오바 기숙사에?」"},
{"id": "clse07:578500", "ko": "「……마, 말했잖아. 나는 혼자가 좋아서 그 기숙사를 나간 거야. 이제 와서 가족 놀이 같은 데로 돌아갈 수 있을 리가 없어」"},
{"id": "clse07:578600", "ko": "「아, 아니야! 내가 나간 건 아버지랑 싸워서고, 그런――」", "note": "새 용어: 拓留가 부르는 父さん(사쿠마) → 아버지"},
{"id": "clse07:578700", "ko": "「윽……」"},
{"id": "clse07:578800", "ko": "「…………」"},
{"id": "clse07:578900", "ko": "「……알았어」"},
{"id": "clse07:579000", "ko": "「그래. 하지만 계속은 아니야. 일단 오늘만이다」"},
{"id": "clse07:579100", "ko": "「잠깐. 그 전에 부실에서 가방 가져와야지」"},
{"id": "clse07:579200", "ko": "「…………」"},
{"id": "clse07:579300", "ko": "「아니……」"},
{"id": "clse07:579400", "ko": "「시, 실례합니다」"},
{"id": "clse07:579500", "ko": "「그게…… 다녀왔어……」"},
{"id": "clse07:579600", "ko": "「야, 야…… 뭐야, 갑자기」"},
{"id": "clse07:579700", "ko": "「나갔다고 해서 멀리 간 것도 아니야. 만나려고 하면 언제든 만날 수 있잖아」"},
{"id": "clse07:579800", "ko": "「유이……」"},
{"id": "clse07:579900", "ko": "「그러니까…… 무슨 소리야?」"},
{"id": "clse07:580000", "ko": "「유이……」"},
{"id": "clse07:580100", "ko": "「다녀왔어」"},
{"id": "clse07:580200", "ko": "「어라…… 그러고 보니 쿠루스는?」"},
{"id": "clse07:580300", "ko": "「아…… 아니……」"},
{"id": "clse07:580400", "ko": "「노, 노노는 어떻게 된 거야?」"},
{"id": "clse07:580500", "ko": "「응…… 아아, 그렇네. 그럼 그렇게 할게」"},
{"id": "clse07:580600", "ko": "「어라? 쿠루스…… 가 아니라, 노노는 아직 안 돌아왔어?」"},
{"id": "clse07:580700", "ko": "「볼일이 있는 건 아니지만……」"},
{"id": "clse07:580800", "ko": "「아……」"},
{"id": "clse07:580900", "ko": "「잠깐 갔다 올게」"},
{"id": "clse07:581000", "ko": "「나야. 있지?」"},
{"id": "clse07:581100", "ko": "「좀처럼 안 돌아와서 말이야. 무슨 일인가 해서」"},
{"id": "clse07:581200", "ko": "「들어가도 돼?」"},
{"id": "clse07:581300", "ko": "「연다」"},
{"id": "clse07:581400", "ko": "「이제 와서 뭘 신경 쓰는 거야?」"},
{"id": "clse07:581500", "ko": "「그러니까 그런 얼굴 하지 말라니까, 노노…… 가 아니라, 지금은 센리인가」"},
{"id": "clse07:581600", "ko": "「그렇게 꺼림칙하면, 차라리 그 모습으로 돌아가면 될 텐데」"},
{"id": "clse07:581700", "ko": "「왜?」"},
{"id": "clse07:581800", "ko": "「그런 건――」"},
{"id": "clse07:581900", "ko": "「아무튼, 집에 있을 때는 그 모습으로 돌아가기로 약속했잖아. 이제 와서 그렇게 방에 틀어박혀 봤자 아무 소용 없어」"},
{"id": "clse07:582000", "ko": "「아무튼, 난 신경 안 쓰니까」"},
{"id": "clse07:582100", "ko": "「잘 먹겠습니다」"},
{"id": "clse07:582200", "ko": "「……왜, 왜 그래, 유이?」"},
{"id": "clse07:582300", "ko": "「응, 맛있어」"},
{"id": "clse07:582400", "ko": "「이런 걸로 거짓말해 봤자 소용없잖아」"},
{"id": "clse07:582500", "ko": "「그래?」"},
{"id": "clse07:582600", "ko": "「헤에, 이걸 유이가……」"},
{"id": "clse07:582700", "ko": "「응, 정말 맛있어. 센리가 만든 거랑 별로 다르지 않아」"},
{"id": "clse07:582800", "ko": "「치킨은 필요 없다고 하지 않았어?」"},
{"id": "clse07:582900", "ko": "「아!! 그거, 제일 큰 거!」"},
{"id": "clse07:583000", "ko": "「으으, 젠장〜……!」"},
{"id": "clse07:583100", "ko": "「유이?」"},
{"id": "clse07:583200", "ko": "「매지컬…… 유이……」"},
{"id": "clse07:583300", "ko": "「노, 놀랄 게 뻔하잖아! 게다가 뭐야, 마법 아이돌이라니!」"},
{"id": "clse07:583400", "ko": "「뭐?」"},
{"id": "clse07:583500", "ko": "「무, 물론 알고 있었지! 나를 누구라고 생각하는 거야. 그런 정보 약자들이랑 같이 취급하지 말아 줘」"},
{"id": "clse07:583600", "ko": "「다, 당연히 난 알고 있었지만!」"},
{"id": "clse07:583700", "ko": "「유이……」"},
{"id": "clse07:583800", "ko": "「유……」"},
{"id": "clse07:583900", "ko": "「유이이이이이이이이이!!」"},
{"id": "clse07:584000", "ko": "「어?」"},
{"id": "clse07:584100", "ko": "「아……」"},
{"id": "clse07:584200", "ko": "「아, 아니…… 그…… 텔레비전은…… 나중에 보렴……」"},
{"id": "clse07:584300", "ko": "「디소드……!」"},
{"id": "clse07:584400", "ko": "「뭐……?」"},
{"id": "clse07:584500", "ko": "「기, 기다려, 유토! 그건――!」"},
{"id": "clse07:584600", "ko": "「유토! 너, 뭐 하는 거야!」"},
{"id": "clse07:584700", "ko": "「마술이라니…… 너, 방금 그 목소리……」"},
{"id": "clse07:584800", "ko": "「그만둬!!!」"},
{"id": "clse07:584900", "ko": "「아, 아버지야말로 뭘 태연하게 보고 있는 거야! 잘리고 있다고, 유이가!」"},
{"id": "clse07:585000", "ko": "「유…… 유이이이이이이이이이!!」"},
{"id": "clse07:585100", "ko": "「어?」"},
{"id": "clse07:585200", "ko": "「아……」"},
{"id": "clse07:585300", "ko": "「아, 아니…… 그…… 텔레비전은…… 나중에 보렴……」"},
{"id": "clse07:585400", "ko": "「으, 응…… 뭐……」"},
{"id": "clse07:585500", "ko": "「음……」"},
{"id": "clse07:585600", "ko": "「으음……」"},
{"id": "clse07:585700", "ko": "「…………어, 어라?」"},
{"id": "clse07:585800", "ko": "「후아아……」"},
{"id": "clse07:585900", "ko": "「응…… 아, 센리」"},
{"id": "clse07:586000", "ko": "「저기…… 아까, 내가 하고 싶은 말을 어떻게 안 거야?」"},
{"id": "clse07:586100", "ko": "「잘 먹었습니다」"},
{"id": "clse07:586200", "ko": "「충분해. 아침부터 과식했을 정도야」"},
{"id": "clse07:586300", "ko": "「왜 그래?」"},
{"id": "clse07:586400", "ko": "「그래」"},
{"id": "clse07:586500", "ko": "「아버지한테 갔어. 아무튼 나는 먼저 간다. 그럼」"},
{"id": "clse07:586600", "ko": "「무슨 일이야. 일부러 교실까지 오다니」"},
{"id": "clse07:586700", "ko": "「뭐야…… 아리무라도 같이냐……」"},
{"id": "clse07:586800", "ko": "「『야호〜. 히나에땅이 나를 만나러 와 줬어. 타쿠루 감격〜』」"},
{"id": "clse07:586900", "ko": "「왜 화를 내」"},
{"id": "clse07:587000", "ko": "「어떻게 알았어!? 설마 너, 능력을……」"},
{"id": "clse07:587100", "ko": "「어디가!」"},
{"id": "clse07:587200", "ko": "「윽……」"}
]
