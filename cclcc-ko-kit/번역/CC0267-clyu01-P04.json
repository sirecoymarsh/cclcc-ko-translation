[
{"id": "clyu01:30000", "ko": "노노는 작게 고개를 끄덕였다."},
{"id": "clyu01:30100", "ko": "확실히 우키는 남을 위해 애쓰는 게 삶의 보람인 듯한 구석이 있다."},
{"id": "clyu01:30200", "ko": "지금까지 유이가 하던 일도, 본인이 알아채기 전에 먼저 해 버린다고 한다."},
{"id": "clyu01:30300", "ko": "게다가 흠잡을 데 없는 완성도로……"},
{"id": "clyu01:30400", "ko": "그런 상황이니, 자연히 ⟦col:280aa02d1400⟧아오바 의원⟦col:800000⟧에 오는 환자분들한테도 평이 좋아진다.", "note": "새 용어: 青葉医院 → 아오바 의원"},
{"id": "clyu01:30500", "ko": "그렇게 되면――"},
{"id": "clyu01:30600", "ko": "「스스로도 그러면 안 된다는 걸 알면서도, 아무래도 비교하게 되나 봐……」"},
{"id": "clyu01:30700", "ko": "「그래서 요즘 이것저것 고민하게 됐고……」"},
{"id": "clyu01:30800", "ko": "그렇군."},
{"id": "clyu01:30900", "ko": "유이는 예전에, 어른이 되면 간호사가 돼서 아버지 일을 도울까…… 하고 말한 적도 있다."},
{"id": "clyu01:31000", "ko": "물론 그건 대화 중에 문득 나온 말이었고, 아버지를 기쁘게 하려던 것이기도 했겠지만……"},
{"id": "clyu01:31100", "ko": "그래도 그 나이대 여자애를 고민하게 만들기에는 충분한 상황일지도 모른다."},
{"id": "clyu01:31200", "ko": "「얘기는 알겠어. 그런데 왜 나야? 상담이라면 쿠루스가 들어 주면 되잖아?」"},
{"id": "clyu01:31300", "ko": "「……나도 넌지시 물어보려고 한 적은 있어. 그런데 얼버무려 버려서……」"},
{"id": "clyu01:31400", "ko": "그렇다면 집에서 얘기를 들어 줄 수 있는 건 아버지랑 유토랑 우키 정도인가."},
{"id": "clyu01:31500", "ko": "그중에서 우키는 원인이기도 하고, 유토도 상담할 나이는 아니다."},
{"id": "clyu01:31600", "ko": "아버지는…… 저런 사람이니까."},
{"id": "clyu01:31700", "ko": "「나는 봐, 좀 잔소리가 많은 편이잖아? 그래서 말하기 어려운 걸지도 모르고, 그런 점에서 타쿠루라면…… 해서」"},
{"id": "clyu01:31800", "ko": "「⟦rb⟧유이⟦rt⟧그 애⟦/r⟧, 타쿠루를 따르는 구석도 있고……」"},
{"id": "clyu01:31900", "ko": "뭐야. 그렇게 말은 하지만 결국 소거법이잖아."},
{"id": "clyu01:32000", "ko": "「그래도 그런 고민이라면 누구나 있는 거 아냐?」"},
{"id": "clyu01:32100", "ko": "「그건 그렇지만……」"},
{"id": "clyu01:32200", "ko": "「애초에 고민이 심각하면 언젠가 자기가 먼저 말하겠지. 게다가 내가 그 나이대 여자애 상담을 들어 줄 수 있을 것 같지도 않고, 애초에 나랑은 상관없――」"},
{"id": "clyu01:32300", "ko": "「타쿠루~……?」"},
{"id": "clyu01:32400", "ko": "「아……」"},
{"id": "clyu01:32500", "ko": "큰일이다. 노노의 목소리 톤이 올라갔다."},
{"id": "clyu01:32600", "ko": "이거 또…… 지뢰를 밟았나?"},
{"id": "clyu01:32700", "ko": "「상관없어? 방금 상관없다고 했지?」"},
{"id": "clyu01:32800", "ko": "「아, 아니, 방금 건 그냥 말이 그렇다는 거고……」"},
{"id": "clyu01:32900", "ko": "「가족의 장래 얘기를 하고 있는데 상관없다고? 설마 진심으로 한 말은 아니겠지!」"},
{"id": "clyu01:33000", "ko": "「아~! 그러고 보니 마침 오랜만에 집에 얼굴 좀 비칠까 생각하던 참이었어!」"},
{"id": "clyu01:33100", "ko": "「모처럼이니까 한동안 집에서 유이 상태라도 지켜볼까 하는데, 어때?」"},
{"id": "clyu01:33200", "ko": "「……그래. 그렇다면 됐어」"},
{"id": "clyu01:33300", "ko": "「…………」"},
{"id": "clyu01:33400", "ko": "머릿속에서 오노에의 목소리가 들렸다."},
{"id": "clyu01:33500", "ko": "『정말, 타쿠는 노노한테 약하다니까~……』", "note": "のんちゃん(세리카가 노노를 부르는 애칭)은 「노노」로"},
{"id": "clyu01:33600", "ko": "쓸데없는 참견이다. 나도 알고 있다고."},
{"id": "clyu01:33700", "ko": "「다녀왔어」"},
{"id": "clyu01:33800", "ko": "「어라~? 타쿠루 형?!」"},
{"id": "clyu01:33900", "ko": "눈치를 보듯 집에 들어서자, 나를 본 유토가 눈을 동그랗게 떴다."},
{"id": "clyu01:34000", "ko": "「오랜만이야」"},
{"id": "clyu01:34100", "ko": "「무슨 일이야? 돌아온 거야?」"},
{"id": "clyu01:34200", "ko": "「뭐, 당분간……」"},
{"id": "clyu01:34300", "ko": "「왜?」"},
{"id": "clyu01:34400", "ko": "「가끔은 유토네 얼굴이 보고 싶어져서」"},
{"id": "clyu01:34500", "ko": "「정말?! 신난다! 나도 타쿠루 형 보고 싶었어」"},
{"id": "clyu01:34600", "ko": "노노가 으름장을 놔서, 라는 진실은 말할 수 없다."},
{"id": "clyu01:34700", "ko": "게다가 돌아오는 길에 내 안에서는 생각이 조금 바뀌었다."},
{"id": "clyu01:34800", "ko": "만약―― 여기서 내가 유이의 고민이라는 걸 멋지게 해결해 준다면…… 그러면 노노도 나를 조금은 다시 보겠지."},
{"id": "clyu01:34900", "ko": "지금까지처럼 미덥지 못한 남동생 취급을 안 하게 될지도 모르고, 그렇게 되면 내가 하는 일마다 일일이 참견하지 않게 될지도 모른다."},
{"id": "clyu01:35000", "ko": "그건 앞으로의 내 인생에 있어 엄청난 플러스가 되지 않을까――"},
{"id": "clyu01:35100", "ko": "「어머? 유토뿐이야? 우키랑 유이는?」"},
{"id": "clyu01:35200", "ko": "「둘 다 아빠 있는 데서 일 돕고 있지 않을까」"},
{"id": "clyu01:35300", "ko": "아버지 있는 데라면, 병원 쪽인가."},
{"id": "clyu01:35400", "ko": "「잠깐 보고 올게」"},
{"id": "clyu01:35500", "ko": "나는 집에 붙어 있는 ⟦col:280aa02d1400⟧아오바 의원⟦col:800000⟧을 몰래 들여다보기로 했다."},
{"id": "clyu01:35600", "ko": "「우키. 이거 부탁한다」"},
{"id": "clyu01:35700", "ko": "「네」"},
{"id": "clyu01:35800", "ko": "「우키는 늘 일을 거들고, 어린데도 장하구나~」"},
{"id": "clyu01:35900", "ko": "「아뇨. 좋아서 하는 일이니까요」"},
{"id": "clyu01:36000", "ko": "「자, 사탕 줄게. 이따가 먹으렴」"},
{"id": "clyu01:36100", "ko": "「……감사합니다」"},
{"id": "clyu01:36200", "ko": "「어이, 우키. 그거 어디 뒀더라? 으음, 그거 있잖냐, 그거!」"},
{"id": "clyu01:36300", "ko": "「청진기라면 목에 걸려 있어요」"},
{"id": "clyu01:36400", "ko": "「응? 아아, 진짜네. 나이 먹으니까 금방 이렇다니까. 싫어진다」"},
{"id": "clyu01:36500", "ko": "「그나저나 우키. 너 용케 알았구나」"},
{"id": "clyu01:36600", "ko": "「아버지 모습을 보다 보니까 그냥」"},
{"id": "clyu01:36700", "ko": "「하핫, 역시구나」"},
{"id": "clyu01:36800", "ko": "「어땠어?」"},
{"id": "clyu01:36900", "ko": "아오바 기숙사로 돌아오자, 저녁 준비를 시작하려던 노노가 물었다."},
{"id": "clyu01:37000", "ko": "「우키밖에 없었어」"},
{"id": "clyu01:37100", "ko": "잠깐 봤을 뿐이지만, 저 상태라면 확실히 우키 혼자서 충분해 보였다."},
{"id": "clyu01:37200", "ko": "그렇다면 유이가 있을 곳이 없다고 느끼는 것도 무리는 아니다."},
{"id": "clyu01:37300", "ko": "「그럼 누나는 방에 있을지도」"},
{"id": "clyu01:37400", "ko": "「방이라……」"},
{"id": "clyu01:37500", "ko": "나는 유이의 방으로 가려다가, 그 전에 문득 생각이 나서 유토 곁으로 다가갔다."},
{"id": "clyu01:37600", "ko": "「있잖아, 유토. 요즘 유이한테 달라진 거 없어?」"},
{"id": "clyu01:37700", "ko": "「달라진 거라니?」"},
{"id": "clyu01:37800", "ko": "「글쎄…… 뭔가 고민하고 있다든가……」"},
{"id": "clyu01:37900", "ko": "「음…… 고민하는지는 모르겠지만…… 요즘 맨날 노트에 열심히 뭔가 쓰고 있는 것 같아」"},
{"id": "clyu01:38000", "ko": "「노트에? 뭘?」"},
{"id": "clyu01:38100", "ko": "「글쎄. 누나는 보려고 하면 화내고」"},
{"id": "clyu01:38200", "ko": "……그게 유이의 고민과 관계있는 걸까?"},
{"id": "clyu01:38300", "ko": "유이 방 앞에서 노크를 하자, 안에서 뭔가 허둥대는 듯한 소리가 들렸다."},
{"id": "clyu01:38400", "ko": "「누구야?!」"},
{"id": "clyu01:38500", "ko": "「나야. 열어도 돼?」"},
{"id": "clyu01:38600", "ko": "「타쿠루 오빠?! 잠깐 기다려!!」"},
{"id": "clyu01:38700", "ko": "다시 부스럭거리는 소리가 나더니, 이윽고――"},
{"id": "clyu01:38800", "ko": "「괜찮아. 들어와」"},
{"id": "clyu01:38900", "ko": "목소리에 따라 문을 열자, 책상을 등지고 유이가 서 있었다."},
{"id": "clyu01:39000", "ko": "「타, 타쿠루 오빠…… 와 있었구나」"},
{"id": "clyu01:39100", "ko": "「응, 뭐…… 좀」"},
{"id": "clyu01:39200", "ko": "「그럼, 이제부터 계속 집에 있는 거야?」"},
{"id": "clyu01:39300", "ko": "「아니, 일단 오늘만이고, 내일이 되면 다시 돌아갈 거야」"},
{"id": "clyu01:39400", "ko": "「뭐야~. 아쉽다. 다시 다 같이 살 수 있을 줄 알았는데」"},
{"id": "clyu01:39500", "ko": "유이는 입을 삐죽 내밀며 말했다."},
{"id": "clyu01:39600", "ko": "그 말투에서는 노노가 말한 것 같은 심각한 기색은 엿볼 수 없었다."},
{"id": "clyu01:39700", "ko": "하지만――"},
{"id": "clyu01:39800", "ko": "「그러고 보니, 뭐 하고 있었어?」"},
{"id": "clyu01:39900", "ko": "「어? 뭐 하냐니, 그…… 고, 공부지?」"}
]
