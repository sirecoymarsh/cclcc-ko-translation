[
{"id": "clah04:20000", "ko": "「아, 여기 있었군」"},
{"id": "clah04:20100", "ko": "그때 복도 안쪽을 지나가던 와쿠이 선생님이 우리를 보고 다가왔다."},
{"id": "clah04:20200", "ko": "「찾았네, 미야시로 군, 아리무라 양. 잠깐 같이 가 줄 수 있겠나?」"},
{"id": "clah04:20300", "ko": "「그렇군. 그러니까 아리무라 양이 어머니와 싸우고 미야시로 군 방에 굴러들어 갔다, 이거로군」"},
{"id": "clah04:20400", "ko": "「뭐, 그런 거예요」"},
{"id": "clah04:20500", "ko": "곤란하게 됐다."},
{"id": "clah04:20600", "ko": "설마 선생님까지 알게 될 줄이야."},
{"id": "clah04:20700", "ko": "「그래서 불순한 행위는 전혀 없다, 이건가」"},
{"id": "clah04:20800", "ko": "「물론입니다!!!」"},
{"id": "clah04:20900", "ko": "「흠……」"},
{"id": "clah04:21000", "ko": "……아니, 잠깐?"},
{"id": "clah04:21100", "ko": "여기서 문제가 되면 아리무라는 얌전히 집에 돌아갈 수밖에 없게 되지 않을까?"},
{"id": "clah04:21200", "ko": "나도 약간의 꾸중은 듣겠지만, 그걸로 내 평온한 생활이 돌아온다면 만만세 아닌가?"},
{"id": "clah04:21300", "ko": "「그런가. 그렇다면 됐네. 오케이」"},
{"id": "clah04:21400", "ko": "「네?」"},
{"id": "clah04:21500", "ko": "그런데 와쿠이 선생님은 순순히 인정했다."},
{"id": "clah04:21600", "ko": "「어, 어째서요!?」"},
{"id": "clah04:21700", "ko": "「학생으로서 절도를 지키며 사귀고 있는 거잖나?」"},
{"id": "clah04:21800", "ko": "「학교로서도 불순한 행위에 빠지는 건 곤란하지만, 그게 아니라면 이러쿵저러쿵할 일도 아니고 말이지」"},
{"id": "clah04:21900", "ko": "「그, 그래도 혹시 무슨 일이 생길지도……」"},
{"id": "clah04:22000", "ko": "「생기는 건가?」"},
{"id": "clah04:22100", "ko": "「아, 아뇨…… 없…… 습니다……」"},
{"id": "clah04:22200", "ko": "「음. 그렇다면 문제없네」"},
{"id": "clah04:22300", "ko": "「그렇게 말씀하셔도……!」"},
{"id": "clah04:22400", "ko": "「게다가 아리무라 양의 어머니와도 아까 전화로 이야기를 해 두었네. 딸이 하고 싶은 대로 하게 해 달라더군」"},
{"id": "clah04:22500", "ko": "「부모님이 괜찮다고 하시면 우리가 이러쿵저러쿵할 일이 아니라네」"},
{"id": "clah04:22600", "ko": "그런……"},
{"id": "clah04:22700", "ko": "「뭐, 둘 다 부디 절도 있는 교제를 부탁하네」"},
{"id": "clah04:22800", "ko": "「아, 선생님! 잠깐――」"},
{"id": "clah04:22900", "ko": "하지만 그런 내 목소리는 닿지 않았고, 와쿠이 선생님은 그대로 가 버렸다."},
{"id": "clah04:23000", "ko": "「일단 혼나지 않은 건 다행이지만……」"},
{"id": "clah04:23100", "ko": "다행이 아니다. 전혀 다행이 아니야!"},
{"id": "clah04:23200", "ko": "이걸로 이 바보 같은 가출 소동을 아리무라가 포기하게 만들 구실이 또 하나 줄어들었다는 거다."},
{"id": "clah04:23300", "ko": "이렇게 된 이상……"},
{"id": "clah04:23400", "ko": "「어이, 미야시로. 할 얘기가 있는데……」"},
{"id": "clah04:23500", "ko": "「카, 카와하라!!! 마침 잘 왔어!」"},
{"id": "clah04:23600", "ko": "「어……?」"},
{"id": "clah04:23700", "ko": "「그렇군. 그래서 와쿠이 선생님은 뭐라고 하셨지?」"},
{"id": "clah04:23800", "ko": "「그게…… 딱히……」"},
{"id": "clah04:23900", "ko": "「흠……」"},
{"id": "clah04:24000", "ko": "교직원까지 인정한 이상, 이제 믿을 건 학생회…… 아니, 카와하라뿐이다."},
{"id": "clah04:24100", "ko": "나한테는 유독 엄한 카와하라다."},
{"id": "clah04:24200", "ko": "이런 소동이 있으면 이때다 싶어 책망해 올 게 틀림없다."},
{"id": "clah04:24300", "ko": "그렇게 되면 내 뜻대로다."},
{"id": "clah04:24400", "ko": "「선생님들이 뭐라고 하든, 학생회로서는 학생끼리라는 관계를 벗어나는 행위, 혹은 벗어날 가능성으로 이어지는 행위를 인정할 수 없다」"},
{"id": "clah04:24500", "ko": "「그, 그렇죠!!」"},
{"id": "clah04:24600", "ko": "「에〜. 딱히 떳떳하지 못한 짓을 하는 것도 아닌데요〜」"},
{"id": "clah04:24700", "ko": "「더 이상 이상한 소문이 퍼져서 학내에 불순한 공기가 만연해도 곤란해. 안 되는 건 안 된다」"},
{"id": "clah04:24800", "ko": "「딱딱하시긴…… 그러니까 쿠루스 선배가 거들떠보지도 않는 검다〜」"},
{"id": "clah04:24900", "ko": "「응? 뭐라고 했나?」"},
{"id": "clah04:25000", "ko": "「아니요오, 아무것도♪」"},
{"id": "clah04:25100", "ko": "「아무튼 아리무라는 오늘부터 제대로 집에 돌아가도록. 알겠지」"},
{"id": "clah04:25200", "ko": "「네〜. 알겠습니다〜」"},
{"id": "clah04:25300", "ko": "응……?"},
{"id": "clah04:25400", "ko": "「어쩔 수 없네. 미야시로 선배, 가요」"},
{"id": "clah04:25500", "ko": "아리무라가 내 등에 손을 두르며 재촉했다."},
{"id": "clah04:25600", "ko": "뭐야. 의외로 순순히 포기하잖아……"},
{"id": "clah04:25700", "ko": "아리무라도 카와하라는 껄끄러웠던 건가."},
{"id": "clah04:25800", "ko": "아무튼 이걸로 드디어 평온한 시간이 돌아온다."},
{"id": "clah04:25900", "ko": "지금만큼은 카와하라에게 감사하자고!"},
{"id": "clah04:26000", "ko": "「그, 그럼 우리는……」"},
{"id": "clah04:26100", "ko": "이 손에 되찾을 평온에 기대를 품고, 나는 학생회실을 나서려고 문에 손을 댔다."},
{"id": "clah04:26200", "ko": "「자, 잠깐, 미야시로!!!」"},
{"id": "clah04:26300", "ko": "「어?」"},
{"id": "clah04:26400", "ko": "「아〜, 뭐랄까, 그, 말이지……」"},
{"id": "clah04:26500", "ko": "뭐지?"},
{"id": "clah04:26600", "ko": "평소 카와하라답지 않게 유난히 횡설수설하는 말투인데……"},
{"id": "clah04:26700", "ko": "「여, 역시 학생회로서도 처음부터 학생을 의심의 눈으로 보는 건 좋지 않다」"},
{"id": "clah04:26800", "ko": "「네……?」"},
{"id": "clah04:26900", "ko": "「⟦col:280aa02d1400⟧남녀칠세부동석⟦col:800000⟧ 같은 건 구시대적인 사고방식이다. 앞으로는 좀 더 유연하게 생각해야 한다고 나는 생각한다」"},
{"id": "clah04:27000", "ko": "「그렇게 함께 성장하면서 자제심을 기르는 것도 중요한 공부가 될지도 모르고 말이야」"},
{"id": "clah04:27100", "ko": "「애초에 남녀라는 것만으로 삐딱하게 보는 건 보는 쪽에도 문제가 있다는 거다」"},
{"id": "clah04:27200", "ko": "「게다가 남녀 교제도 결코 나쁜 것만 있다고는 할 수 없지」"},
{"id": "clah04:27300", "ko": "「그중에는 서로를 성장시키는 관계도 있을 거다」"},
{"id": "clah04:27400", "ko": "대체 무슨 말이 하고 싶은 거야?"},
{"id": "clah04:27500", "ko": "「즉, 우리 학생회는 너희의 동거 생활을 인정하겠다는 거다. 아니, 오히려 적극적으로 응원해도 좋아」"},
{"id": "clah04:27600", "ko": "「네!? 자, 잠깐만요!!」"},
{"id": "clah04:27700", "ko": "「너희 둘이 본교의 새로운 모델 케이스가 되어 남녀 간의 새로운 사랑의 형태를 노래해 주길 기대하고 있겠다」"},
{"id": "clah04:27800", "ko": "「그런! 아까랑 하는 말이 다르――」"},
{"id": "clah04:27900", "ko": "「그런 거다. 아리무라도 알겠지」"},
{"id": "clah04:28000", "ko": "「네〜. 알겠습니다〜. 그럼 미야시로 선배, 가요」"},
{"id": "clah04:28100", "ko": "「잠깐! 나는 아직 할 얘기가――」"},
{"id": "clah04:28200", "ko": "「아, 미야시로!」"},
{"id": "clah04:28300", "ko": "반쯤 억지로 학생회실에서 밀려 나오자, 거기에는 이토 일행이 있었다."},
{"id": "clah04:28400", "ko": "아무래도 우리를 쫓아온 모양이다."},
{"id": "clah04:28500", "ko": "「그래서 어땠어? 뭐라고 하든?」"},
{"id": "clah04:28600", "ko": "「그게……」"},
{"id": "clah04:28700", "ko": "아까까지 나를 규탄할 기세였는데, 갑자기 손바닥 뒤집듯 바뀐 카와하라의 태도."},
{"id": "clah04:28800", "ko": "그건 대체 뭐였던 거지."},
{"id": "clah04:28900", "ko": "그야말로 여우에 홀린 기분이다."},
{"id": "clah04:29000", "ko": "「어라, 타쿠. 등에 뭐가 붙어 있어?」"},
{"id": "clah04:29100", "ko": "「어?」"},
{"id": "clah04:29200", "ko": "「이게 뭐야? 『쿠루스 선배랑 떼어 놓고 싶으면――』」"},
{"id": "clah04:29300", "ko": "「와아아아아아아아아아아아아아!!」"},
{"id": "clah04:29400", "ko": "「우와〜. 등에 커다랗게 『바보』라고 쓴 종이가 붙어 있었어요, 선배」"},
{"id": "clah04:29500", "ko": "「누굴까요〜, 요즘 세상에 이런 장난을 치다니. 너무하다〜」"},
{"id": "clah04:29600", "ko": "「???」"},
{"id": "clah04:29700", "ko": "「뭐, 그래도 학생회 사람도 문제없다고 했고, 이걸로 숨길 것 없이 당당하게 미야시로 선배네서 공동생활을 할 수 있게 된 거네요」"},
{"id": "clah04:29800", "ko": "……이 녀석, 무슨 짓을 한 거 아냐?"},
{"id": "clah04:29900", "ko": "「뭐요?」"}
]
