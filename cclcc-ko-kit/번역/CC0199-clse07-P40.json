[
{"id": "clse07:377300", "ko": "「그런데 지금은 우키가 있잖아? 아빠 일도, 집안일도 그 애가 나서서 해 주게 돼서……」"},
{"id": "clse07:377400", "ko": "「스스로도 안 된다는 걸 알면서도 아무래도 비교하게 되나 봐……」"},
{"id": "clse07:377500", "ko": "「그래서 요즘 여러 가지로 고민하게 돼서……」"},
{"id": "clse07:377600", "ko": "「……나도 넌지시 물어보려고 한 적은 있었어. 그런데 얼버무리더라고……」"},
{"id": "clse07:377700", "ko": "「나는, 봐, 좀 잔소리가 많은 편이잖아? 그래서 말하기 어려운 걸지도 모르고, 그 점에선 타쿠루라면……」"},
{"id": "clse07:377800", "ko": "「⟦rb⟧유이⟦rt⟧그 애⟦/r⟧는 타쿠루를 따르는 구석도 있고……」"},
{"id": "clse07:377900", "ko": "「그건 그렇지만……」"},
{"id": "clse07:378000", "ko": "「타쿠루〜……?」"},
{"id": "clse07:378100", "ko": "「상관없어? 지금 상관없다고 했지?」"},
{"id": "clse07:378200", "ko": "「가족의 장래 얘기를 하고 있는데 상관없다고? 설마 진심으로 한 말은 아니겠지!」"},
{"id": "clse07:378300", "ko": "「……그래. 그럼 됐어」"},
{"id": "clse07:378400", "ko": "「어머? 유토뿐이야? 우키랑 유이는?」"},
{"id": "clse07:378500", "ko": "「어땠어?」"},
{"id": "clse07:378600", "ko": "「자, 자, 타쿠루. 내 반찬도 줄 테니까 많이 먹어」"},
{"id": "clse07:378700", "ko": "「응, 맛있게 먹어 줘서 고마워」"},
{"id": "clse07:378800", "ko": "「숙제는?」"},
{"id": "clse07:378900", "ko": "「응…… 그럼 됐어」"},
{"id": "clse07:379000", "ko": "「얘, 유이」"},
{"id": "clse07:379100", "ko": "「어머. 타쿠루도 “케이 씨”한테 빠져 있었잖아. 그거랑 같은 거야」"},
{"id": "clse07:379200", "ko": "「왜 그래?」"},
{"id": "clse07:379300", "ko": "「그래. 그 타카야나기 모모네라는 사람, 립싱크였던 걸 역이용해서 지금은 립싱크 아이돌로 니야생에서 뜨는 중…… 어머? 혹시 타쿠루, 몰랐어?」"},
{"id": "clse07:379400", "ko": "「그렇지, 타쿠루가 그럴 리가 없지」"},
{"id": "clse07:379500", "ko": "「안 돼, 유이. 아이돌 활동이라니」"},
{"id": "clse07:379600", "ko": "「잘 들어? 연예 활동이라는 건 언뜻 화려해 보이지만 고생도 많아」"},
{"id": "clse07:379700", "ko": "「쉽게 할 수 있을 것 같아 보여도, 많은 사람이 협력해 줘야 비로소 할 수 있는 거야」"},
{"id": "clse07:379800", "ko": "「게다가 공부랑 병행하는 것도 힘들단 말이야. 너 그거 할 수 있어?」"},
{"id": "clse07:379900", "ko": "「지금도 숙제 많다고 징징대면서?」"},
{"id": "clse07:380000", "ko": "「그건……」"},
{"id": "clse07:380100", "ko": "「확실히 우리 집은 돈이 많은 건 아니지만, 그래도 우리 모두가 먹고살 만큼은 아빠가 제대로 벌어 주고 있어」"},
{"id": "clse07:380200", "ko": "「게다가 인터넷으로 방송한다는 건 불특정 다수가 본다는 거야. 그게 어떤 건지 알아?」"},
{"id": "clse07:380300", "ko": "「모르는 사람들이 잔뜩 네 얼굴을 알게 된다는 거야. 그중에는 어쩌면 이상한 사람도 있을지 몰라」"},
{"id": "clse07:380400", "ko": "「그러다 만약 무슨 일이 생기면 어쩔 생각이야?」"},
{"id": "clse07:380500", "ko": "「유이 마음은 알아. 나도 유이처럼 아이돌을 동경한 적이 있으니까」"},
{"id": "clse07:380600", "ko": "「뭐?」"},
{"id": "clse07:380700", "ko": "「확실히 요즘 세상에는 아이돌 흉내 정도는 간단히 낼 수 있을지도 몰라」"},
{"id": "clse07:380800", "ko": "「그래도 말이야, 진심으로 하려면 그야말로 돈도 들고, 개인의 힘으로 그렇게 쉽게 할 수 있는 게 아니야」"},
{"id": "clse07:380900", "ko": "「너라면 알겠지, 유이……」"},
{"id": "clse07:381000", "ko": "「그럼……」"},
{"id": "clse07:381100", "ko": "「……타, 쿠루……?」"},
{"id": "clse07:381200", "ko": "「있잖아…… 타쿠루…… 어디 있어? 대답해 줘……」"},
{"id": "clse07:381300", "ko": "「어두워서 아무것도 안 보여…… 그러니까 부탁이야……」"},
{"id": "clse07:381400", "ko": "「타쿠루…… 어두워…… 살려 줘……」"},
{"id": "clse07:381500", "ko": "「다녀왔습니다」"},
{"id": "clse07:381600", "ko": "「있잖아, 유이. 타쿠루가 안 보이는데, 어디 갔는지 알――」"},
{"id": "clse07:381700", "ko": "「타쿠루……」"},
{"id": "clse07:381800", "ko": "「어머, 타쿠루. 잘됐네. 유이가 놀아 줘서」"},
{"id": "clse07:381900", "ko": "「후훗. 타쿠루. 착하게 있었나 보네」"},
{"id": "clse07:382000", "ko": "「자, 타쿠루. 이리 와. 착하다 착하다 해 줄게」"},
{"id": "clse07:382100", "ko": "「옳지 옳지, 착하다 착해」"},
{"id": "clse07:382200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:382300", "ko": "「왜 그래?」"},
{"id": "clse07:382400", "ko": "「…………」"},
{"id": "clse07:382500", "ko": "「있잖아, 유이. 타쿠루가 안 보이는데, 어디 갔는지 알――」"},
{"id": "clse07:382600", "ko": "「타쿠루……」"},
{"id": "clse07:382700", "ko": "「아니라고? 뭐가 아니라는 거야?」"},
{"id": "clse07:382800", "ko": "「그건…… 무슨 뜻이니, 유이?」"},
{"id": "clse07:382900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:383000", "ko": "「그래……」"},
{"id": "clse07:383100", "ko": "「읏……」"},
{"id": "clse07:383200", "ko": "「타쿠루는 조용히 해!」"},
{"id": "clse07:383300", "ko": "「…………」"},
{"id": "clse07:383400", "ko": "「…………」"},
{"id": "clse07:383500", "ko": "「……듣고 보니 그러네」"},
{"id": "clse07:383600", "ko": "「아, 나도 손이 좋아」"},
{"id": "clse07:383700", "ko": "「그것도 좋네」"},
{"id": "clse07:383800", "ko": "「응. 알았어」"},
{"id": "clse07:383900", "ko": "「그럼, 간다」"},
{"id": "clse07:384000", "ko": "「…………」"},
{"id": "clse07:384100", "ko": "「……둘 다 요즘 식욕이 엄청나네」"},
{"id": "clse07:384200", "ko": "「그건 좋은데, 너무 많이 먹으면 살쪄」"},
{"id": "clse07:384300", "ko": "「어머. 비 오기 시작했나 봐」"},
{"id": "clse07:384400", "ko": "「……내일 빨래 어떡하지」"},
{"id": "clse07:384500", "ko": "「그래? 그럼 다행이지만……」"},
{"id": "clse07:384600", "ko": "「그러고 보니 타쿠루. 요즘 유이네랑 자주 같이 있는 것 같던데……」"},
{"id": "clse07:384700", "ko": "「고마워. 요즘 유이도 유토도 즐거워 보이고, 타쿠루가 돌아와 준 덕분이야」"},
{"id": "clse07:384800", "ko": "「그럼, 역시……」"},
{"id": "clse07:384900", "ko": "「그 @채널 글에서 두 사람을 데리고 있던 사람을 찾을 수는 없나요?」"},
{"id": "clse07:385000", "ko": "「타쿠루! 이 방송 못 막아!?」"},
{"id": "clse07:385100", "ko": "「괜찮아…… 분명 같이 있을 거야」"},
{"id": "clse07:385200", "ko": "「어쩌면……」"},
{"id": "clse07:385300", "ko": "「뭔가 약점을 잡혔다…… 든가?」"},
{"id": "clse07:385400", "ko": "「무슨 소리야, 유토?」"},
{"id": "clse07:385500", "ko": "「왜 그래…… 유토?」"},
{"id": "clse07:385600", "ko": "「혹시…… 얘기할 수 있는 거야? 유이랑……」"},
{"id": "clse07:385700", "ko": "「유이는 뭐래?」"},
{"id": "clse07:385800", "ko": "「벽에…… 얼굴……」"},
{"id": "clse07:385900", "ko": "「유이!!」"},
{"id": "clse07:386000", "ko": "「아무튼 우리가 왔으니까 이제 괜찮아……」"},
{"id": "clse07:386100", "ko": "「아아, 타쿠루. 다행이다. 지금 막 부실로 가려던 참이었는데, 수고를 덜었네」"},
{"id": "clse07:386200", "ko": "「그 모습을 보니 역시 잊어버렸구나」"},
{"id": "clse07:386300", "ko": "「오늘은 우키랑 유이 진로 때문에 집에 선생님이 오시니까 동아리는 쉰다고 전에 말했을 텐데」"},
{"id": "clse07:386400", "ko": "「그런 거니까 잘 부탁해」"},
{"id": "clse07:386500", "ko": "「……설마 부실에 갇혀 있었을 줄이야……」"},
{"id": "clse07:386600", "ko": "「안녕하세요, 쿠노사토 씨」"},
{"id": "clse07:386700", "ko": "「유토가 학교에서 돌아오자마자 뭔가 신나서 도시락을 만들길래 무슨 일인가 했거든요. 물어봐도 아무것도 안 알려 주고」"},
{"id": "clse07:386800", "ko": "「그치, 유토?」"},
{"id": "clse07:386900", "ko": "「응, 좋은 냄새. 조금만 더 일찍 왔으면 같이 먹을 수 있었으려나?」"},
{"id": "clse07:387000", "ko": "「응, 유토? 다음엔 누나한테도 대접해 줘?」"},
{"id": "clse07:387100", "ko": "「자, 곤란하게 됐네, 유토?」"},
{"id": "clse07:387200", "ko": "「타쿠루? 무슨…… 일 있어?」"}
]
