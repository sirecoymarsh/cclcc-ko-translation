[
{"id": "clse01:34700", "ko": "「그리고 지금은 코피를 뿜으며 쓰러져 있어」"},
{"id": "clse01:34800", "ko": "「그렇군. 알기 쉬운 설명, 고맙다」"},
{"id": "clse01:34900", "ko": "「멋대로 납득하지 마~! 하나도 모르겠단 말이야~!」"},
{"id": "clse01:35000", "ko": "「아아, 나쁜 버릇이 나와서 망상을 좀…… 놀라게 해서 미안했다」"},
{"id": "clse01:35100", "ko": "나는 여기저기 쑤시는 몸을 문지르며 일어났다."},
{"id": "clse01:35200", "ko": "오노에는 재빨리 휴지로 코피를 막아 준다. 이런 점만큼은 옛날부터 정말 상냥하고 눈치 빠른 녀석이라고 생각한다."},
{"id": "clse01:35300", "ko": "그 밖에는 바보 같은 애지만, 뭐, 그런 점도 귀엽다면 귀엽다."},
{"id": "clse01:35400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:35500", "ko": "（어, 우왓! 아차!）"},
{"id": "clse01:35600", "ko": "막연히 그런 생각을 하고 있을 때, 마침 오노에는 내 이마에서 조금 배어 나온 피를 휴지로 닦아 주던 참이었다."},
{"id": "clse01:35700", "ko": "당연히 그녀의 눈은 내 눈 언저리를 보고 있는 상태니까…… 사고 도촬을 봉인했다는 게 거짓말이라면, 내 생각은 그녀에게 완전히 새어 나갔을 것이다."},
{"id": "clse01:35800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:35900", "ko": "나는 엄청나게 민망해져서 눈을 피한다."},
{"id": "clse01:36000", "ko": "「??? 왜 그래?」"},
{"id": "clse01:36100", "ko": "「어?」"},
{"id": "clse01:36200", "ko": "어라?"},
{"id": "clse01:36300", "ko": "오노에 녀석, 딱히 쑥스러워하는 반응조차 보이지 않는다."},
{"id": "clse01:36400", "ko": "그렇다는 건, 정말로 능력을 봉인하고 있는 건가?"},
{"id": "clse01:36500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:36600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:36700", "ko": "「우? 어라? 뭔가 화났어?」"},
{"id": "clse01:36800", "ko": "「왜, 왜 내가 오노에 때문에 화를 내야 하는 건데?」"},
{"id": "clse01:36900", "ko": "「내 탓? 어, 왜?」"},
{"id": "clse01:37000", "ko": "「아니, 그러니까――」"},
{"id": "clse01:37100", "ko": "거기까지 말하다가 알아차렸다."},
{"id": "clse01:37200", "ko": "그녀는 정말로 아무것도 모르는 멍한 얼굴로 이쪽을 보고 있다."},
{"id": "clse01:37300", "ko": "이게 연기라면 대단한 거지만…… 만약 그렇지 않다면 전자――즉, 내 생각을 정말로 읽지 않은 것이다."},
{"id": "clse01:37400", "ko": "「야, 너 말이야? 혹시 지금 능력 안 쓰고 있는 거야?」"},
{"id": "clse01:37500", "ko": "「우? 그, 그러니까 그렇게 말했잖아」"},
{"id": "clse01:37600", "ko": "「사고 도촬 같은 거 이제 안 해. 노노한테 주의받은 거, 타쿠도 알잖아?」"},
{"id": "clse01:37700", "ko": "「그래도 겐 씨 생각은 간단히 도촬했잖아?」"},
{"id": "clse01:37800", "ko": "「……. 아, 그건 그게…… 겐 씨가 나쁜 생각을 하는 것 같아서. 응, 정말 그것뿐이야」"},
{"id": "clse01:37900", "ko": "어딘가 변명처럼 들리게 오노에는 말끝을 흐렸다."},
{"id": "clse01:38000", "ko": "「…………」"},
{"id": "clse01:38100", "ko": "「저, 저기, 오노에?」"},
{"id": "clse01:38200", "ko": "「……? 뭔데~?」"},
{"id": "clse01:38300", "ko": "「이제 됐잖아? 슬슬 그만하라고」"},
{"id": "clse01:38400", "ko": "「무, 무슨 소리야?」"},
{"id": "clse01:38500", "ko": "「너, 아까부터 계속 나를 사고 도촬하고 있지? 기분 좋지 않거든, 그거」"},
{"id": "clse01:38600", "ko": "「쿠루스한테도 실컷 주의받았잖아? 친구 잃는다?」"},
{"id": "clse01:38700", "ko": "「에에에? 그런 거 안 했어! 안 했다니까!」"},
{"id": "clse01:38800", "ko": "「뭐?」"},
{"id": "clse01:38900", "ko": "안 했다고?"},
{"id": "clse01:39000", "ko": "사고 도촬을?"},
{"id": "clse01:39100", "ko": "「나는 오히려 타쿠가 계속 나를 빤히 쳐다보니까, 뭘까~? 하고 보고 있었을 뿐이야~?」"},
{"id": "clse01:39200", "ko": "「그것뿐? 이라고?」"},
{"id": "clse01:39300", "ko": "「응. 확실히 내 능력은 안 좋은 거구나 싶어서 되도록 안 쓰려고 하는데……」"},
{"id": "clse01:39400", "ko": "오노에는 살짝 뾰로통해 보였다."},
{"id": "clse01:39500", "ko": "「……미, 미안. 내가 착각했어. 잘못했다」"},
{"id": "clse01:39600", "ko": "「으, 응. 알아주면 그걸로 됐어. 응」"},
{"id": "clse01:39700", "ko": "「그보다 타쿠는 왜 나를 계속 보고 있었어?」"},
{"id": "clse01:39800", "ko": "「응? 그건――」"},
{"id": "clse01:39900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:40000", "ko": "「미안하지만 그건 아니야」"},
{"id": "clse01:40100", "ko": "그 순간 오노에의 고개가 푹 떨궈졌다."},
{"id": "clse01:40200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:40300", "ko": "「뭐야, 그게」"},
{"id": "clse01:40400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:40500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse01:40600", "ko": "", "note": "보류 — 연애 묘사(학생)"}
]
