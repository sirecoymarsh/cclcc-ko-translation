[
{"id": "clse07:587300", "ko": "「좋은 거?」"},
{"id": "clse07:587400", "ko": "「오노에랑 아리무라가…… 베이글……」"},
{"id": "clse07:587500", "ko": "「먹을 수는 있는 거겠지?」"},
{"id": "clse07:587600", "ko": "「기다려, 아리무라. 농담이라니까」"},
{"id": "clse07:587700", "ko": "「무슨 뜻이야?」"},
{"id": "clse07:587800", "ko": "「아〜, 정말, 알았어. 어쩔 수 없지……」"},
{"id": "clse07:587900", "ko": "「아리무라가 『부탁드립니다, 미야시로 선배. 소인이 만든 베이글이라도 괜찮으시다면 드셔 주시지 않겠사옵니까?』라고 하면 먹어 주지」"},
{"id": "clse07:588000", "ko": "「헤에. 겉보기는 나쁘지 않잖아」"},
{"id": "clse07:588100", "ko": "「문제는 맛이지……」"},
{"id": "clse07:588200", "ko": "「오노에 건?」"},
{"id": "clse07:588300", "ko": "「뭐, 뭐라고 할까…… 응, 맛도 문제겠지……」"},
{"id": "clse07:588400", "ko": "「응?」"},
{"id": "clse07:588500", "ko": "「야, 오노에…… 대체 뭘…… 읏!」"},
{"id": "clse07:588600", "ko": "「그, 그만――」"},
{"id": "clse07:588700", "ko": "「읍읍읍!!」"},
{"id": "clse07:588800", "ko": "「므, 믈…… 믈을……」"},
{"id": "clse07:588900", "ko": "「푸훕! 커헉, 컥……!」"},
{"id": "clse07:589000", "ko": "「으…… 으으……」"},
{"id": "clse07:589100", "ko": "「푸, 하아…… 험한 꼴을 당했네……」"},
{"id": "clse07:589200", "ko": "「너 말이야! 누구 때문에 이런 꼴을――」"},
{"id": "clse07:589300", "ko": "「아, 아니, 그 덕분에 방금 목숨을 잃을 뻔했다고?」"},
{"id": "clse07:589400", "ko": "「여자라고 해도 오노에랑 아리무라잖아」"},
{"id": "clse07:589500", "ko": "「힉! 미, 미안합니다! 베이글은 이제 봐주세요!」"},
{"id": "clse07:589600", "ko": "「이토……」"},
{"id": "clse07:589700", "ko": "「쿠루스가?」"},
{"id": "clse07:589800", "ko": "「봉투? 서, 설마 쿠루스도 베이글을……」"},
{"id": "clse07:589900", "ko": "「글쎄…… 뭐, 그래도 안 왔다는 건 별 용건 아니었던 거 아냐?」"},
{"id": "clse07:590000", "ko": "「당연하지」"},
{"id": "clse07:590100", "ko": "「이토, 저쪽에서 주스 사서 가지 않을래? 내가 살게」"},
{"id": "clse07:590200", "ko": "「뭐든 상관없잖아?」"},
{"id": "clse07:590300", "ko": "「딱히 꿍꿍이 같은 거 없다니까」"},
{"id": "clse07:590400", "ko": "「아……」"},
{"id": "clse07:590500", "ko": "「아, 안녕하세요……」"},
{"id": "clse07:590600", "ko": "「그게…… 그래서, 무슨 일로……?」"},
{"id": "clse07:590700", "ko": "「네……?」"},
{"id": "clse07:590800", "ko": "「글쎄……」"},
{"id": "clse07:590900", "ko": "「뭐? 그게 뭔데?」"},
{"id": "clse07:591000", "ko": "「왜 내가 이토한테 주스를 사 줘야 하는 건데」"},
{"id": "clse07:591100", "ko": "「바보 같은 소리 하지 말고 동아리 가자」"},
{"id": "clse07:591200", "ko": "「그런 옛날 일은 잊었다」"},
{"id": "clse07:591300", "ko": "「쿠루스 녀석, 늦네」"},
{"id": "clse07:591400", "ko": "「카즈키, 뭔가 알아?」"},
{"id": "clse07:591500", "ko": "「정말이지…… 그 녀석, 동아리 활동을 우습게 보는군」"},
{"id": "clse07:591600", "ko": "「이런 건 따끔하게 말해 둬야 하는 거야」"},
{"id": "clse07:591700", "ko": "「그건 들었어. 하지만 이유를――」"},
{"id": "clse07:591800", "ko": "「야, 노노!!」"},
{"id": "clse07:591900", "ko": "「응?」"},
{"id": "clse07:592000", "ko": "「뭐, 뭐야, 아리무라? 왜 그래?」"},
{"id": "clse07:592100", "ko": "「어? 아, 아니…… 글, 글쎄……」"},
{"id": "clse07:592200", "ko": "「아, 아니, 이건――!」"},
{"id": "clse07:592300", "ko": "「아니야! 그게 아니라……」"},
{"id": "clse07:592400", "ko": "「아니, 아무리 그래도 엿듣는 건 나쁘잖아」"},
{"id": "clse07:592500", "ko": "「아니, 그러니까 그건……」"},
{"id": "clse07:592600", "ko": "「조사……」"},
{"id": "clse07:592700", "ko": "「뭐, 뭐어, 조사라면…… 어쩔 수 없지」"},
{"id": "clse07:592800", "ko": "「뭐!」"},
{"id": "clse07:592900", "ko": "「기다――!!」"},
{"id": "clse07:593000", "ko": "「하아〜……」"},
{"id": "clse07:593100", "ko": "「아, 아아……」"},
{"id": "clse07:593200", "ko": "「아무튼 다들, 아까 본 건――」"},
{"id": "clse07:593300", "ko": "「와아아아아아아앗!!!」"},
{"id": "clse07:593400", "ko": "「무슨 생각 하는 거야! 아까 일을 처음부터 끝까지 우리가 봤다는 건 쿠루스한테는 비밀이다」"},
{"id": "clse07:593500", "ko": "「무슨 일이 있어도야!」"},
{"id": "clse07:593600", "ko": "「아〜, 아니, 아무것도 아니야, 아무것도. 그치, 이토?」"},
{"id": "clse07:593700", "ko": "「아〜, 그건 말인데, 나 잠깐 볼일이 있는 게 생각나서」"},
{"id": "clse07:593800", "ko": "「아, 아아, 그렇지. 그럼, 나는 이만」"},
{"id": "clse07:593900", "ko": "「읏…… 오늘은 관둘게. 늦어질 것 같고」"},
{"id": "clse07:594000", "ko": "（뭐가 쓰여 있는 거지?）"},
{"id": "clse07:594100", "ko": "「그게……」"},
{"id": "clse07:594200", "ko": "「어? 아, 아, 알고 있는 게 당연하잖아! 나를 누구라고 생각하는 거야」"},
{"id": "clse07:594300", "ko": "「저, 저기, 이토」"},
{"id": "clse07:594400", "ko": "「아니……」"},
{"id": "clse07:594500", "ko": "「오, 오노에? 아니, 그게 아니야, 이건 딱히 벽보 내용을 보려던 게 아니라……!」"},
{"id": "clse07:594600", "ko": "「교내 연애 금지!?」"},
{"id": "clse07:594700", "ko": "「아, 알고 있었어! 물론 알고 있었고말고! 정말 너무한 얘기지!!!」"},
{"id": "clse07:594800", "ko": "「학생회 제안이야?」"},
{"id": "clse07:594900", "ko": "「그런 태평한 소리 할 때냐!」"},
{"id": "clse07:595000", "ko": "「아〜, 나는……」"},
{"id": "clse07:595100", "ko": "「농담…… 이지?」"},
{"id": "clse07:595200", "ko": "「요컨대, 우리가 카와하라를 얕보고 있었다는 거다」"},
{"id": "clse07:595300", "ko": "「쿠루스!!!」"},
{"id": "clse07:595400", "ko": "「하지만 딱히 쿠루스가 책임을 느낄 필요도 없잖아. 이렇게 된 것도 학교 전체의 뜻이니까……」"},
{"id": "clse07:595500", "ko": "「우, 우우, 우리는 딱히 그런 사이가……」"},
{"id": "clse07:595600", "ko": "「뭐, 그러니까…… 곤란하다고 해도 일부 사람들뿐이고, 그것도 학교 밖까지 감시할 수는 없으니까, 실제로는 피해가 거의 없지 않아?」"},
{"id": "clse07:595700", "ko": "「그렇지? 결국 우리하고는 거의 상관없는 일이야」"},
{"id": "clse07:595800", "ko": "「뭐, 그렇지……」"},
{"id": "clse07:595900", "ko": "「뭐? 네가 그 얘기를 어떻게 알아?」"},
{"id": "clse07:596000", "ko": "「이토……」"},
{"id": "clse07:596100", "ko": "「너…… 설마 유이한테 무슨 짓 하려는 건 아니겠지?」"},
{"id": "clse07:596200", "ko": "「그러니까 그…… 노리고 있다든가」"},
{"id": "clse07:596300", "ko": "「어쩔 수 없지. 집에는 오늘 가기로 할게……」"},
{"id": "clse07:596400", "ko": "「잘 먹었습니다」"},
{"id": "clse07:596500", "ko": "「그럴지도」"},
{"id": "clse07:596600", "ko": "「센리. 나도 설거지 도울게」"},
{"id": "clse07:596700", "ko": "「오케이」"},
{"id": "clse07:596800", "ko": "「풉!」"},
{"id": "clse07:596900", "ko": "「푸부웁!!」"},
{"id": "clse07:597000", "ko": "「아니, 너희들……」"},
{"id": "clse07:597100", "ko": "「아, 아아……」"},
{"id": "clse07:597200", "ko": "「하아……」"}
]
