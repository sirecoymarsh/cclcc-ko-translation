[
{"id": "clkn07:20000", "ko": "「뭐, 뭐냐. 사람을 괴물 보듯이」"},
{"id": "clkn07:20100", "ko": "「아…… 아, 아니……」"},
{"id": "clkn07:20200", "ko": "「왜 그래? 숨을 헐떡이잖아. 감기냐?」"},
{"id": "clkn07:20300", "ko": "이마로 뻗어 온 아버지의 투박한 손을 나는 황급히 뿌리쳤다."},
{"id": "clkn07:20400", "ko": "「괘, 괜찮아! 괜찮으니까……!」"},
{"id": "clkn07:20500", "ko": "「그…… 그러냐? 그럼 됐다만」"},
{"id": "clkn07:20600", "ko": "「타쿠루 씨. 목욕물 다 데워졌어요. 먼저 들어가세요」"},
{"id": "clkn07:20700", "ko": "「어, 어어……」"},
{"id": "clkn07:20800", "ko": "……방금 꿈은 잊고, 얼른 목욕하고 자 버리자."},
{"id": "clkn07:20900", "ko": "아니 아니, 이러고저러고 할 것도 없다."},
{"id": "clkn07:21000", "ko": "우리는 가족이다."},
{"id": "clkn07:21100", "ko": "그런 일이 있을 리가…… 없겠지…… 아마……"},
{"id": "clkn07:21200", "ko": "그날 밤."},
{"id": "clkn07:21300", "ko": "나는 이상한 꿈을 꿨다."},
{"id": "clkn07:21400", "ko": "귓속 깊은 곳에서 계속 뭔가가 울리고 있었다."},
{"id": "clkn07:21500", "ko": "이건 뭐지?"},
{"id": "clkn07:21600", "ko": "울고 있어?"},
{"id": "clkn07:21700", "ko": "누군가가 울고 있다."},
{"id": "clkn07:21800", "ko": "그 ⟦rb⟧누군가⟦rt⟧⟦rbc⟧●●●⟦/r⟧는 계속 등을 돌리고 있었다."},
{"id": "clkn07:21900", "ko": "누구지?"},
{"id": "clkn07:22000", "ko": "노노인가?"},
{"id": "clkn07:22100", "ko": "아니면 센리인가?"},
{"id": "clkn07:22200", "ko": "아니야……"},
{"id": "clkn07:22300", "ko": "이 울음소리는……"},
{"id": "clkn07:22400", "ko": "아기?"},
{"id": "clkn07:22500", "ko": "그 순간, 등을 돌리고 있던 “누군가”가 돌아봤다."},
{"id": "clkn07:22600", "ko": "「읏…………!」"},
{"id": "clkn07:22700", "ko": "「으…… 아아아아아아아아아아아아앗!!」"}
