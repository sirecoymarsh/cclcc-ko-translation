[
{"id": "clah06:20000", "ko": "（안 입었…… 다니……）"},
{"id": "clah06:20100", "ko": "「어, 언제부터?」"},
{"id": "clah06:20200", "ko": "「아침부터 쭉…… 이에요……」"},
{"id": "clah06:20300", "ko": "「왜!」"},
{"id": "clah06:20400", "ko": "「그치만…… 선배, 이런 거 좋아할 것 같아서……」"},
{"id": "clah06:20500", "ko": "아리무라는 대체 나를 어떤 놈이라고 생각하는 거야!?"},
{"id": "clah06:20600", "ko": "큭…… 한순간이라도 아리무라를 순진하다고 생각한 내가 잘못이었다."},
{"id": "clah06:20700", "ko": "「말해 두겠는데요…… 이런 짓 하는 거…… 선배니까 그런 거예요……」"},
{"id": "clah06:20800", "ko": "그, 그런가."},
{"id": "clah06:20900", "ko": "이건 나를 위해서 해 준 거고……"},
{"id": "clah06:21000", "ko": "그렇다면…… 어쩔 수 없는 거지…… 그렇지?"},
{"id": "clah06:21100", "ko": "「…………」"},
{"id": "clah06:21200", "ko": "「읏…………」"},
{"id": "clah06:21300", "ko": "나도 모르게 숨을 삼킨다."},
{"id": "clah06:21400", "ko": "아리무라의 치마는 꽤 짧은 편이고, 그 아래는…… 니삭스가 아니라 타이츠지, 저건."},
{"id": "clah06:21500", "ko": "노팬티에 타이츠…… 그거라면 어느 정도는 티가 안 나지 않을까 싶기도 하지만, 그건 그거대로 꽤 마니악한 것 같다."},
{"id": "clah06:21600", "ko": "혹시 그것까지 포함해서 내가 좋아할지도 모른다고 한 건가?"},
{"id": "clah06:21700", "ko": "그렇다면…… 이 녀석은 전부 꿰뚫어 보고 있는 건가!?"},
{"id": "clah06:21800", "ko": "「신경 쓰여요?」"},
{"id": "clah06:21900", "ko": "「그, 그야……」"},
{"id": "clah06:22000", "ko": "「그럼……」"},
{"id": "clah06:22100", "ko": "아리무라는 무슨 생각인지 치맛자락을 살짝 집었다."},
{"id": "clah06:22200", "ko": "「어, 어이……」"},
{"id": "clah06:22300", "ko": "그리고 천천히, 천천히……"},
{"id": "clah06:22400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah06:22500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah06:22600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah06:22700", "ko": "「읏……」"},
{"id": "clah06:22800", "ko": "「……꿀꺽」"},
{"id": "clah06:22900", "ko": "「역시 안 돼! 더는 입 다물고 있을 수 없어!」"},
{"id": "clah06:23000", "ko": "아리무라가 갑자기 소리를 질렀다."},
{"id": "clah06:23100", "ko": "「미야시로 선배…… 실은 저, 선배한테 꼭 해야 할 말이 있는데요」"},
{"id": "clah06:23200", "ko": "「해야 할 말?」"},
{"id": "clah06:23300", "ko": "대체 뭐지?"},
{"id": "clah06:23400", "ko": "게다가 아까와는 딴판으로 유난히 진지한 표정을 짓고 있다."},
{"id": "clah06:23500", "ko": "뭔가 중대한 일일까."},
{"id": "clah06:23600", "ko": "「있잖아. 실은…… 그게…… 풉!」"},
{"id": "clah06:23700", "ko": "하고 이번에는 웃음을 터뜨렸다."},
{"id": "clah06:23800", "ko": "「아〜, 이제 참는 거 무리〜! 완전 창피하거든요〜」"},
{"id": "clah06:23900", "ko": "「대체 뭐냐고, 아까부터!!」"},
{"id": "clah06:24000", "ko": "「선배, 오늘 집 나오기 전에 거울 봤어요? 안 봤죠〜?」"},
{"id": "clah06:24100", "ko": "거울?"},
{"id": "clah06:24200", "ko": "확실히 안 보긴 했는데……"},
{"id": "clah06:24300", "ko": "「있잖아요……………… 코털, 나왔어요〜!!」"},
{"id": "clah06:24400", "ko": "「뭐!?」"},
{"id": "clah06:24500", "ko": "「그것도 양쪽 구멍에서. 빽빽하게!」"},
{"id": "clah06:24600", "ko": "「빽빽하게!?」"},
{"id": "clah06:24700", "ko": "「완전 덥수룩!」"},
{"id": "clah06:24800", "ko": "「덥수룩!!?」"},
{"id": "clah06:24900", "ko": "나도 모르게 두 손으로 코를 가렸다."},
{"id": "clah06:25000", "ko": "「아〜, 언제 눈치채나 하고 기다렸는데, 더는 같이 다니기 창피해〜!」"},
{"id": "clah06:25100", "ko": "그럼…… 아까 그건 쑥스러워한 게 아니라, 내 얼굴을 보고 계속 웃음을 참고 있었다는 건가?"},
{"id": "clah06:25200", "ko": "「맞아 맞아, 그리고……」"},
{"id": "clah06:25300", "ko": "아직 뭐가 더 있어!?"},
{"id": "clah06:25400", "ko": "「지퍼, 열렸어요오〜」"},
{"id": "clah06:25500", "ko": "「꺄앙!」"},
{"id": "clah06:25600", "ko": "「그리고 셔츠, 안팎이 뒤집혔고오」"},
{"id": "clah06:25700", "ko": "「히이이!」"},
{"id": "clah06:25800", "ko": "「뭔가 말라붙은 밥알도 붙어 있고오」"},
{"id": "clah06:25900", "ko": "「누와아아아!」"},
{"id": "clah06:26000", "ko": "「뒤통수에 까치집 졌고오」"},
{"id": "clah06:26100", "ko": "「으아아아아아!」"},
{"id": "clah06:26200", "ko": "「양말도 좌우 짝짝이예요오」"},
{"id": "clah06:26300", "ko": "「아…… 아아…… 아아……」"},
{"id": "clah06:26400", "ko": "「잘도 그 꼴로 밖을 돌아다녔네요〜. 저는 같이 걷기만 해도 얼굴이 빨개질 지경이었는데!」"},
{"id": "clah06:26500", "ko": "지나가는 사람들이 킥킥 웃으며 나를 손가락질하고 지나간다."},
{"id": "clah06:26600", "ko": "「부…… 부끄러워……」"},
{"id": "clah06:26700", "ko": "나는 지금까지 얼마나 창피한 꼴로 돌아다닌 거야."},
{"id": "clah06:26800", "ko": "이제…… 밖을 못 걷겠다."},
{"id": "clah06:26900", "ko": "당장 돌아가자."},
{"id": "clah06:27000", "ko": "집에 가자."},
{"id": "clah06:27100", "ko": "그리고 다시는 밖에 안 나간다."},
{"id": "clah06:27200", "ko": "평생 나가나 봐라."},
{"id": "clah06:27300", "ko": "「선배 위험해요!!」"},
{"id": "clah06:27400", "ko": "「어?」"},
{"id": "clah06:27500", "ko": "「아윽!!!」"},
{"id": "clah06:27600", "ko": "「괜찮아요?」"},
{"id": "clah06:27700", "ko": "……딴생각하면서 걷다가 전봇대에 제대로 부딪혀 버렸다."},
{"id": "clah06:27800", "ko": "「아야야야……」"},
{"id": "clah06:27900", "ko": "「참, 멍하니 있으니까」"},
{"id": "clah06:28000", "ko": "「미안……」"},
{"id": "clah06:28100", "ko": "「자, 보여 주세요」"},
{"id": "clah06:28200", "ko": "정신을 차려 보니 아리무라의 얼굴이 바로 옆에 있었다."},
{"id": "clah06:28300", "ko": "「괘, 괜찮아! 이 정도는 아무렇지도 않으니까!」"},
{"id": "clah06:28400", "ko": "「그래요……? 그럼 됐지만요」"},
{"id": "clah06:28500", "ko": "……정말이지, 나까지 쑥스러워해서 어쩌자는 거야."},
{"id": "clah06:28600", "ko": "그건 그렇고……"},
{"id": "clah06:28700", "ko": "「다음엔 어디 갈까나〜」"},
{"id": "clah06:28800", "ko": "오늘 아리무라는 영 적응이 안 되네."},
{"id": "clah06:28900", "ko": "「…………」"},
{"id": "clah06:29000", "ko": "「새근…… 새근……」"},
{"id": "clah06:29100", "ko": "「…………」"},
{"id": "clah06:29200", "ko": "「새근…… 새근……」"},
{"id": "clah06:29300", "ko": "젠장, 왜일까."},
{"id": "clah06:29400", "ko": "잠이 안 온다……"}
]
