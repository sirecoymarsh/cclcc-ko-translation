[
{"id": "clah03:10000", "ko": "「좋아한다…… 라」"},
{"id": "clah03:10100", "ko": "어라?"},
{"id": "clah03:10200", "ko": "「…………」"},
{"id": "clah03:10300", "ko": "왜 두 사람 다 굳은 얼굴을 하고 있는 거지?"},
{"id": "clah03:10400", "ko": "방금 대사, 분명 대본대로였지?"},
{"id": "clah03:10500", "ko": "「있지, 미야시로 군. 너 정말로 이 애를 좋아하니?」"},
{"id": "clah03:10600", "ko": "「무, 물론…… 이죠」"},
{"id": "clah03:10700", "ko": "「…………」"},
{"id": "clah03:10800", "ko": "「흐응…… 그래……」"},
{"id": "clah03:10900", "ko": "아리무라네 어머니는 여전히 굳은 얼굴로 일어섰다."},
{"id": "clah03:11000", "ko": "「뭐, 됐어. 오늘은 이만 가 볼게요」"},
{"id": "clah03:11100", "ko": "「네……?」"},
{"id": "clah03:11200", "ko": "「어차피 지금은 무슨 말을 해도 안 들을 테고. 머리가 식을 즈음에 다시 올게」"},
{"id": "clah03:11300", "ko": "그대로 가방을 들고 문 앞까지 걸어가더니, 문득 생각난 듯 돌아보며 나를 보고 말했다."},
{"id": "clah03:11400", "ko": "「돌아가는 길을 모르겠는데. 데려다줄 수 있으려나?」"},
{"id": "clah03:11500", "ko": "「…………」"},
{"id": "clah03:11600", "ko": "일찍이 이렇게 무거운 공기를 짊어진 채 이 길을 걸은 적이 있었던가."},
{"id": "clah03:11700", "ko": "등 뒤에서 오싹오싹 전해지는 아리무라네 어머니의 압박을 느끼며, 나는 이노카시라 거리로 향하는 길을 걷고 있었다."},
{"id": "clah03:11800", "ko": "（정말이지, 왜 내가――）"},
{"id": "clah03:11900", "ko": "그렇게 몇 번이고 속으로 물어봤자 당연히 답은 보이지 않는다."},
{"id": "clah03:12000", "ko": "「미야시로 군」"},
{"id": "clah03:12100", "ko": "「네, 네!?」"},
{"id": "clah03:12200", "ko": "등 뒤에서 이름을 부르는 소리에 펄쩍 뛸 뻔했다."},
{"id": "clah03:12300", "ko": "「미안하구나. 그 애의 제멋대로인 짓에 어울려 줘서」"},
{"id": "clah03:12400", "ko": "「네?」"},
{"id": "clah03:12500", "ko": "「그 애라면 뻔하지. 사귄다는 건 거짓말. 사람 좋은 선배한테 억지 부려서 굴러들어 간 거겠지?」"},
{"id": "clah03:12600", "ko": "……들켰다."},
{"id": "clah03:12700", "ko": "「그 얼굴을 보니 정곡인가 보구나」"},
{"id": "clah03:12800", "ko": "「아, 아뇨…… 그……」"},
{"id": "clah03:12900", "ko": "「뭐, 그래도 너 같은 타입을 고른 걸 보면 그 애 보는 눈도 영 없지는 않다는 건지도 모르겠지만」"},
{"id": "clah03:13000", "ko": "칭찬…… 인가?"},
{"id": "clah03:13100", "ko": "「너라면 이상한 짓은 안 할 것 같으니까」"},
{"id": "clah03:13200", "ko": "는 아니었던 모양이다."},
{"id": "clah03:13300", "ko": "「너도 곤란하지?」"},
{"id": "clah03:13400", "ko": "「그…… 뭐……」"},
{"id": "clah03:13500", "ko": "「후후. 그래도 너도 이상한 애구나. 곤란하면 그런 바보 같은 연극에 어울려 주지 않으면 될 텐데」"},
{"id": "clah03:13600", "ko": "「아……」"},
{"id": "clah03:13700", "ko": "듣고 보니 확실히 그랬다!"},
{"id": "clah03:13800", "ko": "아리무라를 진심으로 돌려보내고 싶었다면, 아리무라의 대본 따위 따르지 말고 사실을 다 털어놓으면 됐던 거다."},
{"id": "clah03:13900", "ko": "그럼 나는 왜 그러지 않았지?"},
{"id": "clah03:14000", "ko": "혹시…… 아리무라와의 시간이 아깝다고 생각했던 건가?"},
{"id": "clah03:14100", "ko": "아니, 그럴 리 없다…… 아마도."},
{"id": "clah03:14200", "ko": "「뭐, 그래도 어차피 여기서 억지로 그 애를 데려가 봤자 똑같을 테고, 너한테는 미안하지만 조금만 더 돌봐 줄 수 있으려나?」"},
{"id": "clah03:14300", "ko": "그렇게 말하더니 아리무라네 어머니는 지갑에서 지폐 몇 장을 꺼냈다."},
{"id": "clah03:14400", "ko": "「아, 아뇨……! 그건 받을 수 없어요!!」"},
{"id": "clah03:14500", "ko": "「폐 끼친 값 겸 숙박비야」"},
{"id": "clah03:14600", "ko": "「아, 안 돼요!」"},
{"id": "clah03:14700", "ko": "「그래도 저런 데서 산다는 건 형편이 어려운 거 아니니?」"},
{"id": "clah03:14800", "ko": "「저, 저기는 좋아서 지내는 것뿐이고, 딱히 어려운 건……」"},
{"id": "clah03:14900", "ko": "결국 내가 완강하게 받지 않으리라는 걸 알고, 아리무라네 어머니는 지폐를 거두었다."},
{"id": "clah03:15000", "ko": "「그렇구나……」"},
{"id": "clah03:15100", "ko": "「뭐, 뭐가요?」"},
{"id": "clah03:15200", "ko": "「이쪽 얘기야. 그보다 히나에를 잘 부탁할게」"},
{"id": "clah03:15300", "ko": "아리무라네 어머니는 정중하게 말하고 고개를 숙였다."},
{"id": "clah03:15400", "ko": "비겁하다."},
{"id": "clah03:15500", "ko": "할 수만 있다면 억지로라도 데려가 줬으면 했는데, 이렇게 고개를 숙이면 반박할 수가 없잖아."},
{"id": "clah03:15600", "ko": "「그 대신 그 애 몸을 버리게 하는 일이 있으면, 그때는…… 알고 있겠지?」"},
{"id": "clah03:15700", "ko": "……어떻게 되는 걸까?"},
{"id": "clah03:15800", "ko": "「아, 그 앞은 큰길이구나. 여기까지 오면 알겠어. 고마워, 그럼」"},
{"id": "clah03:15900", "ko": "뭐야."},
{"id": "clah03:16000", "ko": "아리무라는 불평했지만…… 좋은 어머니잖아."},
{"id": "clah03:16100", "ko": "뭐, 그래도 가족 사이의 일이라는 건 밖에서는 모르는 법이니, 분명 이런저런 일이 있겠지."},
{"id": "clah03:16200", "ko": "아무리 봐도 복잡한 사정이 있는 것 같았고……"},
{"id": "clah03:16300", "ko": "아무튼 지금 말할 수 있는 건, 내가 스스로 아리무라를 방에서 쫓아낼 기회를 놓쳐 버렸다는 것이다."},
{"id": "clah03:16400", "ko": "「다녀왔어……」"},
{"id": "clah03:16500", "ko": "「…………」"},
{"id": "clah03:16600", "ko": "방에 돌아오니 아리무라는 돌아보지도 않았다."},
{"id": "clah03:16700", "ko": "이상하네."},
{"id": "clah03:16800", "ko": "내가 돌아온 걸 눈치 못 챘나?"},
{"id": "clah03:16900", "ko": "……그럴 리 없지."},
{"id": "clah03:17000", "ko": "보통이라면 엄마랑 무슨 얘기를 했는지 물어볼 법한데."},
{"id": "clah03:17100", "ko": "「응……?」"},
{"id": "clah03:17200", "ko": "문득 쓰레기통 안에 종이 뭉치가 쑤셔 박혀 있는 게 눈에 들어왔다."},
{"id": "clah03:17300", "ko": "저건…… 아까 그 대본?"},
{"id": "clah03:17400", "ko": "뭐, 확실히 이제 필요 없을지도 모르지만, 그렇다 쳐도 버리는 게 너무 빠르지 않나?"},
{"id": "clah03:17500", "ko": "의문을 품으면서도 나는 냉장고에서 ⟦col:280aa02d1400⟧마운틴 뷰⟦col:800000⟧를 꺼냈다."},
{"id": "clah03:17600", "ko": "「선배. 하나 물어봐도 돼요?」"},
{"id": "clah03:17700", "ko": "「뭐, 뭔데?」"},
{"id": "clah03:17800", "ko": "「……미야시로 선배는 게이예요?」"},
{"id": "clah03:17900", "ko": "「푸우우우웃!!」"},
{"id": "clah03:18000", "ko": "막 입에 머금은 마운틴 뷰를 뿜었다."},
{"id": "clah03:18100", "ko": "「아, 진짜〜, 뭐 하는 거예요〜! 더러워〜」"},
{"id": "clah03:18200", "ko": "「네가 이상한 소리 하니까 그렇지!」"},
{"id": "clah03:18300", "ko": "「이상한 소리 아니거든요」"},
{"id": "clah03:18400", "ko": "「이상하잖아. 왜 내가 게이인데?」"},
{"id": "clah03:18500", "ko": "「그치만 선배, 아까 거짓말했잖슴까」"},
{"id": "clah03:18600", "ko": "거짓말? 무슨 소리지?"},
{"id": "clah03:18700", "ko": "「아까. 엄마한테 한 말」"},
{"id": "clah03:18800", "ko": "아리무라네 어머니한테 한 말이라면…… 혹시 그 대사 말인가?"},
{"id": "clah03:18900", "ko": "「그야 그건 아리무라가 만든 대본이잖아?」"},
{"id": "clah03:19000", "ko": "「그렇지만, 그래도 쪼오금이라도 제가 신경 쓰였다면 거짓말은 안 됐을 거예요」"},
{"id": "clah03:19100", "ko": "하는 말이 엉망진창이다."},
{"id": "clah03:19200", "ko": "「게다가 이렇게나 같이 있는데 이 히나에의 매력을 모르다니, 역시 게이죠? 이토 선배를 좋아하는 거예요? 그런 거예요?」"},
{"id": "clah03:19300", "ko": "「그럴 리가 없잖아!」"},
{"id": "clah03:19400", "ko": "「그럼 저한테 이상한 마음이 들거나 해요?」"},
{"id": "clah03:19500", "ko": "「이상한 마음이라니…… 뭔데?」"},
{"id": "clah03:19600", "ko": "「달아오른다든가」"},
{"id": "clah03:19700", "ko": "「안 그래」"},
{"id": "clah03:19800", "ko": "「…………」"},
{"id": "clah03:19900", "ko": "「뭐, 뭐야?」"}
]
