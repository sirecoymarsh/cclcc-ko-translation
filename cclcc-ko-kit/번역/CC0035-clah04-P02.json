[
{"id": "clah04:10000", "ko": "상?"},
{"id": "clah04:10100", "ko": "「제 니삭스…… 갖고 싶죠?」"},
{"id": "clah04:10200", "ko": "아리무라가 신고 있는 저 니삭스……"},
{"id": "clah04:10300", "ko": "「자. 갖고 싶으면 갖고 싶다고 말해야죠」"},
{"id": "clah04:10400", "ko": "「아, 아리무라의 니삭스…… 갖고 싶…… 어요」"},
{"id": "clah04:10500", "ko": "「주세요, 겠죠?」"},
{"id": "clah04:10600", "ko": "「아리무라의 니삭스를…… 저에게 주세요……」"},
{"id": "clah04:10700", "ko": "「참 잘했어요. 그럼……」"},
{"id": "clah04:10800", "ko": "아리무라는 기쁜 듯 미소 짓더니 천천히 허리를 낮췄다……"},
{"id": "clah04:10900", "ko": "그리고――"},
{"id": "clah04:11000", "ko": "「이야아아아아아앗!!!」"},
{"id": "clah04:11100", "ko": "「호고오오오오옷!!」"},
{"id": "clah04:11200", "ko": "아리무라의 무릎이 내 턱을 직격했다는 걸 깨달았을 때는 이미 의식이 끊어지려 하고 있었다."},
{"id": "clah04:11300", "ko": "「어때요, 제 니하이?」", "note": "ニーハイ(니삭스)를 「무릎(knee)을 높이(high)」로 비튼 말장난 — 여기서만 「니하이」"},
{"id": "clah04:11400", "ko": "아리무라…… 그건 니하이라기보다 ⟦col:280aa02d1400⟧진공 플라잉 니킥⟦col:800000⟧이다……"},
{"id": "clah04:11500", "ko": "……같은 일이 벌어질지도 모른다."},
{"id": "clah04:11600", "ko": "상상했더니 불순한 마음 따위는 단숨에 사라져 버렸다."},
{"id": "clah04:11700", "ko": "그래도 이걸로 잘된 거다, 아마……"},
{"id": "clah04:11800", "ko": "「…………」"},
{"id": "clah04:11900", "ko": "좋아, 괜찮다."},
{"id": "clah04:12000", "ko": "「아…… 선배. 차오임다」"},
{"id": "clah04:12100", "ko": "어느새 니삭스를 다 신은 아리무라가 이쪽을 보고 있었다."},
{"id": "clah04:12200", "ko": "「응…… 아아, 좋은 아침」"},
{"id": "clah04:12300", "ko": "다행이다."},
{"id": "clah04:12400", "ko": "아무래도 내가 보고 있었다는 건 눈치채지 못한 것 같다."},
{"id": "clah04:12500", "ko": "「빨리 준비 안 하면 학교 늦어요」"},
{"id": "clah04:12600", "ko": "「그, 그렇지……」"},
{"id": "clah04:12700", "ko": "「선배. 자, 이거」"},
{"id": "clah04:12800", "ko": "아침을 먹는 도중, 아리무라가 다시 책 같은 걸 건넸다."},
{"id": "clah04:12900", "ko": "「설마…… 대본?」"},
{"id": "clah04:13000", "ko": "「오, 눈치가 빠르심다〜」"},
{"id": "clah04:13100", "ko": "「대본이니까 대번에 알지」", "note": "원문은 察し(눈치)/冊子(책자)가 같은 소리인 말장난 — 「대본/대번에」로"},
{"id": "clah04:13200", "ko": "「엄마가 또 온다고 했으니까요. 그때를 위해서예요」"},
{"id": "clah04:13300", "ko": "내 말은 무시냐."},
{"id": "clah04:13400", "ko": "「참고로 아까 그 말을 무시한 건 제 배려거든요」"},
{"id": "clah04:13500", "ko": "「…………」"},
{"id": "clah04:13600", "ko": "「그런 고로, 이거 외워 두세요」"},
{"id": "clah04:13700", "ko": "어제 늦게까지 뭘 하나 했더니 이걸 쓰고 있었던 건가."},
{"id": "clah04:13800", "ko": "「그보다 아리무라. 동아리 말인데, 당분간 신문부에는 얼굴 안 내미는 게 좋지 않을까?」"},
{"id": "clah04:13900", "ko": "「왜요?」", "note": "원문 끝의 」」 는 오타로 보고 하나만"},
{"id": "clah04:14000", "ko": "「쓸데없는 데서 괜한 말을 툭 흘릴 수도 있잖아. 아무 일도 없다고는 해도 이상한 소문이 나면 아리무라도 곤란하잖아?」"},
{"id": "clah04:14100", "ko": "「흠…… 뭐, 그것도 그렇슴다」"},
{"id": "clah04:14200", "ko": "특히 아리무라 같은 능력을 가진 사람은 여러모로 성가실 것이다."},
{"id": "clah04:14300", "ko": "「알겠슴다. 그럼 학교에서는 되도록 접촉 안 하는 방향으로 부탁함다!」"},
{"id": "clah04:14400", "ko": "아무래도 순순히 납득해 준 것 같아서 다행이다."},
{"id": "clah04:14500", "ko": "「후우……」"},
{"id": "clah04:14600", "ko": "학교에 와서야 겨우 한숨 돌린 기분이다."},
{"id": "clah04:14700", "ko": "상대가 아리무라라고 해도, 역시 여자애가 계속 같이 있으면 방에 있어도 마음 편할 시간이 없다."},
{"id": "clah04:14800", "ko": "뭐, 그래도 학교에 있는 동안은 아리무라와 되도록 접촉하지 않기로 약속도 했으니, 이제야 겨우……"},
{"id": "clah04:14900", "ko": "「미야시로 선배!!!」"},
{"id": "clah04:15000", "ko": "「…………」"},
{"id": "clah04:15100", "ko": "「아리무라…… 학교에서는 되도록 엮이지 말자고 방금 말했잖아」"},
{"id": "clah04:15200", "ko": "「그렇긴 한데요〜, 여기엔 사정이……」"},
{"id": "clah04:15300", "ko": "「아, 있다, 타쿠!!」"},
{"id": "clah04:15400", "ko": "목소리에 돌아보니 신문부 녀석들이 얼굴빛이 변해서 달려오고 있었다."},
{"id": "clah04:15500", "ko": "「무, 무슨 일이야? 뭔가 특종이라도 있었어?」"},
{"id": "clah04:15600", "ko": "「뭐, 특종이라면 특종일지도 모르지」"},
{"id": "clah04:15700", "ko": "뭐야, 그 뭔가 숨기는 듯한 말투는."},
{"id": "clah04:15800", "ko": "「타쿠루. 그리고 아리무라도. 그 소문 진짜야?」"},
{"id": "clah04:15900", "ko": "「소문……?」"},
{"id": "clah04:16000", "ko": "「타쿠랑 히나가 같이 살고 있다는 소문 말이야」"},
{"id": "clah04:16100", "ko": "「뭐!?」"},
{"id": "clah04:16200", "ko": "어째서지?"},
{"id": "clah04:16300", "ko": "대체 누가……"},
{"id": "clah04:16400", "ko": "「2학년…… 이시다 모에라는 사람이 봤다고 한대…… 일지도」", "note": "표에 없는 이름: 石田萌 → 이시다 모에"},
{"id": "clah04:16500", "ko": "이시다 모에?"},
{"id": "clah04:16600", "ko": "후배라면 아리무라랑 아는 사이인가?"},
{"id": "clah04:16700", "ko": "「이시다…… 아〜, 같은 반이었던 적은 있는데, 잘 기억이 안 나네」"},
{"id": "clah04:16800", "ko": "아니, 지금은 소문의 출처는 아무래도 좋다."},
{"id": "clah04:16900", "ko": "「그래서 진짜야, 어떻게 된 거야?」"},
{"id": "clah04:17000", "ko": "「그, 그건……」"},
{"id": "clah04:17100", "ko": "「진짜임다」"},
{"id": "clah04:17200", "ko": "「야, 야, 아리무라!!!」"},
{"id": "clah04:17300", "ko": "「진짜라는 건, 아리무라, 너 타쿠루 방에?」"},
{"id": "clah04:17400", "ko": "「아〜, 그렇다고 해도 딱히 이상한 관계는 아니에요. 그냥 당분간 신세 지고 있을 뿐이에요. 그쵸, 선배♪」"},
{"id": "clah04:17500", "ko": "『그쵸, 선배♪』는 무슨……"},
{"id": "clah04:17600", "ko": "「윽…… 뭐, 그런 거야. 그러니까 이상한 일은 아무것도 없어. 정말로」"},
{"id": "clah04:17700", "ko": "나는 힐끗 이토를 보았다."},
{"id": "clah04:17800", "ko": "이런 소문이 퍼졌다면 분명 『나를 제쳐 두고!』 같은 귀찮은 소리를 해 올 게 틀림없다."},
{"id": "clah04:17900", "ko": "「미야시로오〜」"},
{"id": "clah04:18000", "ko": "거봐, 왔다."},
{"id": "clah04:18100", "ko": "「너도 고생이 많구나……」"},
{"id": "clah04:18200", "ko": "「엥?」"},
{"id": "clah04:18300", "ko": "「네가 그 아리무라를 스스로 끌어들였을 리가 없지. 어차피 약점이라도 잡혔다든가 그런 거겠지?」"},
{"id": "clah04:18400", "ko": "「이토……」"},
{"id": "clah04:18500", "ko": "뭐야, 의외로 이해가 빠르잖아."},
{"id": "clah04:18600", "ko": "역시 가져야 할 건 친구구나."},
{"id": "clah04:18700", "ko": "「뭐, 타쿠니까〜」"},
{"id": "clah04:18800", "ko": "「…………」"},
{"id": "clah04:18900", "ko": "「아리무라 상대로 뭘 할 수 있을 것 같지도 않고……」"},
{"id": "clah04:19000", "ko": "「무리…… 일지도……」"},
{"id": "clah04:19100", "ko": "어라?"},
{"id": "clah04:19200", "ko": "내가 생각했던 것보다 다들 훨씬 잘 이해해 주고 있나?"},
{"id": "clah04:19300", "ko": "「잠깐요〜! 잠깐 잠깐〜! 왜 다들 납득해 주고 있는 검까〜! 이럴 땐 보통 여자애를 걱정하는 거잖아요」"},
{"id": "clah04:19400", "ko": "「그치만 타쿠랑 히나잖아……」"},
{"id": "clah04:19500", "ko": "「두 사람을 모르는 사람이라면 몰라도, 그치……」"},
{"id": "clah04:19600", "ko": "「……일지도」"},
{"id": "clah04:19700", "ko": "「끄으으응〜……」"},
{"id": "clah04:19800", "ko": "이건 기뻐해야 할 일일까."},
{"id": "clah04:19900", "ko": "아니, 내가 말하지 않아도 다들 내 결백을 믿어 주고 있으니, 그건 그거대로 나쁜 일은 아니지만……"}
]
