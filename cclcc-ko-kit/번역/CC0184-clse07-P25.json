{"id": "clse07:237200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:237300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:237400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:237500", "ko": "「농담이야〜. 거짓말」"},
{"id": "clse07:237600", "ko": "「하나가 부끄러워서 선배한테 먼저 샤워하게 했잖아」"},
{"id": "clse07:237700", "ko": "「그런데 역시 몸이 꽁꽁 얼어서 한계였나 봐」"},
{"id": "clse07:237800", "ko": "「맞아 맞아. 그래서 더는 못 참겠다고, 어떡하냐고 ⟦rb⟧나⟦rt⟧⟦rbc⟧●⟦/r⟧한테 상담해 와서 말이야」"},
{"id": "clse07:237900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:238700", "ko": "「어?」"},
{"id": "clse07:238800", "ko": "「거짓말!」"},
{"id": "clse07:238900", "ko": "「잠깐 선배! 괜찮아!?」"},
{"id": "clse07:239000", "ko": "「일어나! 응, 일어나라니까!」"},
{"id": "clse07:239100", "ko": "「선배!」"},
{"id": "clse07:239200", "ko": "「……이제, 그만두고 싶어…… 일지도」"},
{"id": "clse07:239300", "ko": "「왜?」"},
{"id": "clse07:239400", "ko": "「으음……!」"},
{"id": "clse07:239500", "ko": "「여기까지 왔으니까, 끝까지 해 보자」"},
{"id": "clse07:239600", "ko": "「……으으응. 하지만……」"},
{"id": "clse07:239700", "ko": "「이런 건 좋지 않아…… 일지도」"},
{"id": "clse07:239800", "ko": "「좋지 않다니, 뭐가?」"},
{"id": "clse07:239900", "ko": "「뭐가, 냐니……」"},
{"id": "clse07:240000", "ko": "「으으응……」"},
{"id": "clse07:240100", "ko": "「그치만, 이런 건 치사해…… 일지도」"},
{"id": "clse07:240200", "ko": "「……」"},
{"id": "clse07:240300", "ko": "「치사해? 어디가 치사한데?」"},
{"id": "clse07:240400", "ko": "「으으응……」"},
{"id": "clse07:240500", "ko": "「안 돼. 제대로 말로 해」"},
{"id": "clse07:240600", "ko": "「응……」"},
{"id": "clse07:240700", "ko": "「그치만……」"},
{"id": "clse07:240800", "ko": "「타쿠루 선배의 마음을, 이용하고 있어…… 일지도」"},
{"id": "clse07:240900", "ko": "「선배는, 네 억지에 휘둘리고 있다고 생각하고 있어…… 일지도」"},
{"id": "clse07:241000", "ko": "「그 말대로잖아. 그러니까 네가 신경 쓸 건 하나도 없어」"},
{"id": "clse07:241100", "ko": "「으으응!」"},
{"id": "clse07:241200", "ko": "「그게, 이용하는 거야…… 일지도」"},
{"id": "clse07:241300", "ko": "「모르겠네. 이용한다니, 누가?」"},
{"id": "clse07:241400", "ko": "「응……」"},
{"id": "clse07:241500", "ko": "「우리, 가…… 일지도」"},
{"id": "clse07:241600", "ko": "「우리가?」"},
{"id": "clse07:241700", "ko": "「……으응, 아니야…… 일지도」"},
{"id": "clse07:241800", "ko": "「타쿠루 선배의 마음을 이용하고 있는 건――」"},
{"id": "clse07:241900", "ko": "「――나…… 일지도」"},
{"id": "clse07:242000", "ko": "「……」"},
{"id": "clse07:242100", "ko": "「……후우」"},
{"id": "clse07:242200", "ko": "「그래. 그 말대로야」"},
{"id": "clse07:242300", "ko": "「미야시로 선배의 마음을 이용하고 있는 건 우리가 아니라 너야. 너 혼자뿐이라고」"},
{"id": "clse07:242400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:242500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:242600", "ko": "「……」"},
{"id": "clse07:242700", "ko": "「……응」"},
{"id": "clse07:242800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:242900", "ko": "「그래, 네가 원하니까 내가 여기 있는 거야」"},
{"id": "clse07:243000", "ko": "「소심하고, 사람 대하는 게 서툴고, 게다가 성가신 능력 탓에 말하는 것조차 제대로 못 하는 너 대신 여기 있는 거라고」"},
{"id": "clse07:243100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:243200", "ko": "「……읏!?」"},
{"id": "clse07:243300", "ko": "「으으으응!!!!」"},
{"id": "clse07:243400", "ko": "「……」"},
{"id": "clse07:243500", "ko": "「읏!!」"},
{"id": "clse07:243600", "ko": "「……」"},
{"id": "clse07:243700", "ko": "「……미안, 해」"},
{"id": "clse07:243800", "ko": "「…………」"},
{"id": "clse07:243900", "ko": "「…………」"},
{"id": "clse07:244000", "ko": "「…………」"},
{"id": "clse07:244100", "ko": "「…………」"}
]
