[
{"id": "clse07:234200", "ko": "「그러니까 먼저, 들어가」"},
{"id": "clse07:234300", "ko": "「그것만이, 아니야」"},
{"id": "clse07:234400", "ko": "「내가, 거기 있을 수 있는 이유」"},
{"id": "clse07:234500", "ko": "「노노 선배만이, 아니야」"},
{"id": "clse07:234600", "ko": "「뭘 신경 안 쓴다는 거야?」"},
