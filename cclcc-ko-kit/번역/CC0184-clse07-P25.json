{"id": "clse07:236300", "ko": "「음후」"},
{"id": "clse07:236400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:236500", "ko": "「음후」"},
{"id": "clse07:236600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:236700", "ko": "", "note": "보류 — 성적 묘사"},
