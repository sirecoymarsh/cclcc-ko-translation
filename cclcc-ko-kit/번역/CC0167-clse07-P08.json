[
{"id": "clse07:69800", "ko": "「너무해! 그렇다면 제가 싫어진 거죠」"},
{"id": "clse07:69900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:70000", "ko": "「정말이에요? 그럼 또 만들어 올게요」"},
{"id": "clse07:70100", "ko": "「선배…… 조금 있으면 졸업해 버리는군요」"},
{"id": "clse07:70200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:70300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:70400", "ko": "「뭐가요?」"},
{"id": "clse07:70500", "ko": "「정말, 선배도 참. 그런 걱정은 필요 없어요. 왜냐하면……」"},
{"id": "clse07:70600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:70700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:70800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:70900", "ko": "「……선배…… 부탁이 있는데요……」"},
{"id": "clse07:71000", "ko": "「다음에 우리 집에 와 주지 않을래요?」"},
{"id": "clse07:71100", "ko": "「네. 오빠가 한번 만나 보고 싶대요……」"},
{"id": "clse07:71200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:71300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:71400", "ko": "「네」"},
{"id": "clse07:71500", "ko": "「선배?」"},
{"id": "clse07:71600", "ko": "「후후…… 잠들어 버렸나」"},
{"id": "clse07:71700", "ko": "「고마워요, 선배」"},
{"id": "clse07:71800", "ko": "「선배……」"},
{"id": "clse07:71900", "ko": "「선~배…… 일어나요, 선배……」"},
{"id": "clse07:72000", "ko": "「정말, 어쩔 수 없다니까……」"},
{"id": "clse07:72100", "ko": "「…………」"},
{"id": "clse07:72200", "ko": "「아, 겨우 일어났다」"},
{"id": "clse07:72300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:72400", "ko": "「뭐가요?」"},
{"id": "clse07:72500", "ko": "「괜찮아요. 어차피 아빠도 엄마도 멋대로 하고 있으니까」"},
{"id": "clse07:72600", "ko": "「그럼 선배는 제가 돌아가 버려도 괜찮아요?」"},
{"id": "clse07:72700", "ko": "「내일부터 또 청소도 빨래도 밥도 전~부 직접 하게 될 거예요?」"},
{"id": "clse07:72800", "ko": "「게다가……」"},
{"id": "clse07:72900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:73000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:73100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:73200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:73300", "ko": "「……라는 건 농담이에요, 농담」"},
{"id": "clse07:73400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:73500", "ko": "「네?」"},
{"id": "clse07:73600", "ko": "「선배……」"},
{"id": "clse07:73700", "ko": "「있잖아요, 선배?」"},
{"id": "clse07:73800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:73900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:74000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:74100", "ko": "「에잇!」"},
{"id": "clse07:74200", "ko": "「후훗……」"},
{"id": "clse07:74300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:74400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:74500", "ko": "「이토 선배는 전혀 모르네요. 오히려 이쪽을 써야죠」"},
{"id": "clse07:74600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:74700", "ko": "「그런 낮은 의식이니까 인기가 없는 거예요!」"},
{"id": "clse07:74800", "ko": "「미야시로 선배 차오임다」"},
{"id": "clse07:74900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:75000", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:75100", "ko": "「그렇슴다」"},
{"id": "clse07:75200", "ko": "「그때의 미야시로 선배, 뭔가 사명감에 불타서 멋있었슴다~」"},
{"id": "clse07:75300", "ko": "「네? 그야 다 같이 동아리 활동을 하고 있었으니까요」"},
{"id": "clse07:75400", "ko": "「뭐, 교복을 입고 있는 쪽이 안심이긴 했죠」"},
{"id": "clse07:75500", "ko": "「시내에서 카메라를 돌리고 있으면 이상한 트집을 잡히는 일도 있을 테고요」"},
{"id": "clse07:75600", "ko": "「…………」"},
{"id": "clse07:75700", "ko": "「아하하하하!」"},
{"id": "clse07:75800", "ko": "「미, 미야시로 선배! 기, 기억이, 안 난다니, 거, 거짓말, 이죠!」"},
{"id": "clse07:75900", "ko": "「선배……」"},
{"id": "clse07:76000", "ko": "「정말로 기억 안 나는군요……」"},
{"id": "clse07:76100", "ko": "「너무해……」"},
{"id": "clse07:76200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:76300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:76400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:76500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:76600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:76700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:76800", "ko": "「너무해!」"},
{"id": "clse07:76900", "ko": "「……쳇」"},
{"id": "clse07:77000", "ko": "「조금만 더 하면 막대한 위자료를 받아 낼 수 있었는데」"},
{"id": "clse07:77100", "ko": "「농담이에요, 미야시로 선배」"},
{"id": "clse07:77200", "ko": "「확실히 어젯밤의 선배는 어디까지나 신사적이었어요」"},
{"id": "clse07:77300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:77400", "ko": "「자자, 즐거웠으니까 됐잖아요」"},
{"id": "clse07:77500", "ko": "「갑자기 눈을 번쩍 뜨더니 딴사람처럼 말하기 시작했어요!」"},
{"id": "clse07:77600", "ko": "「얼굴이 새빨갰고, 음료수 중 어딘가에 미성년자가 마시면 안 되는 뭔가가 들어 있었던 걸까요~」"},
{"id": "clse07:77700", "ko": "「아이고~ 그런 몹쓸 짓을 한 게 누굴까~. 괘씸하네~」"},
{"id": "clse07:77800", "ko": "「녹화 예약을 깜빡한 프로그램이 있어서요」"},
{"id": "clse07:77900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:78000", "ko": "「이…… 뭐라고요?」"},
{"id": "clse07:78100", "ko": "「꽤 괜찮은 통솔력이었어요」"},
{"id": "clse07:78200", "ko": "「늘 있는 일 아님까」"},
{"id": "clse07:78300", "ko": "「그러고 보니 방을 나갈 때의 하나, 평소랑 분위기가 좀 다르지 않았어요?」"},
{"id": "clse07:78400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:78500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:78600", "ko": "「……흐~응? 뭐, 상관없지만요」"},
{"id": "clse07:78700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:78800", "ko": "「세리, 미야시로 선배는 거짓말 안 하고 있어」"},
{"id": "clse07:78900", "ko": "「네. 저는 언제나 미야시로 선배 편이에요」"},
{"id": "clse07:79000", "ko": "「사실을 말하자면, 아까 미야시로 선배가 부실을 나갈 때 다들한테 진짜 이유를 말하지 않았다는 걸 알고 있었어요」"},
{"id": "clse07:79100", "ko": "「물론이죠. 알았지? 세리」"},
{"id": "clse07:79200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:79300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:79400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:79500", "ko": "「자~ 대체 무슨 말일까요?」"},
{"id": "clse07:79600", "ko": "「확실히 이상하네요」"},
{"id": "clse07:79700", "ko": "「미야시로 선배라면 『이건 누가 나를 놀리려고 쓴 게 틀림없어. 속을까 보냐!』 같은 느낌이죠」"}
]
