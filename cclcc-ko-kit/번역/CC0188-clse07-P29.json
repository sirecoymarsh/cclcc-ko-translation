[
{"id": "clse07:274200", "ko": "「좁아…… 일지도……」"},
{"id": "clse07:274300", "ko": "「하고 싶은 말은 알았어…… 일지도. 하지만……」"},
{"id": "clse07:274400", "ko": "「응…… 좋은 표정…… 일지도」"},
{"id": "clse07:274500", "ko": "「응…………」"},
{"id": "clse07:274600", "ko": "「최악…… 일지도」"},
{"id": "clse07:274700", "ko": "「응……」"},
{"id": "clse07:274800", "ko": "「응……」"},
{"id": "clse07:274900", "ko": "「으음……」"},
{"id": "clse07:275000", "ko": "「굉장해…… 일지도……」"},
{"id": "clse07:275100", "ko": "「……반에서도 가끔 화제에 올라…… 일지도……」"},
{"id": "clse07:275200", "ko": "「응……?」"},
{"id": "clse07:275300", "ko": "「깜짝 놀랐어…… 일지도……」"},
{"id": "clse07:275400", "ko": "「곤란해…… 일지도……」"},
{"id": "clse07:275500", "ko": "「응……」"},
{"id": "clse07:275600", "ko": "「신상 노출…… 일지도」"},
{"id": "clse07:275700", "ko": "「다 같이 나눠서 찾아야 해……」"},
{"id": "clse07:275800", "ko": "「읏…… 젠장……!」"},
{"id": "clse07:275900", "ko": "「응……」"},
{"id": "clse07:276000", "ko": "「햐와하아아〜」"},
{"id": "clse07:276100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:276200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:276300", "ko": "「그래도 돼요?」"},
{"id": "clse07:276400", "ko": "「아, 그래도 조건이 하나 있어요. 잘 때는 히나에 씨랑 다른 방으로 해 주세요」"},
{"id": "clse07:276500", "ko": "「그치만 찰싹 달라붙으면 못 자니까」"},
{"id": "clse07:276600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:276700", "ko": "「나도 같이…… 일지도」"},
{"id": "clse07:276800", "ko": "「가게 취재도 하고 올게…… 일지도」"},
{"id": "clse07:276900", "ko": "「안됐다…… 일지도……」"},
{"id": "clse07:277000", "ko": "「――그리고 2016년, 봄」"},
{"id": "clse07:277100", "ko": "「시부야 전역을 뒤덮고 있던 대규모 “망상 싱크로”, 그리고 “카오스 차일드 증후군”이라는 이상 사태는 거의 수습되었다」"},
{"id": "clse07:277200", "ko": "「증후군 환자들은 모두 제정신을 되찾고, 원래의 평온한 일상으로 돌아가고 있다」"},
{"id": "clse07:277300", "ko": "「또한 정보가 넘쳐 나는 이 시대――그것이 아무리 충격적인 사건이었다 해도, 불과 몇 개월 만에 사람들의 기억은 화석이 되어 어느새 풍화되어 가려 하고 있었다」"},
{"id": "clse07:277400", "ko": "「그리고 그것은 이윽고 누구의 입에도 오르내리지 않게 되고…… 사람들은 새로운 자극을 찾아 정보의 바다를 그저 헤엄쳐 다닌다. 마치 굶주린 물고기처럼」"},
{"id": "clse07:277500", "ko": "「그러니까, 그래――내가 지금부터 하려는 이야기는 아마 잊혀 가는 무의미한 이야기 중 하나에 불과하고…… 우리에게조차 그저 사족일 뿐이라고, 나는 그렇게 생각한다」"},
{"id": "clse07:277600", "ko": "「응…… 으응……」"},
{"id": "clse07:277700", "ko": "「으아〜. 응〜?」"},
{"id": "clse07:277800", "ko": "「실례로군, 너는. 나처럼 근면한 과학자가 이 시간까지 자고 있을 리가 없지 않나?」"},
{"id": "clse07:277900", "ko": "「기분 탓이다. 그리고 『선생님』이라고 부르지 말라고 그렇게 말했을 텐데――」"},
{"id": "clse07:278000", "ko": "「응? 분명 어제 막 봐 줬잖아」"},
{"id": "clse07:278100", "ko": "「흐음……」"},
{"id": "clse07:278200", "ko": "（역시 어른과 아이는 뇌의 카운트 클록이 다르군. 한번 연구해 볼 가치는 있을 것 같다만……）"},
{"id": "clse07:278300", "ko": "（음, 더럽군）"},
{"id": "clse07:278400", "ko": "（유토 녀석…… 초등학생 주제에 왜 저렇게 잔소리가 많은 거지? 그 녀석 누나들 탓인가?）"},
{"id": "clse07:278500", "ko": "「흥. 너는 어린애인 데다 남자라서 모르겠지만, 여자한테 5분은 너무 짧다. 적어도 15분은 기다려」"},
{"id": "clse07:278600", "ko": "「바, 바보 같은 소리 마라. 청소 정도는 혼자서도 할 수 있다. 완벽하게」"},
{"id": "clse07:278700", "ko": "「으음……」"},
{"id": "clse07:278800", "ko": "「참나…… 쓸데없는 데 신경 쓰는 녀석이군. 어린애 주제에」"},
{"id": "clse07:278900", "ko": "「그러니까 15분 기다리라고 했잖아」"},
{"id": "clse07:279000", "ko": "「너도 언젠가 과학자가 되면 알게 될 거다」"},
{"id": "clse07:279100", "ko": "「………」"},
{"id": "clse07:279200", "ko": "「……… 이봐, 알고 있나? 밧줄로 묶은 사람을 욕조에 던져 넣고 진한 황산을 들이붓는 영화가 있지. 뼈까지 녹아서 완전 범죄가 가능하다는 모양인데…… 한번 시험해 볼까」"},
{"id": "clse07:279300", "ko": "「네가 이미 능력을 잃었다 해도…… 이 눈을 보면 알 수 있겠지? 내가 진심인지 아닌지」"},
{"id": "clse07:279400", "ko": "「그보다 애초에 너는 부르지도 않았다. 왜 멋대로 들어와 있는 거지」"},
{"id": "clse07:279500", "ko": "「……?」"},
{"id": "clse07:279600", "ko": "「이건, 그…… 방 청소와의 등가 교환이다. 딱히 이상할 건 없겠지」"},
{"id": "clse07:279700", "ko": "「단호히 거절한다」"},
{"id": "clse07:279800", "ko": "「……?」"},
{"id": "clse07:279900", "ko": "「……? 뭔가라니 뭐지?」"},
{"id": "clse07:280000", "ko": "「정말 아슬아슬했군. 하마터면 진짜로 베어 버릴 뻔했어」"},
{"id": "clse07:280100", "ko": "「설마」"},
{"id": "clse07:280200", "ko": "「그러니까, 단호히 거절한다고――」"},
{"id": "clse07:280300", "ko": "「뭐라고?」"},
{"id": "clse07:280400", "ko": "「자, 책상 주변을 정리하고 오늘 수업을 시작하지. 분명 방정식 이어서였지」"},
{"id": "clse07:280500", "ko": "「늘 있는 일이다. 내버려 둬」"},
{"id": "clse07:280600", "ko": "「흠, 그거면 OK다. 전부터 생각했는데, 네 응용력은 대단하군. 거기서부터는 혼자서 해를 구할 수 있겠지?」"},
{"id": "clse07:280700", "ko": "「좋아. 잘했다」"},
{"id": "clse07:280800", "ko": "「……… 그보다 저 녀석들, 아직도 하고 있었나」"},
{"id": "clse07:280900", "ko": "「뭐, 싸우면서 정든다고들 하지만」"},
{"id": "clse07:281000", "ko": "「벌써 이런 시간인가. 그럼 오늘은 여기까지 하지. 피자라도 시킬까?」"},
{"id": "clse07:281100", "ko": "「참나. 실컷 방해해 놓고 피자만은 먹을 생각인가, 저 녀석은……」"},
{"id": "clse07:281200", "ko": "「음?」"},
{"id": "clse07:281300", "ko": "「흠. 뭐 확실히…… 칭찬받을 만한 식생활은 아니군」"},
{"id": "clse07:281400", "ko": "「아니, 유토 말이 맞다. 사과할 필요 없어」"},
{"id": "clse07:281500", "ko": "「호오. 그건 좋은 마음가짐이군」"},
{"id": "clse07:281600", "ko": "「너희끼리만 기숙사에 남는다고 들었을 땐 걱정했다만. 잘 지내는 것 같아서 다행이다」"},
{"id": "clse07:281700", "ko": "「어?」"},
{"id": "clse07:281800", "ko": "「아, 아아…… 미안하군」"},
{"id": "clse07:281900", "ko": "「대단하군, 유토. 벌써 어엿한 셰프잖아」"},
{"id": "clse07:282000", "ko": "「……어?」"},
{"id": "clse07:282100", "ko": "「아니, 놀라게 해서 미안하다. 이렇게 호화로운 식사는 대체 몇 개월 만인가 싶어서 감동했어」"},
{"id": "clse07:282200", "ko": "「먹어도, 되나?」"},
{"id": "clse07:282300", "ko": "「아아, 알았다. ――잘 먹겠습니다」"},
{"id": "clse07:282400", "ko": "「응. 맛있어, 유토」"},
{"id": "clse07:282500", "ko": "「이 정도면 언젠가 야마조에뿐만 아니라 미나미사와 센리도 앞지를 수 있겠군」"},
{"id": "clse07:282600", "ko": "「그렇지 않아. 처음부터 무리라고 단정하면 안 돼」"},
{"id": "clse07:282700", "ko": "「이 내가 보증해 주지. 너라면 금방 실력이 늘 거다」"},
{"id": "clse07:282800", "ko": "「비밀? 아, 그건, 그…… 무리라고 생각하는 편이 좋을지도 모르겠군」"},
{"id": "clse07:282900", "ko": "「문은 열려 있다. 마음대로 들어와도 돼」"},
{"id": "clse07:283000", "ko": "「미안하군, 잠깐 동생을 빌리고 있다」"},
{"id": "clse07:283100", "ko": "「호오, 나는 실험대이자 시식 담당이었던 거군. 아주 잘 알겠어」"},
{"id": "clse07:283200", "ko": "「여기에 야마조에까지 있었으면 더 큰일이었겠군」"},
{"id": "clse07:283300", "ko": "「야마조에. 너는 존재감이 너무 옅다. 좀 더 진하게 해」"},
{"id": "clse07:283400", "ko": "「잠깐. 그건 깜빡한 내 잘못이다. 유토를 혼내지 말아 줘」"},
{"id": "clse07:283500", "ko": "「엇!? 아, 아니, 그렇지 않다, 음」"},
{"id": "clse07:283600", "ko": "「아, 아아, 물론」"},
{"id": "clse07:283700", "ko": "「응?」"},
{"id": "clse07:283800", "ko": "「아, 아니, 아무것도 아니다. 좀 귀찮은 녀석한테서 온 전화라서」"},
{"id": "clse07:283900", "ko": "「이 녀석한테서 연락이 올 때는 좋은 일이 없어」"},
{"id": "clse07:284000", "ko": "「정말 그렇군. 그보다, 이제 다시 만날 일은 없을 줄 알았는데」"},
{"id": "clse07:284100", "ko": "「나는 의사가 아니다. 진찰이라면 이 병원에서 얼마든지 할 수 있잖아」"}
]
