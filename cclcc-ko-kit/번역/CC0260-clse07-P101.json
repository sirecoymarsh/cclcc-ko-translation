[
{"id": "clse07:959500", "ko": "「……히나에 누나들은 저대로 둬도 괜찮아?」"},
{"id": "clse07:959600", "ko": "「아, 그렇구나. 혹시 이 식을 이쪽으로 가져오면 되는 건가? 그러면 양쪽이 같아지지?」"},
{"id": "clse07:959700", "ko": "「응. 그러니까, 여기가 이렇게 되니까…… 이 식을 대입해서……」"},
{"id": "clse07:959800", "ko": "「이게 답」"},
{"id": "clse07:959900", "ko": "「에헤헤」"},
{"id": "clse07:960000", "ko": "「괜찮을까」"},
{"id": "clse07:960100", "ko": "「그래? 그럼 다행이지만……」"},
{"id": "clse07:960200", "ko": "「아, 헤헤헤…… 배에서 꼬르륵 소리 났다」"},
{"id": "clse07:960300", "ko": "「저, 저기, 선생님?」"},
{"id": "clse07:960400", "ko": "「선생님 말야, 맨날 컵라면이나 편의점 도시락 같은 것만 먹잖아? 매일 그러면 몸에 별로 안 좋지 않을까 해서……」"},
{"id": "clse07:960500", "ko": "「……건방진 소리 해서 미안해요」"},
{"id": "clse07:960600", "ko": "「그래서 말야…… 그…… 나 요즘 우키 누나랑 같이 센리 누나한테 요리를 배우고 있어. 아오바 기숙사에서 센리 누나만 밥 당번이면 힘드니까」"},
{"id": "clse07:960700", "ko": "「응. 그래서 말야 그래서…… 으음……」"},
{"id": "clse07:960800", "ko": "「아, 아직 잘하진 못하지만…… 도시락을 만들어 왔어」"},
{"id": "clse07:960900", "ko": "「아, 물론 학교에서 한 번 집에 갔다가 새로 만들어 온 도시락이야. 아직 조금 따뜻하지만…… 전자레인지로 데울게」"},
{"id": "clse07:961000", "ko": "「아, 그런데 곤란하네. 히나에 누나가 올 줄은 몰라서 2인분밖에 안 만들어 왔어」"},
{"id": "clse07:961100", "ko": "「화해하는 거야?」"},
{"id": "clse07:961200", "ko": "「자, 기다렸지. 그러니까…… 실은 아직 별로 자신이 없어. 맛없으면 미안해요」"},
{"id": "clse07:961300", "ko": "「있잖아, 아직 할 줄 아는 레퍼토리가 적어서…… 이게 버섯 햄버그스테이크고. 이쪽은 다진 베이컨을 넣은 달걀말이」"},
{"id": "clse07:961400", "ko": "「그리고 닭고기랑 숙주랑 양배추 볶음. 숙주를 많이 넣으면 닭고기가 적어도 많아 보이거든. 에헤헤」"},
{"id": "clse07:961500", "ko": "「그리고 마지막으로, 남은 양배추를 두부랑 같이 샐러드로 만들어 왔습니다~」"},
{"id": "clse07:961600", "ko": "「아니, 그게 말야~! 우키 누나를 도저히 못 이기겠어~. 봐, 여기저기 탔고……」"},
{"id": "clse07:961700", "ko": "「와?! 저기, 저기?! 왜 그래?! 뭐 싫어하는 거라도 들어 있었어?!」"},
{"id": "clse07:961800", "ko": "「응? 그렇게 대단한 거 아니야~?」"},
{"id": "clse07:961900", "ko": "「응. 그러니까 더 이렇게 하는 게 좋다든가 말해 줘. 나, 우키 누나한테 꼭 이길 거니까」"},
{"id": "clse07:962000", "ko": "「……어, 어때?」"},
{"id": "clse07:962100", "ko": "「에이~? 그건 무리야~」"},
{"id": "clse07:962200", "ko": "「그럴…… 까」"},
{"id": "clse07:962300", "ko": "「정말?! 그럼 열심히 해 볼까. 그래도 센리 누나네한테는 비밀이야?」"},
{"id": "clse07:962400", "ko": "「응? 왜?」"},
{"id": "clse07:962500", "ko": "「응?」"},
{"id": "clse07:962600", "ko": "「우왓?」"},
{"id": "clse07:962700", "ko": "「지, 집에 가면 말하려고 했단 말야아」"},
{"id": "clse07:962800", "ko": "「무, 물론이지! 이건, 봐, 실험이랄까! 센리 누나한테 먹이기 전의 시식이랄까!」"},
{"id": "clse07:962900", "ko": "「에엣?! 아, 아, 아아 아니야! 시식이니 실험이니 거짓말! 그냥 한번 말해 본 거니까! 그것뿐이니까!」"},
{"id": "clse07:963000", "ko": "「우와아아~~?!」"},
{"id": "clse07:963100", "ko": "「그보다, 우키 누나까지 뭐 하러 온 거야~?」"},
{"id": "clse07:963200", "ko": "「앗, 그렇구나. 미안해요. 그만――」"},
{"id": "clse07:963300", "ko": "「선생님?」"},
{"id": "clse07:963400", "ko": "「타쿠루 형 돌아왔어?!」"},
{"id": "clse07:963500", "ko": "「타쿠루 형!!」"},
{"id": "clse07:963600", "ko": "「그치만…… 그치만, 계속 보고 싶었단 말야」"},
{"id": "clse07:963700", "ko": "「그래도…… 그래도……」"},
{"id": "clse07:963800", "ko": "「에헤헤, 타쿠루 형……」"},
{"id": "clse07:963900", "ko": "「안 돼, 유이 누나. 그런 말 하면 타쿠루 형 또 안 돌아오게 돼」"},
{"id": "clse07:964000", "ko": "「어라? 그러고 보니 유이 누나, 아까랑 입은 옷이 다르지?」"},
{"id": "clse07:964100", "ko": "「잘 먹겠습니다」"},
{"id": "clse07:964200", "ko": "「나랑 우키 누나도 도왔어. 그치, 우키 누나!」"},
{"id": "clse07:964300", "ko": "「맞아~. 유이 누나한테 맡기면 맨날 카레 아니면 스튜가 된다고~」"},
{"id": "clse07:964400", "ko": "「와아, 우키 누나, 살려 줘~」"},
{"id": "clse07:964500", "ko": "「잘 먹었습니다! 저기, 텔레비전 켜도 돼?」"},
{"id": "clse07:964600", "ko": "「그래도 봐, 오늘은 그게 있단 말야. 유이 누나도 보고 싶다고 했던……」"},
{"id": "clse07:964700", "ko": "「나도 깜짝 놀랐어」"},
{"id": "clse07:964800", "ko": "「나도 나도!!」"},
{"id": "clse07:964900", "ko": "「에이이이이」"},
{"id": "clse07:965000", "ko": "「네에~」"},
{"id": "clse07:965100", "ko": "「있잖아, 실은 나도 마술할 수 있어」"},
{"id": "clse07:965200", "ko": "「으음…… 설명하는 것보다 보여 주는 게 빠르려나?」"},
{"id": "clse07:965300", "ko": "「에헤헤, 분명 다들 놀랄 거야」"},
{"id": "clse07:965400", "ko": "「유이 누나, 도와줄래?」"},
{"id": "clse07:965500", "ko": "「그럼 이쪽으로 와」"},
{"id": "clse07:965600", "ko": "「영차……」"},
{"id": "clse07:965700", "ko": "「그럼, 누나. 이 안으로 들어가세요」"},
{"id": "clse07:965800", "ko": "「응」"},
{"id": "clse07:965900", "ko": "「자, 여러분. 보시는 바와 같이 이 상자 안에는 지금 유이 누나가 들어 있습니다. 그리고――」"},
{"id": "clse07:966000", "ko": "「지금부터 이 상자를 산산조각 내 보겠습니다~」"},
{"id": "clse07:966100", "ko": "「그럼, 갑니다~. 하나, 둘!」"},
{"id": "clse07:966200", "ko": "「뭐냐니, 그러니까 마술이라니까?」"},
{"id": "clse07:966300", "ko": "「그럼, 이쪽도 간다. 에잇」"},
{"id": "clse07:966400", "ko": "「왜?」"},
{"id": "clse07:966500", "ko": "「자, 이 산산조각 난 상자가, 놀랍게도. 원래대로――」"},
{"id": "clse07:966600", "ko": "「어라? 이상하다…… 원래대로 안 돌아와?」"},
{"id": "clse07:966700", "ko": "「왜? 왜 원래대로 안 돌아와?」"},
{"id": "clse07:966800", "ko": "「있잖아, 타쿠루 형! 왜?! 어째서 원래대로 안 돌아오는 거야?! 응!!」"},
{"id": "clse07:966900", "ko": "「에이이이이」"},
{"id": "clse07:967000", "ko": "「네에~」"},
{"id": "clse07:967100", "ko": "「잘 먹었습니다」"},
{"id": "clse07:967200", "ko": "「있잖아, 타쿠루 형! 카드놀이 하자, 카드놀이」"},
{"id": "clse07:967300", "ko": "「에이~. 모처럼 타쿠루 형이 돌아왔는데~」"},
{"id": "clse07:967400", "ko": "「치이~」"},
{"id": "clse07:967500", "ko": "「아직 이렇게 어린 아이인데, 너무해……」"},
{"id": "clse07:967600", "ko": "「와, 울기 시작했어. 왜 그러지?」"},
{"id": "clse07:967700", "ko": "「뭐어?!」"},
{"id": "clse07:967800", "ko": "「있잖아, 타쿠루 형」"},
{"id": "clse07:967900", "ko": "「타쿠루 형은…… 귀엽네」"},
{"id": "clse07:968000", "ko": "「있잖아, 타쿠루 형. 귀엽다」"},
{"id": "clse07:968100", "ko": "「어?! 그러니까…… 무슨 얘기야?」"},
{"id": "clse07:968200", "ko": "「아기. 귀엽다고……」"},
{"id": "clse07:968300", "ko": "「…………?」"},
{"id": "clse07:968400", "ko": "「? 센리 누나네, 무슨 얘기 하고 있었어?」"},
{"id": "clse07:968500", "ko": "「정말 가 버리는구나……」"},
{"id": "clse07:968600", "ko": "「응…… 그래도……」"},
{"id": "clse07:968700", "ko": "「응. 잘 지내, 히카리」"},
{"id": "clse07:968800", "ko": "「신난다~, 과자~!」"},
{"id": "clse07:968900", "ko": "「정말 가 버리는구나……」"},
{"id": "clse07:969000", "ko": "「응…… 그래도……」"},
{"id": "clse07:969100", "ko": "「응. 잘 지내, 히카리」"},
{"id": "clse07:969200", "ko": "「어라~? 타쿠루 형?!」"},
{"id": "clse07:969300", "ko": "「무슨 일이야? 돌아온 거야?」"},
{"id": "clse07:969400", "ko": "「왜?」"}
]
