[
{"id": "clse07:567300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:567400", "ko": "「……뭐?」"},
{"id": "clse07:567500", "ko": "「……재채기를 꽤 했었지」"},
{"id": "clse07:567600", "ko": "「너한테?」"},
{"id": "clse07:567700", "ko": "「거, 거절한다!」"},
{"id": "clse07:567800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:567900", "ko": "「네가 신경 안 써도 내가 신경 쓰인다고!?」"},
{"id": "clse07:568000", "ko": "「방금 아무렇지 않게 엄청난 소리 했지!?」"},
{"id": "clse07:568100", "ko": "「바, 바보야, 그만해!」"},
{"id": "clse07:568200", "ko": "「어떠냐니?」"},
{"id": "clse07:568300", "ko": "「뭐!?」"},
{"id": "clse07:568400", "ko": "「어?」"},
{"id": "clse07:568500", "ko": "「아갹!!」"},
{"id": "clse07:568600", "ko": "「……으응……」"},
{"id": "clse07:568700", "ko": "「……아얏」"},
{"id": "clse07:568800", "ko": "（욕실에서 머리를 부딪쳐서 기절했던 건가. 한심한 얘기군……）"},
{"id": "clse07:568900", "ko": "（영차……）"},
{"id": "clse07:569000", "ko": "（……목욕 가운을 입고 있어. 카즈키가 입혀 준 건가?）"},
{"id": "clse07:569100", "ko": "（카즈키인가? 그런데 누군가랑 얘기하고 있는 것 같은……?）"},
{"id": "clse07:569200", "ko": "（어떻게, 된 거지?）"},
{"id": "clse07:569300", "ko": "（뭐!?）"},
{"id": "clse07:569400", "ko": "（둘이서 대화하고 있다는 건가?）"},
{"id": "clse07:569500", "ko": "（이용하고 있다고? 무슨 소리지?）"},
{"id": "clse07:569600", "ko": "（……어?）"},
{"id": "clse07:569700", "ko": "（……뭐어!?）"},
{"id": "clse07:569800", "ko": "「아, 아니, 카즈키, 이건――」"},
{"id": "clse07:569900", "ko": "「카, 카즈키, 엿들은 건 미안해. 하지만――」"},
{"id": "clse07:570000", "ko": "「얘, 얘기를――」"},
{"id": "clse07:570100", "ko": "「카즈키! 기다려 줘!」"},
{"id": "clse07:570200", "ko": "「카즈키!」"},
{"id": "clse07:570300", "ko": "「……카, 카즈키?」"},
{"id": "clse07:570400", "ko": "「되찾아, 준 거구나」"},
{"id": "clse07:570500", "ko": "「……」"},
{"id": "clse07:570600", "ko": "「그러니까……」"},
{"id": "clse07:570700", "ko": "「아까 그 말……」"},
{"id": "clse07:570800", "ko": "「그러니까, 그건」"},
{"id": "clse07:570900", "ko": "「뭐라고 해야 하나,」"},
{"id": "clse07:571000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:571100", "ko": "「그러니까, 카즈키는」"},
{"id": "clse07:571200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:571300", "ko": "「……」"},
{"id": "clse07:571400", "ko": "「…………」"},
{"id": "clse07:571500", "ko": "「…………아,」"},
{"id": "clse07:571600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:571700", "ko": "「……」"},
{"id": "clse07:571800", "ko": "「……하아」"},
{"id": "clse07:571900", "ko": "「무슨 얼굴로 만나야 하는 거야……」"},
{"id": "clse07:572000", "ko": "「대체, 어떻게 된 거야?」"},
{"id": "clse07:572100", "ko": "「그 두 사람은, 대체 뭘 하고 싶은 거야?」"},
{"id": "clse07:572200", "ko": "「어, 뭐가?」"},
{"id": "clse07:572300", "ko": "「뭐야, 다들 왜 그래」"},
{"id": "clse07:572400", "ko": "「……어?」"},
{"id": "clse07:572500", "ko": "「무슨 소리야?」"},
{"id": "clse07:572600", "ko": "「그렇군, 다들 짜고 나를 함정에 빠뜨리려는 거지?」"},
{"id": "clse07:572700", "ko": "「어!? 어, 어떻게 하냐니……」"},
{"id": "clse07:572800", "ko": "「……」"},
{"id": "clse07:572900", "ko": "「……아무튼, 카즈키를 찾자」"},
{"id": "clse07:573000", "ko": "「미안. 다들, 도와줘!」"},
{"id": "clse07:573100", "ko": "「젠장, 어디 있는 거야……!」"},
{"id": "clse07:573200", "ko": "「메일? ……카즈키한테서다!」"},
{"id": "clse07:573300", "ko": "「시어터 큐브!」"},
{"id": "clse07:573400", "ko": "「여기다!」"},
{"id": "clse07:573500", "ko": "「읏!」"},
{"id": "clse07:573600", "ko": "「벌써 와 있으려나, 카즈키」"},
{"id": "clse07:573700", "ko": "「히앗!?」"},
{"id": "clse07:573800", "ko": "「카, 카즈키!?」"},
{"id": "clse07:573900", "ko": "「어?」"},
{"id": "clse07:574000", "ko": "「후왓!? 뭐, 뭐 하는 거야!?」"},
{"id": "clse07:574100", "ko": "「어, 방금 뭐라고 했어?」"},
{"id": "clse07:574200", "ko": "「뭐, 뭔데!?」"},
{"id": "clse07:574300", "ko": "「……읏!」"},
{"id": "clse07:574400", "ko": "「……후, 하하하」"},
{"id": "clse07:574500", "ko": "「아, 아무것도 아니야. 들어가자」"},
{"id": "clse07:574600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:574700", "ko": "「다들, 어제는 고마웠어. 덕분에 살았어. 그치?」"},
{"id": "clse07:574800", "ko": "「그래서, 실은 모두한테 알리고 싶은 게 있어서. 그치?」"},
{"id": "clse07:574900", "ko": "「굳이 알리는 것도 좀 그런가 싶지만, 다들 도와줬으니까――」"},
{"id": "clse07:575000", "ko": "「――응?」"},
{"id": "clse07:575100", "ko": "「저기, 다들――」"},
{"id": "clse07:575200", "ko": "「힉!!!」"},
{"id": "clse07:575300", "ko": "「히익!!!」"},
{"id": "clse07:575400", "ko": "「히이이이이이이익!!!!!!!!」"},
{"id": "clse07:575500", "ko": "「이이이이이, 이토!!!!!! 왜왜왜왜왜, 왜 네가 그걸 갖고 있는 거야!?」"},
{"id": "clse07:575600", "ko": "「그, 그치만 그건 내가 어제 회수――」"},
{"id": "clse07:575700", "ko": "「카카카카카, 카즈키, 이건 대체――?」"},
{"id": "clse07:575800", "ko": "「카, 카즈키!?」"},
{"id": "clse07:575900", "ko": "「엥!?」"},
{"id": "clse07:576000", "ko": "「카, 카즈키!」"},
{"id": "clse07:576100", "ko": "「아, 아니 이건」"},
{"id": "clse07:576200", "ko": "「아니, 그게 말이지」"},
{"id": "clse07:576300", "ko": "「그, 그러니까!」"},
{"id": "clse07:576400", "ko": "「이, 이토! 도와줘!」"},
{"id": "clse07:576500", "ko": "「거짓말이지!?」"},
{"id": "clse07:576600", "ko": "「끼야아아아아아아아아아아!!!!!!!」"},
{"id": "clse07:576700", "ko": "「어? 어디로?」"},
{"id": "clse07:576800", "ko": "「그, 그렇지 않아. 나에게는 위대한 사명이――」"},
{"id": "clse07:576900", "ko": "「네」"},
{"id": "clse07:577000", "ko": "「딱히……」"},
{"id": "clse07:577100", "ko": "「윽…… 학생회실이잖아」"},
{"id": "clse07:577200", "ko": "（어쩔 수 없지）"}
]
