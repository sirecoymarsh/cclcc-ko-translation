[
{"id": "clse07:447300", "ko": "「동아리는 뭐…… 적당히 해 줘. 그럼」"},
{"id": "clse07:447400", "ko": "「…………」"},
{"id": "clse07:447500", "ko": "「응?」"},
{"id": "clse07:447600", "ko": "「뭐 하고 있었어. 늦었잖……」"},
{"id": "clse07:447700", "ko": "「――!?」"},
{"id": "clse07:447800", "ko": "「이, 이토…… 왜 네가……!」"},
{"id": "clse07:447900", "ko": "「아, 아니…… 갑작스러워서 놀라서……」"},
{"id": "clse07:448000", "ko": "「뭐, 뭐야?」"},
{"id": "clse07:448100", "ko": "「왜, 왜?」"},
{"id": "clse07:448200", "ko": "「이, 이렇게 늦게 누구냐고 한 거야」"},
{"id": "clse07:448300", "ko": "「자, 잠깐 기다려!」"},
{"id": "clse07:448400", "ko": "「아, 아니…… 그런 게 아니라……」"},
{"id": "clse07:448500", "ko": "「뭐, 뭐야!?」"},
{"id": "clse07:448600", "ko": "「그러니까 뭐냐고, 아까부터!?」"},
{"id": "clse07:448700", "ko": "「아, 아아, 당연하지. 내, 내가 이 방에 여자를 끌어들일 리가 있겠냐」"},
{"id": "clse07:448800", "ko": "「그, 그래. 나한테 그런 일이 있을 리가 없잖아」"},
{"id": "clse07:448900", "ko": "「……뭐야?」"},
{"id": "clse07:449000", "ko": "「……너랑 똑같이 취급하지 마. 그런 거 아니야」"},
{"id": "clse07:449100", "ko": "「응?」"},
{"id": "clse07:449200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:449300", "ko": "「아, 아니! 빵…… 이라도 먹을까〜 해서」"},
{"id": "clse07:449400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:449500", "ko": "「아〜! 그…… 괜히 편의점 빵이 먹고 싶네〜, 라든가……」"},
{"id": "clse07:449600", "ko": "「그, 그럼 나는 빵 사러 갈 테니까, 이토도 슬슬……」"},
{"id": "clse07:449700", "ko": "「아니, 그래도 나도 집을 비우니까」"},
{"id": "clse07:449800", "ko": "「어?」"},
{"id": "clse07:449900", "ko": "「이, 이토!!!」"},
{"id": "clse07:450000", "ko": "「아…………」"},
{"id": "clse07:450100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:450200", "ko": "「미, 미안」"},
{"id": "clse07:450300", "ko": "「그, 그건……」"},
{"id": "clse07:450400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:450500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:450600", "ko": "「부, 부탁이야, 이토! 이 일 아무한테도 말하지 마!」"},
{"id": "clse07:450700", "ko": "「으, 응……」"},
{"id": "clse07:450800", "ko": "「…………」"},
{"id": "clse07:450900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:451000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:451100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:451200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:451300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:451400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:451500", "ko": "「아, 안 돼!」"},
{"id": "clse07:451600", "ko": "「이, 이토……」"},
{"id": "clse07:451700", "ko": "「아, 아니야…… 나는……」"},
{"id": "clse07:451800", "ko": "「어……?」"},
{"id": "clse07:451900", "ko": "「거짓말…… 이지?」"},
{"id": "clse07:452000", "ko": "「다 같이?」"},
{"id": "clse07:452100", "ko": "「신조 씨? 그리고……」"},
{"id": "clse07:452200", "ko": "「자, 잠깐만. 이게 어떻게 된 거야!?」"},
{"id": "clse07:452300", "ko": "「아, 아니! 나는 그런 취미 없어――!」"},
{"id": "clse07:452400", "ko": "「아니에요! 그건――」"},
{"id": "clse07:452500", "ko": "「겐 씨!?」"},
{"id": "clse07:452600", "ko": "「히이이익!」"},
{"id": "clse07:452700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:452800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:452900", "ko": "「어? 아, 아아, 미안! 좀 발이 걸려서!!」"},
{"id": "clse07:453000", "ko": "「그럴 줄 알았다니?」"},
{"id": "clse07:453100", "ko": "「응? 아아, 그렇군. 그럼 잘 가」"},
{"id": "clse07:453200", "ko": "「그래. 그보다……」"},
{"id": "clse07:453300", "ko": "「…………!」"},
{"id": "clse07:453400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:453500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:453600", "ko": "「아, 아리무라! 언제 돌아왔어!?」"},
{"id": "clse07:453700", "ko": "「그, 그런가……」"},
{"id": "clse07:453800", "ko": "「어? 아〜 아니, 그건 그러니까……!!」"},
{"id": "clse07:453900", "ko": "「아, 아니야!! 이건 그러니까――!」"},
{"id": "clse07:454000", "ko": "「엥? 곱창 밴드……?」"},
{"id": "clse07:454100", "ko": "「아, 그래…… 곱창 밴드…… 그렇구나……」"},
{"id": "clse07:454200", "ko": "「저기, 아직이야?」"},
{"id": "clse07:454300", "ko": "「오오……」"},
{"id": "clse07:454400", "ko": "「……뭐…… 조금은……」"},
{"id": "clse07:454500", "ko": "「그나저나 무슨 바람이 분 거야?」"},
{"id": "clse07:454600", "ko": "「응. 맛있어」"},
{"id": "clse07:454700", "ko": "「이 수프도 꽤 괜찮네」"},
{"id": "clse07:454800", "ko": "「이 납작한 미트소스 스파게티도」"},
{"id": "clse07:454900", "ko": "「다 그냥 맛있어」"},
{"id": "clse07:455000", "ko": "「역시 쿠루스한테는 못 미치지만……」"},
{"id": "clse07:455100", "ko": "「뭐, 뭐 쿠루스는 매일 집에서 가족들 몫까지 만드니까, 그거랑 비교할 필요는 없지 않나」"},
{"id": "clse07:455200", "ko": "「그래도 놀랐어」"},
{"id": "clse07:455300", "ko": "「뭐, 그렇지」"},
{"id": "clse07:455400", "ko": "「다른 애라면 그렇게 하겠지만, 아리무라한테는 거짓말해도 들키잖아」"},
{"id": "clse07:455500", "ko": "「…………」"},
{"id": "clse07:455600", "ko": "「바보」"},
{"id": "clse07:455700", "ko": "「뭐야, 이거……?」"},
{"id": "clse07:455800", "ko": "「뭐?」"},
{"id": "clse07:455900", "ko": "「아니아니아니, 그건 곤란하지 않아?」"},
{"id": "clse07:456000", "ko": "「무슨…… 소리야?」"},
{"id": "clse07:456100", "ko": "「애초에 가출 같은 거 그만두고 집에 돌아가면 되는 거 아냐?」"},
{"id": "clse07:456200", "ko": "「왜!?」"},
{"id": "clse07:456300", "ko": "「애초에 말해 두지만 나는――」"},
{"id": "clse07:456400", "ko": "「뭐야, 이거?」"},
{"id": "clse07:456500", "ko": "「일부러는 무슨. 감사고 뭐고, 전부 자기를 위해서잖아」"},
{"id": "clse07:456600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:456700", "ko": "「이게 뭐야아아아아!!」"},
{"id": "clse07:456800", "ko": "「누가 결혼한다는 거야, 누가!!」"},
{"id": "clse07:456900", "ko": "「농담하지 마! 이런 건 나는 절대 사양이야!」"},
{"id": "clse07:457000", "ko": "「…………」"},
{"id": "clse07:457100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:457200", "ko": "", "note": "보류 — 연애 묘사"}
]
