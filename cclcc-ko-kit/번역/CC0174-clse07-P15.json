[
{"id": "clse07:137800", "ko": "「왜냐니, 부실에 왔더니 놓여 있었다고」"},
{"id": "clse07:137900", "ko": "「아, 나 호출받았었지. 그럼 간다, 나머지는 힘내라」"},
{"id": "clse07:138000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:138100", "ko": "「미야시로오오……」"},
{"id": "clse07:138200", "ko": "「모처럼 신경 써서 네 몫의 빵도 사 왔는데, 그런 나를 제쳐 두고 혼자서 여자애가 손수 만든 베이글이라고오?」"},
{"id": "clse07:138300", "ko": "「여자애 요리로 죽을 수 있다면 소원 성취지!」"},
{"id": "clse07:138400", "ko": "「괜찮다고! 일단은이라지만 오노에도 아리무라도 여자는 여자야!」"},
{"id": "clse07:138500", "ko": "「그럼 나한테! 미야시로 몫의 베이글도 이 비천한 저에게 주시겠습니까!?」"},
{"id": "clse07:138600", "ko": "「노오오오오오오오오오!!!」"},
{"id": "clse07:138700", "ko": "「이렇게 된 이상 사 온 빵 전부 먹어 주마! 햄 샌드위치도 달걀 샌드위치도 전부 먹어 버릴 테니까!!」"},
{"id": "clse07:138800", "ko": "「욱…… 큰일이다…… 괴로워. 못 움직이겠어……」"},
{"id": "clse07:138900", "ko": "「……아, 그러고 보니 아까 교실 밖에 부부장이 있던데, 그거 뭐였을까……」"},
{"id": "clse07:139000", "ko": "「그래. 뭔가 봉투 같은 걸 들고 있던데……」"},
{"id": "clse07:139100", "ko": "「미야시로오~. 부실 갈 거지?」"},
{"id": "clse07:139200", "ko": "「뭐? 진짜? 무슨 바람이 분 거야?」"},
{"id": "clse07:139300", "ko": "「아니, 네가 갑자기 그런 소리를 하다니, 뭔가 꿍꿍이가 있는 게 틀림없어」"},
{"id": "clse07:139400", "ko": "「정말이냐~? 음, 그렇다면……」"},
{"id": "clse07:139500", "ko": "「아니아니, 미야시로는 맨날 이런 느낌이잖아」"},
{"id": "clse07:139600", "ko": "「뭐였던 거야, 저건?」"},
{"id": "clse07:139700", "ko": "「뭐, 신경 쓰지 마. 그보다 가자. 주스다 주스」"},
{"id": "clse07:139800", "ko": "「뭐냐니…… 사 줄 거잖아?」"},
{"id": "clse07:139900", "ko": "「뭐! 너……」"},
{"id": "clse07:140000", "ko": "「아니아니아니, 네가 사 준다고 했잖아」"},
{"id": "clse07:140100", "ko": "「노망났냐? 할아버지냐?」"},
{"id": "clse07:140200", "ko": "「누가 할아버지야!」"},
{"id": "clse07:140300", "ko": "「기다려, 오노에! 누가 왔어!!」"},
{"id": "clse07:140400", "ko": "「그래, 미야시로. 게다가 이건 엿듣기가 아니야. 조사다」"},
{"id": "clse07:140500", "ko": "「그 카와하라 말이야. 또 우리한테 뭔가 보란 듯이 굴 생각일지도 몰라. 그러니까 이건 엄연한 조사라고」"},
{"id": "clse07:140600", "ko": "「부부장이 카와하라한테 도시락? 무슨 일이야?」"},
{"id": "clse07:140700", "ko": "「하아~……」"},
{"id": "clse07:140800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:140900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:141000", "ko": "「뭐, 본인은 전혀 모르는 것 같았지만」"},
{"id": "clse07:141100", "ko": "「오, 오우!」"},
{"id": "clse07:141200", "ko": "「아, 나도 나도!!」"},
{"id": "clse07:141300", "ko": "「아, 미야시로!」"},
{"id": "clse07:141400", "ko": "「봤냐, 그 벽보. 농담이 아니라고. 웃기지 말라 그래」"},
{"id": "clse07:141500", "ko": "「응? 너, 설마 모르는 거냐?」"},
{"id": "clse07:141600", "ko": "「그렇지~. 그나저나 아~ 진짜 열받아! 그런 게 통과될까 보냐」"},
{"id": "clse07:141700", "ko": "「응? 뭐야?」"},
{"id": "clse07:141800", "ko": "「뭐야? 알고 있었던 거 아니냐?」"},
{"id": "clse07:141900", "ko": "「아아, 그렇게 쓰여 있었잖아? 어라? 미야시로. 너 혹시……」"},
{"id": "clse07:142000", "ko": "「우와…… 그야말로 여제 같은 느낌이네……」"},
{"id": "clse07:142100", "ko": "「대단하네, 그 녀석. 나였으면 지렸을 거야」"},
{"id": "clse07:142200", "ko": "「그렇다고 연애 금지라니 이상하잖아요」"},
{"id": "clse07:142300", "ko": "「그래요. 여자 친구가 생길 가능성이 전무한 내가…… 잠깐, 뭐라고, 아리무라!」"},
{"id": "clse07:142400", "ko": "「그런 고로, 이번 신문은 학생회가 내건 『교내 연애 금지령』에 이의를 제기하는 걸로 하고 싶은데」"},
{"id": "clse07:142500", "ko": "「다들 의견은 어때?」"},
{"id": "clse07:142600", "ko": "「미야시로는 당연히 찬성이니까 만장일치로 괜찮지?」"},
{"id": "clse07:142700", "ko": "「좋아, 그럼――」"},
{"id": "clse07:142800", "ko": "「왜 그래, 부부장? 설마…… 안 된다고 하는 건 아니겠지?」"},
{"id": "clse07:142900", "ko": "「거 봐 거 봐! 공평하게라니 번지르르한 소리 하니까 가결돼 버렸잖아!! 어떻게 할 거야!」"},
{"id": "clse07:143000", "ko": "「아아아, 이걸로 내 장밋빛 학원 생활에 대한 희망은 끊겨 버렸다~!」"},
{"id": "clse07:143100", "ko": "「뭐, 은근히 그 녀석 남자들한테 인기 있으니까……」"},
{"id": "clse07:143200", "ko": "「그 교칙이 가결돼서 어떻게 되나 했는데, 별로 달라진 건 없네」"},
{"id": "clse07:143300", "ko": "「큭…… 그건 그거대로 뭔가 열받지만」"},
{"id": "clse07:143400", "ko": "「뭔가 괜히 떠들어서 손해 본 느낌」"},
{"id": "clse07:143500", "ko": "「아아, 그러고 보니 너 다음엔 언제 집에 가냐? 일주일에 한 번은 가기로 약속했다며?」"},
{"id": "clse07:143600", "ko": "「어제 우연히 유이를 만났거든. 집에 오라고 전해 달래」"},
{"id": "clse07:143700", "ko": "「가끔은 귀여운 여동생 부탁 좀 제대로 들어줘」"},
{"id": "clse07:143800", "ko": "「뭐야?」"},
{"id": "clse07:143900", "ko": "「어, 어떻게든이라니, 무슨 소리야?」"},
{"id": "clse07:144000", "ko": "「바, 바보! 나한테는 그런 취미 없다니까」"},
{"id": "clse07:144100", "ko": "「그렇게 소중하면 상자에라도 넣어서 넣어 둬. 그보다 좀 더 소중히 해 줘」"},
{"id": "clse07:144200", "ko": "「아~ 그렇게 해 그렇게 해」"},
{"id": "clse07:144300", "ko": "「우와, 진짜 아기가 있잖아. 대박」"},
{"id": "clse07:144400", "ko": "「헤헷. 미야시로가 몰래 돌아가려고 하길래 다 같이 뒤를 밟아 왔지」"},
{"id": "clse07:144500", "ko": "「야, 이 애 여자애냐?」"},
{"id": "clse07:144600", "ko": "", "note": "보류 — 아동 대상 연애 농담"},
{"id": "clse07:144700", "ko": "「어……?」"},
{"id": "clse07:144800", "ko": "「아, 아니야, 농담! 농담이라니까!」"},
{"id": "clse07:144900", "ko": "「으아아아아아아아아아, 아니야아아아아아, 믿어 줘어어어어어!!」"},
{"id": "clse07:145000", "ko": "「내 탓이냐!? 내 탓인 거냐?」"},
{"id": "clse07:145100", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:145200", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse07:145300", "ko": "「미야시로. 카와하라가 뭐래?」"},
{"id": "clse07:145400", "ko": "「그치만 나도 그 녀석 껄끄럽고. 그래서? 무슨 얘기였어?」"},
{"id": "clse07:145500", "ko": "「그래. 부부장은 오늘도?」"},
{"id": "clse07:145600", "ko": "「알~겠어」"},
{"id": "clse07:145700", "ko": "「연애 금지령 말이지. 결국 시끄러웠던 건 처음 며칠뿐이었네」"},
{"id": "clse07:145800", "ko": "「여, 미야시로. 오늘 동아리는……」"},
{"id": "clse07:145900", "ko": "「참 나, 뭐야, 이제부터 방과 후라는 때에」"},
{"id": "clse07:146000", "ko": "「그렇다는 건 부부장도 모른다는 건가」"},
{"id": "clse07:146100", "ko": "「웃기지 마!」"},
{"id": "clse07:146200", "ko": "「미야시로가 그런 짓을 할 리가 없잖아! 그렇지, 미야시로?」"},
{"id": "clse07:146300", "ko": "「⟦rb⟧미야시로⟦rt⟧이 녀석⟦/r⟧이 여자애랑 사귀는 것만이 아니라 애까지 있다고? 그럴 리가 없잖아!」"},
{"id": "clse07:146400", "ko": "「알겠어? 미야시로는 말이야, 그런 짓을 할 수 있을 만큼 인기 있는 녀석이 아니라고!」"},
{"id": "clse07:146500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:146600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:146700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:146800", "ko": "「아, 아무튼 미야시로는 그런 녀석이 아니야! 자, 아리무라! 너도 뭐라고 말 좀 해 봐……」"},
{"id": "clse07:146900", "ko": "「그래도 말이야, 요컨대 같이 산다는 그 애를 데려오기만 하면 되는 거잖아? 그럼 얘기는 빠르잖아」"},
{"id": "clse07:147000", "ko": "「뭐야, 둘 다 심각한 얼굴을 하고. 데려올 수 있잖아?」"},
{"id": "clse07:147100", "ko": "「뭐? 왜?」"},
{"id": "clse07:147200", "ko": "「사정이라니…… 그런 소리 할 때냐. 이쪽도 큰일 난 상황이잖아」"},
{"id": "clse07:147300", "ko": "「이유는? 우리한테도 말 못 하는 거냐?」"}
]
