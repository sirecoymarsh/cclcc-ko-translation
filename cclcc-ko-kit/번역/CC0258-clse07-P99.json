[
{"id": "clse07:939500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:939600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:939700", "ko": "「어라?」"},
{"id": "clse07:939800", "ko": "「방금 타쿠루…… 부르르 떨었어. 혹시 쉬 마려운가?」"},
{"id": "clse07:939900", "ko": "「자, 쉬는 거기서 하는 거야?」"},
{"id": "clse07:940000", "ko": "「자. 쉬~, 쉬~……」"},
{"id": "clse07:940100", "ko": "「와. 엄청 나온다…… 대단해~」"},
{"id": "clse07:940200", "ko": "「왜 그래, 타쿠루 오빠? 얼굴 빨개?」"},
{"id": "clse07:940300", "ko": "「…………?」"},
{"id": "clse07:940400", "ko": "「잠깐만, 노노 언니」"},
{"id": "clse07:940500", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:940600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:940700", "ko": "「흐응. 그렇게 협박하면 따를 거라고 생각하는 거지?」"},
{"id": "clse07:940800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:940900", "ko": "「타쿠루 오빠는 가만있어!」"},
{"id": "clse07:941000", "ko": "「유……」"},
{"id": "clse07:941100", "ko": "「나눠 갖자고……?」"},
{"id": "clse07:941200", "ko": "「나도 유 의견에 찬성일지도」"},
{"id": "clse07:941300", "ko": "「그럼 난 머리 쪽이 좋겠다」"},
{"id": "clse07:941400", "ko": "「그럼, 노노 언니 부탁해……」"},
{"id": "clse07:941500", "ko": "「하나, 둘!」"},
{"id": "clse07:941600", "ko": "「〜〜〜〜♪」"},
{"id": "clse07:941700", "ko": "「타쿠루 오빠, 다녀왔어」"},
{"id": "clse07:941800", "ko": "「타쿠루 오빠…… 괜찮아? 안색이 안 좋아 보이는데?」"},
{"id": "clse07:941900", "ko": "「후훗」"},
{"id": "clse07:942000", "ko": "「잘~ 먹겠습니다~!」"},
{"id": "clse07:942100", "ko": "「덥석…… 우물, 냠…… 음!」"},
{"id": "clse07:942200", "ko": "「응? 아하하, 한창 클 때니까! 그치~?」"},
{"id": "clse07:942300", "ko": "「천천히? 왜?」"},
{"id": "clse07:942400", "ko": "「음…… 그렇구나, 알겠어」"},
{"id": "clse07:942500", "ko": "「그러니까…… 천천히라는 건, 깨물지 않는 게 좋다는 거지?」"},
{"id": "clse07:942600", "ko": "", "note": "보류 — 성적 묘사(미성년 인물 둘이 아이스크림을 핥는 성적 암시 장면 942600~943500)"},
{"id": "clse07:942700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:942800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:942900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:943000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:943100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:943200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:943300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:943400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:943500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:943600", "ko": "「우~……」"},
{"id": "clse07:943700", "ko": "「그러니까, 다음은…… 오른손을 빨강에……」"},
{"id": "clse07:943800", "ko": "「어때? 될 것 같아?」"},
{"id": "clse07:943900", "ko": "「유, 유…… 빨리~. 이 자세, 힘들……」"},
{"id": "clse07:944000", "ko": "「그, 그럼 다음, 부탁해요……!」"},
{"id": "clse07:944100", "ko": "「뭐어…… 왼쪽? 초록이라니…… 그런 거 무리~……」"},
{"id": "clse07:944200", "ko": "「어? 이쪽이라니……?」"},
{"id": "clse07:944300", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:944400", "ko": "「유, 유 발이 옆구리에 닿아서…… 간지러……」"},
{"id": "clse07:944500", "ko": "「아! 잠깐, 유! 아직 움직이지 마……!」"},
{"id": "clse07:944600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:944700", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:944800", "ko": "「있잖아, 유. 우리끼리 니야생 해 보지 않을래?」"},
{"id": "clse07:944900", "ko": "「응. 우리 맨날 타쿠루 오빠한테만 기대잖아? 그것도 미안하달까」"},
{"id": "clse07:945000", "ko": "「그러니까 가끔은 우리 힘으로 할 수 있는 것도 하는 게 좋을 것 같아」"},
{"id": "clse07:945100", "ko": "「어때, 유? 해 보고 싶지 않아?」"},
{"id": "clse07:945200", "ko": "「신난다! 그럼 오늘은 둘이서 생방송 해 버리자!」"},
{"id": "clse07:945300", "ko": "「안녕하세요! 『밀푀유』 유이예요」"},
{"id": "clse07:945400", "ko": "「리퀘스트라~…… 음, 어떡할래, 유?」"},
{"id": "clse07:945500", "ko": "「교복 차림? 보고 싶어? 음, 괜찮긴 한데」"},
{"id": "clse07:945600", "ko": "「그런데 교복 차림으로 뭘 하면 돼?」"},
{"id": "clse07:945700", "ko": "", "note": "보류 — 성적 묘사(미성년, 원래 장면 clyu08:2800)"},
{"id": "clse07:945800", "ko": "「어떡할래, 유?」"},
{"id": "clse07:945900", "ko": "", "note": "보류 — 성적 묘사(미성년, 원래 장면 clyu08:3100)"},
{"id": "clse07:946000", "ko": "「알았어. 그럼 잠깐만 기다려 줘」"},
{"id": "clse07:946100", "ko": "「『알았어. 그럼 잠깐만 기다려 줘』」"},
{"id": "clse07:946200", "ko": "「『그럼 시작할게』」"},
{"id": "clse07:946300", "ko": "「『꺅! 차가워~!』」"},
{"id": "clse07:946400", "ko": "「『음, 이 정도 온도면 딱 좋으려나? 그럼…… 에잇!!』」"},
{"id": "clse07:946500", "ko": "「『했겠다~! 나도 반격이다~!』」"},
{"id": "clse07:946600", "ko": "「『어, 어라? 유…… 뭔가 이상해?』」"},
{"id": "clse07:946700", "ko": "", "note": "보류 — 성적 묘사(미성년 인물의 노출, 원문은 『 를 닫지 않음)"},
{"id": "clse07:946800", "ko": "", "note": "보류 — 성적 묘사(미성년 인물의 노출)"},
{"id": "clse07:946900", "ko": "「『어떡해~, 우키! 어떻게 하면 좋아?』」"},
{"id": "clse07:947000", "ko": "「잘못했어……」"},
{"id": "clse07:947100", "ko": "「있잖아, 타쿠루 오빠…… 우리 어떻게 되는 걸까?」"},
{"id": "clse07:947200", "ko": "「그렇구나……」"},
{"id": "clse07:947300", "ko": "「말도 안 돼……」"},
{"id": "clse07:947400", "ko": "「나는 슬슬 노선을 바꾸는 게 좋지 않을까 싶어」"},
{"id": "clse07:947500", "ko": "「어라? 나 뭐 이상한 말 했어?」"},
{"id": "clse07:947600", "ko": "「음~, 그건 그…… 우리가 목표로 하는 건 아이돌이잖아?」"},
{"id": "clse07:947700", "ko": "「물론 보는 사람들 요청에 응하는 것도 중요하다고는 생각하지만……」"},
{"id": "clse07:947800", "ko": "「그래도 지금까지 하던 방송을 계속해 봤자 점점 심해지기만 하지 않을까 해서」"},
{"id": "clse07:947900", "ko": "「아이돌로 활동해 나가려면 분명 어느 시점에선가 방향을 바꿔야 하는 거고……」"},
{"id": "clse07:948000", "ko": "「그렇다면 마침 주목받고 있는 지금이 그 기회가 아닐까 해서……」"},
{"id": "clse07:948100", "ko": "「어라? 나 뭔가 이상한 말 해 버렸어?」"},
{"id": "clse07:948200", "ko": "「정말?」"},
{"id": "clse07:948300", "ko": "「에헤헤」"},
{"id": "clse07:948400", "ko": "「야호~. 여러분, 안녕하세요~, 『밀푀유』 유이예요~」"},
{"id": "clse07:948500", "ko": "「그러고 보니, 이제 곧 크리스마스네~」"},
{"id": "clse07:948600", "ko": "「히얏!」"},
{"id": "clse07:948700", "ko": "「미안해, 타쿠루 오빠……」"},
{"id": "clse07:948800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:948900", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:949000", "ko": "「꺅!!」"},
{"id": "clse07:949100", "ko": "「있잖아, 타쿠루 오빠……」"},
{"id": "clse07:949200", "ko": "「나 있지…… 타쿠루 오빠가 오빠가 되어 줘서 다행이야……」"},
{"id": "clse07:949300", "ko": "「응……」"},
{"id": "clse07:949400", "ko": "「응……」"}
]
