[
{"id": "clse07:764400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:764500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:764600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:764700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:764800", "ko": "「그렇지~」"},
{"id": "clse07:764900", "ko": "「그러네!」"},
{"id": "clse07:765000", "ko": "「……」"},
{"id": "clse07:765100", "ko": "「타쿠, 최악」"},
{"id": "clse07:765200", "ko": "「최악!」"},
{"id": "clse07:765300", "ko": "「있잖아, 타쿠」"},
{"id": "clse07:765400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:765500", "ko": "「맞아, 타쿠」"},
{"id": "clse07:765600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:765700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:765800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:765900", "ko": "「타쿠~?」"},
{"id": "clse07:766000", "ko": "「아, 찾았다 찾았다. 타쿠~!」"},
{"id": "clse07:766100", "ko": "「타쿠랑 히나는 정말 사이좋다니까~」"},
{"id": "clse07:766200", "ko": "「거 봐~, 엄청 사이좋잖아」"},
{"id": "clse07:766300", "ko": "「에헤헤~. 실은 말이야, 오전 수업에서 베이글 만들었거든~」"},
{"id": "clse07:766400", "ko": "「그래서 말이야, 잔뜩 만들어서 타쿠한테도 줄까~ 하고 가져왔어」"},
{"id": "clse07:766500", "ko": "「응?」"},
{"id": "clse07:766600", "ko": "「어? 잠깐, 히나?」"},
{"id": "clse07:766700", "ko": "「봐, 히나가 구운 베이글, 맛있어 보이지~」"},
{"id": "clse07:766800", "ko": "「응? 내 건 말이야~…… 이거」"},
{"id": "clse07:766900", "ko": "「오케이」"},
{"id": "clse07:767000", "ko": "「있잖아, 타쿠. 여자애의 호의는 순순히 받아야 하는 거야? 그러니까……」"},
{"id": "clse07:767100", "ko": "「잔뜩 있으니까 많이 먹어, 타쿠」"},
{"id": "clse07:767200", "ko": "「어라? 있잖아, 히나. 타쿠 상태가……」"},
{"id": "clse07:767300", "ko": "「타쿠! 정신 차려, 타쿠!! 타쿠야~!!」"},
{"id": "clse07:767400", "ko": "「큰일 날 뻔했네~, 타쿠」"},
{"id": "clse07:767500", "ko": "「아, 미안, 신지. 베이글 이제 없어」"},
{"id": "clse07:767600", "ko": "「그렇게 잔뜩 먹으니까 그렇지~」"},
{"id": "clse07:767700", "ko": "「음~. 그럼 노노는 뭐 하러 온 걸까?」"},
{"id": "clse07:767800", "ko": "「학생회 일도 있으니까 어쩔 수 없지」"},
{"id": "clse07:767900", "ko": "「그래서? 노노는 뭐래?」"},
{"id": "clse07:768000", "ko": "「굳이 전화까지 할 필요는 없는데」"},
{"id": "clse07:768100", "ko": "「불러 볼까. 어이~, 노노――」"},
{"id": "clse07:768200", "ko": "「무슨 얘기 하는 걸까?」"},
{"id": "clse07:768300", "ko": "「있잖아 있잖아, 타쿠! 이거 혹시~……」"},
{"id": "clse07:768400", "ko": "「하아~……」"},
{"id": "clse07:768500", "ko": "「그건 그렇고 놀랐네~」"},
{"id": "clse07:768600", "ko": "「왜? 노노는 귀엽고 성격도 좋고 집안일도 뭐든 척척 해내는 멋진 여자애잖아?」"},
{"id": "clse07:768700", "ko": "「아, 노노! 아까 그――!!」"},
{"id": "clse07:768800", "ko": "「응? 읍~, 음후~!!」"},
{"id": "clse07:768900", "ko": "「하아~…… 정말, 뭐 하는 거야 타쿠~」"},
{"id": "clse07:769000", "ko": "「에~, 왜~?」"},
{"id": "clse07:769100", "ko": "「무우~」"},
{"id": "clse07:769200", "ko": "「어? 그러니까, 나는, 나는…… 집에 가서 만화 읽어야 해!」"},
{"id": "clse07:769300", "ko": "「왜 발돋움하고 있어, 타쿠?」"},
{"id": "clse07:769400", "ko": "「아, 너무하지~, 그 벽보. 교내 연애 금지령이라니, 너무 횡포야~」"},
{"id": "clse07:769500", "ko": "「그래도 학생회 제안이라는 건 노노도 알고 있는 걸까~?」"},
{"id": "clse07:769600", "ko": "「있잖아, 타쿠. 저기…… 노노」"},
{"id": "clse07:769700", "ko": "「노노의 그런 무서운 얼굴, 처음 봤어……」"},
{"id": "clse07:769800", "ko": "「나는 타쿠가 괜찮다면……」"},
{"id": "clse07:769900", "ko": "「깜짝 놀랐네~」"},
{"id": "clse07:770000", "ko": "「그러고 보니 부회장이 됐을 때 표도 거의 남자애들이었다는 얘기잖아~」"},
{"id": "clse07:770100", "ko": "「노노, 괜찮을까~?」"},
{"id": "clse07:770200", "ko": "「미안해~, 노노」"},
{"id": "clse07:770300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:770400", "ko": "「신지……」"},
{"id": "clse07:770500", "ko": "「와앗! 신지가 큰 소리 내서 울어 버렸잖아~」"},
{"id": "clse07:770600", "ko": "「오오오, 왠지 완전 엄마 같네, 노노」"},
{"id": "clse07:770700", "ko": "「그렇지 않아~. 노노는 너그럽고, 꽤 좋은 엄마가 될 것 같은데~」"},
{"id": "clse07:770800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:770900", "ko": "「아, 타쿠. 긴급 집회가 뭘까~?」"},
{"id": "clse07:771000", "ko": "「좋아, 신지! 말해 줘, 말해 줘!!」"},
{"id": "clse07:771100", "ko": "「노노……」"},
{"id": "clse07:771200", "ko": "「아, 타쿠. 역시 여기 있었구나~」"},
{"id": "clse07:771300", "ko": "「타쿠가 생각하는 것 정도는 알아……」"},
{"id": "clse07:771400", "ko": "「있잖아, 타쿠. 타쿠는 말 안 할 거야? 사실을」"},
{"id": "clse07:771500", "ko": "「……노노에 대해서」"},
{"id": "clse07:771600", "ko": "「왜?」"},
{"id": "clse07:771700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:771800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:771900", "ko": "「그렇구나……」"},
{"id": "clse07:772000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:772100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:772200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:772300", "ko": "「그래도 그게 타쿠가 바라는 거라면, 나는 반대 안 해」"},
{"id": "clse07:772400", "ko": "「친구…… 라」"},
{"id": "clse07:772500", "ko": "「에헤헤~. 왠지 그런 거, 새삼 들으니까 쑥스럽다」"},
{"id": "clse07:772600", "ko": "「아~. 타쿠, 빨개졌어?」"},
{"id": "clse07:772700", "ko": "「헤헷. 그래도…… 응, 왠지 안심했어. 역시 타쿠는 타쿠구나 싶어서」"},
{"id": "clse07:772800", "ko": "「으응. 그럼 힘내, 응원할게」"},
{"id": "clse07:772900", "ko": "「노노. 잠깐만 여기서 기다려 줘」"},
{"id": "clse07:773000", "ko": "「……노노에 대해서」"},
{"id": "clse07:773100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:773200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:773300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:773400", "ko": "「들었어?」"},
{"id": "clse07:773500", "ko": "「그렇대」"},
{"id": "clse07:773600", "ko": "「갈까」"},
{"id": "clse07:773700", "ko": "「잘 말했어, 타쿠!!」"},
{"id": "clse07:773800", "ko": "「타쿠 말이 맞아. 노노…… 가 아니라, 센리는 언제나 모두를 생각했어. 그건 틀림없는 사실인걸」"},
{"id": "clse07:773900", "ko": "「응? 음~, 그런 거 아냐?」"},
{"id": "clse07:774000", "ko": "「한 방이라니?」"},
{"id": "clse07:774100", "ko": "「워워워, 신지 진정해」"},
{"id": "clse07:774200", "ko": "「응? 못 해 먹겠다니, 뭐가?」"},
{"id": "clse07:774300", "ko": "「히나랑 신지는 은근히 많이 닮았지~」"}
]
