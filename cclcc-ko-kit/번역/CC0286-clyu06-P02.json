[
{"id": "clyu06:10000", "ko": "（어, 어라?）"},
{"id": "clyu06:10100", "ko": "이상하다…… 몸이 멋대로 노노 쪽으로 나아가고 있어……?"},
{"id": "clyu06:10200", "ko": "게다가 노노가…… 유난히 커 보이는데……"},
{"id": "clyu06:10300", "ko": "（아……）"},
{"id": "clyu06:10400", "ko": "――하고 소리를 낼 틈도 없이, 노노가 커다란 두 손으로 나를 가볍게 안아 올렸다."},
{"id": "clyu06:10500", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu06:10600", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu06:10700", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu06:10800", "ko": "「옳지 옳지, 착하지 착하지」"},
{"id": "clyu06:10900", "ko": "그, 그만해! 애도 아닌데!"},
{"id": "clyu06:11000", "ko": "「깽, 깽!」"},
{"id": "clyu06:11100", "ko": "……어, 어라?"},
{"id": "clyu06:11200", "ko": "이상하다."},
{"id": "clyu06:11300", "ko": "내 목소리……"},
{"id": "clyu06:11400", "ko": "「깽!!」"},
{"id": "clyu06:11500", "ko": "말이…… 안 나온다……"},
{"id": "clyu06:11600", "ko": "「노노 언니만 치사해~. 나도 착하지 착하지 할래~」"},
{"id": "clyu06:11700", "ko": "「아이, 정말!」"},
{"id": "clyu06:11800", "ko": "아니다. 말만이 아니다."},
{"id": "clyu06:11900", "ko": "「옳지 옳지, 착하지 착하지」"},
{"id": "clyu06:12000", "ko": "아무래도 나는…… 개가 되어 버린 모양이다!!"},
{"id": "clyu06:12100", "ko": "왜? 어째서 갑자기 이런 일이……?"},
{"id": "clyu06:12200", "ko": "「…………」"},
{"id": "clyu06:12300", "ko": "「뭐어? 혹시 유도 착하지 착하지 하고 싶어?」"},
{"id": "clyu06:12400", "ko": "「나, 나는 괜찮아」"},
{"id": "clyu06:12500", "ko": "휴…… 다행이다."},
{"id": "clyu06:12600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:12700", "ko": "「그래? 타쿠루, 이렇게 귀여운데」"},
{"id": "clyu06:12800", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu06:12900", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu06:13000", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu06:13100", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clyu06:13200", "ko": "아, 아니야."},
{"id": "clyu06:13300", "ko": "방금 건 일부러 그런 게 아니라――"},
{"id": "clyu06:13400", "ko": "（읏……）"},
{"id": "clyu06:13500", "ko": "「어라?」"},
{"id": "clyu06:13600", "ko": "「왜 그래?」"},
{"id": "clyu06:13700", "ko": "「방금 타쿠루…… 부르르 떨었어. 혹시 쉬 마려운가?」"},
{"id": "clyu06:13800", "ko": "유이는 훌쩍 일어나더니 나를 가볍게 안아 들고, 어느새 방구석에 놓여 있던 애완동물용 화장실에 내려놓았다."},
{"id": "clyu06:13900", "ko": "（어……）"},
{"id": "clyu06:14000", "ko": "「자, 쉬는 거기서 하는 거야?」"},
{"id": "clyu06:14100", "ko": "여기서 하라고 해도……"},
{"id": "clyu06:14200", "ko": "「자. 쉬~, 쉬~……」"},
{"id": "clyu06:14300", "ko": "「…………」"},
{"id": "clyu06:14400", "ko": "「…………」"},
{"id": "clyu06:14500", "ko": "그럴 수가…… 아무리 내가 개라고 해도, 이렇게 다들 보는 앞에서 볼일을 보는 창피한 짓을 할 수 있을 리가 없다."},
{"id": "clyu06:14600", "ko": "……라고 생각하는데도."},
{"id": "clyu06:14700", "ko": "「끄~응」"},
{"id": "clyu06:14800", "ko": "개가 되어 버린 나의 인내력은 자연의 욕구 앞에 완전히 무력했다."},
{"id": "clyu06:14900", "ko": "（아……）"},
{"id": "clyu06:15000", "ko": "「와. 엄청 나온다…… 대단해~」"},
{"id": "clyu06:15100", "ko": "（그만…… 보지 마……）"},
{"id": "clyu06:15200", "ko": "「…………」"},
{"id": "clyu06:15300", "ko": "「왜 그래, 타쿠루 오빠? 얼굴 빨개?」"},
{"id": "clyu06:15400", "ko": "「아, 아니…… 딱히, 아무것도…… 아냐……」"},
{"id": "clyu06:15500", "ko": "유이의 얼굴을 똑바로 보지 못하고 저도 모르게 시선을 피해 버렸다."},
{"id": "clyu06:15600", "ko": "「…………?」"},
{"id": "clyu06:15700", "ko": "「저기, 유이. 타쿠루가 안 보이는데, 어디 갔는지 알――」"},
{"id": "clyu06:15800", "ko": "으레 나쁜 예감은 들어맞는 법이다."},
{"id": "clyu06:15900", "ko": "노노는 들어오자마자 우리 모습을 보고 굳어 버렸다."},
{"id": "clyu06:16000", "ko": "「타쿠루……」"},
{"id": "clyu06:16100", "ko": "이건…… 완전히 오해하고 있는 눈이다."},
{"id": "clyu06:16200", "ko": "「쿠…… 노노…… 아니야, 이건――」"},
{"id": "clyu06:16300", "ko": "「아니야? 뭐가 아니라는 건데?」"},
{"id": "clyu06:16400", "ko": "노노 뒤로 새까만 먹구름이 드리우는 게 보이는 것 같았다."},
{"id": "clyu06:16500", "ko": "여기선 어떻게든 원만하게 넘어가고 싶은데……"},
{"id": "clyu06:16600", "ko": "「잠깐만, 노노 언니」"},
{"id": "clyu06:16700", "ko": "갑자기 유이가 나와 노노 사이를 가로막고 섰다."},
{"id": "clyu06:16800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:16900", "ko": "……갑자기 무슨 소리를 하는 거야?"},
{"id": "clyu06:17000", "ko": "「그건…… 무슨 뜻일까, 유이?」"},
{"id": "clyu06:17100", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:17200", "ko": "뜻밖의 유이의 말에 나는 그저 어안이 벙벙했다."},
{"id": "clyu06:17300", "ko": "한편 노노는……"},
{"id": "clyu06:17400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:17500", "ko": "아무리 봐도 폭발 직전이었다."},
{"id": "clyu06:17600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족, 17600~17900)"},
{"id": "clyu06:17700", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:17800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:17900", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:18000", "ko": "「그래……」"},
{"id": "clyu06:18100", "ko": "갑자기 노노의 손에 거대한 날개가 돋아났다."},
{"id": "clyu06:18200", "ko": "아니, 그건―― ⟦col:280aa02d1400⟧디소드⟦col:800000⟧."},
{"id": "clyu06:18300", "ko": "⟦col:280aa02d1400⟧기가로매니악스⟦col:800000⟧만이 쓸 수 있다는 망상의 검――"},
{"id": "clyu06:18400", "ko": "「자, 잠깐, 노노…… 성급하게 굴지 마! 말로 하면 알아!!」"},
{"id": "clyu06:18500", "ko": "「흐응. 그렇게 협박하면 따를 거라고 생각하는 거지?」"},
{"id": "clyu06:18600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:18700", "ko": "「야, 야, 유이…… 적당히 좀 해」"},
{"id": "clyu06:18800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:18900", "ko": "「읏……」"},
{"id": "clyu06:19000", "ko": "……영문을 모르겠다."},
{"id": "clyu06:19100", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:19200", "ko": "「두, 둘 다, 좀 진정하고……」"},
{"id": "clyu06:19300", "ko": "「타쿠루는 가만있어!」⟦n⟧⟦par⟧「타쿠루 오빠는 가만있어!」"},
{"id": "clyu06:19400", "ko": "「으……」"},
{"id": "clyu06:19500", "ko": "「…………」"},
{"id": "clyu06:19600", "ko": "노노는 디소드를 든 채 슬금슬금 다가온다."},
{"id": "clyu06:19700", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:19800", "ko": "이러다간 정말 대참사가 벌어진다."},
{"id": "clyu06:19900", "ko": "어떡하지……"}
]
