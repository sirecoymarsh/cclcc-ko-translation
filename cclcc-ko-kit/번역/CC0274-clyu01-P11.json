[
{"id": "clyu01:99500", "ko": "뭐, 그렇게 생각하게 만드는 내 재능이 문제지만."},
{"id": "clyu01:99600", "ko": "그런 의미에서 저 애들에게 죄는 없다."},
{"id": "clyu01:99700", "ko": "오히려 죄가 있는 건 내 쪽이다."},
{"id": "clyu01:99800", "ko": "게다가 내 손에 걸리면, 저 애들처럼 아무리 별 볼 일 없는 여자애라도 아이돌로 만들어 보일 수 있다."},
{"id": "clyu01:99900", "ko": "왜냐하면 나는…… 명프로듀서, 미야시로 타쿠루니까!"},
{"id": "clyu01:100000", "ko": "「프로듀서님」"},
{"id": "clyu01:100100", "ko": "「응? 무슨 일인가, 오노에 양?」", "note": "망상 속 상사·비서 역할극의 「尾上くん」 — 상사가 여자 비서를 부르는 말투로 「오노에 양」"},
{"id": "clyu01:100200", "ko": "「이후 일정입니다만, 방송국 사장님과 식사 자리. 그 후――」"},
{"id": "clyu01:100300", "ko": "「미안하지만, 저녁 일정은 전부 취소해 주게」"},
{"id": "clyu01:100400", "ko": "「그렇지만……」"},
{"id": "clyu01:100500", "ko": "「두 번 말하게 하지 마」"},
{"id": "clyu01:100600", "ko": "「네…… 알겠습니다……」"},
{"id": "clyu01:100700", "ko": "높으신 분들과의 식사도 매일 이어지니 역시 지루하다."},
{"id": "clyu01:100800", "ko": "게다가――"},
{"id": "clyu01:100900", "ko": "나는 프로듀서다."},
{"id": "clyu01:101000", "ko": "「마운틴 뷰와 우유를」"},
{"id": "clyu01:101100", "ko": "가장 신경 써야 하는 건 내가 프로듀스하는 아이돌인 것이다."},
{"id": "clyu01:101200", "ko": "", "note": "보류 — 성적 강요 묘사(미성년, 101200~103600)"},
{"id": "clyu01:101300", "ko": "「……그래서?」"},
{"id": "clyu01:101400", "ko": "「저, 어떻게 하면 좋을까요?」"},
{"id": "clyu01:101500", "ko": "「어떻게 하면…… 이라니?」"},
{"id": "clyu01:101600", "ko": "「저, 아이돌로서 더 잘나가고 싶어요. 그런데 어떻게 하면 좋을지 몰라서」"},
{"id": "clyu01:101700", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:101800", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:101900", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102000", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102100", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102200", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102300", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102400", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102500", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102600", "ko": "「…………」"},
{"id": "clyu01:102700", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102800", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:102900", "ko": "「…………」"},
{"id": "clyu01:103000", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:103100", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:103200", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:103300", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:103400", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:103500", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:103600", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:103700", "ko": "「…………」"},
{"id": "clyu01:103800", "ko": "「타쿠루 오빠? 왜 그래?」"},
{"id": "clyu01:103900", "ko": "「어? 아, 응」"},
{"id": "clyu01:104000", "ko": "큰일이다."},
{"id": "clyu01:104100", "ko": "또 망상에 빠져 버렸다!"},
{"id": "clyu01:104200", "ko": "애초에 아무리 망상이라도 너무 구닥다리잖아, 나!"},
{"id": "clyu01:104300", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"},
{"id": "clyu01:104400", "ko": "게다가 유이는 여동생이라고!!!"},
{"id": "clyu01:104500", "ko": "정신 차려, 나!!!"},
{"id": "clyu01:104600", "ko": "「아, 아무튼 나한테 맡겨 두면 어떻게든 할 테니까」"},
{"id": "clyu01:104700", "ko": "「…………」"},
{"id": "clyu01:104800", "ko": "「어라? 야…… 방금 그 녀석, 그거 아냐? 옛날에 아이돌 프로듀서 같은 거 하던……」"},
{"id": "clyu01:104900", "ko": "「뭐? 누구야 그게? 몰라」"},
{"id": "clyu01:105000", "ko": "「그렇지. 잠깐 뜰 뻔했던 아이돌이었는데, 그 뒤로 금방 사라졌고」"},
{"id": "clyu01:105100", "ko": "「그런 녀석을 알 리가 없잖아」"},
{"id": "clyu01:105200", "ko": "「하아……」"},
{"id": "clyu01:105300", "ko": "아이돌 활동이라…… 그립네."},
{"id": "clyu01:105400", "ko": "처음엔 꽤 잘될 줄 알았지."},
{"id": "clyu01:105500", "ko": "인터넷에서는 나름 팬도 생기고, 라이브 하우스에서 활동하게 되고, 텔레비전에도 조금은 나오게 되고……"},
{"id": "clyu01:105600", "ko": "하지만…… 내가 안이했다."},
{"id": "clyu01:105700", "ko": "아이돌 활동이란 역시 그렇게 쉬운 게 아니었던 거다."},
{"id": "clyu01:105800", "ko": "요즘 시대에 아이돌은 얼마나 오래 활동을 이어 갈 수 있느냐가 승부다."},
{"id": "clyu01:105900", "ko": "길고 긴 무명 시절을 거쳐 많은 사람에게 알려지고, 겨우 작은 꽃을 피우는 것, 그게 아이돌이다."},
{"id": "clyu01:106000", "ko": "그러려면 역시 자금이 필요한데, 우리는 그 근본적인 부분에서 잘못하고 있었다."},
{"id": "clyu01:106100", "ko": "덕분에 유이와 유토의 활동은 순식간에 끝."},
{"id": "clyu01:106200", "ko": "그뿐 아니라 빚을 지는 바람에 두 사람 다 다른 소속사로 강제로 이적하는 처지가 됐다."},
{"id": "clyu01:106300", "ko": "그 뒤로 꾸준히 활동은 했던 것 같지만, 지금은 어떻게 지내는지 이름조차 들리지 않게 되었다."},
{"id": "clyu01:106400", "ko": "……내 탓이다."},
{"id": "clyu01:106500", "ko": "전부 내……"},
{"id": "clyu01:106600", "ko": "「오~, 타쿠. 옜다, 그거 또 구했다」"},
{"id": "clyu01:106700", "ko": "「아아…… 고마워……」"},
{"id": "clyu01:106800", "ko": "⟦col:280aa02d1400⟧쿨 캣 프레스⟦col:800000⟧인가."},
{"id": "clyu01:106900", "ko": "이제 와서는 이것도……"},
{"id": "clyu01:107000", "ko": "「어라? 뭐야, 이거?」"},
{"id": "clyu01:107100", "ko": "쿨 캣 프레스가 아니다……"},
{"id": "clyu01:107200", "ko": "겐 씨도 참, 실수로 다른 걸 가져왔네."},
{"id": "clyu01:107300", "ko": "", "note": "보류 — 성적 묘사(미성년, 107300~108500)"},
