[
{"id": "clka10:10000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:10100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:10200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:10300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:10400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:10500", "ko": "그러자 드물게도 카즈키 쪽에서 말을 걸어왔다."},
{"id": "clka10:10600", "ko": "「타쿠루 선배는 상냥해…… 일지도」"},
{"id": "clka10:10700", "ko": "「무슨 소리야?」"},
{"id": "clka10:10800", "ko": "잠깐의 침묵."},
{"id": "clka10:10900", "ko": "「어울려 줄 의리도…… 없는데」"},
{"id": "clka10:11000", "ko": "「여기까지…… 해 줘」"},
{"id": "clka10:11100", "ko": "「……게다가」"},
{"id": "clka10:11200", "ko": "「게다가?」"},
{"id": "clka10:11300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:11400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:11500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:11600", "ko": "「어느 쪽이냐 하면 나는 남한테 차가운 편이야」"},
{"id": "clka10:11700", "ko": "「으응. 그렇지 않아」"},
{"id": "clka10:11800", "ko": "「선배는, 상냥해」"},
{"id": "clka10:11900", "ko": "「선배만이 아니라, 신문부 사람들은, 다들, 상냥해」"},
{"id": "clka10:12000", "ko": "「무슨 뜻이야?」"},
{"id": "clka10:12100", "ko": "「다들, 내가 곤란해하면, 아무 말 안 해도, 도와줘」"},
{"id": "clka10:12200", "ko": "「동아리에 들어왔을 때도, 그랬어」"},
{"id": "clka10:12300", "ko": "「아, 그러고 보니 카즈키는 쿠루스가 권해서 신문부에 들어왔었지」"},
{"id": "clka10:12400", "ko": "「응」"},
{"id": "clka10:12500", "ko": "전에 쿠루스한테 들은 적이 있다."},
{"id": "clka10:12600", "ko": "새 학기가 시작되고 며칠 지났을 무렵, 쿠루스는 복도에서 프린트를 흩뜨려 놓고 곤란해하는 카즈키와 마주쳤다."},
{"id": "clka10:12700", "ko": "카즈키는 스스로는 전혀 말을 하지 않는 탓에, 같은 반 애들이나 담임 선생님에게 제멋대로 잡일꾼으로 부려지고 있었다."},
{"id": "clka10:12800", "ko": "걸어 다니는 정의감인 쿠루스가 그 상황에 항의하고, 학교 안에 있을 곳을 마련해 줄 수 없을까 싶어 신문부에 권한 것이다."},
{"id": "clka10:12900", "ko": "며칠 뒤 카즈키는 부실에 나타났다. 쿠루스 자신은 안 돼도 그만이라는 생각이었기 때문에 오히려 깜짝 놀랐다고 한다."},
{"id": "clka10:13000", "ko": "그 뒤로 창가에서 ⟦col:280aa02d1400⟧엠스⟦col:800000⟧에 열중하는 카즈키의 모습이 일상이 되었다."},
{"id": "clka10:13100", "ko": "「쿠루스는 상냥하다기보다, 곤란한 사람을 그냥 못 지나치는 녀석이라서」"},
{"id": "clka10:13200", "ko": "「뭐랄까, 남 챙기는 걸 좋아할 뿐이야」"},
{"id": "clka10:13300", "ko": "「으응」"},
{"id": "clka10:13400", "ko": "「그것도, 상냥함」"},
{"id": "clka10:13500", "ko": "잘 모르겠다."},
{"id": "clka10:13600", "ko": "「뭐, 만약 쿠루스가 없었다면 카즈키가 지금처럼 방과 후에 엠스를 하고 있는 일은 없었겠지」"},
{"id": "clka10:13700", "ko": "「쿠루스한테 고마워하도록 해」"},
{"id": "clka10:13800", "ko": "「……」"},
{"id": "clka10:13900", "ko": "「으응」"},
{"id": "clka10:14000", "ko": "「그것만이, 아니야」"},
{"id": "clka10:14100", "ko": "「어?」"},
{"id": "clka10:14200", "ko": "「내가, 거기 있을 수 있는 이유」"},
{"id": "clka10:14300", "ko": "「노노 선배만이, 아니야」"},
{"id": "clka10:14400", "ko": "「무슨 뜻이야?」"},
{"id": "clka10:14500", "ko": "「응……」"},
{"id": "clka10:14600", "ko": "「……그건」"},
{"id": "clka10:14700", "ko": "그때."},
{"id": "clka10:14800", "ko": "「힉! 뭐, 뭐야!?」"},
{"id": "clka10:14900", "ko": "갑자기 방 안에 울린 소리에 몸이 움찔 떨린다."},
{"id": "clka10:15000", "ko": "「물이 다 받아진 것 같아」"},
{"id": "clka10:15100", "ko": "「그, 그렇구나! 놀라게 하지 말라고……」"},
{"id": "clka10:15200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:15300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:15400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:15500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:15600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:15700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:15800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:15900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:16000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:16100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:16200", "ko": "「……그, 그래! 그렇지!」"},
{"id": "clka10:16300", "ko": "목소리가 뒤집힌 채 나는 어색하게 일어서서 세면실로 달려갔다."},
{"id": "clka10:16400", "ko": "뜨거운 샤워가 피부를 타고 흐르며 차갑게 식은 몸을 데워 간다."},
{"id": "clka10:16500", "ko": "（카즈키는 무슨 말을 하려던 걸까?）"},
{"id": "clka10:16600", "ko": "「그것만이, 아니야」"},
{"id": "clka10:16700", "ko": "「내가, 거기 있을 수 있는 이유」"},
{"id": "clka10:16800", "ko": "「노노 선배만이, 아니야」"},
{"id": "clka10:16900", "ko": "（카즈키가 신문부에 있을 수 있는 이유…… 라니, 뭐지?）"},
{"id": "clka10:17000", "ko": "내 인상으로는, 카즈키는 정신을 차려 보니 부실에 눌러앉아 있었다. 쿠루스한테 듣기 전까지는 카즈키가 입부한 경위도 몰랐을 정도다."},
{"id": "clka10:17100", "ko": "신문부 멤버들은 좋은 의미로든 나쁜 의미로든 남의 개인 공간에 억지로 들어가려 하지 않는 데가 있다."},
{"id": "clka10:17200", "ko": "카즈키처럼 사람을 싫어하진 않지만 남과 말하는 게 서툰 사람에게는 편한 공간인가 보다 하고 멋대로 생각하고 있었다."},
{"id": "clka10:17300", "ko": "（……흠）"},
{"id": "clka10:17400", "ko": "뭐, 됐나. 나와는 관계없는 일이다."},
{"id": "clka10:17500", "ko": "「……신경 쓰지 않기로 하자」"},
{"id": "clka10:17600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:17700", "ko": "「히아앗!?」"},
{"id": "clka10:17800", "ko": "생각지도 못할 만큼 가까이에서 목소리가 들려서, 나도 모르게 비명을 질렀다."},
{"id": "clka10:17900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18000", "ko": "「너, 너! 카즈키가 아니지!?」"},
{"id": "clka10:18100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:18800", "ko": "「뭐뭐뭐, 무슨 차림을 하고 있는 거야!」"},
{"id": "clka10:18900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:19000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:19100", "ko": "「갸아아아아아!!!!!」"},
{"id": "clka10:19200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:19300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:19400", "ko": "「시시시, 시끄러워! 질문에 대답해! 왜 수영복 같은 걸 입고 있는 거야!」"},
{"id": "clka10:19500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:19600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:19700", "ko": "「무슨 얘기를 하는 거야!?」"},
{"id": "clka10:19800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:19900", "ko": "「안 했어!!」"}
]
