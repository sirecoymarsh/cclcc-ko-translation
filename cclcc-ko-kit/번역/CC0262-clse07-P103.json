[
{"id": "clse07:979500", "ko": "「정말 좋아…… 해애……?」"},
{"id": "clse07:979600", "ko": "「읏…… 정말 좋아해~!」"},
{"id": "clse07:979700", "ko": "「우, 우리는 어떻게 하면 되는 걸까?」"},
{"id": "clse07:979800", "ko": "「나도 타쿠루 형이 좋겠다……」"},
{"id": "clse07:979900", "ko": "「춤춰 봤다?」"},
{"id": "clse07:980000", "ko": "「…………」"},
{"id": "clse07:980100", "ko": "「그치만, 이거 여자애들이 보는 애니잖아?」"},
{"id": "clse07:980200", "ko": "「그런데 타쿠루 형…… 왜 지금부터 이 차림을 해야 돼?」"},
{"id": "clse07:980300", "ko": "「흐응, 그렇구나」"},
{"id": "clse07:980400", "ko": "「춤…… 나 해 본 적 없어……」"},
{"id": "clse07:980500", "ko": "「하나, 둘, 셋, 넷, 다섯, 여섯, 일곱, 여덟」"},
{"id": "clse07:980600", "ko": "「그러니까. 여기서 턴하고……」"},
{"id": "clse07:980700", "ko": "「괘, 괜찮아, 누나?!」"},
{"id": "clse07:980800", "ko": "「누나!」"},
{"id": "clse07:980900", "ko": "「저기, 누나. 피곤한 것 같으니까 오늘은 이걸로 끝내자? 응?」"},
{"id": "clse07:981000", "ko": "「거기 리듬은 탄, 타탄, 탄이야!」"},
{"id": "clse07:981100", "ko": "「그러니까, 탄, 타탄, 탄, 이라니까~」"},
{"id": "clse07:981200", "ko": "「그리고 여기서 스텝이야!」"},
{"id": "clse07:981300", "ko": "「자, 턴!」"},
{"id": "clse07:981400", "ko": "「으, 응……」"},
{"id": "clse07:981500", "ko": "「마지막으로 여기서 포즈!」"},
{"id": "clse07:981600", "ko": "「…………」"},
{"id": "clse07:981700", "ko": "「응! 제대로 했어!」"},
{"id": "clse07:981800", "ko": "「아니, 누나가 열심히 했으니까 그런 거야」"},
{"id": "clse07:981900", "ko": "「보여 주고 싶은…… 거?」"},
{"id": "clse07:982000", "ko": "「봐, 누나…… 조회 수…… 이렇게 많은 사람이 보고 있어?」"},
{"id": "clse07:982100", "ko": "「그런데 타쿠루 형, 언제……」"},
{"id": "clse07:982200", "ko": "「응!」"},
{"id": "clse07:982300", "ko": "「아하하. 타쿠루 형, 쑥스러워한다 쑥스러워한다」"},
{"id": "clse07:982400", "ko": "「…………」"},
{"id": "clse07:982500", "ko": "「나, 나는 괜찮아」"},
{"id": "clse07:982600", "ko": "「…………」"},
{"id": "clse07:982700", "ko": "「그만해!!!」"},
{"id": "clse07:982800", "ko": "「그만해…… 안 돼, 이런 거……」"},
{"id": "clse07:982900", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:983000", "ko": "「그래서 말야, 나 생각했어. 다 같이 나눠 가지면 된다고」"},
{"id": "clse07:983100", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clse07:983200", "ko": "「그럼, 난 손으로 할까……」"},
{"id": "clse07:983300", "ko": "「그럼 각자 손이랑 발을 한 짝씩 나누자」"},
{"id": "clse07:983400", "ko": "「잘 먹겠습니다!」"},
{"id": "clse07:983500", "ko": "「우물우물우물……」"},
{"id": "clse07:983600", "ko": "「응!」"},
{"id": "clse07:983700", "ko": "「우……」"},
{"id": "clse07:983800", "ko": "「이거 먹기만 하면 돼?」"},
{"id": "clse07:983900", "ko": "", "note": "보류 — 성적 묘사(미성년 인물 둘이 아이스크림을 핥는 성적 암시 장면 983900~984700, CC0258 942600~943500과 같은 장면)"},
{"id": "clse07:984000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:984100", "ko": "「응」"},
{"id": "clse07:984200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:984300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:984400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:984500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:984600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:984700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:984800", "ko": "「다, 다음은 무슨 색?」"},
{"id": "clse07:984900", "ko": "「오, 오른손을…… 빨강…… 읏……」"},
{"id": "clse07:985000", "ko": "「조, 조금만 더 하면…… 닿아……」"},
{"id": "clse07:985100", "ko": "「읏…… 다, 닿았다……!」"},
{"id": "clse07:985200", "ko": "「다, 다음은…… 왼발을 초록…… 이래……」"},
{"id": "clse07:985300", "ko": "「이, 이쪽으로 발을 넣으면 될 것 같…… 아?」"},
{"id": "clse07:985400", "ko": "「그, 그러니까, 이쪽……」"},
{"id": "clse07:985500", "ko": "「왜, 왜 그래?」"},
{"id": "clse07:985600", "ko": "「와왓, 그렇게 움직이면 위험――!」"},
{"id": "clse07:985700", "ko": "「어? 타쿠루 형…… 뭐라고 했어?」"},
{"id": "clse07:985800", "ko": "「으, 응. 그러니까…… 다음은……」"},
{"id": "clse07:985900", "ko": "「그, 그런 말 해도 이런 자세로는 무리야아……」"},
{"id": "clse07:986000", "ko": "「어?! 아, 잠깐만―― 아아아앗!」"},
{"id": "clse07:986100", "ko": "「니야생?」"},
{"id": "clse07:986200", "ko": "「누나가 하고 싶으면 좋아」"},
{"id": "clse07:986300", "ko": "「유, 유예요」"},
{"id": "clse07:986400", "ko": "「나, 나는 누나만 괜찮으면」"},
{"id": "clse07:986500", "ko": "「나는 딱히 괜찮아?」"},
{"id": "clse07:986600", "ko": "「『히얏!』」"},
{"id": "clse07:986700", "ko": "「『정말…… 반격이야!! 에잇!」", "note": "원문도 『 를 닫지 않음 — 그대로 둠"},
{"id": "clse07:986800", "ko": "「『푸웁!!』」"},
{"id": "clse07:986900", "ko": "「『그러는 유이야말로……』」"},
{"id": "clse07:987000", "ko": "「『와와와!』」"},
{"id": "clse07:987100", "ko": "「우우……」"},
{"id": "clse07:987200", "ko": "「…………」"},
{"id": "clse07:987300", "ko": "「밀푀유, 유야」"},
{"id": "clse07:987400", "ko": "「아, 저번에 학교에서 돌아오는 길에 벌써 크리스마스 장식 하고 있었지. 봐, 히카――」"},
{"id": "clse07:987500", "ko": "「누나, 집에는 없었어」"},
{"id": "clse07:987600", "ko": "「…………」"},
{"id": "clse07:987700", "ko": "「있잖아…… 내가 말해 버려서? 내가 말한 탓에 누나가 위험한 일을 당하고 있는 거야?」"},
{"id": "clse07:987800", "ko": "「누나!」"},
{"id": "clse07:987900", "ko": "「있잖아…… 누나, 어떻게 되는 거야?」"},
{"id": "clse07:988000", "ko": "「내 일…… 일지도……」"},
{"id": "clse07:988100", "ko": "「내가…… 『밀푀유』의 유가 사실은 남자라는 걸 들켜 버린 걸지도……」"},
{"id": "clse07:988200", "ko": "「누나……」"},
{"id": "clse07:988300", "ko": "「누나…… 알려 줘. 어디 있어?」"},
{"id": "clse07:988400", "ko": "「……어?!」"},
{"id": "clse07:988500", "ko": "「누…… 나……?」"},
{"id": "clse07:988600", "ko": "「들려…… 누나 목소리……」"},
{"id": "clse07:988700", "ko": "「누나! 나야! 유토야! 있잖아, 대답해! 지금 어디 있어?!」"},
{"id": "clse07:988800", "ko": "「……말도 안 돼」"},
{"id": "clse07:988900", "ko": "「어떤 건물의 3층이나 4층…… 그 정도밖에 모르겠대……」"},
{"id": "clse07:989000", "ko": "「어? 으, 응!」"},
{"id": "clse07:989100", "ko": "「누나! 거기까지 걸어서 얼마나 걸렸냐고 타쿠루 형이!」"},
{"id": "clse07:989200", "ko": "「……15분? 차에는? 응, 알았어」"},
{"id": "clse07:989300", "ko": "「「……커다란 둥근 침대. 그 밖에는 어두워서 잘 모르겠대」", "note": "원문 머리의 겹낫표 「「 그대로 둠"},
{"id": "clse07:989400", "ko": "「창밖에 얼굴이 보였대…… 벽 쪽에 떠 있었고……」"}
]
