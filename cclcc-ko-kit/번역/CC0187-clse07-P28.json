[
{"id": "clse07:264200", "ko": "「그거, 거짓말이야」"},
{"id": "clse07:264300", "ko": "「……어?」"},
{"id": "clse07:264400", "ko": "「안쪽, 봐 봐」"},
{"id": "clse07:264500", "ko": "「어?」"},
{"id": "clse07:264600", "ko": "「어? 어?」"},
{"id": "clse07:264700", "ko": "「어? 어? 어?」"},
{"id": "clse07:264800", "ko": "「에에에에에에에에에에에에에!!!!!!!??????」"},
{"id": "clse07:264900", "ko": "「어어어어어, 어째서!?」"},
{"id": "clse07:265000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:265100", "ko": "「그그그그, 그치만 그치만 그치만!」"},
{"id": "clse07:265200", "ko": "「그치만, 자기 자신한테는 거짓말 못 한다고……!!??」"},
{"id": "clse07:265300", "ko": "「에〜? 나 그런 말 안 했는데?」"},
{"id": "clse07:265400", "ko": "「『자기 자신한테 거짓말할 필요는 없다』고 했을 뿐이야」"},
{"id": "clse07:265500", "ko": "「거짓말하면 안 된다는 건 아니지」"},
{"id": "clse07:265600", "ko": "「말도 안 돼〜!!!」"},
{"id": "clse07:265700", "ko": "「뭐, 하루 종일 어울려 준 데 대한 내 선물이야」"},
{"id": "clse07:265800", "ko": "「나머지는 네가 잘해 봐」"},
{"id": "clse07:265900", "ko": "「그럼 안녕」"},
{"id": "clse07:266000", "ko": "「아……」"},
{"id": "clse07:266100", "ko": "「……고마워」"},
{"id": "clse07:266200", "ko": "「응」"},
{"id": "clse07:266300", "ko": "「……응」"},
{"id": "clse07:266400", "ko": "「읏! ……」"},
{"id": "clse07:266500", "ko": "「읏!!??」"},
{"id": "clse07:266600", "ko": "「……응」"},
{"id": "clse07:266700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:266800", "ko": "「!……」"},
{"id": "clse07:266900", "ko": "「……」"},
{"id": "clse07:267000", "ko": "「…………」"},
{"id": "clse07:267100", "ko": "「응」"},
{"id": "clse07:267200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:267300", "ko": "「응」"},
{"id": "clse07:267400", "ko": "「응?」"},
{"id": "clse07:267500", "ko": "「응」"},
{"id": "clse07:267600", "ko": "「응!」"},
{"id": "clse07:267700", "ko": "「응」"},
{"id": "clse07:267800", "ko": "「으음〜!!」"},
{"id": "clse07:267900", "ko": "「……똑같은 거…… 일지도」"},
{"id": "clse07:268000", "ko": "「응?」"},
{"id": "clse07:268100", "ko": "「응」"},
{"id": "clse07:268200", "ko": "「……」"},
{"id": "clse07:268300", "ko": "「……응」"},
{"id": "clse07:268400", "ko": "「응」"},
{"id": "clse07:268500", "ko": "「응」"},
{"id": "clse07:268600", "ko": "「……」"},
{"id": "clse07:268700", "ko": "「응……」"},
{"id": "clse07:268800", "ko": "「……후훗」"},
{"id": "clse07:268900", "ko": "「그 논리대로라면…… 히나 씨도 나보다 한 학년 위니까……」"},
{"id": "clse07:269000", "ko": "「응……」"},
{"id": "clse07:269100", "ko": "「학생회 일이 아니야…… 일지도……」"},
{"id": "clse07:269200", "ko": "「오는 길에 만났어…… 일지도……」"},
{"id": "clse07:269300", "ko": "「……잠깐 볼일이 있어서 늦을지도 모른대……」"},
{"id": "clse07:269400", "ko": "「으으으읏!!?」"},
{"id": "clse07:269500", "ko": "「하아〜……」"},
{"id": "clse07:269600", "ko": "「쓰레기…… 일지도……」"},
{"id": "clse07:269700", "ko": "「엠스의 시간 한정 퀘스트…… 일지도……」"},
{"id": "clse07:269800", "ko": "「좋아…… 일지도」"},
{"id": "clse07:269900", "ko": "「괜히 부회장이 아니었어…… 일지도……」"},
{"id": "clse07:270000", "ko": "「무리도 아니야…… 일지도……」"},
{"id": "clse07:270100", "ko": "「와 버렸어…… 일지도……」"},
{"id": "clse07:270200", "ko": "「응…………」"},
{"id": "clse07:270300", "ko": "「응……!?」"},
{"id": "clse07:270400", "ko": "「응……」"},
{"id": "clse07:270500", "ko": "「응……」"},
{"id": "clse07:270600", "ko": "「이상해…… 일지도」"},
{"id": "clse07:270700", "ko": "「바보…… 일지도……」"},
{"id": "clse07:270800", "ko": "「응……」"},
{"id": "clse07:270900", "ko": "「……정말, 인가요. 선배……」"},
{"id": "clse07:271000", "ko": "「차오임다……」", "note": "앞서 히나에가 한 인사 「チャオっす」를 따라 함 — 히나에의 っす(~임다)에 맞춤"},
{"id": "clse07:271100", "ko": "「그치……」"},
{"id": "clse07:271200", "ko": "「그런 건 사실이 아니니까, 분명 다들 언젠가 알아줄…… 거야……」"},
{"id": "clse07:271300", "ko": "「응……」"},
{"id": "clse07:271400", "ko": "「…………」"},
{"id": "clse07:271500", "ko": "「타쿠루…… 선배……」"},
{"id": "clse07:271600", "ko": "「노노…… 선배……」"},
{"id": "clse07:271700", "ko": "「…………」"},
{"id": "clse07:271800", "ko": "「노노 선배……」"},
{"id": "clse07:271900", "ko": "「받아라〜…… 일지도……」"},
{"id": "clse07:272000", "ko": "「으음……」"},
{"id": "clse07:272100", "ko": "「응……」"},
{"id": "clse07:272200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:272300", "ko": "「응……」"},
{"id": "clse07:272400", "ko": "「으음……」"},
{"id": "clse07:272500", "ko": "「응……」"},
{"id": "clse07:272600", "ko": "「히나 씨……!」"},
{"id": "clse07:272700", "ko": "「……센리 선배도…… 기다리고 있을지도 몰라……」"},
{"id": "clse07:272800", "ko": "「마찬가지…… 일지도……」"},
{"id": "clse07:272900", "ko": "「꽤 궁금해…… 일지도」"},
{"id": "clse07:273000", "ko": "「왜?」"},
{"id": "clse07:273100", "ko": "「응, 알았어…… 일지도」"},
{"id": "clse07:273200", "ko": "「…………」"},
{"id": "clse07:273300", "ko": "「…………」"},
{"id": "clse07:273400", "ko": "「…………!」"},
{"id": "clse07:273500", "ko": "「최악…… 일지도……」"},
{"id": "clse07:273600", "ko": "「……이토 선배는…… 평생 여자애가 만든 도시락을 못 먹게 된다……」"},
{"id": "clse07:273700", "ko": "「……일지도」"},
{"id": "clse07:273800", "ko": "「아이돌을 프로듀스!?」"},
{"id": "clse07:273900", "ko": "「응…………」"},
