[
{"id": "clyu06:20000", "ko": "어떻게 하면……"},
{"id": "clyu06:20100", "ko": "「그만해!!!」"},
{"id": "clyu06:20200", "ko": "그때, 바깥에 밀려나 있던 유토가 공기를 가르듯 소리치자 두 사람의 움직임이 멈췄다."},
{"id": "clyu06:20300", "ko": "「…………」"},
{"id": "clyu06:20400", "ko": "「유……」"},
{"id": "clyu06:20500", "ko": "「그만해…… 안 돼, 이런 거……」"},
{"id": "clyu06:20600", "ko": "유토……"},
{"id": "clyu06:20700", "ko": "그래…… 이상하다고."},
{"id": "clyu06:20800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:20900", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:21000", "ko": "「엥……?」"},
{"id": "clyu06:21100", "ko": "「그래서 말야, 나 생각했어. 다 같이 나눠 가지면 된다고」"},
{"id": "clyu06:21200", "ko": "「나눠 갖자고……?」"},
{"id": "clyu06:21300", "ko": "무슨…… 소리지?"},
{"id": "clyu06:21400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:21500", "ko": "유토는 노노가 손에 든 ⟦col:280aa02d1400⟧디소드⟦col:800000⟧를 가리키며 웃었다."},
{"id": "clyu06:21600", "ko": "「……듣고 보니 그렇네」"},
{"id": "clyu06:21700", "ko": "「나도 유 의견에 찬성일지도」"},
{"id": "clyu06:21800", "ko": "잠깐."},
{"id": "clyu06:21900", "ko": "부위?"},
{"id": "clyu06:22000", "ko": "그게 뭐야?"},
{"id": "clyu06:22100", "ko": "무슨 소리야?"},
{"id": "clyu06:22200", "ko": "「그럼 난 머리 쪽이 좋겠다」"},
{"id": "clyu06:22300", "ko": "「그럼, 난 손으로 할까……」"},
{"id": "clyu06:22400", "ko": "「아, 나도 손이 좋아」"},
{"id": "clyu06:22500", "ko": "「그럼 각자 손이랑 발을 한 짝씩 나누자」"},
{"id": "clyu06:22600", "ko": "「그것도 좋겠네」"},
{"id": "clyu06:22700", "ko": "「그럼, 노노 언니 부탁해……」"},
{"id": "clyu06:22800", "ko": "「응. 알았어」"},
{"id": "clyu06:22900", "ko": "노노는 돌아서더니 ⟦col:280aa02d1400⟧디소드⟦col:800000⟧를 겨누었다."},
{"id": "clyu06:23000", "ko": "어느새 유이와 유토가 양옆에서 나를 붙잡고 있어서 꼼짝할 수가 없다."},
{"id": "clyu06:23100", "ko": "「어? 잠깐만. 농담이지? 응? 고약한 농담이지?」"},
{"id": "clyu06:23200", "ko": "「그럼, 간다」"},
{"id": "clyu06:23300", "ko": "「하나, 둘!」"},
{"id": "clyu06:23400", "ko": "「힉――!!」"},
{"id": "clyu06:23500", "ko": "「…………」"},
{"id": "clyu06:23600", "ko": "――캄캄하다."},
{"id": "clyu06:23700", "ko": "나는 캄캄하고 캄캄한 상자 속에 있었다."},
{"id": "clyu06:23800", "ko": "그로부터 벌써 며칠이 지났을까."},
{"id": "clyu06:23900", "ko": "일주일?"},
{"id": "clyu06:24000", "ko": "열흘?"},
{"id": "clyu06:24100", "ko": "아니면 한 달?"},
{"id": "clyu06:24200", "ko": "아니, 이제 아무래도 좋다,"},
{"id": "clyu06:24300", "ko": "이미 시간 감각조차 사라진 나에게 시간 따위는 아무래도 좋은 일이다."},
{"id": "clyu06:24400", "ko": "「〜〜〜〜♪」"},
{"id": "clyu06:24500", "ko": "오늘도 아무래도 그 시간이 온 모양이다."},
{"id": "clyu06:24600", "ko": "그건 움직일 수도 없게 된 나에게 유일하게 바깥세상과 닿을 수 있는 시간."},
{"id": "clyu06:24700", "ko": "어둠 속에 한 줄기 빛이 비치더니, 이윽고 그것이 커져 네모나게 잘린 천장이 보였다."},
{"id": "clyu06:24800", "ko": "「타쿠루 오빠, 다녀왔어」"},
{"id": "clyu06:24900", "ko": "소리를 낼 기관마저 잃은 나는, 네모난 빛 속에서 들여다보는 의붓여동생을 향해 그저 마음속으로 생각했다."},
{"id": "clyu06:25000", "ko": "――어서 와, 유이."},
{"id": "clyu06:25100", "ko": "「타쿠루 오빠…… 괜찮아? 안색이 안 좋아 보이는데?」"},
{"id": "clyu06:25200", "ko": "「아, 아아. 좀 피곤할 뿐이야. 괜찮아」"},
{"id": "clyu06:25300", "ko": "왠지 굉장히 끔찍한 망상을 해 버렸다."},
{"id": "clyu06:25400", "ko": "……아니, 괜찮다."},
{"id": "clyu06:25500", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:25600", "ko": "「후훗」"},
{"id": "clyu06:25700", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:25800", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu06:25900", "ko": "「잘~ 먹겠습니다~!」"},
{"id": "clyu06:26000", "ko": "「잘 먹겠습니다!」"},
{"id": "clyu06:26100", "ko": "「…………」"},
{"id": "clyu06:26200", "ko": "「덥석…… 우물, 냠…… 음!」"},
{"id": "clyu06:26300", "ko": "「우물우물우물……」"},
{"id": "clyu06:26400", "ko": "「…………」"},
{"id": "clyu06:26500", "ko": "「……둘 다 요즘 식욕이 굉장하네」"},
{"id": "clyu06:26600", "ko": "「응? 아하하, 한창 클 때니까! 그치~?」"},
{"id": "clyu06:26700", "ko": "「응!」"},
{"id": "clyu06:26800", "ko": "「그건 좋은데, 너무 많이 먹으면 살쪄」"},
{"id": "clyu06:26900", "ko": "「우……」"},
{"id": "clyu06:27000", "ko": "「하하하! 뭐 어떠냐. 젊은 녀석들은 많이 먹어야지」"},
{"id": "clyu06:27100", "ko": "하긴 매일 그만큼 몸을 움직이면 당연히 배도 고프겠지."},
{"id": "clyu06:27200", "ko": "오늘은 좋은 일도 있었으니 원래라면 성대하게 건배라도 하고 싶지만, 대놓고는 할 수 없다는 게 슬픈 점이기도 하다."},
{"id": "clyu06:27300", "ko": "축하는 언젠가 다시 따로 뭔가 생각하기로 하자."},
{"id": "clyu06:27400", "ko": "그렇다고 여기서 마음을 놓을 수는 없다."},
{"id": "clyu06:27500", "ko": "두 사람은 이제 겨우 출발선에 섰을 뿐이다."},
{"id": "clyu06:27600", "ko": "받기만 하는 민중은 제멋대로인 법."},
{"id": "clyu06:27700", "ko": "일단 시청자 수는 얻었다고 해도, 앞으로 뭔가 새로운 걸 더 내놓지 않으면 시청자는 떠나 버릴 거다."},
{"id": "clyu06:27800", "ko": "그러려면 앞으로 어떻게 해야 할지 생각해야 한다."},
{"id": "clyu06:27900", "ko": "우리의 싸움은 이제 막 시작되었을 뿐이다!"}
]
