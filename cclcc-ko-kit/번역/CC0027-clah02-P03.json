[
{"id": "clah02:20000", "ko": "「저, 저기 말이야…… 미야시로…… 그…… 좀 비켜…… 줄래?」"},
{"id": "clah02:20100", "ko": "이토가 어째서인지 부끄러운 듯 눈을 피했다."},
{"id": "clah02:20200", "ko": "잠깐!"},
{"id": "clah02:20300", "ko": "그쪽을 보면 ⟦rb⟧팬티⟦rt⟧그거⟦/r⟧가!"},
{"id": "clah02:20400", "ko": "아니, 그렇다 해도 이토가 나를 ⟦rb⟧그쪽⟦rt⟧⟦rbc⟧●●⟦/r⟧ 사람이라고 오해하는 것보다는 낫다."},
{"id": "clah02:20500", "ko": "「미, 미안」"},
{"id": "clah02:20600", "ko": "나는 천천히 침대에서 일어나 이토의 몸을 풀어 주었다."},
{"id": "clah02:20700", "ko": "「아니…… 응?」"},
{"id": "clah02:20800", "ko": "이토의 시선이 문제의 물건을 포착했다."},
{"id": "clah02:20900", "ko": "「뭐야, 이거?」"},
{"id": "clah02:21000", "ko": "아아…… 이제 끝이다."},
{"id": "clah02:21100", "ko": "「팬티? 게다가 이거 여자 거잖아! 야, 미야시로! 왜 이런 데 여자 팬티가 있는 건데!?」"},
{"id": "clah02:21200", "ko": "「그, 그건……」"},
{"id": "clah02:21300", "ko": "「!? 그렇구나…… 너, 역시……!」"},
{"id": "clah02:21400", "ko": "「아, 아니야! 그건…… 그, 그래! 내 거야!!!」"},
{"id": "clah02:21500", "ko": "「엥?」"},
{"id": "clah02:21600", "ko": "아차."},
{"id": "clah02:21700", "ko": "나도 모르게 말해 버렸다."},
{"id": "clah02:21800", "ko": "「실은 그…… 나, 집에 있을 때는 늘 그걸 입고 있어서……」"},
{"id": "clah02:21900", "ko": "「그, 그 말은…… 이 란제리를, 말이냐?」", "note": "パンツ(팬티)와 구별되는 パンティー 를 「란제리」로 — 「パンティーって言うな」 딴지를 살리려고"},
{"id": "clah02:22000", "ko": "란제리라고 하지 마."},
{"id": "clah02:22100", "ko": "……라고 딴지 걸 때가 아니다."},
{"id": "clah02:22200", "ko": "「이 란제리를 네가?」"},
{"id": "clah02:22300", "ko": "아무튼 이미 말해 버린 건 어쩔 수 없다."},
{"id": "clah02:22400", "ko": "이렇게 된 이상 이대로 밀어붙이는 수밖에 없다."},
{"id": "clah02:22500", "ko": "나는 이토를 향해 천천히 고개를 끄덕였다."},
{"id": "clah02:22600", "ko": "「그, 그렇구나…… 그, 뭐랄까…… 뭐, 취향은 사람마다 다르지, 응……」"},
{"id": "clah02:22700", "ko": "이토는 느릿느릿 일어섰다."},
{"id": "clah02:22800", "ko": "기분 탓인지 나와 거리를 둔 것 같다."},
{"id": "clah02:22900", "ko": "「부, 부탁이야, 이토! 이 일, 아무한테도 말하지 말아 줘!」"},
{"id": "clah02:23000", "ko": "「아, 아아…… 말 안 해…… 아무한테도……」"},
{"id": "clah02:23100", "ko": "나와 일정한 거리를 둔 채, 이토는 천천히 문 쪽으로 돌아가더니 그대로 슬금슬금 뒷걸음질 쳤다."},
{"id": "clah02:23200", "ko": "「미, 미안했다. 방해해서. 나 슬슬……」"},
{"id": "clah02:23300", "ko": "「으, 응……」"},
{"id": "clah02:23400", "ko": "「그, 그럼 간다!!!」"},
{"id": "clah02:23500", "ko": "말이 끝나기도 전에 이토는 문을 거칠게 열고 도망치듯 떠나갔다."},
{"id": "clah02:23600", "ko": "「…………」"},
{"id": "clah02:23700", "ko": "정말 괜찮았던 걸까, 이걸로……"},
{"id": "clah02:23800", "ko": "「란제리……」"},
{"id": "clah02:23900", "ko": "얼떨결에 그런 말을 했지만…… 정말로 입어 보면 어떤 기분일까."},
{"id": "clah02:24000", "ko": "아니, 그만둬, 미야시로 타쿠루!"},
{"id": "clah02:24100", "ko": "그 호기심은 너 자신을 죽이는 칼날이 될 거다!"},
{"id": "clah02:24200", "ko": "하지만……"},
{"id": "clah02:24300", "ko": "뭐든 경험이라고들 하고……"},
{"id": "clah02:24400", "ko": "「읏……」"},
{"id": "clah02:24500", "ko": "나는 솟구치는 흥미를 거스르지 못하고, 무의식중에 바지에 손을 대고 있었다."},
{"id": "clah02:24600", "ko": "그리고……"},
{"id": "clah02:24700", "ko": "그 금단의 고리 안에 한쪽 다리를 넣고 말았다."},
{"id": "clah02:24800", "ko": "「뭐, 뭐야 이건――!!」"},
{"id": "clah02:24900", "ko": "그건 그야말로 충격이라고 해야 할 감촉이었다."},
{"id": "clah02:25000", "ko": "「이 착 감기는 느낌! 그리고 매끄러운 감촉! 이게…… 여자의 란제리!!」"},
{"id": "clah02:25100", "ko": "이걸 체감해 버린 지금, 이제 앞으로 트렁크나 박서 팬티, 하물며 삼각팬티 따위는 못 입는다!!!"},
{"id": "clah02:25200", "ko": "고마워, 아리무라!"},
{"id": "clah02:25300", "ko": "나에게 새로운 기쁨을 가르쳐 줘서!"},
{"id": "clah02:25400", "ko": "앞으로도 나는 여성용 속옷을 계속 착용하리라."},
{"id": "clah02:25500", "ko": "「잠깐…… 위는 어떨까?」"},
{"id": "clah02:25600", "ko": "아래만으로는 불완전한 느낌이 든다."},
{"id": "clah02:25700", "ko": "그래, 그렇게 정했으면 지금 당장 사러 가자!"},
{"id": "clah02:25800", "ko": "나는 바지를 입자마자 그대로 두근거리는 가슴을 안고 밖으로 뛰쳐나갔다!"},
{"id": "clah02:25900", "ko": "「기다려라, 브래지어!!」"},
{"id": "clah02:26000", "ko": "새로운 기쁨을 향한 추구는 이제 막 시작되었을 뿐이다!!!"},
{"id": "clah02:26100", "ko": "아니, 그럴 리 없어!!"},
{"id": "clah02:26200", "ko": "나한테는 결코 그런 취미는 없다!!!"},
{"id": "clah02:26300", "ko": "「아, 안 돼!」"},
{"id": "clah02:26400", "ko": "이토의 턱을 잡고 반쯤 억지로 내 쪽을 보게 한다."},
{"id": "clah02:26500", "ko": "「아……」"},
{"id": "clah02:26600", "ko": "어라?"},
{"id": "clah02:26700", "ko": "뭐지, 이 가슴의 두근거림은."},
{"id": "clah02:26800", "ko": "그보다 이토."},
{"id": "clah02:26900", "ko": "너는 또 왜 그렇게 애틋한 얼굴을 하고 있는 건데?"},
{"id": "clah02:27000", "ko": "「미야시로…… 너…… 혹시……」"},
{"id": "clah02:27100", "ko": "「이, 이토……」"},
{"id": "clah02:27200", "ko": "「그렇구나…… 미안하다…… 지금까지 알아주지 못해서……」"},
{"id": "clah02:27300", "ko": "「아, 아니야…… 나는……」"},
{"id": "clah02:27400", "ko": "「실은 말이야…… 나도……」"},
{"id": "clah02:27500", "ko": "「어……?」"},
{"id": "clah02:27600", "ko": "「나도 실은 너랑 같아서……」"},
{"id": "clah02:27700", "ko": "같다고?"},
{"id": "clah02:27800", "ko": "무슨 뜻이지?"},
{"id": "clah02:27900", "ko": "「나도 전부터 너를……」"},
{"id": "clah02:28000", "ko": "「거짓말…… 이지?」"},
{"id": "clah02:28100", "ko": "「그러니까 네가 이쪽 사람이란 걸 알게 돼서 기뻐. 다 같이 행복해지자고」"},
{"id": "clah02:28200", "ko": "「다, 같이?」"},
{"id": "clah02:28300", "ko": "그때 갑자기 우렁찬 목소리와 함께 문이 열렸다."},
{"id": "clah02:28400", "ko": "「드디어 진정한 사랑을 깨달은 모양이군, 미야시로 군!」"},
{"id": "clah02:28500", "ko": "「신조 씨? 그리고……」"},
{"id": "clah02:28600", "ko": "「어서 오게, 우리의 세계에!」"},
{"id": "clah02:28700", "ko": "와쿠이 선생님까지……"},
{"id": "clah02:28800", "ko": "「자, 잠깐. 이게 어떻게 된 거냐고!?」"},
{"id": "clah02:28900", "ko": "「우리는 말일세. 같은 취미를 가진 자로서 이 세계에 새로운 왕국을 세우는――그런 뜻을 품은 동지라네」"},
{"id": "clah02:29000", "ko": "새로운 왕국?"},
{"id": "clah02:29100", "ko": "이제 뭐가 뭔지 모르겠다."},
{"id": "clah02:29200", "ko": "「우리를 거들떠보지도 않는 여자라는 존재는 이 세상에 필요 없어. 세상엔 남자만 있으면 돼!」"},
{"id": "clah02:29300", "ko": "「이 친구 말대로다, 미야시로 군. 건방진 트윈테일 여자도, 과학자인지 뭔지 모르겠지만 사람을 쓰레기 취급하는 거만한 여자도 필요 없어」"},
{"id": "clah02:29400", "ko": "「우리 남자들끼리만 눈부신 사랑의 세계를 엮어 나가자고」"},
{"id": "clah02:29500", "ko": "「아, 아니! 나는 그런 취미가――!」"},
{"id": "clah02:29600", "ko": "「무슨 소리인가. 방금 자네는 몸소 행동해서 우리에게 보여 주지 않았나」"},
{"id": "clah02:29700", "ko": "「그래. 모처럼 낸 용기를 부정하면 안 되지」"},
{"id": "clah02:29800", "ko": "「아니에요! 그건――」"},
{"id": "clah02:29900", "ko": "「그럼 우리의 국왕을 불러 보도록 하지」"}
]
