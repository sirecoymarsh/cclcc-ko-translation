[
{"id": "clka11:10000", "ko": "「그러니까 나는 네 능력으로 나타난 게 아니라는 거지」"},
{"id": "clka11:10100", "ko": "「간단하지?」"},
{"id": "clka11:10200", "ko": "「드, 듣고 보니 그 말이 맞긴 한데……」"},
{"id": "clka11:10300", "ko": "「그, 그럼 너는 대체……?」"},
{"id": "clka11:10400", "ko": "「으음, 가르쳐 주는 건 간단하지만, 네가 직접 생각해 봤으면 좋겠네」"},
{"id": "clka11:10500", "ko": "핑크 하나는 잠깐 생각하더니, 놀리는 듯한 눈길을 하나에게 보냈다."},
{"id": "clka11:10600", "ko": "「이제 신문부로는 못 돌아간다며? 그럼 시간은 조금 더 있잖아」"},
{"id": "clka11:10700", "ko": "『조금 더』가 무슨 뜻인지 잘 몰랐지만, 하나는 처음부터 생각해 보기로 했다."},
{"id": "clka11:10800", "ko": "（애초의 계기는, 타쿠루 선배의 메모가 적힌 쿨 캣 프레스를 읽은 거였어）"},
{"id": "clka11:10900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka11:11000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka11:11100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka11:11200", "ko": "（나는 그게 내가 능력을 발현시킨 결과라고 생각했는데, 그게 아니라면――）"},
{"id": "clka11:11300", "ko": "「……」"},
{"id": "clka11:11400", "ko": "「……응?」"},
{"id": "clka11:11500", "ko": "카즈키는 그제야 겨우, 지금까지 전혀 의식하지 않았던 가능성을 깨달았다."},
{"id": "clka11:11600", "ko": "「으으음?」"},
{"id": "clka11:11700", "ko": "아니, 사실은 한참 전부터 알아차리고 있었지만, 너무나도 어처구니가 없어서 지금까지 무시해 온 것이었다."},
{"id": "clka11:11800", "ko": "「으으으으으음?」"},
{"id": "clka11:11900", "ko": "왜냐하면 그게 사실일 경우, 너무나도 ⟦rb⟧부끄러운 일⟦rt⟧⟦rbc⟧●●●●●⟦/r⟧이었기 때문이다."},
{"id": "clka11:12000", "ko": "「으으으으으음!!!!!??????」"},
{"id": "clka11:12100", "ko": "「어때? 답은 찾았어?」"},
{"id": "clka11:12200", "ko": "「……」"},
{"id": "clka11:12300", "ko": "「……서,」"},
{"id": "clka11:12400", "ko": "「……서서서서, 설마아……」"},
{"id": "clka11:12500", "ko": "말소리가 저절로 작아져 버린다. 『하나』는 짐짓 귀에 손을 대고 이쪽으로 내밀었다."},
{"id": "clka11:12600", "ko": "「응? 설마?」"},
{"id": "clka11:12700", "ko": "「너는……」"},
{"id": "clka11:12800", "ko": "「나는?」"},
{"id": "clka11:12900", "ko": "「나의……」"},
{"id": "clka11:13000", "ko": "「너의?」"},
{"id": "clka11:13100", "ko": "「……착」", "note": "13100~13800: お(思いこみ)를 끌며 뜸 들이는 대목 — 「착(각)」의 첫소리로 맞춤"},
{"id": "clka11:13200", "ko": "「착?」"},
{"id": "clka11:13300", "ko": "「……차악」"},
{"id": "clka11:13400", "ko": "「착?」"},
{"id": "clka11:13500", "ko": "「……차악!」"},
{"id": "clka11:13600", "ko": "「자, 말해 버려!」"},
{"id": "clka11:13700", "ko": "「으음!」"},
{"id": "clka11:13800", "ko": "「차…… 착각인 거야!?」"},
{"id": "clka11:13900", "ko": "「대〜정답!」"},
{"id": "clka11:14000", "ko": "「거, 짓말!?」"},
{"id": "clka11:14100", "ko": "「나는 능력으로 태어난 게 아니야」"},
{"id": "clka11:14200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka11:14300", "ko": "「하지만 그건 인격이 하나 더 있다고 자기 자신한테 암시를 걸고 있을 뿐이고, 어느 쪽이든 너라는 거지」"},
{"id": "clka11:14400", "ko": "「다만 이쪽 인격으로 바뀌어 있는 동안은 『이건 내 의지가 아니야』라고 핑계를 대면서 리미터를 풀 수 있어」"},
{"id": "clka11:14500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka11:14600", "ko": "「그게 좋은 일인지 나쁜 일인지는 모르겠지만, 나는 딱히 신경 안 써」"},
{"id": "clka11:14700", "ko": "「그야, 나는 너인걸」"},
{"id": "clka11:14800", "ko": "「자자자자자자, 잠깐만!」"},
{"id": "clka11:14900", "ko": "『하나』가 즐겁게 정답 풀이를 늘어놓지만, 하나에게는 그걸 가만히 듣고 있을 여유가 없었다."},
{"id": "clka11:15000", "ko": "머릿속은 대혼란이다."},
{"id": "clka11:15100", "ko": "「어, 그럼, 어?」"},
{"id": "clka11:15200", "ko": "「네가…… 아니, 내가 지금까지 해 온 일들은……」"},
{"id": "clka11:15300", "ko": "「으음, 글쎄……」"},
{"id": "clka11:15400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka11:15500", "ko": "「하우우웃!?」"},
{"id": "clka11:15600", "ko": "너무 부끄러워서 얼굴이 새빨개지고, 머리를 마구 쥐어뜯는다."},
{"id": "clka11:15700", "ko": "「게게게게, 게다가, 네가 나라는 건……」"},
{"id": "clka11:15800", "ko": "「네가 지금까지 선배한테 해 온 일들은……」"},
{"id": "clka11:15900", "ko": "「그런 거지」"},
{"id": "clka11:16000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka11:16100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka11:16200", "ko": "「하와와아아아아아앗!!!!????」"},
{"id": "clka11:16300", "ko": "사람은 수치심 때문에 기절할 수 있을까?"},
{"id": "clka11:16400", "ko": "지금 막 너무 부끄러운 나머지 머릿속이 새하얘지고 있는 카즈키가 그걸 증명할지도 모른다."},
{"id": "clka11:16500", "ko": "「하우우……」"},
{"id": "clka11:16600", "ko": "몸이 휘청 흔들렸을 때, 어느새 『하나』가 눈앞에 와서 두 어깨를 받쳐 주었다."},
{"id": "clka11:16700", "ko": "「정신 차려. 이런 데서 기절하거나 하지 마. 내 몸이 감기 걸리잖아」"},
{"id": "clka11:16800", "ko": "「게다가 내일 아침에 청소부나 누가 발견하면 뭐라고 변명할 건데?」"},
{"id": "clka11:16900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka11:17000", "ko": "「우우우, 나 자신한테 지적당하고 있어……」"},
{"id": "clka11:17100", "ko": "「아」"},
{"id": "clka11:17200", "ko": "「어?」"},
{"id": "clka11:17300", "ko": "「방금 『나 자신』이라고 했지. 그거 좋은 징조야」"},
{"id": "clka11:17400", "ko": "「내가 너라는 걸 받아들이고 있는 거야」"},
{"id": "clka11:17500", "ko": "「아……」"},
{"id": "clka11:17600", "ko": "「솔직하게, 단순하게 생각하면 답 같은 건 금방 찾을 수 있어」"},
{"id": "clka11:17700", "ko": "「응……」"},
{"id": "clka11:17800", "ko": "「그래…… 일지도」"},
{"id": "clka11:17900", "ko": "「흐흥. 솔직해서 좋네」"},
{"id": "clka11:18000", "ko": "「그럼, 하나 더 솔직해져 볼까」"},
{"id": "clka11:18100", "ko": "「하나 더?」"},
{"id": "clka11:18200", "ko": "「그래」"},
{"id": "clka11:18300", "ko": "『하나』는 카즈키에게 얼굴을 가까이 대고 속삭였다."},
{"id": "clka11:18400", "ko": "「미야시로 선배를 어떻게 생각해?」"},
{"id": "clka11:18500", "ko": "「하왓!?」"},
{"id": "clka11:18600", "ko": "「그건, 그러니까, 저기……」"},
{"id": "clka11:18700", "ko": "「으으음……!」"},
{"id": "clka11:18800", "ko": "「자기 자신한테 거짓말할 필요는 없어. 아무도 안 듣고 있으니까」"},
{"id": "clka11:18900", "ko": "「어떻게 생각하는지 들려줘」"},
{"id": "clka11:19000", "ko": "「그……」"},
{"id": "clka11:19100", "ko": "「타쿠루…… 선배는……」"},
{"id": "clka11:19200", "ko": "생각한다."},
{"id": "clka11:19300", "ko": "자기 자신에게 거짓말할 필요는 없다. 그 말대로다."},
{"id": "clka11:19400", "ko": "이번 소동은 애초에 자신의 마음을 억지로 눌러 왔기 때문에 일어난 일이다."},
{"id": "clka11:19500", "ko": "이 일을 매듭짓기 위해서는, 자신의 마음을 똑바로 마주 보고 답을 내야 한다."},
{"id": "clka11:19600", "ko": "그리고 그건 지금 해야 하는 일이다."},
{"id": "clka11:19700", "ko": "「……」"},
{"id": "clka11:19800", "ko": "「……응」"},
{"id": "clka11:19900", "ko": "「타쿠루 선배는…… 나한테 있을 곳을 줬어」"}
]
