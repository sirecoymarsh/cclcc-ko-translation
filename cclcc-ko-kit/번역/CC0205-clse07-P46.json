[
{"id": "clse07:437300", "ko": "「이・유! 여기 있는 이유 말이야! 길어도 좋으니까 일단 설명해 봐」"},
{"id": "clse07:437400", "ko": "「그래, 괜찮아」"},
{"id": "clse07:437500", "ko": "「어?」"},
{"id": "clse07:437600", "ko": "「가출?」"},
{"id": "clse07:437700", "ko": "「그게 다야?」"},
{"id": "clse07:437800", "ko": "「두 글자로 끝이잖아!!!」", "note": "원문 「３文字」(いえで) — 한국어 「가출」 두 글자에 맞춤"},
{"id": "clse07:437900", "ko": "「잠깐」"},
{"id": "clse07:438000", "ko": "「바, 방금…… 뭐라고 했어?」"},
{"id": "clse07:438100", "ko": "「기각이다!!」"},
{"id": "clse07:438200", "ko": "「안 되는 게 당연하잖아! 봐 봐! 이 방 어디에 둘이나 잘 공간이 있다는 거야!?」"},
{"id": "clse07:438300", "ko": "「애, 애초에 왜 내 쪽이야? 갈 데라면 얼마든지 있잖아. 예를 들어 카즈키네 ⟦rb⟧기숙사⟦rt⟧집⟦/r⟧라든가」"},
{"id": "clse07:438400", "ko": "「오노에네 집이라든가」"},
{"id": "clse07:438500", "ko": "「그럼 아오바 기숙사는. 뭣하면 내 방이 비어 있을 텐데」"},
{"id": "clse07:438600", "ko": "「연락 정도는 해도 되잖아」"},
{"id": "clse07:438700", "ko": "「그, 그럼…… 이토네 집이라든가……」"},
{"id": "clse07:438800", "ko": "「아니, 아무리 이토라도 그런 짓은……」"},
{"id": "clse07:438900", "ko": "「그건……」"},
{"id": "clse07:439000", "ko": "「왜 나라면 안심인데!?」"},
{"id": "clse07:439100", "ko": "「뭣!!」"},
{"id": "clse07:439200", "ko": "「끄으윽……!」"},
{"id": "clse07:439300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:439400", "ko": "「어……?」"},
{"id": "clse07:439500", "ko": "「아, 아니…… 방금 건 그냥 홧김에 한 말이고, 나는 그럴 생각은……」"},
{"id": "clse07:439600", "ko": "「으……」"},
{"id": "clse07:439700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:439800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:439900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:440700", "ko": "「엥?」"},
{"id": "clse07:440800", "ko": "「……뭐가 말이야?」"},
{"id": "clse07:440900", "ko": "「아리무라아아아아아!!」"},
{"id": "clse07:441000", "ko": "「뭐――!?」"},
{"id": "clse07:441100", "ko": "「이토……」"},
{"id": "clse07:441200", "ko": "「뭐, 뭐야 이거? 어떻게 된 거야?」"},
{"id": "clse07:441300", "ko": "「몰래카메라?」"},
{"id": "clse07:441400", "ko": "「잠깐! 그런 건 나 못 들었다고!」"},
{"id": "clse07:441500", "ko": "「그, 그만둬어어어!!」"},
{"id": "clse07:441600", "ko": "「이, 이럴 수가…… 내 인생은 이제 끝이야아아……!」"},
{"id": "clse07:441700", "ko": "「…………」"},
{"id": "clse07:441800", "ko": "「……뭐가 말이야?」"},
{"id": "clse07:441900", "ko": "「……뭐가 말이야?」"},
{"id": "clse07:442000", "ko": "「안 돼!」"},
{"id": "clse07:442100", "ko": "「아까 그거라니, 뭔데?」"},
{"id": "clse07:442200", "ko": "「크……!」"},
{"id": "clse07:442300", "ko": "「아, 아니. 그래도 안 돼……!」"},
{"id": "clse07:442400", "ko": "「안 되면 안 되는 거야. 애초에 그건 너희 사정이잖아. 내 사생활은 어떻게 되는데!」"},
{"id": "clse07:442500", "ko": "「무리인 게 당연하잖아!」"},
{"id": "clse07:442600", "ko": "「아무튼 지금 당장 나가 줘」"},
{"id": "clse07:442700", "ko": "「뭐라고 해도 안 돼. 아무튼 돌아가」"},
{"id": "clse07:442800", "ko": "「아니……」"},
{"id": "clse07:442900", "ko": "「…………」"},
{"id": "clse07:443000", "ko": "「…………」"},
{"id": "clse07:443100", "ko": "「아리무라!!!」"},
{"id": "clse07:443200", "ko": "「……아직도 이런 데 있었냐」"},
{"id": "clse07:443300", "ko": "「잠깐 음료수 사러 나온 것뿐이야. 그랬더니 네가 있길래……」"},
{"id": "clse07:443400", "ko": "「배고프지? 우리 집에서 뭐라도 먹고 가」"},
{"id": "clse07:443500", "ko": "「……어쩔 수 없잖아. 갈 데가 없다면」"},
{"id": "clse07:443600", "ko": "「…………」"},
{"id": "clse07:443700", "ko": "「후루룩후루룩……」"},
{"id": "clse07:443800", "ko": "「미안하다…… 이런 것밖에 없어서」"},
{"id": "clse07:443900", "ko": "「…………」"},
{"id": "clse07:444000", "ko": "「아니, 아리무라라면 『저녁으로 컵라면이라니, 진심이에요?』 정도는 말할 줄 알았는데……」"},
{"id": "clse07:444100", "ko": "「그렇지. 그 밖엔 편의점 도시락을 사거나, 칼로리 블록이거나……」"},
{"id": "clse07:444200", "ko": "「너까지 쿠루스 같은 소리 하지 마」"},
{"id": "clse07:444300", "ko": "「하아아암……」"},
{"id": "clse07:444400", "ko": "「어? 아, 그, 그렇지, 응」"},
{"id": "clse07:444500", "ko": "「아, 아리무라는 거기 이불 써도 돼」"},
{"id": "clse07:444600", "ko": "「나는 침낭이 있으니까……」"},
{"id": "clse07:444700", "ko": "「여, 여자애를 침낭에서 재울 수는 없잖아」"},
{"id": "clse07:444800", "ko": "「바, 바바바바바바바바보 같은 소리 하지 마!」"},
{"id": "clse07:444900", "ko": "「나는 언제나 신사다」"},
{"id": "clse07:445000", "ko": "「그, 그럴 리가 있냐!」"},
{"id": "clse07:445100", "ko": "「그거…… 뭐 하는 거야?」"},
{"id": "clse07:445200", "ko": "「…………」"},
{"id": "clse07:445300", "ko": "「…………」"},
{"id": "clse07:445400", "ko": "「…………」"},
{"id": "clse07:445500", "ko": "「으〜! 으으〜!」"},
{"id": "clse07:445600", "ko": "「푸핫!!!!」"},
{"id": "clse07:445700", "ko": "「하아, 하아……」"},
{"id": "clse07:445800", "ko": "「주, 죽일 셈이냐!!!」"},
{"id": "clse07:445900", "ko": "「그게 아니야! 너 방금 내 코랑 입 막았잖아! 보통 아침에는 좀 더 상냥하게 깨우는 거 아니냐?」"},
{"id": "clse07:446000", "ko": "「하마터면 영원히 못 일어날 뻔했잖아!」"},
{"id": "clse07:446100", "ko": "「뭐?」"},
{"id": "clse07:446200", "ko": "「그보다 아리무라. 오늘은 집에――」"},
{"id": "clse07:446300", "ko": "「알겠지? 당분간 여기서 묵고 있다는 건 아무한테도 들키지 않게 해」"},
{"id": "clse07:446400", "ko": "「모, 몰라. 왜 나한테 물어?」"},
{"id": "clse07:446500", "ko": "「나, 나는 딱히 아리무라랑 특별히 친한 게 아니야!!」"},
{"id": "clse07:446600", "ko": "「어?」"},
{"id": "clse07:446700", "ko": "「아……」"},
{"id": "clse07:446800", "ko": "「아, 아니, 딱히 그런 건……」"},
{"id": "clse07:446900", "ko": "「안 돼!!」"},
{"id": "clse07:447000", "ko": "「아…………」"},
{"id": "clse07:447100", "ko": "「아〜, 그, 그러니까, 뭐냐…… 오늘은 좀 들를 데가 있어서. 그러니까……」"},
{"id": "clse07:447200", "ko": "「아〜. 그러고 보니 볼일이 있었지. 미안하지만 먼저 갈게」"}
]
