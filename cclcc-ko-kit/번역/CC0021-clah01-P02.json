[
{"id": "clah01:9900", "ko": "「호오오…… 그렇군요. 『이렇게 하면 여자는 넘어온다. 남자의 ⟦col:280aa02d1400⟧48수⟦col:800000⟧』 『⟦col:280aa02e1400⟧크리스마스⟦col:800000⟧ 전에 반드시 여자 친구를 GET!』이라……」"},
{"id": "clah01:10000", "ko": "「너, 너 어느새!!」"},
{"id": "clah01:10100", "ko": "어느새 아리무라의 손에 들려 있던 쿨 캣을 빼앗았다."},
{"id": "clah01:10200", "ko": "「그러니까 선배가 떨어뜨렸다니까요」"},
{"id": "clah01:10300", "ko": "「큭……」"},
{"id": "clah01:10400", "ko": "만약 과거의 나에게 어떤 방법으로든 메시지를 보낼 수 있다면 말해 주고 싶다."},
{"id": "clah01:10500", "ko": "“끝까지 방심하지 마라”라고."},
{"id": "clah01:10600", "ko": "아니, 아니면 “나갈 때는 문을 잠가라”인가."},
{"id": "clah01:10700", "ko": "「〜〜♪」"},
{"id": "clah01:10800", "ko": "어느 쪽이든, 평온하다고 생각했던 나의 하루는 이 녀석이 나타난 덕분에 와르르 무너져 버렸다."},
{"id": "clah01:10900", "ko": "「자자, 좁은 곳이지만 그쪽에라도 앉아서 편히 쉬세요」"},
{"id": "clah01:11000", "ko": "「네가 할 소리냐!」"},
{"id": "clah01:11100", "ko": "그렇게 말하면서도 시키는 대로 소파 베드에 앉는 내가 원망스럽다."},
{"id": "clah01:11200", "ko": "「그래서?」"},
{"id": "clah01:11300", "ko": "「네?」"},
{"id": "clah01:11400", "ko": "「이・유! 여기 있는 이유 말이야! 길어도 되니까 일단 설명해 봐」"},
{"id": "clah01:11500", "ko": "「그야 물론, 선배가 보고 싶어서――」"},
{"id": "clah01:11600", "ko": "다짜고짜 아리무라의 손을 잡고 문 쪽으로 끌고 간다."},
{"id": "clah01:11700", "ko": "「으와앗, 농담! 농담이라니까〜!」"},
{"id": "clah01:11800", "ko": "예상외로 강하게 저항하길래 손을 놓자, 겨우 얌전해진 아리무라는 한숨을 한 번 쉬고 이야기를 시작했다."},
{"id": "clah01:11900", "ko": "「설명해도 되지만, 아까도 말했듯이 길어질 거예요?」"},
{"id": "clah01:12000", "ko": "「괜찮아, 상관없어」"},
{"id": "clah01:12100", "ko": "「그렇슴까. 그럼 최대한 짧게 말할게요…… 으〜음, 뭐라고 하면 좋을까…… 좋은 말이 안 떠오름다만……」"},
{"id": "clah01:12200", "ko": "「가출?」"},
{"id": "clah01:12300", "ko": "「어?」"},
{"id": "clah01:12400", "ko": "「그러니까…… 가・출?」"},
{"id": "clah01:12500", "ko": "「가출?」"},
{"id": "clah01:12600", "ko": "「예스! 댓츠 롸잇!」"},
{"id": "clah01:12700", "ko": "「이상?」"},
{"id": "clah01:12800", "ko": "「이상」"},
{"id": "clah01:12900", "ko": "「두 글자로 끝이잖아!!!」", "note": "원문 「３文字」는 いえで(세 글자) — 한국어 「가출」에 맞춰 두 글자로"},
{"id": "clah01:13000", "ko": "「아니〜, 엄마랑 싸워 버려서요. 어른들은 왜 그렇게 자기 일은 제쳐 두고 설교만 하는 걸까요〜」"},
{"id": "clah01:13100", "ko": "안 되겠다…… ⟦rb⟧아리무라⟦rt⟧이 녀석⟦/r⟧이랑 있으면 정말 피곤하다……"},
{"id": "clah01:13200", "ko": "그야 아리무라네 어머니도 잔소리 한두 마디쯤 하고 싶어지겠지."},
{"id": "clah01:13300", "ko": "「그런 고로, 당분간 여기서 신세 좀 지겠으니, 그 점 잘 좀 부탁드려요」"},
{"id": "clah01:13400", "ko": "네네. 이제 좋을 대로――"},
{"id": "clah01:13500", "ko": "「잠깐」"},
{"id": "clah01:13600", "ko": "「네?」"},
{"id": "clah01:13700", "ko": "「바, 방금…… 뭐라고 했어?」"},
{"id": "clah01:13800", "ko": "「그러니까 당분간 여기서 신세 지겠다고요」"},
{"id": "clah01:13900", "ko": "「기각이다!!」"},
{"id": "clah01:14000", "ko": "「에〜, 왜〜?」"},
{"id": "clah01:14100", "ko": "누가 봐도 뜻밖이라는 듯한 몸짓으로 아리무라는 싫다는 듯 고개를 저었다."},
{"id": "clah01:14200", "ko": "「당연히 안 되지! 봐 봐! 이 방 어디에 둘이나 잘 공간이 있어!?」"},
{"id": "clah01:14300", "ko": "「⟦col:280aa02d1400⟧서면 다다미 반 장, 누우면 한 장⟦col:800000⟧. 이만큼만 있으면 충분해요〜」", "note": "立って半畳寝て一畳(사람에게 필요한 자리는 얼마 되지 않는다는 옛말)"},
{"id": "clah01:14400", "ko": "또 고리타분한 말을."},
{"id": "clah01:14500", "ko": "「게다가 이쪽 소파도 침대가 되는 거죠? 아까 확인했어요」"},
{"id": "clah01:14600", "ko": "큭…… 눈치 빠른 녀석."},
{"id": "clah01:14700", "ko": "「애, 애초에 왜 하필 나한테 오는 건데? 다른 데 갈 곳은 얼마든지 있잖아. 예를 들면 카즈키네 ⟦rb⟧기숙사⟦rt⟧집⟦/r⟧라든가」"},
{"id": "clah01:14800", "ko": "「얼마 전에 친구를 불러서 난리를 친 애가 있어서, 입주자 외에는 출입이 엄격해졌대」"},
{"id": "clah01:14900", "ko": "「오노에네라든가」"},
{"id": "clah01:15000", "ko": "「세리는 왠지 완강하게 거부한단 말임다〜」"},
{"id": "clah01:15100", "ko": "그러고 보니 나 말고는 방에 들인 적이 없다고 했었지."},
{"id": "clah01:15200", "ko": "「그럼 아오바 기숙사는. 뭣하면 내 방이 비어 있을 텐데」"},
{"id": "clah01:15300", "ko": "「쿠루스 선배는 저희 부모님께 양해 연락을 하겠죠, 절대로」"},
{"id": "clah01:15400", "ko": "확실히 쿠루스라면 틀림없이 그렇게 하겠지."},
{"id": "clah01:15500", "ko": "「뭐 어때, 연락 정도는」"},
{"id": "clah01:15600", "ko": "「그럼 가출이 안 되잖아」"},
{"id": "clah01:15700", "ko": "그런 건가?"},
{"id": "clah01:15800", "ko": "「그, 그럼…… 이토네라든가……」"},
{"id": "clah01:15900", "ko": "「너무해! 미야시로 선배는 제가 몸을 버려도 괜찮다는 거군요!」"},
{"id": "clah01:16000", "ko": "몸을 버린다니……"},
{"id": "clah01:16100", "ko": "「그치만 이토 선배예요? 분명 밤마다 저한테 차마 입에 담을 수 없는 이런 짓 저런 짓을……」"},
{"id": "clah01:16200", "ko": "「저…… 저는 싫다고 하는데도…… 그래도 그 사람은 억지로…… 흑흑흑흑흑……」"},
{"id": "clah01:16300", "ko": "불쌍하게도, 이토 녀석."},
{"id": "clah01:16400", "ko": "있지도 않은 일로 멋대로 범죄자 취급을 받다니."},
{"id": "clah01:16500", "ko": "「아니, 아무리 이토라도 그런 짓은……」"},
{"id": "clah01:16600", "ko": "「안 한다고 할 수 있어요?」"},
{"id": "clah01:16700", "ko": "「그건……」"},
{"id": "clah01:16800", "ko": "……완전히 부정할 수 없다는 게 더 슬픈 점이다."},
{"id": "clah01:16900", "ko": "미안하다, 이토."},
{"id": "clah01:17000", "ko": "「그 점에서 미야시로 선배라면 안심이니까요」"},
{"id": "clah01:17100", "ko": "「왜 나라면 안심인데!?」"},
{"id": "clah01:17200", "ko": "「그치만〜, 미야시로 선배는 쫄보잖아요〜」"},
{"id": "clah01:17300", "ko": "「뭐!!」"},
{"id": "clah01:17400", "ko": "「세리 같은 소꿉친구랑, 쿠루스 선배 같은 피 안 섞인 누나가 있다는, 미소녀 게임 주인공 같은 위치에 있으면서……」"},
{"id": "clah01:17500", "ko": "「아무 진전도 없이 바보처럼 특종만 쫓아다니다니, 그야말로 쫄보의 극치」"},
{"id": "clah01:17600", "ko": "「그런 미야시로 선배니까, 히나에는 안심하고 기댈 수 있는 것이지 말입니다」"},
{"id": "clah01:17700", "ko": "「끄으으……!」"},
{"id": "clah01:17800", "ko": "이 녀석…… 가만히 듣고 있자니 하고 싶은 말 다 하네!"},
{"id": "clah01:17900", "ko": "「나, 나도 남자다! 막상 때가 되면 무슨 짓을 할지 모른다고!」"},
{"id": "clah01:18000", "ko": "「상관…… 없어요」"},
{"id": "clah01:18100", "ko": "「어……?」"},
{"id": "clah01:18200", "ko": "「미야시로 선배라면…… 괜찮아요……」"},
{"id": "clah01:18300", "ko": "뭐, 뭐야, 갑자기 얌전해져서는."},
{"id": "clah01:18400", "ko": "「아, 아니…… 방금 그건 그냥 홧김에 한 말이고, 나는 그럴 생각은……」"},
{"id": "clah01:18500", "ko": "「저는 매력이…… 없나요?」"},
{"id": "clah01:18600", "ko": "「윽……」"},
{"id": "clah01:18700", "ko": "「단둘이 이렇게 좁은 방에 있어도 그런 마음이 안 생길 만큼 안 귀여워요?」"},
{"id": "clah01:18800", "ko": "잠깐."},
{"id": "clah01:18900", "ko": "뭘 두근거리고 있는 거야."},
{"id": "clah01:19000", "ko": "상대는 아리무라라고."},
{"id": "clah01:19100", "ko": "그런 마음이 생길 리가……"},
{"id": "clah01:19200", "ko": "「만져도…… 괜찮아요……」"},
{"id": "clah01:19300", "ko": "「엥? 마, 만지라니…… 어, 어, 어디를……?」"},
{"id": "clah01:19400", "ko": "「아주…… 말랑한 곳이요……」"},
{"id": "clah01:19500", "ko": "「꿀꺽……!」"},
{"id": "clah01:19600", "ko": "「만지고 싶지 않아요?」"},
{"id": "clah01:19700", "ko": "안 되겠다."},
{"id": "clah01:19800", "ko": "나는 더는 못 참겠어!!"}
]
