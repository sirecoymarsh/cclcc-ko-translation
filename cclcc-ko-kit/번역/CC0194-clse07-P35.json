[
{"id": "clse07:328100", "ko": "「무슨 걱정거리가 있으면 언제든지 상담하러――」"},
{"id": "clse07:328200", "ko": "「……너희, 뭐 하고 있는 거야?」"},
{"id": "clse07:328300", "ko": "「타, 타쿠루…… 너, 설마……!」"},
{"id": "clse07:328400", "ko": "「……타쿠루」"},
{"id": "clse07:328500", "ko": "「타쿠루」"},
{"id": "clse07:328600", "ko": "「각오는 돼 있겠지?」"},
{"id": "clse07:328700", "ko": "「적당히 좀 하라고오〜!!!!!!」"},
{"id": "clse07:328800", "ko": "「아직도 그런 뻔한 거짓말을 하는 거야!?」"},
{"id": "clse07:328900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:329000", "ko": "「아빠한테 뭐라고 말해야 할까……」"},
{"id": "clse07:329100", "ko": "「정말! 적당히 좀 하라고오〜!!!!!」"},
{"id": "clse07:329200", "ko": "「각오는 돼 있겠지?」"},
{"id": "clse07:329300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:329400", "ko": "「봐! 카즈키, 완전히 겁먹었잖아!」"},
{"id": "clse07:329500", "ko": "「나쁜 건 너야! 타쿠루!」"},
{"id": "clse07:329600", "ko": "「변명의 여지는 없는 것 같네」"},
{"id": "clse07:329700", "ko": "「역시 경찰을 부르자」"},
{"id": "clse07:329800", "ko": "「……」"},
{"id": "clse07:329900", "ko": "「카즈키, 이 메일 보낸 거 너야?」"},
{"id": "clse07:330000", "ko": "「아닌 것 같네」"},
{"id": "clse07:330100", "ko": "「타쿠루, 가짜 메일까지 준비해서 죄에서 벗어나려는 거야?」"},
{"id": "clse07:330200", "ko": "「잠자코 있지 말고 뭐라고 말 좀 해 봐, 타쿠루」"},
{"id": "clse07:330300", "ko": "「세리카 말대로 무슨 이유가 있었어?」"},
{"id": "clse07:330400", "ko": "「타쿠루?」"},
{"id": "clse07:330500", "ko": "「……타쿠루」"},
{"id": "clse07:330600", "ko": "「인정하는 거구나」"},
{"id": "clse07:330700", "ko": "「나는 아니지만……」"},
{"id": "clse07:330800", "ko": "「카즈키?」"},
{"id": "clse07:330900", "ko": "「어?」"},
{"id": "clse07:331000", "ko": "「잠깐, 카즈키, 그거 정말이야!?」"},
{"id": "clse07:331100", "ko": "「어, 그치만, 그럼 어떻게 된 거야?」"},
{"id": "clse07:331200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:331300", "ko": "「뭣!?」"},
{"id": "clse07:331400", "ko": "「어떻게, 된 거야?」"},
{"id": "clse07:331500", "ko": "「……아니」"},
{"id": "clse07:331600", "ko": "「카즈키의 능력은 『입 밖에 낸 게 구현화되는 능력』이야. 경우에 따라서는 새로운 인격까지도」"},
{"id": "clse07:331700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:331800", "ko": "「타쿠루!? 갑자기 왜 그래?」"},
{"id": "clse07:331900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:332000", "ko": "「으으으, 내 동생이지만 그렇게까지 커뮤니케이션 능력이 낮다니……」"},
{"id": "clse07:332100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:332200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:332300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:332400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:332500", "ko": "「타쿠루」"},
{"id": "clse07:332600", "ko": "「……타쿠루」"},
{"id": "clse07:332700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:332800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:332900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:333000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:333100", "ko": "「……타쿠루」"},
{"id": "clse07:333200", "ko": "「아직도 그런 소리를 하는 거야?」"},
{"id": "clse07:333300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:333400", "ko": "「타쿠루. 최악이야, 너」"},
{"id": "clse07:333500", "ko": "「최악!」"},
{"id": "clse07:333600", "ko": "「하아…… 내 동생이지만 기가 막혀」"},
{"id": "clse07:333700", "ko": "「이토는 좀 조용히 해 줄래?」"},
{"id": "clse07:333800", "ko": "「자, 타쿠루, 어떻게 할 거야?」"},
{"id": "clse07:333900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:334000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:334100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:334200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:334300", "ko": "「타쿠루〜? 이거 네가 쓴 거지?」"},
{"id": "clse07:334400", "ko": "「『츤데레가 너무 심하다』는 게 무슨 뜻인지 알려 줄래?」"},
{"id": "clse07:334500", "ko": "「타쿠루?」"},
{"id": "clse07:334600", "ko": "「타쿠루. 잠깐 따라와 줄래?」"},
{"id": "clse07:334700", "ko": "「무슨 볼일이라도 있어?」"},
{"id": "clse07:334800", "ko": "「설령 있다 해도 어차피 별일 아니잖아? 됐으니까 와」"},
{"id": "clse07:334900", "ko": "「네네, 알았으니까 이리 와. 알았지?」"},
{"id": "clse07:335000", "ko": "「그런 거 아니거든요!」"},
{"id": "clse07:335100", "ko": "「그래, 잘 가」"},
{"id": "clse07:335200", "ko": "「안녕. 내일 또 봐」"},
{"id": "clse07:335300", "ko": "「뭐?」"},
{"id": "clse07:335400", "ko": "「그래. 그럼 됐어. 자, 다 왔어」"},
{"id": "clse07:335500", "ko": "「그래」"},
{"id": "clse07:335600", "ko": "「카와하라. 신문부 일로 할 얘기가 있는데……」"},
{"id": "clse07:335700", "ko": "「흐응…… 그러니까 신문부 예산 축소에 관한 건은 내가 알면 곤란한 일이라는 거네」"},
{"id": "clse07:335800", "ko": "「말해 두지만, 타쿠루는 그 건에 대해 아무 말도 안 했어. 다른 사람한테서 들었어」"},
{"id": "clse07:335900", "ko": "「각 부의 예산은 매년 봄 정례 부회에서 정해진다는 건 알고 있지?」"},
{"id": "clse07:336000", "ko": "「한 번 정해진 걸 바꾸려면 교칙과 마찬가지로 전교생 과반수 이상의 찬성이 필요해―― 이것도 알고 있지?」"},
{"id": "clse07:336100", "ko": "「그럼 네가 한 일이 이상하다는 건 알겠지?」"},
{"id": "clse07:336200", "ko": "「그거랑 이건 별개 문제입니다」"},
{"id": "clse07:336300", "ko": "「신문부 활동에 대해서는 내가 책임지고 지도할게. 그러니까 너도 승부 같은 바보 같은 짓은 그만둬. 알았어?」"},
{"id": "clse07:336400", "ko": "「그리고 타쿠루. 네가 신문부 부장으로서 똑바로 하지 않으니까 이렇게 되는 거야. 알고 있어?」"},
{"id": "clse07:336500", "ko": "「너도 거기에 응했다면, 싸움은 쌍방 과실이에요」"},
{"id": "clse07:336600", "ko": "「미안해」"},
{"id": "clse07:336700", "ko": "「아까 일. 타쿠루가 잘못한 게 아니라는 건 알아」"},
{"id": "clse07:336800", "ko": "「그래도 카와하라잖아. 일방적으로 카와하라만 탓하면 분명 또 이상하게 경쟁심을 불태울 테니까……」"},
{"id": "clse07:336900", "ko": "「정말?」"},
{"id": "clse07:337000", "ko": "「다행이다」"},
{"id": "clse07:337100", "ko": "「그나저나 카와하라는 왜 타쿠루만 상대하면 저렇게 되는 걸까」"},
{"id": "clse07:337200", "ko": "「있잖아, 타쿠루. 너 카와하라한테 뭔가 한 거 아니야?」"},
{"id": "clse07:337300", "ko": "「……무슨 소리야?」"},
{"id": "clse07:337400", "ko": "「맞다 맞다, 그리고 그 “쿠루스”라고 부르는 거, 이제 그만해 주면 안 될까?」"},
{"id": "clse07:337500", "ko": "「그건 그렇지만……」"},
{"id": "clse07:337600", "ko": "「이상하다니? 남매니까 딱히 이상하지 않잖아?」"},
{"id": "clse07:337700", "ko": "「그렇게 생각하고 싶은 사람은 그렇게 생각하게 내버려 두면 돼」"},
{"id": "clse07:337800", "ko": "「왜?」"},
{"id": "clse07:337900", "ko": "「있잖아…… 타쿠루. 너, 슬슬 집으로 돌아오지 않을래?」"},
{"id": "clse07:338000", "ko": "「그런 소리 해도, 네가 집안 살림 생각해서 나갔다는 것쯤은 다들 알고 있으니까」"}
]
