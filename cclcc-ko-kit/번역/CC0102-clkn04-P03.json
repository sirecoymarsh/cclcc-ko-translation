[
{"id": "clkn04:20000", "ko": "그런…… 건가?"},
{"id": "clkn04:20100", "ko": "「뭐, 본인은 전혀 몰랐던 모양이지만」"},
{"id": "clkn04:20200", "ko": "「그나저나 저건 아니지~. 그 고백은 아니지~」"},
{"id": "clkn04:20300", "ko": "「『내 여자가 되어라, 쿠루스』라니! 게다가 벽쿵이라니!」"},
{"id": "clkn04:20400", "ko": "「그런 거, 좋아하는 남자애 말고 다른 사람이 하면 깰 뿐이라고」"},
{"id": "clkn04:20500", "ko": "「쓰레기…… 일지도……」"},
{"id": "clkn04:20600", "ko": "멋대로 훔쳐본 것도 모자라 이렇게까지 혹평을 하니, 좀 불쌍한 생각도 드네."},
{"id": "clkn04:20700", "ko": "「아무튼 다들, 아까 본 건――」"},
{"id": "clkn04:20800", "ko": "「미, 미안해, 늦어서」"},
{"id": "clkn04:20900", "ko": "말을 꺼내려는 참에 문이 열리고, 다름 아닌 그 노노가 얼굴을 내밀었다."},
{"id": "clkn04:21000", "ko": "「아, 노노! 아까 그――!!」"},
{"id": "clkn04:21100", "ko": "「우와아아아아아아앗!!!」"},
{"id": "clkn04:21200", "ko": "「응? 읍~, 으흡~!!」"},
{"id": "clkn04:21300", "ko": "황급히 오노에의 입을 막았다."},
{"id": "clkn04:21400", "ko": "「푸하…… 정말, 뭐 하는 거야, 타쿠~」"},
{"id": "clkn04:21500", "ko": "「무슨 생각이야! 아까 일을 처음부터 끝까지 우리가 봤다는 거, 쿠루스한테는 비밀이야」"},
{"id": "clkn04:21600", "ko": "「에~ 왜~?」"},
{"id": "clkn04:21700", "ko": "「무조건이야!」"},
{"id": "clkn04:21800", "ko": "「치이~」"},
{"id": "clkn04:21900", "ko": "「타쿠루? 왜 그래?」"},
{"id": "clkn04:22000", "ko": "「아~ 아니, 아무것도 아니야, 아무것도. 그치, 이토?」"},
{"id": "clkn04:22100", "ko": "「어, 어!」"},
{"id": "clkn04:22200", "ko": "「???」"},
{"id": "clkn04:22300", "ko": "오노에는 불만스러운 듯했지만, 다른 녀석들은 일단 분위기 파악은 하는 것 같았다."},
{"id": "clkn04:22400", "ko": "「뭐, 됐어. 그보다 오늘 부활동은 어떻게 할래?」"},
{"id": "clkn04:22500", "ko": "「아~ 그거 말인데, 나 볼일이 좀 있다는 게 생각나서」"},
{"id": "clkn04:22600", "ko": "「아, 나도 나도!!」"},
{"id": "clkn04:22700", "ko": "「가끔은 문예부에도 얼굴 비춰야지!」"},
{"id": "clkn04:22800", "ko": "「⟦col:280aa02d1400⟧엠스⟦col:800000⟧ 시간 한정 퀘…… 일지도……」"},
{"id": "clkn04:22900", "ko": "「어? 그, 나는, 나는…… 집에 가서 만화 읽어야 돼!」"},
{"id": "clkn04:23000", "ko": "그건 언제든 할 수 있잖아."},
{"id": "clkn04:23100", "ko": "「그래…… 그럼 오늘은 이걸로 해산할까?」"},
{"id": "clkn04:23200", "ko": "「어, 어어, 그러자. 그럼 난 이만」"},
{"id": "clkn04:23300", "ko": "「아, 타쿠루! 오늘은 집에――」"},
{"id": "clkn04:23400", "ko": "「읏…… 오늘은 관둘래. 늦어질 것 같고」"},
{"id": "clkn04:23500", "ko": "「그래……」"},
{"id": "clkn04:23600", "ko": "도저히 아까 일이 머릿속에 아른거려서 평소처럼 지낼 수 있을 것 같지 않았다."},
{"id": "clkn04:23700", "ko": "하루라도 시간을 두면, 오늘 일은 없었던 것처럼 지낼 수 있겠지."},
{"id": "clkn04:23800", "ko": "그리고."},
{"id": "clkn04:23900", "ko": "확실히 내 예상대로, 다음 날에는 오늘 일이 없었던 것처럼 지내게 되었다."},
{"id": "clkn04:24000", "ko": "다만 그건 평온한 일상의 회복과는 한참 거리가 멀었지만."}
]
