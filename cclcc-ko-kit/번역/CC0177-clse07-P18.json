[
{"id": "clse07:167400", "ko": "「괜찮은 거냐!?」"},
{"id": "clse07:167500", "ko": "「잘 먹겠습니다~! 냠!」"},
{"id": "clse07:167600", "ko": "「우물, 우물…… 하아~……」"},
{"id": "clse07:167700", "ko": "「햄 샌드위치만큼은 아니지만」"},
{"id": "clse07:167800", "ko": "「헤헤~. 이미 먹어 버렸지롱~!」"},
{"id": "clse07:167900", "ko": "「……그만둬」"},
{"id": "clse07:168000", "ko": "「어이, 진짜 그만두라니까!!!」"},
{"id": "clse07:168100", "ko": "「나 잘 거니까. 너도 얼른 자」"},
{"id": "clse07:168200", "ko": "「야, 미야시로…… 잤냐?」"},
{"id": "clse07:168300", "ko": "「미야시로오……」"},
{"id": "clse07:168400", "ko": "「…………」"},
{"id": "clse07:168500", "ko": "「네가 이상한 얘기를 하니까 그렇잖아!!」"},
{"id": "clse07:168600", "ko": "「아…… 그러고 보니 그렇네…… 그보다 그럼 시시한 얘기 하지 마!!」"},
{"id": "clse07:168700", "ko": "「…………」"},
{"id": "clse07:168800", "ko": "「듣지 마! 절대로 듣지 마」"},
{"id": "clse07:168900", "ko": "「말해 두는데, 방금 건 반대로 하라는 신호 아니니까」"},
{"id": "clse07:169000", "ko": "「아아아아아아아아아아아아!!」"},
{"id": "clse07:169100", "ko": "「그 보장은 있냐?」"},
{"id": "clse07:169200", "ko": "「보통 휴일이라도 누군가 오잖아, 학교라면. 그런데 꼬박 이틀 동안 아무도 안 온다고. 내일이 되면 누가 온다는 보장이 어디 있는데?」"},
{"id": "clse07:169300", "ko": "「……미야시로? 왜 그래?」"},
{"id": "clse07:169400", "ko": "「그러고 보니 코맹맹이 소리네. 이마 좀 대 봐!!」"},
{"id": "clse07:169500", "ko": "「역시 열이 엄청나……」"},
{"id": "clse07:169600", "ko": "「뭐? 열 잴 때는 보통 이렇게 하잖아」"},
{"id": "clse07:169700", "ko": "「……그런가?」"},
{"id": "clse07:169800", "ko": "「뭐, 그래도 지금은 그런 건 아무래도 좋아. 아무튼 네 열, 그걸 어떻게든 해야 해」"},
{"id": "clse07:169900", "ko": "「그럴 수는 없잖아」"},
{"id": "clse07:170000", "ko": "「그건 그렇지만……」"},
{"id": "clse07:170100", "ko": "「미야시로……」"},
{"id": "clse07:170200", "ko": "「……미야시로…… 너, 괜찮냐?」"},
{"id": "clse07:170300", "ko": "「추운 거냐?」"},
{"id": "clse07:170400", "ko": "「읏……」"},
{"id": "clse07:170500", "ko": "「위험하네…… 이대로라면 악화될 거야……」"},
{"id": "clse07:170600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:170700", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:170800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:170900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:171000", "ko": "「봐, 아무리 봐도 괜찮지 않잖아」"},
{"id": "clse07:171100", "ko": "「괜찮으니까……」"},
{"id": "clse07:171200", "ko": "「응?」"},
{"id": "clse07:171300", "ko": "「……알았어」"},
{"id": "clse07:171400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:171500", "ko": "「응?」"},
{"id": "clse07:171600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:171700", "ko": "「좋은 아침, 미야시로……」"},
{"id": "clse07:171800", "ko": "「몸은 좀 어때?」"},
{"id": "clse07:171900", "ko": "「다행이다…… 이제 괜찮은 것 같네」"},
{"id": "clse07:172000", "ko": "「응?」"},
{"id": "clse07:172100", "ko": "「정말 봐줬으면 좋겠어. 그렇지, 미야시로?」"},
{"id": "clse07:172200", "ko": "「아……」"},
{"id": "clse07:172300", "ko": "「오, 오우……」"},
{"id": "clse07:172400", "ko": "「…………」"},
{"id": "clse07:172500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:172600", "ko": "「읏…… 여, 역시 아무것도 아니야. 그럼…… 또, 보자……」"},
{"id": "clse07:172700", "ko": "「어이, 미야시로」"},
{"id": "clse07:172800", "ko": "「역시 여기였나」"},
{"id": "clse07:172900", "ko": "「응? 학생회장이 없군」"},
{"id": "clse07:173000", "ko": "「그런가. 회장 앞에서는 하기 힘든 얘기였으니까. 마침 잘됐다」"},
{"id": "clse07:173100", "ko": "「실은 학생회 얘기인데. 지금 계절은 학교 행사도 많아서 꽤 바쁘다」"},
{"id": "clse07:173200", "ko": "「당연히 학생회장의 부담도 상당히 커지고 있지. 그 탓에 쿠루스는 쉬는 날까지 일을 해 주고 있다」"},
{"id": "clse07:173300", "ko": "「게다가 공부도 빼먹지 않아서 시험 성적은 늘 상위권이다. 쿠루스가 얼마나 힘들게 지내는지 알겠지?」"},
{"id": "clse07:173400", "ko": "「지금의 신문부는 모여도 그냥 놀기만 할 뿐. 아무 도움도 안 되잖나. 그런 활동에 쿠루스의 귀중한 시간을 낭비시키지 말아 주겠나」"},
{"id": "clse07:173500", "ko": "「취재라고? 애초에 다른 학교의 건전한 신문부라는 걸 알고 있나?」"},
{"id": "clse07:173600", "ko": "「그쪽은 학교 행사 특집을 하거나, 인터하이를 목표로 하는 동아리나 학생을 소개하거나…… 학교에 유의미한 지면을 만들고 있지」"},
{"id": "clse07:173700", "ko": "「그에 비해 너희는――뭔지 모를 도시 전설이니, 수상한 소문 조사니. 그런 게 학교 신문이 할 일인가?」"},
{"id": "clse07:173800", "ko": "「학생회로서는 그런 동아리에 귀중한 부비 같은 건 배분할 수 없다. 그렇게 생각하지 않나?」"},
{"id": "clse07:173900", "ko": "「물론 당장 부비를 깎는 횡포는 부리지 않는다. 너희를 포함해서 활동 실태가 수상한 동아리의 활동을 앞으로 한동안 확인하겠다. 그런 얘기다」"},
{"id": "clse07:174000", "ko": "「흥. 쿠루스한테 매달려 봐야 소용없다. 애초에 내 말은 옳은 말이니까, 아무리 쿠루스한테 매달려도…… 아~ 안 되는 건 안 되는 게 당연하다」"},
{"id": "clse07:174100", "ko": "「그래. 이건 학생회로서 올바른 행위다. 쿠루스한테 이른다든가 그런 비겁한 짓은 하지 마라. 아니, 쿠루스한테는 절대로 말하지 마라. 나와 미야시로――남자 대 남자의 승부니까!」"},
{"id": "clse07:174200", "ko": "「그럼 간다, 미야시로!」"},
{"id": "clse07:174300", "ko": "「어이, 미야시로. 할 얘기가 있는데……」"},
{"id": "clse07:174400", "ko": "「어……?」"},
{"id": "clse07:174500", "ko": "「그렇군. 그래서 와쿠이 선생님은 뭐라고 하셨지?」"},
{"id": "clse07:174600", "ko": "「흠……」"},
{"id": "clse07:174700", "ko": "「선생님들이 뭐라고 하시든, 학생회로서는 학생끼리라는 관계를 벗어나는 행위, 혹은 벗어날 가능성으로 이어지는 행위를 인정할 수는 없다」"},
{"id": "clse07:174800", "ko": "「더 이상 이상한 소문이 퍼져서 교내에 불순한 분위기가 만연해도 곤란하다. 안 되는 건 안 된다」"},
{"id": "clse07:174900", "ko": "「응? 뭐라고 했나?」"},
{"id": "clse07:175000", "ko": "「아무튼 아리무라는 오늘부터 제대로 집에 돌아가도록. 알겠지」"},
{"id": "clse07:175100", "ko": "「기, 기다려, 미야시로!!!」"},
{"id": "clse07:175200", "ko": "「아~ 뭐라고 할까, 그, 그러니까……」"},
{"id": "clse07:175300", "ko": "「역, 역시 학생회로서도 처음부터 학생을 의심의 눈으로 보는 건 좋지 않다」"},
{"id": "clse07:175400", "ko": "「남녀칠세부동석 같은 건 구시대적인 사고방식이다. 앞으로는 더 유연하게 생각해야 한다고 나는 생각한다」"},
{"id": "clse07:175500", "ko": "「그렇게 함께 성장하면서 자제심을 기르는 것도 중요한 공부가 될지도 모르고 말이지」"},
{"id": "clse07:175600", "ko": "「애초에 남녀라는 것만으로 삐딱하게 보는 건 보는 쪽에도 문제가 있는 거다」"},
{"id": "clse07:175700", "ko": "「게다가 남녀의 교제도 결코 나쁜 것만 있다고는 할 수 없다」"},
{"id": "clse07:175800", "ko": "「그중에는 서로를 높여 주는 관계도 있겠지」"},
{"id": "clse07:175900", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:176000", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:176100", "ko": "「그런 거다. 아리무라도 알겠지」"},
{"id": "clse07:176200", "ko": "「뭘 하고 있었나, 쿠루스. 늦었잖――」"},
{"id": "clse07:176300", "ko": "「미야시로…… 왜 네가 여기에?」"},
{"id": "clse07:176400", "ko": "「읏…… 혹시 미야시로…… 너, 말한 건가!?」"},
{"id": "clse07:176500", "ko": "「그럼 왜 쿠루스가 알고 있는 거지!」"},
{"id": "clse07:176600", "ko": "「아, 아니, 딱히 그런 건……」"},
{"id": "clse07:176700", "ko": "「읏…………」"},
{"id": "clse07:176800", "ko": "「아, 아아……」"},
{"id": "clse07:176900", "ko": "「……알고 있다」"},
{"id": "clse07:177000", "ko": "「그, 그래도 신문부는 지금까지 변변한 활동을 안 했어. 그러니까――!」"},
{"id": "clse07:177100", "ko": "「으……」"},
{"id": "clse07:177200", "ko": "「아, 알았어」"},
{"id": "clse07:177300", "ko": "「쿠루스?」"}
]
