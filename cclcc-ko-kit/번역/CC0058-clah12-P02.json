[
{"id": "clah12:10000", "ko": "「……선배…… 부탁이 있는데요……」"},
{"id": "clah12:10100", "ko": "「응?」"},
{"id": "clah12:10200", "ko": "「다음에 우리 집에 와 주지 않을래요?」"},
{"id": "clah12:10300", "ko": "「히나에네 집에?」"},
{"id": "clah12:10400", "ko": "「네. 오빠가 한번 만나 보고 싶대서……」"},
{"id": "clah12:10500", "ko": "최근에야 안 건데, 히나에는 꽤 오빠바라기라서, 어릴 때는 오빠한테 딱 붙어 지냈다고 한다."},
{"id": "clah12:10600", "ko": "「히나에가 좋아하는 상대가 어떤 놈인지 내가 똑똑히 봐 주겠다면서」"},
{"id": "clah12:10700", "ko": "이건 혹시 그거 아닌가?"},
{"id": "clah12:10800", "ko": "『네놈한테 형님 소리 들을 이유는 없다!』 같은 거."},
{"id": "clah12:10900", "ko": "「……나, 나로 괜찮을까?」"},
{"id": "clah12:11000", "ko": "「후후…… 괜찮아요. 왜냐하면 제가 고른 사람인걸요」"},
{"id": "clah12:11100", "ko": "히나에……"},
{"id": "clah12:11200", "ko": "「그, 그래, 알았어. 그럼 다음에……」"},
{"id": "clah12:11300", "ko": "「네」"},
{"id": "clah12:11400", "ko": "히나에가 그렇게 말해 준다면 나에게 무서울 건 없다."},
{"id": "clah12:11500", "ko": "나는 앞으로도 분명 히나에가 바라는 일이라면 뭐든지 할 수 있을 것이다."},
{"id": "clah12:11600", "ko": "그게 내가 바라는 일이기도 하니까."},
{"id": "clah12:11700", "ko": "「선배?」"},
{"id": "clah12:11800", "ko": "「…………」"},
{"id": "clah12:11900", "ko": "「후후…… 잠들어 버렸나」"},
{"id": "clah12:12000", "ko": "「고마워, 선배」"}
]
