[
{"id": "clah08:19900", "ko": "확실히 처음에는 민폐였다."},
{"id": "clah08:20000", "ko": "바로 조금 전까지 민폐라고 생각했다."},
{"id": "clah08:20100", "ko": "하지만 그래도――"},
{"id": "clah08:20200", "ko": "「그, 저는――」"},
{"id": "clah08:20300", "ko": "어느새 아리무라를……"},
{"id": "clah08:20400", "ko": "「그만해!!!」"},
{"id": "clah08:20500", "ko": "「…………?」"},
{"id": "clah08:20600", "ko": "「민폐 끼친 건 알아…… 그러니까 말하지 마……」"},
{"id": "clah08:20700", "ko": "「입 밖에…… 내지 마……」"},
{"id": "clah08:20800", "ko": "「…………」"},
{"id": "clah08:20900", "ko": "「엄마…… 선배는 처음부터 상관없으니까…… 내가 멋대로 쳐들어가서 억지로 얹혀살았던 것뿐이니까……」"},
{"id": "clah08:21000", "ko": "아리무라는 천천히 일어섰다."},
{"id": "clah08:21100", "ko": "「선배도, 민폐 끼쳐서 죄송해요……」"},
{"id": "clah08:21200", "ko": "그리고 깊숙이 고개를 숙이더니, 구석에 두었던 가방을 어깨에 메고 돌아보지도 않고 그대로 나가 버렸다."},
{"id": "clah08:21300", "ko": "（아리무라……）"},
{"id": "clah08:21400", "ko": "「……대체 뭐야, 정말」"},
{"id": "clah08:21500", "ko": "그건 내가 하고 싶은 말이었다."},
{"id": "clah08:21600", "ko": "대체 뭐냐고."},
{"id": "clah08:21700", "ko": "「폐를 끼쳤네. 미안해……」"},
{"id": "clah08:21800", "ko": "아리무라네 어머니는 한숨 섞인 목소리로 말하더니, 단단한 발걸음으로 아리무라의 뒤를 쫓아 나갔다."},
{"id": "clah08:21900", "ko": "돌아가면서 두고 간 봉투 안에는 지폐가 몇 장 들어 있었다."}
]
