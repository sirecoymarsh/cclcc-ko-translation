[
{"id": "clah11:10000", "ko": "「아는 ⟦col:280aa02d1400⟧엠스⟦col:800000⟧ 친구한테…… 상담해 봤어…… 일지도」"},
{"id": "clah11:10100", "ko": "「네가 아는 사람이라니, 대체 어떤 놈인데?」"},
{"id": "clah11:10200", "ko": "동감이다."},
{"id": "clah11:10300", "ko": "아니, 그래도 어쨌든 살았다!!"},
{"id": "clah11:10400", "ko": "「잘했어, 카즈키!!!」"},
{"id": "clah11:10500", "ko": "「그보다, 타쿠. 여기는……」"},
{"id": "clah11:10600", "ko": "빨갛게 깜빡이는 위치를 다시 확인한다."},
{"id": "clah11:10700", "ko": "그러자 거기는――"},
{"id": "clah11:10800", "ko": "「미야시타 공원……?」"},
{"id": "clah11:10900", "ko": "설마, 내 집!?"},
{"id": "clah11:11000", "ko": "어째서? 뭘 두고 가기라도 했나?"},
{"id": "clah11:11100", "ko": "아니면…… 조금은 쓸쓸하다고 생각해 주는 걸까?"},
{"id": "clah11:11200", "ko": "「타쿠루. 생각은 나중에. 지금은 움직여야지!」"},
{"id": "clah11:11300", "ko": "「아, 응……!!」"},
{"id": "clah11:11400", "ko": "아리무라는 아마 나를 기다리고 있는 건 아니다……"},
{"id": "clah11:11500", "ko": "그렇다면 금방 자리를 옮길 가능성이 높다."},
{"id": "clah11:11600", "ko": "그 전에 어떻게든 아리무라를 붙잡아야 해!"},
{"id": "clah11:11700", "ko": "（아리무라……）"},
{"id": "clah11:11800", "ko": "나는 익숙한 귀갓길을 그저 정신없이 달렸다."},
{"id": "clah11:11900", "ko": "수십 번, 수백 번 오간 이 길이지만, 아마 그중에서도 가장 빨랐을 게 틀림없다."},
{"id": "clah11:12000", "ko": "（아리무라……읏）"},
{"id": "clah11:12100", "ko": "「아리무라!!」"},
{"id": "clah11:12200", "ko": "걷어차 부술 듯한 기세로 문을 열고 굴러들어 가듯 올라섰다."},
{"id": "clah11:12300", "ko": "하지만――"},
{"id": "clah11:12400", "ko": "「하아…… 하아……」"},
{"id": "clah11:12500", "ko": "거기에 아리무라의 모습은 없었다."},
{"id": "clah11:12600", "ko": "젠장, 한발 늦었다……"},
{"id": "clah11:12700", "ko": "전화!?"},
{"id": "clah11:12800", "ko": "그래. 카즈키가――!"},
{"id": "clah11:12900", "ko": "「나야!」"},
{"id": "clah11:13000", "ko": "「타쿠? 다행이다, 겨우 연결됐네!」"},
{"id": "clah11:13100", "ko": "「오노에!! 아리무라는――」"},
{"id": "clah11:13200", "ko": "「방금 거기서 나와서 지금은 역 쪽으로 가고 있어. 지금이라면 아직 따라잡을 수 있어」"},
{"id": "clah11:13300", "ko": "「그렇구나! 고마워!!」"},
{"id": "clah11:13400", "ko": "「……타쿠」"},
{"id": "clah11:13500", "ko": "「응……?」"},
{"id": "clah11:13600", "ko": "「힘내!!」"},
{"id": "clah11:13700", "ko": "「……응!」"},
{"id": "clah11:13800", "ko": "빨리!"},
{"id": "clah11:13900", "ko": "빨리!!!"},
{"id": "clah11:14000", "ko": "「아……!」"},
{"id": "clah11:14100", "ko": "저 뒷모습은――"},
{"id": "clah11:14200", "ko": "「아리무라!!!」"},
{"id": "clah11:14300", "ko": "「어……!?」"},
{"id": "clah11:14400", "ko": "아리무라는 내 얼굴을 보자마자 도망치려 했지만, 그보다 빨리 나는 아리무라의 팔을 붙잡았다."},
{"id": "clah11:14500", "ko": "「드, 드디어…… 잡았다……!」"},
{"id": "clah11:14600", "ko": "「미야시로 선배……」"},
{"id": "clah11:14700", "ko": "겁먹은 듯한 눈동자가 나를 보더니――"},
{"id": "clah11:14800", "ko": "그리고 곧바로 눈을 피했다."},
{"id": "clah11:14900", "ko": "「왜 도망치는 거야?」"},
{"id": "clah11:15000", "ko": "「그치만……」"},
{"id": "clah11:15100", "ko": "「들어 줘, 아리무라」"},
{"id": "clah11:15200", "ko": "「싫어, 듣고 싶지 않아!」"},
{"id": "clah11:15300", "ko": "아리무라는 나에게서 벗어나려고 발버둥 쳤지만, 이윽고 포기하고 맥이 풀린 듯 힘을 빼더니 툭 하고 말했다."},
{"id": "clah11:15400", "ko": "「선배…… 있잖아, 나 옛날부터 계속 진실을 알고 싶었어……」"},
{"id": "clah11:15500", "ko": "아리무라……"},
{"id": "clah11:15600", "ko": "「우리 집은 아빠도 엄마도 거짓말투성이야. 입으로는 사랑한다느니 하면서, 자기들은 밖에서 제멋대로 하고……」"},
{"id": "clah11:15700", "ko": "「그래서 나는 계속 진실을 알고 싶다고 생각했어. 말 깊숙이 숨겨진 진짜 마음을……」"},
{"id": "clah11:15800", "ko": "아리무라는 나와 눈을 마주치려 하지 않았다."},
{"id": "clah11:15900", "ko": "「그러니까 이 능력은 내가 원했던 능력. 이 능력만 있으면 나는 행복해질 수 있을 거였어……」"},
{"id": "clah11:16000", "ko": "「…………」"},
{"id": "clah11:16100", "ko": "「그런데 있잖아…… 그런데 현실은 정반대. 진실 같은 걸 알아 봤자 행복한 일은 하나도 없었어……」"},
{"id": "clah11:16200", "ko": "지나가는 사람들이 거리낌 없는 시선으로 신기하다는 듯 우리를 바라보며 간다."},
{"id": "clah11:16300", "ko": "그래도 아리무라는 말을 이었다."},
{"id": "clah11:16400", "ko": "「이 세상에 거짓말 안 하는 사람은 없어. 누구나 다 거짓말을 하면서 살고 있었어……」"},
{"id": "clah11:16500", "ko": "「부모님도 오빠도, 친구도 선생님도, 높으신 정치가도 다들, 다들 거짓말을 하고 있어……」"},
{"id": "clah11:16600", "ko": "「물론 그중에는 나쁘지 않은 거짓말도 있었어. 하지만 귀를 막고 싶어지는 거짓말도 잔뜩 있었어……」"},
{"id": "clah11:16700", "ko": "우는 건지 아니면 겁먹은 건지, 아리무라의 손은 가늘게 떨리고 있었다."},
{"id": "clah11:16800", "ko": "나는 그런 아리무라의 말을 잠자코 듣고 있었다."},
{"id": "clah11:16900", "ko": "「나한테 말로는 친구라고 하면서 속으로는 싫어하는 애도 있었어」"},
{"id": "clah11:17000", "ko": "「매일 계속 같이 있는데. 서로 웃고 있는데, 사실은 서로 싫어하는 애들도 있었어……」"},
{"id": "clah11:17100", "ko": "⟦col:280aa02d1400⟧스크램블 교차로⟦col:800000⟧의 신호가 파란불로 바뀌고, 사람의 물결이 움직이기 시작한다."},
{"id": "clah11:17200", "ko": "「그래서 있잖아…… 나는 나 자신을 거짓말로 덧칠하기로 했어. 누구하고도 진짜 마음으로 마주하지 않아도 되도록……」"},
{"id": "clah11:17300", "ko": "「그러면 누가 거짓말을 해도 마음이 아프지 않으니까……」"},
{"id": "clah11:17400", "ko": "그래."},
{"id": "clah11:17500", "ko": "거짓말을 가장 싫어하던 아리무라가 가장 거짓말을 하고 있었다."},
{"id": "clah11:17600", "ko": "자신의 진짜 마음에."},
{"id": "clah11:17700", "ko": "하지만 나는 생각한다."},
{"id": "clah11:17800", "ko": "그것도 분명 거짓말일 거라고."},
{"id": "clah11:17900", "ko": "설령 거짓말로 덧칠한 자신이라 해도, 누군가 거짓말을 들이밀면 마음이 아프지 않을 리가 없다."},
{"id": "clah11:18000", "ko": "오히려 자신이 거짓말을 하고 있다는 떳떳하지 못함이 상처 입은 마음을 더욱 아프게 할 것이다."},
{"id": "clah11:18100", "ko": "「그렇게 나를 거짓말로 굳혀 가는 사이에 나는 점점 거짓말에 익숙해졌어. 남의 거짓말도 아무렇지 않게 받아들일 수 있게 됐어」"},
{"id": "clah11:18200", "ko": "「이제 누군가의 진짜 마음을 아는 게 무섭다느니, 그런 식으로 생각할 일은 없을 거였어……」"},
{"id": "clah11:18300", "ko": "이상하게도 조용했다."},
{"id": "clah11:18400", "ko": "「그래…… 줄곧 거짓말일 생각이었는데……」"},
{"id": "clah11:18500", "ko": "오가는 차 소리도, 스쳐 지나가는 사람들의 목소리도 나에게는 닿지 않는다."},
{"id": "clah11:18600", "ko": "중얼거리는 듯한 아리무라의 목소리만이 내 귀를 울린다."},
{"id": "clah11:18700", "ko": "「그냥 사람 좋은 선배를 놀리고 어리광 부리고…… 그것뿐일 생각이었는데……」"},
{"id": "clah11:18800", "ko": "「아리무라……」"},
{"id": "clah11:18900", "ko": "「그런데……」"},
{"id": "clah11:19000", "ko": "갑자기 고개를 든 아리무라의 눈에는, 부풀어 오른 불안이 눈물이 되어 넘치고 있었다."},
{"id": "clah11:19100", "ko": "「그런데 지금은 무서워. 거짓이었을 내 마음도! 선배를 못 만날 때 쓸쓸하다는 마음도, 모든 게……」"},
{"id": "clah11:19200", "ko": "깜빡이던 신호가 빨간불로 바뀐다."},
{"id": "clah11:19300", "ko": "「하지만 무엇보다…… 선배의 진짜 마음을 아는 게 무서워……」"},
{"id": "clah11:19400", "ko": "「하지만 나는――!」"},
{"id": "clah11:19500", "ko": "「만약에!」"},
{"id": "clah11:19600", "ko": "아리무라가 내 말을 가로막는다."},
{"id": "clah11:19700", "ko": "「만약 선배가 나를 좋아한다고 말해 줘도…… 그 뒤편에 다른 마음이 있다면……」"},
{"id": "clah11:19800", "ko": "「그게 거짓이라면……」"},
{"id": "clah11:19900", "ko": "「…………」"}
]
