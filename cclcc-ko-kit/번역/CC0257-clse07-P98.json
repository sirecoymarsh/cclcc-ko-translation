[
{"id": "clse07:929500", "ko": "「――!」"},
{"id": "clse07:929600", "ko": "「…………」"},
{"id": "clse07:929700", "ko": "「……네」"},
{"id": "clse07:929800", "ko": "「…………」"},
{"id": "clse07:929900", "ko": "「……조금요」"},
{"id": "clse07:930000", "ko": "「프로듀서…… 님……」"},
{"id": "clse07:930100", "ko": "「아……」"},
{"id": "clse07:930200", "ko": "「프로듀서……」"},
{"id": "clse07:930300", "ko": "「타쿠루 오빠? 왜 그래?」"},
{"id": "clse07:930400", "ko": "「저기, 타쿠루 오빠……?」"},
{"id": "clse07:930500", "ko": "「그보다, 타쿠루 오빠, 이런 데서 살고 있었구나」"},
{"id": "clse07:930600", "ko": "「네…… 이토 씨가요~?」"},
{"id": "clse07:930700", "ko": "「아~, 아뇨, 죄송해요. 부탁드려요, 이토 프로듀서」"},
{"id": "clse07:930800", "ko": "「아, 네. 일단은……」"},
{"id": "clse07:930900", "ko": "「에헤헤…… 그건 어제 자기 전에 열심히 생각했어. 그치?」"},
{"id": "clse07:931000", "ko": "「우리 유닛 이름은~. 하나, 둘!」"},
{"id": "clse07:931100", "ko": "「『밀푀유』예요」"},
{"id": "clse07:931200", "ko": "「그치 그치?」"},
{"id": "clse07:931300", "ko": "「중요한 거…… 가창력이라든가……」"},
{"id": "clse07:931400", "ko": "「서비스 정신?」"},
{"id": "clse07:931500", "ko": "「흠흠」"},
{"id": "clse07:931600", "ko": "「네, 부탁드려요, 프로듀서님!」"},
{"id": "clse07:931700", "ko": "「어? 그래?」"},
{"id": "clse07:931800", "ko": "「부탁드려요, 이토 프로듀서!」"},
{"id": "clse07:931900", "ko": "「어? 간다니 어디로?」"},
{"id": "clse07:932000", "ko": "「여러분 안녕하세요. 『밀푀유』의 유이예요」"},
{"id": "clse07:932100", "ko": "「웃는 얼굴…… 이렇게? 방긋」"},
{"id": "clse07:932200", "ko": "「간지럽히라고? 알았어! 에잇~」"},
{"id": "clse07:932300", "ko": "「자. 간질간질간질~」"},
{"id": "clse07:932400", "ko": "「간질간질간질간질~」"},
{"id": "clse07:932500", "ko": "「어? 아, 꺅!」"},
{"id": "clse07:932600", "ko": "「앗, 얘, 유! 안 돼, 거긴…… 앙!」"},
{"id": "clse07:932700", "ko": "「후훗, 후후훗…… 아하하하하, 안 돼! 안 된다니까~!」"},
{"id": "clse07:932800", "ko": "「앞으로 숙여?」"},
{"id": "clse07:932900", "ko": "「이토 씨……」"},
{"id": "clse07:933000", "ko": "「「알아요. 이토 씨는 저희를 위해서 해 주신 거죠……」", "note": "원문 머리의 겹낫표 「「 그대로 둠"},
{"id": "clse07:933100", "ko": "「고맙습니다, 이토 씨」"},
{"id": "clse07:933200", "ko": "「잘 부탁드립니다, 아리무라 프로듀서」"},
{"id": "clse07:933300", "ko": "「교복?!」"},
{"id": "clse07:933400", "ko": "「신난다! 교복이래, 유!」"},
{"id": "clse07:933500", "ko": "「빨리 갈아입자! 자!」"},
{"id": "clse07:933600", "ko": "「짜잔~」"},
{"id": "clse07:933700", "ko": "「에헷」"},
{"id": "clse07:933800", "ko": "「저, 정말 좋아해……?」"},
{"id": "clse07:933900", "ko": "「정말 좋아해~!」"},
{"id": "clse07:934000", "ko": "「저기~…… 그런데……」"},
{"id": "clse07:934100", "ko": "「있잖아, 타쿠루 오빠. 나, 역시 타쿠루 오빠가 프로듀서 해 줬으면 좋겠어」"},
{"id": "clse07:934200", "ko": "「무~울론. 인기곡에 맞춰서 춤추는 걸 올린 영상 말하는 거지?」"},
{"id": "clse07:934300", "ko": "「아, 나 이 노래 좋아!」"},
{"id": "clse07:934400", "ko": "「유토는 몰라?」"},
{"id": "clse07:934500", "ko": "「하, 하나…… 둘…… 셋……」"},
{"id": "clse07:934600", "ko": "「터, 턴? 영차…… 앗!」"},
{"id": "clse07:934700", "ko": "「아얏……!」"},
{"id": "clse07:934800", "ko": "「으, 응. 잠깐 발이 걸렸을 뿐이야……」"},
{"id": "clse07:934900", "ko": "「하아…… 핫……」"},
{"id": "clse07:935000", "ko": "「아우!」"},
{"id": "clse07:935100", "ko": "「하아…… 하아…… 하아……」"},
{"id": "clse07:935200", "ko": "「아, 아니! 나 아직 할 수 있단 말야」"},
{"id": "clse07:935300", "ko": "「그래도――」"},
{"id": "clse07:935400", "ko": "「……알았어」"},
{"id": "clse07:935500", "ko": "「……타쿠루 오빠. 잠깐 괜찮…… 을까?」"},
{"id": "clse07:935600", "ko": "「…………」"},
{"id": "clse07:935700", "ko": "「나…… 한심하지. 노래도 춤도 유보다 훨씬 못하고……」"},
{"id": "clse07:935800", "ko": "「이래 가지고 아이돌이 되고 싶다…… 니, 웃기지」"},
{"id": "clse07:935900", "ko": "「읏……!」"},
{"id": "clse07:936000", "ko": "「그치만…… 분하단 말야……」"},
{"id": "clse07:936100", "ko": "「정말?」"},
{"id": "clse07:936200", "ko": "「있잖아…… 타쿠루 오빠. 부탁이 있는데……」"},
{"id": "clse07:936300", "ko": "「조금만 더 그렇게 쓰다듬어 줄래?」"},
{"id": "clse07:936400", "ko": "「……고마워」"},
{"id": "clse07:936500", "ko": "「있잖아, 타쿠루 오빠」"},
{"id": "clse07:936600", "ko": "「타쿠루 오빠가 나가서, 사실은 엄청 외로웠단 말야」"},
{"id": "clse07:936700", "ko": "「그래도…… 돌아와 줘서 기뻐」"},
{"id": "clse07:936800", "ko": "「그러니까…… 탁, 탁탁, 탁……?」"},
{"id": "clse07:936900", "ko": "「우우……」"},
{"id": "clse07:937000", "ko": "「스, 스텝……!」"},
{"id": "clse07:937100", "ko": "「터, 턴…… 꺅!!」"},
{"id": "clse07:937200", "ko": "「아, 아니. 아직 괜찮아! 유, 방금 거기 한 번 더!」"},
{"id": "clse07:937300", "ko": "「!!!」"},
{"id": "clse07:937400", "ko": "「하아…… 하아…… 어때……?」"},
{"id": "clse07:937500", "ko": "「정말?!」"},
{"id": "clse07:937600", "ko": "「해냈다아아아아아아아!!」"},
{"id": "clse07:937700", "ko": "「이것도 타쿠루 오빠랑 유 덕분이야! 고마워~!」"},
{"id": "clse07:937800", "ko": "「있잖아 있잖아! 이걸로 드디어 “춤춰 봤다”에 올릴 수 있지?」"},
{"id": "clse07:937900", "ko": "「타쿠루 오빠…… 이거……」"},
{"id": "clse07:938000", "ko": "「이거…… 정말 우리……?」"},
{"id": "clse07:938100", "ko": "「정말이네……」"},
{"id": "clse07:938200", "ko": "「그러게. 알려 줬으면 좋았잖아……」"},
{"id": "clse07:938300", "ko": "「그건 그렇지만……」"},
{"id": "clse07:938400", "ko": "「그래도, 왠지 거짓말 같아……」"},
{"id": "clse07:938500", "ko": "「유!」"},
{"id": "clse07:938600", "ko": "「해냈다!」"},
{"id": "clse07:938700", "ko": "「타쿠루 오빠……」"},
{"id": "clse07:938800", "ko": "「고마워!!」"},
{"id": "clse07:938900", "ko": "「에헤헤. 그치만 기쁘단 말야」"},
{"id": "clse07:939000", "ko": "「어때, 조금쯤은. 남매잖아?」"},
{"id": "clse07:939100", "ko": "「노노 언니만 치사해~. 나도 착하지 착하지 할래~」"},
{"id": "clse07:939200", "ko": "「옳지 옳지, 착하지 착하지」"},
{"id": "clse07:939300", "ko": "「뭐어? 혹시 유도 착하지 착하지 하고 싶어?」"},
{"id": "clse07:939400", "ko": "「그래? 타쿠루, 이렇게 귀여운데」"}
]
