[
{"id": "clse07:734400", "ko": "「으, 으, 으으…… 오노에…… 부탁이야…… 부탁이라고……」"},
{"id": "clse07:734500", "ko": "「내…… 내 소원은……」"},
{"id": "clse07:734600", "ko": "「으, 으으…… 부탁이야, 세리카…… 누구라도 좋아. 나를…… 아주 조금이라도 ⟦rb⟧사랑해 줄 사람⟦rt⟧⟦rbc⟧●●●●●●⟦/r⟧을 줘. 나한테, 그 사람을 행복하게 해 주게 해 줘……」"},
{"id": "clse07:734700", "ko": "「네…… 깨어난 직후에는 몇 번이나 환각에 시달렸지만, 이제 괜찮은 것 같아요」"},
{"id": "clse07:734800", "ko": "「상당히 험한 꼴을 보게 한 모양이네요」"},
{"id": "clse07:734900", "ko": "「그 사람 자신이에요」"},
{"id": "clse07:735000", "ko": "「괜찮아요. 무슨 짓을 당하든 저는 그 녀석한테 굴복하지 않아요. 이번에도 그 사람 덕분에 꽤 즐거운 꿈을 꿨다―― 그것뿐이에요」"},
{"id": "clse07:735100", "ko": "「쿠노사토 씨?」"},
{"id": "clse07:735200", "ko": "「…… 글쎄요, 어떨까요?」"},
{"id": "clse07:735300", "ko": "「………」"},
{"id": "clse07:735400", "ko": "「만약 쿠노사토 씨라면요?」"},
{"id": "clse07:735500", "ko": "「다른 사람들은요? 괜찮은 건가요?」"},
{"id": "clse07:735600", "ko": "「그래요, 다행이다」"},
{"id": "clse07:735700", "ko": "「완치될 때까지 이토를 잘 부탁드립니다」"},
{"id": "clse07:735800", "ko": "「그리고, 저……」"},
{"id": "clse07:735900", "ko": "「………」"},
{"id": "clse07:736000", "ko": "「……… 고맙습니다」"},
{"id": "clse07:736100", "ko": "「네. 그럼 또 봬요」"},
{"id": "clse07:736200", "ko": "「앞으로도 모두를 잘 부탁해. 나 때문에 슬퍼지거나 외로워지거나…… 그런 일이 없도록」"},
{"id": "clse07:736300", "ko": "「그리고 나는 빨리 잊고 즐겁게 살아가 줬으면 좋겠어. 내가 정말 좋아하는, 누나」"},
{"id": "clse07:736400", "ko": "「이봐 이봐. 이제 정신 좀 차려, 오노에」"},
{"id": "clse07:736500", "ko": "「그렇게 네가 울고 있으면 나는 언제까지고 안심할 수 없잖아」"},
{"id": "clse07:736600", "ko": "「게다가 말이야, 네가 울어 봤자 하나도 안 귀여워. 콧물 닦아, 콧물」"},
{"id": "clse07:736700", "ko": "「늘 말하잖아? 너는 바보처럼 웃는 얼굴이 제일이라고」"},
{"id": "clse07:736800", "ko": "「그래그래, 그렇게 토라진 얼굴도 귀엽네. 그러니까 우는 얼굴만은 하지 마? 정말 안 어울리니까」"},
{"id": "clse07:736900", "ko": "「아아, 오노에냐. 너도 부실 가지?」"},
{"id": "clse07:737000", "ko": "「뭐? 왜?」"},
{"id": "clse07:737100", "ko": "「그렇군…… 아리무라가 그렇게 말한다는 건 같이 놀러 간다는 건가……」"},
{"id": "clse07:737200", "ko": "「둘이서?」"},
{"id": "clse07:737300", "ko": "「우왓!」"},
{"id": "clse07:737400", "ko": "「아니, 사양할게……」"},
{"id": "clse07:737500", "ko": "「……그렇다는 건, 혹시 쿠루스도……?」"},
{"id": "clse07:737600", "ko": "「…………」"},
{"id": "clse07:737700", "ko": "「정말이지, 오노에도 쿠루스도 카즈키도 아리무라도 우키도, 다들 동아리 활동에 좀 더 진지하게 임해 주지 않으면 곤란하다고」"},
{"id": "clse07:737800", "ko": "「다들 쉰대. 그래서 오늘은 사실상 활동 휴지라는 거지」"},
{"id": "clse07:737900", "ko": "「뭐야. 가도 된다고?」"},
{"id": "clse07:738000", "ko": "「흥, 한가한 녀석」"},
{"id": "clse07:738100", "ko": "「바보 같은 소리 마. 나는 할 일이 산더미야」"},
{"id": "clse07:738200", "ko": "「야, 잘 거면 집에 가서 자」"},
{"id": "clse07:738300", "ko": "「후아아……」"},
{"id": "clse07:738400", "ko": "「윽……」"},
{"id": "clse07:738500", "ko": "「――!!?」"},
{"id": "clse07:738600", "ko": "「또 시부야 지진 같은 건가」"},
{"id": "clse07:738700", "ko": "「그래. 일단 상황을……」"},
{"id": "clse07:738800", "ko": "「……아차. 스마트폰, 교실에 두고 왔다」"},
{"id": "clse07:738900", "ko": "「야, 설마……」"},
{"id": "clse07:739000", "ko": "「그럼 나도 갈게」"},
{"id": "clse07:739100", "ko": "「어라? 안 열려……」"},
{"id": "clse07:739200", "ko": "「혹시 방금 지진으로 문틀이 비뚤어진 건가?」"},
{"id": "clse07:739300", "ko": "「좋아, 간다. 하나, 둘!!」"},
{"id": "clse07:739400", "ko": "「……어라?」"},
{"id": "clse07:739500", "ko": "「정전?」"},
{"id": "clse07:739600", "ko": "「아무래도 이 학교만 정전된 것 같네」"},
{"id": "clse07:739700", "ko": "「야, 그렇다는 건……」"},
{"id": "clse07:739800", "ko": "「PC도 안 돼…… 그보다 이럴 때를 대비해서 노트북으로 해야 하는 거잖아, 보통」"},
{"id": "clse07:739900", "ko": "「……어떻게 하냐고 해도…… 어쩔 수 없잖아. 누군가 알아챌 때까지 여기 있는 수밖에」"},
{"id": "clse07:740000", "ko": "「그건 내가 할 소리다」"},
{"id": "clse07:740100", "ko": "「……확실히」"},
{"id": "clse07:740200", "ko": "「맞다! 분명……」"},
{"id": "clse07:740300", "ko": "「점심에 다 못 먹고 남겼거든」"},
{"id": "clse07:740400", "ko": "「아무도 준다고는 안 했다」"},
{"id": "clse07:740500", "ko": "「친구라면 그렇겠지」"},
{"id": "clse07:740600", "ko": "「…………」"},
{"id": "clse07:740700", "ko": "「……알았어. 반 줄게!」"},
{"id": "clse07:740800", "ko": "「그렇게 먹고 싶은 얼굴로 쳐다보면 혼자 먹을 수도 없잖아!」"},
{"id": "clse07:740900", "ko": "「어때. 참치 샌드위치도 꽤 괜찮지?」"},
{"id": "clse07:741000", "ko": "「읏…… 내놔! 너한테 줄 샌드위치는 없어!!」"},
{"id": "clse07:741100", "ko": "「그러고 보니 알아? 우리 학교에 얽힌 괴담……」"},
{"id": "clse07:741200", "ko": "「한밤중에 방 앞을 걷는, 물에 젖은 듯한 발소리…… 듣자 하니 10년 전에 수영장에서 죽은 여학생이……」"},
{"id": "clse07:741300", "ko": "「…………」"},
{"id": "clse07:741400", "ko": "「…………」"},
{"id": "clse07:741500", "ko": "「…………」"},
{"id": "clse07:741600", "ko": "「왜 다가오는 건데!!」"},
{"id": "clse07:741700", "ko": "「그런 얘기는 거짓말이야. 애초에 10년 전에 이 학교 없었잖아」"},
{"id": "clse07:741800", "ko": "「미안했어. 그러니까 이제 자라니까」"},
{"id": "clse07:741900", "ko": "「…………」"},
{"id": "clse07:742000", "ko": "「누가 좋다고 듣겠냐」"},
{"id": "clse07:742100", "ko": "「알고 있으니까 얼른 해!」"},
{"id": "clse07:742200", "ko": "「관둬…… 벌써 몇 번이나 해 봤잖아」"},
{"id": "clse07:742300", "ko": "「아무튼 내일까지 기다리자. 그러면 학교가 시작돼서 선생님도 학생도 올 거야……」"},
{"id": "clse07:742400", "ko": "「무슨 소리야?」"},
{"id": "clse07:742500", "ko": "「아무튼…… 여기서 떠들어 봤자 아무 소용 없으니까…… 에취!!」"},
{"id": "clse07:742600", "ko": "「아니, 아무것도 아니야……」"},
{"id": "clse07:742700", "ko": "「어?」"},
{"id": "clse07:742800", "ko": "「너, 너……」"},
{"id": "clse07:742900", "ko": "「왜, 왜 굳이 열 재는데 이마를 맞대는 건데!?」"},
{"id": "clse07:743000", "ko": "「아니아니, 부모나 형제라면 모를까, 남자끼리는 안 하잖아!」"},
{"id": "clse07:743100", "ko": "「이, 이 정도는 아무렇지도 않아. 자면 나아」"},
{"id": "clse07:743200", "ko": "「그렇게 말해도 이 상황에선 어떻게 할 수도 없잖아」"},
{"id": "clse07:743300", "ko": "「읏…… 아무튼 내일까지만 참으면 되니까, 나는 이제 잘게」"},
{"id": "clse07:743400", "ko": "「후우……」"},
{"id": "clse07:743500", "ko": "「으으〜……」"},
{"id": "clse07:743600", "ko": "「으〜……」"},
{"id": "clse07:743700", "ko": "「우으〜……」"},
{"id": "clse07:743800", "ko": "「이토…… 너, 뭐 하는……」"},
{"id": "clse07:743900", "ko": "「…………야, 설마……」"},
{"id": "clse07:744000", "ko": "「이토……」"},
{"id": "clse07:744100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:744200", "ko": "「기, 기다려……」"},
{"id": "clse07:744300", "ko": "", "note": "보류 — 성적 묘사"}
]
