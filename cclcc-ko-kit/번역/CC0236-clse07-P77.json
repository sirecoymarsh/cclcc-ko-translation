[
{"id": "clse07:744400", "ko": "「…………」"},
{"id": "clse07:744500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:744600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:744700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:744800", "ko": "「음……」"},
{"id": "clse07:744900", "ko": "「어라? 나는……」"},
{"id": "clse07:745000", "ko": "「이토……」"},
{"id": "clse07:745100", "ko": "「……이토」"},
{"id": "clse07:745200", "ko": "「고…… 마워……」"},
{"id": "clse07:745300", "ko": "「――!?」"},
{"id": "clse07:745400", "ko": "「그러게 말이야」"},
{"id": "clse07:745500", "ko": "「쿠노사토 씨……」"},
{"id": "clse07:745600", "ko": "「벼, 별로 재밌는 일 같은 건 아무것도 없었어요!」"},
{"id": "clse07:745700", "ko": "「딱히 발끈하거나 한 건……」"},
{"id": "clse07:745800", "ko": "「아아, 이토. 안녕……」"},
{"id": "clse07:745900", "ko": "「…………」"},
{"id": "clse07:746000", "ko": "「쉰다고?」"},
{"id": "clse07:746100", "ko": "「뭐? 아아……」"},
{"id": "clse07:746200", "ko": "「그, 그러니까 없다니까요! 아무것도!」"},
{"id": "clse07:746300", "ko": "「응? 초코칩 들어간 걸로 괜찮아~?」"},
{"id": "clse07:746400", "ko": "「그럼 나는 전병으로 해야지~. 하나도 먹을래~?」"},
{"id": "clse07:746500", "ko": "「하나는 이렇게 되면 무리야, 타쿠~」"},
{"id": "clse07:746600", "ko": "「아, 우키는 과자 뭐 먹을래? 초코도 있어~?」"},
{"id": "clse07:746700", "ko": "「아~, 나도 같이 가고 싶어~! 우키 옷 고르고 싶어~!」"},
{"id": "clse07:746800", "ko": "「좋아~, 어떤 옷이 어울릴지 같이 생각해 보자? 나, 잠깐 편의점 가서 패션 잡지 사 올게」"},
{"id": "clse07:746900", "ko": "「응~?」"},
{"id": "clse07:747000", "ko": "「오~」"},
{"id": "clse07:747100", "ko": "「이건 이제 신문부의 “장기 자랑”이네!」"},
{"id": "clse07:747200", "ko": "「괜찮잖아, 타쿠? 나도 히나가 있으면 즐겁고~」"},
{"id": "clse07:747300", "ko": "「응? 음…… 뭐였더라?」"},
{"id": "clse07:747400", "ko": "「………」"},
{"id": "clse07:747500", "ko": "「엄청난 뉴스뿐이라 고민되네~」"},
{"id": "clse07:747600", "ko": "「대놓고 말하면 안 돼~. 조금은 봐줘야지~」"},
{"id": "clse07:747700", "ko": "「응? 그래?」"},
{"id": "clse07:747800", "ko": "「에~, 괜찮아!? 할래 할래! 노노도 같이 쓸 거지!?」", "note": "새 용어: 세리카가 부르는 のんちゃん → 노노"},
{"id": "clse07:747900", "ko": "「찬성~」"},
{"id": "clse07:748000", "ko": "「알았어~」"},
{"id": "clse07:748100", "ko": "「에~?」"},
{"id": "clse07:748200", "ko": "「있잖아 있잖아! 타쿠! 이거랑 이거, 어느 옷이 귀여운 것 같아~?」"},
{"id": "clse07:748300", "ko": "「에~? 이쪽이 절대 더 좋다니까~! 그치, 우키?」"},
{"id": "clse07:748400", "ko": "「우와! 방금 건 절대 협박이야~! 『언니 말 안 들으면 나중에 엄청난 벌을 줄 거야?』라는 뜻이야~!」"},
{"id": "clse07:748500", "ko": "「뭐야 뭐야?」"},
{"id": "clse07:748600", "ko": "「잠깐만, 타쿠. 저기, 타쿠」"},
{"id": "clse07:748700", "ko": "「여기서 가면 아깝다니까. 이다음에 어마어마한 이벤트가 기다리고 있으니까」"},
{"id": "clse07:748800", "ko": "「잠깐 귀 좀 빌려줘, 귀」"},
{"id": "clse07:748900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:749000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:749100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:749200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:749300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:749400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:749500", "ko": "「잠깐 기다려, 타쿠~!」"},
{"id": "clse07:749600", "ko": "「뭐가 대단했는데?」"},
{"id": "clse07:749700", "ko": "「응? 문이 열려 있었으니까」"},
{"id": "clse07:749800", "ko": "「음~. 타쿠가 말이야, 중얼중얼 혼잣말하기 시작했을 때쯤」"},
{"id": "clse07:749900", "ko": "「에헤헤~」"},
{"id": "clse07:750000", "ko": "「아, 맞다. 늘 내던 오백 엔」"},
{"id": "clse07:750100", "ko": "「응. 거기서 겐 씨를 만났거든. 그랬더니 타쿠가 ⟦rb⟧매달⟦rt⟧⟦rbc⟧●●⟦/r⟧ ⟦rb⟧기대하고⟦rt⟧⟦rbc⟧●●●●⟦/r⟧ ⟦rb⟧있는⟦rt⟧⟦rbc⟧●●⟦/r⟧ 잡지를 전해 달래」"},
{"id": "clse07:750200", "ko": "「자, 이거. 돈은 내가 대신 내 뒀으니까. 오백 엔」"},
{"id": "clse07:750300", "ko": "「에~? 왜 버려? 아직 안 읽었는데」"},
{"id": "clse07:750400", "ko": "「응? 그래도 이쪽 선반 안쪽에 몰래 넣어 둔 책들, 전부 『쿨 캣 프레스』라고 쓰여 있었던 것 같은데……」"},
{"id": "clse07:750500", "ko": "「노노한테는 비밀로 할 테니까 나도 보여 줘~」"},
{"id": "clse07:750600", "ko": "「있잖아, 타쿠! 이런 재밌는 거 있어? 해 봐~」"},
{"id": "clse07:750700", "ko": "「정말~, 맨날 그런 소리만 하니까 타쿠는 언제까지고 여자 친구가 안 생기는 거야~」"},
{"id": "clse07:750800", "ko": "「이런 건 게임 같아서 재밌어. 하자?」"},
{"id": "clse07:750900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:751000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:751100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:751200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:751300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:751400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:751500", "ko": "「응? 뭐야 뭐야? 무슨 사진이야~?」"},
{"id": "clse07:751600", "ko": "「으음? 그런가~」"},
{"id": "clse07:751700", "ko": "「음~?」"},
{"id": "clse07:751800", "ko": "「모든 사건이 우리를 웃기려고 하고 있어!」"},
{"id": "clse07:751900", "ko": "「그래도 그래도, 재밌는 사건뿐이잖아? 몇 년 전에 『뉴제 뭐시기의 광기』라는 게 있었는데, 그거랑은 완전 달라」"},
{"id": "clse07:752000", "ko": "「왜 그래, 타쿠?」"},
{"id": "clse07:752100", "ko": "「뭐야 뭐야?」"},
{"id": "clse07:752200", "ko": "「날짜?」"},
{"id": "clse07:752300", "ko": "「……?」"},
{"id": "clse07:752400", "ko": "「으, 응」"},
{"id": "clse07:752500", "ko": "「그러니까…… 결국 무슨 말이야?」"},
{"id": "clse07:752600", "ko": "「그런데 왜 그런 귀찮은 짓을 하는 걸까~? 게다가 웃음이 나는 사건들뿐이고」"},
{"id": "clse07:752700", "ko": "「오~. 왠지 멋있다~」"},
{"id": "clse07:752800", "ko": "「그렇구나~! 대단하다, 타쿠~!」"},
{"id": "clse07:752900", "ko": "「응?」"},
{"id": "clse07:753000", "ko": "「타쿠……」"},
{"id": "clse07:753100", "ko": "「응? 나랑 신지야」"},
{"id": "clse07:753200", "ko": "「게다가 타쿠가 갖고 있는 책이랑은 내용을 바꿨어~? 봐?」"},
{"id": "clse07:753300", "ko": "「음~, 신문 만드는 데 참고하려고. 아침에 타쿠 깨우러 간 김에 비밀 책장에서 빌려 왔는데……」"},
{"id": "clse07:753400", "ko": "「에헤헤~ 타쿠~ 알고 있어♪」"},
{"id": "clse07:753500", "ko": "「어쩌면 이번 신문에서 제일 인기 있을지도 몰라」"},
{"id": "clse07:753600", "ko": "「그럼 말이야! 만약 이 코너가 반응 좋으면, 다음 신문부터는 전부 이걸로 하자~!」"},
{"id": "clse07:753700", "ko": "「왜 그래, 타쿠? 뚱한 얼굴을 하고」"},
{"id": "clse07:753800", "ko": "「그래도~ 타쿠도 재밌으니까 쿨 캣이었나? 그 책 사는 거잖아?」"},
{"id": "clse07:753900", "ko": "「응? 체육 수업은 나왔는데?」"},
{"id": "clse07:754000", "ko": "「있잖아, 타쿠. 히나, 오늘은 동아리 올까~?」"},
{"id": "clse07:754100", "ko": "「그치만 타쿠, 히나랑 사이좋잖아?」"},
{"id": "clse07:754200", "ko": "「…………」"},
{"id": "clse07:754300", "ko": "「맞다, 타쿠. 오늘 돌아가는 길에 타쿠네 집 들러도 돼?」"}
]
