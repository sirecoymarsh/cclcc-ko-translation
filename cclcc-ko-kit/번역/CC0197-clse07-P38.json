[
{"id": "clse07:358100", "ko": "「타쿠루. 도시락은 챙겼어?」"},
{"id": "clse07:358200", "ko": "「응. 아까 아빠한테 연락했더니 문제없대. 그리고…… 갑자기 집회라니…… 이쪽도 걱정되고」"},
{"id": "clse07:358300", "ko": "「잠깐, 카와하라! 타쿠루가 뭘 했다는 거야? 대체 무슨 근거로 그런 말을 하는 거야!」"},
{"id": "clse07:358400", "ko": "「설마 아무 근거도 없이 학생 한 명을 규탄하는 건 아니겠지? 그렇다면 용서 안 할 거야」"},
{"id": "clse07:358500", "ko": "「어……?」"},
{"id": "clse07:358600", "ko": "「저건……」"},
{"id": "clse07:358700", "ko": "「그 집은 아오바 기숙사라는 아동 복지 시설이고, 사정이 있는 아이들을 맡고 있어. 그리고 거기서 나도 타쿠루도 살고 있어. 그건 카와하라, 너도 알고 있잖아!」"},
{"id": "clse07:358800", "ko": "「같은 시설에서 사는 사람으로서 대신 사정을 설명하는 데 무슨 문제라도 있어?」"},
{"id": "clse07:358900", "ko": "「그 아이는 며칠 전에 우리 시설에 맡겨진 아이야」"},
{"id": "clse07:359000", "ko": "「그, 그 애는…… 돌아왔어, 얼마 전에」"},
{"id": "clse07:359100", "ko": "「그건……」"},
{"id": "clse07:359200", "ko": "「읏…………」"},
{"id": "clse07:359300", "ko": "「그, 그렇지 않아!」"},
{"id": "clse07:359400", "ko": "「그거…… 무슨 뜻이야?」"},
{"id": "clse07:359500", "ko": "「웃기지 마!!」"},
{"id": "clse07:359600", "ko": "「내 가족을 나쁘게 말하는 건, 누구든 용서 안 해……!」"},
{"id": "clse07:359700", "ko": "「당연하지! 그 아기는 맡은 아이고, 타쿠루의 아이도 시설의 다른 누구의 아이도 아니야」"},
{"id": "clse07:359800", "ko": "「…………!」"},
{"id": "clse07:359900", "ko": "「그건……」"},
{"id": "clse07:360000", "ko": "「…………」"},
{"id": "clse07:360100", "ko": "「…………」"},
{"id": "clse07:360200", "ko": "「……!?」"},
{"id": "clse07:360300", "ko": "「…………」"},
{"id": "clse07:360400", "ko": "「그건……」"},
{"id": "clse07:360500", "ko": "「……깨어 있어?」"},
{"id": "clse07:360600", "ko": "「……이런 시간에 미안해」"},
{"id": "clse07:360700", "ko": "「미안해……」"},
{"id": "clse07:360800", "ko": "「그게 아니라…… 그…… 이번 일. 나 때문에 이런 소동이 벌어져서」"},
{"id": "clse07:360900", "ko": "「…………」"},
{"id": "clse07:361000", "ko": "「……있잖아, 타쿠루…… 실은 말해야 할 게 있어……」"},
{"id": "clse07:361100", "ko": "「나, 돌아갈 수 없게 됐어……」"},
{"id": "clse07:361200", "ko": "「나, 센리로 돌아갈 수 없게 됐어……」"},
{"id": "clse07:361300", "ko": "「쿠노사토 씨는…… 뭐래?」"},
{"id": "clse07:361400", "ko": "「그래……」"},
{"id": "clse07:361500", "ko": "「미안…… 타쿠루…… 나…… 나는……」"},
{"id": "clse07:361600", "ko": "「그래도 이대로면 네가――!!!」"},
{"id": "clse07:361700", "ko": "「응……」"},
{"id": "clse07:361800", "ko": "「…………」"},
{"id": "clse07:361900", "ko": "「제멋대로야…… 나……」"},
{"id": "clse07:362000", "ko": "「나한테 제일 소중한 건 나 자신이야……」"},
{"id": "clse07:362100", "ko": "「있잖아, 히카리……」"},
{"id": "clse07:362200", "ko": "「나, 어떻게 하면 좋을까?」"},
{"id": "clse07:362300", "ko": "「어떻게 하면……」"},
{"id": "clse07:362400", "ko": "「…………」"},
{"id": "clse07:362500", "ko": "（――세리카랑 또 한 명…… 누구지?）"},
{"id": "clse07:362600", "ko": "（――타쿠루?）"},
{"id": "clse07:362700", "ko": "（타쿠루……）"},
{"id": "clse07:362800", "ko": "「――!」"},
{"id": "clse07:362900", "ko": "「읏…… 흐윽……」"},
{"id": "clse07:363000", "ko": "（타…… 쿠루…… 읏……）"},
{"id": "clse07:363100", "ko": "「읏…………」"},
{"id": "clse07:363200", "ko": "「세리카……」"},
{"id": "clse07:363300", "ko": "「응」"},
{"id": "clse07:363400", "ko": "「응」"},
{"id": "clse07:363500", "ko": "「응」"},
{"id": "clse07:363600", "ko": "「기다려!!!」"},
{"id": "clse07:363700", "ko": "「그치만, 역시…… 이런 건 안 되니까……」"},
{"id": "clse07:363800", "ko": "「아니, 안 좋아…… 안 좋다고……」"},
{"id": "clse07:363900", "ko": "「고마워, 타쿠루…… 미안해……」"},
{"id": "clse07:364000", "ko": "「카와하라. 너는 틀렸어」"},
{"id": "clse07:364100", "ko": "「아니. 그래도 틀렸어……」"},
{"id": "clse07:364200", "ko": "「있잖아, 다들. 다들은 그 교칙, 정말로 옳다고 생각해?」"},
{"id": "clse07:364300", "ko": "「사람을 좋아하게 되는 게 나쁜 일이라고, 정말로 생각해?」"},
{"id": "clse07:364400", "ko": "「다들 소중한 사람을 생각하는 마음은 있잖아?」"},
{"id": "clse07:364500", "ko": "「그 사람을 위해 뭔가 해 주고 싶다. 그 사람이 기뻐하는 얼굴이 보고 싶다…… 그건 아주 상냥하고 따뜻한 마음이라고 나는 생각해」"},
{"id": "clse07:364600", "ko": "「그런 마음 너머에 있는 게 연애나 사랑이라면, 나는 그 마음을 소중히 하고 싶어. 왜냐하면……」"},
{"id": "clse07:364700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:364800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:364900", "ko": "「그러니까 연애 금지 교칙 같은 건 틀렸어」"},
{"id": "clse07:365000", "ko": "「적어도 나는 그렇게 생각해……」"},
{"id": "clse07:365100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:365200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:365300", "ko": "「그것도 틀렸어」"},
{"id": "clse07:365400", "ko": "「증거라면 있어」"},
{"id": "clse07:365500", "ko": "「그치만, 나…… 내가……」"},
{"id": "clse07:365600", "ko": "「내가 미나미사와 센리니까」"},
{"id": "clse07:365700", "ko": "「내가 센리야. 그 영상에 찍혀 있던 미나미사와 센리라고, 카와하라」"},
{"id": "clse07:365800", "ko": "「농담 같은 거 아니야. 나는 진짜 미나미사와 센리야. 너도 잘 아는 사람이지」"},
{"id": "clse07:365900", "ko": "「응, 그렇지……」"},
{"id": "clse07:366000", "ko": "「봐 줘. 이게 나의, 기가로매니악스로서의 ⟦rb⟧능력⟦rt⟧힘⟦/r⟧――」"},
{"id": "clse07:366100", "ko": "「…………」"},
{"id": "clse07:366200", "ko": "「히카리……」"},
{"id": "clse07:366300", "ko": "「잘 지내……」"},
{"id": "clse07:366400", "ko": "「어?」"},
{"id": "clse07:366500", "ko": "「히카리……」"},
{"id": "clse07:366600", "ko": "「쿠노사토 씨는 뭐래?」"},
{"id": "clse07:366700", "ko": "「그래……」"},
{"id": "clse07:366800", "ko": "「……그러네. 히카리 엄마가 가져온 과자도 있고. 따뜻한 코코아라도 탈까」"},
{"id": "clse07:366900", "ko": "「자, 타쿠루도」"},
{"id": "clse07:367000", "ko": "「응, 좋은 아침」"},
{"id": "clse07:367100", "ko": "「정말, 그렇게 부르지 말라고 했잖아」"},
{"id": "clse07:367200", "ko": "「저, 저기, 타쿠루. 그거 말인데, 그…… 유이랑 유토는 친구 집에서 파티래……」"},
{"id": "clse07:367300", "ko": "「응. 아빠도 학회래……」"},
{"id": "clse07:367400", "ko": "「후훗, 정말……」"},
{"id": "clse07:367500", "ko": "「히카리…… 잘 지내고 있을까……?」"},
{"id": "clse07:367600", "ko": "「그러면 좋겠는데……」"},
{"id": "clse07:367700", "ko": "「그러게……」"},
{"id": "clse07:367800", "ko": "「응……」"},
{"id": "clse07:367900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:368000", "ko": "", "note": "보류 — 연애 묘사"}
]
