[
{"id": "clah11:20000", "ko": "「그런 말 따위, 듣고 싶지 않아……」"},
{"id": "clah11:20100", "ko": "「아리무라……」"},
{"id": "clah11:20200", "ko": "「선배 입에서…… 좋아한다는 말, 듣고 싶지 않아……」"},
{"id": "clah11:20300", "ko": "「그러니까……」"},
{"id": "clah11:20400", "ko": "스르르, 손안의 온기가."},
{"id": "clah11:20500", "ko": "「안녕……」"},
{"id": "clah11:20600", "ko": "사라졌다."},
{"id": "clah11:20700", "ko": "「아리무라!!!!」"},
{"id": "clah11:20800", "ko": "뻗은 손을 빠져나가, 아리무라는 막 빨간불로 바뀐 교차로로 뛰어들었다."},
{"id": "clah11:20900", "ko": "달리기 시작한 차들 사이를 빠져나가, 경적과 고함 속에서 아리무라의 등이 작아져 간다."},
{"id": "clah11:21000", "ko": "「기다려, 아리무라!!!」"},
{"id": "clah11:21100", "ko": "여기서 전하지 못하면 앞으로 두 번 다시 내 목소리는 닿지 않는다――"},
{"id": "clah11:21200", "ko": "어째서인지 그런 기분이 들어서, 나는――"},
{"id": "clah11:21300", "ko": "「나는――!!」"},
{"id": "clah11:21400", "ko": "스크램블 교차로 건너편을 향해, 목이 찢어질 만큼 외쳤다."},
{"id": "clah11:21500", "ko": "「나는 너를――!!」"},
{"id": "clah11:21600", "ko": "아리무라에게 전하기 위해."},
{"id": "clah11:21700", "ko": "「정말 싫어해애애애애애애애애애앳!!」"},
{"id": "clah11:21800", "ko": "「――!!」"},
{"id": "clah11:21900", "ko": "뒤돌아본 아리무라의 눈이 나를 똑바로 바라보았다."},
{"id": "clah11:22000", "ko": "「나는 네가, 정마아아알 싫어어엇!!!!」"},
{"id": "clah11:22100", "ko": "신호를 기다리던 사람들이 무슨 일인가 하고 나를 본다."},
{"id": "clah11:22200", "ko": "『너무해』 『불쌍해』 그런 목소리가 귀를 때린다."},
{"id": "clah11:22300", "ko": "그래도 나는 계속 외쳤다."},
{"id": "clah11:22400", "ko": "「친구들 앞에서는 꾸며서 겉으로만 착한 애인 척하는 것도!」"},
{"id": "clah11:22500", "ko": "「시끄러운 것도, 제멋대로인 것도, 의외로 살뜰한 것도, 사실은 외로움을 잘 타면서 고집 부리는 것도, 누군가에게 상처 주기 싫어서 자기만 상처 입는 것도!」"},
{"id": "clah11:22600", "ko": "“좋아한다”는 말은 듣고 싶지 않다고?"},
{"id": "clah11:22700", "ko": "그럼 말해 주지."},
{"id": "clah11:22800", "ko": "내 마음을."},
{"id": "clah11:22900", "ko": "「전부 전부, 저어언부!」"},
{"id": "clah11:23000", "ko": "너라면 알겠지?"},
{"id": "clah11:23100", "ko": "내 마음을."},
{"id": "clah11:23200", "ko": "「정말 싫어어어어어어어엇!!」"},
{"id": "clah11:23300", "ko": "진짜…… 마음을……"},
{"id": "clah11:23400", "ko": "「…………」"},
{"id": "clah11:23500", "ko": "「하아…… 하아……」"},
{"id": "clah11:23600", "ko": "신호가…… 바뀐다."},
{"id": "clah11:23700", "ko": "멈춰 있던 주위의 풍경이 흐르기 시작한다."},
{"id": "clah11:23800", "ko": "그런 가운데, 천천히."},
{"id": "clah11:23900", "ko": "천천히 아리무라가 걷기 시작한다."},
{"id": "clah11:24000", "ko": "나를 향해."},
{"id": "clah11:24100", "ko": "「읏……!」"},
{"id": "clah11:24200", "ko": "내디딘 발은 점점 빨라지고."},
{"id": "clah11:24300", "ko": "「――!!」"},
{"id": "clah11:24400", "ko": "어느새 나도 달리기 시작했다."},
{"id": "clah11:24500", "ko": "「선배!!」"},
{"id": "clah11:24600", "ko": "「아리무라!!!!」"},
{"id": "clah11:24700", "ko": "「선배!」"},
{"id": "clah11:24800", "ko": "「아리무라!!!」"},
{"id": "clah11:24900", "ko": "그리고 우리 사이의 거리는 제로가 되었다."},
{"id": "clah11:25000", "ko": "「다시 한번 말할게…… 나는 네가 싫어……」"},
{"id": "clah11:25100", "ko": "내 품 안에서, 내 눈을 똑바로 본 아리무라가 고개를 끄덕인다."},
{"id": "clah11:25200", "ko": "「응……」"},
{"id": "clah11:25300", "ko": "「정말 싫어……」"},
{"id": "clah11:25400", "ko": "「한 번 더……」"},
{"id": "clah11:25500", "ko": "몇 번이라도 말하자."},
{"id": "clah11:25600", "ko": "「정말정말정말정말, 정말 싫어」"},
{"id": "clah11:25700", "ko": "「선배…… 거짓말쟁이……」"},
{"id": "clah11:25800", "ko": "이윽고 신호는 파란불에서 빨간불로 바뀌고, 경적이 들리기 시작한다."},
{"id": "clah11:25900", "ko": "그래도 우리는 끌어안고 있었다."},
{"id": "clah11:26000", "ko": "시부야 한복판, 이 스크램블 교차로에서."},
{"id": "clah11:26100", "ko": "서로의 온기를 느끼면서."},
{"id": "clah11:26200", "ko": "「선배……」"},
{"id": "clah11:26300", "ko": "「응……?」"},
{"id": "clah11:26400", "ko": "「정말 좋아……」"}
]
