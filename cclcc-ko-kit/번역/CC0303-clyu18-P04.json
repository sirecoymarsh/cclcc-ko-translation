[
{"id": "clyu18:29400", "ko": "「유이……」"},
{"id": "clyu18:29500", "ko": "유이가 이렇게까지 나를 의지하고 있었다니……"},
{"id": "clyu18:29600", "ko": "그 사실에 나는 적잖이 충격을 받았다."},
{"id": "clyu18:29700", "ko": "그리고 그 마음에 어떻게든 보답하고 싶다고, 진심으로 그렇게 생각했다."},
{"id": "clyu18:29800", "ko": "「젠장! 뭐였더라…… 이 걸리는 느낌은……!」"},
{"id": "clyu18:29900", "ko": "「왜 그래, 타쿠?」"},
{"id": "clyu18:30000", "ko": "「유이 얘기…… 벽에 얼굴이 있다는 게 아무래도 걸려. 어디서 본 것 같은데…… 오노에는 짚이는 데 없어?!」"},
{"id": "clyu18:30100", "ko": "「우…… 미안, 나 모르겠어……」"},
{"id": "clyu18:30200", "ko": "아니, 분명히 본 것 같다."},
{"id": "clyu18:30300", "ko": "그게 어디였더라……"},
{"id": "clyu18:30400", "ko": "「카즈키! 사진 있지?!」"},
{"id": "clyu18:30500", "ko": "취재하러 나갈 때면 나는 되도록 가 본 장소를 사진으로 남겨 두고 있다."},
{"id": "clyu18:30600", "ko": "나중에 그게 어떤 사건의 단서로 이어질지 모르기 때문이다."},
{"id": "clyu18:30700", "ko": "벽에 얼굴…… 그걸 바로 얼마 전에 본 것 같다."},
{"id": "clyu18:30800", "ko": "그것도 최근에 찍은 사진 속에서."},
{"id": "clyu18:30900", "ko": "「응……」"},
{"id": "clyu18:31000", "ko": "카즈키는 최근 몇 달 동안 찍은 사진을 서랍에서 꺼내 나에게 건넸다."},
{"id": "clyu18:31100", "ko": "이 안에 분명 단서가 있을 거다."},
{"id": "clyu18:31200", "ko": "（겐 씨 말로는 유이를 본 게 학교 근처라고 했지……）"},
{"id": "clyu18:31300", "ko": "（거기서 15분 안에 갈 수 있는 곳이라면……）"},
{"id": "clyu18:31400", "ko": "「유이 말로는 방에 커다란 둥근 침대가 있다고 했다）", "note": "원문 괄호 짝(「…）) 그대로"},
{"id": "clyu18:31500", "ko": "（그리고 벽에 떠오른 얼굴……）"},
{"id": "clyu18:31600", "ko": "（이 중에서 그 얘기와 들어맞는 건……）"},
{"id": "clyu18:31700", "ko": "（이거다!）"},
{"id": "clyu18:31800", "ko": "（……아니, 아니야. 이래서는 유토 얘기와 맞지 않아）"},
{"id": "clyu18:31900", "ko": "（다시 한번 생각해 보는 거다）"},
{"id": "clyu18:32000", "ko": "「틀림없어! 여기야!」"},
{"id": "clyu18:32100", "ko": "「어이, 거긴――」"},
{"id": "clyu18:32200", "ko": "얼마 전 『회전 제트』 취재로 몰래 들어가려 했던 호텔의 바깥."},
{"id": "clyu18:32300", "ko": "「벽에…… 얼굴……」"},
{"id": "clyu18:32400", "ko": "거기에는 사람 얼굴을 한 묘한 스티커가 붙어 있었다."},
{"id": "clyu18:32500", "ko": "「이 스티커는 딱 3층쯤에 붙어 있어요. 그러니까 창문으로 이 스티커가 보이는 방에 유이가 있을 거예요!!」"},
{"id": "clyu18:32600", "ko": "「그 호텔인가!!」"}
]
