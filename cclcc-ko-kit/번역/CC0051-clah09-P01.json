[
{"id": "clah09:0", "ko": "오랜만에 조용한 밤이었다."},
{"id": "clah09:100", "ko": "역시 내 방은 이래야 한다."},
{"id": "clah09:200", "ko": "어쨌든 요 며칠은 나만의 시간이라는 걸 전혀 가질 수 없었으니까."},
{"id": "clah09:300", "ko": "앞으로는 마음껏 하고 싶은 걸 할 수 있는 셈이다."},
{"id": "clah09:400", "ko": "「우선은…… 그래」"},
{"id": "clah09:500", "ko": "나는 안쪽에 숨겨 두었던 ⟦col:280aa02d1400⟧쿨 캣 프레스⟦col:800000⟧를 꺼냈다."},
{"id": "clah09:600", "ko": "저번에 겐 씨가 가져다준 쿨 캣, 아리무라가 있었던 탓에 아직 못 읽었지."},
{"id": "clah09:700", "ko": "「이번 특집은……」"},
{"id": "clah09:800", "ko": "「여심을 철저 해부! 라……」"},
{"id": "clah09:900", "ko": "정말 무슨 생각을 하는지 모르겠다니까, 여자들은……"},
{"id": "clah09:1000", "ko": "「하아……」"},
{"id": "clah09:1100", "ko": "질렸다!!"},
{"id": "clah09:1200", "ko": "이런 거 읽어 봤자 여자 마음 같은 건 눈곱만큼도 알 수 있게 되지 않잖아."},
{"id": "clah09:1300", "ko": "「지금 몇 시지?」"},
{"id": "clah09:1400", "ko": "스마트폰을 꺼내서 시간을 확인한다."},
{"id": "clah09:1500", "ko": "그런데 아까부터 아직 30분 정도밖에 지나지 않았다."},
{"id": "clah09:1600", "ko": "시간 가는 게 이렇게나 느렸던가?"},
{"id": "clah09:1700", "ko": "「…………」"},
{"id": "clah09:1800", "ko": "문득 멀리서 순찰차 소리가 들려왔다."},
{"id": "clah09:1900", "ko": "무슨 사건이라도 있었나?"},
{"id": "clah09:2000", "ko": "뭐, 사건 같은 건 여기 시부야에선 일상다반사지만."},
{"id": "clah09:2100", "ko": "하지만 요 며칠은 그런 건 조금도 신경 쓰이지 않았다."},
{"id": "clah09:2200", "ko": "라기보다는 이 방 안이 너무 시끌벅적해서 바깥 소리 같은 건 전혀 신경 쓰이지 않았던 것뿐이다."},
{"id": "clah09:2300", "ko": "……이 방, 이렇게나 조용했던가?"},
{"id": "clah09:2400", "ko": "또 한 대, 순찰차가 지나갔다."},
{"id": "clah09:2500", "ko": "（……아리무라…… 괜찮으려나?）"},
{"id": "clah09:2600", "ko": "……라니, 무슨 소리를 하는 거야, 나는."},
{"id": "clah09:2700", "ko": "아무리 그래도 이제는 집에 돌아갔겠지."},
{"id": "clah09:2800", "ko": "「…………」"},
{"id": "clah09:2900", "ko": "그러고 보니 배가 고프다."},
{"id": "clah09:3000", "ko": "뭐 먹을 거라도 사러 갈까……"},
{"id": "clah09:3100", "ko": "아니, 그것도 귀찮네."},
{"id": "clah09:3200", "ko": "분명 선반 안쪽에……"},
{"id": "clah09:3300", "ko": "있다 있다."},
{"id": "clah09:3400", "ko": "사다 둔 영양 밸런스 식품."},
{"id": "clah09:3500", "ko": "오늘은 이걸로 됐어."},
{"id": "clah09:3600", "ko": "「…………」"},
{"id": "clah09:3700", "ko": "뭐야 이거, 맛없어."},
{"id": "clah09:3800", "ko": "이런 맛이었던가?"},
{"id": "clah09:3900", "ko": "게다가 눈 깜짝할 사이에 없어져 버렸다."},
{"id": "clah09:4000", "ko": "밋밋하기 짝이 없는 데다, 이래서는 시간 때우기도 안 된다."},
{"id": "clah09:4100", "ko": "뭔가 기분 전환할 만한 건 없을까?"},
{"id": "clah09:4200", "ko": "「응? 뭐지 이건?」"},
{"id": "clah09:4300", "ko": "문득 보니 창가에 웬 우유병 같은 게 놓여 있었다."},
{"id": "clah09:4400", "ko": "「꽃?」"},
{"id": "clah09:4500", "ko": "꽃 한 송이 꽂는 화병이라는 거다."},
{"id": "clah09:4600", "ko": "언제 이런 걸 놔뒀던 거야."},
{"id": "clah09:4700", "ko": "그러고 보니…… 싱크대 주변이 깨끗해져 있었지."},
{"id": "clah09:4800", "ko": "게다가 세면실도……"},
{"id": "clah09:4900", "ko": "「…………」"},
{"id": "clah09:5000", "ko": "왠지 방 안이 추운 것 같은 기분이 든다."},
{"id": "clah09:5100", "ko": "분명 사람 수가 줄어든 탓이다."},
{"id": "clah09:5200", "ko": "그렇다고 난방을 켤 정도는 아니고, 일단 겉옷이라도 걸치고……"},
{"id": "clah09:5300", "ko": "「어라……?」"},
{"id": "clah09:5400", "ko": "분명 이 겉옷, 밑단 쪽이 풀려 있었을 텐데……"},
{"id": "clah09:5500", "ko": "「꿰매져 있어……」"},
{"id": "clah09:5600", "ko": "그것도 빈말로라도 솜씨 좋다고는 못 하겠고."},
{"id": "clah09:5700", "ko": "「뭐야, 이거……」"},
{"id": "clah09:5800", "ko": "좋은 모습을 보여 줘서 완전히 반하게 만든다고?"},
{"id": "clah09:5900", "ko": "그럼 이런 거야말로 제대로 어필하라고, 그 녀석."},
{"id": "clah09:6000", "ko": "그랬으면 나도 조금은……"}
]
