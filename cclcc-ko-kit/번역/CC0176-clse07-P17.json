[
{"id": "clse07:157400", "ko": "「흠…… 좋아. 다 모였지?」"},
{"id": "clse07:157500", "ko": "「드디어 지금부터 나, 이토 신지 프로듀스의 아이돌 유닛 『밀푀유』의 아이돌 활동을 시작한다!」"},
{"id": "clse07:157600", "ko": "「먼저 말해 두는데, 아이돌 활동이라고 해도 처음부터 노래하거나 춤추거나 할 수 있는 건 아니야」"},
{"id": "clse07:157700", "ko": "「미안해, 유이. 그래도 생각해 봐. 노래를 부르거나 춤을 추려면 곡이 필요하잖아?」"},
{"id": "clse07:157800", "ko": "「곡을 만들려면 작곡가한테 보수도 들고, 춤을 추려 해도 안무가 필요한데 거기에도 돈이 들어」"},
{"id": "clse07:157900", "ko": "「그래! 그러니까 먼저 해야 할 일은 니야동에서 조회 수를 벌어서 유명해지고, 그걸로 보수를 얻는 거다」"},
{"id": "clse07:158000", "ko": "「그러면 그 돈을 밑천으로 곡을 만들 수도 있고, 어쩌면 선의로 만들어 주는 팬이 나올지도 몰라. 그렇지?」"},
{"id": "clse07:158100", "ko": "「알겠나, 제군들. 이 몸에게 맡겨 두면 『밀푀유』는 인기 폭발 틀림없지!」"},
{"id": "clse07:158200", "ko": "「하하하, 큰 배에 탄 셈 치고 맡기게나」"},
{"id": "clse07:158300", "ko": "「그럼 가 볼까」"},
{"id": "clse07:158400", "ko": "「당연히 촬영하러지. 니야동에 동영상을 올리려면 먼저 소재를 찍어야 하잖아?」"},
{"id": "clse07:158500", "ko": "「이런저런 준비는 내 쪽에서 해 뒀으니까」"},
{"id": "clse07:158600", "ko": "「음~ 아직 어색하네. 자, 더 웃는 얼굴 웃는 얼굴」"},
{"id": "clse07:158700", "ko": "「오, 좋아 좋아~. 자, 유토…… 가 아니라 유도!」"},
{"id": "clse07:158800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:158900", "ko": "「미야시로, 지금 좋은 데니까 조용히 해 줘!」"},
{"id": "clse07:159000", "ko": "「뭐냐니, 뭐가?」"},
{"id": "clse07:159100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:159200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:159300", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:159400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:159500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:159600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:159700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:159800", "ko": "「응? 뭐야, 미야시로. 지금 좋은 데니까――」"},
{"id": "clse07:159900", "ko": "「아……」"},
{"id": "clse07:160000", "ko": "「뭐? 왜?」"},
{"id": "clse07:160100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:160200", "ko": "「에~ 뭐야~. 나도 열심히 했는데~」"},
{"id": "clse07:160300", "ko": "「어? 당연히 신문부 부비에서 낼 예정인데?」"},
{"id": "clse07:160400", "ko": "「뭐? 그럼 어떻게 할 건데, 저기 돈!?」"},
{"id": "clse07:160500", "ko": "「아니, 무리 무리! 무리라니까! 그런 돈 없다고!」"},
{"id": "clse07:160600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:160700", "ko": "「아니, 그렇게 말해도……」"},
{"id": "clse07:160800", "ko": "「아, 아니라고! 나도 잘되라고 생각해서……」"},
{"id": "clse07:160900", "ko": "「게다가 어쩔 수 없잖아? 그럼 어떻게 그 돈을 낸다는 건데?」"},
{"id": "clse07:161000", "ko": "「어?」"},
{"id": "clse07:161100", "ko": "「으……」"},
{"id": "clse07:161200", "ko": "「나, 나는……」"},
{"id": "clse07:161300", "ko": "「나는 얼마나 쓰레기 같은 놈인 거야아아아!」"},
{"id": "clse07:161400", "ko": "「미안해, 유이! 미안하다, 유토! 나, 이제 프로듀서 그만둘게!」"},
{"id": "clse07:161500", "ko": "「그래. 부비를 믿고 있다간 호되게 당한다고」"},
{"id": "clse07:161600", "ko": "「오오, 이건――!」"},
{"id": "clse07:161700", "ko": "「아니, 어떻게 생각해도 낡았잖아. 쇼와 냄새가 풀풀 나」"},
{"id": "clse07:161800", "ko": "「미야시로! 봤어, 동영상! 대단하네, 유이네!」"},
{"id": "clse07:161900", "ko": "「아니, 봤고 뭐고, 니야동 랭킹 상위에 올라 있었잖아? 그럼 눈치채지」"},
{"id": "clse07:162000", "ko": "「뭐야, 너 체크 안 했냐?」"},
{"id": "clse07:162100", "ko": "「솔직히 말이야, 그런 소리 해도 어차피 말뿐이겠지 했거든. 근데 진짜 재능 있었구나, 프로듀서」"},
{"id": "clse07:162200", "ko": "「글쎄……?」"},
{"id": "clse07:162300", "ko": "「응? 야, 미야시로. 유이네 채널에서 생방송 시작됐어……」"},
{"id": "clse07:162400", "ko": "「괜찮은 거야, 이거?」"},
{"id": "clse07:162500", "ko": "「뭐가? 딱히 이 정도는 별거 아니잖아」"},
{"id": "clse07:162600", "ko": "「뭐야? 사용료라도 내놓으라는 거냐? 쩨쩨하네, 아리무라」"},
{"id": "clse07:162700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:162800", "ko": "「봐! 대단해, 미야시로! 카운트가 엄청난 기세로 올라가!」"},
{"id": "clse07:162900", "ko": "「오오!!」"},
{"id": "clse07:163000", "ko": "「아~……」"},
{"id": "clse07:163100", "ko": "「아~ 이거 BAN당한 모양이네」"},
{"id": "clse07:163200", "ko": "「지금 오는 중이라는 건 아닐까? 휴대폰은?」"},
{"id": "clse07:163300", "ko": "「그런 걸로 감탄할 때가 아니야. 여기 봐 봐」"},
{"id": "clse07:163400", "ko": "「아무래도 전에 니야생에서 무심코 말해 버린 모양이네」"},
{"id": "clse07:163500", "ko": "「혹시 무슨 일 있었던 거 아니냐?」"},
{"id": "clse07:163600", "ko": "「그건 봐…… 개중에는 집착하는 녀석도 있는 것 같고…… 이상한 일에 휘말린 건……」"},
{"id": "clse07:163700", "ko": "「그래도 혹시라는 것도――」"},
{"id": "clse07:163800", "ko": "「아……」"},
{"id": "clse07:163900", "ko": "「그, 그렇지. 아무리 그래도 그런 일은」"},
{"id": "clse07:164000", "ko": "「비밀? 뭐야, 그게? 알지도 못하는 남자한테 잡힐 만한 비밀이 유이한테 있다는 거냐?」"},
{"id": "clse07:164100", "ko": "「젠장…… 단서는 없는 거냐!?」"},
{"id": "clse07:164200", "ko": "「거짓말이지…… 어떻게……」"},
{"id": "clse07:164300", "ko": "「여어~! 라니, 뭐야…… 미야시로뿐이냐?」"},
{"id": "clse07:164400", "ko": "「다른 녀석들은 어떻게 됐어?」"},
{"id": "clse07:164500", "ko": "「흐~응」"},
{"id": "clse07:164600", "ko": "「뭐, 그런 날도 있겠지」"},
{"id": "clse07:164700", "ko": "「어차피 집에 가도 할 일 없으니까」"},
{"id": "clse07:164800", "ko": "「너도 마찬가지잖아?」"},
{"id": "clse07:164900", "ko": "「아, 그래」"},
{"id": "clse07:165000", "ko": "「그런 거라면 마침 잘됐다. 나 좀 잘게」"},
{"id": "clse07:165100", "ko": "「괜찮잖아, 조금쯤. 방과 후부터 졸려서 말이야~. 오전에 체육, 그것도 마라톤 같은 건 좀 봐줬으면 좋겠어」"},
{"id": "clse07:165200", "ko": "「우왓! 뭐야? 지진이냐!?」"},
{"id": "clse07:165300", "ko": "「대단했네, 방금 지진……」"},
{"id": "clse07:165400", "ko": "「그렇다면 큰일인데……」"},
{"id": "clse07:165500", "ko": "「진짜냐. 미야시로답지 않네. 그럼 내 걸…… 아……」"},
{"id": "clse07:165600", "ko": "「나도 잊어버린 모양이다. 잠깐 가져올게!」"},
{"id": "clse07:165700", "ko": "「거짓말? 진짜로? 좀 빌려줘 봐」"},
{"id": "clse07:165800", "ko": "「미야시로, 도와줘!!」"},
{"id": "clse07:165900", "ko": "「어떻게 하지? 이래서는 상황도 모르겠다고」"},
{"id": "clse07:166000", "ko": "「어이, 설마……」"},
{"id": "clse07:166100", "ko": "「진짜…… 냐……」"},
{"id": "clse07:166200", "ko": "「이, 일단 불 켜자. 이렇게 어두우면 기분이 처져」"},
{"id": "clse07:166300", "ko": "「진짜냐……」"},
{"id": "clse07:166400", "ko": "「지금 그런 말 해도 소용없잖아. 그보다 어떻게 할 거야, 이제부터?」"},
{"id": "clse07:166500", "ko": "「그렇지……」"},
{"id": "clse07:166600", "ko": "「아~아, 미야시로랑 둘이서 부실에 갇히다니. 기왕이면 여자애랑 같이 있는 게 좋았을 텐데」"},
{"id": "clse07:166700", "ko": "「그러고 보니 배고프네……」"},
{"id": "clse07:166800", "ko": "「오오, 샌드위치잖아!」"},
{"id": "clse07:166900", "ko": "「아…… 뭐야, 참치 샌드위치냐. 나는 햄 샌드위치가 좋았는데」"},
{"id": "clse07:167000", "ko": "「뭐? 이럴 때 나눠 먹는 게 친구라는 거 아니냐?」"},
{"id": "clse07:167100", "ko": "「아, 너무하네!」"},
{"id": "clse07:167200", "ko": "「…………」"},
{"id": "clse07:167300", "ko": "「……아~……」"}
]
