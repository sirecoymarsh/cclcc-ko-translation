[
{"id": "clse07:627300", "ko": "「계속 이런 시간이 이어지면 좋겠다고 생각했어」"},
{"id": "clse07:627400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:627500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:627600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:627700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:627800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:627900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:628000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:628100", "ko": "「쿠노사토 씨, 왜 여기에……?」"},
{"id": "clse07:628200", "ko": "「아……」"},
{"id": "clse07:628300", "ko": "「만족감……」"},
{"id": "clse07:628400", "ko": "「…………」"},
{"id": "clse07:628500", "ko": "「…………」"},
{"id": "clse07:628600", "ko": "「너, 네 말을 일부 인정하지……」"},
{"id": "clse07:628700", "ko": "「저, 전에도 쿠루스가 말한 대로, 그 아기는 내가 사는 시설에 맡겨진 아이야……」"},
{"id": "clse07:628800", "ko": "「그러니까 그게 내 아이라는 너희의 상상은 사실이 아니야……」"},
{"id": "clse07:628900", "ko": "「그 점에 대해서는…… 사실이다……」"},
{"id": "clse07:629000", "ko": "「그래. 그런 거다……」"},
{"id": "clse07:629100", "ko": "「그, 그 애는 우리 가족이야. 딱히 켕길 건 없어」"},
{"id": "clse07:629200", "ko": "「그건……」"},
{"id": "clse07:629300", "ko": "「…………」"},
{"id": "clse07:629400", "ko": "「그건…… 못 해」"},
{"id": "clse07:629500", "ko": "「……상관없어」"},
{"id": "clse07:629600", "ko": "「이유?」"},
{"id": "clse07:629700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:629800", "ko": "「그러니까 그 애를 여기 데려올 생각도 없고, 이런 데서 구경거리로 만들 생각도 없어. 더 이상 변명도 안 해」"},
{"id": "clse07:629900", "ko": "「만약 그게 마음에 안 든다면…… 나는 너희의 결정에 따르겠어……!」"},
{"id": "clse07:630000", "ko": "「노노…… 어째서……」"},
{"id": "clse07:630100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:630200", "ko": "（노노……）"},
{"id": "clse07:630300", "ko": "「노노……」"},
{"id": "clse07:630400", "ko": "「뭐, 뭐야!!」"},
{"id": "clse07:630500", "ko": "「다들 학생회장한테 엄청 신세 졌잖아!!」"},
{"id": "clse07:630600", "ko": "「지금까지 그 사람은 아무리 작은 호소라도 귀 기울여 줬잖아!」"},
{"id": "clse07:630700", "ko": "「학교와의 귀찮은 교섭이든, 이웃의 민원이든, 언제나 앞장서서 싸워 준 건 그 사람이잖아?」"},
{"id": "clse07:630800", "ko": "「학교에 건의함을 둬서 의견을 내기 쉽게 한 것도, 여러 동아리의 불만을 전부 듣고 내 일처럼 고민해 준 것도 그 사람이야!!」"},
{"id": "clse07:630900", "ko": "「그건 그 사람이 모두를 생각해서 한 일이잖아! 모두가 즐겁게 지낼 수 있도록 해 준 일이잖아!」"},
{"id": "clse07:631000", "ko": "「확실히 그 사람은 모습을 속였을지도 몰라!」"},
{"id": "clse07:631100", "ko": "「하지만 지금까지 학생회장으로서 그 사람이 모두를 위해 애써 온 건 사실이야!」"},
{"id": "clse07:631200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:631300", "ko": "「참견쟁이에 다정하고 가끔은 무서울 때도 있지만…… 그래도 겉모습이 다르다고 해서 달라지는 건 아무것도 없어!」"},
{"id": "clse07:631400", "ko": "「그 사람은 그 사람이야!!!」"},
{"id": "clse07:631500", "ko": "「……!?」"},
{"id": "clse07:631600", "ko": "「오노에……」"},
{"id": "clse07:631700", "ko": "「하하…… 들었어, 센리? 다들 인정해 준 거야, 너를」"},
{"id": "clse07:631800", "ko": "「우, 울 리가 없잖아. 그러는 센리야말로」"},
{"id": "clse07:631900", "ko": "「뭐, 이 정도는 받아들여야지……」"},
{"id": "clse07:632000", "ko": "「어?」"},
{"id": "clse07:632100", "ko": "「아, 아니야, 그건 그러니까……!」"},
{"id": "clse07:632200", "ko": "「아니, 지금 거기서 그렇게 받아쳐!?」"},
{"id": "clse07:632300", "ko": "「아〜, 아니, 그건 그러니까……」"},
{"id": "clse07:632400", "ko": "「윽……」"},
{"id": "clse07:632500", "ko": "「센리……」"},
{"id": "clse07:632600", "ko": "「…………」"},
{"id": "clse07:632700", "ko": "「――같은 거, 할 수 있겠냐아아아아아아!!」"},
{"id": "clse07:632800", "ko": "「센리!」"},
{"id": "clse07:632900", "ko": "「또 보자, 히카리. 행복해야 해」"},
{"id": "clse07:633000", "ko": "「방금……」"},
{"id": "clse07:633100", "ko": "「쿠노사토 씨!? 왜……」"},
{"id": "clse07:633200", "ko": "「그럼 카와하라한테도 능력이……?」"},
{"id": "clse07:633300", "ko": "「그런 일이 있어요?」"},
{"id": "clse07:633400", "ko": "「그럼 카와하라는……」"},
{"id": "clse07:633500", "ko": "「응. 별로……」"},
{"id": "clse07:633600", "ko": "「자, 슬슬 들어가자. 계속 여기 있어 봤자 춥기만 해」"},
{"id": "clse07:633700", "ko": "「응……」"},
{"id": "clse07:633800", "ko": "「어떻게라니…… 딱히…… 가족끼리 집에서……」"},
{"id": "clse07:633900", "ko": "「그래?」"},
{"id": "clse07:634000", "ko": "「그럼 집에는 우리랑 우키만……」"},
{"id": "clse07:634100", "ko": "「…………」"},
{"id": "clse07:634200", "ko": "「뭐야, 저거……」"},
{"id": "clse07:634300", "ko": "「어? 아, 아아…… 뭐, 잘 지내지 않을까……?」"},
{"id": "clse07:634400", "ko": "「역시 쓸쓸해?」"},
{"id": "clse07:634500", "ko": "「그래도 그게 히카리한테 제일 좋은 거잖아」"},
{"id": "clse07:634600", "ko": "「흐앗!?」"},
{"id": "clse07:634700", "ko": "「너, 너너너, 너…… 무슨 소리를……!!」"},
{"id": "clse07:634800", "ko": "「아니, 시기가 문제가 아니잖아!」"},
{"id": "clse07:634900", "ko": "「무슨 문제냐니…… 그야, 상대라든가……」"},
{"id": "clse07:635000", "ko": "「――!!!」"},
{"id": "clse07:635100", "ko": "「노……」"},
{"id": "clse07:635200", "ko": "「어!?」"},
{"id": "clse07:635300", "ko": "「아…… 아…… 아…………」"},
{"id": "clse07:635400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:635500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:635600", "ko": "「응?」"},
{"id": "clse07:635700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:635800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:635900", "ko": "「또 보자, 히카리. 행복해야 해」"},
{"id": "clse07:636000", "ko": "「방금……」"},
{"id": "clse07:636100", "ko": "「쿠노사토 씨!? 왜……」"},
{"id": "clse07:636200", "ko": "「그럼 카와하라한테도 능력이……?」"},
{"id": "clse07:636300", "ko": "「그런 일이 있어요?」"},
{"id": "clse07:636400", "ko": "「그럼 카와하라는……」"},
{"id": "clse07:636500", "ko": "「아, 그게 말인데요……」"},
{"id": "clse07:636600", "ko": "「아…… 카, 카와하라. 그게…… 무슨 볼일…… 있어요?」"},
{"id": "clse07:636700", "ko": "「……아, 아뇨, 없는데요……」"},
{"id": "clse07:636800", "ko": "「그, 그렇…… 네요……」"},
{"id": "clse07:636900", "ko": "「뭐, 뭐어……」"},
{"id": "clse07:637000", "ko": "「…………」"},
{"id": "clse07:637100", "ko": "「하아……」"},
{"id": "clse07:637200", "ko": "「네?」"}
]
