[
{"id": "clse07:657300", "ko": "「비밀의 방……?」"},
{"id": "clse07:657400", "ko": "（애초에…… 여기는 어디지? 왜 내가 여기에?）"},
{"id": "clse07:657500", "ko": "（그래. 누군가 왔었어!）"},
{"id": "clse07:657600", "ko": "「……?」"},
{"id": "clse07:657700", "ko": "「저기…… 누구, 세요?」"},
{"id": "clse07:657800", "ko": "「오노에!」"},
{"id": "clse07:657900", "ko": "（그렇다곤 해도…… 아마 그때 오노에가 나한테 뭔가를 해서 ⟦rb⟧여기⟦rt⟧⟦rbc⟧●●⟦/r⟧로 데려온 거야）"},
{"id": "clse07:658000", "ko": "（이제 두 번 다시 올 일은 없을 줄 알았는데）"},
{"id": "clse07:658100", "ko": "（이런 건 ⟦rb⟧거기⟦rt⟧⟦rbc⟧●●⟦/r⟧에서밖에 맡아 본 적 없는 냄새야）"},
{"id": "clse07:658200", "ko": "（그런데 어떻게 이런 곳에 나를!?）"},
{"id": "clse07:658300", "ko": "「너…… 너……?」"},
{"id": "clse07:658400", "ko": "「……?」"},
{"id": "clse07:658500", "ko": "「미끼?」"},
{"id": "clse07:658600", "ko": "「너, 너, 대체 무슨 소리를……?」"},
{"id": "clse07:658700", "ko": "「내…… 소원?」"},
{"id": "clse07:658800", "ko": "「뭐, 뭐야, 그게!? 그런 거, 나는――」"},
{"id": "clse07:658900", "ko": "「으……?」"},
{"id": "clse07:659000", "ko": "「너, 너 같은 녀석한테 들을 말은……」"},
{"id": "clse07:659100", "ko": "「……?」"},
{"id": "clse07:659200", "ko": "「오노에가? 그럴 수가……」"},
{"id": "clse07:659300", "ko": "「어?」"},
{"id": "clse07:659400", "ko": "「잠!? 잠깐 기다려! 그런――」"},
{"id": "clse07:659500", "ko": "「읏……!?」"},
{"id": "clse07:659600", "ko": "「그 녀석?」"},
{"id": "clse07:659700", "ko": "「…………」"},
{"id": "clse07:659800", "ko": "（젠장……）"},
{"id": "clse07:659900", "ko": "（그래, 이 작전이다. 이거라면 잘될 거야）"},
{"id": "clse07:660000", "ko": "「어, 어이, 오노에? 오노에〜〜?」"},
{"id": "clse07:660100", "ko": "「화장실 가고 싶어! 이거 풀어 줘!」"},
{"id": "clse07:660200", "ko": "「대놓고 말하지 마! 여자애면 좀 더 조신하게 굴어!」"},
{"id": "clse07:660300", "ko": "「네가 가 봤자 아무 해결도 안 된다고!」"},
{"id": "clse07:660400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:660500", "ko": "「안 도망친다니까!! 아무튼 이 나이에 지려 버리는 건 내 영혼이 못 견딘다고!」"},
{"id": "clse07:660600", "ko": "「뭐・라・고――!?」"},
{"id": "clse07:660700", "ko": "「그, 그거, 설마――!」"},
{"id": "clse07:660800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:660900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:661000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:661100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:661200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:661300", "ko": "「왜!?」"},
{"id": "clse07:661400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:661500", "ko": "「그럴 리가 있겠냐!」"},
{"id": "clse07:661600", "ko": "「어? 오, 오노에……?」"},
{"id": "clse07:661700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:661800", "ko": "「…………」"},
{"id": "clse07:661900", "ko": "「아니, 그게……」"},
{"id": "clse07:662000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:662100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:662200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:662300", "ko": "（그런 건 도저히 못 견디잖아?）"},
{"id": "clse07:662400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:662500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:662600", "ko": "（그런데…… 이 벨트가 생각보다. 젠장）"},
{"id": "clse07:662700", "ko": "「그러니까, 벌써 수업은 끝났어, 오노에?」"},
{"id": "clse07:662800", "ko": "「동아리는?」"},
{"id": "clse07:662900", "ko": "（좋아. 경찰이라면 신조 씨도 와 있을 거야. 이걸로 탈출할 가능성이 올라갔다）"},
{"id": "clse07:663000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:663100", "ko": "「우와아아아――!?」"},
{"id": "clse07:663200", "ko": "「아니야! 방금 건 그냥 농담이라니까!! 그보다 너, 뭘 하려는 거야!?」"},
{"id": "clse07:663300", "ko": "「울면서 사과하기는커녕 1초 만에 죽는다고! 이제 안 그럴 테니까 그만둬――!」"},
{"id": "clse07:663400", "ko": "「정말정말!」"},
{"id": "clse07:663500", "ko": "「미안, 오노에! 깊이 반성하고 있으니까!」"},
{"id": "clse07:663600", "ko": "（어, 어이, 오노에……? 그 소리로 봐서는 방금 그 쇠집게, 꽤 무겁고 단단했지? 그치?）"},
{"id": "clse07:663700", "ko": "「응! 진짜 배고프니까 부탁해!」"},
{"id": "clse07:663800", "ko": "「어?」"},
{"id": "clse07:663900", "ko": "「어떻게라니…… 두 손이 이래서는 못 먹잖아……」"},
{"id": "clse07:664000", "ko": "「평소처럼 두 손의 사슬을 조금만 느슨하게 해 주면……」"},
{"id": "clse07:664100", "ko": "「……그거, 라니?」"},
{"id": "clse07:664200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:664300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:664400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:664500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:664600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:664700", "ko": "「응! 엄청, 맛있어!」"},
{"id": "clse07:664800", "ko": "「너, 정말 요리 실력 늘었구나! 놀랐어!」"},
{"id": "clse07:664900", "ko": "「잘 먹었습니다! 맛있었어, 고마워」"},
{"id": "clse07:665000", "ko": "「……?」"},
{"id": "clse07:665100", "ko": "「오노에, 너……」"},
{"id": "clse07:665200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:665300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:665400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:665500", "ko": "「우긋……」"},
{"id": "clse07:665600", "ko": "「끄으응……!」"},
{"id": "clse07:665700", "ko": "「그, 그, 그것만은 그만둬――!」"},
{"id": "clse07:665800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:665900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:666000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:666100", "ko": "「……?」"},
{"id": "clse07:666200", "ko": "「…………」"},
{"id": "clse07:666300", "ko": "「아얏……」"},
{"id": "clse07:666400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:666500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:666600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:666700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:666800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:666900", "ko": "", "note": "보류 — 연애 묘사"},
