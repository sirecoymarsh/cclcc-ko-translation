[
{"id": "clse07:694400", "ko": "「아, 아니, 그래도 아이돌이 그렇게 쉽게 될 수 있는 게 아니잖아」"},
{"id": "clse07:694500", "ko": "「그렇다고 해도 말이지……」"},
{"id": "clse07:694600", "ko": "「저기, 유이――」"},
{"id": "clse07:694700", "ko": "「…………」"},
{"id": "clse07:694800", "ko": "「뭐!? 노노가…… 아이돌?」"},
{"id": "clse07:694900", "ko": "「아, 아뇨…… 아무것도 아닙니다……」"},
{"id": "clse07:695000", "ko": "「（일단 자려고 노력이라도 해 볼까）」"},
{"id": "clse07:695100", "ko": "「（누구지, 이런 시간에?）」"},
{"id": "clse07:695200", "ko": "「…………」"},
{"id": "clse07:695300", "ko": "「유토…… 왜 그래?」"},
{"id": "clse07:695400", "ko": "「안 되잖아, 이런 시간까지 깨어 있으면」"},
{"id": "clse07:695500", "ko": "「나랑?」"},
{"id": "clse07:695600", "ko": "「그래서 할 얘기라는 게?」"},
{"id": "clse07:695700", "ko": "「어? 미안. 잘 못 들었어」"},
{"id": "clse07:695800", "ko": "「……」"},
{"id": "clse07:695900", "ko": "「………………」"},
{"id": "clse07:696000", "ko": "「…………………………」"},
{"id": "clse07:696100", "ko": "「에에에에에에에에에엣!!!?」"},
{"id": "clse07:696200", "ko": "「자, 잠깐만, 유토! 여자애라니…… 그러니까, 그…… 남자가 아니라는 거지!?」"},
{"id": "clse07:696300", "ko": "「그, 그야 갑자기 그런 말을 들어도……」"},
{"id": "clse07:696400", "ko": "「어……?」"},
{"id": "clse07:696500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:696600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:696700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:696800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:696900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:697000", "ko": "「그, 그런데…… 왜?」"},
{"id": "clse07:697100", "ko": "「그, 그런데…… 왜?」"},
{"id": "clse07:697200", "ko": "「엥?」"},
{"id": "clse07:697300", "ko": "「기, 기다려, 유토! 그런 말을 갑자기 해도 나는――」"},
{"id": "clse07:697400", "ko": "「어?」"},
{"id": "clse07:697500", "ko": "「윽……」"},
{"id": "clse07:697600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:697700", "ko": "「…………」"},
{"id": "clse07:697800", "ko": "「유토…… 왜 그래?」"},
{"id": "clse07:697900", "ko": "「안 되잖아, 이런 시간까지 깨어 있으면」"},
{"id": "clse07:698000", "ko": "「부탁? 나한테?」"},
{"id": "clse07:698100", "ko": "「그렇구나. 좋아, 내가 할 수 있는 거라면 뭐든 들어줄게」"},
{"id": "clse07:698200", "ko": "「그래. 나는 형이니까」"},
{"id": "clse07:698300", "ko": "「…………뭐라고?」"},
{"id": "clse07:698400", "ko": "「기다려, 유토. 그렇다고 그 생각은 너무 성급하잖아」"},
{"id": "clse07:698500", "ko": "「유, 유토……?」"},
{"id": "clse07:698600", "ko": "「지, 진짜……? 그게 무슨 뜻이야……?」"},
{"id": "clse07:698700", "ko": "「유토…… 너, 무슨 소리를 하는 거야?」"},
{"id": "clse07:698800", "ko": "「말을 들으라니…… 설마……」"},
{"id": "clse07:698900", "ko": "「힉――!?」"},
{"id": "clse07:699000", "ko": "「아…… 아아……」"},
{"id": "clse07:699100", "ko": "「우와아아아아아아아아아아앗!!」"},
{"id": "clse07:699200", "ko": "「으…… 아아아아아아아아아아아아아아아아!!」"},
{"id": "clse07:699300", "ko": "「…………」"},
{"id": "clse07:699400", "ko": "「…………」"},
{"id": "clse07:699500", "ko": "「아, 잠깐」"},
{"id": "clse07:699600", "ko": "「아니, 괜찮아. 깨어 있었으니까」"},
{"id": "clse07:699700", "ko": "「그게…… 들어올래?」"},
{"id": "clse07:699800", "ko": "「그래서 이런 시간에 무슨 일이야?」"},
{"id": "clse07:699900", "ko": "「유이 일이라니…… 그 아이돌이 되고 싶다는 얘기?」"},
{"id": "clse07:700000", "ko": "「그래도 유이는 포기한다고……」"},
{"id": "clse07:700100", "ko": "「유이야말로 무슨 일이야? 벌써 한밤중이라고」"},
{"id": "clse07:700200", "ko": "「그럼 용건은 우키랑 같네」"},
{"id": "clse07:700300", "ko": "「우키는 유이한테 한 번 아이돌을 시켜 달라고…… 그걸 위해 협력해 달라고 말하러 왔어」"},
{"id": "clse07:700400", "ko": "「…………」"},
{"id": "clse07:700500", "ko": "「（이건……）」"},
{"id": "clse07:700600", "ko": "「（어쩌면 이 둘, 될지도 몰라!）」"},
{"id": "clse07:700700", "ko": "「저기, 우키…… 전에 텔레비전에서 그러던데, 아이돌은 누군가에게 힘을 주려고 열심히 하는 거래」"},
{"id": "clse07:700800", "ko": "「노래하고 춤추며 열심히 하는 모습을 보여 주면 누군가가 기뻐해 준다. 그래서 자기들은 힘낼 수 있고, 웃을 수 있다고―― 그러더라」"},
{"id": "clse07:700900", "ko": "「그러니까 말이야. 해 보는 건 어때?」"},
{"id": "clse07:701000", "ko": "「모처럼이잖아. 가끔은 스스로 도전해 봐」"},
{"id": "clse07:701100", "ko": "「게다가 유이도 우키를 필요로 하고 있어. 그렇지, 유이?」"},
{"id": "clse07:701200", "ko": "「에에에에에에에에에에에에에에엣!?」"},
{"id": "clse07:701300", "ko": "「아니, 그치만 지금 흐름이면 “알겠어요! 저, 할게요!”라고 할 차례잖아, 보통」"},
{"id": "clse07:701400", "ko": "「이거다!!!!!」"},
{"id": "clse07:701500", "ko": "「후후후…… 된다, 된다고, 이건!! 하하하하하!」"},
{"id": "clse07:701600", "ko": "「유이. 오늘부터 너는 아이돌이다!」"},
{"id": "clse07:701700", "ko": "「그리고 유토! 너도다!」"},
{"id": "clse07:701800", "ko": "「모르겠어? 오늘부로 둘은 유이와 유. 자매 유닛으로 아이돌 활동을 시작하는 거다!!」"},
{"id": "clse07:701900", "ko": "「아니, 유토…… 너라면 될 수 있어! 내가 보증해」"},
{"id": "clse07:702000", "ko": "「저기, 우키는 어떻게 생각해? 유토한테는 무리라고 생각해?」"},
{"id": "clse07:702100", "ko": "「저기, 유토」"},
{"id": "clse07:702200", "ko": "「만약 아이돌 활동으로 성공하면 갖고 싶은 거 뭐든 살 수 있어」"},
{"id": "clse07:702300", "ko": "「그래……」"},
{"id": "clse07:702400", "ko": "「물론! 프리스테 베다도 살 수 있어!」", "note": "새 용어: プリステ・ヴェーダ → 프리스테 베다(게임기 이름)"},
{"id": "clse07:702500", "ko": "「어때, 유토. 해 보지 않을래?」"},
{"id": "clse07:702600", "ko": "「정말!?」"},
{"id": "clse07:702700", "ko": "「（이건 된다――!!）」"},
{"id": "clse07:702800", "ko": "「아, 맞다…… 둘 다. 거듭 말해 두는데, 이건 쿠루스한테는 비밀이다」"},
{"id": "clse07:702900", "ko": "「쿠루스는 설득하는 데 시간이 걸리니까. 어느 정도 결과를 내고 나서가 아니면 절대 반대할 거야」"},
{"id": "clse07:703000", "ko": "「우키도, 알았지?」"},
{"id": "clse07:703100", "ko": "「걱정 마. 그 녀석한테는 적당한 타이밍에 내가 제대로 말해 줄 테니까」"},
{"id": "clse07:703200", "ko": "「프로듀서……?」"},
{"id": "clse07:703300", "ko": "「（정말이지. 곤란하군……）」"},
{"id": "clse07:703400", "ko": "「응? 무슨 일인가, 오노에 군?」"},
{"id": "clse07:703500", "ko": "「미안하지만 저녁 일정은 전부 취소해 주게」"},
{"id": "clse07:703600", "ko": "「두 번 말하게 하지 마」"},
{"id": "clse07:703700", "ko": "「마운틴 뷰와 우유를」"},
{"id": "clse07:703800", "ko": "「……그래서?」"},
{"id": "clse07:703900", "ko": "「어떻게 하면…… 이라니?」"},
{"id": "clse07:704000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:704100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:704200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:704300", "ko": "", "note": "보류 — 성적 묘사"}
]
