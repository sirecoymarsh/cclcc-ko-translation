[
{"id": "clah05:10000", "ko": "「〜〜〜〜♪」"},
{"id": "clah05:10100", "ko": "일단 여기선 진정하자."},
{"id": "clah05:10200", "ko": "이럴 때는 소수를 세거나, 아니면 원소 주기율표를 암송하는 게 정석이다."},
{"id": "clah05:10300", "ko": "2, 3, 5, 7, 11……"},
{"id": "clah05:10400", "ko": "「…………」"},
{"id": "clah05:10500", "ko": "「후후〜응」"},
{"id": "clah05:10600", "ko": "젠장!!"},
{"id": "clah05:10700", "ko": "안 보려고 하면 할수록 자꾸 눈이 그쪽으로 가 버린다!!"},
{"id": "clah05:10800", "ko": "이래서야 아리무라 뜻대로다."},
{"id": "clah05:10900", "ko": "좋아, 생각을 바꾸자."},
{"id": "clah05:11000", "ko": "그래. 애초에 수영복이란 무엇인가?"},
{"id": "clah05:11100", "ko": "수영복이란 그저 물에 들어간다는 목적을 위해 만든 옷―― 요컨대 남에게 보이는 것을 전제로 만든 물건이다."},
{"id": "clah05:11200", "ko": "본래 보여서는 안 될 것을 눈에 담았을 때, 비로소 사람은 희열을 느끼는 법 아닌가?"},
{"id": "clah05:11300", "ko": "그렇다면 수영복 따위는 노출이 조금 많으냐 적으냐의 차이일 뿐, 평소 입는 교복이나 사복과 다를 게 없는 그냥 물속용 의복이 아닌가."},
{"id": "clah05:11400", "ko": "애초에 보이는 걸 전제로 한 것을 보고 기분이 들뜬다는 것도 이상한 이야기다."},
{"id": "clah05:11500", "ko": "「…………」"},
{"id": "clah05:11600", "ko": "응. 점점 진정되기 시작했어."},
{"id": "clah05:11700", "ko": "지금이라면 아리무라의 모습을 봐도――"},
{"id": "clah05:11800", "ko": "「자, 완성됐어요〜」"},
{"id": "clah05:11900", "ko": "아리무라가 갓 만든 요리가 담긴 접시를 들고 다가왔다."},
{"id": "clah05:12000", "ko": "언제 벗었는지, 아까까지 두르고 있던 앞치마는 이제 없다."},
{"id": "clah05:12100", "ko": "「우훗♪」"},
{"id": "clah05:12200", "ko": "꽤, 꽤나 아슬아슬한 수영복 차림이다."},
{"id": "clah05:12300", "ko": "아까까지의 나였다면 시선 둘 곳을 몰라 횡설수설했을 것이다."},
{"id": "clah05:12400", "ko": "하지만 지금의 나에게 그건 그저 의복."},
{"id": "clah05:12500", "ko": "즉, 평소 차림과 하등 다를 게 없는 것이다."},
{"id": "clah05:12600", "ko": "「아리무라」"},
{"id": "clah05:12700", "ko": "「왜 그래요? 혹시 기브업이에요?」"},
{"id": "clah05:12800", "ko": "「춥지 않아?」"},
{"id": "clah05:12900", "ko": "「에?」"},
{"id": "clah05:13000", "ko": "「언제까지 그런 차림으로 있다간 감기 걸린다」"},
{"id": "clah05:13100", "ko": "「……그, 그런 말로 얼버무려도 소용없슴다」"},
{"id": "clah05:13200", "ko": "「난 딱히 얼버무리는 거 아냐. 그냥 추울 테니까 옷을 입는 게 낫지 않을까 생각했을 뿐이야」"},
{"id": "clah05:13300", "ko": "「흐〜응, 그래요? 하지만 저는 이대로도…… 엣취!」"},
{"id": "clah05:13400", "ko": "「거봐」"},
{"id": "clah05:13500", "ko": "아무리 이 안이 좀 따뜻하다고 해도, 달력상으로는 벌써 11월이다."},
{"id": "clah05:13600", "ko": "수영복 차림으로는 몸이 식을 게 분명하다."},
{"id": "clah05:13700", "ko": "「으으…… 그럼 이렇게 해요. 선배가 히나에한테 두근두근 러브 하트라고 말하면 옷 입을게요」"},
{"id": "clah05:13800", "ko": "「……그걸 말하면 되는 거야?」"},
{"id": "clah05:13900", "ko": "「으……」"},
{"id": "clah05:14000", "ko": "「말하면 되는 거지? 그럼……」"},
{"id": "clah05:14100", "ko": "「잠깐, 잠깐! 역시 됐어요! 알겠어요. 오늘은 얌전히 옷 입을게요……」"},
{"id": "clah05:14200", "ko": "휴……"},
{"id": "clah05:14300", "ko": "하고 가슴을 쓸어내린 내 귀에 뭔가 보글보글 둔한 소리가 들려왔다."},
{"id": "clah05:14400", "ko": "「응? 뭐지, 이 소리」"},
{"id": "clah05:14500", "ko": "「아! 이런. 그러고 보니 요리 하나 더 데우고 있었지!」"},
{"id": "clah05:14600", "ko": "옷을 들고 세면실로 가려던 아리무라가 허둥지둥 싱크대 쪽으로 간다."},
{"id": "clah05:14700", "ko": "위험하네. 그대로 잊어버렸으면 불이라도 날 뻔했다."},
{"id": "clah05:14800", "ko": "（그건 그렇고…… 여자 수영복은 참 불안하단 말이지. 저렇게 가는 끈이라니, 풀리기라도 하면……）"},
{"id": "clah05:14900", "ko": "아리무라의 뒷모습을 보며 그런 생각을 하고 있자니, 이윽고 아리무라가 김이 오르는 작은 양수 냄비를 들고 종종걸음으로 다가와……"},
{"id": "clah05:15000", "ko": "그리고――"},
{"id": "clah05:15100", "ko": "「자, 자〜, 테이블 좀 비워 주세요오――우왓!」"},
{"id": "clah05:15200", "ko": "발이 걸렸다."},
{"id": "clah05:15300", "ko": "「잠――!」"},
{"id": "clah05:15400", "ko": "균형을 잃고 덮쳐 오는 아리무라를 향해 나는 반사적으로 두 손을 내밀었지만, 그게 잘못이었다."},
{"id": "clah05:15500", "ko": "뜻밖의 사태에 내 능력이 발동해 버린 것이다."},
{"id": "clah05:15600", "ko": "아까 떠올린 내 망상이 능력과 감응해――아리무라의 수영복 끈이 풀리는 형태로 결실을 맺었다."},
{"id": "clah05:15700", "ko": "「히약!」"},
{"id": "clah05:15800", "ko": "스르륵 풀리는 끈."},
{"id": "clah05:15900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:16000", "ko": "내미는 두 손."},
{"id": "clah05:16100", "ko": "그리고 다가오는 아리무라."},
{"id": "clah05:16200", "ko": "그 결과."},
{"id": "clah05:16300", "ko": "「읏……!?」"},
{"id": "clah05:16400", "ko": "（뭐지, 이거……）"},
{"id": "clah05:16500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:16600", "ko": "「싫……」"},
{"id": "clah05:16700", "ko": "어라? 이거……"},
{"id": "clah05:16800", "ko": "「싫어어어어어어어어어어엇!」"},
{"id": "clah05:16900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:17000", "ko": "「으아아앗! 아니야! 아니라고! 나는 절대 그런 생각으로 한 게 아니라!!」"},
{"id": "clah05:17100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:17200", "ko": "「아, 아무튼 손 떼 주세요!!」"},
{"id": "clah05:17300", "ko": "「아, 알았어!」"},
{"id": "clah05:17400", "ko": "「아, 잠깐 기다려!!」"},
{"id": "clah05:17500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:17600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:17700", "ko": "「아, 아리무라! 너, 너, 뭐 하는……」"},
{"id": "clah05:17800", "ko": "「아, 아니거든! 그게 아니라…… 손 떼면 다 보여 버린단 말이야……」"},
{"id": "clah05:17900", "ko": "「아……」"},
{"id": "clah05:18000", "ko": "공교롭게도 아리무라는 냄비를 드느라 두 손이 다 묶여 있다."},
{"id": "clah05:18100", "ko": "내던졌다간 둘 다 큰 화상을 입을 게 뻔하다."},
{"id": "clah05:18200", "ko": "「아, 아무튼 진정해, 응?」"},
{"id": "clah05:18300", "ko": "「지, 진정할 수 있을 리가 없잖아요!」"},
{"id": "clah05:18400", "ko": "아리무라 말이 맞다."},
{"id": "clah05:18500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:18600", "ko": "「서, 선배. 이 냄비, 내던져도 돼요?」"},
{"id": "clah05:18700", "ko": "「당연히 안 되지!」"},
{"id": "clah05:18800", "ko": "「앗!」"},
{"id": "clah05:18900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:19000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:19100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:19200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah05:19300", "ko": "「아, 아니야. 불가항력이야!」"},
{"id": "clah05:19400", "ko": "안 되겠다."},
{"id": "clah05:19500", "ko": "이대로는 정말 어떻게 돼 버리겠다."},
{"id": "clah05:19600", "ko": "이 상황을 벗어나려면――"},
{"id": "clah05:19700", "ko": "「어라…… 그렇지, 내가 눈을 감으면 되는 거 아냐?」"},
{"id": "clah05:19800", "ko": "「아〜! 그거예요! 왜 빨리 말 안 했어요! 선배 엉큼해!」"},
{"id": "clah05:19900", "ko": "「너, 너도 생각 못 했잖아!」"}
]
