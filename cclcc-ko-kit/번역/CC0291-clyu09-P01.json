[
{"id": "clyu09:0", "ko": "「『알았어. 그럼 잠깐만 기다려 줘』」"},
{"id": "clyu09:100", "ko": "그렇게 말을 남기고 한동안 화면이 꺼졌다."},
{"id": "clyu09:200", "ko": "아마 유이 방쯤에서 유니폼으로 갈아입고 있겠지."},
{"id": "clyu09:300", "ko": "「괜찮은 거냐, 이거?」"},
{"id": "clyu09:400", "ko": "「응…… 뭐, 괜찮지 않을까?」"},
{"id": "clyu09:500", "ko": "유이도 아직 중학생이다."},
{"id": "clyu09:600", "ko": "그냥 평범했던 중학생이 조금 떠받들어지기 시작하면 들뜨는 일도 있겠지."},
{"id": "clyu09:700", "ko": "⟦col:280aa02d1400⟧프로듀서⟦col:800000⟧라고는 해도 내가 모든 걸 관리하는 건 아니다."},
{"id": "clyu09:800", "ko": "말하자면 하고 싶은 일을 도와주고 있을 뿐이다."},
{"id": "clyu09:900", "ko": "가끔은 나 없이 ⟦col:280aa02d1400⟧니야생⟦col:800000⟧을 하고 싶다―― 그게 두 사람이 하고 싶은 일이라면 내가 이러쿵저러쿵할 일도 아니겠지."},
{"id": "clyu09:1000", "ko": "어느 정도는 하고 싶은 대로 하게 둔다―― 그건 불만을 품지 않도록 관리하기 위해서도 필요한 일이다."},
{"id": "clyu09:1100", "ko": "게다가 시청자들의 요청을 보는 한, 그 정도 리퀘스트라면 별문제도 없을 터였다."},
{"id": "clyu09:1200", "ko": "「『그럼 시작할게』」"},
{"id": "clyu09:1300", "ko": "화면이 다시 켜지자, 거기에는 전에 아리무라가 가져온 유니폼을 입은 유이와 유토의 모습이 있었다."},
{"id": "clyu09:1400", "ko": "장소는 방이 아니라 욕실이다."},
{"id": "clyu09:1500", "ko": "", "note": "보류 — 성적 묘사(미성년, 1500~1900)"},
{"id": "clyu09:1600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:1700", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:1800", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:1900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:2000", "ko": "「『꺅! 차가워~!』」"},
{"id": "clyu09:2100", "ko": "「――!!」"},
{"id": "clyu09:2200", "ko": "화면 속에서 유이가 샤워기를 틀어 온도를 확인하기 시작함과 동시에 부실 문이 열려서, 나는 허둥지둥 스마트폰을 손으로 가렸다."},
{"id": "clyu09:2300", "ko": "「차오~슴다! 히나에다~」"},
{"id": "clyu09:2400", "ko": "「뭐야, 아리무라냐. 놀라게 하지 마」"},
{"id": "clyu09:2500", "ko": "「응? 으응~? 선배님들, 뭘 몰래 보고 있었어요? 앗! 혹시……」"},
{"id": "clyu09:2600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:2700", "ko": "「바보야, 큰 소리 내지 마. 그런 거 아니라니까」"},
{"id": "clyu09:2800", "ko": "「그럼 왜 허둥지둥 숨겼어요?」"},
{"id": "clyu09:2900", "ko": "뭐, 아리무라도 한때는 프로듀서로 손을 들었던 사람이다. 알려 줘도 문제없겠지."},
{"id": "clyu09:3000", "ko": "「유이랑 유토가 둘이서 니야생을 시작했거든. 그걸 보고 있었어」"},
{"id": "clyu09:3100", "ko": "「아, 그러고 보니 꽤 인기인 것 같더라고요, 『⟦col:280aa02d1400⟧밀푀유⟦col:800000⟧』」"},
{"id": "clyu09:3200", "ko": "아리무라는 그렇게 말하며 내 스마트폰 화면을 들여다보았다."},
{"id": "clyu09:3300", "ko": "「네? 이거…… 좀 위험하지 않아요?」"},
{"id": "clyu09:3400", "ko": "「뭐가? 딱히 이 정도는 별것 아니잖아」"},
{"id": "clyu09:3500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:3600", "ko": "「그게 아니라, 이 유니폼……」"},
{"id": "clyu09:3700", "ko": "「이거, 전에 제가 준비한 거 맞죠?」"},
{"id": "clyu09:3800", "ko": "「뭐야? 사용료라도 내놓으라는 거냐? 쩨쩨하다, 아리무라」"},
{"id": "clyu09:3900", "ko": "「이토 선배처럼 쪼잔한 소리는 안 한다니까요」"},
{"id": "clyu09:4000", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:4100", "ko": "나한테 묻지 마."},
{"id": "clyu09:4200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:4300", "ko": "「그보다 아리무라. 뭐가 위험하다는 건데?」"},
{"id": "clyu09:4400", "ko": "「이 유니폼…… 종이인데요」"},
{"id": "clyu09:4500", "ko": "아리무라는 머뭇머뭇 화면을 가리키며 알 수 없는 소리를 했다."},
{"id": "clyu09:4600", "ko": "「뭐? 무슨 소리야?」"},
{"id": "clyu09:4700", "ko": "「그러니까, 이 유니폼…… 종이로 만든 거예요」"},
{"id": "clyu09:4800", "ko": "「『음, 이 정도 온도면 딱 좋으려나? 그럼…… 에잇!!』」"},
{"id": "clyu09:4900", "ko": "「『히얏!』」"},
{"id": "clyu09:5000", "ko": "화면 속에서는 지금 막 유이와 유토가 물장난을 시작하려는 참이었다."},
{"id": "clyu09:5100", "ko": "「조, 종이? 종이라니 그 종이?! 왜?」"},
{"id": "clyu09:5200", "ko": "「당연하잖슴까! 싸게 만들려고요. 적은 돈으로 꾸려 나가다니, 히나에 유능~」"},
{"id": "clyu09:5300", "ko": "「가슴 펼 때냐!」"},
{"id": "clyu09:5400", "ko": "「『정말…… 반격이야!! 에잇!』」"},
{"id": "clyu09:5500", "ko": "「『했겠다~! 나도 반격이다~!』」"},
{"id": "clyu09:5600", "ko": "「『푸웁!!』」"},
{"id": "clyu09:5700", "ko": "당연히 그런 사실은 꿈에도 모르는 유이와 유토는 이미 머리부터 흠뻑 젖어 있었다."},
{"id": "clyu09:5800", "ko": "그 결과――"},
{"id": "clyu09:5900", "ko": "「『어, 어라? 유…… 뭔가 이상해?』」"},
{"id": "clyu09:6000", "ko": "「『그러는 누나야말로……』」"},
{"id": "clyu09:6100", "ko": "", "note": "보류 — 성적 묘사(미성년 인물의 노출, 6100~6500)"},
{"id": "clyu09:6200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:6300", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:6400", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:6500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:6600", "ko": "「『와와와!』」"},
{"id": "clyu09:6700", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:6800", "ko": "「봐! 대단하다, 미야시로! 조회 수가 엄청난 기세로 올라가고 있어!」"},
{"id": "clyu09:6900", "ko": "「바보야, 좋아할 때냐!」"},
{"id": "clyu09:7000", "ko": "조회 수만이 아니다. 댓글도 계속 늘어나서 그야말로 축제 분위기다."},
{"id": "clyu09:7100", "ko": "「『어떡해~, 우키! 어떻게 하면 좋아?』」"},
{"id": "clyu09:7200", "ko": "「『이, 이럴 때는, 그…… 그러니까…… 어, 어떡하죠……』」"},
{"id": "clyu09:7300", "ko": "다급하게 카메라 담당인 우키에게 부탁하지만, 당연히 우키가 그런 판단을 할 수 있을 리 없다."},
{"id": "clyu09:7400", "ko": "그냥 화면 밖으로 나가거나 영상을 멈추기만 하면 되는데, 갑작스러운 일에 대처하지 못하고 있는 모양이다."},
{"id": "clyu09:7500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:7600", "ko": "게다가 유토는……"},
{"id": "clyu09:7700", "ko": "언젠가 들킬 때가 온다고 해도 그건 아직 한참 뒤의 일이고, 지금은 아직 이르다."},
{"id": "clyu09:7800", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:7900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu09:8000", "ko": "그보다 너는 뭘 같이 좋아하고 있는 거야, 이토."},
{"id": "clyu09:8100", "ko": "젠장! 어떻게든 해야 해!!"},
{"id": "clyu09:8200", "ko": "그렇다고 지금 돌아가 봤자 시간 안에 닿을 리도 없고……"},
{"id": "clyu09:8300", "ko": "「아――」"},
{"id": "clyu09:8400", "ko": "「어?」"},
{"id": "clyu09:8500", "ko": "「아~……」"},
{"id": "clyu09:8600", "ko": "갑자기 아무 예고도 없이 니야생 영상이 새까맣게 변했다."},
{"id": "clyu09:8700", "ko": "유이가 방송을 멈춘…… 건 아닌 것 같다."},
{"id": "clyu09:8800", "ko": "그렇다는 건……"},
{"id": "clyu09:8900", "ko": "「아~, 이건 ⟦col:280aa02d1400⟧BAN⟦col:800000⟧당한 것 같은데」"},
{"id": "clyu09:9000", "ko": "BAN이란 부적절한 방송으로 판단되어 방송이 강제로 중지되는 것을 말한다."}
]
