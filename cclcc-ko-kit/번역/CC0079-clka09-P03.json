[
{"id": "clka09:18900", "ko": "눈앞에 얼굴을 살짝 들고 눈을 감은 카즈키의 얼굴이 있었다."},
{"id": "clka09:19000", "ko": "은은하게 분홍빛이 도는 탱글탱글한 입술은 그저 내가 닿기를 기다리고 있었다."},
{"id": "clka09:19100", "ko": "「……선배」"},
{"id": "clka09:19200", "ko": "눈을 감은 채 『하나』가 중얼거린다."},
{"id": "clka09:19300", "ko": "「제 처음, 가져 주세요」"},
{"id": "clka09:19400", "ko": "순식간에 주위 풍경이 빛을 잃고 내 시야에서 멀어져 갔다."},
{"id": "clka09:19500", "ko": "카즈키의 얼굴만이 내게 보이는 전부였다."},
{"id": "clka09:19600", "ko": "그 얼굴을 향해 내 입술이 멋대로 다가간다."},
{"id": "clka09:19700", "ko": "마치 지구에서 원격 조종으로 자동 비행하는 달 착륙선 같다."},
{"id": "clka09:19800", "ko": "「카……즈키……」"},
{"id": "clka09:19900", "ko": "「선, 배……」"},
{"id": "clka09:20000", "ko": "「응……」"},
{"id": "clka09:20100", "ko": "「……하아……」"},
{"id": "clka09:20200", "ko": "내가 무엇을 했는지 뇌가 이해하기도 전에 카즈키의 얼굴이 멀어져 갔다."},
{"id": "clka09:20300", "ko": "「……」"},
{"id": "clka09:20400", "ko": "「카, 카즈키……」"},
{"id": "clka09:20500", "ko": "「후훗」"},
{"id": "clka09:20600", "ko": "「행복하게 해 주세요. 미야시로 선배」"},
{"id": "clka09:20700", "ko": "「봐요, 다들 축복해 주고 있잖아요♪」"},
{"id": "clka09:20800", "ko": "「……어? 다, 다들?」"},
{"id": "clka09:20900", "ko": "그때."},
{"id": "clka09:21000", "ko": "「「「「축하해〜!」」」」"},
{"id": "clka09:21100", "ko": "「너, 너희!? 어어어어, 언제부터 거기 있었어!?」"},
{"id": "clka09:21200", "ko": "「언제부터냐니, 결혼식 처음부터」"},
{"id": "clka09:21300", "ko": "「겨, 결혼식!?」"},
{"id": "clka09:21400", "ko": "정신을 차려 보니 주위 풍경이 완전히 바뀌어 있었다."},
{"id": "clka09:21500", "ko": "「여, 여기는!? 교회야!?」"},
{"id": "clka09:21600", "ko": "눈앞에는 나무 긴 의자가 두 줄로 늘어서 있었다. 나와 카즈키는 한 단 높은 곳에 서 있었고, 벽에는 거대한 십자가가 걸려 있다."},
{"id": "clka09:21700", "ko": "어디로 보나 교회였다."},
{"id": "clka09:21800", "ko": "「교회예요. 결혼식이니까 당연하잖아요」"},
{"id": "clka09:21900", "ko": "「결혼식이라니, 누구랑 누구 거야!!」"},
{"id": "clka09:22000", "ko": "「타쿠랑 하나 거지 당연히」"},
{"id": "clka09:22100", "ko": "「아니, 잠깐만!」"},
{"id": "clka09:22200", "ko": "「하나, 잘됐다〜」"},
{"id": "clka09:22300", "ko": "「고마워요. 저, 타쿠루 씨랑 행복해질게요!」"},
{"id": "clka09:22400", "ko": "내 혼란은 무시한 채 이야기가 이어져 간다."},
{"id": "clka09:22500", "ko": "아리무라가 마치 마이크를 내밀듯이 『하나』를 향해 주먹을 뻗었다."},
{"id": "clka09:22600", "ko": "「『카즈키 하나 씨! 결혼을 결심하신 이유를 들려주세요!』」"},
{"id": "clka09:22700", "ko": "「에헤헤〜. 실은요〜」"},
{"id": "clka09:22800", "ko": "『하나』는 녹아내릴 듯한 웃음을 지으며 레이스 장갑을 낀 왼손을 배에 댄다."},
{"id": "clka09:22900", "ko": "그리고 그 배를 사랑스럽다는 듯 천천히 쓰다듬었다."},
{"id": "clka09:23000", "ko": "「저랑, 타쿠루 씨의, 사랑의 결정체가 이끌어 줘서, 려나?」"},
{"id": "clka09:23100", "ko": "「『사랑의 결정체! 대체 그게 무슨 뜻이죠!?』」"},
{"id": "clka09:23200", "ko": "「에〜. 부끄러워〜」"},
{"id": "clka09:23300", "ko": "「『거기를 꼭!』」"},
{"id": "clka09:23400", "ko": "「그게요〜」"},
{"id": "clka09:23500", "ko": "『하나』는 천천히 시선을 배로 향했다."},
{"id": "clka09:23600", "ko": "『하나』의 배는 볼록하게 부풀어 있었다."},
{"id": "clka09:23700", "ko": "「아기가 생겼어요」"},
{"id": "clka09:23800", "ko": "「……뭐」"},
{"id": "clka09:23900", "ko": "「다음 달에 태어나요」"},
{"id": "clka09:24000", "ko": "「뭐라고!?」"},
{"id": "clka09:24100", "ko": "「그러니까 속도위반 결혼이라는 거냐. 역시 ⟦col:280aa02d1400⟧음흉한 변태⟦col:800000⟧」"},
{"id": "clka09:24200", "ko": "「어떤 아이가 태어날까〜. 타쿠 닮았을까? 하나 닮았을까?」"},
{"id": "clka09:24300", "ko": "「하이브리드일지도 몰라요. 미야시로 선배는 입만 다물고 있으면 반듯한 얼굴이니까, 아들이든 딸이든 잘생긴 애가 태어날 것 같아요」"},
{"id": "clka09:24400", "ko": "「이야, 미야시로 선배 혈기 왕성하심다! 할 땐 하는 남자! 게다가 적중률 장난 아님다! 아니면 시도 횟수가 많았던 검까!?」"},
{"id": "clka09:24500", "ko": "「후후후훗」"},
{"id": "clka09:24600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:24700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:24800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:24900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:25000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:25100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:25200", "ko": "「동정은 좀 조용히 해 주세요」"},
{"id": "clka09:25300", "ko": "「네」"},
{"id": "clka09:25400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:25500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:25600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:25700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:25800", "ko": "「동정은 좀 조용히 해 주세요」"},
{"id": "clka09:25900", "ko": "「네」"},
{"id": "clka09:26000", "ko": "「그래도 그 미야시로 선배의 변태 성욕 덕분에 이렇게 골인할 수 있었으니까, 전화위복이네요」"},
{"id": "clka09:26100", "ko": "「하나, 타쿠가 짐승이라서 다행이다」"},
{"id": "clka09:26200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:26300", "ko": "「잠깐 기다려! 너희 지금 그 얘기를 믿는 거야!」"},
{"id": "clka09:26400", "ko": "「어디 이상한 데라도 있었어?」"},
{"id": "clka09:26500", "ko": "「제가 상상하는 미야시로 선배의 행동 그대로예요」"},
{"id": "clka09:26600", "ko": "「그러게〜」"},
{"id": "clka09:26700", "ko": "「너희는 평소에 나를 그런 눈으로 보고 있는 거야!」"},
{"id": "clka09:26800", "ko": "「타쿠루」"},
{"id": "clka09:26900", "ko": "「힉! 쿠, 쿠루스!」"},
{"id": "clka09:27000", "ko": "지금까지 잠자코 있던 쿠루스가 성큼성큼 내 앞으로 걸어왔다."},
{"id": "clka09:27100", "ko": "「……타쿠루」"},
{"id": "clka09:27200", "ko": "「자, 잠깐만 쿠루스! 이건 뭔가 착오가 있어서――」"},
{"id": "clka09:27300", "ko": "「축하해」"},
{"id": "clka09:27400", "ko": "「……에?」"},
{"id": "clka09:27500", "ko": "「타쿠루가 계획성이 없는 건 좀 마음에 걸리지만. 그래도 오늘은 그런 말 안 할게」"},
{"id": "clka09:27600", "ko": "「귀여운 동생이 새 출발 하는 날이잖아」"},
{"id": "clka09:27700", "ko": "「카즈키랑 태어날 아기, 둘 다 꼭 행복하게 해 줘야 해」"},
{"id": "clka09:27800", "ko": "「누님! 고맙습니다! 타쿠루 씨랑 이 아이랑 셋이서 꼭 행복한 가정을 꾸릴게요!」"},
{"id": "clka09:27900", "ko": "「이 얼마나 아름다운 광경인가요!」"},
{"id": "clka09:28000", "ko": "「그러게!」"},
{"id": "clka09:28100", "ko": "「나, 나나나는 가, 감동해 버렸어……!」"},
{"id": "clka09:28200", "ko": "쿠루스의 눈물에 덩달아 모두가 울기 시작했고, 뭔가 이대로 모든 이야기가 해피 엔딩으로 막을 내릴 분위기가 되어 가고 있었다."},
{"id": "clka09:28300", "ko": "이 흐름을 멈출 수 있는 건 나밖에 없었다."},
{"id": "clka09:28400", "ko": "「잠깐 기다려! 나, 나는 아직 결혼 같은 거 안 할 거야!」"},
{"id": "clka09:28500", "ko": "「에에에!?」"},
{"id": "clka09:28600", "ko": "「책임져 준다고 했잖아요! 그건 그 자리에서만 한 거짓말이었어요!?」"},
{"id": "clka09:28700", "ko": "「책임이고 뭐고, 애초에 나는 너랑 아이를 만든 기억도 없어!」"},
{"id": "clka09:28800", "ko": "「그럴 수가!」"}
]
