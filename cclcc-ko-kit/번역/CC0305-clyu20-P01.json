[
{"id": "clyu20:0", "ko": "「거기까지다!!」"},
{"id": "clyu20:100", "ko": "반쯤 걷어차듯 문을 연 신조 씨를 따라 방 안으로 뛰어들자, ⟦col:280aa02d1400⟧BJ⟦col:800000⟧는 막 유이의 옷에 손을 대려던 참이었다."},
{"id": "clyu20:200", "ko": "「타쿠루 오빠!!」"},
{"id": "clyu20:300", "ko": "유이는 눈물이 맺힌 눈으로 매달리듯 우리를 보았다."},
{"id": "clyu20:400", "ko": "「어, 어떻게……?!」"},
{"id": "clyu20:500", "ko": "남자는 잠깐 움찔한 듯 보였지만, 곧 사태를 파악했는지 손에 든 나이프를 유이에게 들이댔다."},
{"id": "clyu20:600", "ko": "「오, 오지 마! 오면 이 녀석을 죽인다!!」"},
{"id": "clyu20:700", "ko": "「읏――!」"},
{"id": "clyu20:800", "ko": "당장이라도 덤벼들려던 신조 씨가 움직임을 멈춘다."},
{"id": "clyu20:900", "ko": "아무리 그래도 인질이 잡혀 있어서는 섣불리 움직일 수 없다."},
{"id": "clyu20:1000", "ko": "「신조 씨……」"},
{"id": "clyu20:1100", "ko": "「안 돼. 지금은 하라는 대로 할 수밖에 없다……」"},
{"id": "clyu20:1200", "ko": "「나, 나가……」"},
{"id": "clyu20:1300", "ko": "「그 애한테서 떨어져. 더 이상 죄를 거듭할 필요는 없다」"},
{"id": "clyu20:1400", "ko": "「지, 지금 당장 여기서 나가! 안 그러면 이 녀석을 죽인다――!」"},
{"id": "clyu20:1500", "ko": "「기다려…… 아무튼 진정해라……」"},
{"id": "clyu20:1600", "ko": "진심인지 아닌지 알 수 없다."},
{"id": "clyu20:1700", "ko": "과연 저런 녀석이 그런 엄청난 짓을 할 수 있을까?"},
{"id": "clyu20:1800", "ko": "하지만 흥분해 있는 지금 상태를 보면, 무슨 계기로 스위치가 들어가 버리지 않으리라는 보장도 없다――"},
{"id": "clyu20:1900", "ko": "다만 이쪽에는 두 사람이 있다."},
{"id": "clyu20:2000", "ko": "어떻게든 저 녀석의 주의를 돌릴 수만 있다면……"},
{"id": "clyu20:2100", "ko": "「…………」"},
{"id": "clyu20:2200", "ko": "그래, 잊고 있었다."},
{"id": "clyu20:2300", "ko": "나는 누구지?"},
{"id": "clyu20:2400", "ko": "그래, 미야시로 타쿠루―― ⟦col:280aa02d1400⟧기가로매니악스⟦col:800000⟧다."},
{"id": "clyu20:2500", "ko": "「읏……!」"},
{"id": "clyu20:2600", "ko": "마음속으로 강하게 염원한다."},
{"id": "clyu20:2700", "ko": "움직여――"},
{"id": "clyu20:2800", "ko": "움직여――!"},
{"id": "clyu20:2900", "ko": "「몇 번이나 말하게 하지 마! 빨리, 빨리 나가――」⟦avs⟧⟦n⟧⟦n⟧"},
{"id": "clyu20:3000", "ko": "（읏…… 움직여――!）"},
{"id": "clyu20:3100", "ko": "구웅―― 하는 커다란 소리가 났다."},
{"id": "clyu20:3200", "ko": "「뭐, 뭐야?!」"},
{"id": "clyu20:3300", "ko": "다음 순간, 거대한 원형 침대가 모터 소리를 내며 엄청난 기세로 격렬하게 돌기 시작했다."},
{"id": "clyu20:3400", "ko": "「신조 씨!」"},
{"id": "clyu20:3500", "ko": "「어? 아, 그래!!」"},
{"id": "clyu20:3600", "ko": "갑작스러운 일에 BJ와 마찬가지로 놀라 있던 신조 씨였지만, 내가 부르자 곧바로 사태를 파악하고 다음 순간 남자에게 덤벼들었다."},
{"id": "clyu20:3700", "ko": "그다음은 순식간이었다."},
{"id": "clyu20:3800", "ko": "신조 씨는 반쯤 눈이 핑핑 돌고 있는 남자의 손에서 나이프를 빼앗고, 눈 깜짝할 새에 그 몸을 눌러 제압했다."},
{"id": "clyu20:3900", "ko": "「유이!!」"},
{"id": "clyu20:4000", "ko": "「타쿠루 오빠!!」"},
{"id": "clyu20:4100", "ko": "남자를 신조 씨에게 맡기고 달려가자, 유이는 눈물 고인 눈으로 나를 올려다보았다."},
{"id": "clyu20:4200", "ko": "불안해 보이는, 금방이라도 부서질 듯한 눈――"},
{"id": "clyu20:4300", "ko": "「괜찮아. 이제 괜찮으니까……!」"},
{"id": "clyu20:4400", "ko": "「응…… 꼭 와 줄 거라고 생각했어……」"},
{"id": "clyu20:4500", "ko": "그렇게 말하면서도 그 어깨는 가늘게 떨리고 있었다."},
{"id": "clyu20:4600", "ko": "이, 이럴 때는 안심시키기 위해서라도 끌어안아 줘야…… 하는 거겠지?"},
{"id": "clyu20:4700", "ko": "「유이……」"},
{"id": "clyu20:4800", "ko": "「타쿠루 오빠……」"},
{"id": "clyu20:4900", "ko": "나는 천천히 유이의 떨리는 어깨로 손을 뻗었다……"},
{"id": "clyu20:5000", "ko": "「유이!!」"},
{"id": "clyu20:5100", "ko": "「누나!!」"},
{"id": "clyu20:5200", "ko": "「우왓」"},
{"id": "clyu20:5300", "ko": "하지만 뒤따라 달려온 노노 일행이 내 몸을 밀쳐 내 버렸다."},
{"id": "clyu20:5400", "ko": "「괜찮아요? 다친 데는 없어요?」"},
{"id": "clyu20:5500", "ko": "「응…… 괜찮아……」"},
{"id": "clyu20:5600", "ko": "「미안해, 누나! 나 때문에……」"},
{"id": "clyu20:5700", "ko": "「아니. 유는 잘못 없어. 따지고 보면 내가 끌어들였는걸」"},
{"id": "clyu20:5800", "ko": "「아무튼 우리가 왔으니까 이제 괜찮아……」"},
{"id": "clyu20:5900", "ko": "노노가 유이의 어깨에 팔을 둘러 끌어안았다."},
{"id": "clyu20:6000", "ko": "（아…… 그거, 내 역할이었는데……）"},
{"id": "clyu20:6100", "ko": "「아극!!」"},
{"id": "clyu20:6200", "ko": "둔탁한 소리와 함께 남자의 먹먹한 신음이 들려 무슨 일인가 하고 돌아보니, 노노 일행과 함께 달려온 아리무라가 주먹을 치켜들고 있었다."},
{"id": "clyu20:6300", "ko": "「방금 건 유이랑 유토 몫! 그리고 이건――」"},
{"id": "clyu20:6400", "ko": "「내 몫이다아아아아아앗!!」"},
{"id": "clyu20:6500", "ko": "（아니, 아리무라, 너는 상관없잖아…）"},
{"id": "clyu20:6600", "ko": "「우욱!」"},
{"id": "clyu20:6700", "ko": "아리무라의 주먹을 맞고 BJ는 나뒹굴며 쓰러지더니――"},
{"id": "clyu20:6800", "ko": "「웁…… 우웨에에에에엑」"},
{"id": "clyu20:6900", "ko": "맞은 데가 나빴는지 성대하게 게워 냈다."},
{"id": "clyu20:7000", "ko": "「우와, 더러워!」"},
{"id": "clyu20:7100", "ko": "「보지 마! 이, 이쪽 보지 마!」"},
{"id": "clyu20:7200", "ko": "어디선가 들어 본 적 있는 대사 같았지만, 지금은 그런 건 아무래도 좋았다."},
{"id": "clyu20:7300", "ko": "유이가 무사하다면 그걸로……"},
{"id": "clyu20:7400", "ko": "이윽고 신조의 부하 형사들이 여럿 와서 유괴범인 남자를 데려갔다."},
{"id": "clyu20:7500", "ko": "노노 일행은, 안심했는지 울음을 터뜨린 유토 곁을 지키고 있었다."},
{"id": "clyu20:7600", "ko": "남은 건 나와――"},
{"id": "clyu20:7700", "ko": "「……있잖아, 타쿠루 오빠……」"},
{"id": "clyu20:7800", "ko": "「응?」"},
{"id": "clyu20:7900", "ko": "「와 줘서 기뻤어. 고마워……」"},
{"id": "clyu20:8000", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu20:8100", "ko": "「그, 그럼 우리도 갈까!」"},
{"id": "clyu20:8200", "ko": "그 동요를 들키지 않으려고 퉁명스럽게 손을 내민다."},
{"id": "clyu20:8300", "ko": "하지만――"},
{"id": "clyu20:8400", "ko": "「…………」"},
{"id": "clyu20:8500", "ko": "유이는 그 손을 잡으려 하지 않았다."},
{"id": "clyu20:8600", "ko": "「왜 그래? 안 가?」"},
{"id": "clyu20:8700", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)의 연속: 배뇨를 참게 한 끝의 실금 장면(8700·9700~9900)"},
{"id": "clyu20:8800", "ko": "「참았다니?」"},
{"id": "clyu20:8900", "ko": "「아, 아무튼 타쿠루 오빠는 저쪽으로 가!!」"},
{"id": "clyu20:9000", "ko": "날 밀어낸 건가?"},
{"id": "clyu20:9100", "ko": "유이가……?"},
{"id": "clyu20:9200", "ko": "왜?"},
{"id": "clyu20:9300", "ko": "「자, 잠깐만, 유이! 확실히 이번 일은 내가 주의가 부족했지만 나도 구하려고――」"},
{"id": "clyu20:9400", "ko": "「정말! 그런 게 아니라…… 아, 아무튼 빨리 저쪽으로……!」"},
{"id": "clyu20:9500", "ko": "그때 유이의 얼굴이 괴로운 듯 일그러져서, 나는 황급히 다가갔다."},
{"id": "clyu20:9600", "ko": "「유, 유이?!」"},
{"id": "clyu20:9700", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)의 연속"},
{"id": "clyu20:9800", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)의 연속"},
{"id": "clyu20:9900", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)의 연속"}
]
