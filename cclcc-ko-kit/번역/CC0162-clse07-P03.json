[
{"id": "clse07:19900", "ko": "「처음에는 그렇게 했어요. 근데 계속 깨우는데도 선배가 전혀 안 일어나잖아요」"},
{"id": "clse07:20000", "ko": "「어젯밤에도 냉큼 푹 잠들어 버리고 말이죠~」"},
{"id": "clse07:20100", "ko": "「아무것도 아니거든요~」"},
{"id": "clse07:20200", "ko": "「안 돌아가요. 오늘 돌아가면 가출이 아니라 그냥 무단 외박이잖슴까」"},
{"id": "clse07:20300", "ko": "「네네, 알아요 알아요」"},
{"id": "clse07:20400", "ko": "「애초에 들켜서 제일 곤란한 건 선배보다 저니까요」"},
{"id": "clse07:20500", "ko": "「그럼 저 먼저 갈게요~. 아디오스 그라시아~♪」"},
{"id": "clse07:20600", "ko": "「차오임다, 여러분~. 아이고, 늦어서 죄송해요」"},
{"id": "clse07:20700", "ko": "「세상에~! 혹시 여러분, 히나에의 등장을 손꼽아 기다리고 있었어요?」"},
{"id": "clse07:20800", "ko": "「아~ 미안 미안. 어제는 좀 사소한 볼일이란 거였어서요, 헤헤헷」"},
{"id": "clse07:20900", "ko": "「훼? 싸움?」"},
{"id": "clse07:21000", "ko": "「뭐가 어쩔 수 없다는 검까?」"},
{"id": "clse07:21100", "ko": "「팬?」"},
{"id": "clse07:21200", "ko": "「방금 전이요. 돌아왔더니 이토 선배가 와 있잖아요. 하마터면 들킬 뻔했어요」"},
{"id": "clse07:21300", "ko": "「그보다 제 팬 어쩌고 하지 않았어요?」"},
{"id": "clse07:21400", "ko": "「아아아아아아아아아아앗!!!」"},
{"id": "clse07:21500", "ko": "「다행이다~. 역시 이 방에 떨어뜨렸던 거군요, 제 곱창 밴드」"},
{"id": "clse07:21600", "ko": "「혹시 잃어버린 게 아닌가 했거든요~. 아이고, 다행이다 다행이다」"},
{"id": "clse07:21700", "ko": "「왜 그러심까, 선배?」"},
{"id": "clse07:21800", "ko": "「???」"},
{"id": "clse07:21900", "ko": "「아직이에요, 조금만 더 기다려 주세요~」"},
{"id": "clse07:22000", "ko": "「네~ 다 됐어요~. 자자, 그 눈가리개를 벗어 주세요」"},
{"id": "clse07:22100", "ko": "「헤헷, 어떰까 어떰까~. 조금은 히나에를 다시 보게 됐지 않슴까?」"},
{"id": "clse07:22200", "ko": "「솔직하지 못함다~」"},
{"id": "clse07:22300", "ko": "「그야 신세 지고 있으니까 이 정도는 해야지 싶어서요」"},
{"id": "clse07:22400", "ko": "「자자, 그보다 따뜻할 때 드세요, 플리즈 보나페티」"},
{"id": "clse07:22500", "ko": "「빤~히」"},
{"id": "clse07:22600", "ko": "「그쵸그쵸?」"},
{"id": "clse07:22700", "ko": "「미네스트로네예요」"},
{"id": "clse07:22800", "ko": "「탈리아텔레 볼로네제예요」"},
{"id": "clse07:22900", "ko": "「쿠루스 선배 요리보다?」"},
{"id": "clse07:23000", "ko": "「아~. 역시……」"},
{"id": "clse07:23100", "ko": "「괜찮슴다. 딱히 신경 안 써요」"},
{"id": "clse07:23200", "ko": "「호오~. 그렇다는 건 처음부터 집안일 같은 건 못 할 거라고 생각했다는 거임다」"},
{"id": "clse07:23300", "ko": "「그럴 땐 거짓말이라도 부정하는 거 아님까, 보통은」"},
{"id": "clse07:23400", "ko": "「그건 그렇지만요~……」"},
{"id": "clse07:23500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:23600", "ko": "「으으~! 바보라고 하는 사람이 바보거든요~」"},
{"id": "clse07:23700", "ko": "「선배, 이거」"},
{"id": "clse07:23800", "ko": "「대본이에요」"},
{"id": "clse07:23900", "ko": "「제가 절찬 가출 중이라는 건 당연히 기억하시죠」"},
{"id": "clse07:24000", "ko": "「그래서 우리 엄마 성격이라면 분명 머지않아 여기를 찾아내서 데리러 올 거예요」"},
{"id": "clse07:24100", "ko": "「곤란해요. 아무리 우리 엄마라도 “그냥” 선배, 그것도 남자 방에 굴러들어 와 있다는 걸 알면 억지로라도 데려가려고 할 거예요」"},
{"id": "clse07:24200", "ko": "「그치만~ 만약 상대가 “그냥” 선배가 아니라면 얘기가 다를 거라고 생각함다~」"},
{"id": "clse07:24300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:24400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:24500", "ko": "「아~ 그건 무리」"},
{"id": "clse07:24600", "ko": "「뭐랄까…… 여자의 자존심?」"},
{"id": "clse07:24700", "ko": "「그런 연기 못 한다는 거죠? 알아요 알아. 선배는 서툴러 보이니까요~」"},
{"id": "clse07:24800", "ko": "「그런 서툰 미야시로 선배를 위해서, 자, 이거」"},
{"id": "clse07:24900", "ko": "「헤헤헤, 문예부의 희망인 이 아리무라 히나에가 손수 쓴 대본이옵니다. 부디 받아 주시길……」"},
{"id": "clse07:25000", "ko": "「어때요 일부러 선배 한 사람을 위해 썼다고요 대서비스예요 감사하세요」"},
{"id": "clse07:25100", "ko": "「뭐, 그렇게도 말하죠」"},
{"id": "clse07:25200", "ko": "「잔소리는 됐고, 일단 한번 훑어봐 주세요」"},
{"id": "clse07:25300", "ko": "「자자자, 손님, 잠깐 보기만이라도, 네? 보는 건 공짜니까. 속는 셈 치고」"},
{"id": "clse07:25400", "ko": "「꺅!」"},
{"id": "clse07:25500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:25600", "ko": "「그런~. 모처럼 만들었으니까 적어도 끝까지 읽고 나서 정해 주세요~」"},
{"id": "clse07:25700", "ko": "「네?」"},
{"id": "clse07:25800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:25900", "ko": "「저기~, 적어도 조금만 더 마음을 담아서 읽어 줄래요?」"},
{"id": "clse07:26000", "ko": "「뭐, 됐어요. 아무튼 엄마가 언제 와도 괜찮게 제대로 외워 두세요」"},
{"id": "clse07:26100", "ko": "「선배……」"},
{"id": "clse07:26200", "ko": "「부탁해요~. 저랑 선배 사이잖아요」"},
{"id": "clse07:26300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:26400", "ko": "「그쵸!?」"},
{"id": "clse07:26500", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:26600", "ko": "「딱히 엄마한테 허락받을 필요 없어」"},
{"id": "clse07:26700", "ko": "「어머, 엄마한테 그런 소리를 듣다니 뜻밖이네」"},
{"id": "clse07:26800", "ko": "「엄마가 집에 안 들어올 때 어디서 자는지 우리 가족이 모른다고 생각해?」"},
{"id": "clse07:26900", "ko": "「그것만이 아니야. 아빠가……」"},
{"id": "clse07:27000", "ko": "「그렇게 자기는 멋대로 하면서 딸이 하는 일에는 참견하다니, 이상하다고 생각하는데요」"},
{"id": "clse07:27100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:27200", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:27300", "ko": "「대본!」"},
{"id": "clse07:27400", "ko": "「…………」"},
{"id": "clse07:27500", "ko": "「…………」"},
{"id": "clse07:27600", "ko": "「…………」"},
{"id": "clse07:27700", "ko": "「선배. 하나 물어봐도 돼요?」"},
{"id": "clse07:27800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:27900", "ko": "「잠깐~, 뭐 하는 거예요~! 더러워~」"},
{"id": "clse07:28000", "ko": "「이상하지 않거든요」"},
{"id": "clse07:28100", "ko": "「그치만 선배, 아까 거짓말했잖슴까」"},
{"id": "clse07:28200", "ko": "「아까. 엄마한테 한 말」"},
{"id": "clse07:28300", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:28400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:28500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:28600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:28700", "ko": "「…………」"},
{"id": "clse07:28800", "ko": "「……거짓말이 아니야……」"},
{"id": "clse07:28900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse07:29000", "ko": "「그런 짓 하면 큰 소리로 소리 지를 거예요」"},
{"id": "clse07:29100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse07:29200", "ko": "「그건――!」"},
{"id": "clse07:29300", "ko": "「아무튼 여기까지 와서는 저도 물러설 수 없어요. 이건 여자의 자존심이에요!」"},
{"id": "clse07:29400", "ko": "「응?」"},
{"id": "clse07:29500", "ko": "「선배~? 뭘 보고 있었어요~?」"},
{"id": "clse07:29600", "ko": "「얼버무려도 안 돼요. 아까 보고 있었죠?」"},
{"id": "clse07:29700", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"}
]
