[
{"id": "clse07:790200", "ko": "「그러니까 안 돼. 절대 도망칠 거잖아」"},
{"id": "clse07:790300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:790400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:790500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:790600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:790700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:790800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:790900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:791000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:791100", "ko": "「타쿠, 다녀왔어~. 기다리게 해서 미안해」"},
{"id": "clse07:791200", "ko": "「……에, 에헤헤~……」"},
{"id": "clse07:791300", "ko": "「배고프지? 도시락 만들어 왔어」"},
{"id": "clse07:791400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:791500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:791600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:791700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:791800", "ko": "「흥. 몰라~」"},
{"id": "clse07:791900", "ko": "「응? 물론이지. 그래서 여기 온 거잖아」"},
{"id": "clse07:792000", "ko": "「당연히 취소지. 다들 타쿠를 찾고 있으니까. 그리고 결국 경찰까지 와서, 뭔가 엄청나. 그래도 절대 못 찾게 할 거야」"},
{"id": "clse07:792100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:792200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:792300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:792400", "ko": "「정말!?」"},
{"id": "clse07:792500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:792600", "ko": "「음~……」"},
{"id": "clse07:792700", "ko": "「……정말, 알았어~」"},
{"id": "clse07:792800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:792900", "ko": "「오늘은 무려 내가 직접 만든 햄버그스테이크예요. 실은 몰래 우키한테 배웠어!」"},
{"id": "clse07:793000", "ko": "「게다가 말이야, 엄청 맛있게 됐어. 점심때 반 애들한테 칭찬받았어. 에헤헤~. 먹고 싶어? 먹고 싶어?」"},
{"id": "clse07:793100", "ko": "「그렇지! 다만, 그……」"},
{"id": "clse07:793200", "ko": "「타쿠는 침대에 묶여 있으니까 평범하게는 못 먹겠지」"},
{"id": "clse07:793300", "ko": "「으음, 어떻게 하면 먹일 수 있으려나~」"},
{"id": "clse07:793400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:793500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:793600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:793700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:793800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:793900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:794000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:794100", "ko": "「어, 어때……?」"},
{"id": "clse07:794200", "ko": "「싫, 싫다~. 그렇게 칭찬하지 마~」"},
{"id": "clse07:794300", "ko": "「왜, 왠지 타쿠한테 순순히 칭찬받으니까 이상한 기분이야~」"},
{"id": "clse07:794400", "ko": "「뭐랄까, 타쿠한테는 늘 따끔한 소리만 들어서 그게 익숙해졌다고 할까……」"},
{"id": "clse07:794500", "ko": "「응?」"},
{"id": "clse07:794600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:794700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:794800", "ko": "「――라니, 안 돼. 그런 걸로 도망치려고 해도」"},
{"id": "clse07:794900", "ko": "「끄으응……!」"},
{"id": "clse07:795000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:795100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:795200", "ko": "「으~, 그렇구나? 그럼 어쩔 수 없지~」"},
{"id": "clse07:795300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:795400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:795500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:795600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:795700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:795800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:795900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:796000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:796100", "ko": "「그런데, 뭐?」"},
{"id": "clse07:796200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:796300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:796400", "ko": "「나 말이야, 타쿠를 위해서 열심히 만들었어. 기뻐해 주면 좋겠다」"},
{"id": "clse07:796500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:796600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:796700", "ko": "「――라니, 안 돼. 그런 걸로 도망치려고 해도」"},
{"id": "clse07:796800", "ko": "「뭐어~, 미야시로 타쿠루 군」"},
{"id": "clse07:796900", "ko": "「응? 뭐가?」"},
{"id": "clse07:797000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:797100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:797200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:797300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clse07:797400", "ko": "「으~, 어쩔 수 없지~. 용서해 줄게」"},
{"id": "clse07:797500", "ko": "「저, 정말!? 기, 기뻐!」"},
{"id": "clse07:797600", "ko": "「에헤. 숨은 맛으로 바닐라 에센스를 떨어뜨려 봤어」"},
{"id": "clse07:797700", "ko": "「내가 만든 자랑스러운 햄버그스테이크 도시락이랑 디저트를 말이야, 전부 한꺼번에 믹서에 갈아서…… 타쿠가 수프처럼 마실 수 있게 해 왔어. 영양이 치우치지 않게 생선도 조금 넣었어」"},
{"id": "clse07:797800", "ko": "「응. 그런데 있잖아……」"},
{"id": "clse07:797900", "ko": "「……그때, 이런 돌봄, 내가 하고 싶었어」"}
]
