[
{"id": "clkn11:10000", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn11:10100", "ko": "「왜?」"},
{"id": "clkn11:10200", "ko": "「아니, 아무것도 아니야」"},
{"id": "clkn11:10300", "ko": "센리는 아무것도 아니라고 했지만, 그 말이 내게는 유난히 쓸쓸하게 들렸다."},
{"id": "clkn11:10400", "ko": "아오바 기숙사에 돌아오자 안에서 커다란 울음소리가 들려왔다."},
{"id": "clkn11:10500", "ko": "「어머. 히카리가 기분이 안 좋은가 보네」"},
{"id": "clkn11:10600", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn11:10700", "ko": "서둘러 집에 들어가려고 손잡이에 손을 대려던 순간, 안에서 문이 열리고 히카리를 안은 유이가 얼굴을 내밀며 말했다."},
{"id": "clkn11:10800", "ko": "그 말에는 하도 많이 들어서 이제 태클 걸 기운도 안 난다."},
{"id": "clkn11:10900", "ko": "「어머~ 히카리. 왜 그래? 외로웠어?」"},
{"id": "clkn11:11000", "ko": "센리는 유이의 손에서 히카리를 받아 들고 그 얼굴을 들여다봤다."},
{"id": "clkn11:11100", "ko": "「자자, 착하지~. 조용히 하자~」"},
{"id": "clkn11:11200", "ko": "「역시 엄마!」"},
{"id": "clkn11:11300", "ko": "「정말. 또 그런 소리 하고. 자, 얼른 들어가자」"},
{"id": "clkn11:11400", "ko": "「네에~」"},
{"id": "clkn11:11500", "ko": "「…………」"},
{"id": "clkn11:11600", "ko": "그날 밤에 아버지가 돌아왔다."},
{"id": "clkn11:11700", "ko": "「하하하! 한동안 못 본 사이에 너희도 육아가 완전히 몸에 뱄구먼」"},
{"id": "clkn11:11800", "ko": "「웃을 일이 아니라니까」"},
{"id": "clkn11:11900", "ko": "「맞아, 아빠. 앞으로 이 아이를 어떻게 할지도 제대로 생각해야 하잖아」"},
{"id": "clkn11:12000", "ko": "「여전히 넌 딱딱하구나. 그런 건 생각해 봤자 소용없다. 될 대로 되는 거야」"},
{"id": "clkn11:12100", "ko": "「또 그런 태평한 소리 하고……」"},
{"id": "clkn11:12200", "ko": "노노가 한숨을 쉬는 것도 무리는 아니다."},
{"id": "clkn11:12300", "ko": "신조 씨에게서 아기 엄마를 찾았다는 연락은 없다."},
{"id": "clkn11:12400", "ko": "앞으로 아오바 기숙사에서 아기를 어떻게 할지, 우리는 정해야 한다."},
{"id": "clkn11:12500", "ko": "신조 씨 말대로 모모세 씨 쪽에 조사를 맡길지, 아니면 이대로 ⟦rb⟧아오바 기숙사⟦rt⟧우리 집⟦/r⟧에서 키울지."},
{"id": "clkn11:12600", "ko": "키운다고 한마디로 말해도 그렇게 간단하지 않다는 건 요 며칠 사이에 알았다."},
{"id": "clkn11:12700", "ko": "그에 따라 우리의 장래도 크게 바뀌어 버릴지 모른다."},
{"id": "clkn11:12800", "ko": "하지만――."},
{"id": "clkn11:12900", "ko": "「…………」"},
{"id": "clkn11:13000", "ko": "노노는 그래도 좋다고 하겠지."},
{"id": "clkn11:13100", "ko": "유이와 유토, 우키도……"},
{"id": "clkn11:13200", "ko": "나는 어떨까."},
{"id": "clkn11:13300", "ko": "만약 이대로 히카리를 키우게 된다면."},
{"id": "clkn11:13400", "ko": "예전처럼 다시 아오바 기숙사에서 생활하며 다 같이 히카리를 돌보고."},
{"id": "clkn11:13500", "ko": "말을 했다고 기뻐하고, 일어섰다고 기뻐하고."},
{"id": "clkn11:13600", "ko": "아프면 걱정하고."},
{"id": "clkn11:13700", "ko": "그런 생활이 있다니, 지금까지 상상조차 해 본 적이 없었다."},
{"id": "clkn11:13800", "ko": "하지만 어쩐지 그건 무척……"},
{"id": "clkn11:13900", "ko": "무척……"},
{"id": "clkn11:14000", "ko": "「뭐, 일단 내일부터 한동안 아기는 내가 봐 줄 테니까. 너는 학교 제대로 가라」"},
{"id": "clkn11:14100", "ko": "「그래도…… 괜찮겠어?」"},
{"id": "clkn11:14200", "ko": "「당연하지. 날 누구로 보는 거냐」"},
{"id": "clkn11:14300", "ko": "「그걸 아니까 걱정인 거야……」"},
{"id": "clkn11:14400", "ko": "「허 참~…… 너희들, 가족이면 나 좀 믿어라……」"},
{"id": "clkn11:14500", "ko": "「봐라, 히카리도 이렇게 말하잖냐」"},
{"id": "clkn11:14600", "ko": "「후훗, 정말, 히카리도 참……」"},
{"id": "clkn11:14700", "ko": "이런 걸 단란하다고 하는 걸까?"},
{"id": "clkn11:14800", "ko": "만약 히카리가 없었다면, 내가 이렇게 여기 있을 일은 없었을지도 모른다."},
{"id": "clkn11:14900", "ko": "「하아암……」"},
{"id": "clkn11:15000", "ko": "오늘도 하루 종일 지쳤다."},
{"id": "clkn11:15100", "ko": "애들은 어째서 저렇게 체력이 남아도는 걸까."},
{"id": "clkn11:15200", "ko": "나한테도 저런 시절이 있었다니 도저히 믿기지 않는다."},
{"id": "clkn11:15300", "ko": "봐, 지금도 계속 울고 있고……"},
{"id": "clkn11:15400", "ko": "「…………」"},
{"id": "clkn11:15500", "ko": "「센리?」"},
{"id": "clkn11:15600", "ko": "「미안해, 타쿠루. 잠 못 잤어?」"},
{"id": "clkn11:15700", "ko": "「아, 뭐야. 노노구나……」"},
{"id": "clkn11:15800", "ko": "「응. 혹시 울음을 그칠까 해서. 그런데 안 되나 봐……」"},
{"id": "clkn11:15900", "ko": "노노의 품 안에서 히카리는 자지러지게 울고 있었다."},
{"id": "clkn11:16000", "ko": "「……잠깐 바꿔 줄까?」"},
{"id": "clkn11:16100", "ko": "「어? 아, 응……」"},
{"id": "clkn11:16200", "ko": "노노에게서 히카리를 받아 천천히 흔들어 주었다."},
{"id": "clkn11:16300", "ko": "그러자……"},
{"id": "clkn11:16400", "ko": "「어머……」"},
{"id": "clkn11:16500", "ko": "히카리는 금세 울음을 그치고, 이윽고 조용히 새근거리기 시작했다."},
{"id": "clkn11:16600", "ko": "요 며칠 사이에 알게 됐는데, 잠들었다고 안심하고 떨어지면 아기는 금방 깬다."},
{"id": "clkn11:16700", "ko": "나는 그대로 히카리를 이불에 눕히고 바로 옆에 누워서, 한동안 숨소리에 맞춰 손바닥으로 그 작은 몸을 살살 토닥여 주었다."},
{"id": "clkn11:16800", "ko": "「히카리는 참, 나도 센리도 안 됐는데. 조금 질투 나네」"},
{"id": "clkn11:16900", "ko": "센리라도, 라……"},
{"id": "clkn11:17000", "ko": "「노노는 그…… 졸업할 때까지 그 모습 그대로 있을 거야?」"},
{"id": "clkn11:17100", "ko": "「어?」"},
{"id": "clkn11:17200", "ko": "그 말을 던지자마자 노노의 얼굴이 순식간에 흐려지는 게 보였다."},
{"id": "clkn11:17300", "ko": "「미안, 아무것도 아니야……」"},
{"id": "clkn11:17400", "ko": "「……응」"},
{"id": "clkn11:17500", "ko": "즉 그게 대답이라는 거다."},
{"id": "clkn11:17600", "ko": "당연하다면 당연하다."},
{"id": "clkn11:17700", "ko": "사실 자신은 미나미사와 센리라는 소녀이고, 쿠루스 노노의 모습은 다른 사람이었다――고 밝히는 건, 지금까지 자신이 주위를 속여 왔다고 선언하는 것이기도 하다."},
{"id": "clkn11:17800", "ko": "곧 고등학교 생활도 끝나려는 이 시기에 굳이 그런 일을 할 필요는 없다."},
{"id": "clkn11:17900", "ko": "「저기, 타쿠루. 학교는 어때?」"},
{"id": "clkn11:18000", "ko": "「별로. 딱히 달라진 건 없어」"},
{"id": "clkn11:18100", "ko": "「그래. 그 교칙이 생긴 뒤잖아? 그래서 신경 쓰여서……」"},
{"id": "clkn11:18200", "ko": "「이제 잠잠해졌어. 잘하면 이대로 있으나 마나 한 게 되지 않을까?」"},
{"id": "clkn11:18300", "ko": "「그래. 그러면 다행이지만……」"},
{"id": "clkn11:18400", "ko": "「…………」"},
{"id": "clkn11:18500", "ko": "「맞다, 아리무라랑 세리카가 또 히카리 보러 오고 싶대」"},
{"id": "clkn11:18600", "ko": "「…………」"},
{"id": "clkn11:18700", "ko": "「그리고 카즈키가……」"},
{"id": "clkn11:18800", "ko": "「…………」"},
{"id": "clkn11:18900", "ko": "「타쿠루?」"},
{"id": "clkn11:19000", "ko": "「…………」"},
{"id": "clkn11:19100", "ko": "「……후후, 잠들었구나」"},
{"id": "clkn11:19200", "ko": "「타쿠루……」"},
{"id": "clkn11:19300", "ko": "「고마워……」"},
{"id": "clkn11:19400", "ko": "「…………」"}
]
