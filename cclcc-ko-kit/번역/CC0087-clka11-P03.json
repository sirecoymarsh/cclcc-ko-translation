[
{"id": "clka11:20000", "ko": "「선배는…… 갑자기 신문부에 눌러앉은 나를, 사정도 묻지 않고 받아 줬어」"},
{"id": "clka11:20100", "ko": "「말없이 엠스만 계속해도, 싫은 소리 안 하고 넘어가 줬어」"},
{"id": "clka11:20200", "ko": "「내가 말하기 싫어하는 이유도 묻지 않아 줬어」"},
{"id": "clka11:20300", "ko": "「분명 그건, 선배한테는 아무것도 아닌 일이야」"},
{"id": "clka11:20400", "ko": "「분명 나는 머릿수 채우기용 부원일 뿐이야」"},
{"id": "clka11:20500", "ko": "「그래도, 기뻤어」"},
{"id": "clka11:20600", "ko": "「나를 필요로 해 주고, 내가 하고 싶은 걸 존중해 주는 게 기뻤어」"},
{"id": "clka11:20700", "ko": "「그리고, 타쿠루 선배는 상냥한 사람이야」"},
{"id": "clka11:20800", "ko": "「평소엔 엄청 잘난 척하고 다들 무시하는 듯한 말투로만 말하지만, 사실은 굉장히 상냥한 사람이야」"},
{"id": "clka11:20900", "ko": "「분명 지금도 나를 찾아서 뛰어다니고 있을 거야」"},
{"id": "clka11:21000", "ko": "「그러니까, 나는……」"},
{"id": "clka11:21100", "ko": "「나…… 는……」"},
{"id": "clka11:21200", "ko": "목소리가 점점 잦아들어서, 말을 잇지 못하게 된다."},
{"id": "clka11:21300", "ko": "고개도 숙여지고, 시선이 바닥을 헤맨다."},
{"id": "clka11:21400", "ko": "『하나』가 한 걸음 다가와 눈앞에 선다."},
{"id": "clka11:21500", "ko": "「나는?」"},
{"id": "clka11:21600", "ko": "다정하게 손을 잡고 묻는다."},
{"id": "clka11:21700", "ko": "「괜찮아, 내가 옆에 있으니까. 말해 봐」"},
{"id": "clka11:21800", "ko": "「……」"},
{"id": "clka11:21900", "ko": "「……응」"},
{"id": "clka11:22000", "ko": "「나는……」"},
{"id": "clka11:22100", "ko": "「타쿠루 선배가……」"},
{"id": "clka11:22200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka11:22300", "ko": "「……일지도」"},
{"id": "clka11:22400", "ko": "고개를 든다."},
{"id": "clka11:22500", "ko": "⟦top:38⟧『하나』는 눈가에 눈물을 머금은 채 미소 짓고 있었다."},
{"id": "clka11:22600", "ko": "「……」"},
{"id": "clka11:22700", "ko": "「……응」"},
{"id": "clka11:22800", "ko": "「드디어 네 마음을 말했네」"},
{"id": "clka11:22900", "ko": "「……응」"},
{"id": "clka11:23000", "ko": "「……응……!」"},
{"id": "clka11:23100", "ko": "그 순간, 풍경이 흐물흐물 일그러졌다."},
{"id": "clka11:23200", "ko": "「어, 뭐야……?」"},
{"id": "clka11:23300", "ko": "「이제 머릿속 대화는 끝. 현실로 돌아가」"},
{"id": "clka11:23400", "ko": "「어, 어디? 어디 있는 거야?」"},
{"id": "clka11:23500", "ko": "「어디에도 없어」"},
{"id": "clka11:23600", "ko": "「나는 처음부터 어디에도 없어」"},
{"id": "clka11:23700", "ko": "「지금은 네 마음속으로 막 돌아온 참이야. 그리고 곧 사라져」"},
{"id": "clka11:23800", "ko": "「네가 솔직하게 네 마음을 말할 수 있는 동안은, 이제 나오지 않아」"},
{"id": "clka11:23900", "ko": "「그러니까 내가 안 나와도 되게끔 힘내」"},
{"id": "clka11:24000", "ko": "「……응」"},
{"id": "clka11:24100", "ko": "「힘낼게」"},
{"id": "clka11:24200", "ko": "「좋아!」"},
{"id": "clka11:24300", "ko": "「어때? 지금 기분은」"},
{"id": "clka11:24400", "ko": "「……솔직히 말하면」"},
{"id": "clka11:24500", "ko": "「……말도 못 하게 부끄러워……!」"},
{"id": "clka11:24600", "ko": "「아핫!」"},
{"id": "clka11:24700", "ko": "『하나』가 웃음을 터뜨렸다. 눈가에서 흘러내린 눈물을 닦고 있는 게 상상이 갔다."},
{"id": "clka11:24800", "ko": "「그렇지. 알아」"},
{"id": "clka11:24900", "ko": "「그래도 있지, 이다음에 더 부끄러운 일이 생길 테니까, 기절하지 않게 조심해」"},
{"id": "clka11:25000", "ko": "「어?」"},
{"id": "clka11:25100", "ko": "「미안해, 나, 너한테 거짓말했어」"},
{"id": "clka11:25200", "ko": "「어?」"},
{"id": "clka11:25300", "ko": "「여기엔 아무도 없다고 했잖아」"},
{"id": "clka11:25400", "ko": "「그거, 거짓말이야」"},
{"id": "clka11:25500", "ko": "「……어?」"},
{"id": "clka11:25600", "ko": "「안쪽 좀 봐 봐」"},
{"id": "clka11:25700", "ko": "그 말에 시선을 돌린다."},
{"id": "clka11:25800", "ko": "아무도 없는 로비 안쪽. 극장으로 향하는 계단보다도 더 안쪽."},
{"id": "clka11:25900", "ko": "⟦top:38⟧거기에는 비상 연결 통로로 이어지는 문이 있었다. 반쯤 열린 채로."},
{"id": "clka11:26000", "ko": "「어?」"},
{"id": "clka11:26100", "ko": "문이 열려 있는 건, 누군가가 방금 막 열었기 때문이었다."},
{"id": "clka11:26200", "ko": "「어? 어?」"},
{"id": "clka11:26300", "ko": "⟦rb⟧그 사람⟦rt⟧⟦rbc⟧●●●⟦/r⟧은 연 문의 손잡이를 쥔 채, 멍한 얼굴로 이쪽을 바라보고 있었다."},
{"id": "clka11:26400", "ko": "「어? 어? 어?」"},
{"id": "clka11:26500", "ko": "그 사람은――"},
{"id": "clka11:26600", "ko": "――미야시로 타쿠루였다."},
{"id": "clka11:26700", "ko": "달빛밖에 없는데도, 미야시로 타쿠루의 얼굴이 새빨개져 있는 게 보인다."},
{"id": "clka11:26800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka11:26900", "ko": "「에에에에에에에에에에에에에!!!!!!!??????」"},
{"id": "clka11:27000", "ko": "「어어어어어, 어째서!?」"},
{"id": "clka11:27100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka11:27200", "ko": "「그그그그, 그치만 그치만 그치만!」"},
{"id": "clka11:27300", "ko": "「그치만, 자기 자신한테는 거짓말 못 한다고……!!??」"},
{"id": "clka11:27400", "ko": "「에〜? 나 그런 말 안 했는데?」"},
{"id": "clka11:27500", "ko": "「『자기 자신한테 거짓말할 필요는 없다』고 했을 뿐이야」"},
{"id": "clka11:27600", "ko": "「거짓말을 하면 안 된다는 뜻은 아니지」"},
{"id": "clka11:27700", "ko": "「말도 안 돼애〜〜!!!」"},
{"id": "clka11:27800", "ko": "「뭐, 하루 종일 어울려 준 데 대한 내 선물이야」"},
{"id": "clka11:27900", "ko": "「나머진 네가 잘 해 봐」"},
{"id": "clka11:28000", "ko": "「그럼 안녕」"},
{"id": "clka11:28100", "ko": "가슴 깊은 곳에서 무언가가 스윽 사라졌다."},
{"id": "clka11:28200", "ko": "「아……」"},
{"id": "clka11:28300", "ko": "몸이 아주 조금 가벼워진 것 같았다."},
{"id": "clka11:28400", "ko": "그건 기쁜 일이기도 하고, 슬픈 일이기도 한 것 같았다."},
{"id": "clka11:28500", "ko": "가슴을 손으로 누르며 중얼거린다."},
{"id": "clka11:28600", "ko": "「……고마워」"},
{"id": "clka11:28700", "ko": "그리고 고개를 들고, 미야시로 타쿠루 쪽으로 걸어갔다."},
{"id": "clka11:28800", "ko": "「……카, 카즈키?」"},
{"id": "clka11:28900", "ko": "「응」"},
{"id": "clka11:29000", "ko": "손에 들고 있던 쿨 캣 프레스를 들어 올려 보인다."},
{"id": "clka11:29100", "ko": "「되찾아 줬구나」"},
{"id": "clka11:29200", "ko": "「……응」"},
{"id": "clka11:29300", "ko": "「……」"},
{"id": "clka11:29400", "ko": "「저기……」"},
{"id": "clka11:29500", "ko": "「아까 그 말……」"},
{"id": "clka11:29600", "ko": "「읏! ……」"},
{"id": "clka11:29700", "ko": "「그러니까, 그건」"},
{"id": "clka11:29800", "ko": "「뭐라고 해야 하나,」"},
{"id": "clka11:29900", "ko": "「네…… 진심인 거야?」"}
]
