[
{"id": "clse07:194200", "ko": "「아, 그래도 말해 두는데, 풀 죽은 건 아니니까. 딱히 여자가 그 녀석만 있는 것도 아니고」"},
{"id": "clse07:194300", "ko": "「게다가 오랜만에 만나 보니까, 그 녀석도 제법……」"},
{"id": "clse07:194400", "ko": "「좀, 그게……」"},
{"id": "clse07:194500", "ko": "「어때? 이제 학교에는 익숙해졌나?」"},
{"id": "clse07:194600", "ko": "「그, 그런가…… 곤란한 일이 있으면 언제든 말해 줘」"},
{"id": "clse07:194700", "ko": "「…………」"},
{"id": "clse07:194800", "ko": "「아, 잠깐만!!」"},
{"id": "clse07:194900", "ko": "「그…… 쿠루스가 외국에 가 버린 건 아쉽지만, 언제까지 아쉬워해 봤자 소용없어」"},
{"id": "clse07:195000", "ko": "「인생은 긍정적으로 살아야 하는 법이다. 그렇게 생각하지 않나?」"},
{"id": "clse07:195100", "ko": "「미나미사와도 오랜만에 돌아와서 외롭겠지」"},
{"id": "clse07:195200", "ko": "「외롭지? 아니, 외로운 게 분명해!! 틀림없이 그래!」"},
{"id": "clse07:195300", "ko": "「요컨대 말이다. 외로운 미나미사와를 위해 내가 사귀어 주겠다는 거다」"},
{"id": "clse07:195400", "ko": "「눈치 없는 녀석이군. 내가 네 남자친구가 되어 주겠다는 거다」"},
{"id": "clse07:195500", "ko": "「왜냐니…… 너, 옛날부터 나를 좋아했잖아? 그렇지? 그야 늘 내가 있는 데마다 따라왔었잖아?」"},
{"id": "clse07:195600", "ko": "「그러니까 외로운 너를 위해 내가 사귀어 주――」"},
{"id": "clse07:195700", "ko": "「……어?」"},
{"id": "clse07:195800", "ko": "「뭣!?」"},
{"id": "clse07:195900", "ko": "「뭐…… 아…… 아…… 아아……」"},
{"id": "clse07:196000", "ko": "「아…… 아아…… 아…………」"},
{"id": "clse07:196100", "ko": "「으음〜!」"},
{"id": "clse07:196200", "ko": "「으음. 전멸 같은 건 말도 안 돼…… 일지도!」"},
{"id": "clse07:196300", "ko": "「으으음! 조용히 해 줬으면 좋겠어…… 일지도!」"},
{"id": "clse07:196400", "ko": "「크아아아아아아!」"},
{"id": "clse07:196500", "ko": "「흡! 흐읍! 흐으읍!」"},
{"id": "clse07:196600", "ko": "「으음후〜〜, 하아하아하아……」"},
{"id": "clse07:196700", "ko": "「으응!」"},
{"id": "clse07:196800", "ko": "「지금은 안 돼…… 일지도!」"},
{"id": "clse07:196900", "ko": "「으음!?」"},
{"id": "clse07:197000", "ko": "「………」"},
{"id": "clse07:197100", "ko": "「으, 으음……」"},
{"id": "clse07:197200", "ko": "「응」"},
{"id": "clse07:197300", "ko": "「어?」"},
{"id": "clse07:197400", "ko": "「으, 응…… 으읏……」"},
{"id": "clse07:197500", "ko": "「으, 으읏…… 그만해 줬으면 좋겠어…… 일지도……」"},
{"id": "clse07:197600", "ko": "「아, 안 돼. 그런 거, 부끄러…… 아, 응, 읏……」"},
{"id": "clse07:197700", "ko": "「응, 아, 으응……」"},
{"id": "clse07:197800", "ko": "「아, 앙…… 그, 그런 거 아니야…… 일지도……」"},
{"id": "clse07:197900", "ko": "「그러니까, 아니……」"},
{"id": "clse07:198000", "ko": "「으으, 그런 거…… 나…… 안 했……」"},
{"id": "clse07:198100", "ko": "「으, 흑, 으으으……」"},
{"id": "clse07:198200", "ko": "「……저, 저기…… 이제 그만하고 싶어…… 일지도」"},
{"id": "clse07:198300", "ko": "「뭐, 뭔가 신변에 위험을 느끼기 시작했어. 히나 씨…… 진심인 것 같으니까…… 일지도」"},
{"id": "clse07:198400", "ko": "「그렇게 화내면서 내 가슴을 빤히 쳐다보는 건 그만해 줬으면 좋겠어…… 일지도」"},
{"id": "clse07:198500", "ko": "「응?」"},
{"id": "clse07:198600", "ko": "「아…… 타쿠루 선배」"},
{"id": "clse07:198700", "ko": "「으음?」"},
{"id": "clse07:198800", "ko": "「앗! 큰일이야…… 일지도!」"},
{"id": "clse07:198900", "ko": "「이벤트. 중요한. 벌써 시간」"},
{"id": "clse07:199000", "ko": "「……응. 했었어. 약속」"},
{"id": "clse07:199100", "ko": "「응? 으음? 으음」"},
{"id": "clse07:199200", "ko": "「타쿠루 선배한테 바통 터치하면 돼…… 일지도」"},
{"id": "clse07:199300", "ko": "「………」"},
{"id": "clse07:199400", "ko": "「으……」"},
{"id": "clse07:199500", "ko": "「으음〜. 실망…… 일지도」"},
{"id": "clse07:199600", "ko": "「……으으음〜」"},
{"id": "clse07:199700", "ko": "「응」"},
{"id": "clse07:199800", "ko": "「히나 씨라면…… 오늘은 안 왔어…… 일지도……」"},
{"id": "clse07:199900", "ko": "「그럴 가능성도 있어…… 일지도……?」"},
{"id": "clse07:200000", "ko": "「몰래카메라…… 일지도」"},
{"id": "clse07:200100", "ko": "「하지만 대본 쓴 건 히나 씨…… 일지도……」"},
{"id": "clse07:200200", "ko": "「…………」"},
{"id": "clse07:200300", "ko": "「어제도 안 왔어…… 일지도……」"},
{"id": "clse07:200400", "ko": "「어……?」"},
{"id": "clse07:200500", "ko": "「2학년…… 이시다 모에라는 사람이 봤다고 했어…… 일지도」"},
{"id": "clse07:200600", "ko": "「무리…… 일지도……」"},
{"id": "clse07:200700", "ko": "「……일지도」"},
{"id": "clse07:200800", "ko": "「응……」"},
{"id": "clse07:200900", "ko": "「누구냐니, 이토 선……」", "note": "伊藤先輩(이토 선배)를 말하다 끊음 — 입에 올리면 현실이 될까 봐"},
{"id": "clse07:201000", "ko": "「그런 말 안 하기로 했잖아…… 일지도」"},
{"id": "clse07:201100", "ko": "「낮에는 괜찮아…… 일지도……」"},
{"id": "clse07:201200", "ko": "「어휴…… 일지도……」"},
{"id": "clse07:201300", "ko": "「풋」"},
{"id": "clse07:201400", "ko": "「으음!」"},
{"id": "clse07:201500", "ko": "「알았어…… 일지도」"},
{"id": "clse07:201600", "ko": "「히나 씨가 있는 곳…… 알아냈어…… 일지도……」"},
{"id": "clse07:201700", "ko": "「응……」"},
{"id": "clse07:201800", "ko": "「히나 씨의…… 스마트폰 위치…… 일지도……」"},
{"id": "clse07:201900", "ko": "「아는 엠스 친구한테…… 물어봤어…… 일지도」"},
{"id": "clse07:202000", "ko": "「음……」"},
{"id": "clse07:202100", "ko": "「응……」"},
{"id": "clse07:202200", "ko": "「이 영상…… 해외 사이트에서 화제가 되고 있어…… 일지도……」"},
{"id": "clse07:202300", "ko": "「응?」"},
{"id": "clse07:202400", "ko": "「응!?」"},
{"id": "clse07:202500", "ko": "「응〜?」"},
{"id": "clse07:202600", "ko": "「으응?」"},
{"id": "clse07:202700", "ko": "「응? 응?」"},
{"id": "clse07:202800", "ko": "「응!?」"},
{"id": "clse07:202900", "ko": "「으음」"},
{"id": "clse07:203000", "ko": "「응!?」"},
{"id": "clse07:203100", "ko": "「으응」"},
{"id": "clse07:203200", "ko": "「응」"},
{"id": "clse07:203300", "ko": "「응」"},
{"id": "clse07:203400", "ko": "「응」"},
{"id": "clse07:203500", "ko": "「으음」"},
{"id": "clse07:203600", "ko": "「응」"},
{"id": "clse07:203700", "ko": "「응」"},
{"id": "clse07:203800", "ko": "「응?」"},
{"id": "clse07:203900", "ko": "「응」"},
{"id": "clse07:204000", "ko": "「……」"},
{"id": "clse07:204100", "ko": "「……」"}
]
