[
{"id": "clah04:0", "ko": "「하아아암……」"},
{"id": "clah04:100", "ko": "벌써 아침인가……"},
{"id": "clah04:200", "ko": "안 되겠다……"},
{"id": "clah04:300", "ko": "어쩐지 피로가 안 풀린다."},
{"id": "clah04:400", "ko": "이제 와서 말하기도 뭣하지만, 이 생활에는 역시 무리가 있는 거 아닐까?"},
{"id": "clah04:500", "ko": "이럴 줄 알았으면 어제 아리무라네 어머니께 사정사정해서 억지로라도 데려가 달라고 했어야 했는지도 모른다."},
{"id": "clah04:600", "ko": "「응……?」"},
{"id": "clah04:700", "ko": "「――!?」"},
{"id": "clah04:800", "ko": "갑자기 눈에 들어온 광경에 무겁던 머리가 단숨에 깨어났다."},
{"id": "clah04:900", "ko": "아리무라 녀석, 내가 자는 줄 알고 저렇게 무방비하게……"},
{"id": "clah04:1000", "ko": "옷 갈아입는 건 역시 늘 세면실에서 하지만, ⟦col:280aa02d1400⟧니삭스⟦col:800000⟧ 정도는 괜찮겠지 하고 방심한 건지도 모른다."},
{"id": "clah04:1100", "ko": "그래도……"},
{"id": "clah04:1200", "ko": "뭔가 이렇게 니삭스를 신는 모습에서는 뭐라 말할 수 없는 에로티시즘이 느껴진다."},
{"id": "clah04:1300", "ko": "안 돼, 안 돼."},
{"id": "clah04:1400", "ko": "냉정해져라, 미야시로 타쿠루."},
{"id": "clah04:1500", "ko": "상대는 아리무라다."},
{"id": "clah04:1600", "ko": "어제 이상한 마음은 안 생긴다고 딱 잘라 말한 참이잖아."},
{"id": "clah04:1700", "ko": "여기서 자는 척하며 몰래 보고 있다는 게 들키면, 그야말로 이겼다는 듯이 으스댈 게 틀림없다."},
{"id": "clah04:1800", "ko": "아리무라는 어제 여자의 자존심이라고 했지만, 나한테도 남자의 자존심이 있다."},
{"id": "clah04:1900", "ko": "결코 불순한 감정을 품을 수는 없다."},
{"id": "clah04:2000", "ko": "그럴 수는 없는 거다."},
{"id": "clah04:2100", "ko": "하지만……"},
{"id": "clah04:2200", "ko": "「…………」"},
{"id": "clah04:2300", "ko": "그만 눈이 가 버리는 건 어쩔 수 없잖아."},
{"id": "clah04:2400", "ko": "남자애니까."},
{"id": "clah04:2500", "ko": "「응?」"},
{"id": "clah04:2600", "ko": "큰일이다!!"},
{"id": "clah04:2700", "ko": "「선배애〜? 뭘 보고 있었어요오?」"},
{"id": "clah04:2800", "ko": "니삭스를 다 신은 아리무라가 사뿐히 일어섰다."},
{"id": "clah04:2900", "ko": "여기선 얼버무리는 수밖에 없다!"},
{"id": "clah04:3000", "ko": "「후에? 아아, 좋은 아침, 아리무라」"},
{"id": "clah04:3100", "ko": "「얼버무려도 소용없어요. 아까 보고 있었죠?」"},
{"id": "clah04:3200", "ko": "「……뭘?」"},
{"id": "clah04:3300", "ko": "「제가 니삭스 신는 거」"},
{"id": "clah04:3400", "ko": "「아아……」"},
{"id": "clah04:3500", "ko": "어차피 거짓말해도 들킨다."},
{"id": "clah04:3600", "ko": "이럴 때는 사실을 인정하면서 태연한 척하는 게 최고다."},
{"id": "clah04:3700", "ko": "「어제 저한테는 그런 마음 안 생긴다고 하지 않았던가요오?」"},
{"id": "clah04:3800", "ko": "「그랬지」"},
{"id": "clah04:3900", "ko": "「……혹시 니삭스 좋아해요?」"},
{"id": "clah04:4000", "ko": "「글쎄……」"},
{"id": "clah04:4100", "ko": "그리고 위험한 부분은 애매하게 얼버무린다."},
{"id": "clah04:4200", "ko": "「흐〜응, 그렇게 얼버무릴 셈이에요?」"},
{"id": "clah04:4300", "ko": "아리무라가 천천히 나에게 다가왔다."},
{"id": "clah04:4400", "ko": "「좋아요. 그렇게 얼버무리겠다면 불게 만들어 드리죠」"},
{"id": "clah04:4500", "ko": "……뭘 하려는 거지?"},
{"id": "clah04:4600", "ko": "「에잇」"},
{"id": "clah04:4700", "ko": "이, 이건――!"},
{"id": "clah04:4800", "ko": "「후훗, 어때요? 이런 거 좋아하죠?」"},
{"id": "clah04:4900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:5000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:5100", "ko": "그야말로 더없는 행복!"},
{"id": "clah04:5200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:5300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:5400", "ko": "「어때요? 자, 말해 봐요. 좋아한다고」"},
{"id": "clah04:5500", "ko": "「읏……」"},
{"id": "clah04:5600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:5700", "ko": "「묵비권인가요. 그럼――」"},
{"id": "clah04:5800", "ko": "양 볼을 조이는 힘이 한층 세진다."},
{"id": "clah04:5900", "ko": "딱 ⟦col:280aa02d1400⟧목 4자 굳히기⟦col:800000⟧ 같은 모양새다."},
{"id": "clah04:6000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:6100", "ko": "「자, 말해 봐? 좋아한다고」"},
{"id": "clah04:6200", "ko": "「윽……」"},
{"id": "clah04:6300", "ko": "「……참, 고집도 세다니까. 그럼 이건 어때?」"},
{"id": "clah04:6400", "ko": "「우왓!!」"},
{"id": "clah04:6500", "ko": "갑자기 눈앞이 깜깜해졌다."},
{"id": "clah04:6600", "ko": "물론 정전이고 뭐고 아니다."},
{"id": "clah04:6700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:6800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:6900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clah04:7000", "ko": "이러면 나는 이제……"},
{"id": "clah04:7100", "ko": "……냉정해져, 나."},
{"id": "clah04:7200", "ko": "설령 들킨다 해도 그런 일은 안 생기니까."},
{"id": "clah04:7300", "ko": "하지만……"},
{"id": "clah04:7400", "ko": "「…………」"},
{"id": "clah04:7500", "ko": "그만 눈이 가 버리는 건 어쩔 수 없잖아."},
{"id": "clah04:7600", "ko": "남자애니까."},
{"id": "clah04:7700", "ko": "「응?」"},
{"id": "clah04:7800", "ko": "큰일이다!!"},
{"id": "clah04:7900", "ko": "「선배애〜? 뭘 보고 있었어요오?」"},
{"id": "clah04:8000", "ko": "니삭스를 다 신은 아리무라가 사뿐히 일어섰다."},
{"id": "clah04:8100", "ko": "여기선 얼버무리는 수밖에 없다!"},
{"id": "clah04:8200", "ko": "「후에? 아아, 좋은 아침, 아리무라」"},
{"id": "clah04:8300", "ko": "「얼버무려도 소용없어요. 아까 보고 있었죠?」"},
{"id": "clah04:8400", "ko": "「……뭘?」"},
{"id": "clah04:8500", "ko": "「제가 니삭스 신는 거」"},
{"id": "clah04:8600", "ko": "「아아……」"},
{"id": "clah04:8700", "ko": "어차피 거짓말해도 들킨다."},
{"id": "clah04:8800", "ko": "이럴 때는 사실을 인정하면서 태연한 척하는 게 최고다."},
{"id": "clah04:8900", "ko": "「어제 저한테는 그런 마음 안 생긴다고 하지 않았던가요오?」"},
{"id": "clah04:9000", "ko": "「그랬지」"},
{"id": "clah04:9100", "ko": "「……혹시 니삭스 좋아해요?」"},
{"id": "clah04:9200", "ko": "「응……」"},
{"id": "clah04:9300", "ko": "아차!!"},
{"id": "clah04:9400", "ko": "대충 이리저리 얼버무릴 생각이었는데, 나도 모르게 솔직하게 대답해 버렸다!"},
{"id": "clah04:9500", "ko": "「후훗, 솔직하시네요, 선배」"},
{"id": "clah04:9600", "ko": "아리무라는 방금 그 말이 내 진심이라는 걸 알았을 거다."},
{"id": "clah04:9700", "ko": "그렇다면 이제 얼버무려 봤자 소용없다."},
{"id": "clah04:9800", "ko": "「그래. 나는 니삭스를 아주 좋아한다」"},
{"id": "clah04:9900", "ko": "「그래요. 그럼 솔직한 선배한테는 상을 줘야겠네」"}
]
