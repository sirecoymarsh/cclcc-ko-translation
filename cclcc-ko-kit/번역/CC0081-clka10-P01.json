[
{"id": "clka10:0", "ko": "「하아…… 험한 꼴을 당했네」"},
{"id": "clka10:100", "ko": "「……응」"},
{"id": "clka10:200", "ko": "겨우 원래 옷으로 돌아온 나와 카즈키는 딱히 목적지도 없이 시부야 거리를 걷고 있었다."},
{"id": "clka10:300", "ko": "⟦col:280aa02d1400⟧107⟦col:800000⟧에 들어가기 전엔 파란 하늘이었는데, 지금은 하늘 가득 회색 구름이 덮여 있다. 이따금 우르릉 하고 기분 나쁜 소리가 들려온다."},
{"id": "clka10:400", "ko": "「비가 올 것 같네」"},
{"id": "clka10:500", "ko": "「……응」"},
{"id": "clka10:600", "ko": "「나, 우산 안 가져왔는데」"},
{"id": "clka10:700", "ko": "「……응」"},
{"id": "clka10:800", "ko": "「그러니까……」"},
{"id": "clka10:900", "ko": "「……」"},
{"id": "clka10:1000", "ko": "「……하아」"},
{"id": "clka10:1100", "ko": "대화가 이어지지 않는다. 어쩔 수 없으니 말없이 걷는다."},
{"id": "clka10:1200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka10:1300", "ko": "「아야야……」"},
{"id": "clka10:1400", "ko": "「사진관에서 넘어졌을 때 삐었나」"},
{"id": "clka10:1500", "ko": "「……」"},
{"id": "clka10:1600", "ko": "「……미안해…… 일지도」"},
{"id": "clka10:1700", "ko": "「아, 아니, 카즈키 탓이 아니야」"},
{"id": "clka10:1800", "ko": "「모든 건 그 녀석 책임이야」"},
{"id": "clka10:1900", "ko": "「……」"},
{"id": "clka10:2000", "ko": "「응……」"},
{"id": "clka10:2100", "ko": "카즈키의 대답에 뭔가 망설임이 섞여 있는 것처럼 들렸지만, 그게 뭔지는 알 수 없었다."},
{"id": "clka10:2200", "ko": "「그렇다고 해도 앞으로 어떻게 해야 하지……」"},
{"id": "clka10:2300", "ko": "「이다음에 무슨 예정이었는지는 그 녀석밖에 모르잖아……」"},
{"id": "clka10:2400", "ko": "「카즈키, 너는 그 녀석이 무슨 생각을 하는지 모르는 거지?」"},
{"id": "clka10:2500", "ko": "「응……」"},
{"id": "clka10:2600", "ko": "아주 조금 고개를 끄덕인다."},
{"id": "clka10:2700", "ko": "「그렇다는 건, 그때 그 녀석이 갑자기 사라진 이유도 모른다는 거구나」"},
{"id": "clka10:2800", "ko": "「응……」"},
{"id": "clka10:2900", "ko": "고개 각도가 더 작아져서, 잘 보지 않으면 끄덕이는 건지 알 수가 없다."},
{"id": "clka10:3000", "ko": "걸으면서 생각한다."},
{"id": "clka10:3100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka10:3200", "ko": "그냥 나를 놀리며 즐기는 것뿐일까? ⟦col:280aa02d1400⟧인기 없는⟦col:800000⟧ 남자 고등학생이 허둥대는 모습을 보고 싶은 것뿐일까?"},
{"id": "clka10:3300", "ko": "（……아니면）"},
{"id": "clka10:3400", "ko": "아니면, 입으로는 그렇게 말하면서도 역시 카즈키 본인의 뜻을 존중하려는 걸까?"},
{"id": "clka10:3500", "ko": "청춘을 구가하는 건 『하나』가 아니라 카즈키라고 생각하는 걸까?"},
{"id": "clka10:3600", "ko": "「……흠」"},
{"id": "clka10:3700", "ko": "어쩐지 이 추측이 맞는 것 같은 기분이 든다."},
{"id": "clka10:3800", "ko": "근거는 없지만, 오늘 하루 『하나』와 함께 지내며 다다른 게 이 느낌이다."},
{"id": "clka10:3900", "ko": "그 녀석은 언뜻 제멋대로인 것 같지만, 행동에는 일관성이 있는 것 같다."},
{"id": "clka10:4000", "ko": "「……응」"},
{"id": "clka10:4100", "ko": "갑자기 카즈키가 멈춰 서서 하늘을 올려다보았다."},
{"id": "clka10:4200", "ko": "「왜 그래?」"},
{"id": "clka10:4300", "ko": "「……」"},
{"id": "clka10:4400", "ko": "「……비」"},
{"id": "clka10:4500", "ko": "「오기 시작했어…… 일지도」"},
{"id": "clka10:4600", "ko": "따라서 올려다보니 뺨에 톡 하고 빗방울이 떨어졌다."},
{"id": "clka10:4700", "ko": "그리고 금세 소나기가 되었다."},
{"id": "clka10:4800", "ko": "삔 발 때문에 빨리 달리지 못해서, 나와 카즈키는 순식간에 흠뻑 젖어 버렸다."},
{"id": "clka10:4900", "ko": "「일단 저기서 비를 피하자!」"},
{"id": "clka10:5000", "ko": "「응!」"},
{"id": "clka10:5100", "ko": "처마 밑을 빌린 곳은 본 적이 있는 것도 같고 없는 것도 같은 건물이었다."},
{"id": "clka10:5200", "ko": "들어가 본 기억이 있는 것도 같고 없는 것도 같은 곳이지만, 무슨 건물인지는 안다."},
{"id": "clka10:5300", "ko": "러브호텔이다."},
{"id": "clka10:5400", "ko": "둘이서 터벅터벅 걷는 사이에 어느새 러브호텔 거리를 헤매고 있었던 모양이다."},
{"id": "clka10:5500", "ko": "（아차……）"},
{"id": "clka10:5600", "ko": "분명히 내가 있을 곳이 아니라서 오래 있고 싶진 않지만, 주위에 보이는 건물은 하나같이 비슷비슷한 러브호텔이었다."},
{"id": "clka10:5700", "ko": "게다가 빗줄기가 점점 거세져서, 이 속을 역 앞까지 달리는 건 사양이다."},
{"id": "clka10:5800", "ko": "「일단 비가 그칠 때까지 여기 있자」"},
{"id": "clka10:5900", "ko": "「응」"},
{"id": "clka10:6000", "ko": "입구에는 아무도 없어서, 우리가 여기 있어도 뭐라고 하러 올 사람은 없을 것 같다."},
{"id": "clka10:6100", "ko": "「에취」"},
{"id": "clka10:6200", "ko": "귀여운 재채기 소리에 돌아보니, 카즈키가 휴지를 뭉쳐서 가방에 넣고 있었다."},
{"id": "clka10:6300", "ko": "「카즈키, 추워?」"},
{"id": "clka10:6400", "ko": "「으응」"},
{"id": "clka10:6500", "ko": "고개를 젓지만, 카즈키는 몸을 부르르 떨더니 자기를 끌어안듯이 몸을 문지르기 시작한다."},
{"id": "clka10:6600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:6700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:6800", "ko": "「에취 에취」"},
{"id": "clka10:6900", "ko": "재채기가 계속된다."},
{"id": "clka10:7000", "ko": "「……」"},
{"id": "clka10:7100", "ko": "나는 입구를 돌아보고, 다음으로 폭우가 되어 가는 바깥 풍경을 보고, 마지막으로 지갑 속을 확인했다."},
{"id": "clka10:7200", "ko": "「…………하아」"},
{"id": "clka10:7300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:7400", "ko": "「……」"},
{"id": "clka10:7500", "ko": "「으으으으으읏!?」"},
{"id": "clka10:7600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:7700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:7800", "ko": "「……응?」"},
{"id": "clka10:7900", "ko": "「그대로 있으면 감기 걸리잖아. 그래서 나중에 쿠루스한테 혼나는 건 나야」"},
{"id": "clka10:8000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:8100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:8200", "ko": "「으으응……」"},
{"id": "clka10:8300", "ko": "카즈키는 아직 망설이는 것 같았다. 나는 스스로도 한심하다고 생각하면서 마지막 비장의 카드를 꺼냈다."},
{"id": "clka10:8400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:8500", "ko": "「……」"},
{"id": "clka10:8600", "ko": "「응」"},
{"id": "clka10:8700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:8800", "ko": "……조금 복잡한 기분이긴 하다."},
{"id": "clka10:8900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9200", "ko": "「……응」"},
{"id": "clka10:9300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9400", "ko": "「뭐야?」"},
{"id": "clka10:9500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9600", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka10:9900", "ko": "", "note": "보류 — 성적 묘사"}
]
