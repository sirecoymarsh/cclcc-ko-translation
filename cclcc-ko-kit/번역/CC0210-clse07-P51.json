[
{"id": "clse07:487300", "ko": "「뭐가?」"},
{"id": "clse07:487400", "ko": "「어떻고 뭐고, 딱히 아무것도 없어」"},
{"id": "clse07:487500", "ko": "「그렇게 말하면서, 상대가 아리무라라서 그런 거잖아?」"},
{"id": "clse07:487600", "ko": "「그럼 나도 마찬가지잖아」"},
{"id": "clse07:487700", "ko": "「……왜 그렇게 생각하는데?」"},
{"id": "clse07:487800", "ko": "「그래? 별로 다를 거 없잖아」"},
{"id": "clse07:487900", "ko": "「마치 자기는 다 안다는 것 같잖아」"},
{"id": "clse07:488000", "ko": "「그렇지 않다니까. 그건 그냥 게임에 열 올리는 어린애야」"},
{"id": "clse07:488100", "ko": "「뭐, 뭐야……?」"},
{"id": "clse07:488200", "ko": "「뭐? 무슨 소리야. 왜 내가 열 올리고 있다는 거야?」"},
{"id": "clse07:488300", "ko": "「그러니까 딱히 나는 고집부리는 게……」"},
{"id": "clse07:488400", "ko": "「그래도 그 녀석은 달리 갈 데가 없었으니까……」"},
{"id": "clse07:488500", "ko": "「그래도――!」"},
{"id": "clse07:488600", "ko": "「그런 건――」"},
{"id": "clse07:488700", "ko": "「있잖아, 이토……」"},
{"id": "clse07:488800", "ko": "「나, 돌아갈게……」"},
{"id": "clse07:488900", "ko": "「응……?」"},
{"id": "clse07:489000", "ko": "「…………」"},
{"id": "clse07:489100", "ko": "「다녀왔……」"},
{"id": "clse07:489200", "ko": "「어, 어머님……」"},
{"id": "clse07:489300", "ko": "「아, 아니, 방금 건 말이 ⟦rb⟧헛나온⟦rt⟧⟦rbc⟧●●●⟦/r⟧ 거라……」"},
{"id": "clse07:489400", "ko": "「마, 마실 거라도 어떠…… 세요?」"},
{"id": "clse07:489500", "ko": "「마운틴 뷰로 괜찮으세요?」"},
{"id": "clse07:489600", "ko": "「……그렇죠. 그럼 애플티로」"},
{"id": "clse07:489700", "ko": "「드세요」"},
{"id": "clse07:489800", "ko": "「저, 그러니까…… 그래서, 그……」"},
{"id": "clse07:489900", "ko": "「저는……」"},
{"id": "clse07:490000", "ko": "「아, 아뇨, 저는――」"},
{"id": "clse07:490100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:490200", "ko": "「그러니까 저는――」"},
{"id": "clse07:490300", "ko": "「야, 아까부터 무슨 소리를 하는 거야, 아리무라」"},
{"id": "clse07:490400", "ko": "「모처럼 내가 대본대로 진행하려고 하는데……」"},
{"id": "clse07:490500", "ko": "「잠깐. 그게 무슨……」"},
{"id": "clse07:490600", "ko": "「아리무라……?」"},
{"id": "clse07:490700", "ko": "「아, 아니……」"},
{"id": "clse07:490800", "ko": "「그, 저는――」"},
{"id": "clse07:490900", "ko": "「…………」"},
{"id": "clse07:491000", "ko": "（아리무라……）"},
{"id": "clse07:491100", "ko": "「우선은…… 그렇지」"},
{"id": "clse07:491200", "ko": "「이번 특집은……」"},
{"id": "clse07:491300", "ko": "「여자의 마음을 철저 해부! 라……」"},
{"id": "clse07:491400", "ko": "「하아……」"},
{"id": "clse07:491500", "ko": "「지금 몇 시지?」"},
{"id": "clse07:491600", "ko": "「…………」"},
{"id": "clse07:491700", "ko": "（……아리무라…… 괜찮을까?）"},
{"id": "clse07:491800", "ko": "「…………」"},
{"id": "clse07:491900", "ko": "「…………」"},
{"id": "clse07:492000", "ko": "「응? 뭐지 이거?」"},
{"id": "clse07:492100", "ko": "「꽃?」"},
{"id": "clse07:492200", "ko": "「…………」"},
{"id": "clse07:492300", "ko": "「어라……?」"},
{"id": "clse07:492400", "ko": "「꿰매져 있어……」"},
{"id": "clse07:492500", "ko": "「뭐야, 이거……」"},
{"id": "clse07:492600", "ko": "「아아……」"},
{"id": "clse07:492700", "ko": "「미안하게 됐네. 나는 원래 이런 얼굴이야」"},
{"id": "clse07:492800", "ko": "「아, 아리무라는 상관없어!」"},
{"id": "clse07:492900", "ko": "「어……?」"},
{"id": "clse07:493000", "ko": "「미안, 이토. 나 잠깐 갈 데가 있어서」"},
{"id": "clse07:493100", "ko": "「아아, 오노에. 마침 잘 왔다」"},
{"id": "clse07:493200", "ko": "「아〜, 아니……」"},
{"id": "clse07:493300", "ko": "「그런…… 건가?」"},
{"id": "clse07:493400", "ko": "「아, 아아…… 뭐, 좀 이것저것 있어서……」"},
{"id": "clse07:493500", "ko": "「미안, 고마워」"},
{"id": "clse07:493600", "ko": "「…………」"},
{"id": "clse07:493700", "ko": "「…………」"},
{"id": "clse07:493800", "ko": "「아…………」"},
{"id": "clse07:493900", "ko": "「――!!」"},
{"id": "clse07:494000", "ko": "「……역시 문예부는 안 맞아, 그 녀석……」"},
{"id": "clse07:494100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:494200", "ko": "「그런가. 그럼 혹시 보면 연락 줘」"},
{"id": "clse07:494300", "ko": "「하아, 하아……!」"},
{"id": "clse07:494400", "ko": "「아리무라!!」"},
{"id": "clse07:494500", "ko": "「야, 기다리라니까!!」"},
{"id": "clse07:494600", "ko": "「아리무라……!!」"},
{"id": "clse07:494700", "ko": "「우왓!!!」"},
{"id": "clse07:494800", "ko": "「으윽……」"},
{"id": "clse07:494900", "ko": "「죄, 죄송합니다……」"},
{"id": "clse07:495000", "ko": "「…………」"},
{"id": "clse07:495100", "ko": "「하아……」"},
{"id": "clse07:495200", "ko": "「……아니, 아리무라답네」"},
{"id": "clse07:495300", "ko": "「뭐, 뭐야?」"},
{"id": "clse07:495400", "ko": "「……좀 더 일찍 알아챘으면 좋았을 텐데」"},
{"id": "clse07:495500", "ko": "「하아……」"},
{"id": "clse07:495600", "ko": "「그렇게 생각해서 신발장에서 지키고 있었는데……」"},
{"id": "clse07:495700", "ko": "「아리무라가 갈 만한 곳……」"},
{"id": "clse07:495800", "ko": "「안 되겠다. 생각해 봤는데 짐작도 안 가」"},
{"id": "clse07:495900", "ko": "「뭐야, 카즈키…… 있었냐……」"},
{"id": "clse07:496000", "ko": "「뭐!? 정말이야!?」"},
{"id": "clse07:496100", "ko": "「잘했어, 카즈키!!!」"},
{"id": "clse07:496200", "ko": "「미야시타 공원……?」"},
{"id": "clse07:496300", "ko": "「아, 아아……!!」"},
{"id": "clse07:496400", "ko": "（아리무라……）"},
{"id": "clse07:496500", "ko": "（아리무라……읏）"},
{"id": "clse07:496600", "ko": "「아리무라!!」"},
{"id": "clse07:496700", "ko": "「하아…… 하아……」"},
{"id": "clse07:496800", "ko": "「나야!」"},
{"id": "clse07:496900", "ko": "「오노에!! 아리무라는――」"},
{"id": "clse07:497000", "ko": "「그렇구나! 고마워!!」"},
{"id": "clse07:497100", "ko": "「응……?」"},
{"id": "clse07:497200", "ko": "「……아아!」"}
]
