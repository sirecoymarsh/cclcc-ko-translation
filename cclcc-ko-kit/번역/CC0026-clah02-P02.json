[
{"id": "clah02:10000", "ko": "「이, 이토…… 네가 왜……!」"},
{"id": "clah02:10100", "ko": "「누웃…… 으아아아아아아아앗!!!」"},
{"id": "clah02:10200", "ko": "젠장! 이 녀석이 억지로 열어 버렸다."},
{"id": "clah02:10300", "ko": "「하아…… 하아…… 뭐, 뭐야. 왜 문을 닫는 건데?」"},
{"id": "clah02:10400", "ko": "「아, 아니…… 갑자기라서 놀라서……」"},
{"id": "clah02:10500", "ko": "「흐흐〜응……」"},
{"id": "clah02:10600", "ko": "「뭐, 뭐야?」"},
{"id": "clah02:10700", "ko": "「그런 소리 하면서. 누구 기다리고 있었던 거 아냐〜?」"},
{"id": "clah02:10800", "ko": "「왜, 왜?」"},
{"id": "clah02:10900", "ko": "「아까 늦었네, 라고 하지 않았냐?」"},
{"id": "clah02:11000", "ko": "큰일이다."},
{"id": "clah02:11100", "ko": "「이, 이렇게 늦게 누구냐, 라고 한 거야」"},
{"id": "clah02:11200", "ko": "「흐응……」"},
{"id": "clah02:11300", "ko": "방금 걸로 얼버무렸…… 나?"},
{"id": "clah02:11400", "ko": "「……뭐, 됐어. 들어간다〜」"},
{"id": "clah02:11500", "ko": "「자, 잠깐만!」"},
{"id": "clah02:11600", "ko": "「왜? 혹시 내가 들어가면 곤란한 거라도 있냐?」"},
{"id": "clah02:11700", "ko": "「아, 아니…… 그런 건 아니고……」"},
{"id": "clah02:11800", "ko": "「그럼 괜찮지? 실례합니다〜」"},
{"id": "clah02:11900", "ko": "이토는 대답도 기다리지 않고 내 옆을 빠져나가 안으로 들어와 버렸다."},
{"id": "clah02:12000", "ko": "그리고 뭔가 방 안을 이리저리 훑어보기 시작했다."},
{"id": "clah02:12100", "ko": "「흠……」"},
{"id": "clah02:12200", "ko": "그러더니 이번엔 세면실 문을 열고 안을 확인하고 있다."},
{"id": "clah02:12300", "ko": "「뭐, 뭐야!?」"},
{"id": "clah02:12400", "ko": "게다가 쭈그려 앉아 냉장고 안까지."},
{"id": "clah02:12500", "ko": "「설마 여기는…… 없겠지」"},
{"id": "clah02:12600", "ko": "「그러니까 뭐냐고, 아까부터!?」"},
{"id": "clah02:12700", "ko": "「흠. 안심했다! 역시 너는 내 절친이야, 미야시로!」"},
{"id": "clah02:12800", "ko": "이토는 벌떡 일어나더니 두 손으로 내 손을 잡고 세차게 위아래로 흔들었다."},
{"id": "clah02:12900", "ko": "「아니〜, 동아리 시간에 네 모습이 이상했잖아? 유난히 빨리 돌아가고 싶어 하는 것 같았고」"},
{"id": "clah02:13000", "ko": "「그래서 당연히 이 몸을 제쳐 두고 방에 여자애라도 끌어들여서 동거라도 하는 거 아닌가 했는데, 어디에도 여자 흔적 같은 건 없고, 아무래도 내 기우였던 것 같다」"},
{"id": "clah02:13100", "ko": "이 녀석…… 이 무슨 야생의 감인가."},
{"id": "clah02:13200", "ko": "「아, 아아, 당연하지. 내, 내가 이 방에 여자애를 끌어들이거나 할 리가 있냐」"},
{"id": "clah02:13300", "ko": "「그렇지〜. 역시 미야시로야. 내가 믿는 남자답다」"},
{"id": "clah02:13400", "ko": "그런 식으로 믿어 주는 건 사양하고 싶다."},
{"id": "clah02:13500", "ko": "「뭐, 생각해 보면 오노에나 부부장 같은 애들이 주위에 있는데도 지금까지 아무 일도 없었으니까」"},
{"id": "clah02:13600", "ko": "「너한테는 그런 걱정을 할 필요가 없었던 거지」"},
{"id": "clah02:13700", "ko": "이토가 나를 이렇게 생각하는 건 거슬리지만, 여기선 잠자코 듣고 있는 게 나을 것 같다."},
{"id": "clah02:13800", "ko": "「그, 그렇지. 나한테 그런 일이 있을 리가 없잖아」"},
{"id": "clah02:13900", "ko": "「그렇지〜. 그래서?」"},
{"id": "clah02:14000", "ko": "고개를 끄덕끄덕하는가 싶더니, 이번엔 갑자기 얼굴을 가까이 대고 귓속말을 해 왔다."},
{"id": "clah02:14100", "ko": "「……뭐야?」"},
{"id": "clah02:14200", "ko": "「숨기지 마! 뭔가 좋은 야한 DVD라도 손에 넣어서 그래서 일찍 돌아온 거지?」"},
{"id": "clah02:14300", "ko": "「……너랑 똑같이 취급하지 마. 그런 거 아니야」"},
{"id": "clah02:14400", "ko": "애초에 요즘 세상에 DVD라니."},
{"id": "clah02:14500", "ko": "그런 건 인터넷을 돌아다니면 얼마든지 구할 수 있을 텐데."},
{"id": "clah02:14600", "ko": "「또또〜. 질리면 나한테도 빌려줘」"},
{"id": "clah02:14700", "ko": "「응?」"},
{"id": "clah02:14800", "ko": "그때 나는 이토의 등 뒤, 침대 베개 그늘에서 뭔가 돌돌 말린 것을 발견했다."},
{"id": "clah02:14900", "ko": "팬시한 색감의 무늬가 들어간, 천으로 된 무언가다."},
{"id": "clah02:15000", "ko": "저건 혹시……"},
{"id": "clah02:15100", "ko": "「패, 팬――」"},
{"id": "clah02:15200", "ko": "말하려다가 나도 모르게 손으로 입을 막았다."},
{"id": "clah02:15300", "ko": "「뭐?」"},
{"id": "clah02:15400", "ko": "「아, 아니! 팬…… 케이크라도 먹을까〜, 싶어서」", "note": "パン(빵)/パンツ(팬티) 말장난 → 「팬케이크」/「팬티」"},
{"id": "clah02:15500", "ko": "「뭐야. 너 배고프냐?」"},
{"id": "clah02:15600", "ko": "저건………… 팬티 아냐?"},
{"id": "clah02:15700", "ko": "그것도 여자 거!"},
{"id": "clah02:15800", "ko": "근데 왜 저런 곳에 여자 팬티가!?"},
{"id": "clah02:15900", "ko": "아니, 그거야 뻔하지."},
{"id": "clah02:16000", "ko": "저건………… 아리무라 거다!"},
{"id": "clah02:16100", "ko": "그 녀석, 저런 곳에 벗은 팬티를 두고 가다니."},
{"id": "clah02:16200", "ko": "잠깐…… 벗은 팬티?"},
{"id": "clah02:16300", "ko": "그럼 그 녀석은 오늘 하루 종일……"},
{"id": "clah02:16400", "ko": "「노팬티!!?」"},
{"id": "clah02:16500", "ko": "「뭐어?」"},
{"id": "clah02:16600", "ko": "「아〜! 그…… 노, 노릇노릇한 팬케이크가 괜히 먹고 싶네〜, 라든가……」", "note": "원문 「コンビニのぉパン」(노오판)이 ノーパン 처럼 들리는 말장난 → 「노릇노릇한 팬케이크」"},
{"id": "clah02:16700", "ko": "「뭐야. 나는 안 사러 간다. 먹고 싶으면 네가 사 와」"},
{"id": "clah02:16800", "ko": "노팬티……"},
{"id": "clah02:16900", "ko": "설마 아리무라한테 그런 취향이……"},
{"id": "clah02:17000", "ko": "아니, 잠깐. 벗은 팬티라고 단정할 수는 없지."},
{"id": "clah02:17100", "ko": "어쩌면 갈아입을 팬티일지도 모르잖아."},
{"id": "clah02:17200", "ko": "아니아니, 지금은 그런 건 아무래도 좋다."},
{"id": "clah02:17300", "ko": "저 팬티를 어떻게든 하지 않으면 이토가 나를 엉뚱하게 의심하게 된다."},
{"id": "clah02:17400", "ko": "아니, 저런 게 발견되면 엉뚱한 의심은커녕 결정적인 증거라 할 수 있다."},
{"id": "clah02:17500", "ko": "다행히 이토는 지금 침대에 등을 돌리고 있다."},
{"id": "clah02:17600", "ko": "어떻게든 이대로 돌아가도록 유도하자."},
{"id": "clah02:17700", "ko": "「그, 그럼 나는 팬케이크 사러 갈 테니까, 이토도 슬슬……」"},
{"id": "clah02:17800", "ko": "「응? 모처럼 왔는데 좀 더 있다 가도 되잖아」"},
{"id": "clah02:17900", "ko": "「아니, 그래도 나도 집을 비우니까」"},
{"id": "clah02:18000", "ko": "「그동안 내가 집 봐 준다니까」"},
{"id": "clah02:18100", "ko": "……이 녀석, 눈치 좀 챙겨라."},
{"id": "clah02:18200", "ko": "「그보다 말이야, 나 좀 졸리거든. 그러니까 네가 편의점 간 동안 누워 있어도 되냐?」"},
{"id": "clah02:18300", "ko": "「뭐?」"},
{"id": "clah02:18400", "ko": "바보! 그러면 그게――!"},
{"id": "clah02:18500", "ko": "「그럼 잘 자〜!」"},
{"id": "clah02:18600", "ko": "그때, 생각보다 먼저 내 몸이 움직였다."},
{"id": "clah02:18700", "ko": "「이, 이토!!!」"},
{"id": "clah02:18800", "ko": "「어? 아…… 우왓!!」"},
{"id": "clah02:18900", "ko": "「아…………」"},
{"id": "clah02:19000", "ko": "「미, 미야시로…… 너, 뭘……」"},
{"id": "clah02:19100", "ko": "아차!!"},
{"id": "clah02:19200", "ko": "이래서는 마치 이토를 덮치고 있는 것 같잖아!!"},
{"id": "clah02:19300", "ko": "빨리 비키지 않으면 사태가 다른 방향으로 악화되겠어."},
{"id": "clah02:19400", "ko": "지금 당장――"},
{"id": "clah02:19500", "ko": "（으아아아아! 팬티가!!）"},
{"id": "clah02:19600", "ko": "여기서 비키면 아리무라의 팬티가……!"},
{"id": "clah02:19700", "ko": "어느 쪽으로 굴러가도 위험해지는 거 아냐?"},
{"id": "clah02:19800", "ko": "젠자아아앙, 어떻게 하지!"},
{"id": "clah02:19900", "ko": "나는 어떻게 하면 좋은 거야!"}
]
