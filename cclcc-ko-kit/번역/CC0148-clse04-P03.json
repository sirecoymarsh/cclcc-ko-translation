[
{"id": "clse04:15500", "ko": "저게 말로만 듣던 환자용 소변기라는 건가!?"},
{"id": "clse04:15600", "ko": "……하고 감탄하고 있을 때가 아니었다."},
{"id": "clse04:15700", "ko": "「그, 그만해 줘! 나한테 그런 취미는 없다니까!!」"},
{"id": "clse04:15800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:15900", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:16000", "ko": "나는 너무나 한심한 기분에 휩싸여서 나도 모르게 울 뻔했다."},
{"id": "clse04:16100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:16200", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:16300", "ko": "하지만 그런 건 알고 싶지 않았다."},
{"id": "clse04:16400", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:16500", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:16600", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:16700", "ko": "그보다 내 마음이 이미 너덜너덜하다고!"},
{"id": "clse04:16800", "ko": "「저기, 오노에~. 절대 안 도망칠 테니까 화장실 보내 줘. 이래서는 무리야」"},
{"id": "clse04:16900", "ko": "「무리 아니거든」"},
{"id": "clse04:17000", "ko": "「왜!?」"},
{"id": "clse04:17100", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse04:17200", "ko": "「윽!? 아니, 그건 이런 방법이 아니었고! 애초에 의료 행위랄까, 치료의 일환이니까 창피하다거나 그런 게 아니라――」"},
{"id": "clse04:17300", "ko": "", "note": "보류 — 성적 묘사(미성년·가족)"},
{"id": "clse04:17400", "ko": "「그럴 리가 있냐~!」"},
{"id": "clse04:17500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clse04:17600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clse04:17700", "ko": "「어? 오, 오노에……?」"},
{"id": "clse04:17800", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:17900", "ko": "검은 오노에가 입에 올린 『하얀 오노에 세리카가 망가지기 시작했다』."},
{"id": "clse04:18000", "ko": "그 말의 의미를 어렴풋이 알 것 같았다."},
{"id": "clse04:18100", "ko": "", "note": "보류 — 성적 묘사(미성년 대상)"},
{"id": "clse04:18200", "ko": "결국 나는 그렇게 대답할 수밖에 없게 되어 있었다."}
]
