{"id": "clkn09:15400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:15500", "ko": "「헉!?」"},
{"id": "clkn09:15600", "ko": "아, 안 돼!"},
{"id": "clkn09:15700", "ko": "내가 무슨 상상을 해 버린 거야!!"},
{"id": "clkn09:15800", "ko": "「정말, 못된 아이라니까」"},
{"id": "clkn09:15900", "ko": "「죄, 죄송합니다!」"},
{"id": "clkn09:16000", "ko": "「어?」"},
{"id": "clkn09:16100", "ko": "「아, 아니…… 아무것도 아니야. 아무것도……」"},
{"id": "clkn09:16200", "ko": "「정말. 이상한 타쿠루네」"},
{"id": "clkn09:16300", "ko": "……깊이 반성."},
{"id": "clkn09:16400", "ko": "「노노!」"},
{"id": "clkn09:16500", "ko": "「왜에, 타쿠루?」"},
{"id": "clkn09:16600", "ko": "「히카리를…… 안게 해 주지 않을래?」"},
{"id": "clkn09:16700", "ko": "「어?」"},
{"id": "clkn09:16800", "ko": "「됐으니까 히카리를 이리 줘」"},
{"id": "clkn09:16900", "ko": "「어, 응……」"},
{"id": "clkn09:17000", "ko": "노노에게서 히카리를 받아 들자 내 마음은 충만감으로 가득 찼다."},
{"id": "clkn09:17100", "ko": "아아, 그래, 이거다."},
{"id": "clkn09:17200", "ko": "내가 원하던 건 이거였어."},
{"id": "clkn09:17300", "ko": "「그렇구나…… 히카리. 젖이 먹고 싶은 거야?」"},
{"id": "clkn09:17400", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:17500", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:17600", "ko": "「타, 타쿠루!? 너 뭐 하는 거야!?」"},
{"id": "clkn09:17700", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:17800", "ko": "그래, 나는 분명 계속 이렇게 하고 싶었던 거다."},
{"id": "clkn09:17900", "ko": "누군가의 엄마가 되어 아기를 키운다."},
{"id": "clkn09:18000", "ko": "그것이 줄곧 억눌려 있던 내 안의 진짜 욕망."},
{"id": "clkn09:18100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:18200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:18300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:18400", "ko": "엄마가 된다는 건 이런 기분이구나……"},
{"id": "clkn09:18500", "ko": "「오늘부터 내가 너의 엄마야…… 안녕, 아가야」"},
{"id": "clkn09:18600", "ko": "「헉!?」"},
{"id": "clkn09:18700", "ko": "뭐, 뭐였지 방금 그건?"}
]
