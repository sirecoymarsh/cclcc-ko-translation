[
{"id": "clkn09:8800", "ko": "「어?」"},
{"id": "clkn09:8900", "ko": "「아……」"},
{"id": "clkn09:9000", "ko": "「노, 노노…… 너 무슨 소리야?」"},
{"id": "clkn09:9100", "ko": "「아, 아니야. 딱히 내가, 라든가 그런 게 아니라……!」"},
{"id": "clkn09:9200", "ko": "「그, 그치? 그렇지~ 히카리~」"},
{"id": "clkn09:9300", "ko": "「어머어머. 히카리, 기분이 안 좋아쪄요~. 왜 그럴까~?」"},
{"id": "clkn09:9400", "ko": "조금 전까지 기분 좋던 히카리가 갑자기 칭얼대기 시작했다."},
{"id": "clkn09:9500", "ko": "「배고픈가~? 타쿠루, 미안한데……」"},
{"id": "clkn09:9600", "ko": "「분유지?」"},
{"id": "clkn09:9700", "ko": "「덕분에 살았어, 고마워」"},
{"id": "clkn09:9800", "ko": "이 이틀 동안 나도 완전히 육아 경험자가 됐다."},
{"id": "clkn09:9900", "ko": "분유도 탈 줄 알고, 기저귀도 갈 줄 안다."},
{"id": "clkn09:10000", "ko": "물론 처음에는 왜 내가 이런 걸 해야 하냐고 생각했지만, 해 보니 의외로 쉽다."},
{"id": "clkn09:10100", "ko": "적어도 반의 정보 약자들을 상대하는 것보다는 훨씬 마음 편하고 좋다."},
{"id": "clkn09:10200", "ko": "열탕 소독을 마친 젖병에 분유를 넣고 70도 이상의 뜨거운 물로 녹인다."},
{"id": "clkn09:10300", "ko": "그다음 젖병을 찬물에 담가 체온 정도로 식히면 끝."},
{"id": "clkn09:10400", "ko": "「자, 분유」"},
{"id": "clkn09:10500", "ko": "「고마워. 자, 히카리~ 맘마 왔쪄요~」"},
{"id": "clkn09:10600", "ko": "하지만 히카리는 젖병을 물려고 하지 않았다."},
{"id": "clkn09:10700", "ko": "내가 탄 분유가 싫…… 은 건 아니겠지. 실제로 오늘 아침에도 잘 먹었고."},
{"id": "clkn09:10800", "ko": "「왜 그러지?」"},
{"id": "clkn09:10900", "ko": "「배고픈 게 아닌가?」"},
{"id": "clkn09:11000", "ko": "걱정스럽게 들여다보는 노노의 품 안에서 히카리가 몸을 비틀었다."},
{"id": "clkn09:11100", "ko": "그러더니 침투성이 입을 노노의 가슴에 갖다 댔다."},
{"id": "clkn09:11200", "ko": "「그렇구나, 엄마 젖이 먹고 싶구나」"},
{"id": "clkn09:11300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:11400", "ko": "「그래도 안 돼, 히카리. 그래 봤자 누나는 젖이 안 나와」"},
{"id": "clkn09:11500", "ko": "「…………」"},
{"id": "clkn09:11600", "ko": "아니 아니 아니."},
{"id": "clkn09:11700", "ko": "아기가 엄마 젖을 찾는 건 당연한 일이다."},
{"id": "clkn09:11800", "ko": "하지만……"},
{"id": "clkn09:11900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn09:12000", "ko": "「…………」"},
{"id": "clkn09:12100", "ko": "기다려, 진정해, 타쿠루."},
{"id": "clkn09:12200", "ko": "상대는 아기라고."},
{"id": "clkn09:12300", "ko": "딱히 불순한 마음 같은 게 있을 리가 없다."},
{"id": "clkn09:12400", "ko": "있을 리가……"},
