[
{"id": "clse07:497300", "ko": "「아……!」"},
{"id": "clse07:497400", "ko": "「아리무라!!!」"},
{"id": "clse07:497500", "ko": "「겨, 겨우…… 잡았다……!」"},
{"id": "clse07:497600", "ko": "「왜 도망치는 거야?」"},
{"id": "clse07:497700", "ko": "「들어 줘, 아리무라」"},
{"id": "clse07:497800", "ko": "「…………」"},
{"id": "clse07:497900", "ko": "「아리무라……」"},
{"id": "clse07:498000", "ko": "「그래도 나는――!」"},
{"id": "clse07:498100", "ko": "「…………」"},
{"id": "clse07:498200", "ko": "「아리무라……」"},
{"id": "clse07:498300", "ko": "「아리무라!!!!」"},
{"id": "clse07:498400", "ko": "「기다려, 아리무라!!!」"},
{"id": "clse07:498500", "ko": "「나는――!!」"},
{"id": "clse07:498600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:498700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:498800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:498900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:499000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:499100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:499200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:499300", "ko": "「하아…… 하아……」"},
{"id": "clse07:499400", "ko": "「――!!」"},
{"id": "clse07:499500", "ko": "「아리무라!!!!」"},
{"id": "clse07:499600", "ko": "「아리무라!!!」"},
{"id": "clse07:499700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:499800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:499900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:500000", "ko": "「응……?」"},
{"id": "clse07:500100", "ko": "「그러니까 몇 번이나 사과했잖아」"},
{"id": "clse07:500200", "ko": "「그럼 어쩌라는 건데?」"},
{"id": "clse07:500300", "ko": "「아무튼 나는 이제 사과 안 할 거니까」"},
{"id": "clse07:500400", "ko": "「그런 거라니, 뭔데?」"},
{"id": "clse07:500500", "ko": "「뭐어?」"},
{"id": "clse07:500600", "ko": "「야, 알 수 없는 소리 하지 마」"},
{"id": "clse07:500700", "ko": "「너 말이야…… 자꾸 알 수 없는 소리만 하면 진짜로 싫어질 거다」"},
{"id": "clse07:500800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:500900", "ko": "「우와아아아아아아아!!!」"},
{"id": "clse07:501000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:501100", "ko": "「야! 스피커 음량 올리지 마!」"},
{"id": "clse07:501200", "ko": "「기다려! 구경거리가 아니라고! 카즈키도 당장 닫아!」"},
{"id": "clse07:501300", "ko": "「아니, 왜 너까지 같이 그러고 있냐고, 히나에」"},
{"id": "clse07:501400", "ko": "「그런 건 볼 필요 없어!」"},
{"id": "clse07:501500", "ko": "「자꾸 알 수 없는 소리만 하면 싫어질 거다」"},
{"id": "clse07:501600", "ko": "「잘 먹었어. 맛있었어」"},
{"id": "clse07:501700", "ko": "「아아, 그렇지……」"},
{"id": "clse07:501800", "ko": "「걱정이네……」"},
{"id": "clse07:501900", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:502000", "ko": "「후아아…… 안심했더니 좀 졸리네」"},
{"id": "clse07:502100", "ko": "「……왠지 미안하네」"},
{"id": "clse07:502200", "ko": "「응?」"},
{"id": "clse07:502300", "ko": "「히나에네 집에?」"},
{"id": "clse07:502400", "ko": "「……나, 나로 괜찮을까?」"},
{"id": "clse07:502500", "ko": "「그, 그래, 알았어. 그럼 다음에……」"},
{"id": "clse07:502600", "ko": "「…………」"},
{"id": "clse07:502700", "ko": "「응……」"},
{"id": "clse07:502800", "ko": "「으음……」"},
{"id": "clse07:502900", "ko": "「응?」"},
{"id": "clse07:503000", "ko": "「아아…… 미안. 나도 모르게 꾸벅꾸벅 졸아서……」"},
{"id": "clse07:503100", "ko": "「그보다, 괜찮은 걸까. 정말로……」"},
{"id": "clse07:503200", "ko": "「이대로 같이 생활해도…… 어머님도 화나 계신 거 아냐?」"},
{"id": "clse07:503300", "ko": "「그래도, 그렇다고……」"},
{"id": "clse07:503400", "ko": "「으……」"},
{"id": "clse07:503500", "ko": "「……그건…… 싫어」"},
{"id": "clse07:503600", "ko": "「인정해 달라니…… 여기 사는 걸?」"},
{"id": "clse07:503700", "ko": "「나는――」"},
{"id": "clse07:503800", "ko": "「어?」"},
{"id": "clse07:503900", "ko": "「히나에……」"},
{"id": "clse07:504000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:504100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:504200", "ko": "「응?」"},
{"id": "clse07:504300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:504400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:504500", "ko": "「어?」"},
{"id": "clse07:504600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:504700", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clse07:504800", "ko": "（응……）"},
{"id": "clse07:504900", "ko": "（으응……）"},
{"id": "clse07:505000", "ko": "「…………」"},
{"id": "clse07:505100", "ko": "「…………」"},
{"id": "clse07:505200", "ko": "「……오늘은, 월요일……」"},
{"id": "clse07:505300", "ko": "「…………」"},
{"id": "clse07:505400", "ko": "「……일어나야지……」"},
{"id": "clse07:505500", "ko": "「…………?」"},
{"id": "clse07:505600", "ko": "「……아니, 안 돼. 일어나자」"},
{"id": "clse07:505700", "ko": "「영차――」"},
{"id": "clse07:505800", "ko": "「――읏차」"},
{"id": "clse07:505900", "ko": "「컥!?」"},
{"id": "clse07:506000", "ko": "「뭐, 뭐야!?」"},
{"id": "clse07:506100", "ko": "「머, 머리가…… 아파!」"},
{"id": "clse07:506200", "ko": "「……」"},
{"id": "clse07:506300", "ko": "「대체 뭐야……」"},
{"id": "clse07:506400", "ko": "「……왜 나 교복을 입은 채로 자고 있었지?」"},
{"id": "clse07:506500", "ko": "「읏차, 우왓!」"},
{"id": "clse07:506600", "ko": "「교복……」"},
{"id": "clse07:506700", "ko": "「어제는 일요일인데……」"},
{"id": "clse07:506800", "ko": "「아니, 잠깐」"},
{"id": "clse07:506900", "ko": "「분명 어제는……」"},
{"id": "clse07:507000", "ko": "「신문부 멤버들이랑 같이 움직였던, 것 같은데……」"},
{"id": "clse07:507100", "ko": "「어제 나는 그 녀석들이랑……」"},
{"id": "clse07:507200", "ko": "「으윽!」"}
]
