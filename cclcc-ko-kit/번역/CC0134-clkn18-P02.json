[
{"id": "clkn18:9600", "ko": "이럴 때 이 녀석들 말을 믿고 행동해 봤자 좋은 꼴을 못 본다는 건 경험상 알고 있다."},
{"id": "clkn18:9700", "ko": "하지만……"},
{"id": "clkn18:9800", "ko": "「그나저나 센리, 늦네~. 무슨 일일까?」"},
{"id": "clkn18:9900", "ko": "「아까 복도에서 만났는데, 볼일이 있어서 늦을지도 모른다던데」"},
{"id": "clkn18:10000", "ko": "「볼일?」"},
{"id": "clkn18:10100", "ko": "분명 학생회는 오늘 없다고 했다."},
{"id": "clkn18:10200", "ko": "그럼 신문부 회의보다 중요한 볼일이 대체 뭔데."},
{"id": "clkn18:10300", "ko": "「신경 쓰이면 전화해 보지 그래?」"},
{"id": "clkn18:10400", "ko": "「따, 딱히 신경 쓰이는 건……」"},
{"id": "clkn18:10500", "ko": "「아, 여보세요~ 선배? 그게~ 미야시로 선배가 걱정해서~……」"},
{"id": "clkn18:10600", "ko": "「아! 아리무라! 너 언제……」"},
{"id": "clkn18:10700", "ko": "「아, 잠깐, 선배? 센리 선배~……」"},
{"id": "clkn18:10800", "ko": "「아아아아아아아아!!」"},
{"id": "clkn18:10900", "ko": "「시끄럽네. 뭐야, 이토?」"},
{"id": "clkn18:11000", "ko": "「저거! 저거!!!」"},
{"id": "clkn18:11100", "ko": "「응?」"},
{"id": "clkn18:11200", "ko": "이토가 가리킨 곳――창밖의 테니스 코트. 거기에는……"},
{"id": "clkn18:11300", "ko": "「저기…… 뭐야, 할 얘기라는 게?」"},
{"id": "clkn18:11400", "ko": "센리와……"},
{"id": "clkn18:11500", "ko": "「좀, 말이야……」"},
{"id": "clkn18:11600", "ko": "카와하라가 있었다."},
{"id": "clkn18:11700", "ko": "「응?」"},
{"id": "clkn18:11800", "ko": "잠깐."},
{"id": "clkn18:11900", "ko": "어떻게 목소리가 들리는 거지?"},
{"id": "clkn18:12000", "ko": "「센리 선배, 또 허둥대다 전화 끊는 걸 잊었네요~」"},
{"id": "clkn18:12100", "ko": "아리무라가 든 스마트폰 화면에는 센리의 이름과 스피커 표시가 떠 있었다."},
{"id": "clkn18:12200", "ko": "「그러니까 너……」"},
{"id": "clkn18:12300", "ko": "「그래도 궁금하잖아요?」"},
{"id": "clkn18:12400", "ko": "「으……」"},
{"id": "clkn18:12500", "ko": "다시 창밖을 보니, 카와하라와 센리가 나란히 서 있는 모습이 보였다."},
{"id": "clkn18:12600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clkn18:12700", "ko": "「근데~…… 왠지 저, 엄청난 ⟦col:280aa02d1400⟧데자뷔⟦col:800000⟧가 밀려오는데요~」"},
{"id": "clkn18:12800", "ko": "「마찬가지…… 일지도……」"},
{"id": "clkn18:12900", "ko": "「아, 아니~ 그래도 설마, 아무리 그래도……」"},
{"id": "clkn18:13000", "ko": "「쉬잇!!」"},
{"id": "clkn18:13100", "ko": "「어때? 이제 학교에는 적응했나?」"},
{"id": "clkn18:13200", "ko": "「으, 응…… 뭐……」"},
{"id": "clkn18:13300", "ko": "적응하고 말고 할 것도 없이 계속 다니고 있었지만, 카와하라에게 센리는 유학에서 막 돌아온 걸로 되어 있는 것이다."},
{"id": "clkn18:13400", "ko": "「그, 런가…… 곤란한 일이 있으면 언제든 말해 줘」"},
{"id": "clkn18:13500", "ko": "「고, 고마워……」"},
{"id": "clkn18:13600", "ko": "「…………」"},
{"id": "clkn18:13700", "ko": "「할 얘기는 그것뿐이야? 그럼 난……」"},
{"id": "clkn18:13800", "ko": "「아, 기다려 줘!!」"},
{"id": "clkn18:13900", "ko": "「왜?」"},
{"id": "clkn18:14000", "ko": "「그…… 쿠루스가 외국으로 가 버린 건 아쉽지만, 언제까지나 아쉬워해 봤자 소용없지」"},
{"id": "clkn18:14100", "ko": "「인생은 긍정적으로 살아야 하는 법이다. 그렇게 생각하지 않나?」"},
{"id": "clkn18:14200", "ko": "「…………?」"},
{"id": "clkn18:14300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:14400", "ko": "「아~……」"},
{"id": "clkn18:14500", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:14600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clkn18:14700", "ko": "「미나미사와도 오랜만에 돌아와서 외롭겠지」"},
{"id": "clkn18:14800", "ko": "「딱히……」"},
{"id": "clkn18:14900", "ko": "「외롭지? 아니, 외로울 게 뻔해!! 분명히 그래!」"},
{"id": "clkn18:15000", "ko": "「저기, 카와하라? 아까부터 무슨……」"},
{"id": "clkn18:15100", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clkn18:15200", "ko": "「뭐?」"},
{"id": "clkn18:15300", "ko": "진짜…… 냐……"},
{"id": "clkn18:15400", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clkn18:15500", "ko": "「……왜?」"},
{"id": "clkn18:15600", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clkn18:15700", "ko": "그건 아마 카와하라가 아니라 쿠루스 노노가 있어서였던 거 아닌가?"},
{"id": "clkn18:15800", "ko": "", "note": "보류 — 연애 묘사(학생)"},
{"id": "clkn18:15900", "ko": "「그게…… 미안해」"},
{"id": "clkn18:16000", "ko": "「……어?」"},
{"id": "clkn18:16100", "ko": "「카와하라는 친구지만, 그 이상으로 생각해 본 적은 없어」"},
{"id": "clkn18:16200", "ko": "「뭣!?」"},
{"id": "clkn18:16300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:16400", "ko": "「뭐…… 아…… 아…… 아아……」"},
{"id": "clkn18:16500", "ko": "「할 얘기는 그것뿐이야? 그럼 난 이만……」"},
{"id": "clkn18:16600", "ko": "「아…… 아아…… 아…………」"},
{"id": "clkn18:16700", "ko": "센리가 떠난 뒤에도 카와하라는 넋이 나간 듯 계속 우두커니 서 있었다."},
{"id": "clkn18:16800", "ko": "「저거, 또 기억이 이상해지겠네……」"},
{"id": "clkn18:16900", "ko": "그때는 그야말로 쿠노사토 씨가 나설 차례다."},
{"id": "clkn18:17000", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:17100", "ko": "「따, 딱히 나는 걱정 같은 거 안 했거든!」"},
{"id": "clkn18:17200", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:17300", "ko": "", "note": "보류 — 연애 묘사(학생·가족)"},
{"id": "clkn18:17400", "ko": "「바보! 아리무라! 그만해!」"},
{"id": "clkn18:17500", "ko": "「에~ 방금 거, 진짜야 거짓말이야? 알려 줘, 히나~!」"},
{"id": "clkn18:17600", "ko": "「그건~」"},
{"id": "clkn18:17700", "ko": "「그러니까 그만하라고!!!」"},
{"id": "clkn18:17800", "ko": "「타쿠루. 차 마실래?」"},
{"id": "clkn18:17900", "ko": "「어? 아, 될 수 있으면 ⟦col:280aa02d1400⟧마운틴 뷰⟦col:800000⟧ 쪽이……」"},
{"id": "clkn18:18000", "ko": "「안~ 돼. 이런 시간에 그렇게 ⟦col:280aa02d1400⟧카페인⟦col:800000⟧이 많은 걸 마시면 잠이 안 오잖아」"},
{"id": "clkn18:18100", "ko": "「으……」"},
{"id": "clkn18:18200", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn18:18300", "ko": "「얘, 유이. 놀리지 마」"},
{"id": "clkn18:18400", "ko": "「안녕히 주무세요~」"},
{"id": "clkn18:18500", "ko": "「정말, 저 애도 참!」"},
{"id": "clkn18:18600", "ko": "유이가 방으로 돌아가자, 거실에 남은 건 나와 센리뿐이었다."},
{"id": "clkn18:18700", "ko": "날마다 북적이는 만큼, 둘만 남자마자 고요함이 두드러진다."},
{"id": "clkn18:18800", "ko": "응……?"},
{"id": "clkn18:18900", "ko": "", "note": "보류 — 연애 묘사(가족)"},
{"id": "clkn18:19000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clkn18:19100", "ko": "「…………」"},
{"id": "clkn18:19200", "ko": "「타쿠루, 왜 그래?」"},
{"id": "clkn18:19300", "ko": "「어? 아, 아…… 아니, 아무것도. 아니야……!」"},
{"id": "clkn18:19400", "ko": "「그래……」"},
{"id": "clkn18:19500", "ko": "", "note": "보류 — 연애 묘사(가족)"}
]
