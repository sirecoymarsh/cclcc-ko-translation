[
{"id": "clah04:40000", "ko": "「넵! 완전 반하게 만들 검다!」"},
{"id": "clah04:40100", "ko": "또 귀찮은 소리를 하기 시작했다……"},
{"id": "clah04:40200", "ko": "（그런 것만 없으면 아리무라도 조금은……）"},
{"id": "clah04:40300", "ko": "……이봐 이봐."},
{"id": "clah04:40400", "ko": "조금은…… 뭐라는 건데."},
{"id": "clah04:40500", "ko": "「이건 제 자존심을 건 싸움이에요. 누가 뭐라 하든 나는 한다!」"},
{"id": "clah04:40600", "ko": "「그래, 절대 질 수 없는 싸움이 거기에 있다!」"},
{"id": "clah04:40700", "ko": "아리무라가 선언할 때마다 내 마음은 점점 굳어 갔다."},
{"id": "clah04:40800", "ko": "「뭐, 그래도 일단 오늘은 아직 전초전이라는 걸로……」"},
{"id": "clah04:40900", "ko": "그러더니 아리무라는 소매를 걷어붙이고 부엌으로 향했다."},
{"id": "clah04:41000", "ko": "그리고 세 시간 뒤――"},
{"id": "clah04:41100", "ko": "「자, 드세요」"},
{"id": "clah04:41200", "ko": "테이블 위에는 일식과 양식이 뒤섞인 온갖 음식이 산더미처럼 차려져 있었다."},
{"id": "clah04:41300", "ko": "도저히 둘이서 먹을 수 있는 양을 훨씬 넘어섰다."},
{"id": "clah04:41400", "ko": "게다가――"},
{"id": "clah04:41500", "ko": "「왜 그래요? 안 먹어요?」"},
{"id": "clah04:41600", "ko": "「음, 그게……」"},
{"id": "clah04:41700", "ko": "「아〜, 알았다〜. 어쩔 수 없네요〜, 참. 선배도 참, 어리광쟁이라니까」"},
{"id": "clah04:41800", "ko": "아리무라는 아직 김이 펄펄 나는 곤약을 내밀었다."},
{"id": "clah04:41900", "ko": "「⟦col:280aa02d1400⟧자, 아〜 해⟦col:800000⟧」"},
{"id": "clah04:42000", "ko": "「아니, 잠깐! 그건――!」"},
{"id": "clah04:42100", "ko": "「사양하지 말고, 아〜」"},
{"id": "clah04:42200", "ko": "아리무라의 젓가락이 순식간에 눈앞으로 다가왔고, 피하려던 내 뺨에……"},
{"id": "clah04:42300", "ko": "「뜨거! 앗뜨뜨뜨뜨!!」"},
{"id": "clah04:42400", "ko": "제대로 데었다."},
{"id": "clah04:42500", "ko": "「어라? 선배, 뜨거운 거 못 먹어요?」"},
{"id": "clah04:42600", "ko": "「그 이전의 문제다!!!」"},
{"id": "clah04:42700", "ko": "그보다, 무슨 예능 프로냐!"},
{"id": "clah04:42800", "ko": "「알았어요〜. 그럼 후후 불어 줄게요」"},
{"id": "clah04:42900", "ko": "「후, 후우」"},
{"id": "clah04:43000", "ko": "「저기…… 아리무라……」"},
{"id": "clah04:43100", "ko": "「자, 한 번 더, 아〜……」"},
{"id": "clah04:43200", "ko": "「미안한데, 나……」"},
{"id": "clah04:43300", "ko": "「아〜」"},
{"id": "clah04:43400", "ko": "「돌아오기 전에 밥을 먹어 버렸거든……」"},
{"id": "clah04:43500", "ko": "「……아앙?」"},
{"id": "clah04:43600", "ko": "「아, 아니, 그게, 막 개업한 피자집이 있어서! 무슨 밀라노에서 처음 상륙했다나 해서, 맛있어 보였거든……」"},
{"id": "clah04:43700", "ko": "「헤에〜……」"},
{"id": "clah04:43800", "ko": "……역시 화났나?"},
{"id": "clah04:43900", "ko": "「아〜」"},
{"id": "clah04:44000", "ko": "「그, 그러니까 배가 불러서」"},
{"id": "clah04:44100", "ko": "「아〜!」"},
{"id": "clah04:44200", "ko": "「미, 미안했어! 더 빨리 말했어야 했――읍!」"},
{"id": "clah04:44300", "ko": "「변명 무용! 모처럼 만들었으니까 먹어엇! 자, 먹어! 전부 먹어어어!!!」"},
{"id": "clah04:44400", "ko": "하지만 아무리 억지로 먹이려 해도 내 위의 용량은 뻔한 것이라."},
{"id": "clah04:44500", "ko": "그렇다면――"},
{"id": "clah04:44600", "ko": "「으아앙, 이렇게 된 거 내가 다 먹어 버릴 거야〜!」"},
{"id": "clah04:44700", "ko": "「…………」"},
{"id": "clah04:44800", "ko": "「아〜, 맛있다! 이렇게 맛있는데 못 먹다니, 선배 불쌍해라〜」"},
{"id": "clah04:44900", "ko": "눈물 그렁그렁한 눈으로 할 말은 아닐 텐데."},
{"id": "clah04:45000", "ko": "그보다, 역시 미안한 기분이 들기 시작했다."},
{"id": "clah04:45100", "ko": "「미안……」"},
{"id": "clah04:45200", "ko": "「말해 두지만 이제 선배한테는 안 줄 거예요!」"},
{"id": "clah04:45300", "ko": "그건 상관없는데. 그렇게 먹으면……"},
{"id": "clah04:45400", "ko": "「으으…… 못 움직이겠다…… 진짜, 못 움직이겠슴다……」"},
{"id": "clah04:45500", "ko": "뭐, 이렇게 되겠지."},
{"id": "clah04:45600", "ko": "「이상하다…… 이럴 리가 없었는데……」"},
{"id": "clah04:45700", "ko": "「자, 약……」"},
{"id": "clah04:45800", "ko": "「오, 오브리가두 고마워어……」"},
{"id": "clah04:45900", "ko": "손이 많이 가는 녀석이다."},
{"id": "clah04:46000", "ko": "나를 완전히 반하게 만들기는커녕 색기라곤 눈곱만큼도 없잖아."},
{"id": "clah04:46100", "ko": "「끄으으…… 하지만 이 정도로 포기할 히나에가 아니니까요…… 두고 봐요, 미야시로 선배……」"},
{"id": "clah04:46200", "ko": "그러면 무슨 원수 갚기잖아."},
{"id": "clah04:46300", "ko": "뭐, 그래도 이상한 소리를 꺼내서 어떻게 되나 했는데, 이런 식이라면 이상한 일은 안 생기겠지."},
{"id": "clah04:46400", "ko": "그 예상대로 아리무라는 밤까지 녹초가 된 채 아무것도 꾸미지 않았고, 슬슬 잘 시간이 되었다."},
{"id": "clah04:46500", "ko": "「말해 두겠는데요, 오늘 건 살짝 엉뚱한 면을 보여 준 것뿐이니까요」"},
{"id": "clah04:46600", "ko": "「그 왜, 반전 매력? 그걸 노린 것뿐임다」"},
{"id": "clah04:46700", "ko": "대체 뭐와 뭐의 반전을 노렸다는 건지 나는 도통 모르겠다."},
{"id": "clah04:46800", "ko": "「그럼 안녕히 주무세요」"},
{"id": "clah04:46900", "ko": "「어라?」"},
{"id": "clah04:47000", "ko": "「왜 그러세요?」"},
{"id": "clah04:47100", "ko": "「아니……」"},
{"id": "clah04:47200", "ko": "「아〜, 혹시 침대 옆 경보기요? 그거 고장 나 버려서요〜」"},
{"id": "clah04:47300", "ko": "딱히 묻지도 않았는데."},
{"id": "clah04:47400", "ko": "「그렇다고 이쪽 침대로 들어오면 안 돼요」"},
{"id": "clah04:47500", "ko": "「알고 있다니까」"},
{"id": "clah04:47600", "ko": "「흥……」"},
{"id": "clah04:47700", "ko": "「뭐, 뭐야?」"},
{"id": "clah04:47800", "ko": "「……그렇게 여유 부릴 수 있는 것도 지금뿐이니까요. 안녕히 주무세요!」"},
{"id": "clah04:47900", "ko": "할 말만 하고는 냉큼 이불 속으로 파고들어 버렸다."},
{"id": "clah04:48000", "ko": "뭐 됐다, 나도 자자."},
{"id": "clah04:48100", "ko": "「…………」"},
{"id": "clah04:48200", "ko": "잠이 안 온다."},
{"id": "clah04:48300", "ko": "원인은 결코 아리무라의 경보기가 없어져서가 아니다…… 아마도."},
{"id": "clah04:48400", "ko": "「으음……」"},
{"id": "clah04:48500", "ko": "깨어 있나?"},
{"id": "clah04:48600", "ko": "……아니면 잠꼬대?"},
{"id": "clah04:48700", "ko": "「미야시로…… 선배……」"},
{"id": "clah04:48800", "ko": "혹시 내 꿈을 꾸고 있는 건가?"},
{"id": "clah04:48900", "ko": "「선배…… 저…… 선배를……」"},
{"id": "clah04:49000", "ko": "아리무라……"},
{"id": "clah04:49100", "ko": "「깨어 있지?」"},
{"id": "clah04:49200", "ko": "「쿨, 쿨……」"},
{"id": "clah04:49300", "ko": "「역시나」"},
{"id": "clah04:49400", "ko": "「칫――」"},
{"id": "clah04:49500", "ko": "정말이지, 그래서 내가 진짜로 덮치기라도 하면 어쩔 셈이야."},
{"id": "clah04:49600", "ko": "정말 무슨 생각을 하는 건지."}
]
