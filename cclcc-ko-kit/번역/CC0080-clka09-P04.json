[
{"id": "clka09:28900", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:29000", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:29100", "ko": "「너무해요, 너무하잖아요! 아뇨, 제 일은 아무래도 상관없어요」"},
{"id": "clka09:29200", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:29300", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:29400", "ko": "그렇게 말하며 연극하는 듯한 몸짓으로 흑흑흑…… 하고 그 자리에 무너져 울었다."},
{"id": "clka09:29500", "ko": "「너 말이야……!」"},
{"id": "clka09:29600", "ko": "그때."},
{"id": "clka09:29700", "ko": "「……타쿠루」"},
{"id": "clka09:29800", "ko": "「쿠루스! 들어 줘! 나는 결백해!」"},
{"id": "clka09:29900", "ko": "「아직도 그런 소리 하는 거야?」"},
{"id": "clka09:30000", "ko": "「……어?」"},
{"id": "clka09:30100", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:30200", "ko": "「타쿠루. 최악이야, 너」"},
{"id": "clka09:30300", "ko": "「하각!」"},
{"id": "clka09:30400", "ko": "「전혀 기억에 없는 얘기인데, 왜인지 양심이 아파!」"},
{"id": "clka09:30500", "ko": "「솔직히 미야시로는 언젠가 이런 짓을 할 거라고 생각했지만 말이야. 나는」"},
{"id": "clka09:30600", "ko": "「그래도 역시 넌 최악이야. 미야시로」"},
{"id": "clka09:30700", "ko": "「히갸악!」"},
{"id": "clka09:30800", "ko": "「마음이, 마음이 아파!」"},
{"id": "clka09:30900", "ko": "「알고 있던 일이긴 하지만, 역시 여자의 적이네요」"},
{"id": "clka09:31000", "ko": "「미야시로 선배. 최악이에요」"},
{"id": "clka09:31100", "ko": "「후굽!」"},
{"id": "clka09:31200", "ko": "「……」"},
{"id": "clka09:31300", "ko": "「타쿠, 최악」"},
{"id": "clka09:31400", "ko": "「포고옥!」"},
{"id": "clka09:31500", "ko": "「최악!」⟦n⟧⟦par⟧「최악!」⟦n⟧⟦par⟧「최악!」"},
{"id": "clka09:31600", "ko": "「우오오오오오오오오!!!!!!!」"},
{"id": "clka09:31700", "ko": "……스스로도 끔찍한 망상이었다."},
{"id": "clka09:31800", "ko": "", "note": "보류 — 성적 묘사"},
{"id": "clka09:31900", "ko": "조심해서 덤벼야겠다."},
{"id": "clka09:32000", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:32100", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:32200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:32300", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:32400", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:32500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:32600", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:32700", "ko": "――그때."},
{"id": "clka09:32800", "ko": "「응?」"},
{"id": "clka09:32900", "ko": "어째서인지 카즈키가 천천히 눈을 떴다."},
{"id": "clka09:33000", "ko": "「응? 응?」"},
{"id": "clka09:33100", "ko": "멍한 눈으로 눈을 깜빡깜빡하고 있다."},
{"id": "clka09:33200", "ko": "「응? 응? 응?」"},
{"id": "clka09:33300", "ko": "눈의 초점이 맞지 않는 것 같았다."},
{"id": "clka09:33400", "ko": "「응? 응? 응? 응?」"},
{"id": "clka09:33500", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:33600", "ko": "「으으읏!!!???」"},
{"id": "clka09:33700", "ko": "물론 나도 카즈키의 그 이상을 알아차리고 있었다."},
{"id": "clka09:33800", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:33900", "ko": "「카, 카즈키!」"},
{"id": "clka09:34000", "ko": "「으음〜〜〜〜〜〜!!!!!!」"},
{"id": "clka09:34100", "ko": "카즈키는 반사적으로 두 팔로 내 몸을 힘껏 밀쳐 냈다. 견디지 못하고 나는 바닥에 굴렀다."},
{"id": "clka09:34200", "ko": "", "note": "보류 — 연애 묘사"},
{"id": "clka09:34300", "ko": "「아, 하하……」"},
{"id": "clka09:34400", "ko": "뭐랄까."},
{"id": "clka09:34500", "ko": "오늘은 넘어지기만 하네……"}
]
