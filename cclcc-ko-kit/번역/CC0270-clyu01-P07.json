[
{"id": "clyu01:59500", "ko": "노노의 설득에 유이는 어깨를 떨구며 고개를 끄덕였다."},
{"id": "clyu01:59600", "ko": "「그럼……」"},
{"id": "clyu01:59700", "ko": "「……알았어. 아이돌은 포기할게……」"},
{"id": "clyu01:59800", "ko": "아무래도 유이는 순순히 포기한 모양이다."},
{"id": "clyu01:59900", "ko": "그런 화려한 세계를 동경하는 유이의 마음도 모르는 건 아니다."},
{"id": "clyu01:60000", "ko": "하지만 하는 말로 치면 노노 쪽이 압도적으로 옳다."},
{"id": "clyu01:60100", "ko": "장난삼아 손을 댔다가 큰일이 나고 나서는 늦는 거다."},
{"id": "clyu01:60200", "ko": "그래도……"},
{"id": "clyu01:60300", "ko": "「…………」"},
{"id": "clyu01:60400", "ko": "포기한다고 말은 하면서도 역시 슬픈 얼굴을 하고 있는 유이의 모습이 안쓰러웠다."},
{"id": "clyu01:60500", "ko": "오랜만의 내 방이라 그런지 도무지 잠이 오지 않는다."},
{"id": "clyu01:60600", "ko": "（일단 자려는 노력이라도 해 볼까）"},
{"id": "clyu01:60700", "ko": "그렇게 생각하고 침대에 파고든 지 한참 지났을 무렵――"},
{"id": "clyu01:60800", "ko": "노크 소리가 났다."},
{"id": "clyu01:60900", "ko": "（누구지, 이런 시간에?）"},
{"id": "clyu01:61000", "ko": "시계를 보니 이미 날짜도 바뀌어 있었다."},
{"id": "clyu01:61100", "ko": "이 시간이면 평소의 나는 아직 깨어서 인터넷으로 정보를 뒤지거나 하지만, 아오바 기숙사 식구들은 다르다."},
{"id": "clyu01:61200", "ko": "대개 날짜가 바뀌기 전에 잠드는 게 보통이다."},
{"id": "clyu01:61300", "ko": "그런데 이런 시간에 찾아오다니……"},
{"id": "clyu01:61400", "ko": "혹시 쿠루스?"},
{"id": "clyu01:61500", "ko": "아니면 아버지인가?"},
{"id": "clyu01:61600", "ko": "혹은 유이인가……"},
{"id": "clyu01:61700", "ko": "아침까지 못 기다릴 정도로 급한 얘기인 걸까?"},
{"id": "clyu01:61800", "ko": "「…………」"},
{"id": "clyu01:61900", "ko": "생각하기보다 확인하는 게 빠르겠지."},
{"id": "clyu01:62000", "ko": "그렇게 마음먹고 막 말을 걸려던 그때, 방문이 천천히 열렸다."},
{"id": "clyu01:62100", "ko": "「타쿠루 형…… 벌써 자?」"},
{"id": "clyu01:62200", "ko": "문틈으로 조심조심 들여다본 건 유토였다."},
{"id": "clyu01:62300", "ko": "「유토…… 무슨 일이야?」"},
{"id": "clyu01:62400", "ko": "「다행이다. 아직 안 잤구나」"},
{"id": "clyu01:62500", "ko": "유토는 안심한 듯한 미소를 짓더니 내 방으로 들어왔다."},
{"id": "clyu01:62600", "ko": "「안 되잖아, 이런 시간까지 안 자고 있으면」"},
{"id": "clyu01:62700", "ko": "유토는 아직 13살이다."},
{"id": "clyu01:62800", "ko": "13살쯤 되면 나름 밤샘도 하는 나이일지도 모르지만, 그래도 안 자고 있다가 혼나는 건 유토다."},
{"id": "clyu01:62900", "ko": "「미안해. 그래도 나…… 꼭 타쿠루 형이랑 얘기하고 싶어서……」"},
{"id": "clyu01:63000", "ko": "「나랑?」"},
{"id": "clyu01:63100", "ko": "「응……」"},
{"id": "clyu01:63200", "ko": "유토가 나한테 이런 말을 해 오는 건 처음이었다."},
{"id": "clyu01:63300", "ko": "지금까지 고민을 털어놓는 상대라면 역시 피가 이어진 누나인 유이가 대부분이었다."},
{"id": "clyu01:63400", "ko": "그다음이 믿음직한 ⟦rb⟧의붓누나⟦rt⟧누나⟦/r⟧ 노노 정도일까."},
{"id": "clyu01:63500", "ko": "그런데 나한테―― 라니."},
{"id": "clyu01:63600", "ko": "혹시 유토도 “남자 대 남자”의 얘기를 하고 싶어지는, 그런 나이가 됐다는 걸까."},
{"id": "clyu01:63700", "ko": "「그래서, 할 얘기라는 게?」"},
{"id": "clyu01:63800", "ko": "「있잖아…… 나 말야, 지금까지 말 안 했지만…… 사실은…… 자…… 야」", "note": "「(女の)子……なの」를 웅얼거리는 줄 — 「(여)자…… 야」로 옮김"},
{"id": "clyu01:63900", "ko": "「어? 미안. 잘 못 들었어」"},
{"id": "clyu01:64000", "ko": "「……그러니까…… 그…… 나…… 사실은……」"},
{"id": "clyu01:64100", "ko": "「사실 나, 여자애야!」"},
{"id": "clyu01:64200", "ko": "「……」"},
{"id": "clyu01:64300", "ko": "방금…… 뭐라고?"},
{"id": "clyu01:64400", "ko": "「………………」"},
{"id": "clyu01:64500", "ko": "「…………………………」"},
{"id": "clyu01:64600", "ko": "여자…… 애……?"},
{"id": "clyu01:64700", "ko": "「뭐어어어어어어어어어엇!!!?」"},
{"id": "clyu01:64800", "ko": "「쉿! 목소리 커」"},
{"id": "clyu01:64900", "ko": "「자, 잠깐만, 유토! 여자애라니…… 그러니까, 그…… 남자가 아니라는 거지?!」"},
{"id": "clyu01:65000", "ko": "「뭐…… 그렇게 되는 거지」"},
{"id": "clyu01:65100", "ko": "화, 확실히 유토는 언뜻 보면 귀여운 얼굴을 하고 있지만……"},
{"id": "clyu01:65200", "ko": "그래도 그건 아직 성장기가 안 온 애들한테는 흔한 일이고……"},
{"id": "clyu01:65300", "ko": "「혹시 내 말 안 믿는 거야?」"},
{"id": "clyu01:65400", "ko": "「그, 그야, 갑자기 그런 말을 들어도……」"},
{"id": "clyu01:65500", "ko": "「알았어…… 그럼, 손 줘 봐」"},
{"id": "clyu01:65600", "ko": "「어……?」"},
{"id": "clyu01:65700", "ko": "나는 유토가 시키는 대로 손을 내밀었다."},
{"id": "clyu01:65800", "ko": "", "note": "보류 — 성적 묘사(13살 인물의 몸을 만지는 장면 65800~67600)"},
{"id": "clyu01:65900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66000", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66100", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66300", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66400", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66700", "ko": "「…………」"},
{"id": "clyu01:66800", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:66900", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67000", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67100", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67300", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67400", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67500", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67600", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clyu01:67700", "ko": "「그, 그래도…… 왜?」"},
{"id": "clyu01:67800", "ko": "지금까지 남자라고 거짓말을 했던 거냐…… 고 다 말하지 않아도 유토는 알아들은 모양이다."},
{"id": "clyu01:67900", "ko": "「그게, 지진 때 여자애 둘이면 위험하니까 그러는 게 낫다고 누나가……」"},
{"id": "clyu01:68000", "ko": "그렇군."},
{"id": "clyu01:68100", "ko": "확실히 그 혼란 속에서 어린 여자애 둘이라면 위험했을지도 모른다."},
{"id": "clyu01:68200", "ko": "「그, 그래도…… 왜?」"},
{"id": "clyu01:68300", "ko": "다음으로 내 입에서 나온 건 아까와 완전히 똑같은 말이었지만, 이번에도 유토는 알아차려 주었다."},
{"id": "clyu01:68400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu01:68500", "ko": "「엥?」"},
{"id": "clyu01:68600", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"},
{"id": "clyu01:68700", "ko": "「그러니까…… 그러니까……」"},
{"id": "clyu01:68800", "ko": "유토의 눈에서 구슬 같은 투명한 눈물방울이 뚝뚝 떨어졌다."},
{"id": "clyu01:68900", "ko": "「자, 잠깐, 유토! 그런 말을 갑자기 해도 나는――」"},
{"id": "clyu01:69000", "ko": "「유……」"},
{"id": "clyu01:69100", "ko": "「어?」"},
{"id": "clyu01:69200", "ko": "", "note": "보류 — 연애 묘사(미성년·가족). 옮길 때: 여자애 「ユウ」로 자기를 밝히는 대목이라 お兄ちゃん 은 「오빠」(03 4절)"},
{"id": "clyu01:69300", "ko": "「으……」"},
{"id": "clyu01:69400", "ko": "", "note": "보류 — 연애 묘사(미성년·가족)"}
]
