[
{"id": "clse07:919500", "ko": "「쪼끔만 줘 봐?」"},
{"id": "clse07:919600", "ko": "「다 써 버렸어」"},
{"id": "clse07:919700", "ko": "「그런 푼돈, 금방 없어지는 게 당연하잖아? 그러니까, 응? 자」"},
{"id": "clse07:919800", "ko": "「뭐어?!」"},
{"id": "clse07:919900", "ko": "「됐으니까 내놓으라고 했잖아? 돈 말야?」"},
{"id": "clse07:920000", "ko": "「네가 나에 대해 뭘 안다는 건데?」"},
{"id": "clse07:920100", "ko": "「착한 척하기는. 가족은 무슨. 거짓말은 안 한다는 게 다 뭐야?」"},
{"id": "clse07:920200", "ko": "「너야말로 거짓말만 해 대는 주제에!」"},
{"id": "clse07:920300", "ko": "「아? 뭘 봐?」"},
{"id": "clse07:920400", "ko": "「따지고 보면 네가 잘못한 거야. 타쿠루 오빠……」"},
{"id": "clse07:920500", "ko": "「네가 나가 버린 뒤로 우리 가족 관계는 망가져 버렸다고……」"},
{"id": "clse07:920600", "ko": "「흥…… 마음에 안 드네……」"},
{"id": "clse07:920700", "ko": "「너의 그런 점이 마음에 안 든다고! 혼자선 아무것도 못 하는 주제에 남을 깔보고! 열받는다고!」"},
{"id": "clse07:920800", "ko": "", "note": "보류 — 미성년 인물에 대한 학대 암시"},
{"id": "clse07:920900", "ko": "「흥……! 그럼 냉큼 돈이나 내놔」"},
{"id": "clse07:921000", "ko": "「쳇! 짜기는」"},
{"id": "clse07:921100", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:921200", "ko": "", "note": "보류 — 성적 묘사(미성년)"},
{"id": "clse07:921300", "ko": "「흥…… 겁쟁이가……!」"},
{"id": "clse07:921400", "ko": "「누구야?!」"},
{"id": "clse07:921500", "ko": "「타쿠루 오빠?! 잠깐 기다려!!」"},
{"id": "clse07:921600", "ko": "「괜찮아. 들어와」"},
{"id": "clse07:921700", "ko": "「타, 타쿠루 오빠…… 와 있었구나」"},
{"id": "clse07:921800", "ko": "「그럼, 이제부터 계속 집에 있는 거야?」"},
{"id": "clse07:921900", "ko": "「뭐야~. 아쉽다. 다시 다 같이 살 수 있을 줄 알았는데」"},
{"id": "clse07:922000", "ko": "「어? 뭐 하냐니, 그…… 고, 공부지?」"},
{"id": "clse07:922100", "ko": "「응?」"},
{"id": "clse07:922200", "ko": "「어?」"},
{"id": "clse07:922300", "ko": "「왜, 왜 그래…… 타쿠루 오빠…… 갑자기……」"},
{"id": "clse07:922400", "ko": "「그, 그래…… 고마워……」"},
{"id": "clse07:922500", "ko": "「으, 응……」"},
{"id": "clse07:922600", "ko": "「음~, 맛있어~」"},
{"id": "clse07:922700", "ko": "「잘 먹었습니다!」"},
{"id": "clse07:922800", "ko": "「저기, 노노 언니. 컴퓨터 써도 되지?」"},
{"id": "clse07:922900", "ko": "「벌써 끝났어」"},
{"id": "clse07:923000", "ko": "「신난다! 자, 우키도 같이 보자?」"},
{"id": "clse07:923100", "ko": "「자, 밥 마지막 한 입, 먹어 먹어」"},
{"id": "clse07:923200", "ko": "「하아, 좋겠다, MOMONE. 귀엽다……」"},
{"id": "clse07:923300", "ko": "「우리 반에선 거의 다 엄청 좋아해」"},
{"id": "clse07:923400", "ko": "「…………」"},
{"id": "clse07:923500", "ko": "「……나도…… 아이돌 되고 싶다……」"},
{"id": "clse07:923600", "ko": "「맞다!」"},
{"id": "clse07:923700", "ko": "「저기, 타쿠루 오빠! 타쿠루 오빠는 인터넷 방송 같은 거 잘 알지?」"},
{"id": "clse07:923800", "ko": "「역시 타쿠루 오빠! 그럼 니야생 같은 것도 할 수 있지?!」"},
{"id": "clse07:923900", "ko": "「나도 아이돌 되고 싶어!!」"},
{"id": "clse07:924000", "ko": "「왜? 인터넷만 있으면 MOMONE처럼 니야생 방송은 할 수 있잖아?」"},
{"id": "clse07:924100", "ko": "「아~, 그렇구나. 응, 그래도 혼자면 좀 불안할지도」"},
{"id": "clse07:924200", "ko": "「저기, 우키! 같이 안 할래? 아이돌 활동!」"},
{"id": "clse07:924300", "ko": "「응!」"},
{"id": "clse07:924400", "ko": "「그건 봐, 귀여운 옷 입고 노래하고 춤추고 수다 떨고 하면 되는 거 아닐까?」"},
{"id": "clse07:924500", "ko": "「응, 되고 싶어! 완전 되고 싶어!」"},
{"id": "clse07:924600", "ko": "「응? 괜찮잖아~? 하자~, 아이돌 활동~」"},
{"id": "clse07:924700", "ko": "「왜, 노노 언니?」"},
{"id": "clse07:924800", "ko": "「할 수 있단 말야」"},
{"id": "clse07:924900", "ko": "「그건……」"},
{"id": "clse07:925000", "ko": "「그, 그래도 만약 인기가 생기면 돈도 벌 수 있게 될지도 모르잖아?」"},
{"id": "clse07:925100", "ko": "「그러면 ⟦rb⟧아오바 기숙사⟦rt⟧우리 집⟦/r⟧한테도 좋은 일이잖아?」"},
{"id": "clse07:925200", "ko": "「나 다 알거든? 우리 집 돈 없지? 노노 언니가 맨날 큰일이다 큰일이다 하잖아」"},
{"id": "clse07:925300", "ko": "「……무슨…… 뜻인데?」"},
{"id": "clse07:925400", "ko": "「…………」"},
{"id": "clse07:925500", "ko": "「응……」"},
{"id": "clse07:925600", "ko": "「……알았어. 아이돌은 포기할게……」"},
{"id": "clse07:925700", "ko": "「…………」"},
{"id": "clse07:925800", "ko": "「어라? 우키?」"},
{"id": "clse07:925900", "ko": "「우키, 무슨 일이야? 이렇게 늦게 타쿠루 오빠 방에서 뭐 해?」"},
{"id": "clse07:926000", "ko": "「나는 타쿠루 오빠한테 부탁이 있어서……」"},
{"id": "clse07:926100", "ko": "「나 있지, 역시 아이돌 해 보고 싶어. 그러니까 타쿠루 오빠, 힘 좀 빌려주지 않을래?」"},
{"id": "clse07:926200", "ko": "「어? 그 말은 혹시 우키도……?」"},
{"id": "clse07:926300", "ko": "「말도 안 돼! 우키도 아이돌 하고 싶었어?!」"},
{"id": "clse07:926400", "ko": "「나한테? 무슨 소리야?」"},
{"id": "clse07:926500", "ko": "「우키…… 그랬구나……」"},
{"id": "clse07:926600", "ko": "「아니! 기뻐. 고마워, 우키!」"},
{"id": "clse07:926700", "ko": "「후훗. 우키, 정말 좋아!」"},
{"id": "clse07:926800", "ko": "「저기, 역시 우키도 같이 하자! 아이돌 활동!」"},
{"id": "clse07:926900", "ko": "「그렇지 않아. 우키는 귀엽잖아. 분명 할 수 있어」"},
{"id": "clse07:927000", "ko": "「게다가 나도 우키가 같이 해 주면 든든하고」"},
{"id": "clse07:927100", "ko": "「응?」"},
{"id": "clse07:927200", "ko": "「응! 나, 우키랑 같이 하고 싶어」"},
{"id": "clse07:927300", "ko": "「응」"},
{"id": "clse07:927400", "ko": "「물론이지!」"},
{"id": "clse07:927500", "ko": "「뭐어어어어어어어어어어어어어?!」"},
{"id": "clse07:927600", "ko": "「그, 그렇지. 나도 그렇게 말해 줄 거라고……」"},
{"id": "clse07:927700", "ko": "「그렇구나…… 그럼 역시 포기할 수밖에 없겠네……」"},
{"id": "clse07:927800", "ko": "「아, 미안, 유. 깨웠지?」"},
{"id": "clse07:927900", "ko": "「어?」"},
{"id": "clse07:928000", "ko": "「……글쎄?」"},
{"id": "clse07:928100", "ko": "「어? 뭐야, 갑자기?」"},
{"id": "clse07:928200", "ko": "「그건………… 뭐어어어어어어어어?」"},
{"id": "clse07:928300", "ko": "「자매라는 건, 유도 여자애가 된다는 거야?」"},
{"id": "clse07:928400", "ko": "「그래도, 그렇구나…… 나도 유가 같이 하면 든든할지도……」"},
{"id": "clse07:928500", "ko": "「있잖아, 유…… 같이 아이돌 활동…… 해 줄래?」"},
{"id": "clse07:928600", "ko": "「유토!」"},
{"id": "clse07:928700", "ko": "「응, 알아」"},
{"id": "clse07:928800", "ko": "「노노 언니는 고지식하니까」"},
{"id": "clse07:928900", "ko": "「그럼 다시 한번, 잘 부탁드립니다. 프로듀서님!」"},
{"id": "clse07:929000", "ko": "「응. 아이돌을 돌봐 주는 사람을 “프로듀서”라고 하잖아? 그러니까 타쿠루 오빠가 프로듀서」"},
{"id": "clse07:929100", "ko": "「저, 어떻게 하면 좋을까요?」"},
{"id": "clse07:929200", "ko": "「「저, 아이돌로서 더 잘나가고 싶어요. 그런데 어떻게 하면 좋을지 몰라서」", "note": "원문 머리의 겹낫표 「「 그대로 둠"},
{"id": "clse07:929300", "ko": "", "note": "보류 — 성적 강요 묘사(미성년, 원래 장면 clyu01:101900~103600)"},
{"id": "clse07:929400", "ko": "", "note": "보류 — 성적 강요 묘사(미성년)"}
]
