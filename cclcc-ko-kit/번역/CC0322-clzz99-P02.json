[
{"id": "clzz99:10000", "ko": "「미야시로, 도와줘!!」"},
{"id": "clzz99:10100", "ko": "「좋아, 간다. 하나, 둘!!」"},
{"id": "clzz99:10200", "ko": "둘이서 힘을 합쳐 봤지만, 역시 문은 전혀 열릴 기미가 없었다."},
{"id": "clzz99:10300", "ko": "「어떡하지? 이래선 상황도 모르겠잖아」"},
{"id": "clzz99:10400", "ko": "난처하다는 듯 말하는 이토의 목소리를 등 뒤로 하고, 나는 창가로 걸어갔다."},
{"id": "clzz99:10500", "ko": "만약 시부야 지진 때처럼 건물이 무너지기라도 했다면, 구급차나 소방차가 돌아다니고 있을 거다."},
{"id": "clzz99:10600", "ko": "그걸 확인하려고 창문에 손을 댔다."},
{"id": "clzz99:10700", "ko": "그런데……"},
{"id": "clzz99:10800", "ko": "「……어라?」"},
{"id": "clzz99:10900", "ko": "「어이, 설마……」"},
{"id": "clzz99:11000", "ko": "그 설마대로, 창문도 열리지 않았다."},
{"id": "clzz99:11100", "ko": "「진짜…… 냐……」"},
{"id": "clzz99:11200", "ko": "혹시 몰라 유리 너머로 눈을 부릅뜨고 살펴봤지만, 어디서 연기가 피어오르는 기색도 없고 소방차가 돌아다니는 기색도 없다."},
{"id": "clzz99:11300", "ko": "일단 거리에는 별다른 낌새가 보이지 않았다."},
{"id": "clzz99:11400", "ko": "「이, 일단 불부터 켜자. 이렇게 어두우면 기분이 처진다고」"},
{"id": "clzz99:11500", "ko": "벽 쪽으로 간 이토가 스위치로 손을 뻗었다."},
{"id": "clzz99:11600", "ko": "하지만 전기 스위치를 눌러도 딸깍딸깍 소리만 날 뿐, 부실 안은 어두운 그대로였다."},
{"id": "clzz99:11700", "ko": "「정전?」"},
{"id": "clzz99:11800", "ko": "창밖을 보니 가로등 불빛은 켜져 있다."},
{"id": "clzz99:11900", "ko": "다만 학교 안은 전부 꺼진 그대로였다."},
{"id": "clzz99:12000", "ko": "「아무래도 이 학교만 정전된 모양이네」"},
{"id": "clzz99:12100", "ko": "「진짜냐……」"},
{"id": "clzz99:12200", "ko": "어딘가 배선이 끊어진 건지 뭔지."},
{"id": "clzz99:12300", "ko": "아무튼 전기가 들어오지 않는다."},
{"id": "clzz99:12400", "ko": "「어이, 그렇다는 건……」"},
{"id": "clzz99:12500", "ko": "늘 카즈키가 마주하고 있는 컴퓨터로 달려가 전원을 눌러 봤지만."},
{"id": "clzz99:12600", "ko": "「PC도 안 돼……. 그보다 이럴 때를 위해서 노트북으로 해야 하는 거잖아, 보통」"},
{"id": "clzz99:12700", "ko": "「지금 그런 소리 해 봤자 소용없잖아. 그보다 어떡할 거야, 이제?」"},
{"id": "clzz99:12800", "ko": "「……어떡하냐고 해도…… 어떻게 할 수도 없잖아. 누가 알아챌 때까지 여기 있는 수밖에」"},
{"id": "clzz99:12900", "ko": "「그렇지……」"},
{"id": "clzz99:13000", "ko": "꽤 오래 잠들어 있었던 건지, 밖을 내다봐도 사람 그림자가 없다."},
{"id": "clzz99:13100", "ko": "하지만 이럴 때는 어쩌면 경비 회사가 순찰하러 올지도 모른다."},
{"id": "clzz99:13200", "ko": "설령 오지 않는다 해도 내일이면 누군가 올 거다."},
{"id": "clzz99:13300", "ko": "「아~아, 미야시로랑 둘이서 부실에 갇히다니. 기왕이면 여자애랑 같이 있는 게 좋았을 텐데」"},
{"id": "clzz99:13400", "ko": "「그건 내가 할 소리다」"},
{"id": "clzz99:13500", "ko": "일단 지금으로선 어쩔 수 없다며 우리는 자리를 잡고 앉아 시간을 때울 방법을 생각했다."},
{"id": "clzz99:13600", "ko": "하지만 평소 스마트폰이나 PC에 기대고 있었던 만큼, 새삼 뭔가 하려 해도 할 게 아무것도 없다."},
{"id": "clzz99:13700", "ko": "처음에야 잡담을 했지만, 이렇게 어두워서는 영 기분이 나지 않는다."},
{"id": "clzz99:13800", "ko": "「그러고 보니 배고프네……」"},
{"id": "clzz99:13900", "ko": "「……확실히」"},
{"id": "clzz99:14000", "ko": "……이토 녀석, 쓸데없는 소리를."},
{"id": "clzz99:14100", "ko": "지금까지는 느끼지 못했는데, 깨닫는 순간 단숨에 허기가 밀려왔다."},
{"id": "clzz99:14200", "ko": "「그렇지! 분명……」"},
{"id": "clzz99:14300", "ko": "가방 안을 뒤지자, 생각했던 대로――"},
{"id": "clzz99:14400", "ko": "「오오, 샌드위치잖아!」"},
{"id": "clzz99:14500", "ko": "「점심에 다 못 먹어서 남긴 거야」"},
{"id": "clzz99:14600", "ko": "「아…… 뭐야, 참치 샌드위치냐. 나 햄 샌드위치가 좋았는데」"},
{"id": "clzz99:14700", "ko": "「아무도 준다고는 안 했다」"},
{"id": "clzz99:14800", "ko": "「뭐? 이럴 때 나눠 먹는 게 친구라는 거 아니냐?」"},
{"id": "clzz99:14900", "ko": "「친구라면 그렇겠지」"},
{"id": "clzz99:15000", "ko": "「아, 너무해!」"},
{"id": "clzz99:15100", "ko": "애초에 남의 것에 트집이나 잡는 녀석한테 나눠 줄 이유도 없다."},
{"id": "clzz99:15200", "ko": "나는 샌드위치 봉지를 열어 내용물을 꺼내 입으로 가져가려 했다."},
{"id": "clzz99:15300", "ko": "「…………」"},
{"id": "clzz99:15400", "ko": "「…………」"},
{"id": "clzz99:15500", "ko": "「……아~……」"},
{"id": "clzz99:15600", "ko": "「……알았어. 반 줄게!」"},
{"id": "clzz99:15700", "ko": "「진짜?!」"},
{"id": "clzz99:15800", "ko": "「그렇게 먹고 싶다는 얼굴로 쳐다보는데 혼자 먹을 수도 없잖아!」"},
{"id": "clzz99:15900", "ko": "어쩔 수 없이 두 조각 들어 있던 샌드위치 중 하나를 이토에게 나눠 준다."},
{"id": "clzz99:16000", "ko": "「잘 먹겠습니다~! 냠!」"},
{"id": "clzz99:16100", "ko": "「우물, 우물…… 크하~……」"},
{"id": "clzz99:16200", "ko": "「어때. 참치 샌드위치도 꽤 괜찮지?」"},
{"id": "clzz99:16300", "ko": "「햄 샌드위치만은 못하지만」"},
{"id": "clzz99:16400", "ko": "「읏…… 돌려줘! 너한테 줄 샌드위치는 없어!!」"},
{"id": "clzz99:16500", "ko": "「헤헤~. 벌써 먹어 버렸지롱~!」"},
{"id": "clzz99:16600", "ko": "젠장!"},
{"id": "clzz99:16700", "ko": "역시 주는 게 아니었다."},
{"id": "clzz99:16800", "ko": "결국 그 뒤로 기다리고 또 기다려도 ⟦rb⟧부실⟦rt⟧여기⟦/r⟧를 찾아오는 사람은 없었고, 할 일도 없는 우리는 자기로 했다."},
{"id": "clzz99:16900", "ko": "「그러고 보니 알아? 우리 학교에 얽힌 괴담……」"},
{"id": "clzz99:17000", "ko": "「……하지 마」"},
{"id": "clzz99:17100", "ko": "「한밤중에 방 앞을 걷는, 물에 젖은 듯한 발소리…… 듣자 하니 10년 전에 수영장에서 죽은 여학생이……」"},
{"id": "clzz99:17200", "ko": "「어이, 진짜 하지 말라니까!!!」"},
{"id": "clzz99:17300", "ko": "겁쟁이 녀석……"},
{"id": "clzz99:17400", "ko": "「나 잔다. 너도 얼른 자라」"},
{"id": "clzz99:17500", "ko": "엽기적인 이야기는 무척 좋아하는 주제에 이런 종류의 이야기는 어지간히 질색인지, 이토는 냉큼 등을 돌리고 입을 다물어 버렸다."},
{"id": "clzz99:17600", "ko": "어쩔 수 없지. 나도 잘까."},
{"id": "clzz99:17700", "ko": "「…………」"},
{"id": "clzz99:17800", "ko": "「저기, 미야시로…… 자냐?」"},
{"id": "clzz99:17900", "ko": "「…………」"},
{"id": "clzz99:18000", "ko": "「미야시로오~……」"},
{"id": "clzz99:18100", "ko": "「…………」"},
{"id": "clzz99:18200", "ko": "「…………」"},
{"id": "clzz99:18300", "ko": "「왜 다가오는 건데!!」"},
{"id": "clzz99:18400", "ko": "눈을 뜨자, 바로 옆까지 이토가 슬금슬금 다가와 있었다."},
{"id": "clzz99:18500", "ko": "「네가 이상한 얘기를 하니까 그렇잖아!!」"},
{"id": "clzz99:18600", "ko": "「그런 얘기는 거짓말이야. 애초에 10년 전에는 이 학교 없었잖아」"},
{"id": "clzz99:18700", "ko": "「아…… 그러고 보니 그렇네…… 그보다, 그럼 시시한 얘기 하지 마!!」"},
{"id": "clzz99:18800", "ko": "「미안하다니까. 그러니까 이제 자라고」"},
{"id": "clzz99:18900", "ko": "미안하지만, 나는 남자랑 붙어서 자는 취미는 없다."},
{"id": "clzz99:19000", "ko": "일단 아침까지 기다리면 누군가 와 주겠지."},
{"id": "clzz99:19100", "ko": "그때까지만 참으면 된다."},
{"id": "clzz99:19200", "ko": "「…………」"},
{"id": "clzz99:19300", "ko": "「…………」"},
{"id": "clzz99:19400", "ko": "다음 날 밤을 맞이하고 말았다."},
{"id": "clzz99:19500", "ko": "어찌 된 일인지 그동안 학교에 누가 오는 기색은 없었다."},
{"id": "clzz99:19600", "ko": "다행히 물은 우키가 포트 안에 가득 채워 두어서 모자라지는 않았다."},
{"id": "clzz99:19700", "ko": "먹을 것은 쿠루스나 오노에가 준비해 둔 과자나 카즈키가 책상 안에 늘 넣어 두는 막대 사탕 같은 게 나와서, 배를 채우는 데까지는 못 가도 영양은 어떻게든 섭취할 수 있었다."},
{"id": "clzz99:19800", "ko": "문제는 화장실인데……"},
{"id": "clzz99:19900", "ko": "「듣지 마! 절대 듣지 마」"}
]
